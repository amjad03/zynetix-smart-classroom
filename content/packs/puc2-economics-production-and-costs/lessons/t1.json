  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Total, average and marginal product"
   },
   "body": {
    "en": "Total product (TP) is the total output from a given amount of the variable input. Average product (AP) is output per unit of the variable input: $AP_L = TP/L$. Marginal product (MP) is the change in TP from one more unit of the variable input: $MP_L = \\Delta TP/\\Delta L$. TP is the sum of the MPs, and TP = AP × L."
   },
   "points": [
    {
     "en": "AP = TP/L"
    },
    {
     "en": "MP = ΔTP/ΔL"
    },
    {
     "en": "TP = ΣMP = AP × L"
    }
   ],
   "narration": {
    "en": "Total product is the whole output. Average product is output per worker. Marginal product is the extra output from one more worker.",
    "kn": "ಒಟ್ಟು ಉತ್ಪನ್ನ ಸಂಪೂರ್ಣ ಉತ್ಪಾದನೆ. ಸರಾಸರಿ ಉತ್ಪನ್ನ ಪ್ರತಿ ಕಾರ್ಮಿಕನ ಉತ್ಪಾದನೆ. ಇನ್ನೊಬ್ಬ ಕಾರ್ಮಿಕನಿಂದ ಸಿಗುವ ಹೆಚ್ಚುವರಿ ಉತ್ಪಾದನೆ ಸೀಮಾಂತ ಉತ್ಪನ್ನ."
   },
   "formula": "AP_L = \\frac{TP}{L},\\quad MP_L = \\frac{\\Delta TP}{\\Delta L}"
  },
