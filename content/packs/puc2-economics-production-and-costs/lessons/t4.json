  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A firm's TFC is ₹30 and its TC for 1 to 5 units is ₹50, 60, 66, 80, 105. Find TVC, AFC, AVC, AC and MC."
   },
   "steps": [
    {
     "en": "TVC = TC − 30: 20, 30, 36, 50, 75."
    },
    {
     "en": "AFC = 30/q: 30, 15, 10, 7.5, 6. AVC = TVC/q: 20, 15, 12, 12.5, 15."
    },
    {
     "en": "AC = TC/q: 50, 30, 22, 20, 21 (check: AFC + AVC, e.g. 7.5 + 12.5 = 20)."
