{
 "chapterId": "puc1-maths-02-relations-and-functions",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Union of two sets"
   },
   "tex": "n(A\\cup B) = n(A) + n(B) - n(A\\cap B)",
   "note": {
    "en": "Inclusion–exclusion."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Three sets"
   },
   "tex": "n(A\\cup B\\cup C) = \\sum n(A) - \\sum n(A\\cap B) + n(A\\cap B\\cap C)",
   "note": {
    "en": "Venn diagram problems."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "De Morgan's laws"
   },
   "tex": "(A\\cup B)' = A'\\cap B',\\quad (A\\cap B)' = A'\\cup B'",
   "note": {
    "en": "Complement swaps ∪ and ∩."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-02-relations-and-functions.t2",
   "name": {
    "en": "Number of subsets"
   },
   "tex": "|\\mathcal P(A)| = 2^n",
   "note": {
    "en": "Proper subsets: 2ⁿ − 1."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-02-relations-and-functions.t3",
   "name": {
    "en": "Number of functions A → B"
   },
   "tex": "n(B)^{n(A)}",
   "note": {
    "en": "One-one: ⁿP_m when m ≤ n."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-02-relations-and-functions.t2",
   "name": {
    "en": "Number of relations"
   },
   "tex": "2^{mn}",
   "note": {
    "en": "Subsets of A × B."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-maths-02-relations-and-functions.t1",
   "name": {
    "en": "Onto functions (m → 2)"
   },
   "tex": "2^m - 2",
   "note": {
    "en": "General case via inclusion–exclusion."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-maths-02-relations-and-functions.t1",
   "name": {
    "en": "Equal ordered pairs"
   },
   "tex": "(a,b) = (c,d)\\iff a = c,\\ b = d"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-maths-02-relations-and-functions.t1",
   "name": {
    "en": "Cartesian product"
   },
   "tex": "A\\times B = \\{(a,b) : a\\in A,\\ b\\in B\\},\\ n(A\\times B) = n(A)\\,n(B)",
   "note": {
    "en": "A × B ≠ B × A unless A = B (or one is empty)."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-02-relations-and-functions.t4",
   "name": {
    "en": "Product identities"
   },
   "tex": "A\\times(B\\cup C) = (A\\times B)\\cup(A\\times C),\\ (A\\times B)\\cap(C\\times D) = (A\\cap C)\\times(B\\cap D)"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-02-relations-and-functions.t3",
   "name": {
    "en": "Number of relations"
   },
   "tex": "A\\to B: 2^{mn},\\ \\text{on } A: 2^{m^2}\\quad(n(A) = m,\\ n(B) = n)"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Function"
   },
   "tex": "\\text{every } a\\in A \\text{ has exactly one image};\\ \\text{range}\\subseteq\\text{codomain}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-02-relations-and-functions.t3",
   "name": {
    "en": "Number of functions"
   },
   "tex": "A\\to B: n^m;\\ \\text{one-one}: {}^nP_m\\ (m\\le n);\\ \\text{onto } (n = 2): 2^m-2"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-02-relations-and-functions.t4",
   "name": {
    "en": "Identity, constant, polynomial, rational"
   },
   "tex": "I(x) = x;\\ f(x) = c;\\ \\text{rational } \\frac{p(x)}{q(x)} \\text{ needs } q(x)\\ne0"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-02-relations-and-functions.t4",
   "name": {
    "en": "Modulus"
   },
   "tex": "|x| = \\begin{cases}x & x\\ge0\\\\ -x & x<0\\end{cases},\\ \\text{range } [0,\\infty)"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-maths-02-relations-and-functions.t4",
   "name": {
    "en": "Signum"
   },
   "tex": "\\operatorname{sgn}x = \\begin{cases}1 & x>0\\\\ 0 & x = 0\\\\ -1 & x<0\\end{cases},\\ \\ |x| = x\\operatorname{sgn}x"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-maths-02-relations-and-functions.t4",
   "name": {
    "en": "Greatest integer function"
   },
   "tex": "[x]\\le x<[x]+1,\\ [x+n] = [x]+n\\ (n\\in\\mathbb Z),\\ [x]+[-x] = \\begin{cases}0 & x\\in\\mathbb Z\\\\ -1 & x\\notin\\mathbb Z\\end{cases}"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Fractional part"
   },
   "tex": "\\{x\\} = x-[x]\\in[0,1),\\ \\{x+1\\} = \\{x\\}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-maths-02-relations-and-functions.t5",
   "name": {
    "en": "Algebra of functions"
   },
   "tex": "(f\\pm g)(x) = f(x)\\pm g(x),\\ (fg)(x) = f(x)g(x),\\ \\left(\\tfrac fg\\right)(x) = \\tfrac{f(x)}{g(x)}",
   "note": {
    "en": "Domain: D_f ∩ D_g, and for f/g also g(x) ≠ 0."
   }
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Domain rules"
   },
   "tex": "\\sqrt{g(x)}: g(x)\\ge0;\\ \\ \\frac1{\\sqrt{g(x)}}: g(x)>0;\\ \\ \\frac1{g(x)}: g(x)\\ne0"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Range by discriminant"
   },
   "tex": "y = \\frac{a_1x^2+b_1x+c_1}{a_2x^2+b_2x+c_2}\\ \\Rightarrow\\ \\text{quadratic in } x \\text{ with } D\\ge0"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Useful ranges"
   },
   "tex": "\\frac{x}{1+x^2}\\in\\left[-\\tfrac12,\\tfrac12\\right],\\ \\frac{x^2}{1+x^2}\\in[0,1),\\ |x-a|+|x-b|\\ge|a-b|"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-maths-02-relations-and-functions.t3",
   "name": {
    "en": "Equal functions"
   },
   "tex": "f = g\\iff D_f = D_g \\text{ and } f(x) = g(x)\\ \\forall x",
   "note": {
    "en": "√(x²) = |x| ≠ x; x²/x ≠ x (domains differ)."
   }
  },
  {
   "id": "zs-f24",
   "name": {
    "en": "Cauchy equation"
   },
   "tex": "f(x+y) = f(x)+f(y)\\Rightarrow f(n) = nf(1),\\ f(0) = 0"
  }
 ]
}
