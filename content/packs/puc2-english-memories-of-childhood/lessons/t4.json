   "heading": {
    "en": "Two kinds of resistance"
   },
   "hook": {
    "en": "One girl fights back by hiding under a bed; the other by studying late into the night. Which kind of resistance lasts longer?"
   },
   "objectives": [
    {
     "en": "Compare the experiences of the two girls"
    },
    {
     "en": "Identify common themes"
    },
    {
     "en": "Discuss equality and dignity today"
    }
   ],
   "narration": {
    "en": "One girl fights back by hiding under a bed; the other by studying late into the night. Which kind of resistance lasts longer?"
