   "name": {
    "en": "Reproductive health (WHO)"
   },
   "tex": "\\text{physical} + \\text{emotional} + \\text{behavioural} + \\text{social well-being}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-03-reproductive-health.t1",
   "name": {
    "en": "Programmes"
   },
   "tex": "\\text{Family planning: } 1951;\\ \\text{RCH programmes}",
   "note": {
    "en": "Statutory ban on amniocentesis for sex determination."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-03-reproductive-health.t2",
   "name": {
    "en": "Population figures"
   },
   "tex": "\\text{World: } 2\\ \\text{bn } (1900) \\to 6\\ \\text{bn } (2000) \\to 7.2\\ \\text{bn } (2011)",
   "note": {
    "en": "India: ~350 million at independence → >1.2 billion in May 2011."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-03-reproductive-health.t2",
   "name": {
    "en": "Natural methods"
   },
   "tex": "\\text{periodic abstinence (days 10–17)},\\ \\text{withdrawal},\\ \\text{lactational amenorrhea } (\\leq 6\\ \\text{mo})"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-03-reproductive-health.t2",
   "name": {
    "en": "Barrier methods"
   },
   "tex": "\\text{condoms (Nirodh)},\\ \\text{diaphragm, cervical cap, vault (reusable)}",
   "note": {
    "en": "Spermicidal creams, jellies and foams increase efficiency. Condoms also protect against STIs."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-03-reproductive-health.t3",
   "name": {
    "en": "IUD types"
   },
   "tex": "\\text{non-medicated: Lippes loop};\\ \\text{Cu: CuT, Cu7, Multiload 375};\\ \\text{hormonal: Progestasert, LNG-20}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-03-reproductive-health.t3",
   "name": {
    "en": "IUD action"
   },
   "tex": "\\uparrow\\ \\text{phagocytosis of sperms};\\ \\text{Cu}^{2+}\\ \\downarrow\\ \\text{sperm motility}",
   "note": {
    "en": "Hormonal IUDs: uterus unsuitable for implantation, cervix hostile to sperms."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-03-reproductive-health.t3",
   "name": {
    "en": "Oral pills"
   },
   "tex": "21\\ \\text{days on (start within first 5 days)} + 7\\ \\text{days gap}",
   "note": {
    "en": "Inhibit ovulation and implantation, alter cervical mucus."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-03-reproductive-health.t3",
   "name": {
    "en": "Saheli"
   },
   "tex": "\\text{CDRI Lucknow; non-steroidal; once a week}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-03-reproductive-health.t3",
   "name": {
    "en": "Emergency contraception"
   },
   "tex": "\\text{within } 72\\ \\text{h}:\\ \\text{progestogen(-estrogen) or IUD}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-03-reproductive-health.t3",
   "name": {
    "en": "Sterilisation"
   },
   "tex": "\\text{vasectomy (vas deferens)};\\ \\text{tubectomy (fallopian tube)}",
   "note": {
    "en": "Highly effective, poor reversibility: terminal method."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-03-reproductive-health.t4",
   "name": {
    "en": "MTP"
   },
   "tex": "\\text{legalised 1971};\\ 45\\text{–}50\\ \\text{million/yr worldwide} \\approx \\tfrac{1}{5}\\ \\text{of pregnancies}",
   "note": {
    "en": "Safe in first trimester. Up to 12 wk: 1 RMP; 12–24 wk: 2 RMPs (as in NCERT; the 2021 Amendment Act uses 20 wk and 20–24 wk)."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-03-reproductive-health.t4",
   "name": {
    "en": "STIs"
   },
   "tex": "\\text{gonorrhoea, syphilis, genital herpes, chlamydiasis, genital warts, trichomoniasis, hepatitis-B, HIV}",
   "note": {
    "en": "Not completely curable: hepatitis-B, genital herpes, HIV. Most vulnerable age: 15–24 years."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "STI complications"
   },
   "tex": "\\text{PID, abortion, still birth, ectopic pregnancy, infertility, reproductive-tract cancer}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-03-reproductive-health.t5",
   "name": {
    "en": "ZIFT vs IUT"
   },
   "tex": "\\text{ZIFT}: \\leq 8\\ \\text{blastomeres} \\to \\text{fallopian tube};\\quad \\text{IUT}: > 8 \\to \\text{uterus}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-03-reproductive-health.t5",
   "name": {
    "en": "Other ART"
   },
   "tex": "\\text{GIFT: donor ovum} \\to \\text{tube};\\ \\text{ICSI: sperm into ovum};\\ \\text{AI/IUI: semen} \\to \\text{vagina/uterus}",
   "note": {
    "en": "IVF + ET = test tube baby programme."
   }
  }
 ]
