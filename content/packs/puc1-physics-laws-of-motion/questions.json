 {
  "id": "1p04-q08",
  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t2",
  "stem": {
   "en": "A 0.2 kg ball moving at 10 m/s hits a wall and rebounds with the same speed. If the contact lasts 0.1 s, the average force on the ball is:"
  },
  "options": [
   {
    "en": "20 N"
   },
   {
    "en": "4 N"
   },
   {
    "en": "40 N"
   },
   {
    "en": "0 N"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Δp = 0.2 × 10 − (−0.2 × 10) = 4 kg m/s. F = Δp/Δt = 4/0.1 = 40 N."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
