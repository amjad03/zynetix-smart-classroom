  "topicId": "puc1-physics-04-laws-of-motion.t1",
  "stem": {
   "en": "Newton's first law of motion gives the concept of:"
  },
  "options": [
   {
    "en": "energy"
   },
   {
    "en": "inertia"
   },
   {
    "en": "work"
   },
   {
    "en": "power"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "The first law says a body keeps its state of rest or uniform motion unless a force acts: that property is inertia."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
