  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t5",
  "stem": {
   "en": "A circular racetrack of radius 300 m is banked at 15°. If μ_s between the tyres and the road is 0.2, the maximum permissible speed is about (g = 9.8 m/s², tan 15° = 0.27):"
  },
  "options": [
   {
    "en": "28.1 m/s"
   },
   {
    "en": "38.1 m/s"
   },
   {
    "en": "48.1 m/s"
   },
   {
    "en": "18.1 m/s"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "v_max = √[Rg(μ_s + tan θ)/(1 − μ_s tan θ)] = √[300 × 9.8 × 0.468/0.946] ≈ √1454 ≈ 38.1 m/s."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
