 {
  "id": "1p04-q03",
  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t1",
  "stem": {
   "en": "A body moves with constant velocity. The net force on it is:"
  },
  "options": [
   {
    "en": "in the direction of motion"
   },
   {
    "en": "opposite to the motion"
   },
   {
    "en": "zero"
   },
   {
    "en": "equal to its weight"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Constant velocity means zero acceleration, so by the first (and second) law the net force is zero."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
