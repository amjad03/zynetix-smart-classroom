  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t3",
  "stem": {
   "en": "Action and reaction forces do not cancel each other because they:"
  },
  "options": [
   {
    "en": "act on different bodies"
   },
   {
    "en": "are unequal"
   },
   {
    "en": "act at different times"
   },
   {
    "en": "act in the same direction"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Forces cancel only when they act on the same body. Action and reaction always act on two different bodies."
  },
