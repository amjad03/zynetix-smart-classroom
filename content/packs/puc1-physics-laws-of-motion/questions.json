  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t2",
  "stem": {
   "en": "A cricketer moves his hands backwards while catching a ball in order to:"
  },
  "options": [
   {
    "en": "increase the impulse"
   },
   {
    "en": "increase the time of impact and so reduce the force"
   },
   {
    "en": "reduce the time of impact"
   },
   {
    "en": "make the change in momentum zero"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "The change in momentum is fixed. Spreading it over a longer time reduces the average force F = Δp/Δt."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
