  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t1",
  "stem": {
   "en": "Standing passengers fall backwards when a bus starts suddenly because of:"
  },
  "options": [
   {
    "en": "inertia of rest"
   },
   {
    "en": "inertia of motion"
   },
   {
    "en": "Newton's third law"
   },
   {
    "en": "friction of the floor"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "The feet move with the bus but the upper body tends to stay at rest (inertia of rest), so it falls backwards."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
