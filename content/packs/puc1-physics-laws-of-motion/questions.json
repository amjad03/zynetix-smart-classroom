  "chapterId": "puc1-physics-04-laws-of-motion",
  "topicId": "puc1-physics-04-laws-of-motion.t1",
  "stem": {
   "en": "Which of these has the greatest inertia?"
  },
  "options": [
   {
    "en": "a 50 g bullet moving at 300 m/s"
   },
   {
    "en": "a 1 kg ball moving at 10 m/s"
   },
   {
    "en": "a 2 kg bat moving at 3 m/s"
   },
   {
    "en": "a 5 kg stone at rest"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Inertia is measured by mass alone, not by speed. The 5 kg stone has the largest mass."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
