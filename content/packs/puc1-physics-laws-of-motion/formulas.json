{
 "chapterId": "puc1-physics-04-laws-of-motion",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Newton's second law"
   },
   "tex": "\\vec F = \\frac{d\\vec p}{dt} = m\\vec a",
   "note": {
    "en": "General form valid for variable mass."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-04-laws-of-motion.t2",
   "name": {
    "en": "Impulse"
   },
   "tex": "\\vec J = \\int\\vec F\\,dt = \\Delta\\vec p",
   "note": {
    "en": "Rebound: Δp = m(u + v)."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Friction"
   },
   "tex": "f_s \\le \\mu_s N,\\qquad f_k = \\mu_k N",
   "note": {
    "en": "Static friction self-adjusts up to its limit."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Apparent weight in lift"
   },
   "tex": "N = m(g \\pm a)",
   "note": {
    "en": "+ when accelerating up, − when down."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Atwood machine"
   },
   "tex": "a = \\frac{(m_1 - m_2)g}{m_1 + m_2},\\quad T = \\frac{2m_1m_2g}{m_1 + m_2}",
   "note": {
    "en": "Light string, frictionless pulley."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Rough incline"
   },
   "tex": "a = g(\\sin\\theta - \\mu\\cos\\theta)",
   "note": {
    "en": "Block sliding down."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Banking of roads"
   },
   "tex": "\\tan\\theta = \\frac{v^2}{rg}",
   "note": {
    "en": "No friction needed at this speed."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Max speed on flat curve"
   },
   "tex": "v_{max} = \\sqrt{\\mu rg}",
   "note": {
    "en": "Friction supplies centripetal force."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-04-laws-of-motion.t1",
   "name": {
    "en": "Newton's first law"
   },
   "tex": "\\sum\\vec F = 0 \\Leftrightarrow \\vec v = \\text{constant}",
   "note": {
    "en": "Defines inertial frames; mass measures inertia."
   }
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Newton's second law"
   },
   "tex": "\\vec F = \\dfrac{d\\vec p}{dt} = m\\vec a\\ (\\text{constant }m)"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-04-laws-of-motion.t3",
   "name": {
    "en": "Variable mass flow"
   },
   "tex": "F = v\\dfrac{dm}{dt}",
   "note": {
    "en": "Conveyor belts, machine guns (F = n m v), water jets."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Impulse"
   },
   "tex": "\\vec J = \\int\\vec F\\,dt = \\Delta\\vec p = \\vec F_{\\text{avg}}\\Delta t",
   "note": {
    "en": "Area under the F–t graph. Larger Δt → smaller force."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Oblique impact on a smooth wall"
   },
   "tex": "|\\Delta p| = 2mv\\cos\\phi",
   "note": {
    "en": "φ measured from the normal; only the normal component reverses."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-04-laws-of-motion.t3",
   "name": {
    "en": "Newton's third law"
   },
   "tex": "\\vec F_{AB} = -\\vec F_{BA}",
   "note": {
    "en": "Act on different bodies, so never cancel each other."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-04-laws-of-motion.t3",
   "name": {
    "en": "Conservation of momentum"
   },
   "tex": "\\sum\\vec F_{\\text{ext}} = 0 \\Rightarrow \\sum m_i\\vec v_i = \\text{constant}",
   "note": {
    "en": "Recoil: MV = mv. Explosion from rest: fragment momenta add to zero."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Equilibrium of a particle"
   },
   "tex": "\\sum F_x = 0,\\quad \\sum F_y = 0"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-04-laws-of-motion.t1",
   "name": {
    "en": "Apparent weight in a lift"
   },
   "tex": "N = m(g + a)\\ \\ (a\\ \\text{upward positive})",
   "note": {
    "en": "Free fall: N = 0. Only the direction of acceleration matters."
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Atwood machine"
   },
   "tex": "a = \\dfrac{(m_1 - m_2)g}{m_1 + m_2},\\qquad T = \\dfrac{2m_1m_2g}{m_1 + m_2}",
   "note": {
    "en": "In a lift accelerating up at a, replace g by g + a."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-04-laws-of-motion.t1",
   "name": {
    "en": "Block on table + hanging block"
   },
   "tex": "a = \\dfrac{m_2g}{m_1 + m_2},\\qquad T = \\dfrac{m_1m_2g}{m_1 + m_2}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Contact force between pushed blocks"
   },
   "tex": "N = \\dfrac{m_2F}{m_1 + m_2}",
   "note": {
    "en": "F applied on m₁; N acts on m₂."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-04-laws-of-motion.t4",
   "name": {
    "en": "Static and kinetic friction"
   },
   "tex": "f_s \\le \\mu_sN,\\qquad f_k = \\mu_kN,\\qquad \\mu_k < \\mu_s",
   "note": {
    "en": "Static friction is self-adjusting; independent of apparent contact area."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Angle of repose / friction"
   },
   "tex": "\\tan\\theta_r = \\mu_s,\\qquad \\tan\\lambda = \\mu"
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Rough incline"
   },
   "tex": "a_{\\text{sliding down}} = g(\\sin\\theta - \\mu\\cos\\theta),\\qquad a_{\\text{sliding up (retardation)}} = g(\\sin\\theta + \\mu\\cos\\theta)"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Pull vs push at angle θ"
   },
   "tex": "N_{\\text{pull}} = mg - F\\sin\\theta,\\qquad N_{\\text{push}} = mg + F\\sin\\theta"
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Least force to drag a block"
   },
   "tex": "F_{\\min} = \\dfrac{\\mu mg}{\\sqrt{1 + \\mu^2}}\\ \\text{at}\\ \\tan\\theta = \\mu"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Block held against a wall"
   },
   "tex": "F_{\\min} = \\dfrac{mg}{\\mu_s}"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-physics-04-laws-of-motion.t1",
   "name": {
    "en": "Two blocks moving together"
   },
   "tex": "F_{\\max} = \\mu_s(m_1 + m_2)g\\ \\ (\\text{force on lower block})",
   "note": {
    "en": "Force on the upper block: F_max = μ m₁ g (m₁ + m₂)/m₂."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-physics-04-laws-of-motion.t1",
   "name": {
    "en": "Hanging chain on a rough table"
   },
   "tex": "\\dfrac{l_{\\text{hang}}}{L} = \\dfrac{\\mu}{1 + \\mu}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Level curve"
   },
   "tex": "v_{\\max} = \\sqrt{\\mu_srg}"
  },
  {
   "id": "zs-f30",
   "name": {
    "en": "Banked curve"
   },
   "tex": "v_0 = \\sqrt{rg\\tan\\theta},\\qquad v_{\\max} = \\sqrt{rg\\dfrac{\\mu + \\tan\\theta}{1 - \\mu\\tan\\theta}}"
  },
  {
   "id": "zs-f31",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Vertical circle (string)"
   },
   "tex": "T_{\\text{bottom}} = mg + \\dfrac{mv^2}{r},\\quad T_{\\text{top}} = \\dfrac{mv^2}{r} - mg,\\quad v_{\\text{top,min}} = \\sqrt{gr},\\ v_{\\text{bottom,min}} = \\sqrt{5gr}"
  },
  {
   "id": "zs-f32",
   "topicId": "puc1-physics-04-laws-of-motion.t5",
   "name": {
    "en": "Pseudo force"
   },
   "tex": "\\vec F_{\\text{pseudo}} = -m\\vec a_{\\text{frame}}",
   "note": {
    "en": "Block at rest on a smooth wedge: a = g tan θ."
   }
  }
 ]
}
