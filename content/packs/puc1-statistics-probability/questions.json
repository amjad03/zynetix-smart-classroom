 {
  "id": "1t10-q02",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t1",
  "stem": {
   "en": "Events that cannot happen together are called:"
  },
  "options": [
   {
    "en": "mutually exclusive"
   },
   {
    "en": "exhaustive"
   },
   {
    "en": "equally likely"
   },
   {
    "en": "independent"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Mutually exclusive events have no common outcome: A ∩ B = ∅."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t10-q03",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t1",
  "stem": {
   "en": "When a die is thrown, the events \"an even number\" and \"an odd number\" are:"
  },
