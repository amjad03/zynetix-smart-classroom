 },
 {
  "id": "1t10-q17",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t4",
  "stem": {
   "en": "A hits a target with probability 0.6 and B with probability 0.5, independently. The probability that the target is hit is:"
  },
  "options": [
   {
    "en": "0.3"
   },
   {
    "en": "0.8"
   },
   {
    "en": "1.1"
   },
   {
    "en": "0.2"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "P(hit) = 1 − P(both miss) = 1 − 0.4 × 0.5 = 0.8."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t10-q18",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t5",
  "stem": {
   "en": "In Bayes' theorem, the probabilities P(Eᵢ) known before the experiment are called:"
  },
  "options": [
   {
    "en": "prior probabilities"
   },
   {
    "en": "joint probabilities"
   },
   {
    "en": "posterior probabilities"
   },
   {
    "en": "conditional probabilities"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "P(Eᵢ) are prior; P(Eᵢ | A), revised after A is observed, are posterior."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t10-q19",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t5",
  "stem": {
   "en": "Machines M₁ and M₂ make 60% and 40% of the items, with 2% and 3% defective. The probability that a randomly chosen item is defective is:"
  },
  "options": [
   {
    "en": "0.05"
   },
   {
    "en": "0.012"
   },
   {
    "en": "0.024"
   },
   {
    "en": "0.025"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Total probability: 0.6 × 0.02 + 0.4 × 0.03 = 0.012 + 0.012 = 0.024."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t10-q20",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t5",
  "stem": {
   "en": "Bag I has 3 red and 2 black balls, bag II has 2 red and 3 black. A bag is chosen at random and a red ball is drawn. The probability that it came from bag I is:"
  },
  "options": [
   {
    "en": "3/10"
   },
   {
    "en": "3/5"
   },
   {
    "en": "1/2"
   },
   {
    "en": "2/5"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "P(I | R) = (½ × 3/5)/(½ × 3/5 + ½ × 2/5) = (3/10)/(5/10) = 3/5."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t10-q21",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t5",
  "stem": {
   "en": "Machines A, B, C make 50%, 30% and 20% of the output, with 1%, 2% and 3% defective. A defective item is found. The probability that it was made by C is about:"
  },
  "options": [
   {
    "en": "0.2"
   },
   {
    "en": "0.353"
   },
   {
    "en": "0.006"
   },
   {
    "en": "0.03"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "P(D) = 0.005 + 0.006 + 0.006 = 0.017; P(C | D) = 0.006/0.017 = 6/17 ≈ 0.353."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "1t10-q22",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t1",
  "stem": {
   "en": "Three coins are tossed. The probability of getting at least one head is:"
  },
  "options": [
   {
    "en": "1/8"
   },
   {
    "en": "1/2"
   },
   {
    "en": "7/8"
   },
   {
    "en": "3/8"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "P(at least one head) = 1 − P(no head) = 1 − 1/8 = 7/8."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t10-q23",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t2",
  "stem": {
   "en": "The probability that a leap year selected at random has 53 Sundays is:"
  },
  "options": [
   {
    "en": "1/7"
   },
   {
    "en": "3/7"
   },
   {
    "en": "2/7"
   },
   {
    "en": "53/366"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "A leap year has 52 weeks and 2 extra days. Of the 7 equally likely pairs (Sun–Mon, Mon–Tue, …, Sat–Sun), 2 contain a Sunday: 2/7."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t10-q24",
  "chapterId": "puc1-statistics-10-probability",
  "topicId": "puc1-statistics-10-probability.t4",
  "stem": {
   "en": "A and B are independent, P(A) = 1/2 and P(B) = 1/3. Then P(A ∪ B) is:"
  },
  "options": [
   {
    "en": "1/6"
   },
   {
    "en": "2/3"
   },
   {
    "en": "5/6"
   },
   {
    "en": "1/2"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "P(A ∪ B) = 1/2 + 1/3 − 1/2 × 1/3 = 5/6 − 1/6 = 2/3."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 }
]
