{
 "chapterId": "puc1-biology-07-structural-organisation-in-animals",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Four basic tissues"
   },
   "tex": "\\text{epithelial, connective, muscular, neural}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t1",
   "name": {
    "en": "Simple epithelia"
   },
   "tex": "\\text{squamous (alveoli, vessels)};\\ \\text{cuboidal (gland ducts, PCT)};\\ \\text{columnar (stomach, intestine)}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t1",
   "name": {
    "en": "Ciliated epithelium"
   },
   "tex": "\\text{bronchioles, fallopian tubes}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t1",
   "name": {
    "en": "Compound epithelium"
   },
   "tex": "\\text{skin, buccal cavity, pharynx, salivary and pancreatic ducts}",
   "note": {
    "en": "Protection against chemical and mechanical stress."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t1",
   "name": {
    "en": "Glands"
   },
   "tex": "\\text{unicellular (goblet)};\\ \\text{multicellular (salivary)};\\ \\text{exocrine (ducts)} \\ne \\text{endocrine (hormones)}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t1",
   "name": {
    "en": "Cell junctions"
   },
   "tex": "\\text{tight (no leak)};\\ \\text{adhering (cement)};\\ \\text{gap (cytoplasmic connection)}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t2",
   "name": {
    "en": "Loose connective"
   },
   "tex": "\\text{areolar (fibroblasts, macrophages, mast cells)};\\ \\text{adipose (fat)}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t2",
   "name": {
    "en": "Dense connective"
   },
   "tex": "\\text{regular: tendon (muscle–bone), ligament (bone–bone)};\\ \\text{irregular: skin}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t2",
   "name": {
    "en": "Specialised connective"
   },
   "tex": "\\text{cartilage (chondrocytes)};\\ \\text{bone (osteocytes in lacunae)};\\ \\text{blood}"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Muscles"
   },
   "tex": "\\text{skeletal (striated)};\\ \\text{smooth (fusiform, involuntary)};\\ \\text{cardiac (intercalated discs)}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t3",
   "name": {
    "en": "Neural tissue"
   },
   "tex": "\\text{neuroglia} > \\tfrac{1}{2}\\ \\text{volume of neural tissue}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t4",
   "name": {
    "en": "Frog"
   },
   "tex": "\\textit{Rana tigrina}:\\ \\text{poikilotherm; colour change (mimicry); aestivation, hibernation}",
   "note": {
    "en": "Never drinks water: absorbs it through the moist skin."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t4",
   "name": {
    "en": "External features"
   },
   "tex": "\\text{head + trunk (no neck, no tail); nictitating membrane; tympanum}",
   "note": {
    "en": "Forelimbs 4 digits; hind limbs 5 webbed digits."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t4",
   "name": {
    "en": "Sexual dimorphism"
   },
   "tex": "\\text{male: vocal sacs + copulatory pad on first digit of forelimb}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Digestion"
   },
   "tex": "\\text{bilobed tongue; short gut (carnivore); bile} \\to \\text{gall bladder; cloaca}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Respiration"
   },
   "tex": "\\text{water: skin (cutaneous)};\\ \\text{land: buccal cavity, skin, lungs}",
   "note": {
    "en": "Aestivation and hibernation: through skin."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Circulation"
   },
   "tex": "\\text{closed; heart} = 2\\ \\text{atria} + 1\\ \\text{ventricle};\\ \\text{sinus venosus} \\to \\text{right atrium};\\ \\text{conus arteriosus}",
   "note": {
    "en": "Hepatic portal and renal portal systems; RBCs nucleated."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Excretion"
   },
   "tex": "\\text{kidneys, ureters, cloaca, urinary bladder; ureotelic}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Nervous system"
   },
   "tex": "\\text{forebrain (olfactory lobes, cerebrum, diencephalon); midbrain (optic lobes); hindbrain (cerebellum, medulla)}",
   "note": {
    "en": "10 pairs of cranial nerves."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Male reproduction"
   },
   "tex": "\\text{testis} \\xrightarrow{\\text{mesorchium}} \\text{kidney};\\ 10\\text{–}12\\ \\text{vasa efferentia} \\to \\text{Bidder's canal} \\to \\text{urinogenital duct} \\to \\text{cloaca}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-biology-07-structural-organisation-in-animals.t5",
   "name": {
    "en": "Female reproduction"
   },
   "tex": "\\text{ovaries (no link with kidneys); oviducts open separately};\\ 2500\\text{–}3000\\ \\text{ova}",
   "note": {
    "en": "External fertilisation; tadpole; metamorphosis."
   }
  }
 ]
}
