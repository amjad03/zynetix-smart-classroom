   "heading": {
    "en": "A tiny tank for charge",
    "kn": "ಆವೇಶಕ್ಕೊಂದು ಚಿಕ್ಕ ತೊಟ್ಟಿ"
   },
   "hook": {
    "en": "A camera flash charges a capacitor for a few seconds and then empties it into the lamp in a thousandth of a second. Capacitors store charge and energy.",
    "kn": "ಕ್ಯಾಮರಾ ಫ್ಲ್ಯಾಶ್ ಕೆಲವು ಸೆಕೆಂಡುಗಳ ಕಾಲ ಧಾರಕವನ್ನು ಆವೇಶಗೊಳಿಸಿ ಸೆಕೆಂಡಿನ ಸಾವಿರದ ಒಂದು ಭಾಗದಲ್ಲಿ ದೀಪಕ್ಕೆ ಖಾಲಿ ಮಾಡುತ್ತದೆ. ಧಾರಕಗಳು ಆವೇಶ ಮತ್ತು ಶಕ್ತಿಯನ್ನು ಸಂಗ್ರಹಿಸುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "Define capacitance and its unit"
    },
    {
     "en": "Use C = ε₀εᵣA/d and W = ½CV²"
    },
    {
     "en": "Combine capacitors in series and parallel and read their codes"
    }
   ],
   "narration": {
    "en": "A camera flash charges a capacitor for a few seconds and then empties it into the lamp in a thousandth of a second. Capacitors store charge and energy.",
    "kn": "ಕ್ಯಾಮರಾ ಫ್ಲ್ಯಾಶ್ ಕೆಲವು ಸೆಕೆಂಡುಗಳ ಕಾಲ ಧಾರಕವನ್ನು ಆವೇಶಗೊಳಿಸಿ ಸೆಕೆಂಡಿನ ಸಾವಿರದ ಒಂದು ಭಾಗದಲ್ಲಿ ದೀಪಕ್ಕೆ ಖಾಲಿ ಮಾಡುತ್ತದೆ. ಧಾರಕಗಳು ಆವೇಶ ಮತ್ತು ಶಕ್ತಿಯನ್ನು ಸಂಗ್ರಹಿಸುತ್ತವೆ."
