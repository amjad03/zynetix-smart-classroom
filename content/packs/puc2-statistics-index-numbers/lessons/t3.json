   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Fisher, Dorbish–Bowley, Marshall–Edgeworth and Kelly"
   },
   "body": {
    "en": "Dorbish–Bowley: $\\frac{L + P}{2}$ (AM). *Fisher*'s: $\\sqrt{L \\times P}$ (GM), the ideal index. Marshall–Edgeworth uses $q_0 + q_1$ as weights: $\\frac{\\sum p_1(q_0+q_1)}{\\sum p_0(q_0+q_1)} \\times 100$. Kelly's uses fixed quantities $q$ of some period: $\\frac{\\sum p_1 q}{\\sum p_0 q} \\times 100$."
   },
   "points": [
    {
     "en": "*Fisher*'s = √(L × P)"
    },
    {
     "en": "*Dorbish*–Bowley = (L + P)/2"
    },
    {
     "en": "*Marshall*–Edgeworth: weights q₀ + q₁"
    }
   ],
   "narration": {
    "en": "Dorbish and Bowley take the arithmetic mean of Laspeyres and Paasche; Fisher takes their geometric mean. Marshall and Edgeworth use the sum of the two quantities as weights, and Kelly uses fixed quantities.",
    "kn": "ಡಾರ್ಬಿಶ್–ಬೌಲೆ ಸೂಚ್ಯಂಕ L ಮತ್ತು P ಗಳ ಅಂಕಗಣಿತೀಯ ಸರಾಸರಿ; ಫಿಶರ್ ಸೂಚ್ಯಂಕ ಅವುಗಳ ಗುಣೋತ್ತರ ಸರಾಸರಿ. ಮಾರ್ಷಲ್–ಎಡ್ಜ್‌ವರ್ತ್ q₀ + q₁ ಅನ್ನು ತೂಕವಾಗಿ ಬಳಸುತ್ತದೆ."
   },
   "formula": "P_{01}^{F} = \\sqrt{P_{01}^{L} \\times P_{01}^{P}}",
   "reveal": true,
   "voice": [
    {
     "say": {
      "en": "Dorbish and Bowley take the arithmetic mean of Laspeyres and Paasche; Fisher takes their geometric mean. Marshall and Edgeworth use the sum of the two quantities as weights, and Kelly uses fixed quantities. Fisher's equals the square root of L times P.",
      "kn": "ಡಾರ್ಬಿಶ್-ಬೌಲೆ ಸೂಚ್ಯಂಕ L ಮತ್ತು P ಗಳ ಅಂಕಗಣಿತೀಯ ಸರಾಸರಿ; ಫಿಶರ್ ಸೂಚ್ಯಂಕ ಅವುಗಳ ಗುಣೋತ್ತರ ಸರಾಸರಿ. ಮಾರ್ಷಲ್-ಎಡ್ಜ್‌ವರ್ತ್ q 0 plus q 1 ಅನ್ನು ತೂಕವಾಗಿ ಬಳಸುತ್ತದೆ."
     }
    },
    {
     "say": {
      "en": "Dorbish-Bowley equals L plus P/2."
     }
    },
    {
     "say": {
      "en": "Marshall-Edgeworth: weights q 0 plus q 1."
     }
    }
   ]
  },
