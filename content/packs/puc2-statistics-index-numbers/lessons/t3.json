  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Laspeyres' and Paasche's indices"
   },
   "body": {
    "en": "Weighted aggregative indices weight each price by a quantity. Laspeyres' uses base-year quantities: $P_{01}^{L} = \\frac{\\sum p_1 q_0}{\\sum p_0 q_0} \\times 100$. Paasche's uses current-year quantities: $P_{01}^{P} = \\frac{\\sum p_1 q_1}{\\sum p_0 q_1} \\times 100$. Laspeyres' tends to overstate and Paasche's to understate the price rise."
   },
   "points": [
    {
     "en": "Laspeyres': weights q₀"
    },
    {
     "en": "Paasche's: weights q₁"
    }
   ],
   "narration": {
    "en": "Laspeyres' index weights prices by base-year quantities; Paasche's index by current-year quantities.",
    "kn": "ಲ್ಯಾಸ್ಪೇರ್ ಸೂಚ್ಯಂಕವು ಆಧಾರ ವರ್ಷದ ಪ್ರಮಾಣಗಳನ್ನು, ಪಾಷೆ ಸೂಚ್ಯಂಕವು ಪ್ರಸಕ್ತ ವರ್ಷದ ಪ್ರಮಾಣಗಳನ್ನು ತೂಕವಾಗಿ ಬಳಸುತ್ತದೆ."
   },
   "formula": "P_{01}^{L} = \\frac{\\sum p_1 q_0}{\\sum p_0 q_0}\\times 100, \\quad P_{01}^{P} = \\frac{\\sum p_1 q_1}{\\sum p_0 q_1}\\times 100"
  },
