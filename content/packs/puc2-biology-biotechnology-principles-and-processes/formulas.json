{
 "chapterId": "puc2-biology-09-biotechnology-principles-and-processes",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t1",
   "name": {
    "en": "Core principles"
   },
   "tex": "\\text{Genetic engineering} + \\text{bioprocess engineering (sterile, large-scale culture)}",
   "note": {
    "en": "EFB: integrating natural science and organisms, cells, parts thereof and molecular analogues for products and services."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Steps of rDNA technology"
   },
   "tex": "\\text{Isolate DNA} \\to \\text{cut (RE)} \\to \\text{isolate fragment} \\to \\text{ligate into vector} \\to \\text{transform host} \\to \\text{culture} \\to \\text{extract product}"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "First recombinant DNA (1972)"
   },
   "tex": "\\text{Cohen \\& Boyer: antibiotic-resistance gene} + \\text{native plasmid of } \\textit{Salmonella typhimurium}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t2",
   "name": {
    "en": "Restriction enzyme naming"
   },
   "tex": "\\text{EcoRI}: E = \\textit{Escherichia},\\ co = \\textit{coli},\\ R = \\text{strain RY 13},\\ I = \\text{first isolated}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t2",
   "name": {
    "en": "Restriction enzyme facts"
   },
   "tex": "\\text{Hind II: first sequence-specific RE, 6-bp site};\\ >900 \\text{ REs from } >230 \\text{ strains}",
   "note": {
    "en": "Exonuclease: removes nucleotides from ends; endonuclease: cuts within DNA."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t2",
   "name": {
    "en": "Palindrome and sticky ends"
   },
   "tex": "5'\\text{-G}\\downarrow\\text{AATTC-}3' \\Rightarrow \\text{overhang } 5'\\text{-AATT}",
   "note": {
    "en": "Same RE must cut vector and source DNA; DNA ligase seals the ends."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t2",
   "name": {
    "en": "Gel electrophoresis"
   },
   "tex": "\\text{DNA}(-) \\to \\text{anode};\\ \\text{smaller fragments move farther}",
   "note": {
    "en": "Agarose from sea weeds; ethidium bromide + UV gives bright orange bands; bands cut out and extracted = elution."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t3",
   "name": {
    "en": "Vector features"
   },
   "tex": "\\text{ori (copy number)},\\ \\text{selectable marker},\\ \\text{single cloning site}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t3",
   "name": {
    "en": "Selectable markers for E. coli"
   },
   "tex": "amp^R,\\ tet^R,\\ kan^R,\\ cml^R"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t3",
   "name": {
    "en": "pBR322 map"
   },
   "tex": "\\text{BamHI, SalI} \\in tet^R;\\quad \\text{PstI, PvuI} \\in amp^R;\\quad rop = \\text{replication proteins}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t3",
   "name": {
    "en": "Insertional inactivation (antibiotic)"
   },
   "tex": "\\text{insert in } tet^R \\Rightarrow \\text{grows on amp, not on tet}",
   "note": {
    "en": "Needs replica plating on two plates — cumbersome."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t3",
   "name": {
    "en": "Blue–white screening"
   },
   "tex": "\\text{insert in } lacZ\\ (\\beta\\text{-gal}) \\Rightarrow \\text{colourless (recombinant)};\\ \\text{no insert} \\Rightarrow \\text{blue}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t1",
   "name": {
    "en": "Natural vectors"
   },
   "tex": "\\text{Ti plasmid } (\\textit{Agrobacterium tumefaciens}) \\to \\text{plants};\\ \\text{disarmed retroviruses} \\to \\text{animals}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t3",
   "name": {
    "en": "Making host competent"
   },
   "tex": "\\text{Ca}^{2+} \\to \\text{ice} \\to 42^\\circ\\text{C heat shock} \\to \\text{ice}",
   "note": {
    "en": "DNA is hydrophilic, so cannot cross membranes unaided. Other methods: microinjection (animal nucleus), biolistics (gold/tungsten), disarmed pathogens."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t4",
   "name": {
    "en": "Enzymes for DNA isolation"
   },
   "tex": "\\text{bacteria: lysozyme; plant: cellulase; fungus: chitinase; RNase, protease}",
   "note": {
    "en": "Purified DNA precipitates with chilled ethanol as fine threads (spooling)."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t4",
   "name": {
    "en": "PCR steps"
   },
   "tex": "\\text{Denaturation} \\to \\text{Annealing (primers)} \\to \\text{Extension (Taq polymerase)}",
   "note": {
    "en": "Taq polymerase from Thermus aquaticus is thermostable."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t4",
   "name": {
    "en": "PCR amplification"
   },
   "tex": "N = N_0 \\times 2^{n}",
   "note": {
    "en": "About 1 billion copies after ~30 cycles (2^30 ≈ 10^9)."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t5",
   "name": {
    "en": "Bioreactors"
   },
   "tex": "100\\text{–}1000\\ \\text{L};\\ \\text{stirred-tank and sparged stirred-tank}",
   "note": {
    "en": "Parts: agitator, oxygen delivery, foam control, temperature and pH control, sampling ports."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t5",
   "name": {
    "en": "Continuous culture"
   },
   "tex": "\\text{drain used medium} + \\text{add fresh} \\Rightarrow \\text{cells kept in log phase}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-biology-09-biotechnology-principles-and-processes.t5",
   "name": {
    "en": "Downstream processing"
   },
   "tex": "\\text{separation} \\to \\text{purification} \\to \\text{formulation (preservatives)} \\to \\text{clinical trials, QC}"
  }
 ]
}
