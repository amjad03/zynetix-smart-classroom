 "topicId": "puc2-electronics-01-transistor-amplifiers.t5",
 "title": {
  "en": "Power amplifiers: class A, B, AB and C",
  "kn": "ಶಕ್ತಿ ವರ್ಧಕಗಳು: ವರ್ಗ A, B, AB ಮತ್ತು C"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Driving the loudspeaker",
    "kn": "ಧ್ವನಿವರ್ಧಕವನ್ನು ನಡೆಸುವುದು"
   },
   "hook": {
    "en": "The last stage of a music system must deliver watts of power to a low-resistance speaker, and waste as little as possible as heat. That is the job of a power amplifier.",
    "kn": "ಸಂಗೀತ ವ್ಯವಸ್ಥೆಯ ಕೊನೆಯ ಹಂತ ಕಡಿಮೆ ರೋಧದ ಸ್ಪೀಕರ್‌ಗೆ ವ್ಯಾಟ್‌ಗಳ ಶಕ್ತಿ ನೀಡಬೇಕು ಮತ್ತು ಕಡಿಮೆ ಶಾಖ ವ್ಯರ್ಥ ಮಾಡಬೇಕು. ಇದು ಶಕ್ತಿ ವರ್ಧಕದ ಕೆಲಸ."
   },
   "objectives": [
    {
     "en": "Distinguish voltage and power amplifiers"
    },
    {
     "en": "Classify power amplifiers by conduction angle"
    },
    {
     "en": "Calculate the efficiency of class A and class B amplifiers"
    }
   ],
   "narration": {
    "en": "The last stage of a music system must deliver watts of power to a low-resistance speaker, and waste as little as possible as heat. That is the job of a power amplifier.",
    "kn": "ಸಂಗೀತ ವ್ಯವಸ್ಥೆಯ ಕೊನೆಯ ಹಂತ ಕಡಿಮೆ ರೋಧದ ಸ್ಪೀಕರ್‌ಗೆ ವ್ಯಾಟ್‌ಗಳ ಶಕ್ತಿ ನೀಡಬೇಕು ಮತ್ತು ಕಡಿಮೆ ಶಾಖ ವ್ಯರ್ಥ ಮಾಡಬೇಕು. ಇದು ಶಕ್ತಿ ವರ್ಧಕದ ಕೆಲಸ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Power amplifiers and their classes"
   },
   "body": {
    "en": "A voltage amplifier handles small signals and raises the voltage; a power amplifier handles large signals and delivers power to a low-impedance load such as a speaker. Power transistors have a large area and are mounted on heat sinks. Power amplifiers are classified by the part of the input cycle for which collector current flows (conduction angle): class A, 360°; class B, 180°; class AB, between 180° and 360°; class C, less than 180°."
   },
   "points": [
    {
     "en": "Class A: 360°"
    },
    {
     "en": "Class B: 180°"
    },
    {
     "en": "Class AB: between 180° and 360°"
    },
    {
     "en": "Class C: less than 180° (tuned RF amplifiers)"
    }
   ],
   "narration": {
    "en": "Power amplifiers are classed by how long the collector current flows: the whole cycle in class A, half in class B, a little more than half in AB, and less than half in C.",
    "kn": "ಕಲೆಕ್ಟರ್ ಪ್ರವಾಹ ಹರಿಯುವ ಕೋನದ ಆಧಾರದ ಮೇಲೆ ಶಕ್ತಿ ವರ್ಧಕಗಳ ವರ್ಗೀಕರಣ: ವರ್ಗ A 360°, ವರ್ಗ B 180°, ವರ್ಗ AB 180° ಮತ್ತು 360° ನಡುವೆ, ವರ್ಗ C 180° ಕ್ಕಿಂತ ಕಡಿಮೆ."
   }
  },
