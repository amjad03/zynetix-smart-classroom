   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A class B push-pull amplifier works from VCC = 20 V and gives a peak output of 16 V across an 8 Ω load. Find the AC output power, the DC input power and the efficiency."
   },
   "steps": [
    {
     "en": "Pac = Vp²/(2RL) = 16²/(2 × 8) = 256/16 = 16 W."
    },
    {
     "en": "Peak current Ip = 16/8 = 2 A; IDC = 2Ip/π = 1.273 A."
    },
    {
     "en": "Pdc = VCC × IDC = 20 × 1.273 = 25.46 W."
    },
    {
     "en": "η = 16/25.46 × 100 = 62.8% (check: 78.5% × 16/20 = 62.8%)."
    }
   ],
   "answer": {
    "en": "16 W, 25.5 W, about 63%"
   },
