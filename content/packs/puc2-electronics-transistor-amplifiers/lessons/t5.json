  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Efficiency and the push-pull amplifier"
   },
   "body": {
    "en": "Collector efficiency is $\\eta = P_{ac}/P_{dc} \\times 100\\%$. The maximum is 25% for a class A amplifier with a resistive load, 50% for a transformer-coupled class A amplifier, and $\\pi/4 = 78.5\\%$ for a class B push-pull amplifier. In push-pull, two transistors each amplify one half-cycle and the output transformer (or a complementary pair) joins the halves. Near zero crossing both transistors are briefly off, causing crossover distortion; a small forward bias (class AB) removes it. Class C, above 90%, is used only with a tuned load in RF transmitters."
   },
   "points": [
    {
     "en": "η = Pac/Pdc × 100%"
    },
    {
     "en": "Class A: 25% (resistive), 50% (transformer)"
    },
    {
     "en": "Class B push-pull: 78.5%"
    },
    {
     "en": "Crossover distortion in class B; cured by class AB bias"
    }
   ],
   "narration": {
    "en": "Efficiency is AC output power over DC input power. Class B push-pull reaches 78.5 percent but shows crossover distortion, which class AB bias removes.",
    "kn": "ದಕ್ಷತೆ = AC ಔಟ್‌ಪುಟ್ ಶಕ್ತಿ ÷ DC ಇನ್‌ಪುಟ್ ಶಕ್ತಿ. ವರ್ಗ B ಪುಶ್-ಪುಲ್ 78.5% ತಲುಪುತ್ತದೆ, ಆದರೆ ಕ್ರಾಸ್‌ಓವರ್ ವಿಕೃತಿ ಇದೆ; ವರ್ಗ AB ಬಯಾಸ್ ಅದನ್ನು ತೆಗೆಯುತ್ತದೆ."
   },
   "formula": "\\eta = \\frac{P_{ac}}{P_{dc}} \\times 100\\%, \\qquad \\eta_{B,max} = \\frac{\\pi}{4} = 78.5\\%"
  },
