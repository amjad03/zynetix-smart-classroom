 "title": {
  "en": "Multistage amplifiers and coupling",
  "kn": "ಬಹುಹಂತ ವರ್ಧಕಗಳು ಮತ್ತು ಜೋಡಣೆ ವಿಧಾನಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "One stage is not enough",
    "kn": "ಒಂದು ಹಂತ ಸಾಕಾಗುವುದಿಲ್ಲ"
   },
   "hook": {
    "en": "A radio receives microvolts from its aerial but must drive a speaker. No single transistor gives that much gain, so we connect stages one after another.",
    "kn": "ರೇಡಿಯೋ ಆಂಟೆನಾದಿಂದ ಮೈಕ್ರೋವೋಲ್ಟ್ ಪಡೆಯುತ್ತದೆ, ಆದರೆ ಸ್ಪೀಕರ್ ನಡೆಸಬೇಕು. ಒಂದೇ ಟ್ರಾನ್ಸಿಸ್ಟರ್ ಅಷ್ಟು ವರ್ಧನೆ ನೀಡದು, ಆದ್ದರಿಂದ ಹಂತಗಳನ್ನು ಒಂದರ ನಂತರ ಒಂದು ಜೋಡಿಸುತ್ತೇವೆ."
   },
   "objectives": [
    {
     "en": "Find the overall gain of a multistage amplifier"
    },
    {
     "en": "Compare RC, transformer and direct coupling"
    },
    {
     "en": "Choose a coupling method for a given use"
    }
   ],
   "narration": {
    "en": "A radio receives microvolts from its aerial but must drive a speaker. No single transistor gives that much gain, so we connect stages one after another.",
    "kn": "ರೇಡಿಯೋ ಆಂಟೆನಾದಿಂದ ಮೈಕ್ರೋವೋಲ್ಟ್ ಪಡೆಯುತ್ತದೆ, ಆದರೆ ಸ್ಪೀಕರ್ ನಡೆಸಬೇಕು. ಒಂದೇ ಟ್ರಾನ್ಸಿಸ್ಟರ್ ಅಷ್ಟು ವರ್ಧನೆ ನೀಡದು, ಆದ್ದರಿಂದ ಹಂತಗಳನ್ನು ಒಂದರ ನಂತರ ಒಂದು ಜೋಡಿಸುತ್ತೇವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Overall gain of cascaded stages"
   },
   "body": {
    "en": "When stages are cascaded, the output of one stage is the input of the next, so the overall voltage gain is the product $A = A_1 A_2 A_3 \\dots$ (each gain taken with the loading of the next stage). In decibels the gains add: $G = G_1 + G_2 + G_3$. The bandwidth of a multistage amplifier is less than that of a single stage, because the gain of every stage falls at the band edges."
   },
   "points": [
    {
     "en": "A = A1 × A2 × A3 …"
    },
    {
     "en": "G(dB) = G1 + G2 + G3 …"
    },
    {
     "en": "Overall bandwidth is less than one stage"
    }
   ],
   "narration": {
    "en": "The overall gain of cascaded stages is the product of the stage gains, or the sum of their decibel gains.",
    "kn": "ಬಹುಹಂತ ವರ್ಧಕದ ಒಟ್ಟು ವರ್ಧನೆ ಹಂತಗಳ ವರ್ಧನೆಗಳ ಗುಣಲಬ್ಧ; ಡೆಸಿಬೆಲ್‌ನಲ್ಲಿ ಅವುಗಳ ಮೊತ್ತ. ಒಟ್ಟು ಬ್ಯಾಂಡ್‌ವಿಡ್ತ್ ಒಂದು ಹಂತಕ್ಕಿಂತ ಕಡಿಮೆ."
   },
   "formula": "A = A_1 A_2 A_3, \\qquad G_{dB} = G_1 + G_2 + G_3"
  },
