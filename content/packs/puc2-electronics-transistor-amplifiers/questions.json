  "stem": {
   "en": "In a CE amplifier the emitter bypass capacitor CE is used to:"
  },
  "options": [
   {
    "en": "raise the frequency of the input"
   },
   {
    "en": "prevent the loss of AC voltage gain due to RE"
   },
