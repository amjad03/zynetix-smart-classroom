  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "1's and 2's complement"
   },
   "body": {
    "en": "The 1's complement of a binary number is obtained by inverting every bit (0 → 1, 1 → 0). The 2's complement is the 1's complement plus 1. A quick way: copy bits from the right up to and including the first 1, then invert all remaining bits. In signed 2's complement form the MSB is the sign bit (0 = positive, 1 = negative); an n-bit number covers $-2^{n-1}$ to $2^{n-1}-1$."
   },
   "points": [
    {
     "en": "1's complement: invert all bits"
    },
    {
     "en": "2's complement = 1's complement + 1"
    },
    {
     "en": "8-bit signed range: −128 to +127"
    }
   ],
   "narration": {
    "en": "Flip every bit for the one's complement. Add one more for the two's complement. In signed numbers the leftmost bit tells the sign.",
    "kn": "ಪ್ರತಿ ಬಿಟ್ ತಿರುಗಿಸಿದರೆ 1ರ ಪೂರಕ. ಅದಕ್ಕೆ ಒಂದು ಸೇರಿಸಿದರೆ 2ರ ಪೂರಕ. ಚಿಹ್ನೆಯ ಸಂಖ್ಯೆಗಳಲ್ಲಿ ಎಡತುದಿಯ ಬಿಟ್ ಚಿಹ್ನೆಯನ್ನು ತಿಳಿಸುತ್ತದೆ."
   },
   "formula": "\\text{2's complement of } N = (2^n - N)"
  },
