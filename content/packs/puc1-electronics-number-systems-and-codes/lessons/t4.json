  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Subtraction using complements"
   },
   "body": {
    "en": "To find A − B with 2's complement: add A to the 2's complement of B (same number of bits). If there is a final carry, discard it: the result is positive. If there is no carry, the result is negative and is in 2's complement form; take its 2's complement and put a minus sign. With 1's complement, a final carry is added back to the LSB (end-around carry)."
   },
   "points": [
    {
     "en": "A − B = A + (2's complement of B)"
    },
    {
     "en": "Carry → discard, result positive"
    },
    {
     "en": "No carry → result negative; re-complement it"
    }
   ],
   "narration": {
    "en": "To subtract, add the two's complement. A carry out means a positive answer; no carry means a negative answer that must be complemented again.",
    "kn": "ಕಳೆಯಲು 2ರ ಪೂರಕವನ್ನು ಕೂಡಿಸಿ. ಕ್ಯಾರಿ ಬಂದರೆ ಉತ್ತರ ಧನಾತ್ಮಕ; ಬರದಿದ್ದರೆ ಉತ್ತರ ಋಣಾತ್ಮಕ, ಮತ್ತೆ ಪೂರಕ ತೆಗೆದುಕೊಳ್ಳಿ."
   }
  },
  {
   "id": "int1",
   "type": "interactive",
   "kind": "bar_chart",
   "caption": {
    "en": "Slide N (8 bits). The bars show its 2's complement bit by bit; the readouts give both complements and N read as a signed number."
   },
   "sliders": [
    {
     "name": "N",
     "label": {
