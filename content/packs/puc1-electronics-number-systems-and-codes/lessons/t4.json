    }
   ],
   "readouts": [
    {
     "label": {
      "en": "1's complement (decimal)"
     },
     "expr": "255-N",
     "digits": 0
    },
    {
     "label": {
      "en": "2's complement (decimal)"
     },
     "expr": "256-N",
     "digits": 0
    },
    {
     "label": {
      "en": "N read as signed 8-bit"
     },
     "expr": "N-256*floor(N/128)",
     "digits": 0
    }
   ],
   "tryThis": [
    {
     "en": "Set N = 52: the bars read 11001100, as on the board."
    },
    {
     "en": "Set N = 128: its 2’s complement is itself; it is −128."
    },
    {
     "en": "Any N above 127 reads as a negative number."
    }
   ],
   "optional": true,
   "seconds": 120,
   "narration": {
    "en": "Slide N (8 bits). The bars show its 2's complement bit by bit; the readouts give both complements and N read as a signed number. Set N = 52: the bars read 11001100, as on the board. Set N = 128: its 2’s complement is itself; it is −128. Any N above 127 reads as a negative number."
   },
   "data": {
    "b7": "(floor((256-N)/128)-2*floor((256-N)/256))",
    "b6": "(floor((256-N)/64)-2*floor((256-N)/128))",
    "b5": "(floor((256-N)/32)-2*floor((256-N)/64))",
    "b4": "(floor((256-N)/16)-2*floor((256-N)/32))",
    "b3": "(floor((256-N)/8)-2*floor((256-N)/16))",
    "b2": "(floor((256-N)/4)-2*floor((256-N)/8))",
    "b1": "(floor((256-N)/2)-2*floor((256-N)/4))",
    "b0": "(floor((256-N)/1)-2*floor((256-N)/2))"
   }
  },
  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find 10110 − 01101 using 2's complement (5 bits)."
   },
   "steps": [
    {
     "en": "2's complement of 01101: invert → 10010, add 1 → 10011."
    },
    {
     "en": "10110 + 10011 = 1 01001."
    },
    {
     "en": "A carry is produced: discard it. Result = 01001 = +9 (22 − 13 = 9)."
    }
   ],
   "answer": {
    "en": "(01001)₂ = 9"
   },
   "narration": {
    "en": "Let us work this out together. Find 10110 − 01101 using 2's complement (5 bits)."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Find 0101 − 1001 (5 − 9) using 4-bit 2's complement."
   },
   "steps": [
    {
     "en": "2's complement of 1001: 0110 + 1 = 0111."
    },
    {
     "en": "0101 + 0111 = 1100, no final carry."
    },
    {
     "en": "No carry → negative. 2's complement of 1100 = 0011 + 1 = 0100 = 4."
    }
   ],
   "answer": {
    "en": "−4"
   },
   "narration": {
    "en": "Let us work this out together. Find 0101 − 1001 (5 − 9) using 4-bit 2's complement."
   }
  },
  {
   "id": "trick",
   "type": "trick",
   "heading": {
    "en": "Copy-then-flip shortcut"
   },
   "body": {
    "en": "For the 2's complement, start from the right, copy every bit up to and including the first 1, then flip all the bits to its left. 01011000 → copy \"1000\", flip \"0101\" to \"1010\" → 10101000."
   },
   "narration": {
    "en": "Copy-then-flip shortcut. For the 2's complement, start from the right, copy every bit up to and including the first 1, then flip all the bits to its left. 01011000 → copy \"1000\", flip \"0101\" to \"1010\" → 10101000."
   },
   "optional": true,
   "seconds": 90,
   "mnemonic": {
    "en": "Copy till the first 1, then flip"
   }
  },
