  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Subtracting by adding",
    "kn": "ಕೂಡಿಸುವ ಮೂಲಕ ಕಳೆಯುವುದು"
   },
   "hook": {
    "en": "A processor does not need a separate subtractor. With a clever trick called the 2's complement, it subtracts by adding.",
    "kn": "ಪ್ರೊಸೆಸರ್‌ಗೆ ಪ್ರತ್ಯೇಕ ವ್ಯವಕಲಕ ಬೇಕಿಲ್ಲ. 2ರ ಪೂರಕ ಎಂಬ ಜಾಣ ತಂತ್ರದಿಂದ ಅದು ಕೂಡಿಸುವ ಮೂಲಕವೇ ಕಳೆಯುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Find the 1's and 2's complement of a binary number"
    },
    {
     "en": "Subtract using 2's complement and represent negative numbers"
    }
   ],
   "narration": {
    "en": "A processor does not need a separate subtractor. With a clever trick called the 2's complement, it subtracts by adding.",
    "kn": "ಪ್ರೊಸೆಸರ್‌ಗೆ ಪ್ರತ್ಯೇಕ ವ್ಯವಕಲಕ ಬೇಕಿಲ್ಲ. 2ರ ಪೂರಕ ಎಂಬ ಜಾಣ ತಂತ್ರದಿಂದ ಅದು ಕೂಡಿಸುವ ಮೂಲಕವೇ ಕಳೆಯುತ್ತದೆ."
   }
