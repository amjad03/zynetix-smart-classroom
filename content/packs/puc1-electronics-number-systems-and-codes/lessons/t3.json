  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Binary multiplication and hex addition"
   },
   "body": {
    "en": "Binary multiplication is like decimal long multiplication but simpler: 0 × 0 = 0, 0 × 1 = 0, 1 × 1 = 1. Each partial product is either the multiplicand shifted or zero; add them. For hex addition, add digit by digit in decimal; if the sum is 16 or more, subtract 16 and carry 1."
   },
   "points": [
    {
     "en": "Multiply = shift and add"
    },
    {
     "en": "Hex: a column sum ≥ 16 → subtract 16, carry 1"
    }
   ],
   "narration": {
    "en": "Binary multiplication is just shift and add. In hex addition, whenever a column reaches sixteen, subtract sixteen and carry one.",
    "kn": "ದ್ವಿಮಾನ ಗುಣಾಕಾರ ಎಂದರೆ ಸರಿಸಿ ಕೂಡಿಸುವುದು. ಷೋಡಶಮಾನ ಸಂಕಲನದಲ್ಲಿ ಮೊತ್ತ ಹದಿನಾರು ತಲುಪಿದಾಗ ಹದಿನಾರು ಕಳೆದು ಒಂದು ಕ್ಯಾರಿ."
   }
