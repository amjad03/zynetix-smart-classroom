   "optional": true,
   "seconds": 120,
   "narration": {
    "en": "Pick two 4-bit numbers A and B. The bars show the 5-bit binary sum, from b4 down to b0. Set A = 13 and B = 7: the bars read 10100, as on the board. Find sums that make the carry out 1: they are 16 or more."
   },
   "data": {
    "b4": "(floor((A+B)/16)-2*floor((A+B)/32))",
    "b3": "(floor((A+B)/8)-2*floor((A+B)/16))",
    "b2": "(floor((A+B)/4)-2*floor((A+B)/8))",
    "b1": "(floor((A+B)/2)-2*floor((A+B)/4))",
    "b0": "(floor((A+B)/1)-2*floor((A+B)/2))"
   }
  },
  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Add (1101)₂ and (1011)₂."
   },
   "steps": [
    {
     "en": "Column 1: 1 + 1 = 0, carry 1."
    },
    {
     "en": "Column 2: 0 + 1 + 1 = 0, carry 1."
    },
    {
     "en": "Column 3: 1 + 0 + 1 = 0, carry 1."
    },
    {
     "en": "Column 4: 1 + 1 + 1 = 1, carry 1 → result 11000₂. Check: 13 + 11 = 24."
    }
   ],
   "answer": {
    "en": "(11000)₂"
   },
   "narration": {
    "en": "Let us work this out together. Add (1101)₂ and (1011)₂."
   }
