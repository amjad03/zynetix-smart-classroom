 "title": {
  "en": "Decimal and binary number systems",
  "kn": "ದಶಮಾಂಶ ಮತ್ತು ದ್ವಿಮಾನ ಸಂಖ್ಯಾ ಪದ್ಧತಿಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Why computers count in twos",
    "kn": "ಕಂಪ್ಯೂಟರ್‌ಗಳು ಎರಡರಲ್ಲಿ ಏಕೆ ಎಣಿಸುತ್ತವೆ"
   },
   "hook": {
    "en": "We count in tens because we have ten fingers. A transistor has only two comfortable states, ON and OFF, so digital circuits count in twos.",
    "kn": "ನಮಗೆ ಹತ್ತು ಬೆರಳುಗಳಿರುವುದರಿಂದ ನಾವು ಹತ್ತರಲ್ಲಿ ಎಣಿಸುತ್ತೇವೆ. ಟ್ರಾನ್ಸಿಸ್ಟರ್‌ಗೆ ಆನ್ ಮತ್ತು ಆಫ್ ಎಂಬ ಎರಡೇ ಸ್ಥಿತಿಗಳಿರುವುದರಿಂದ ಡಿಜಿಟಲ್ ಸರ್ಕ್ಯೂಟ್‌ಗಳು ಎರಡರಲ್ಲಿ ಎಣಿಸುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "Explain positional number systems and base"
    },
    {
     "en": "Convert between decimal and binary, including fractions"
    }
   ],
   "narration": {
    "en": "We count in tens because we have ten fingers. A transistor has only two comfortable states, ON and OFF, so digital circuits count in twos.",
    "kn": "ನಮಗೆ ಹತ್ತು ಬೆರಳುಗಳಿರುವುದರಿಂದ ನಾವು ಹತ್ತರಲ್ಲಿ ಎಣಿಸುತ್ತೇವೆ. ಟ್ರಾನ್ಸಿಸ್ಟರ್‌ಗೆ ಆನ್ ಮತ್ತು ಆಫ್ ಎಂಬ ಎರಡೇ ಸ್ಥಿತಿಗಳಿರುವುದರಿಂದ ಡಿಜಿಟಲ್ ಸರ್ಕ್ಯೂಟ್‌ಗಳು ಎರಡರಲ್ಲಿ ಎಣಿಸುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Positional number systems"
   },
   "body": {
    "en": "In a positional system each digit has a weight equal to a power of the base (radix). Decimal has base 10 and digits 0–9. Binary has base 2 and digits 0 and 1, called bits. A group of 4 bits is a nibble and 8 bits is a byte. The leftmost bit is the MSB and the rightmost the LSB."
   },
   "points": [
    {
     "en": "Decimal: base 10, digits 0–9"
    },
    {
     "en": "Binary: base 2, digits 0, 1"
    },
    {
     "en": "Weights: …, 2³, 2², 2¹, 2⁰ . 2⁻¹, 2⁻², …"
    },
    {
     "en": "4 bits = nibble, 8 bits = byte"
    }
   ],
   "narration": {
    "en": "Every digit carries a weight that is a power of the base. In binary the weights are one, two, four, eight and so on.",
    "kn": "ಪ್ರತಿ ಅಂಕಿಯೂ ಆಧಾರದ ಘಾತಕ್ಕೆ ಸಮಾನವಾದ ತೂಕ ಹೊಂದಿರುತ್ತದೆ. ದ್ವಿಮಾನದಲ್ಲಿ ತೂಕಗಳು ಒಂದು, ಎರಡು, ನಾಲ್ಕು, ಎಂಟು ಹೀಗೆ."
   },
   "formula": "N = \\sum_i d_i \\, r^{\\,i}"
  },
