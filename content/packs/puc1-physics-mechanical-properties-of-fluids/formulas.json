{
 "chapterId": "puc1-physics-09-mechanical-properties-of-fluids",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Pressure"
   },
   "tex": "P = \\dfrac{F}{A},\\quad 1\\ \\text{atm} = 1.013\\times10^{5}\\ \\text{Pa}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t1",
   "name": {
    "en": "Pressure at depth"
   },
   "tex": "P = P_a + \\rho gh,\\qquad P_{\\text{gauge}} = \\rho gh"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t1",
   "name": {
    "en": "Pascal's law / hydraulic lift"
   },
   "tex": "\\dfrac{F_1}{A_1} = \\dfrac{F_2}{A_2}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t1",
   "name": {
    "en": "Barometer height"
   },
   "tex": "h = \\dfrac{P_a}{\\rho g}\\quad(76\\ \\text{cm of Hg} \\approx 10.3\\ \\text{m of water})"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Archimedes / flotation"
   },
   "tex": "F_B = \\rho_{\\text{liq}}V_{\\text{sub}}g,\\qquad \\dfrac{V_{\\text{sub}}}{V} = \\dfrac{\\rho_{\\text{body}}}{\\rho_{\\text{liq}}}"
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Liquid in an accelerated container"
   },
   "tex": "\\tan\\theta = \\dfrac{a}{g}\\ (\\text{horizontal}),\\quad P = P_a + \\rho(g + a)h\\ (\\text{upward})"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Rotating liquid"
   },
   "tex": "y = \\dfrac{\\omega^2x^2}{2g}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t2",
   "name": {
    "en": "Equation of continuity"
   },
   "tex": "A_1v_1 = A_2v_2"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t3",
   "name": {
    "en": "Bernoulli's equation"
   },
   "tex": "P + \\tfrac12\\rho v^2 + \\rho gh = \\text{constant}",
   "note": {
    "en": "Steady, incompressible, non-viscous flow along a streamline."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t3",
   "name": {
    "en": "Torricelli's law and range"
   },
   "tex": "v = \\sqrt{2gh},\\qquad R = 2\\sqrt{h(H - h)}",
   "note": {
    "en": "Range is greatest (= H) for a hole at depth H/2."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t2",
   "name": {
    "en": "Time to drain a tank"
   },
   "tex": "t = \\dfrac{A}{a}\\sqrt{\\dfrac{2}{g}}\\left(\\sqrt{h_1} - \\sqrt{h_2}\\right)"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t4",
   "name": {
    "en": "Viscous force"
   },
   "tex": "F = \\eta A\\dfrac{dv}{dx},\\quad 1\\ \\text{Pa s} = 10\\ \\text{poise}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t4",
   "name": {
    "en": "Stokes' law"
   },
   "tex": "F = 6\\pi\\eta rv"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t4",
   "name": {
    "en": "Terminal velocity"
   },
   "tex": "v_t = \\dfrac{2r^2(\\rho - \\sigma)g}{9\\eta}",
   "note": {
    "en": "v_t ∝ r²."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t2",
   "name": {
    "en": "Reynolds number"
   },
   "tex": "R_e = \\dfrac{\\rho vd}{\\eta}",
   "note": {
    "en": "Streamline below ~1000, turbulent above ~2000."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t5",
   "name": {
    "en": "Surface tension and surface energy"
   },
   "tex": "S = \\dfrac{F}{l} = \\dfrac{W}{\\Delta A}\\quad(\\text{N m}^{-1} = \\text{J m}^{-2})"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t5",
   "name": {
    "en": "Excess pressure"
   },
   "tex": "\\Delta P_{\\text{drop}} = \\dfrac{2S}{r},\\qquad \\Delta P_{\\text{soap bubble}} = \\dfrac{4S}{r}",
   "note": {
    "en": "Air bubble inside a liquid: one surface, 2S/r."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t5",
   "name": {
    "en": "Work to blow a soap bubble"
   },
   "tex": "W = 8\\pi r^2S"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t5",
   "name": {
    "en": "Common film of a double bubble"
   },
   "tex": "R = \\dfrac{r_1r_2}{r_2 - r_1}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t4",
   "name": {
    "en": "Capillary rise (Jurin's law)"
   },
   "tex": "h = \\dfrac{2S\\cos\\theta}{r\\rho g}",
   "note": {
    "en": "θ < 90°: rise, concave meniscus; θ > 90° (Hg): fall, convex meniscus."
   }
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Plates held by a liquid film"
   },
   "tex": "F = \\dfrac{2SA}{d}"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-09-mechanical-properties-of-fluids.t4",
   "name": {
    "en": "Temperature dependence"
   },
   "tex": "\\eta_{\\text{liquid}}\\downarrow,\\ \\eta_{\\text{gas}}\\uparrow,\\ S\\downarrow\\ \\text{as}\\ T\\uparrow"
  }
 ]
}
