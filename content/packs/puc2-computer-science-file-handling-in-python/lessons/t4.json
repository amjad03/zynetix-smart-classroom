  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Jump to any position",
    "kn": "ಯಾವುದೇ ಸ್ಥಾನಕ್ಕೆ ಜಿಗಿಯಿರಿ"
   },
   "hook": {
    "en": "A video player lets you skip to minute 10 without watching the first nine. tell() and seek() let a program jump around inside a file.",
    "kn": "ವಿಡಿಯೋ ಪ್ಲೇಯರ್ ನೇರವಾಗಿ 10ನೇ ನಿಮಿಷಕ್ಕೆ ಹೋಗಲು ಬಿಡುತ್ತದೆ. tell() ಮತ್ತು seek() ಕಡತದೊಳಗೆ ಹೀಗೆ ಜಿಗಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "Find the position with tell()"
    },
    {
     "en": "Move the offset with seek()"
    },
    {
     "en": "Create a file and traverse it line by line"
    }
   ],
   "narration": {
    "en": "A video player lets you skip to minute 10 without watching the first nine. tell() and seek() let a program jump around inside a file.",
    "kn": "ವಿಡಿಯೋ ಪ್ಲೇಯರ್ ನೇರವಾಗಿ 10ನೇ ನಿಮಿಷಕ್ಕೆ ಹೋಗಲು ಬಿಡುತ್ತದೆ. tell() ಮತ್ತು seek() ಕಡತದೊಳಗೆ ಹೀಗೆ ಜಿಗಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "tell() and seek()"
   },
   "body": {
    "en": "Every read or write moves the file offset forward. tell() returns the current position as the number of bytes from the beginning. seek(offset, reference_point) moves it: reference_point 0 is the beginning (default), 1 the current position and 2 the end. In text mode Python 3 allows offsets only from the beginning (plus seek(0, 2) for the end); non-zero offsets from 1 or 2 need binary mode."
   },
   "points": [
    {
     "en": "f.tell() → int"
    },
    {
     "en": "f.seek(0) → back to the beginning"
    },
    {
     "en": "reference_point: 0 beginning, 1 current, 2 end"
    }
   ],
   "narration": {
    "en": "Every read or write moves the file offset forward. tell() returns the current position as the number of bytes from the beginning. seek(offset, reference_point) moves it: reference_point 0 is the beginning (default), 1 the current position and 2 the end. In text mode Python 3 allows offsets only from the beginning (plus seek(0, 2) for the end); non-zero offsets from 1 or 2 need binary mode.",
    "kn": "tell() ಪ್ರಸ್ತುತ ಸ್ಥಾನವನ್ನು ಆರಂಭದಿಂದ ಬೈಟ್‌ಗಳಲ್ಲಿ ನೀಡುತ್ತದೆ. seek(offset, reference_point) ಆಫ್‌ಸೆಟ್ ಸರಿಸುತ್ತದೆ: 0 ಆರಂಭ, 1 ಪ್ರಸ್ತುತ ಸ್ಥಾನ, 2 ಕೊನೆ."
   },
   "formula": "\\texttt{file\\_object.seek(offset[, reference\\_point])}"
  },
