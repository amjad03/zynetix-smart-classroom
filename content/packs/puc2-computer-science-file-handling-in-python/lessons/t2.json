  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "open() and access modes"
   },
   "body": {
    "en": "file_object = open(file_name, access_mode) returns a file object (file handle) that links the program to the file. The access mode says what we will do and where the file offset starts. The file object has attributes such as name, mode and closed."
   },
   "points": [
    {
     "en": "'r': read only, offset at beginning (default); file must exist"
    },
    {
     "en": "'rb': read only, binary"
    },
    {
     "en": "'r+': read and write, beginning"
    },
    {
     "en": "'w': write only; existing contents overwritten, new file created if absent; beginning"
    },
    {
     "en": "'wb+': read and write, binary, overwritten"
    },
    {
     "en": "'a': append; new data written at the end; file created if absent"
    },
    {
     "en": "'a+': append and read; offset at end"
    }
   ],
   "narration": {
    "en": "file_object = open(file_name, access_mode) returns a file object (file handle) that links the program to the file. The access mode says what we will do and where the file offset starts. The file object has attributes such as name, mode and closed.",
    "kn": "open(file_name, access_mode) ಒಂದು ಕಡತ ಆಬ್ಜೆಕ್ಟ್ ನೀಡುತ್ತದೆ. ಆಕ್ಸೆಸ್ ಮೋಡ್ ನಾವು ಏನು ಮಾಡುತ್ತೇವೆ ಮತ್ತು ಆಫ್‌ಸೆಟ್ ಎಲ್ಲಿ ಆರಂಭವಾಗುತ್ತದೆ ಎಂದು ಹೇಳುತ್ತದೆ."
   },
   "formula": "\\texttt{file\\_object = open(file\\_name, access\\_mode)}"
  },
