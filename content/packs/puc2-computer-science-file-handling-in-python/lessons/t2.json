  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Give the exact output of this program."
   },
   "steps": [
    {
     "en": "f = open(\"myfile.txt\", \"w\")"
    },
    {
     "en": "print(f.name, f.mode, f.closed)"
    },
    {
     "en": "f.close()"
    },
    {
     "en": "print(f.closed)"
    },
    {
     "en": "with open(\"myfile.txt\") as g:"
    },
    {
     "en": "    print(g.mode, g.closed)"
    },
    {
     "en": "print(g.closed)"
    }
   ],
   "answer": {
    "en": "myfile.txt w False\nTrue\nr False\nTrue"
   },
   "narration": {
    "en": "Watch the closed attribute change. The with block closes g for us."
   }
