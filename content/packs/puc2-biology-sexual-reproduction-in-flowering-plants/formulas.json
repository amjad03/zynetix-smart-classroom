{
 "chapterId": "puc2-biology-01-sexual-reproduction-in-flowering-plants",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t1",
   "name": {
    "en": "Anther structure"
   },
   "tex": "\\text{bilobed, dithecous} \\Rightarrow 4\\ \\text{microsporangia}",
   "note": {
    "en": "Two microsporangia in each lobe, at the corners of the tetragonal anther."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t1",
   "name": {
    "en": "Microsporangium wall (outer → inner)"
   },
   "tex": "\\text{epidermis} \\to \\text{endothecium} \\to \\text{middle layers} \\to \\text{tapetum}",
   "note": {
    "en": "Tapetum nourishes pollen; outer three protect and help dehiscence."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t1",
   "name": {
    "en": "Microsporogenesis"
   },
   "tex": "\\text{PMC}\\ (2n) \\xrightarrow{\\text{meiosis}} \\text{tetrad of 4 microspores}\\ (n)",
   "note": {
    "en": "1 meiosis → 4 pollen grains."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t1",
   "name": {
    "en": "Pollen wall"
   },
   "tex": "\\text{exine} = \\text{sporopollenin};\\quad \\text{intine} = \\text{cellulose} + \\text{pectin}",
   "note": {
    "en": "Germ pores: where sporopollenin is absent."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t1",
   "name": {
    "en": "Pollen shedding"
   },
   "tex": "> 60\\%\\ \\text{angiosperms shed at 2-celled stage}",
   "note": {
    "en": "Vegetative cell (large, food) + generative cell (small, spindle-shaped)."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Pollen viability and storage"
   },
   "tex": "\\text{rice, wheat} \\approx 30\\ \\text{min};\\quad \\text{storage at } -196\\,^{\\circ}\\text{C}",
   "note": {
    "en": "Months in some Rosaceae, Leguminosae, Solanaceae. Pollen banks use liquid nitrogen."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t2",
   "name": {
    "en": "Megasporogenesis"
   },
   "tex": "\\text{MMC}\\ (2n) \\xrightarrow{\\text{meiosis}} 4\\ \\text{megaspores} \\to 1\\ \\text{functional} + 3\\ \\text{degenerate}",
   "note": {
    "en": "Monosporic development; 1 meiosis → 1 embryo sac."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t2",
   "name": {
    "en": "Embryo sac formation"
   },
   "tex": "1 \\xrightarrow{3\\ \\text{free-nuclear mitoses}} 2^3 = 8\\ \\text{nuclei},\\ 7\\ \\text{cells}",
   "note": {
    "en": "Micropylar: egg + 2 synergids (filiform apparatus); chalazal: 3 antipodals; centre: 2 polar nuclei."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Meiosis count"
   },
   "tex": "\\text{pollen}: N/4;\\quad \\text{embryo sacs}: N",
   "note": {
    "en": "e.g. 100 seeds need 25 + 100 = 125 meioses."
   }
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Ploidy summary"
   },
   "tex": "\\text{nucellus, integument, zygote, perisperm} = 2n;\\ \\text{egg, synergid, antipodal} = n;\\ \\text{PEN/endosperm} = 3n"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t3",
   "name": {
    "en": "Pollination types"
   },
   "tex": "\\text{autogamy (same flower)},\\ \\text{geitonogamy (same plant)},\\ \\text{xenogamy (different plant)}",
   "note": {
    "en": "Geitonogamy: functionally cross, genetically autogamy."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t3",
   "name": {
    "en": "Cleistogamy"
   },
   "tex": "\\text{Viola, Oxalis, Commelina}",
   "note": {
    "en": "Closed flowers, invariably autogamous, assured seed set."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t3",
   "name": {
    "en": "Water pollination"
   },
   "tex": "\\text{Vallisneria, Hydrilla (fresh water)};\\ \\text{Zostera (marine)}",
   "note": {
    "en": "About 30 genera, mostly monocots. Water hyacinth and water lily are insect/wind pollinated."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t3",
   "name": {
    "en": "Wind-pollinated flower"
   },
   "tex": "\\text{light non-sticky pollen, exposed stamens, feathery stigma, single ovule}",
   "note": {
    "en": "Corn-cob tassels = stigma and style."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t3",
   "name": {
    "en": "Outbreeding devices"
   },
   "tex": "\\text{monoecy} \\Rightarrow \\neg\\text{autogamy};\\quad \\text{dioecy} \\Rightarrow \\neg\\text{autogamy},\\ \\neg\\text{geitonogamy}",
   "note": {
    "en": "Castor, maize monoecious; papaya dioecious. Also self-incompatibility, non-synchrony, positional separation."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t3",
   "name": {
    "en": "Insect pollination facts"
   },
   "tex": "\\text{Amorphophallus} \\approx 6\\ \\text{ft};\\quad \\text{Yucca} \\leftrightarrow \\text{moth}",
   "note": {
    "en": "Bees are the dominant biotic agents."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t4",
   "name": {
    "en": "Double fertilisation"
   },
   "tex": "\\text{syngamy: male gamete} + \\text{egg} \\to 2n;\\quad \\text{triple fusion: male gamete} + 2\\ \\text{polar nuclei} \\to 3n",
   "note": {
    "en": "5 nuclei fuse in total; pollen tube enters a synergid."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t4",
   "name": {
    "en": "Endosperm"
   },
   "tex": "\\text{coconut water = free-nuclear};\\ \\text{kernel = cellular}",
   "note": {
    "en": "Consumed: pea, groundnut, beans. Persists: castor, coconut, wheat, maize. Precedes embryo development."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t4",
   "name": {
    "en": "Perisperm"
   },
   "tex": "\\text{residual nucellus } (2n):\\ \\text{black pepper, beet}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t4",
   "name": {
    "en": "Embryo stages"
   },
   "tex": "\\text{proembryo} \\to \\text{globular} \\to \\text{heart-shaped} \\to \\text{mature}",
   "note": {
    "en": "Grass: scutellum (cotyledon), coleoptile (shoot), coleorhiza (root)."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t4",
   "name": {
    "en": "Post-fertilisation"
   },
   "tex": "\\text{ovule} \\to \\text{seed};\\ \\text{ovary} \\to \\text{fruit};\\ \\text{integuments} \\to \\text{testa, tegmen};\\ \\text{ovary wall} \\to \\text{pericarp}",
   "note": {
    "en": "Mature seed: 10–15% moisture."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t4",
   "name": {
    "en": "False and parthenocarpic fruits"
   },
   "tex": "\\text{false: apple, strawberry, cashew (thalamus)};\\ \\text{parthenocarpic: banana}"
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Seed longevity"
   },
   "tex": "\\text{Lupinus arcticus} \\approx 10\\,000\\ \\text{yr};\\ \\text{date palm} \\approx 2000\\ \\text{yr}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-biology-01-sexual-reproduction-in-flowering-plants.t5",
   "name": {
    "en": "Apomixis"
   },
   "tex": "\\text{seed without fertilisation: Asteraceae, grasses}",
   "note": {
    "en": "Nucellar polyembryony: Citrus, mango. Apomictic hybrids show no segregation."
   }
  }
 ]
}
