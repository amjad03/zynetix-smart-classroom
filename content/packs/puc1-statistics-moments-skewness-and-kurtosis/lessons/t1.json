 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Borrowing an idea from physics",
    "kn": "ಭೌತಶಾಸ್ತ್ರದಿಂದ ಎರವಲು ಪಡೆದ ಕಲ್ಪನೆ"
   },
   "hook": {
    "en": "In physics, the moment of a force is force times distance. In statistics, a moment is the average of a power of the distances of the values from a point. The first few moments describe the whole shape of a distribution.",
    "kn": "ಭೌತಶಾಸ್ತ್ರದಲ್ಲಿ ಬಲದ ಭ್ರಾಮಕ = ಬಲ × ದೂರ. ಸಂಖ್ಯಾಶಾಸ್ತ್ರದಲ್ಲಿ ಭ್ರಾಮಕ ಎಂದರೆ ಒಂದು ಬಿಂದುವಿನಿಂದ ಬೆಲೆಗಳ ದೂರಗಳ ಘಾತದ ಸರಾಸರಿ. ಮೊದಲ ಕೆಲವು ಭ್ರಾಮಕಗಳು ವಿತರಣೆಯ ಆಕಾರವನ್ನು ವಿವರಿಸುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "Define raw moments about a point A"
    },
    {
     "en": "Define central moments about the mean"
    },
    {
     "en": "Compute the first four moments"
    }
   ],
   "narration": {
    "en": "In physics, the moment of a force is force times distance. In statistics, a moment is the average of a power of the distances of the values from a point. The first few moments describe the whole shape of a distribution.",
    "kn": "ಭೌತಶಾಸ್ತ್ರದಲ್ಲಿ ಬಲದ ಭ್ರಾಮಕ = ಬಲ × ದೂರ. ಸಂಖ್ಯಾಶಾಸ್ತ್ರದಲ್ಲಿ ಭ್ರಾಮಕ ಎಂದರೆ ಒಂದು ಬಿಂದುವಿನಿಂದ ಬೆಲೆಗಳ ದೂರಗಳ ಘಾತದ ಸರಾಸರಿ. ಮೊದಲ ಕೆಲವು ಭ್ರಾಮಕಗಳು ವಿತರಣೆಯ ಆಕಾರವನ್ನು ವಿವರಿಸುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Raw and central moments"
   },
   "body": {
    "en": "The r-th raw moment about an arbitrary point A is $\\mu_r' = \\sum f(x - A)^r / N$. When A = 0 these are moments about the origin. The r-th central moment is taken about the mean: $\\mu_r = \\sum f(x - \\bar{x})^r / N$. Always $\\mu_0 = 1$ and $\\mu_1 = 0$; $\\mu_2$ is the variance.",
    "kn": "A ಎಂಬ ಯಾವುದೇ ಬಿಂದುವಿನ ಸುತ್ತ r ನೇ ಕಚ್ಚಾ ಭ್ರಾಮಕ μᵣ′ = Σf(x − A)ʳ/N. A = 0 ಆದರೆ ಮೂಲದ ಸುತ್ತ ಭ್ರಾಮಕಗಳು. ಸರಾಸರಿಯ ಸುತ್ತ ತೆಗೆದರೆ ಕೇಂದ್ರೀಯ ಭ್ರಾಮಕ μᵣ = Σf(x − x̄)ʳ/N. ಯಾವಾಗಲೂ μ₀ = 1, μ₁ = 0; μ₂ ವ್ಯತ್ಯಾಸಾಂಕ."
   },
   "points": [
    {
     "en": "μ₁′ = x̄ − A"
    },
    {
     "en": "μ₁ = 0, μ₂ = σ²"
    },
    {
     "en": "μ₃ tells skewness, μ₄ tells kurtosis"
    }
   ],
   "formula": "\\mu_r' = \\frac{1}{N}\\sum f(x-A)^r, \\qquad \\mu_r = \\frac{1}{N}\\sum f(x-\\bar{x})^r",
   "narration": {
    "en": "The r-th raw moment about an arbitrary point A is \\mu_r' = \\sum f(x - A)^r / N. When A = 0 these are moments about the origin. The r-th central moment is taken about the mean: \\mu_r = \\sum f(x - \\bar{x})^r / N. Always \\mu_0 = 1 and \\mu_1 = 0; \\mu_2 is the variance.",
    "kn": "A ಎಂಬ ಯಾವುದೇ ಬಿಂದುವಿನ ಸುತ್ತ r ನೇ ಕಚ್ಚಾ ಭ್ರಾಮಕ μᵣ′ = Σf(x − A)ʳ/N. A = 0 ಆದರೆ ಮೂಲದ ಸುತ್ತ ಭ್ರಾಮಕಗಳು. ಸರಾಸರಿಯ ಸುತ್ತ ತೆಗೆದರೆ ಕೇಂದ್ರೀಯ ಭ್ರಾಮಕ μᵣ = Σf(x − x̄)ʳ/N. ಯಾವಾಗಲೂ μ₀ = 1, μ₁ = 0; μ₂ ವ್ಯತ್ಯಾಸಾಂಕ."
   }
  },
