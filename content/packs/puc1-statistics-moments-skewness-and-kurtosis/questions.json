[
 {
  "id": "1t07-q01",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t1",
  "stem": {
   "en": "The first central moment of any distribution is:"
  },
  "options": [
   {
    "en": "0"
   },
   {
    "en": "1"
   },
   {
    "en": "the mean"
   },
   {
    "en": "the variance"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "μ₁ = Σ(x − x̄)/n = 0, because deviations from the mean add up to zero."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q02",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t1",
  "stem": {
   "en": "The second central moment μ₂ is equal to the:"
  },
  "options": [
   {
    "en": "mean"
   },
   {
    "en": "standard deviation"
   },
   {
    "en": "mean deviation"
   },
   {
    "en": "variance"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "μ₂ = Σ(x − x̄)²/n = σ², the variance."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q03",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t1",
  "stem": {
   "en": "For the values 2, 4, 6, 8, the second central moment μ₂ is:"
  },
  "options": [
   {
    "en": "6"
   },
   {
    "en": "2.24"
   },
   {
    "en": "5"
   },
   {
    "en": "20"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Mean = 5; deviations −3, −1, 1, 3; squares 9, 1, 1, 9; μ₂ = 20/4 = 5."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q04",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t1",
  "stem": {
   "en": "The first raw moment about A = 4 is μ₁′ = 1. The arithmetic mean is:"
  },
  "options": [
   {
    "en": "1"
   },
   {
    "en": "5"
   },
   {
    "en": "3"
   },
   {
    "en": "4"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "μ₁′ = x̄ − A, so x̄ = A + μ₁′ = 4 + 1 = 5."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t07-q05",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t2",
  "stem": {
   "en": "If μ₁′ = 2 and μ₂′ = 13, the variance is:"
  },
  "options": [
   {
    "en": "15"
   },
   {
    "en": "11"
   },
   {
    "en": "9"
   },
   {
    "en": "13"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "μ₂ = μ₂′ − (μ₁′)² = 13 − 4 = 9."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q06",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t2",
  "stem": {
   "en": "Karl Pearson's β₂ coefficient is defined as:"
  },
  "options": [
   {
    "en": "μ₃/μ₂"
   },
   {
    "en": "μ₄/μ₂²"
   },
   {
    "en": "μ₃²/μ₂³"
   },
   {
    "en": "μ₄/μ₂"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "β₂ = μ₄/μ₂² measures kurtosis; β₁ = μ₃²/μ₂³ measures skewness."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q07",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t2",
  "stem": {
   "en": "Given μ₁′ = 1, μ₂′ = 5 and μ₃′ = 20 about some point, μ₃ is:"
  },
  "options": [
   {
    "en": "20"
   },
   {
    "en": "7"
   },
   {
    "en": "17"
   },
   {
    "en": "3"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "μ₃ = μ₃′ − 3μ₂′μ₁′ + 2(μ₁′)³ = 20 − 15 + 2 = 7."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t07-q08",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t2",
  "stem": {
   "en": "If μ₂ = 4 and μ₃ = −4, then β₁ is:"
  },
  "options": [
   {
    "en": "1"
   },
   {
    "en": "−0.25"
   },
   {
    "en": "0.25"
   },
   {
    "en": "0.5"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "β₁ = μ₃²/μ₂³ = 16/64 = 0.25 (always ≥ 0; the sign of skewness is in γ₁ = −0.5)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t07-q09",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t3",
  "stem": {
   "en": "In a positively skewed distribution:"
  },
  "options": [
   {
    "en": "mean = median = mode"
   },
   {
    "en": "median > mean > mode"
   },
   {
    "en": "mean > median > mode"
   },
   {
    "en": "mode > median > mean"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "The long right tail pulls the mean furthest to the right; the mode stays at the peak."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q10",
  "chapterId": "puc1-statistics-07-moments-skewness-and-kurtosis",
  "topicId": "puc1-statistics-07-moments-skewness-and-kurtosis.t3",
  "stem": {
   "en": "Mean = 45, mode = 40 and σ = 10. Karl Pearson's coefficient of skewness is:"
  },
  "options": [
   {
    "en": "5"
   },
   {
    "en": "0.5"
   },
   {
    "en": "−0.5"
   },
   {
    "en": "0.05"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Sk = (mean − mode)/σ = 5/10 = 0.5."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t07-q11",
