  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "An 8085 uses a 6 MHz crystal. Find the operating frequency, the T-state time and the time for an opcode fetch machine cycle."
   },
   "steps": [
    {
     "en": "Operating frequency = 6/2 = 3 MHz."
    },
    {
     "en": "T = 1/3 MHz ≈ 0.333 µs."
    },
    {
     "en": "Opcode fetch = 4 T = 4 × 0.333 ≈ 1.33 µs."
    }
   ],
   "answer": {
    "en": "3 MHz, 0.333 µs, 1.33 µs"
   },
   "narration": {
    "en": "Let us work this out together. An 8085 uses a 6 MHz crystal. Find the operating frequency, the T-state time and the time for an opcode fetch machine cycle."
   }
