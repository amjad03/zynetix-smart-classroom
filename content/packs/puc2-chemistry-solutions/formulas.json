{
 "chapterId": "puc2-chemistry-01-solutions",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Mass percentage"
   },
   "tex": "w\\% = \\dfrac{w_{\\text{solute}}}{w_{\\text{solution}}} \\times 100",
   "note": {
    "en": "ppm = (mass of solute / mass of solution) × 10⁶."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Mole fraction"
   },
   "tex": "x_A = \\dfrac{n_A}{n_A + n_B}, \\quad x_A + x_B = 1"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Molarity"
   },
   "tex": "M = \\dfrac{n_{\\text{solute}}}{V_{\\text{solution}}\\,(\\text{L})}",
   "note": {
    "en": "Depends on temperature (volume changes)."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Molality"
   },
   "tex": "m = \\dfrac{n_{\\text{solute}}}{w_{\\text{solvent}}\\,(\\text{kg})}",
   "note": {
    "en": "Temperature independent, like mole fraction and mass %."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Molarity from mass % and density"
   },
   "tex": "M = \\dfrac{10\\,d\\,(w\\%)}{M_2}",
   "note": {
    "en": "d in g mL⁻¹, M₂ = molar mass of solute."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Molarity ↔ molality"
   },
   "tex": "m = \\dfrac{1000\\,M}{1000\\,d - M\\,M_2}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-01-solutions.t2",
   "name": {
    "en": "Henry's law"
   },
   "tex": "p = K_H\\,x",
   "note": {
    "en": "Larger K_H ⇒ lower solubility; K_H rises with T, so gas solubility falls on heating."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-01-solutions.t3",
   "name": {
    "en": "Raoult's law (volatile components)"
   },
   "tex": "p_A = x_A p_A^\\circ,\\quad P = p_B^\\circ + (p_A^\\circ - p_B^\\circ)\\,x_A"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-01-solutions.t3",
   "name": {
    "en": "Vapour composition"
   },
   "tex": "y_A = \\dfrac{x_A p_A^\\circ}{P}, \\qquad \\dfrac{1}{P} = \\dfrac{y_A}{p_A^\\circ} + \\dfrac{y_B}{p_B^\\circ}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-01-solutions.t3",
   "name": {
    "en": "Ideal solution"
   },
   "tex": "\\Delta_{\\text{mix}}H = 0,\\ \\Delta_{\\text{mix}}V = 0,\\ \\Delta_{\\text{mix}}S > 0,\\ \\Delta_{\\text{mix}}G < 0",
   "note": {
    "en": "e.g. benzene + toluene, n-hexane + n-heptane."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-01-solutions.t3",
   "name": {
    "en": "Positive deviation"
   },
   "tex": "p > p_{\\text{ideal}},\\ \\Delta_{\\text{mix}}H > 0,\\ \\Delta_{\\text{mix}}V > 0",
   "note": {
    "en": "A–B weaker; e.g. ethanol + water, ethanol + acetone, CS₂ + acetone; minimum-boiling azeotrope (ethanol–water ≈ 95%)."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-01-solutions.t3",
   "name": {
    "en": "Negative deviation"
   },
   "tex": "p < p_{\\text{ideal}},\\ \\Delta_{\\text{mix}}H < 0,\\ \\Delta_{\\text{mix}}V < 0",
   "note": {
    "en": "A–B stronger; e.g. CHCl₃ + acetone, HNO₃ + water (max-boiling azeotrope ≈ 68% HNO₃), phenol + aniline."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-01-solutions.t4",
   "name": {
    "en": "Relative lowering of vapour pressure"
   },
   "tex": "\\dfrac{p^\\circ - p}{p^\\circ} = x_2 = \\dfrac{n_2}{n_1 + n_2} \\approx \\dfrac{w_2 M_1}{M_2 w_1}",
   "note": {
    "en": "Exact alternative: (p° − p)/p = n₂/n₁."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-01-solutions.t4",
   "name": {
    "en": "Elevation of boiling point"
   },
   "tex": "\\Delta T_b = i\\,K_b\\,m, \\qquad M_2 = \\dfrac{K_b\\,w_2 \\times 1000}{\\Delta T_b\\,w_1}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-01-solutions.t4",
   "name": {
    "en": "Depression of freezing point"
   },
   "tex": "\\Delta T_f = i\\,K_f\\,m, \\qquad M_2 = \\dfrac{K_f\\,w_2 \\times 1000}{\\Delta T_f\\,w_1}",
   "note": {
    "en": "Water: K_f = 1.86, K_b = 0.52 K kg mol⁻¹; benzene: K_f = 5.12 K kg mol⁻¹."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Kb and Kf from thermodynamics"
   },
   "tex": "K_b = \\dfrac{R M_1 T_b^2}{1000\\,\\Delta_{\\text{vap}}H}, \\qquad K_f = \\dfrac{R M_1 T_f^2}{1000\\,\\Delta_{\\text{fus}}H}",
   "note": {
    "en": "Depend only on the solvent (M₁ in g mol⁻¹, ΔH in J mol⁻¹)."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-01-solutions.t5",
   "name": {
    "en": "Osmotic pressure (van't Hoff)"
   },
   "tex": "\\pi = i\\,C\\,R\\,T = \\dfrac{i\\,w_2 R T}{M_2 V}",
   "note": {
    "en": "R = 0.0821 L atm K⁻¹ mol⁻¹ = 0.083 L bar K⁻¹ mol⁻¹. Preferred for macromolecules."
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Isotonic solutions"
   },
   "tex": "\\pi_1 = \\pi_2 \\;\\Rightarrow\\; i_1 C_1 = i_2 C_2",
   "note": {
    "en": "0.9% NaCl is isotonic with blood; hypotonic → cells swell (haemolysis), hypertonic → cells shrink."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-01-solutions.t1",
   "name": {
    "en": "Reverse osmosis"
   },
   "tex": "P_{\\text{applied}} > \\pi \\;\\Rightarrow\\; \\text{solvent flows from solution to solvent}",
   "note": {
    "en": "Desalination of sea water using cellulose acetate membranes."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-01-solutions.t5",
   "name": {
    "en": "van't Hoff factor"
   },
   "tex": "i = \\dfrac{\\text{observed colligative property}}{\\text{calculated}} = \\dfrac{M_{\\text{normal}}}{M_{\\text{observed}}}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-chemistry-01-solutions.t5",
   "name": {
    "en": "Dissociation"
   },
   "tex": "i = 1 + (n - 1)\\alpha",
   "note": {
    "en": "n = ions per formula unit; i > 1, observed M smaller than true M."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-chemistry-01-solutions.t5",
   "name": {
    "en": "Association"
   },
   "tex": "i = 1 - \\alpha\\left(1 - \\dfrac{1}{n}\\right)",
   "note": {
    "en": "n = molecules per aggregate; e.g. CH₃COOH dimer in benzene, i → 0.5."
   }
  }
 ]
}
