 {
  "id": "sol-q05",
  "chapterId": "puc2-chemistry-01-solutions",
  "topicId": "puc2-chemistry-01-solutions.t2",
  "stem": {
   "en": "According to Henry's law, the solubility of a gas in a liquid is:"
  },
  "options": [
   {
    "en": "inversely proportional to its partial pressure"
   },
   {
    "en": "directly proportional to its partial pressure"
   },
   {
    "en": "independent of pressure"
   },
   {
    "en": "proportional to temperature"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "p = K_H x, so x ∝ p."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "sol-q06",
  "chapterId": "puc2-chemistry-01-solutions",
  "topicId": "puc2-chemistry-01-solutions.t2",
  "stem": {
   "en": "A higher Henry's law constant K_H for a gas at a given temperature means:"
  },
  "options": [
   {
    "en": "higher solubility"
   },
   {
    "en": "lower solubility"
   },
   {
    "en": "no change in solubility"
   },
   {
    "en": "the gas reacts with water"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "x = p/K_H: larger K_H gives smaller x."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
