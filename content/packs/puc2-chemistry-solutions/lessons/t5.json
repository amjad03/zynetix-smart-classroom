       "size": 3,
       "color": "white"
      },
      {
       "kind": "math",
       "at": [
        4,
        42
       ],
       "tex": "\\Delta T_f = 3\\times1.86\\times0.1 = 0.558\\ \\mathrm{K}",
       "size": 4,
       "color": "green"
      }
     ]
    }
   ]
