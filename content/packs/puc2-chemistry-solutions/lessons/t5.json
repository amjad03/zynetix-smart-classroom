 "title": {
  "en": "Abnormal molar masses and the van't Hoff factor",
  "kn": "ಅಸಹಜ ಮೋಲಾರ್ ರಾಶಿ ಮತ್ತು ವ್ಯಾಂಟ್ ಹಾಫ್ ಅಂಶ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "When 1 + 1 is not 2",
    "kn": "1 + 1 = 2 ಆಗದಿದ್ದಾಗ"
   },
   "hook": {
    "en": "Salt splits into ions and acetic acid pairs up in benzene. Then the particle count — and the colligative effect — is not what the formula suggests.",
    "kn": "ಉಪ್ಪು ಅಯಾನುಗಳಾಗಿ ವಿಭಜನೆಯಾಗುತ್ತದೆ; ಅಸಿಟಿಕ್ ಆಮ್ಲ ಬೆಂಜೀನ್‌ನಲ್ಲಿ ಜೋಡಿಯಾಗುತ್ತದೆ."
   },
   "narration": {
    "en": "Salt splits into ions and acetic acid pairs up in benzene. Then the particle count — and the colligative effect — is not what the formula suggests.",
    "kn": "ಉಪ್ಪು ಅಯಾನುಗಳಾಗಿ ವಿಭಜನೆಯಾಗುತ್ತದೆ; ಅಸಿಟಿಕ್ ಆಮ್ಲ ಬೆಂಜೀನ್‌ನಲ್ಲಿ ಜೋಡಿಯಾಗುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "van't Hoff factor"
   },
   "body": {
    "en": "$i$ = observed colligative property ÷ calculated value = normal molar mass ÷ abnormal molar mass. Dissociation gives $i > 1$; association gives $i < 1$. Then $\\Delta T_b = i K_b m$, $\\pi = iCRT$.",
    "kn": "i = ಗಮನಿಸಿದ ಸಂಖ್ಯಾಧಾರಿತ ಗುಣ ÷ ಲೆಕ್ಕಹಾಕಿದ ಮೌಲ್ಯ. ವಿಘಟನೆ: i > 1; ಸಂಯೋಜನೆ: i < 1."
   },
   "points": [
    {
     "en": "NaCl: i ≈ 2; K₂SO₄: i ≈ 3"
    },
    {
     "en": "Acetic acid in benzene: i ≈ 0.5"
    }
   ],
   "narration": {
    "en": "$i$ = observed colligative property ÷ calculated value = normal molar mass ÷ abnormal molar mass. Dissociation gives $i > 1$; association gives $i < 1$. Then $\\Delta T_b = i K_b m$, $\\pi = iCRT$.",
    "kn": "i = ಗಮನಿಸಿದ ಸಂಖ್ಯಾಧಾರಿತ ಗುಣ ÷ ಲೆಕ್ಕಹಾಕಿದ ಮೌಲ್ಯ. ವಿಘಟನೆ: i > 1; ಸಂಯೋಜನೆ: i < 1."
   },
   "formula": "i = \\frac{\\text{normal molar mass}}{\\text{abnormal molar mass}}"
  },
  {
