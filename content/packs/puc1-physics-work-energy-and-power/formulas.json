{
 "chapterId": "puc1-physics-05-work-energy-and-power",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-05-work-energy-and-power.t2",
   "name": {
    "en": "Work"
   },
   "tex": "W = \\vec F\\cdot\\vec s = Fs\\cos\\theta",
   "note": {
    "en": "Variable force: ∫F·ds."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-05-work-energy-and-power.t2",
   "name": {
    "en": "Work–energy theorem"
   },
   "tex": "W_{net} = \\Delta K",
   "note": {
    "en": "Includes work of all forces."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "KE–momentum relation"
   },
   "tex": "K = \\frac{p^2}{2m}",
   "note": {
    "en": "Same p → lighter body has more KE."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Spring PE"
   },
   "tex": "U = \\tfrac12 kx^2",
   "note": {
    "en": "Measured from natural length."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-05-work-energy-and-power.t4",
   "name": {
    "en": "Power"
   },
   "tex": "P = \\frac{dW}{dt} = \\vec F\\cdot\\vec v",
   "note": {
    "en": "1 hp = 746 W."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "Coefficient of restitution"
   },
   "tex": "e = \\frac{v_2 - v_1}{u_1 - u_2}",
   "note": {
    "en": "e = 1 elastic, 0 perfectly inelastic."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "Elastic collision (m₂ at rest)"
   },
   "tex": "v_1 = \\frac{m_1 - m_2}{m_1 + m_2}u,\\quad v_2 = \\frac{2m_1}{m_1 + m_2}u",
   "note": {
    "en": "Equal masses exchange velocities."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Vertical circle"
   },
   "tex": "v_{top} \\ge \\sqrt{gR},\\quad v_{bottom} \\ge \\sqrt{5gR}",
   "note": {
    "en": "T_bottom − T_top = 6mg."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-05-work-energy-and-power.t1",
   "name": {
    "en": "Scalar (dot) product"
   },
   "tex": "\\vec A\\cdot\\vec B = AB\\cos\\theta = A_xB_x + A_yB_y + A_zB_z",
   "note": {
    "en": "Zero for perpendicular vectors."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-05-work-energy-and-power.t1",
   "name": {
    "en": "Work by a constant force"
   },
   "tex": "W = \\vec F\\cdot\\vec d = Fd\\cos\\theta",
   "note": {
    "en": "Positive for θ < 90°, zero for θ = 90°, negative for θ > 90°."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-05-work-energy-and-power.t2",
   "name": {
    "en": "Work by a variable force"
   },
   "tex": "W = \\int_{x_1}^{x_2}F(x)\\,dx = \\text{area under } F\\text{–}x \\text{ graph}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Kinetic energy"
   },
   "tex": "K = \\tfrac12mv^2 = \\dfrac{p^2}{2m},\\qquad p = \\sqrt{2mK}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-05-work-energy-and-power.t2",
   "name": {
    "en": "Work–energy theorem"
   },
   "tex": "W_{\\text{net}} = \\Delta K = \\tfrac12mv^2 - \\tfrac12mu^2",
   "note": {
    "en": "Includes work of all forces — conservative and non-conservative."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Gravitational PE (near the surface)"
   },
   "tex": "U = mgh"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Spring force and PE"
   },
   "tex": "F = -kx,\\qquad U = \\tfrac12kx^2 = \\dfrac{F^2}{2k}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Conservative force and PE"
   },
   "tex": "F = -\\dfrac{dU}{dx},\\qquad W_c = -\\Delta U,\\qquad \\oint\\vec F_c\\cdot d\\vec l = 0"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Equilibrium and stability"
   },
   "tex": "\\dfrac{dU}{dx} = 0;\\quad \\dfrac{d^2U}{dx^2} > 0\\ \\text{stable},\\ < 0\\ \\text{unstable},\\ = 0\\ \\text{neutral}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Conservation of mechanical energy"
   },
   "tex": "K + U = \\text{constant}\\ \\ (\\text{only conservative forces work})",
   "note": {
    "en": "With friction: W_nc = ΔK + ΔU."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-05-work-energy-and-power.t4",
   "name": {
    "en": "Power"
   },
   "tex": "P = \\dfrac{dW}{dt} = \\vec F\\cdot\\vec v,\\qquad P_{\\text{av}} = \\dfrac{W}{t}",
   "note": {
    "en": "1 hp = 746 W; 1 kWh = 3.6 × 10⁶ J."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Constant power from rest"
   },
   "tex": "v \\propto t^{1/2},\\quad x \\propto t^{3/2},\\quad F \\propto t^{-1/2}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Mass–energy equivalence"
   },
   "tex": "E = mc^2"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "Coefficient of restitution"
   },
   "tex": "e = \\dfrac{v_2 - v_1}{u_1 - u_2}",
   "note": {
    "en": "e = 1 elastic, 0 < e < 1 inelastic, e = 0 perfectly inelastic. Bounce: e = √(h₂/h₁)."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "1-D elastic collision (m₂ at rest)"
   },
   "tex": "v_1 = \\dfrac{m_1 - m_2}{m_1 + m_2}u_1,\\qquad v_2 = \\dfrac{2m_1}{m_1 + m_2}u_1",
   "note": {
    "en": "Equal masses exchange velocities."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "Fraction of KE transferred (elastic, target at rest)"
   },
   "tex": "\\dfrac{4m_1m_2}{(m_1 + m_2)^2}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "Perfectly inelastic collision"
   },
   "tex": "V = \\dfrac{m_1u_1 + m_2u_2}{m_1 + m_2},\\qquad \\Delta K = \\dfrac{m_1m_2}{2(m_1 + m_2)}(u_1 - u_2)^2"
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "General KE loss in a 1-D collision"
   },
   "tex": "\\Delta K = \\dfrac{m_1m_2}{2(m_1 + m_2)}(u_1 - u_2)^2(1 - e^2)"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-physics-05-work-energy-and-power.t5",
   "name": {
    "en": "Oblique elastic collision, equal masses (one at rest)"
   },
   "tex": "\\theta_1 + \\theta_2 = 90^\\circ"
  },
  {
   "id": "zs-f28",
   "name": {
    "en": "Vertical circle (string)"
   },
   "tex": "v_{\\text{top}} \\ge \\sqrt{gl},\\quad v_{\\text{bottom}} \\ge \\sqrt{5gl},\\quad T_b - T_t = 6mg"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-physics-05-work-energy-and-power.t3",
   "name": {
    "en": "Leaving a smooth sphere from the top"
   },
   "tex": "\\cos\\theta = \\dfrac23,\\quad h = \\dfrac{2R}{3}\\ \\text{above the centre}"
  },
  {
   "id": "zs-f30",
   "name": {
    "en": "Chain hanging over a table"
   },
   "tex": "W = \\dfrac{MgL}{2n^2}\\ \\text{to pull up }1/n\\text{ of the length}"
  }
 ]
}
