 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "How many to make?"
   },
   "hook": {
    "en": "Make too few and fixed costs swamp you; make too many and you must cut the price to sell them. Somewhere in between is the output with the greatest profit."
   },
   "objectives": [
    {
     "en": "Maximise profit using MR = MC"
    },
    {
     "en": "Minimise average cost using AC = MC"
    },
    {
     "en": "Maximise revenue from a demand law"
    }
   ],
   "narration": {
    "en": "Make too few and fixed costs swamp you; make too many and you must cut the price to sell them. Somewhere in between is the output with the greatest profit."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Optimisation in business"
   },
   "body": {
    "en": "Profit $P(x) = R(x) - C(x)$ is greatest where $P'(x) = 0$, i.e. $MR = MC$, and $P''(x) < 0$. Average cost $AC = C/x$ is least where $\\dfrac{d}{dx}(C/x) = 0$, which gives $MC = AC$. Revenue $R = px$ is greatest where $MR = 0$. Always check the second derivative and that x lies in the allowed range."
   },
   "points": [
    {
     "en": "Max profit: MR = MC, P″ < 0"
    },
    {
     "en": "Min average cost: MC = AC"
    },
    {
     "en": "Max revenue: MR = 0"
    }
   ],
   "narration": {
    "en": "Profit $P(x) = R(x) - C(x)$ is greatest where $P'(x) = 0$, i.e. $MR = MC$, and $P''(x) < 0$. Average cost $AC = C/x$ is least where $\\dfrac{d}{dx}(C/x) = 0$, which gives $MC = AC$. Revenue $R = px$ is greatest where $MR = 0$. Always check the second derivative and that x lies in the allowed range."
   }
  },
