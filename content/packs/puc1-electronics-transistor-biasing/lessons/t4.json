  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A collector-to-base bias circuit has V_CC = 12 V, R_C = 2 kΩ, R_B = 200 kΩ, β = 100 and V_BE = 0.7 V. Find I_B, I_C and V_CE."
   },
   "steps": [
    {
     "en": "I_B = (12 − 0.7)/(200 kΩ + 100 × 2 kΩ) = 11.3/400 kΩ = 28.25 µA."
    },
    {
     "en": "I_C = β I_B = 100 × 28.25 µA = 2.825 mA."
    },
    {
     "en": "V_CE ≈ 12 − 2.825 mA × 2 kΩ = 12 − 5.65 = 6.35 V."
    }
   ],
   "answer": {
    "en": "I_B ≈ 28.3 µA, I_C ≈ 2.83 mA, V_CE ≈ 6.35 V"
   },
