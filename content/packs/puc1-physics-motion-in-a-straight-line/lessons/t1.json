  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A car goes 6 km east in 10 min and then 2 km west in 5 min. Find its average velocity and average speed."
   },
   "steps": [
    {
     "en": "Displacement = 6 − 2 = 4 km east; path length = 6 + 2 = 8 km."
    },
    {
     "en": "Time = 15 min = 0.25 h."
    },
    {
     "en": "Average velocity = 4 / 0.25 = 16 km/h east; average speed = 8 / 0.25 = 32 km/h."
    }
   ],
   "answer": {
    "en": "16 km/h east; 32 km/h"
   },
   "narration": {
    "en": "Let us solve this together. A car goes 6 km east in 10 min and then 2 km west in 5 min. Find its average velocity and average speed."
   }
  },
  {
   "id": "trick",
   "type": "trick",
   "heading": {
    "en": "Equal distances? Use the harmonic mean"
   },
   "body": {
    "en": "For two equal distances at speeds v₁ and v₂, the average speed is 2v₁v₂/(v₁ + v₂) — never the simple average."
   },
   "narration": {
    "en": "Equal distances? Use the harmonic mean. For two equal distances at speeds v₁ and v₂, the average speed is 2v₁v₂/(v₁ + v₂) — never the simple average."
   },
   "optional": true,
   "mnemonic": {
    "en": "Equal Distance → Double Product over Sum"
   }
  },
