  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Average velocity and average speed"
   },
   "body": {
    "en": "Average velocity is displacement divided by time. Average speed is path length divided by time. For a round trip the average velocity is zero but the average speed is not.",
    "kn": "ಸರಾಸರಿ ವೇಗ = ಸ್ಥಾನಪಲ್ಲಟ ÷ ಕಾಲ. ಸರಾಸರಿ ಜವ = ಪಥದ ಉದ್ದ ÷ ಕಾಲ."
   },
   "points": [
    {
     "en": "Average velocity = Δx / Δt"
    },
    {
     "en": "Average speed = path length / Δt"
    }
   ],
   "narration": {
    "en": "Average velocity is displacement divided by time. Average speed is path length divided by time. For a round trip the average velocity is zero but the average speed is not.",
    "kn": "ಸರಾಸರಿ ವೇಗ = ಸ್ಥಾನಪಲ್ಲಟ ÷ ಕಾಲ. ಸರಾಸರಿ ಜವ = ಪಥದ ಉದ್ದ ÷ ಕಾಲ."
   },
   "formula": "\\bar v = \\frac{\\Delta x}{\\Delta t}"
  },
