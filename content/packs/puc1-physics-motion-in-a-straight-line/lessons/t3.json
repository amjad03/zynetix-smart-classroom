     "label": {
      "en": "Time t₁"
     },
     "min": 0,
     "max": 10,
     "step": 0.5,
     "value": 5,
     "unit": "s"
    }
   ],
   "fns": [
    {
     "fn": "u + a*x",
     "label": "v(t)",
     "color": "yellow"
    }
   ],
   "x": [
    0,
    10
   ],
   "y": [
    -30,
    40
   ],
   "xLabel": "t (s)",
   "yLabel": "v (m/s)",
   "readouts": [
    {
     "label": {
      "en": "Velocity at t₁"
     },
     "expr": "u + a*t1",
     "digits": 2,
     "unit": "m/s"
    },
    {
     "label": {
      "en": "Displacement up to t₁"
     },
     "expr": "u*t1 + a*t1^2/2",
     "digits": 2,
     "unit": "m"
    },
    {
     "label": {
      "en": "Average velocity"
     },
     "expr": "u + a*t1/2",
     "digits": 2,
     "unit": "m/s"
    }
   ],
