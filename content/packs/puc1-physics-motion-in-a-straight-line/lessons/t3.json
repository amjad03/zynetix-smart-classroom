 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Speeding up, slowing down",
    "kn": "ವೇಗ ಹೆಚ್ಚುವುದು, ಕಡಿಮೆಯಾಗುವುದು"
   },
   "hook": {
    "en": "When an auto starts from a signal, its velocity changes every second. The rate of that change is acceleration.",
    "kn": "ಸಿಗ್ನಲ್‌ನಿಂದ ಆಟೋ ಹೊರಡುವಾಗ ಅದರ ವೇಗ ಪ್ರತಿ ಸೆಕೆಂಡಿಗೂ ಬದಲಾಗುತ್ತದೆ. ಆ ಬದಲಾವಣೆಯ ದರವೇ ವೇಗೋತ್ಕರ್ಷ."
   },
   "narration": {
    "en": "When an auto starts from a signal, its velocity changes every second. The rate of that change is acceleration.",
    "kn": "ಸಿಗ್ನಲ್‌ನಿಂದ ಆಟೋ ಹೊರಡುವಾಗ ಅದರ ವೇಗ ಪ್ರತಿ ಸೆಕೆಂಡಿಗೂ ಬದಲಾಗುತ್ತದೆ. ಆ ಬದಲಾವಣೆಯ ದರವೇ ವೇಗೋತ್ಕರ್ಷ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Acceleration"
   },
   "body": {
    "en": "Acceleration is the rate of change of velocity, $a = dv/dt$, measured in m/s². It is the slope of the v–t graph. If a and v have opposite signs the body slows down (retardation).",
    "kn": "ವೇಗೋತ್ಕರ್ಷ ಎಂದರೆ ವೇಗದ ಬದಲಾವಣೆಯ ದರ, a = dv/dt. ಇದು v–t ನಕ್ಷೆಯ ಇಳಿಜಾರು."
   },
   "points": [
    {
     "en": "a = dv/dt = d²x/dt²"
    },
    {
     "en": "Slope of v–t graph = acceleration"
    },
    {
     "en": "Area under v–t graph = displacement"
    }
   ],
   "narration": {
    "en": "Acceleration is the rate of change of velocity, $a = dv/dt$, measured in m/s². It is the slope of the v–t graph. If a and v have opposite signs the body slows down (retardation).",
    "kn": "ವೇಗೋತ್ಕರ್ಷ ಎಂದರೆ ವೇಗದ ಬದಲಾವಣೆಯ ದರ, a = dv/dt. ಇದು v–t ನಕ್ಷೆಯ ಇಳಿಜಾರು."
   },
   "formula": "a = \\frac{dv}{dt}"
  },
