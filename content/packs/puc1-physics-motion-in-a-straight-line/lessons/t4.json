  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A car moving at 20 m/s brakes with a retardation of 5 m/s². How far does it go before stopping?"
   },
   "steps": [
    {
     "en": "u = 20, v = 0, a = −5; time not asked, so use v² = u² + 2as."
    },
    {
     "en": "0 = 400 − 10s."
    },
