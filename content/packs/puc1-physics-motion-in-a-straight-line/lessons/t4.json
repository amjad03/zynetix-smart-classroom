       "kind": "axes",
       "from": [
        5,
        8
       ],
       "to": [
        45,
        52
       ],
       "x": [
        0,
        5
       ],
       "y": [
        0,
        10
       ],
       "color": "white",
       "xLabel": "t",
       "yLabel": "v"
      },
      {
       "kind": "plot",
       "fn": "2+1.4*x",
       "color": "yellow"
      },
      {
       "kind": "line",
       "from": [
        5,
        43.2
       ],
       "to": [
        45,
        43.2
       ],
       "color": "white",
       "dashed": true
      },
      {
       "kind": "line",
       "from": [
        45,
        52
       ],
       "to": [
        45,
        12.4
       ],
       "color": "white",
       "dashed": true
      },
      {
       "kind": "text",
       "at": [
        20,
        46
       ],
       "text": {
        "en": "ut"
       },
       "size": 3.5,
       "color": "white"
      },
      {
       "kind": "text",
       "at": [
        30,
        33
       ],
       "text": {
        "en": "½·at·t"
       },
       "size": 3.5,
       "color": "white"
      },
      {
       "kind": "math",
       "at": [
        52,
        16
       ],
       "tex": "s = ut + \\tfrac12 at^{2}",
       "size": 4.5,
       "color": "yellow"
      }
     ]
    },
    {
     "say": {
      "en": "Eliminate t using t equals v minus u over a, and the third equation appears."
     },
     "draw": [
      {
       "kind": "math",
       "at": [
        52,
        26
       ],
       "tex": "t = \\frac{v-u}{a}",
       "size": 4,
       "color": "white"
      },
      {
       "kind": "math",
       "at": [
        52,
        37
       ],
       "tex": "v^{2} = u^{2} + 2as",
       "size": 4.5,
       "color": "yellow"
      }
     ]
    },
    {
     "say": {
      "en": "The distance in the nth second is the displacement in n seconds minus that in n minus one seconds."
     },
     "draw": [
      {
       "kind": "math",
       "at": [
        52,
        47
       ],
       "tex": "s_n = u + \\tfrac{a}{2}(2n-1)",
       "size": 4,
       "color": "green"
      }
     ]
    },
