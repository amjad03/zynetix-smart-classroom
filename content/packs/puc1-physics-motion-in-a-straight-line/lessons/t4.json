 "topicId": "puc1-physics-02-motion-in-a-straight-line.t4",
 "title": {
  "en": "Kinematic equations for uniformly accelerated motion",
  "kn": "ಏಕರೂಪ ವೇಗೋತ್ಕರ್ಷದ ಚಲನೆಯ ಸಮೀಕರಣಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Three equations solve almost every problem",
    "kn": "ಮೂರು ಸಮೀಕರಣಗಳು ಬಹುತೇಕ ಎಲ್ಲಾ ಸಮಸ್ಯೆಗಳನ್ನು ಬಿಡಿಸುತ್ತವೆ"
   },
   "hook": {
    "en": "If acceleration is constant, three short equations connect u, v, a, s and t.",
    "kn": "ವೇಗೋತ್ಕರ್ಷ ಸ್ಥಿರವಾಗಿದ್ದರೆ, ಮೂರು ಸಮೀಕರಣಗಳು u, v, a, s ಮತ್ತು t ಗಳನ್ನು ಜೋಡಿಸುತ್ತವೆ."
   },
   "narration": {
    "en": "If acceleration is constant, three short equations connect u, v, a, s and t.",
    "kn": "ವೇಗೋತ್ಕರ್ಷ ಸ್ಥಿರವಾಗಿದ್ದರೆ, ಮೂರು ಸಮೀಕರಣಗಳು u, v, a, s ಮತ್ತು t ಗಳನ್ನು ಜೋಡಿಸುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The equations of motion"
   },
   "body": {
    "en": "For constant acceleration: $v = u + at$, $s = ut + \\frac12 at^2$, $v^2 = u^2 + 2as$. The distance in the nth second is $s_n = u + \\frac a2(2n-1)$.",
    "kn": "ಸ್ಥಿರ ವೇಗೋತ್ಕರ್ಷಕ್ಕೆ: v = u + at, s = ut + ½at², v² = u² + 2as."
   },
   "points": [
    {
     "en": "Pick the equation that does not contain the quantity you are not given"
    },
    {
     "en": "Take one direction as positive and keep signs"
    }
   ],
   "narration": {
    "en": "For constant acceleration: $v = u + at$, $s = ut + \\frac12 at^2$, $v^2 = u^2 + 2as$. The distance in the nth second is $s_n = u + \\frac a2(2n-1)$.",
    "kn": "ಸ್ಥಿರ ವೇಗೋತ್ಕರ್ಷಕ್ಕೆ: v = u + at, s = ut + ½at², v² = u² + 2as."
   },
   "formula": "v = u + at,\\quad s = ut + \\tfrac12 at^2,\\quad v^2 = u^2 + 2as"
  },
  {
