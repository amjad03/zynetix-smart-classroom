{
 "chapterId": "puc1-physics-02-motion-in-a-straight-line",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t4",
   "name": {
    "en": "Equations of motion"
   },
   "tex": "v = u + at,\\quad s = ut + \\tfrac12at^2,\\quad v^2 = u^2 + 2as",
   "note": {
    "en": "Constant acceleration only."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t4",
   "name": {
    "en": "Distance in nth second"
   },
   "tex": "s_n = u + \\frac a2(2n - 1)",
   "note": {
    "en": "From rest: 1 : 3 : 5 … ratio."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Time of flight"
   },
   "tex": "T = \\frac{2u\\sin\\theta}{g}",
   "note": {
    "en": "Ground-to-ground projectile."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Maximum height"
   },
   "tex": "H = \\frac{u^2\\sin^2\\theta}{2g}",
   "note": {
    "en": "Depends on vertical component only."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Horizontal range"
   },
   "tex": "R = \\frac{u^2\\sin2\\theta}{g}",
   "note": {
    "en": "Max at 45°; equal for θ and 90° − θ."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Trajectory equation"
   },
   "tex": "y = x\\tan\\theta - \\frac{gx^2}{2u^2\\cos^2\\theta}",
   "note": {
    "en": "A parabola."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "River crossing (min time)"
   },
   "tex": "t = \\frac{d}{v_b},\\quad \\text{drift} = \\frac{v_r d}{v_b}",
   "note": {
    "en": "Steer perpendicular to flow."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Centripetal acceleration"
   },
   "tex": "a_c = \\frac{v^2}{r} = \\omega^2 r",
   "note": {
    "en": "Directed towards the centre."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t1",
   "name": {
    "en": "Displacement vs distance"
   },
   "tex": "|\\Delta x| \\le \\text{path length}",
   "note": {
    "en": "Equal only for motion in one direction without turning back."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t1",
   "name": {
    "en": "Average velocity and speed"
   },
   "tex": "\\bar v = \\dfrac{\\Delta x}{\\Delta t},\\qquad \\bar v_{\\text{speed}} = \\dfrac{\\text{total path length}}{\\text{total time}}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t1",
   "name": {
    "en": "Equal distances / equal times"
   },
   "tex": "\\bar v = \\dfrac{2v_1v_2}{v_1 + v_2}\\ (\\text{equal distances}),\\qquad \\bar v = \\dfrac{v_1 + v_2}{2}\\ (\\text{equal times})"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t2",
   "name": {
    "en": "Instantaneous velocity and acceleration"
   },
   "tex": "v = \\dfrac{dx}{dt},\\qquad a = \\dfrac{dv}{dt} = \\dfrac{d^2x}{dt^2} = v\\dfrac{dv}{dx}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Graphs"
   },
   "tex": "\\text{slope}(x\\text{–}t) = v,\\quad \\text{slope}(v\\text{–}t) = a,\\quad \\text{area}(v\\text{–}t) = \\Delta x,\\quad \\text{area}(a\\text{–}t) = \\Delta v"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t4",
   "name": {
    "en": "Equations of uniformly accelerated motion"
   },
   "tex": "v = u + at,\\quad s = ut + \\tfrac12at^2,\\quad v^2 = u^2 + 2as,\\quad s = \\tfrac{(u+v)}{2}t"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t4",
   "name": {
    "en": "Distance in the nth second"
   },
   "tex": "s_n = u + \\dfrac{a}{2}(2n - 1)",
   "note": {
    "en": "From rest: distances in successive seconds are in ratio 1 : 3 : 5 : …"
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t1",
   "name": {
    "en": "Stopping distance"
   },
   "tex": "s = \\dfrac{u^2}{2a},\\qquad s_{\\text{total}} = ut_r + \\dfrac{u^2}{2a}",
   "note": {
    "en": "t_r = reaction time; s ∝ u²."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Free fall from rest"
   },
   "tex": "v = gt,\\quad h = \\tfrac12gt^2,\\quad v = \\sqrt{2gh},\\quad t = \\sqrt{2h/g}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Vertical throw (speed u)"
   },
   "tex": "H = \\dfrac{u^2}{2g},\\quad t_{\\text{up}} = \\dfrac{u}{g},\\quad T = \\dfrac{2u}{g}",
   "note": {
    "en": "Same speed at a given height on the way up and down."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Times at a height h"
   },
   "tex": "t_1 + t_2 = \\dfrac{2u}{g},\\qquad t_1t_2 = \\dfrac{2h}{g}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Thrown up from height h"
   },
   "tex": "-h = ut - \\tfrac12gt^2\\ (\\text{upward positive})",
   "note": {
    "en": "An object released from a moving balloon or lift starts with that body's velocity."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t1",
   "name": {
    "en": "Relative velocity (1D)"
   },
   "tex": "v_{AB} = v_A - v_B",
   "note": {
    "en": "Same direction: subtract speeds; opposite: add. Crossing trains cover L₁ + L₂."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Relative acceleration"
   },
   "tex": "a_{AB} = a_A - a_B",
   "note": {
    "en": "Two bodies in free fall: relative acceleration 0 → relative motion is uniform."
   }
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Non-uniform acceleration"
   },
   "tex": "v = u + \\int_0^t a\\,dt,\\qquad x = x_0 + \\int_0^t v\\,dt,\\qquad \\int v\\,dv = \\int a\\,dx"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t3",
   "name": {
    "en": "Velocity-dependent retardation"
   },
   "tex": "a = -kv \\Rightarrow v = v_0e^{-kt},\\ x_{\\max} = \\dfrac{v_0}{k}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t1",
   "name": {
    "en": "Accelerate then decelerate (α, β, total time t)"
   },
   "tex": "v_{\\max} = \\dfrac{\\alpha\\beta t}{\\alpha + \\beta},\\qquad s = \\dfrac{\\alpha\\beta t^2}{2(\\alpha + \\beta)}"
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-physics-02-motion-in-a-straight-line.t5",
   "name": {
    "en": "Chase from rest"
   },
   "tex": "v_0t = \\tfrac12at^2 \\Rightarrow t = \\dfrac{2v_0}{a}",
   "note": {
    "en": "Maximum separation when speeds are equal, at t = v₀/a."
   }
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Bolt falling in an accelerating lift"
   },
   "tex": "t = \\sqrt{\\dfrac{2h}{g + a}}\\ (\\text{lift accelerating up})"
  }
 ]
}
