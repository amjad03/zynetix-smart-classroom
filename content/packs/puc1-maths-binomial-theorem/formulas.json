{
 "chapterId": "puc1-maths-07-binomial-theorem",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-07-binomial-theorem.t2",
   "name": {
    "en": "Binomial theorem"
   },
   "tex": "(a + b)^n = \\sum_{r=0}^{n}{}^nC_r\\,a^{n-r}b^r",
   "note": {
    "en": "n + 1 terms"
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-07-binomial-theorem.t4",
   "name": {
    "en": "General term"
   },
   "tex": "T_{r+1} = {}^nC_r\\,a^{n-r}b^r"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-07-binomial-theorem.t5",
   "name": {
    "en": "Middle term(s)"
   },
   "tex": "n \\text{ even: } T_{\\frac n2 + 1};\\quad n \\text{ odd: } T_{\\frac{n+1}{2}},\\ T_{\\frac{n+3}{2}}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "r-th term from the end"
   },
   "tex": "T_r(\\text{end}) = T_{n - r + 2}(\\text{beginning})"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-07-binomial-theorem.t5",
   "name": {
    "en": "Term independent of x"
   },
   "tex": "\\text{set the power of } x \\text{ in } T_{r+1} \\text{ equal to } 0"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "Sum of coefficients"
   },
   "tex": "\\sum_{r=0}^n {}^nC_r = 2^n;\\quad \\text{for } p(x),\\ \\text{sum} = p(1)"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "Alternating sum"
   },
   "tex": "\\sum_{r=0}^n (-1)^r\\,{}^nC_r = 0"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-maths-07-binomial-theorem.t5",
   "name": {
    "en": "Odd / even coefficients"
   },
   "tex": "C_0 + C_2 + \\cdots = C_1 + C_3 + \\cdots = 2^{n-1}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "Sum with weight r"
   },
   "tex": "\\sum r\\,{}^nC_r = n\\,2^{n-1};\\quad \\sum r^2\\,{}^nC_r = n(n+1)\\,2^{n-2}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "Sum with 1/(r+1)"
   },
   "tex": "\\sum \\frac{^nC_r}{r+1} = \\frac{2^{n+1} - 1}{n + 1}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "Sum of squares"
   },
   "tex": "\\sum ({}^nC_r)^2 = {}^{2n}C_n;\\quad \\sum C_rC_{r+k} = {}^{2n}C_{n-k}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Vandermonde"
   },
   "tex": "\\sum_r {}^mC_r\\,{}^nC_{k-r} = {}^{m+n}C_k"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Ratio of consecutive terms"
   },
   "tex": "\\frac{T_{r+1}}{T_r} = \\frac{n - r + 1}{r}\\cdot\\frac ba",
   "note": {
    "en": "Greatest term: largest r with ratio ≥ 1"
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-07-binomial-theorem.t2",
   "name": {
    "en": "Greatest binomial coefficient"
   },
   "tex": "n \\text{ even: } {}^nC_{n/2};\\quad n \\text{ odd: } {}^nC_{(n-1)/2} = {}^nC_{(n+1)/2}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-07-binomial-theorem.t1",
   "name": {
    "en": "Sum and difference"
   },
   "tex": "(x+a)^n \\pm (x-a)^n:\\ \\text{only even / only odd powers of } a\\text{ survive (doubled)}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-maths-07-binomial-theorem.t4",
   "name": {
    "en": "Number of terms of a trinomial"
   },
   "tex": "(a + b + c)^n:\\ {}^{n+2}C_2 \\text{ terms}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Multinomial coefficient"
   },
   "tex": "\\text{coefficient of } a^pb^qc^s \\text{ in } (a+b+c)^n = \\frac{n!}{p!\\,q!\\,s!},\\ p+q+s = n"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Divisibility / remainders"
   },
   "tex": "(1 + x)^n = 1 + nx + x^2(\\cdots) \\Rightarrow (1+x)^n - 1 - nx \\text{ divisible by } x^2"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Bernoulli-type inequality"
   },
   "tex": "(1 + x)^n > 1 + nx\\quad (x > 0,\\ n > 1)"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Approximation"
   },
   "tex": "(1 + x)^n \\approx 1 + nx + \\tfrac{n(n-1)}{2}x^2\\quad (|x| \\text{ small})"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-maths-07-binomial-theorem.t2",
   "name": {
    "en": "Integral and fractional part"
   },
   "tex": "(a + \\sqrt b)^n + (a - \\sqrt b)^n \\in \\mathbb Z \\ (0 < a - \\sqrt b < 1) \\Rightarrow f + f' = 1"
  }
 ]
}
