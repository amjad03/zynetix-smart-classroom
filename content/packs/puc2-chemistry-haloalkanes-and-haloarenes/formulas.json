{
 "chapterId": "puc2-chemistry-06-haloalkanes-and-haloarenes",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t2",
   "name": {
    "en": "Alcohol → alkyl halide"
   },
   "tex": "\\text{R–OH} + \\text{SOCl}_2 \\rightarrow \\text{R–Cl} + \\text{SO}_2\\uparrow + \\text{HCl}\\uparrow",
   "note": {
    "en": "Also HCl/ZnCl₂ (Lucas), PCl₅, PCl₃, red P + Br₂/I₂. HX reactivity: HI > HBr > HCl; alcohols 3° > 2° > 1°."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t2",
   "name": {
    "en": "Addition of HX to alkenes"
   },
   "tex": "\\text{CH}_3\\text{CH=CH}_2 \\xrightarrow{\\text{HBr}} \\text{CH}_3\\text{CHBrCH}_3;\\quad \\xrightarrow{\\text{HBr, peroxide}} \\text{CH}_3\\text{CH}_2\\text{CH}_2\\text{Br}",
   "note": {
    "en": "Peroxide (Kharasch) effect only for HBr."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t2",
   "name": {
    "en": "Finkelstein reaction"
   },
   "tex": "\\text{R–X} + \\text{NaI} \\xrightarrow{\\text{dry acetone}} \\text{R–I} + \\text{NaX}\\downarrow",
   "note": {
    "en": "X = Cl, Br; NaX precipitates."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t2",
   "name": {
    "en": "Swarts reaction"
   },
   "tex": "\\text{R–Br} + \\text{AgF} \\rightarrow \\text{R–F} + \\text{AgBr}",
   "note": {
    "en": "Also Hg₂F₂, CoF₂, SbF₃."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t2",
   "name": {
    "en": "Sandmeyer reaction"
   },
   "tex": "\\text{ArN}_2^+\\text{X}^- \\xrightarrow{\\text{CuX/HX}} \\text{Ar–X} + \\text{N}_2",
   "note": {
    "en": "Cu powder/HX: Gattermann. Ar–I by warming with KI (no Cu needed)."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t2",
   "name": {
    "en": "Physical properties"
   },
   "tex": "\\text{b.p.: RI > RBr > RCl > RF};\\ \\ \\text{straight chain > branched}",
   "note": {
    "en": "Density CH₂Cl₂ < CHCl₃ < CCl₄. Dipole: CH₃Cl > CH₃F > CH₃Br > CH₃I. p-Dihalobenzene has the highest m.p."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t3",
   "name": {
    "en": "SN2"
   },
   "tex": "\\text{rate} = k[\\text{RX}][\\text{Nu}^-]",
   "note": {
    "en": "One step, back-side attack, inversion. CH₃ > 1° > 2° > 3°; neopentyl very slow. Polar aprotic solvent."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t3",
   "name": {
    "en": "SN1"
   },
   "tex": "\\text{rate} = k[\\text{RX}]",
   "note": {
    "en": "Carbocation; racemisation; rearrangements. 3° > 2° > 1°; benzylic and allylic fast. Polar protic solvent."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Leaving-group order"
   },
   "tex": "\\text{R–I} > \\text{R–Br} > \\text{R–Cl} > \\text{R–F}",
   "note": {
    "en": "Follows weakening C–X bond."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t3",
   "name": {
    "en": "Ambident nucleophiles"
   },
   "tex": "\\text{KCN} \\to \\text{R–CN};\\ \\text{AgCN} \\to \\text{R–NC};\\ \\text{KNO}_2 \\to \\text{R–ONO};\\ \\text{AgNO}_2 \\to \\text{R–NO}_2",
   "note": {
    "en": "Ionic salt vs covalent silver salt."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t4",
   "name": {
    "en": "Aqueous vs alcoholic KOH"
   },
   "tex": "\\text{aq. KOH} \\to \\text{R–OH (substitution)};\\quad \\text{alc. KOH} \\to \\text{alkene (elimination)}",
   "note": {
    "en": "Saytzeff: more substituted alkene is major. 3° halides favour elimination."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t4",
   "name": {
    "en": "Grignard reagent"
   },
   "tex": "\\text{R–X} + \\text{Mg} \\xrightarrow{\\text{dry ether}} \\text{RMgX};\\quad \\text{RMgX} + \\text{H}_2\\text{O} \\rightarrow \\text{R–H} + \\text{Mg(OH)X}",
   "note": {
    "en": "Any active H (OH, NH, SH, ≡C–H) gives R–H."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t5",
   "name": {
    "en": "Wurtz, Wurtz–Fittig, Fittig"
   },
   "tex": "2\\text{RX} + 2\\text{Na} \\rightarrow \\text{R–R};\\quad \\text{ArX} + \\text{RX} + 2\\text{Na} \\rightarrow \\text{Ar–R};\\quad 2\\text{ArX} + 2\\text{Na} \\rightarrow \\text{Ar–Ar}",
   "note": {
    "en": "All in dry ether."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t5",
   "name": {
    "en": "Low reactivity of haloarenes"
   },
   "tex": "\\text{C–Cl: 169 pm (Ar–Cl)} < \\text{177 pm (CH}_3\\text{Cl)}",
   "note": {
    "en": "Resonance (partial C=Cl), sp² carbon, unstable phenyl cation, π-electron repulsion of the nucleophile."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t3",
   "name": {
    "en": "Nucleophilic aromatic substitution"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{Cl} \\xrightarrow[\\ 623\\,\\text{K},\\ 300\\,\\text{atm}\\ ]{\\text{NaOH}} \\text{C}_6\\text{H}_5\\text{ONa} \\xrightarrow{\\text{H}^+} \\text{C}_6\\text{H}_5\\text{OH}",
   "note": {
    "en": "o/p-NO₂ makes it easier: 4-nitro 443 K, 2,4-dinitro 368 K, 2,4,6-trinitro 323 K (warm water)."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t5",
   "name": {
    "en": "Electrophilic substitution of haloarenes"
   },
   "tex": "-I > +R\\ \\Rightarrow\\ \\text{deactivating but } o/p\\text{-directing}",
   "note": {
    "en": "Cl₂/FeCl₃, HNO₃/H₂SO₄, H₂SO₄, RCl/AlCl₃, RCOCl/AlCl₃ all give mainly para."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-06-haloalkanes-and-haloarenes.t4",
   "name": {
    "en": "Chirality"
   },
   "tex": "\\text{C with four different groups} \\Rightarrow \\text{chiral};\\ \\ 2^n\\ \\text{stereoisomers (max)}",
   "note": {
    "en": "Racemic mixture: optically inactive (external compensation)."
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Chloroform oxidation"
   },
   "tex": "2\\,\\text{CHCl}_3 + \\text{O}_2 \\xrightarrow{h\\nu} 2\\,\\text{COCl}_2 + 2\\,\\text{HCl}",
   "note": {
    "en": "Stored in dark, full bottles."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Polyhalogen compounds"
   },
   "tex": "\\text{Freon-12} = \\text{CCl}_2\\text{F}_2;\\ \\ \\text{DDT};\\ \\ \\text{CHI}_3\\ (\\text{antiseptic, frees I}_2)",
   "note": {
    "en": "Freons and CCl₄ deplete ozone; DDT is non-biodegradable and accumulates in fatty tissue."
   }
  }
 ]
}
