{
 "chapterId": "puc1-maths-12-limits-and-derivatives",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-12-limits-and-derivatives.t3",
   "name": {
    "en": "Standard sine limit"
   },
   "tex": "\\lim_{x\\to0}\\frac{\\sin x}{x} = 1",
   "note": {
    "en": "x in radians."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Exponential limit"
   },
   "tex": "\\lim_{x\\to0}\\frac{e^x - 1}{x} = 1",
   "note": {
    "en": "aˣ version gives ln a."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Log limit"
   },
   "tex": "\\lim_{x\\to0}\\frac{\\ln(1 + x)}{x} = 1",
   "note": {
    "en": "Pairs with e limit."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Power limit"
   },
   "tex": "\\lim_{x\\to a}\\frac{x^n - a^n}{x - a} = na^{n-1}",
   "note": {
    "en": "Any rational n."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "1^∞ form"
   },
   "tex": "\\lim f^g = e^{\\lim g(f - 1)}",
   "note": {
    "en": "When f → 1, g → ∞."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-12-limits-and-derivatives.t4",
   "name": {
    "en": "Definition of e"
   },
   "tex": "\\lim_{x\\to0}(1 + x)^{1/x} = e",
   "note": {
    "en": "Basis of the 1^∞ shortcut."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Continuity at a"
   },
   "tex": "\\lim_{x\\to a^-}f = \\lim_{x\\to a^+}f = f(a)",
   "note": {
    "en": "LHL = RHL = value."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-maths-12-limits-and-derivatives.t5",
   "name": {
    "en": "L'Hôpital's rule"
   },
   "tex": "\\lim\\frac fg = \\lim\\frac{f'}{g'}",
   "note": {
    "en": "Only for 0/0 or ∞/∞."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Existence of a limit"
   },
   "tex": "\\lim_{x\\to a}f(x) = L \\iff \\lim_{x\\to a^-}f(x) = \\lim_{x\\to a^+}f(x) = L"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Algebra of limits"
   },
   "tex": "\\lim(f\\pm g) = \\lim f\\pm\\lim g,\\quad \\lim(fg) = \\lim f\\cdot\\lim g,\\quad \\lim\\frac fg = \\frac{\\lim f}{\\lim g}\\ (\\lim g\\ne0)"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Polynomials and rational functions"
   },
   "tex": "\\lim_{x\\to a}p(x) = p(a),\\qquad \\lim_{x\\to a}\\frac{p(x)}{q(x)} = \\frac{p(a)}{q(a)}\\ \\ (q(a)\\ne0)",
   "note": {
    "en": "for $\\frac00$, factor out $(x-a)$ or rationalise"
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Power limit"
   },
   "tex": "\\lim_{x\\to a}\\frac{x^n-a^n}{x-a} = na^{n-1}",
   "note": {
    "en": "valid for any rational n (a > 0 when needed)"
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-12-limits-and-derivatives.t3",
   "name": {
    "en": "Standard trigonometric limits"
   },
   "tex": "\\lim_{x\\to0}\\frac{\\sin x}{x} = 1,\\quad \\lim_{x\\to0}\\frac{\\tan x}{x} = 1,\\quad \\lim_{x\\to0}\\frac{1-\\cos x}{x^2} = \\frac12",
   "note": {
    "en": "x in radians; in degrees sin x°/x → π/180"
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Scaled forms"
   },
   "tex": "\\lim_{x\\to0}\\frac{\\sin ax}{bx} = \\frac ab,\\qquad \\lim_{x\\to0}\\frac{1-\\cos ax}{x^2} = \\frac{a^2}2"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Limits at infinity (rational)"
   },
   "tex": "\\lim_{x\\to\\infty}\\frac{a_0x^m+\\cdots}{b_0x^n+\\cdots} = \\begin{cases}\\frac{a_0}{b_0} & m = n\\\\ 0 & m<n\\\\ \\pm\\infty & m>n\\end{cases}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Exponential and log limits"
   },
   "tex": "\\lim_{x\\to0}\\frac{e^x-1}{x} = 1,\\quad \\lim_{x\\to0}\\frac{\\log(1+x)}{x} = 1,\\quad \\lim_{x\\to0}\\frac{a^x-1}{x} = \\log a"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Small-x approximations (JEE)"
   },
   "tex": "\\sin x\\approx x-\\frac{x^3}6,\\quad \\cos x\\approx1-\\frac{x^2}2,\\quad \\tan x\\approx x+\\frac{x^3}3"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-maths-12-limits-and-derivatives.t1",
   "name": {
    "en": "Derivative (first principles)"
   },
   "tex": "f'(x) = \\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}",
   "note": {
    "en": "slope of the tangent at (x, f(x)); instantaneous rate of change"
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Left / right derivatives"
   },
   "tex": "Lf'(a) = \\lim_{h\\to0^-}\\frac{f(a+h)-f(a)}h,\\quad Rf'(a) = \\lim_{h\\to0^+}\\frac{f(a+h)-f(a)}h",
   "note": {
    "en": "f is differentiable at a iff both exist and are equal"
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-maths-12-limits-and-derivatives.t5",
   "name": {
    "en": "Power rule"
   },
   "tex": "\\frac{d}{dx}x^n = nx^{n-1},\\qquad \\frac{d}{dx}c = 0"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Sum and constant multiple"
   },
   "tex": "(u\\pm v)' = u'\\pm v',\\qquad (cu)' = cu'"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-maths-12-limits-and-derivatives.t5",
   "name": {
    "en": "Product rule"
   },
   "tex": "(uv)' = u'v+uv',\\qquad (uvw)' = u'vw+uv'w+uvw'"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-maths-12-limits-and-derivatives.t5",
   "name": {
    "en": "Quotient rule"
   },
   "tex": "\\left(\\frac uv\\right)' = \\frac{u'v-uv'}{v^2}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-maths-12-limits-and-derivatives.t4",
   "name": {
    "en": "Trigonometric derivatives"
   },
   "tex": "(\\sin x)' = \\cos x,\\ (\\cos x)' = -\\sin x,\\ (\\tan x)' = \\sec^2x"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-maths-12-limits-and-derivatives.t4",
   "name": {
    "en": "More trigonometric derivatives"
   },
   "tex": "(\\sec x)' = \\sec x\\tan x,\\ (\\csc x)' = -\\csc x\\cot x,\\ (\\cot x)' = -\\csc^2x"
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-maths-12-limits-and-derivatives.t2",
   "name": {
    "en": "Product of linear factors"
   },
   "tex": "f(x) = \\prod_{k=1}^n(x-a_k)\\Rightarrow f'(a_1) = \\prod_{k=2}^n(a_1-a_k)"
  }
 ]
}
