 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Shape of the company",
    "kn": "ಕಂಪನಿಯ ಆಕಾರ"
   },
   "hook": {
    "en": "A company that makes only biscuits and one that makes biscuits, soaps and cement cannot have the same structure. Let us compare the two main shapes.",
    "kn": "ಕೇವಲ ಬಿಸ್ಕತ್ ತಯಾರಿಸುವ ಕಂಪನಿ ಮತ್ತು ಬಿಸ್ಕತ್, ಸಾಬೂನು, ಸಿಮೆಂಟ್ ತಯಾರಿಸುವ ಕಂಪನಿಗೆ ಒಂದೇ ರಚನೆ ಇರಲಾರದು. ಎರಡು ಮುಖ್ಯ ರಚನೆಗಳನ್ನು ಹೋಲಿಸೋಣ."
   },
   "objectives": [
    {
     "en": "Explain functional and divisional structures"
    },
    {
     "en": "State their merits, demerits and suitability"
    }
   ],
   "narration": {
    "en": "A company that makes only biscuits and one that makes biscuits, soaps and cement cannot have the same structure. Let us compare the two main shapes.",
    "kn": "ಕೇವಲ ಬಿಸ್ಕತ್ ತಯಾರಿಸುವ ಕಂಪನಿ ಮತ್ತು ಬಿಸ್ಕತ್, ಸಾಬೂನು, ಸಿಮೆಂಟ್ ತಯಾರಿಸುವ ಕಂಪನಿಗೆ ಒಂದೇ ರಚನೆ ಇರಲಾರದು. ಎರಡು ಮುಖ್ಯ ರಚನೆಗಳನ್ನು ಹೋಲಿಸೋಣ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Functional structure"
   },
   "body": {
    "en": "In a functional structure, jobs of a similar nature are grouped into functions such as production, purchase, marketing, finance and human resources, each under a head who reports to the managing director. It suits large firms with diversified activities needing high specialisation."
   },
   "points": [
    {
     "en": "Merits: specialisation, control within a department, little duplication, easy training"
    },
    {
     "en": "Demerits: functional empires, poor inter-department coordination, conflict, inflexibility"
    }
   ],
   "narration": {
    "en": "In a functional structure, jobs of a similar nature are grouped into functions such as production, purchase, marketing, finance and human resources, each under a head who reports to the managing director. It suits large firms with diversified activities needing high specialisation.",
    "kn": "ಕಾರ್ಯಾತ್ಮಕ ರಚನೆಯಲ್ಲಿ ಉತ್ಪಾದನೆ, ಮಾರಾಟ, ಹಣಕಾಸು ಮುಂತಾದ ಕಾರ್ಯಗಳ ಆಧಾರದ ಮೇಲೆ ವಿಭಾಗಗಳು ರೂಪುಗೊಳ್ಳುತ್ತವೆ."
   }
  },
