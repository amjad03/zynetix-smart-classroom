{
 "chapterId": "puc1-chemistry-07-redox-reactions",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-07-redox-reactions.t1",
   "name": {
    "en": "Oxidation / reduction (electronic)"
   },
   "tex": "\\text{Oxidation} = \\text{loss of } e^-;\\quad \\text{Reduction} = \\text{gain of } e^-",
   "note": {
    "en": "Classical: oxidation = addition of O / electronegative element or removal of H; reduction is the reverse."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-07-redox-reactions.t1",
   "name": {
    "en": "Oxidising and reducing agents"
   },
   "tex": "\\text{oxidant: gains } e^-,\\ \\text{O.N.}\\downarrow;\\quad \\text{reductant: loses } e^-,\\ \\text{O.N.}\\uparrow"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-07-redox-reactions.t2",
   "name": {
    "en": "Sum rule for oxidation numbers"
   },
   "tex": "\\sum \\text{O.N.} = 0 \\ (\\text{molecule}),\\qquad \\sum \\text{O.N.} = \\text{charge} \\ (\\text{ion})"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Fixed oxidation numbers"
   },
   "tex": "\\text{F} = -1;\\ \\text{alkali metals} = +1;\\ \\text{alkaline earths} = +2;\\ \\text{Al} = +3;\\ \\text{free element} = 0"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Oxygen"
   },
   "tex": "\\text{O} = -2;\\ \\text{peroxide } (\\text{O}_2^{2-}) = -1;\\ \\text{superoxide } (\\text{O}_2^-) = -\\tfrac12;\\ \\text{OF}_2 = +2;\\ \\text{O}_2\\text{F}_2 = +1"
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Hydrogen"
   },
   "tex": "\\text{H} = +1 \\ (\\text{with non-metals}),\\quad \\text{H} = -1 \\ (\\text{metal hydrides, e.g. NaH, CaH}_2)"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-07-redox-reactions.t2",
   "name": {
    "en": "Peroxide-containing traps"
   },
   "tex": "\\text{H}_2\\text{SO}_5,\\ \\text{H}_2\\text{S}_2\\text{O}_8: \\text{S} = +6;\\quad \\text{CrO}_5: \\text{Cr} = +6",
   "note": {
    "en": "Average O.N. can be fractional: Fe₃O₄ = +8/3, S in S₄O₆²⁻ = +2.5."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-07-redox-reactions.t2",
   "name": {
    "en": "Range of oxidation states"
   },
   "tex": "\\text{N}: -3 \\text{ to } +5;\\quad \\text{S}: -2 \\text{ to } +6;\\quad \\text{Cl}: -1 \\text{ to } +7;\\quad \\text{Os in OsO}_4 = +8",
   "note": {
    "en": "An element at its maximum state can only be an oxidant; at its minimum, only a reductant; in between, both."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-07-redox-reactions.t3",
   "name": {
    "en": "Types of redox reactions"
   },
   "tex": "\\text{combination, decomposition, displacement (metal / non-metal), disproportionation}",
   "note": {
    "en": "Not every decomposition is redox (e.g. CaCO₃ → CaO + CO₂)."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-07-redox-reactions.t3",
   "name": {
    "en": "Disproportionation"
   },
   "tex": "\\text{Cl}_2 + 2\\text{OH}^- \\rightarrow \\text{Cl}^- + \\text{ClO}^- + \\text{H}_2\\text{O}",
   "note": {
    "en": "Same element both oxidised and reduced. F₂ and ClO₄⁻ cannot disproportionate."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-07-redox-reactions.t4",
   "name": {
    "en": "Balancing — oxidation number method"
   },
   "tex": "\\text{(total O.N. increase)} = \\text{(total O.N. decrease)}",
   "note": {
    "en": "Then balance O with H₂O, H with H⁺ (acid) or H₂O/OH⁻ (base), then check charge."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-07-redox-reactions.t4",
   "name": {
    "en": "Balancing — half-reaction method"
   },
   "tex": "\\text{MnO}_4^- + 8\\text{H}^+ + 5e^- \\rightarrow \\text{Mn}^{2+} + 4\\text{H}_2\\text{O}",
   "note": {
    "en": "Multiply half-reactions so electrons cancel."
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Permanganate in different media"
   },
   "tex": "\\text{acid: Mn}^{2+} (5e^-);\\quad \\text{neutral/weak base: MnO}_2 (3e^-);\\quad \\text{strong base: MnO}_4^{2-} (1e^-)"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-07-redox-reactions.t4",
   "name": {
    "en": "Dichromate in acid"
   },
   "tex": "\\text{Cr}_2\\text{O}_7^{2-} + 14\\text{H}^+ + 6e^- \\rightarrow 2\\text{Cr}^{3+} + 7\\text{H}_2\\text{O}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-07-redox-reactions.t4",
   "name": {
    "en": "Common reductant half-reactions"
   },
   "tex": "\\text{Fe}^{2+} \\rightarrow \\text{Fe}^{3+} + e^-;\\quad \\text{C}_2\\text{O}_4^{2-} \\rightarrow 2\\text{CO}_2 + 2e^-;\\quad 2\\text{I}^- \\rightarrow \\text{I}_2 + 2e^-"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-07-redox-reactions.t4",
   "name": {
    "en": "Redox titration stoichiometry"
   },
   "tex": "n_1 M_1 V_1 = n_2 M_2 V_2",
   "note": {
    "en": "n = electrons gained or lost per formula unit (n-factor)."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-07-redox-reactions.t4",
   "name": {
    "en": "Equivalent mass"
   },
   "tex": "E = \\dfrac{M}{\\text{electrons transferred per formula unit}}",
   "note": {
    "en": "KMnO₄ in acid: 158/5 = 31.6."
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Indicators"
   },
   "tex": "\\text{KMnO}_4: \\text{self};\\ \\ \\text{K}_2\\text{Cr}_2\\text{O}_7: \\text{diphenylamine};\\ \\ \\text{I}_2: \\text{starch (blue)}",
   "note": {
    "en": "Use dilute H₂SO₄, not HCl, with KMnO₄."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-07-redox-reactions.t5",
   "name": {
    "en": "Standard cell emf"
   },
   "tex": "E^\\circ_{\\text{cell}} = E^\\circ_{\\text{cathode}} - E^\\circ_{\\text{anode}}",
   "note": {
    "en": "E° is intensive: do not multiply by stoichiometric coefficients. Positive E°cell → spontaneous."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-07-redox-reactions.t5",
   "name": {
    "en": "Electrochemical series"
   },
   "tex": "\\text{more negative } E^\\circ \\Rightarrow \\text{stronger reductant};\\ \\text{more positive } E^\\circ \\Rightarrow \\text{stronger oxidant}",
   "note": {
    "en": "SHE = 0.00 V. Daniell cell (Zn|Cu) E° = 1.10 V."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-07-redox-reactions.t3",
   "name": {
    "en": "Halogen displacement"
   },
   "tex": "\\text{F}_2 > \\text{Cl}_2 > \\text{Br}_2 > \\text{I}_2 \\ (\\text{oxidising power})",
   "note": {
    "en": "A halogen displaces any halide below it: Cl₂ + 2Br⁻ → 2Cl⁻ + Br₂."
   }
  }
 ]
}
