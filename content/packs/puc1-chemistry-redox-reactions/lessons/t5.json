  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find E°cell for the Daniell cell. E°(Zn²⁺/Zn) = −0.76 V, E°(Cu²⁺/Cu) = +0.34 V."
   },
   "steps": [
    {
     "en": "Zn is the anode (lower E°), Cu is the cathode."
    },
    {
     "en": "E°cell = E°cathode − E°anode = 0.34 − (−0.76)."
    },
    {
     "en": "E°cell = 1.10 V."
    }
   ],
   "answer": {
    "en": "1.10 V"
   },
   "narration": {
