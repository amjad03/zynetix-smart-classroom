 "title": {
  "en": "Redox reactions and electrode processes",
  "kn": "ರೆಡಾಕ್ಸ್ ಕ್ರಿಯೆಗಳು ಮತ್ತು ವಿದ್ಯುದ್ವಾರ ಪ್ರಕ್ರಿಯೆಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Can a redox reaction light a bulb?",
    "kn": "ರೆಡಾಕ್ಸ್ ಕ್ರಿಯೆ ಬಲ್ಬ್ ಉರಿಸಬಹುದೇ?"
   },
   "hook": {
    "en": "If zinc and copper sulphate are kept in separate beakers and joined by a wire, electrons flow through the wire. A redox reaction becomes an electric current.",
    "kn": "ಸತು ಮತ್ತು ತಾಮ್ರದ ಸಲ್ಫೇಟನ್ನು ಬೇರೆ ಬೇರೆ ಬೀಕರುಗಳಲ್ಲಿಟ್ಟು ತಂತಿಯಿಂದ ಜೋಡಿಸಿದರೆ ಇಲೆಕ್ಟ್ರಾನ್‌ಗಳು ತಂತಿಯ ಮೂಲಕ ಹರಿಯುತ್ತವೆ. ರೆಡಾಕ್ಸ್ ಕ್ರಿಯೆ ವಿದ್ಯುತ್ ಪ್ರವಾಹವಾಗುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Describe the Daniell cell and the salt bridge"
    },
    {
     "en": "Use standard electrode potentials"
    },
    {
     "en": "Predict which metal can reduce which ion"
    }
   ],
   "narration": {
    "en": "If zinc and copper sulphate are kept in separate beakers and joined by a wire, electrons flow through the wire. A redox reaction becomes an electric current.",
    "kn": "ಸತು ಮತ್ತು ತಾಮ್ರದ ಸಲ್ಫೇಟನ್ನು ಬೇರೆ ಬೇರೆ ಬೀಕರುಗಳಲ್ಲಿಟ್ಟು ತಂತಿಯಿಂದ ಜೋಡಿಸಿದರೆ ಇಲೆಕ್ಟ್ರಾನ್‌ಗಳು ತಂತಿಯ ಮೂಲಕ ಹರಿಯುತ್ತವೆ. ರೆಡಾಕ್ಸ್ ಕ್ರಿಯೆ ವಿದ್ಯುತ್ ಪ್ರವಾಹವಾಗುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The Daniell cell"
   },
   "body": {
    "en": "A zinc rod dips in ZnSO₄ solution and a copper rod in CuSO₄ solution; a salt bridge joins the solutions. Zinc is oxidised at the anode and Cu²⁺ is reduced at the cathode, so electrons flow from zinc to copper through the wire. The salt bridge completes the circuit and keeps both solutions electrically neutral.",
    "kn": "ಡೇನಿಯಲ್ ಕೋಶದಲ್ಲಿ ಸತು ಆನೋಡ್‌ನಲ್ಲಿ ಉತ್ಕರ್ಷಿತವಾಗುತ್ತದೆ, Cu²⁺ ಕ್ಯಾಥೋಡ್‌ನಲ್ಲಿ ಅಪಕರ್ಷಿತವಾಗುತ್ತದೆ. ಲವಣ ಸೇತುವೆ ಸರ್ಕ್ಯೂಟ್ ಪೂರ್ಣಗೊಳಿಸಿ ದ್ರಾವಣಗಳನ್ನು ತಟಸ್ಥವಾಗಿಡುತ್ತದೆ."
   },
   "points": [
    {
     "en": "Anode: oxidation (Zn → Zn²⁺ + 2e⁻)"
    },
    {
     "en": "Cathode: reduction (Cu²⁺ + 2e⁻ → Cu)"
    },
    {
     "en": "Cell notation: Zn | Zn²⁺ || Cu²⁺ | Cu"
    }
   ],
   "narration": {
    "en": "A zinc rod dips in ZnSO₄ solution and a copper rod in CuSO₄ solution; a salt bridge joins the solutions. Zinc is oxidised at the anode and Cu²⁺ is reduced at the cathode, so electrons flow from zinc to copper through the wire. The salt bridge completes the circuit and keeps both solutions electrically neutral.",
    "kn": "ಡೇನಿಯಲ್ ಕೋಶದಲ್ಲಿ ಸತು ಆನೋಡ್‌ನಲ್ಲಿ ಉತ್ಕರ್ಷಿತವಾಗುತ್ತದೆ, Cu²⁺ ಕ್ಯಾಥೋಡ್‌ನಲ್ಲಿ ಅಪಕರ್ಷಿತವಾಗುತ್ತದೆ. ಲವಣ ಸೇತುವೆ ಸರ್ಕ್ಯೂಟ್ ಪೂರ್ಣಗೊಳಿಸಿ ದ್ರಾವಣಗಳನ್ನು ತಟಸ್ಥವಾಗಿಡುತ್ತದೆ."
   }
  },
