{
 "chapterId": "puc1-maths-08-sequences-and-series",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "AP nth term & sum"
   },
   "tex": "a_n = a + (n-1)d,\\quad S_n = \\frac n2[2a + (n-1)d]",
   "note": {
    "en": "Also S_n = n(a + l)/2."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "GP nth term & sum"
   },
   "tex": "a_n = ar^{n-1},\\quad S_n = a\\frac{r^n - 1}{r - 1}",
   "note": {
    "en": "r ≠ 1."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "Infinite GP"
   },
   "tex": "S_\\infty = \\frac{a}{1 - r}",
   "note": {
    "en": "|r| < 1."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-08-sequences-and-series.t5",
   "name": {
    "en": "Means of two numbers"
   },
   "tex": "A = \\frac{a+b}2,\\ G = \\sqrt{ab},\\ H = \\frac{2ab}{a+b}",
   "note": {
    "en": "G² = AH."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-08-sequences-and-series.t5",
   "name": {
    "en": "Inequality"
   },
   "tex": "A \\ge G \\ge H",
   "note": {
    "en": "Positive numbers; equality iff equal."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Natural-number sums"
   },
   "tex": "\\sum n = \\frac{n(n+1)}2,\\ \\sum n^2 = \\frac{n(n+1)(2n+1)}6",
   "note": {
    "en": "Σn³ = (Σn)²."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Telescoping"
   },
   "tex": "\\sum_{k=1}^n\\frac{1}{k(k+1)} = \\frac{n}{n+1}",
   "note": {
    "en": "Partial fractions."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "A.P. nth term"
   },
   "tex": "a_n = a + (n-1)d"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "A.P. sum"
   },
   "tex": "S_n = \\frac n2[2a + (n-1)d] = \\frac n2(a + l)"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "Term from the sum"
   },
   "tex": "a_n = S_n - S_{n-1}\\ (n \\ge 2),\\quad a_1 = S_1"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-08-sequences-and-series.t5",
   "name": {
    "en": "Arithmetic mean"
   },
   "tex": "A = \\frac{a + b}{2};\\quad n \\text{ AMs: } d = \\frac{b - a}{n + 1}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "G.P. nth term"
   },
   "tex": "a_n = ar^{n-1}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "G.P. sum"
   },
   "tex": "S_n = \\frac{a(r^n - 1)}{r - 1}\\ (r \\ne 1)"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "Infinite G.P."
   },
   "tex": "S_\\infty = \\frac{a}{1 - r},\\quad |r| < 1"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-08-sequences-and-series.t5",
   "name": {
    "en": "Geometric mean"
   },
   "tex": "G = \\sqrt{ab};\\quad n \\text{ GMs: } r = \\left(\\frac ba\\right)^{1/(n+1)}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-maths-08-sequences-and-series.t5",
   "name": {
    "en": "AM–GM inequality"
   },
   "tex": "\\frac{a_1 + \\dots + a_n}{n} \\ge \\sqrt[n]{a_1\\cdots a_n}",
   "note": {
    "en": "Equality iff all equal; positive reals"
   }
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Numbers from A and G"
   },
   "tex": "a, b = A \\pm \\sqrt{A^2 - G^2}"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Convenient choices"
   },
   "tex": "\\text{A.P.: } a - d, a, a + d;\\quad \\text{G.P.: } \\tfrac ar, a, ar"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Three terms in A.P. / G.P."
   },
   "tex": "2b = a + c;\\quad b^2 = ac"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-maths-08-sequences-and-series.t1",
   "name": {
    "en": "Sum of first n naturals"
   },
   "tex": "\\sum k = \\frac{n(n+1)}{2}"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Sum of squares"
   },
   "tex": "\\sum k^2 = \\frac{n(n+1)(2n+1)}{6}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Sum of cubes"
   },
   "tex": "\\sum k^3 = \\left[\\frac{n(n+1)}{2}\\right]^2"
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Odd numbers"
   },
   "tex": "\\sum (2k - 1) = n^2,\\quad \\sum (2k-1)^2 = \\frac{n(2n-1)(2n+1)}{3}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "Arithmetico-geometric (infinite)"
   },
   "tex": "\\sum_{k\\ge0}(a + kd)r^k = \\frac{a}{1 - r} + \\frac{dr}{(1 - r)^2},\\ |r| < 1"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "Useful series"
   },
   "tex": "\\sum_{k\\ge1} kx^{k-1} = \\frac{1}{(1-x)^2}\\ (|x| < 1),\\quad \\sum_{k=1}^n k\\,2^k = (n-1)2^{n+1} + 2"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Telescoping"
   },
   "tex": "\\frac{1}{k(k+1)} = \\frac1k - \\frac1{k+1};\\quad \\frac{1}{k(k+1)(k+2)} = \\frac12\\left[\\frac1{k(k+1)} - \\frac1{(k+1)(k+2)}\\right]"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Recurring decimals"
   },
   "tex": "0.\\overline{ab} = \\frac{ab}{99}"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-maths-08-sequences-and-series.t2",
   "name": {
    "en": "Common terms of two A.P.s"
   },
   "tex": "\\text{an A.P. with difference } \\operatorname{lcm}(d_1, d_2)"
  }
 ]
}
