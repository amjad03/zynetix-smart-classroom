  "en": "Androecium, gynoecium and placentation",
  "kn": "ಪುಂಕೇಸರಗುಚ್ಛ, ಸ್ತ್ರೀಕೇಸರಗುಚ್ಛ ಮತ್ತು ಜರಾಯು ವಿನ್ಯಾಸ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Where do the seeds sit?",
    "kn": "ಬೀಜಗಳು ಎಲ್ಲಿ ಕುಳಿತಿವೆ?"
   },
   "hook": {
    "en": "Cut a tomato across and you see seeds attached to a thick central column. Cut a pea pod open and the seeds line one edge. The pattern is called placentation.",
    "kn": "ಟೊಮೆಟೊವನ್ನು ಅಡ್ಡಲಾಗಿ ಕತ್ತರಿಸಿದರೆ ಬೀಜಗಳು ಮಧ್ಯದ ಕಂಬಕ್ಕೆ ಅಂಟಿರುತ್ತವೆ. ಬಟಾಣಿ ಕಾಯಿಯಲ್ಲಿ ಒಂದು ಅಂಚಿಗೆ ಅಂಟಿರುತ್ತವೆ. ಇದೇ ಜರಾಯು ವಿನ್ಯಾಸ."
   },
   "objectives": [
    {
     "en": "Describe the union of stamens"
    },
    {
     "en": "Distinguish apocarpous and syncarpous pistils"
    },
    {
     "en": "Identify the five types of placentation"
    }
   ],
   "narration": {
    "en": "Cut a tomato across and you see seeds attached to a thick central column. Cut a pea pod open and the seeds line one edge. The pattern is called placentation.",
    "kn": "ಟೊಮೆಟೊವನ್ನು ಅಡ್ಡಲಾಗಿ ಕತ್ತರಿಸಿದರೆ ಬೀಜಗಳು ಮಧ್ಯದ ಕಂಬಕ್ಕೆ ಅಂಟಿರುತ್ತವೆ. ಬಟಾಣಿ ಕಾಯಿಯಲ್ಲಿ ಒಂದು ಅಂಚಿಗೆ ಅಂಟಿರುತ್ತವೆ. ಇದೇ ಜರಾಯು ವಿನ್ಯಾಸ."
