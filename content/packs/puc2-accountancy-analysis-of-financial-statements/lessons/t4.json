 "title": {
  "en": "Comparative statements",
  "kn": "ತುಲನಾತ್ಮಕ ತಃಖ್ತೆಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "This year versus last year",
    "kn": "ಈ ವರ್ಷ ಮತ್ತು ಕಳೆದ ವರ್ಷ"
   },
   "hook": {
    "en": "Revenue went up by ₹2.5 lakh. Is that good? It depends on how much expenses went up. A comparative statement puts both years side by side.",
    "kn": "ಆದಾಯ ₹2.5 ಲಕ್ಷ ಹೆಚ್ಚಾಗಿದೆ. ಇದು ಒಳ್ಳೆಯದೇ? ವೆಚ್ಚ ಎಷ್ಟು ಹೆಚ್ಚಾಗಿದೆ ಎಂಬುದರ ಮೇಲೆ ಅವಲಂಬಿತ. ತುಲನಾತ್ಮಕ ತಃಖ್ತೆ ಎರಡೂ ವರ್ಷಗಳನ್ನು ಅಕ್ಕಪಕ್ಕ ಇಡುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Prepare a comparative Statement of Profit and Loss"
    },
    {
     "en": "Prepare a comparative Balance Sheet"
    },
    {
     "en": "Interpret absolute and percentage changes"
    }
   ],
   "narration": {
    "en": "Revenue went up by ₹2.5 lakh. Is that good? It depends on how much expenses went up. A comparative statement puts both years side by side.",
    "kn": "ಆದಾಯ ₹2.5 ಲಕ್ಷ ಹೆಚ್ಚಾಗಿದೆ. ಇದು ಒಳ್ಳೆಯದೇ? ವೆಚ್ಚ ಎಷ್ಟು ಹೆಚ್ಚಾಗಿದೆ ಎಂಬುದರ ಮೇಲೆ ಅವಲಂಬಿತ. ತುಲನಾತ್ಮಕ ತಃಖ್ತೆ ಎರಡೂ ವರ್ಷಗಳನ್ನು ಅಕ್ಕಪಕ್ಕ ಇಡುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Format of a comparative statement"
   },
   "body": {
    "en": "Columns: Particulars, Note No., Previous year (₹), Current year (₹), Absolute change (₹), Percentage change (%). Absolute change = current − previous. Percentage change = absolute change ÷ previous year × 100. Both the comparative Statement of Profit and Loss and the comparative Balance Sheet follow this format.",
    "kn": "ತುಲನಾತ್ಮಕ ತಃಖ್ತೆಯಲ್ಲಿ ಹಿಂದಿನ ವರ್ಷ, ಪ್ರಸಕ್ತ ವರ್ಷ, ನಿಖರ ಬದಲಾವಣೆ ಮತ್ತು ಶೇಕಡಾ ಬದಲಾವಣೆಯ ಕಾಲಂಗಳಿರುತ್ತವೆ. ಶೇಕಡಾವನ್ನು ಯಾವಾಗಲೂ ಹಿಂದಿನ ವರ್ಷದ ಮೇಲೆ ಲೆಕ್ಕಿಸಬೇಕು."
   },
   "points": [
    {
     "en": "Absolute change = current − previous"
    },
    {
     "en": "% change on previous year"
    }
   ],
   "narration": {
    "en": "A comparative statement has columns for the previous year, the current year, the absolute change and the percentage change. The percentage is always worked on the previous year.",
    "kn": "ತುಲನಾತ್ಮಕ ತಃಖ್ತೆಯಲ್ಲಿ ಹಿಂದಿನ ವರ್ಷ, ಪ್ರಸಕ್ತ ವರ್ಷ, ನಿಖರ ಬದಲಾವಣೆ ಮತ್ತು ಶೇಕಡಾ ಬದಲಾವಣೆಯ ಕಾಲಂಗಳಿರುತ್ತವೆ. ಶೇಕಡಾವನ್ನು ಯಾವಾಗಲೂ ಹಿಂದಿನ ವರ್ಷದ ಮೇಲೆ ಲೆಕ್ಕಿಸಬೇಕು."
   },
   "formula": "\\%\\ \\text{change} = \\frac{\\text{Current year} - \\text{Previous year}}{\\text{Previous year}} \\times 100"
  },
