  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t09-q10",
  "chapterId": "puc1-statistics-09-theory-of-attributes",
  "topicId": "puc1-statistics-09-theory-of-attributes.t3",
  "stem": {
   "en": "N = 100, (A) = 60, (B) = 50, (AB) = 5. These data are:"
  },
  "options": [
   {
    "en": "inconsistent, because (AB) > (A)"
   },
   {
    "en": "inconsistent, because (αβ) = −5"
   },
   {
    "en": "inconsistent, because (Aβ) is negative"
   },
   {
    "en": "consistent"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "(αβ) = 100 − 60 − 50 + 5 = −5 < 0, so the data are inconsistent."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t09-q11",
  "chapterId": "puc1-statistics-09-theory-of-attributes",
  "topicId": "puc1-statistics-09-theory-of-attributes.t3",
  "stem": {
   "en": "For consistent data, (AB) can never exceed:"
  },
  "options": [
   {
    "en": "(A) + (B)"
   },
   {
    "en": "(αβ)"
   },
   {
    "en": "the smaller of (A) and (B)"
   },
   {
    "en": "N − (A)"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "(Aβ) = (A) − (AB) ≥ 0 and (αB) = (B) − (AB) ≥ 0, so (AB) ≤ (A) and (AB) ≤ (B)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t09-q12",
  "chapterId": "puc1-statistics-09-theory-of-attributes",
  "topicId": "puc1-statistics-09-theory-of-attributes.t3",
  "stem": {
   "en": "The condition (AB) ≥ (A) + (B) − N comes from requiring:"
  },
  "options": [
   {
    "en": "(Aβ) ≥ 0"
   },
   {
    "en": "(αB) ≥ 0"
   },
   {
    "en": "(αβ) ≥ 0"
   },
   {
    "en": "(AB) ≥ 0"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "(αβ) = N − (A) − (B) + (AB) ≥ 0 rearranges to (AB) ≥ (A) + (B) − N."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
