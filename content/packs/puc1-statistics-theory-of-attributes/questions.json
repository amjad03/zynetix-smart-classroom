  "chapterId": "puc1-statistics-09-theory-of-attributes",
  "topicId": "puc1-statistics-09-theory-of-attributes.t2",
  "stem": {
   "en": "N = 1000, (A) = 600, (B) = 500 and (AB) = 350. Then (αβ) is:"
  },
  "options": [
