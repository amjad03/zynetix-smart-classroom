{
 "chapterId": "puc1-physics-07-gravitation",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-07-gravitation.t2",
   "name": {
    "en": "Newton's law of gravitation"
   },
   "tex": "F = \\frac{Gm_1m_2}{r^2},\\quad G = 6.67\\times10^{-11}\\ \\text{N m}^2\\text{kg}^{-2}",
   "note": {
    "en": "Always attractive."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "g at surface"
   },
   "tex": "g = \\frac{GM}{R^2}",
   "note": {
    "en": "≈ 9.8 m/s²."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-07-gravitation.t3",
   "name": {
    "en": "g at height h"
   },
   "tex": "g_h = g\\left(1 + \\frac hR\\right)^{-2} \\approx g\\left(1 - \\frac{2h}{R}\\right)",
   "note": {
    "en": "Approximation for h ≪ R."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-07-gravitation.t3",
   "name": {
    "en": "g at depth d"
   },
   "tex": "g_d = g\\left(1 - \\frac dR\\right)",
   "note": {
    "en": "Zero at the centre."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Orbital speed"
   },
   "tex": "v_o = \\sqrt{\\frac{GM}{r}}",
   "note": {
    "en": "Near surface ≈ 7.9 km/s."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Escape speed"
   },
   "tex": "v_e = \\sqrt{\\frac{2GM}{R}} = \\sqrt2\\,v_o",
   "note": {
    "en": "Earth ≈ 11.2 km/s; independent of mass thrown."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Kepler's third law"
   },
   "tex": "T^2 = \\frac{4\\pi^2}{GM}r^3",
   "note": {
    "en": "T² ∝ r³."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Gravitational PE"
   },
   "tex": "U = -\\frac{GMm}{r}",
   "note": {
    "en": "Total energy of orbit = −GMm/2r."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-07-gravitation.t1",
   "name": {
    "en": "Kepler's laws"
   },
   "tex": "\\text{(1) elliptical orbits, Sun at a focus;\\ (2) } \\dfrac{dA}{dt} = \\dfrac{L}{2m} = \\text{const};\\ \\text{(3) } T^2 \\propto a^3",
   "note": {
    "en": "Second law follows from conservation of angular momentum."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-07-gravitation.t2",
   "name": {
    "en": "Universal law of gravitation"
   },
   "tex": "F = \\dfrac{Gm_1m_2}{r^2},\\quad G = 6.67\\times10^{-11}\\ \\text{N m}^2\\text{kg}^{-2},\\quad [M^{-1}L^3T^{-2}]"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "g and G"
   },
   "tex": "g = \\dfrac{GM}{R^2} = \\dfrac43\\pi G\\rho R"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-07-gravitation.t3",
   "name": {
    "en": "g at height h"
   },
   "tex": "g_h = g\\left(\\dfrac{R}{R + h}\\right)^2 \\approx g\\left(1 - \\dfrac{2h}{R}\\right)\\ (h \\ll R)"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-07-gravitation.t3",
   "name": {
    "en": "g at depth d"
   },
   "tex": "g_d = g\\left(1 - \\dfrac dR\\right)",
   "note": {
    "en": "Zero at the centre; maximum at the surface."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Effect of rotation (latitude λ)"
   },
   "tex": "g' = g - \\omega^2R\\cos^2\\lambda",
   "note": {
    "en": "Least at the equator, unchanged at the poles. Weightless at equator if ω = √(g/R)."
   }
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Gravitational field"
   },
   "tex": "E = \\dfrac{GM}{r^2}\\ (r \\ge R),\\quad E = \\dfrac{GMr}{R^3}\\ (\\text{inside solid sphere}),\\quad E = 0\\ (\\text{inside shell})"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Gravitational potential"
   },
   "tex": "V = -\\dfrac{GM}{r}\\ (r \\ge R),\\quad V_{\\text{solid, inside}} = -\\dfrac{GM(3R^2 - r^2)}{2R^3},\\quad V_{\\text{shell, inside}} = -\\dfrac{GM}{R}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Field from potential"
   },
   "tex": "E = -\\dfrac{dV}{dr}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Gravitational potential energy"
   },
   "tex": "U = -\\dfrac{Gm_1m_2}{r}",
   "note": {
    "en": "For many particles add over every pair once."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Escape speed"
   },
   "tex": "v_e = \\sqrt{\\dfrac{2GM}{R}} = \\sqrt{2gR} \\approx 11.2\\ \\text{km s}^{-1}",
   "note": {
    "en": "Independent of the body's mass and direction of projection."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Orbital speed"
   },
   "tex": "v_o = \\sqrt{\\dfrac{GM}{r}},\\qquad v_o(\\text{surface}) = \\sqrt{gR} \\approx 7.9\\ \\text{km s}^{-1}\\ (8\\ \\text{with } g = 10),\\qquad v_e = \\sqrt2\\,v_o"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Orbital period"
   },
   "tex": "T = 2\\pi\\sqrt{\\dfrac{r^3}{GM}},\\qquad T_{\\text{surface}} = 2\\pi\\sqrt{\\dfrac Rg} \\approx 84\\ \\text{min}"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Energies of a satellite"
   },
   "tex": "K = \\dfrac{GMm}{2r},\\quad U = -\\dfrac{GMm}{r},\\quad E = -\\dfrac{GMm}{2r}",
   "note": {
    "en": "K = −E, U = 2E; binding energy = GMm/2r."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Energy to change orbit"
   },
   "tex": "\\Delta E = \\dfrac{GMm}{2}\\left(\\dfrac{1}{r_1} - \\dfrac{1}{r_2}\\right)"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Energy to launch into orbit from the surface"
   },
   "tex": "\\Delta E = GMm\\left(\\dfrac1R - \\dfrac{1}{2r}\\right)"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-physics-07-gravitation.t3",
   "name": {
    "en": "Maximum height for launch speed v (vertical)"
   },
   "tex": "h = \\dfrac{R v^2}{2gR - v^2}"
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-physics-07-gravitation.t4",
   "name": {
    "en": "Speed at infinity"
   },
   "tex": "v_\\infty = \\sqrt{v^2 - v_e^2}"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-physics-07-gravitation.t5",
   "name": {
    "en": "Geostationary satellite"
   },
   "tex": "T = 24\\ \\text{h},\\ r \\approx 42\\,000\\ \\text{km} \\approx 6.6R,\\ h \\approx 36\\,000\\ \\text{km}",
   "note": {
    "en": "Equatorial plane, west to east. Polar satellites: h ≈ 500–800 km, T ≈ 100 min."
   }
  },
  {
   "id": "zs-f28",
   "name": {
    "en": "Elliptical orbit"
   },
   "tex": "v_pr_p = v_ar_a,\\qquad E = -\\dfrac{GMm}{2a}"
  },
  {
   "id": "zs-f29",
   "name": {
    "en": "Binary system"
   },
   "tex": "\\omega^2 = \\dfrac{G(m_1 + m_2)}{d^3},\\qquad r_1 = \\dfrac{m_2d}{m_1 + m_2}"
  },
  {
   "id": "zs-f30",
   "topicId": "puc1-physics-07-gravitation.t2",
   "name": {
    "en": "Null point between two masses"
   },
   "tex": "x = \\dfrac{d\\sqrt{m_1}}{\\sqrt{m_1} + \\sqrt{m_2}}\\ \\text{from } m_1"
  },
  {
   "id": "zs-f31",
   "topicId": "puc1-physics-07-gravitation.t2",
   "name": {
    "en": "Cavity in a uniform sphere"
   },
   "tex": "\\vec E = -\\tfrac43\\pi G\\rho\\,\\vec a\\ \\ (\\text{uniform inside the cavity})"
  }
 ]
}
