 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Old values, new partner",
    "kn": "ಹಳೆಯ ಮೌಲ್ಯ, ಹೊಸ ಪಾಲುದಾರ"
   },
   "hook": {
    "en": "The firm's building was bought years ago for less than half its price today. Should the new partner share in that gain?",
    "kn": "ಸಂಸ್ಥೆಯ ಕಟ್ಟಡವನ್ನು ವರ್ಷಗಳ ಹಿಂದೆ ಇಂದಿನ ಬೆಲೆಯ ಅರ್ಧಕ್ಕಿಂತ ಕಡಿಮೆಗೆ ಖರೀದಿಸಲಾಗಿತ್ತು. ಆ ಲಾಭದಲ್ಲಿ ಹೊಸ ಪಾಲುದಾರನಿಗೆ ಪಾಲು ಬೇಕೇ?"
   },
   "objectives": [
    {
     "en": "Prepare the Revaluation Account"
    },
    {
     "en": "Distribute reserves and accumulated profits or losses"
    }
   ],
   "narration": {
    "en": "The firm's building was bought years ago for less than half its price today. Should the new partner share in that gain? No. Gains and losses up to the date of admission belong to the old partners.",
    "kn": "ಸಂಸ್ಥೆಯ ಕಟ್ಟಡವನ್ನು ವರ್ಷಗಳ ಹಿಂದೆ ಇಂದಿನ ಬೆಲೆಯ ಅರ್ಧಕ್ಕಿಂತ ಕಡಿಮೆಗೆ ಖರೀದಿಸಲಾಗಿತ್ತು. ಆ ಲಾಭದಲ್ಲಿ ಹೊಸ ಪಾಲುದಾರನಿಗೆ ಪಾಲು ಬೇಕೇ? ಇಲ್ಲ. ಪ್ರವೇಶದ ದಿನದವರೆಗಿನ ಲಾಭ ನಷ್ಟಗಳು ಹಳೆಯ ಪಾಲುದಾರರಿಗೆ ಸೇರುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Revaluation Account"
   },
   "body": {
    "en": "Increase in an asset or decrease in a liability is a gain: credit the Revaluation Account. Decrease in an asset or increase in a liability (including unrecorded liabilities) is a loss: debit it. The balance, profit or loss, is transferred to the old partners' capital accounts in their old ratio.",
    "kn": "ಆಸ್ತಿ ಮೌಲ್ಯ ಹೆಚ್ಚಳ ಅಥವಾ ಹೊಣೆ ಇಳಿಕೆ ಲಾಭ — ಪುನರ್ಮೌಲ್ಯಮಾಪನ ಖಾತೆಗೆ ಜಮಾ. ಆಸ್ತಿ ಇಳಿಕೆ ಅಥವಾ ಹೊಣೆ ಹೆಚ್ಚಳ ನಷ್ಟ — ಖರ್ಚು. ಶಿಲ್ಕನ್ನು ಹಳೆಯ ಪಾಲುದಾರರಿಗೆ ಹಳೆಯ ಅನುಪಾತದಲ್ಲಿ ವರ್ಗಾಯಿಸಲಾಗುತ್ತದೆ."
   },
   "points": [
    {
     "en": "Cr: asset up, liability down"
    },
    {
     "en": "Dr: asset down, liability up"
    },
    {
     "en": "Balance to old partners in old ratio"
    }
   ],
   "narration": {
    "en": "Increase in an asset or decrease in a liability is a gain: credit the Revaluation Account. Decrease in an asset or increase in a liability (including unrecorded liabilities) is a loss: debit it. The balance, profit or loss, is transferred to the old partners' capital accounts in their old ratio.",
    "kn": "ಆಸ್ತಿ ಮೌಲ್ಯ ಹೆಚ್ಚಳ ಅಥವಾ ಹೊಣೆ ಇಳಿಕೆ ಲಾಭ — ಪುನರ್ಮೌಲ್ಯಮಾಪನ ಖಾತೆಗೆ ಜಮಾ. ಆಸ್ತಿ ಇಳಿಕೆ ಅಥವಾ ಹೊಣೆ ಹೆಚ್ಚಳ ನಷ್ಟ — ಖರ್ಚು. ಶಿಲ್ಕನ್ನು ಹಳೆಯ ಪಾಲುದಾರರಿಗೆ ಹಳೆಯ ಅನುಪಾತದಲ್ಲಿ ವರ್ಗಾಯಿಸಲಾಗುತ್ತದೆ."
   }
  },
