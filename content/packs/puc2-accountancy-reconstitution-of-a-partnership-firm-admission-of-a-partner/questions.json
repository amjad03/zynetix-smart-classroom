  "topicId": "puc2-accountancy-02-reconstitution-of-a-partnership-firm-admission-of-a-partner.t1",
  "stem": {
   "en": "A and B share profits 2:1. C is admitted for a 1/4 share, taking 1/6 from A and 1/12 from B. The new ratio of A, B and C is:"
  },
  "options": [
   {
    "en": "2:1:1"
   },
   {
    "en": "6:3:4"
   },
   {
    "en": "3:1:1"
   },
   {
    "en": "4:3:3"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "A = 2/3 − 1/6 = 6/12; B = 1/3 − 1/12 = 3/12; C = 3/12 → 6:3:3 = 2:1:1."
  },
  "exams": [
   "PUC",
   "CBSE",
   "CUET"
  ],
  "difficulty": "hard",
  "format": "mcq",
  "tags": [],
  "solution": [
   {
    "en": "A = 2/3 − 1/6 = 6/12; B = 1/3 − 1/12 = 3/12; C = 3/12 → 6:3:3 = 2:1:1."
   }
  ]
 },
