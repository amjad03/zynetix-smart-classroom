{
 "chapterId": "puc2-biology-07-human-health-and-disease",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Typhoid"
   },
   "tex": "\\textit{Salmonella typhi} \\to \\text{small intestine};\\ \\text{Widal test}",
   "note": {
    "en": "Fever 39–40°C; intestinal perforation; Mary Mallon (carrier)."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Pneumonia"
   },
   "tex": "\\textit{Streptococcus pneumoniae},\\ \\textit{Haemophilus influenzae} \\to \\text{alveoli}",
   "note": {
    "en": "Lips and nails grey to bluish in severe cases."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Common cold"
   },
   "tex": "\\text{Rhinoviruses} \\to \\text{nose \\& respiratory passage, not lungs}",
   "note": {
    "en": "Lasts 3–7 days."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Malaria"
   },
   "tex": "\\textit{Plasmodium} \\text{ (vivax, malariae, falciparum)};\\ \\text{vector: female } \\textit{Anopheles}",
   "note": {
    "en": "Sporozoites → liver → RBC; haemozoin → chill & fever every 3–4 days; P. falciparum = malignant. Fertilisation in mosquito stomach; sporozoites in salivary glands."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Amoebiasis"
   },
   "tex": "\\textit{Entamoeba histolytica} \\to \\text{large intestine}",
   "note": {
    "en": "Houseflies = mechanical carriers; mucus and blood clots in stool."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Ascariasis & filariasis"
   },
   "tex": "\\textit{Ascaris} \\to \\text{intestine};\\ \\ \\textit{Wuchereria bancrofti, W. malayi} \\to \\text{lymphatics (elephantiasis)}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Ringworm (fungal)"
   },
   "tex": "\\textit{Microsporum},\\ \\textit{Trichophyton},\\ \\textit{Epidermophyton}",
   "note": {
    "en": "Dry scaly itchy lesions; heat and moisture favour."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Vector control"
   },
   "tex": "\\textit{Aedes} \\to \\text{dengue, chikungunya};\\ \\ \\textit{Gambusia} \\text{ eats larvae}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-07-human-health-and-disease.t2",
   "name": {
    "en": "Innate immunity barriers"
   },
   "tex": "\\text{physical, physiological, cellular, cytokine}",
   "note": {
    "en": "Skin/mucus; acid, saliva, tears; neutrophils, monocytes, NK cells, macrophages; interferons."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-07-human-health-and-disease.t3",
   "name": {
    "en": "Antibody structure"
   },
   "tex": "\\text{H}_2\\text{L}_2;\\ \\ \\text{IgA, IgM, IgE, IgG}",
   "note": {
    "en": "IgE in allergy; IgA in colostrum."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-07-human-health-and-disease.t2",
   "name": {
    "en": "Acquired immunity"
   },
   "tex": "\\text{primary (weak)} \\to \\text{secondary/anamnestic (intense, memory)}",
   "note": {
    "en": "B cells → humoral; T cells → cell-mediated (graft rejection)."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-07-human-health-and-disease.t3",
   "name": {
    "en": "Active vs passive"
   },
   "tex": "\\text{active: own antibodies (slow)};\\ \\text{passive: ready-made antibodies (fast)}",
   "note": {
    "en": "Passive: colostrum, placenta, anti-tetanus, snake antivenom. Hepatitis B vaccine from yeast (rDNA)."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-07-human-health-and-disease.t3",
   "name": {
    "en": "Allergy & autoimmunity"
   },
   "tex": "\\text{allergen} \\to \\text{IgE} \\to \\text{mast cells release histamine, serotonin}",
   "note": {
    "en": "Treat with antihistamine, adrenaline, steroids. Autoimmune: rheumatoid arthritis."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-biology-07-human-health-and-disease.t3",
   "name": {
    "en": "Lymphoid organs"
   },
   "tex": "\\text{primary: bone marrow, thymus};\\ \\text{secondary: spleen, lymph nodes, tonsils, Peyer's patches, appendix}",
   "note": {
    "en": "MALT ≈ 50% of lymphoid tissue; thymus shrinks by puberty; spleen = blood filter & RBC reservoir."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-07-human-health-and-disease.t4",
   "name": {
    "en": "HIV cycle"
   },
   "tex": "\\text{RNA} \\xrightarrow{\\text{reverse transcriptase}} \\text{DNA} \\to \\text{host genome};\\ \\text{macrophage} = \\text{HIV factory}",
   "note": {
    "en": "Attacks helper T cells (TH); AIDS reported 1981; ELISA; lag 5–10 years; antiretrovirals only partially effective."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-07-human-health-and-disease.t4",
   "name": {
    "en": "Cancer"
   },
   "tex": "\\text{loss of contact inhibition} \\to \\text{tumour (benign / malignant)} \\to \\text{metastasis}",
   "note": {
    "en": "Carcinogens: ionising (X, γ), non-ionising (UV), chemicals (tobacco), oncogenic viruses, c-onc."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-07-human-health-and-disease.t4",
   "name": {
    "en": "Cancer detection & therapy"
   },
   "tex": "\\text{biopsy, CT (X-rays), MRI (magnetic + non-ionising)};\\ \\alpha\\text{-interferon}",
   "note": {
    "en": "Surgery, radiotherapy, chemotherapy, immunotherapy."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-biology-07-human-health-and-disease.t5",
   "name": {
    "en": "Opioids"
   },
   "tex": "\\textit{Papaver somniferum} \\to \\text{morphine} \\xrightarrow{\\text{acetylation}} \\text{heroin (diacetylmorphine)}",
   "note": {
    "en": "Depressant; opioid receptors in CNS and GI tract."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-biology-07-human-health-and-disease.t5",
   "name": {
    "en": "Cannabinoids & cocaine"
   },
   "tex": "\\textit{Cannabis sativa} \\to \\text{marijuana, hashish, charas, ganja};\\ \\textit{Erythroxylum coca} \\to \\text{cocaine (dopamine)}",
   "note": {
    "en": "Hallucinogens: Atropa belladonna, Datura."
   }
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Tobacco"
   },
   "tex": "\\text{nicotine} \\to \\text{adrenal} \\to \\text{adrenaline, noradrenaline} \\uparrow \\text{BP, heart rate}",
   "note": {
    "en": "CO ↑, haem-bound O₂ ↓."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-biology-07-human-health-and-disease.t1",
   "name": {
    "en": "Anabolic steroids"
   },
   "tex": "\\text{females: masculinisation, deep voice, enlarged clitoris};\\ \\text{males: smaller testes, breast enlargement, baldness}",
   "note": {
    "en": "Females also: abnormal menstrual cycles, facial/body hair. Males also: acne, low sperm count, enlarged prostate, kidney/liver dysfunction."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-biology-07-human-health-and-disease.t5",
   "name": {
    "en": "Adolescence & dependence"
   },
   "tex": "12\\text{–}18\\ \\text{years};\\ \\text{withdrawal syndrome on stopping}"
  }
 ]
}
