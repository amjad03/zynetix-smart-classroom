 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Why put things in order?",
    "kn": "ಕ್ರಮದಲ್ಲಿ ಇಡುವುದು ಏಕೆ?"
   },
   "hook": {
    "en": "Finding a word in a dictionary is quick because the words are in alphabetical order. Imagine a dictionary with the words jumbled up. Sorting makes searching fast.",
    "kn": "ಪದಕೋಶದಲ್ಲಿ ಪದ ಹುಡುಕುವುದು ಸುಲಭ, ಏಕೆಂದರೆ ಪದಗಳು ಅಕಾರಾದಿ ಕ್ರಮದಲ್ಲಿವೆ. ವಿಂಗಡಣೆ ಹುಡುಕಾಟವನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Define sorting and give uses"
    },
    {
     "en": "Trace bubble sort pass by pass"
    },
    {
     "en": "Write bubble sort in Python"
    }
   ],
   "narration": {
    "en": "Finding a word in a dictionary is quick because the words are in alphabetical order. Imagine a dictionary with the words jumbled up. Sorting makes searching fast.",
    "kn": "ಪದಕೋಶದಲ್ಲಿ ಪದ ಹುಡುಕುವುದು ಸುಲಭ, ಏಕೆಂದರೆ ಪದಗಳು ಅಕಾರಾದಿ ಕ್ರಮದಲ್ಲಿವೆ. ವಿಂಗಡಣೆ ಹುಡುಕಾಟವನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Sorting"
   },
   "body": {
    "en": "Sorting is the process of arranging the elements of a collection in a particular order: increasing or decreasing for numbers, alphabetical for strings. Dictionaries, telephone directories, exam result lists and online shopping filters all rely on sorted data, because searching sorted data is much faster."
   },
   "points": [
    {
     "en": "Ascending (increasing) or descending (decreasing)"
    },
    {
     "en": "Uses: dictionary, phone book, rank lists"
    }
   ],
   "narration": {
    "en": "Sorting is the process of arranging the elements of a collection in a particular order: increasing or decreasing for numbers, alphabetical for strings. Dictionaries, telephone directories, exam result lists and online shopping filters all rely on sorted data, because searching sorted data is much faster.",
    "kn": "ವಿಂಗಡಣೆ ಎಂದರೆ ಅಂಶಗಳನ್ನು ಏರಿಕೆ ಅಥವಾ ಇಳಿಕೆ ಕ್ರಮದಲ್ಲಿ, ಅಥವಾ ಅಕಾರಾದಿ ಕ್ರಮದಲ್ಲಿ ಜೋಡಿಸುವುದು. ವಿಂಗಡಿಸಿದ ದತ್ತಾಂಶದಲ್ಲಿ ಹುಡುಕುವುದು ಬೇಗ."
   }
  },
