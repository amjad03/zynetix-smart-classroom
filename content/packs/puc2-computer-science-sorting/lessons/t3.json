 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Like sorting cards in your hand",
    "kn": "ಕೈಯಲ್ಲಿನ ಇಸ್ಪೀಟು ಎಲೆಗಳಂತೆ"
   },
   "hook": {
    "en": "When you pick up cards one at a time, you slide each new card into its right place among the cards you already hold. That is insertion sort.",
    "kn": "ಎಲೆಗಳನ್ನು ಒಂದೊಂದಾಗಿ ಎತ್ತಿಕೊಳ್ಳುವಾಗ ಪ್ರತಿ ಹೊಸ ಎಲೆಯನ್ನು ಈಗಾಗಲೇ ಹಿಡಿದಿರುವ ಎಲೆಗಳ ನಡುವೆ ಸರಿಯಾದ ಸ್ಥಳಕ್ಕೆ ಸೇರಿಸುತ್ತೇವೆ. ಇದೇ ಇನ್‌ಸರ್ಶನ್ ಸಾರ್ಟ್."
   },
   "objectives": [
    {
     "en": "Explain how insertion sort grows the sorted part"
    },
    {
     "en": "Trace insertion sort pass by pass"
    },
    {
     "en": "Write insertion sort in Python"
    }
   ],
   "narration": {
    "en": "When you pick up cards one at a time, you slide each new card into its right place among the cards you already hold. That is insertion sort.",
    "kn": "ಎಲೆಗಳನ್ನು ಒಂದೊಂದಾಗಿ ಎತ್ತಿಕೊಳ್ಳುವಾಗ ಪ್ರತಿ ಹೊಸ ಎಲೆಯನ್ನು ಈಗಾಗಲೇ ಹಿಡಿದಿರುವ ಎಲೆಗಳ ನಡುವೆ ಸರಿಯಾದ ಸ್ಥಳಕ್ಕೆ ಸೇರಿಸುತ್ತೇವೆ. ಇದೇ ಇನ್‌ಸರ್ಶನ್ ಸಾರ್ಟ್."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Insertion sort"
   },
   "body": {
    "en": "The first element alone forms the sorted part. In each pass, the next element of the unsorted part is taken out (temp) and compared with the elements of the sorted part from right to left; every larger element is shifted one place right, and temp is inserted into the gap. After n − 1 passes the list is sorted. If the list is already sorted, each pass needs only one comparison."
   },
   "points": [
    {
     "en": "Take the next unsorted element as temp"
    },
    {
     "en": "Shift larger sorted elements one place right"
    },
    {
     "en": "Insert temp into the gap"
    },
    {
     "en": "n − 1 passes"
    }
   ],
   "narration": {
    "en": "The first element alone forms the sorted part. In each pass, the next element of the unsorted part is taken out (temp) and compared with the elements of the sorted part from right to left; every larger element is shifted one place right, and temp is inserted into the gap. After n − 1 passes the list is sorted. If the list is already sorted, each pass needs only one comparison.",
    "kn": "ಮೊದಲ ಅಂಶ ವಿಂಗಡಿತ ಭಾಗ. ಪ್ರತಿ ಸುತ್ತಿನಲ್ಲಿ ಮುಂದಿನ ಅಂಶವನ್ನು (temp) ತೆಗೆದು, ವಿಂಗಡಿತ ಭಾಗದಲ್ಲಿ ಬಲದಿಂದ ಎಡಕ್ಕೆ ಹೋಲಿಸಿ, ದೊಡ್ಡವುಗಳನ್ನು ಬಲಕ್ಕೆ ಸರಿಸಿ, ಸರಿಯಾದ ಸ್ಥಳದಲ್ಲಿ ಸೇರಿಸುತ್ತೇವೆ."
   }
  },
