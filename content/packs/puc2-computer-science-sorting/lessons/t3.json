  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Run this insertion sort program and give the exact output."
   },
   "steps": [
    {
     "en": "def insertion_Sort(list3):"
    },
    {
     "en": "    n = len(list3)"
    },
    {
     "en": "    for i in range(1, n):"
    },
    {
     "en": "        temp = list3[i]"
    },
    {
     "en": "        j = i - 1"
    },
    {
     "en": "        while j >= 0 and temp < list3[j]:"
    },
    {
     "en": "            list3[j + 1] = list3[j]"
    },
    {
     "en": "            j = j - 1"
    },
    {
     "en": "        list3[j + 1] = temp"
    },
    {
     "en": "numList = [8, 7, 13, 1, -9, 4]"
    },
    {
     "en": "insertion_Sort(numList)"
    },
    {
     "en": "print(\"The sorted list is:\", numList)"
    }
   ],
   "answer": {
    "en": "The sorted list is: [-9, 1, 4, 7, 8, 13]"
   },
   "narration": {
    "en": "The while loop shifts larger elements to the right; when it stops, j + 1 is the gap for temp."
   }
  },
