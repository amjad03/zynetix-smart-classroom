   "problem": {
    "en": "Run this selection sort program and give the exact output."
   },
   "steps": [
    {
     "en": "def selection_Sort(list2):"
    },
    {
     "en": "    n = len(list2)"
    },
    {
     "en": "    for i in range(n - 1):"
    },
    {
     "en": "        min = i"
    },
    {
     "en": "        for j in range(i + 1, n):"
    },
    {
     "en": "            if list2[j] < list2[min]:"
    },
    {
     "en": "                min = j"
    },
    {
     "en": "        list2[min], list2[i] = list2[i], list2[min]"
    },
    {
     "en": "numList = [8, 7, 13, 1, -9, 4]"
    },
    {
     "en": "selection_Sort(numList)"
    },
    {
     "en": "print(\"The sorted list is:\", numList)"
    }
   ],
   "answer": {
    "en": "The sorted list is: [-9, 1, 4, 7, 8, 13]"
   },
   "narration": {
    "en": "The inner loop only remembers the position of the minimum; the swap happens once, after the inner loop."
   }
