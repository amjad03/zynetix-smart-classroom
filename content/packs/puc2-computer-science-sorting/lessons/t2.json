 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Pick the smallest, put it first",
    "kn": "ಚಿಕ್ಕದನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮೊದಲು ಇಡಿ"
   },
   "hook": {
    "en": "To line up students by height, you could find the shortest student and bring them to the front, then the next shortest, and so on. That is selection sort.",
    "kn": "ಎತ್ತರದ ಪ್ರಕಾರ ವಿದ್ಯಾರ್ಥಿಗಳನ್ನು ನಿಲ್ಲಿಸಲು ಅತಿ ಕುಳ್ಳನನ್ನು ಮುಂದೆ ತಂದು, ನಂತರ ಮುಂದಿನವನನ್ನು ತರುತ್ತೇವೆ. ಇದೇ ಸೆಲೆಕ್ಷನ್ ಸಾರ್ಟ್."
   },
   "objectives": [
    {
     "en": "Explain the sorted and unsorted parts"
    },
    {
     "en": "Trace selection sort pass by pass"
    },
    {
     "en": "Write selection sort in Python"
    }
   ],
   "narration": {
    "en": "To line up students by height, you could find the shortest student and bring them to the front, then the next shortest, and so on. That is selection sort.",
    "kn": "ಎತ್ತರದ ಪ್ರಕಾರ ವಿದ್ಯಾರ್ಥಿಗಳನ್ನು ನಿಲ್ಲಿಸಲು ಅತಿ ಕುಳ್ಳನನ್ನು ಮುಂದೆ ತಂದು, ನಂತರ ಮುಂದಿನವನನ್ನು ತರುತ್ತೇವೆ. ಇದೇ ಸೆಲೆಕ್ಷನ್ ಸಾರ್ಟ್."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Selection sort"
   },
   "body": {
    "en": "The list is treated as two parts: a sorted part on the left (empty at first) and an unsorted part on the right. In each pass, the smallest element of the unsorted part is selected and swapped with the leftmost element of the unsorted part, so the sorted part grows by one. After n − 1 passes the list is sorted. Each pass makes at most one swap."
   },
   "points": [
    {
     "en": "Find the minimum of the unsorted part"
    },
    {
     "en": "Swap it with the leftmost unsorted element"
    },
    {
     "en": "At most one swap per pass; n − 1 passes"
    }
   ],
   "narration": {
    "en": "The list is treated as two parts: a sorted part on the left (empty at first) and an unsorted part on the right. In each pass, the smallest element of the unsorted part is selected and swapped with the leftmost element of the unsorted part, so the sorted part grows by one. After n − 1 passes the list is sorted. Each pass makes at most one swap.",
    "kn": "ಪಟ್ಟಿಯಲ್ಲಿ ಎಡಭಾಗ ವಿಂಗಡಿತ, ಬಲಭಾಗ ಅವಿಂಗಡಿತ. ಪ್ರತಿ ಸುತ್ತಿನಲ್ಲಿ ಅವಿಂಗಡಿತ ಭಾಗದ ಚಿಕ್ಕ ಅಂಶವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅದರ ಮೊದಲ ಅಂಶದೊಂದಿಗೆ ಅದಲುಬದಲು ಮಾಡುತ್ತೇವೆ. n − 1 ಸುತ್ತುಗಳು ಬೇಕು."
   }
  },
