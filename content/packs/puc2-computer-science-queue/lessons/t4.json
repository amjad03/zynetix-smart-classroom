     "en": "def isPalindrome(word):"
    },
    {
     "en": "    dq = []"
    },
    {
     "en": "    for ch in word:"
    },
    {
     "en": "        dq.append(ch)"
    },
    {
     "en": "    while len(dq) > 1:"
    },
    {
     "en": "        if dq.pop(0) != dq.pop():"
    },
    {
     "en": "            return False"
    },
    {
     "en": "    return True"
    },
    {
     "en": "for w in [\"MALAYALAM\", \"KANNADA\", \"NOON\"]:"
    },
    {
     "en": "    print(w, isPalindrome(w))"
    }
