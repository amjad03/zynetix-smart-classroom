   "steps": [
    {
     "en": "D = −1, 1, −1, 1, −1, 1; ΣD² = 6."
    },
    {
     "en": "ρ = 1 − 6 × 6/[6(36 − 1)] = 1 − 36/210."
    },
    {
     "en": "ρ = 0.8286."
    }
   ],
   "answer": {
    "en": "ρ = 0.83, high agreement"
   },
