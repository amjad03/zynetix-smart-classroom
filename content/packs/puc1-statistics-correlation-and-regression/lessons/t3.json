   "steps": [
    {
     "en": "Ranks of x: 1, 2.5, 2.5, 4, 5 (60 is tied for ranks 2 and 3). Ranks of y: 1, 2, 4, 3, 5."
    },
    {
     "en": "D = 0, 0.5, −1.5, 1, 0; ΣD² = 3.5."
    },
    {
     "en": "One tie of m = 2: correction = 2(4 − 1)/12 = 0.5."
    },
    {
     "en": "ρ = 1 − 6(3.5 + 0.5)/[5(25 − 1)] = 1 − 24/120 = 0.8."
    }
   ],
