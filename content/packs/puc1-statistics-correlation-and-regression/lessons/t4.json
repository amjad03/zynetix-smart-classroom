 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "From relation to prediction",
    "kn": "ಸಂಬಂಧದಿಂದ ಮುನ್ಸೂಚನೆಗೆ"
   },
   "hook": {
    "en": "Correlation tells us that rainfall and yield are related. Regression goes further: given 80 cm of rain, what yield should we expect?",
    "kn": "ಮಳೆ ಮತ್ತು ಇಳುವರಿಗೆ ಸಂಬಂಧವಿದೆ ಎಂದು ಸಹಸಂಬಂಧ ಹೇಳುತ್ತದೆ. ಪ್ರತಿಗಮನ ಮುಂದೆ ಹೋಗುತ್ತದೆ: 80 ಸೆಂ.ಮೀ. ಮಳೆಯಾದರೆ ಎಷ್ಟು ಇಳುವರಿ ನಿರೀಕ್ಷಿಸಬಹುದು?"
   },
   "objectives": [
    {
     "en": "Write the two lines of regression"
    },
    {
     "en": "Compute the regression coefficients"
    },
    {
     "en": "Estimate one variable from the other"
    }
   ],
   "narration": {
    "en": "Correlation tells us that rainfall and yield are related. Regression goes further: given 80 cm of rain, what yield should we expect?",
    "kn": "ಮಳೆ ಮತ್ತು ಇಳುವರಿಗೆ ಸಂಬಂಧವಿದೆ ಎಂದು ಸಹಸಂಬಂಧ ಹೇಳುತ್ತದೆ. ಪ್ರತಿಗಮನ ಮುಂದೆ ಹೋಗುತ್ತದೆ: 80 ಸೆಂ.ಮೀ. ಮಳೆಯಾದರೆ ಎಷ್ಟು ಇಳುವರಿ ನಿರೀಕ್ಷಿಸಬಹುದು?"
   }
