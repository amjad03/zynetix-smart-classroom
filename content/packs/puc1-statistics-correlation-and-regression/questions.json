  "topicId": "puc1-statistics-08-correlation-and-regression.t5",
  "stem": {
   "en": "If b_yx = 1.6, which of these values of b_xy is impossible?"
  },
  "options": [
   {
    "en": "0.6"
   },
   {
    "en": "0.5"
   },
   {
    "en": "0.25"
   },
   {
    "en": "0.8"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "b_yx × b_xy = r² ≤ 1. 1.6 × 0.8 = 1.28 > 1, which is impossible; the others give products ≤ 1."
  },
