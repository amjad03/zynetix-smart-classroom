{
 "chapterId": "puc2-physics-03-current-electricity",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Drift velocity"
   },
   "tex": "I = neAv_d",
   "note": {
    "en": "v_d ~ 10⁻⁴ m/s."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Resistance"
   },
   "tex": "R = \\frac{\\rho L}{A}",
   "note": {
    "en": "Stretch n times → n²R."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-03-current-electricity.t2",
   "name": {
    "en": "Temperature dependence"
   },
   "tex": "R_T = R_0(1 + \\alpha\\Delta T)",
   "note": {
    "en": "α > 0 for metals."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Terminal voltage"
   },
   "tex": "V = E - Ir",
   "note": {
    "en": "Charging: V = E + Ir."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-03-current-electricity.t2",
   "name": {
    "en": "Power"
   },
   "tex": "P = VI = I^2R = \\frac{V^2}{R}",
   "note": {
    "en": "Bulb R = V²/P (rated)."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-03-current-electricity.t3",
   "name": {
    "en": "Max power transfer"
   },
   "tex": "R = r,\\quad P_{max} = \\frac{E^2}{4r}",
   "note": {
    "en": "Efficiency is then 50%."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-03-current-electricity.t5",
   "name": {
    "en": "Wheatstone bridge"
   },
   "tex": "\\frac PQ = \\frac RS",
   "note": {
    "en": "Galvanometer current zero."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Potentiometer"
   },
   "tex": "\\frac{E_1}{E_2} = \\frac{l_1}{l_2}",
   "note": {
    "en": "Ideal voltmeter: draws no current."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Current"
   },
   "tex": "I = \\dfrac{dq}{dt},\\qquad n_e = \\dfrac{It}{e}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Drift velocity"
   },
   "tex": "v_d = \\dfrac{eE\\tau}{m},\\qquad I = neAv_d",
   "note": {
    "en": "v_d ~ 10⁻⁴ m s⁻¹; the field travels at nearly c."
   }
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Mobility"
   },
   "tex": "\\mu = \\dfrac{v_d}{E} = \\dfrac{e\\tau}{m}\\quad (\\text{m}^2\\text{V}^{-1}\\text{s}^{-1})"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Current density; microscopic Ohm's law"
   },
   "tex": "\\vec j = \\dfrac{I}{A}\\hat n = nev_d,\\qquad \\vec j = \\sigma\\vec E"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Ohm's law; resistance"
   },
   "tex": "V = IR,\\qquad R = \\dfrac{\\rho l}{A}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Resistivity"
   },
   "tex": "\\rho = \\dfrac{m}{ne^2\\tau},\\qquad \\sigma = \\dfrac{1}{\\rho}\\ (\\text{S m}^{-1})",
   "note": {
    "en": "Depends on material and temperature, not on dimensions."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Stretching a wire (volume constant)"
   },
   "tex": "R \\propto l^2 \\propto \\dfrac{1}{A^2} \\propto \\dfrac{1}{r^4}",
   "note": {
    "en": "Small change: ΔR/R ≈ 2Δl/l."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-03-current-electricity.t2",
   "name": {
    "en": "Temperature dependence"
   },
   "tex": "R_T = R_0[1 + \\alpha(T - T_0)]",
   "note": {
    "en": "Metals α > 0; semiconductors ρ decreases with T; manganin/constantan α ≈ 0."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Series and parallel resistors"
   },
   "tex": "R_s = \\sum R_i,\\qquad \\dfrac{1}{R_p} = \\sum\\dfrac{1}{R_i}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Cell: emf and terminal voltage"
   },
   "tex": "I = \\dfrac{E}{R + r},\\quad V = E - Ir\\ (\\text{discharging}),\\quad V = E + Ir\\ (\\text{charging})"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Internal resistance from readings"
   },
   "tex": "r = R\\left(\\dfrac{E}{V} - 1\\right)"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Cells in series"
   },
   "tex": "E_{\\text{eq}} = \\sum E_i,\\quad r_{\\text{eq}} = \\sum r_i",
   "note": {
    "en": "A reversed cell subtracts 2E from nE but still adds its r."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Cells in parallel"
   },
   "tex": "E_{\\text{eq}} = \\dfrac{\\sum E_i/r_i}{\\sum 1/r_i},\\qquad \\dfrac{1}{r_{\\text{eq}}} = \\sum\\dfrac{1}{r_i}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Mixed grouping (m rows of n cells)"
   },
   "tex": "I = \\dfrac{nE}{R + nr/m},\\quad I_{\\max}\\ \\text{when}\\ R = \\dfrac{nr}{m}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-physics-03-current-electricity.t5",
   "name": {
    "en": "Kirchhoff's rules"
   },
   "tex": "\\sum I_{\\text{junction}} = 0,\\qquad \\sum_{\\text{loop}}(\\pm E) + \\sum(\\mp IR) = 0",
   "note": {
    "en": "Junction rule: charge conservation; loop rule: energy conservation."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-physics-03-current-electricity.t5",
   "name": {
    "en": "Wheatstone bridge balance"
   },
   "tex": "\\dfrac{P}{Q} = \\dfrac{R}{S}",
   "note": {
    "en": "Galvanometer arm then carries no current; most sensitive when all arms are similar."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-physics-03-current-electricity.t3",
   "name": {
    "en": "Metre bridge"
   },
   "tex": "\\dfrac{X}{R} = \\dfrac{l}{100 - l}\\ (l\\ \\text{in cm})",
   "note": {
    "en": "Interchange X and R to remove end errors; best null near the middle."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-physics-03-current-electricity.t3",
   "name": {
    "en": "Electrical power"
   },
   "tex": "P = VI = I^2R = \\dfrac{V^2}{R}"
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-physics-03-current-electricity.t4",
   "name": {
    "en": "Bulbs in series / parallel"
   },
   "tex": "P_s = \\dfrac{P_1P_2}{P_1 + P_2},\\qquad P_p = P_1 + P_2\\ (\\text{same rated }V)",
   "note": {
    "en": "In series the lower-wattage bulb glows brighter."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-physics-03-current-electricity.t3",
   "name": {
    "en": "Maximum power transfer"
   },
   "tex": "P_{\\max} = \\dfrac{E^2}{4r}\\ \\text{at}\\ R = r,\\quad \\eta = \\dfrac{R}{R + r} = 50\\%"
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-physics-03-current-electricity.t3",
   "name": {
    "en": "Electrical energy"
   },
   "tex": "W = Pt,\\qquad 1\\ \\text{kWh} = 1\\ \\text{unit} = 3.6\\times10^6\\ \\text{J}"
  },
  {
   "id": "zs-f30",
   "name": {
    "en": "Useful network results"
   },
   "tex": "R_{\\text{ladder}} = \\dfrac{(1+\\sqrt5)R}{2},\\quad \\text{cube: } \\tfrac{7R}{12}\\ (\\text{edge}),\\ \\tfrac{3R}{4}\\ (\\text{face diag.}),\\ \\tfrac{5R}{6}\\ (\\text{body diag.})"
  },
  {
   "id": "zs-f31",
   "topicId": "puc2-physics-03-current-electricity.t1",
   "name": {
    "en": "Tapered conductor"
   },
   "tex": "R = \\dfrac{\\rho L}{\\pi ab}"
  },
  {
   "id": "zs-f32",
   "topicId": "puc2-physics-03-current-electricity.t5",
   "name": {
    "en": "Capacitor in a DC circuit (steady state)"
   },
   "tex": "I_C = 0,\\quad Q = CV_{\\text{parallel branch}}"
  }
 ]
}
