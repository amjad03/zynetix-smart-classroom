   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Simplify Y = AB + AB̅ + A̅B."
   },
   "steps": [
    {
     "en": "AB + AB̅ = A(B + B̅) = A·1 = A."
    },
    {
     "en": "So Y = A + A̅B."
    },
    {
     "en": "Using A + A̅B = A + B: Y = A + B."
    }
   ],
   "answer": {
    "en": "Y = A + B (one OR gate)"
   },
   "narration": {
    "en": "Let us work this out together. Simplify Y = AB + AB̅ + A̅B."
   }
