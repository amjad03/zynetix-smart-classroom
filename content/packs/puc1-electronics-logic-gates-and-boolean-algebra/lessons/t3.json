  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Prove A + BC = (A + B)(A + C)."
   },
   "steps": [
    {
     "en": "Expand the right side: AA + AC + AB + BC."
    },
    {
     "en": "AA = A, so it is A + AC + AB + BC = A(1 + C + B) + BC."
    },
    {
     "en": "1 + C + B = 1, so it equals A + BC."
    }
   ],
   "answer": {
    "en": "Both sides are equal (distributive law)"
   },
   "narration": {
    "en": "Let us work this out together. Prove A + BC = (A + B)(A + C)."
