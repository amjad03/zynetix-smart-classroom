 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "One gate to build them all",
    "kn": "ಎಲ್ಲವನ್ನೂ ನಿರ್ಮಿಸುವ ಒಂದೇ ದ್ವಾರ"
   },
   "hook": {
    "en": "Factories prefer to make chips from one kind of gate. With only NAND gates, or only *NOR gates*, we can build any digital circuit.",
    "kn": "ಕಾರ್ಖಾನೆಗಳು ಒಂದೇ ಬಗೆಯ ದ್ವಾರದಿಂದ ಚಿಪ್ ತಯಾರಿಸಲು ಇಷ್ಟಪಡುತ್ತವೆ. ನ್ಯಾಂಡ್ ಅಥವಾ ನಾರ್ ದ್ವಾರಗಳಿಂದ ಮಾತ್ರ ಯಾವುದೇ ಡಿಜಿಟಲ್ ಸರ್ಕ್ಯೂಟ್ ನಿರ್ಮಿಸಬಹುದು."
   },
   "objectives": [
    {
     "en": "Realise NOT, AND and OR gates using only NAND gates"
    },
    {
     "en": "Realise NOT, OR and AND gates using only NOR gates"
    }
   ],
   "narration": {
    "en": "Factories prefer to make chips from one kind of gate. With only NAND gates, or only NOR gates, we can build any digital circuit.",
    "kn": "ಕಾರ್ಖಾನೆಗಳು ಒಂದೇ ಬಗೆಯ ದ್ವಾರದಿಂದ ಚಿಪ್ ತಯಾರಿಸಲು ಇಷ್ಟಪಡುತ್ತವೆ. ನ್ಯಾಂಡ್ ಅಥವಾ ನಾರ್ ದ್ವಾರಗಳಿಂದ ಮಾತ್ರ ಯಾವುದೇ ಡಿಜಿಟಲ್ ಸರ್ಕ್ಯೂಟ್ ನಿರ್ಮಿಸಬಹುದು."
