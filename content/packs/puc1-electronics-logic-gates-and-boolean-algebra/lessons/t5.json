    {
     "name": "Y",
     "expr": "if(k == 1 || k == 4, G1, if(k == 2, 1 - (G1)*(G1), if(k == 5, 1 - max(G1, G1), if(k == 3, 1 - (G1)*(G2), 1 - max(G1, G2)))))"
    },
    {
     "name": "gates",
     "expr": "if(k == 1 || k == 4, 1, if(k == 2 || k == 5, 2, 3))"
    }
