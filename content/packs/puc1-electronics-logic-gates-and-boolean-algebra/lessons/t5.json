{
 "id": "puc1-electronics-10-logic-gates-and-boolean-algebra.t5.lesson",
 "chapterId": "puc1-electronics-10-logic-gates-and-boolean-algebra",
 "topicId": "puc1-electronics-10-logic-gates-and-boolean-algebra.t5",
 "title": {
  "en": "Universality of NAND and NOR gates",
  "kn": "ನ್ಯಾಂಡ್ ಮತ್ತು ನಾರ್ ದ್ವಾರಗಳ ಸಾರ್ವತ್ರಿಕತೆ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "One gate to build them all",
    "kn": "ಎಲ್ಲವನ್ನೂ ನಿರ್ಮಿಸುವ ಒಂದೇ ದ್ವಾರ"
   },
   "hook": {
    "en": "Factories prefer to make chips from one kind of gate. With only NAND gates, or only NOR gates, we can build any digital circuit.",
    "kn": "ಕಾರ್ಖಾನೆಗಳು ಒಂದೇ ಬಗೆಯ ದ್ವಾರದಿಂದ ಚಿಪ್ ತಯಾರಿಸಲು ಇಷ್ಟಪಡುತ್ತವೆ. ನ್ಯಾಂಡ್ ಅಥವಾ ನಾರ್ ದ್ವಾರಗಳಿಂದ ಮಾತ್ರ ಯಾವುದೇ ಡಿಜಿಟಲ್ ಸರ್ಕ್ಯೂಟ್ ನಿರ್ಮಿಸಬಹುದು."
   },
   "objectives": [
    {
     "en": "Realise NOT, AND and OR gates using only NAND gates"
    },
    {
     "en": "Realise NOT, OR and AND gates using only NOR gates"
    }
   ],
   "narration": {
    "en": "Factories prefer to make chips from one kind of gate. With only NAND gates, or only NOR gates, we can build any digital circuit.",
    "kn": "ಕಾರ್ಖಾನೆಗಳು ಒಂದೇ ಬಗೆಯ ದ್ವಾರದಿಂದ ಚಿಪ್ ತಯಾರಿಸಲು ಇಷ್ಟಪಡುತ್ತವೆ. ನ್ಯಾಂಡ್ ಅಥವಾ ನಾರ್ ದ್ವಾರಗಳಿಂದ ಮಾತ್ರ ಯಾವುದೇ ಡಿಜಿಟಲ್ ಸರ್ಕ್ಯೂಟ್ ನಿರ್ಮಿಸಬಹುದು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "NAND as a universal gate"
   },
   "body": {
    "en": "NOT: tie both inputs of a NAND together: $\\overline{A\\cdot A} = \\overline{A}$. AND: NAND followed by a NAND-inverter: $\\overline{\\overline{AB}} = AB$ (2 gates). OR: invert each input with a NAND, then NAND the results: $\\overline{\\overline{A}\\cdot\\overline{B}} = A + B$ (3 gates, by De Morgan)."
   },
   "points": [
    {
     "en": "NOT: 1 NAND (inputs tied)"
    },
    {
     "en": "AND: 2 NANDs"
    },
    {
     "en": "OR: 3 NANDs"
    },
    {
     "en": "XOR: 4 NANDs"
    }
   ],
   "narration": {
    "en": "With NAND gates: one gate gives NOT, two give AND, three give OR.",
    "kn": "ನ್ಯಾಂಡ್ ದ್ವಾರಗಳಿಂದ: ಒಂದು ದ್ವಾರ ನಾಟ್, ಎರಡು ಆಂಡ್, ಮೂರು ಆರ್ ನೀಡುತ್ತವೆ."
   }
  },
