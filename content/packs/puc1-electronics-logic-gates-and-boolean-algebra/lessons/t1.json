 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Decisions made of 0s and 1s",
    "kn": "0 ಮತ್ತು 1 ರಿಂದ ಮಾಡಿದ ನಿರ್ಧಾರಗಳು"
   },
   "hook": {
    "en": "A washing machine starts only if the door is closed AND the start button is pressed. A room light comes on if either switch is pressed. Those are logic gates in daily life.",
    "kn": "ಬಾಗಿಲು ಮುಚ್ಚಿದ್ದು ಮತ್ತು ಸ್ಟಾರ್ಟ್ ಬಟನ್ ಒತ್ತಿದರೆ ಮಾತ್ರ ವಾಷಿಂಗ್ ಮೆಷಿನ್ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ದಿನನಿತ್ಯದ ಜೀವನದಲ್ಲಿ ಇವೇ ತರ್ಕ ದ್ವಾರಗಳು."
   },
   "objectives": [
    {
     "en": "State the symbol, Boolean expression and truth table of AND, OR and NOT gates"
    },
    {
     "en": "Relate gates to switch circuits"
    }
   ],
   "narration": {
    "en": "A washing machine starts only if the door is closed AND the start button is pressed. A room light comes on if either switch is pressed. Those are logic gates in daily life.",
    "kn": "ಬಾಗಿಲು ಮುಚ್ಚಿದ್ದು ಮತ್ತು ಸ್ಟಾರ್ಟ್ ಬಟನ್ ಒತ್ತಿದರೆ ಮಾತ್ರ ವಾಷಿಂಗ್ ಮೆಷಿನ್ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ದಿನನಿತ್ಯದ ಜೀವನದಲ್ಲಿ ಇವೇ ತರ್ಕ ದ್ವಾರಗಳು."
   }
