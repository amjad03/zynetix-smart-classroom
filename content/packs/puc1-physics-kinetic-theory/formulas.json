{
 "chapterId": "puc1-physics-12-kinetic-theory",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-12-kinetic-theory.t1",
   "name": {
    "en": "Ideal gas equation"
   },
   "tex": "PV = nRT = Nk_BT,\\qquad P = nk_BT\\ (n = N/V)",
   "note": {
    "en": "R = 8.31 J mol⁻¹ K⁻¹, k_B = R/N_A = 1.38 × 10⁻²³ J K⁻¹."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Gas laws (special cases)"
   },
   "tex": "\\text{Boyle: } PV = \\text{const }(T);\\quad \\text{Charles: } V \\propto T\\ (P);\\quad \\text{Gay-Lussac: } P \\propto T\\ (V)"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-12-kinetic-theory.t1",
   "name": {
    "en": "Dalton's law of partial pressures"
   },
   "tex": "P = P_1 + P_2 + \\dots,\\qquad P_i = \\dfrac{n_iRT}{V}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-12-kinetic-theory.t1",
   "name": {
    "en": "Avogadro's law / molar volume"
   },
   "tex": "V_m = 22.4\\ \\text{L at STP};\\quad n_L = 2.69 \\times 10^{25}\\ \\text{m}^{-3}",
   "note": {
    "en": "Equal volumes at the same T and P hold equal numbers of molecules."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-12-kinetic-theory.t2",
   "name": {
    "en": "Pressure from kinetic theory"
   },
   "tex": "P = \\tfrac13\\dfrac{N}{V}m\\overline{v^2} = \\tfrac13\\rho v_{\\text{rms}}^2 = \\tfrac23\\dfrac{E_{\\text{tr}}}{V}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-12-kinetic-theory.t2",
   "name": {
    "en": "Momentum change at a wall"
   },
   "tex": "\\Delta p = 2mv\\cos\\theta",
   "note": {
    "en": "θ is measured from the normal; only the normal component reverses."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Kinetic interpretation of temperature"
   },
   "tex": "\\overline{\\text{KE}}_{\\text{tr}} = \\tfrac12m\\overline{v^2} = \\tfrac32k_BT",
   "note": {
    "en": "Per mole: (3/2)RT. Independent of the nature of the gas."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-12-kinetic-theory.t3",
   "name": {
    "en": "rms speed"
   },
   "tex": "v_{\\text{rms}} = \\sqrt{\\dfrac{3k_BT}{m}} = \\sqrt{\\dfrac{3RT}{M}} = \\sqrt{\\dfrac{3P}{\\rho}}",
   "note": {
    "en": "Use M in kg mol⁻¹."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-12-kinetic-theory.t3",
   "name": {
    "en": "Average and most probable speeds"
   },
   "tex": "v_{\\text{av}} = \\sqrt{\\dfrac{8RT}{\\pi M}},\\qquad v_{\\text{mp}} = \\sqrt{\\dfrac{2RT}{M}}"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Ordering of speeds"
   },
   "tex": "v_{\\text{rms}} : v_{\\text{av}} : v_{\\text{mp}} = \\sqrt3 : \\sqrt{8/\\pi} : \\sqrt2 \\approx 1.22 : 1.13 : 1"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Law of equipartition"
   },
   "tex": "\\text{energy per quadratic term} = \\tfrac12k_BT",
   "note": {
    "en": "A vibrational mode has KE + PE terms, so it contributes k_BT."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Degrees of freedom (f)"
   },
   "tex": "\\text{monatomic } 3;\\ \\ \\text{rigid diatomic / linear } 5;\\ \\ \\text{rigid non-linear } 6;\\ \\ \\text{diatomic + vibration } 7"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Internal energy of an ideal gas"
   },
   "tex": "U = \\dfrac f2 nRT"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Molar specific heats"
   },
   "tex": "C_v = \\dfrac f2R,\\qquad C_p = C_v + R = \\left(\\dfrac f2 + 1\\right)R"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Ratio of specific heats"
   },
   "tex": "\\gamma = \\dfrac{C_p}{C_v} = 1 + \\dfrac2f",
   "note": {
    "en": "Monatomic 5/3, rigid diatomic 7/5, rigid non-linear 4/3, vibrating diatomic 9/7."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-12-kinetic-theory.t1",
   "name": {
    "en": "Mixture of gases"
   },
   "tex": "C_{v,\\text{mix}} = \\dfrac{\\sum n_iC_{v,i}}{\\sum n_i},\\qquad \\gamma_{\\text{mix}} = \\dfrac{C_{v,\\text{mix}} + R}{C_{v,\\text{mix}}}",
   "note": {
    "en": "Never average γ directly."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Specific heat of solids (Dulong–Petit)"
   },
   "tex": "C = 3R \\approx 25\\ \\text{J mol}^{-1}\\text{K}^{-1}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-12-kinetic-theory.t4",
   "name": {
    "en": "Specific heat of water"
   },
   "tex": "C \\approx 9R \\approx 75\\ \\text{J mol}^{-1}\\text{K}^{-1}",
   "note": {
    "en": "Treating each of the 3 atoms as a 3-D oscillator."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-12-kinetic-theory.t5",
   "name": {
    "en": "Mean free path"
   },
   "tex": "\\lambda = \\dfrac{1}{\\sqrt2\\,\\pi d^2n} = \\dfrac{k_BT}{\\sqrt2\\,\\pi d^2P}",
   "note": {
    "en": "At fixed n, λ is independent of T."
   }
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Collision frequency"
   },
   "tex": "z = \\dfrac{v_{\\text{av}}}{\\lambda} = \\sqrt2\\,\\pi d^2 n\\,v_{\\text{av}}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-12-kinetic-theory.t1",
   "name": {
    "en": "Ideal behaviour"
   },
   "tex": "\\text{real gases} \\to \\text{ideal at low } P \\text{ and high } T"
  }
 ]
}
