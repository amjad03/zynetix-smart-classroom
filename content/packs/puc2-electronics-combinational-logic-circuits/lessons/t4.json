 "title": {
  "en": "Decoders and encoders",
  "kn": "ಡಿಕೋಡರ್ ಮತ್ತು ಎನ್‌ಕೋಡರ್"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "From a code to a lamp, from a key to a code",
    "kn": "ಸಂಕೇತದಿಂದ ದೀಪಕ್ಕೆ, ಕೀಲಿಯಿಂದ ಸಂಕೇತಕ್ಕೆ"
   },
   "hook": {
    "en": "When you press 7 on a calculator, a circuit turns the key into a binary code; another turns that code into the shape of 7 on the display. These are the encoder and the decoder.",
    "kn": "ಕ್ಯಾಲ್ಕುಲೇಟರ್‌ನಲ್ಲಿ 7 ಒತ್ತಿದಾಗ ಒಂದು ಮಂಡಲ ಕೀಲಿಯನ್ನು ದ್ವಿಮಾನ ಸಂಕೇತವಾಗಿಸುತ್ತದೆ; ಇನ್ನೊಂದು ಆ ಸಂಕೇತವನ್ನು ಪ್ರದರ್ಶಕದಲ್ಲಿ 7 ರ ಆಕಾರವಾಗಿಸುತ್ತದೆ. ಅವೇ ಎನ್‌ಕೋಡರ್ ಮತ್ತು ಡಿಕೋಡರ್."
   },
   "objectives": [
    {
     "en": "Explain a 2:4 and 3:8 decoder"
    },
    {
     "en": "Explain the BCD to 7-segment decoder"
    },
    {
     "en": "Design an 8:3 (octal to binary) encoder and state the need for a priority encoder"
    }
   ],
   "narration": {
    "en": "When you press 7 on a calculator, a circuit turns the key into a binary code; another turns that code into the shape of 7 on the display. These are the encoder and the decoder.",
    "kn": "ಕ್ಯಾಲ್ಕುಲೇಟರ್‌ನಲ್ಲಿ 7 ಒತ್ತಿದಾಗ ಒಂದು ಮಂಡಲ ಕೀಲಿಯನ್ನು ದ್ವಿಮಾನ ಸಂಕೇತವಾಗಿಸುತ್ತದೆ; ಇನ್ನೊಂದು ಆ ಸಂಕೇತವನ್ನು ಪ್ರದರ್ಶಕದಲ್ಲಿ 7 ರ ಆಕಾರವಾಗಿಸುತ್ತದೆ. ಅವೇ ಎನ್‌ಕೋಡರ್ ಮತ್ತು ಡಿಕೋಡರ್."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Decoder"
   },
   "body": {
    "en": "A decoder converts an n-bit binary input into one active line out of at most $2^n$ outputs. In a 2:4 decoder with inputs A (MSB) and B, $D_0 = \\bar{A}\\bar{B}$, $D_1 = \\bar{A}B$, $D_2 = A\\bar{B}$, $D_3 = AB$: one AND gate per output. Common ICs: 74138 (3:8, active-low outputs), 7442 (BCD to decimal), 7447 (BCD to 7-segment, active-low, for common-anode displays) and 7448 (for common-cathode displays). A decoder with an enable input can be used as a demultiplexer."
   },
   "points": [
    {
     "en": "n inputs → 2ⁿ outputs, only one active"
    },
    {
     "en": "Each output is one minterm of the inputs"
    },
    {
     "en": "7447: BCD to 7-segment decoder/driver"
    }
   ],
   "narration": {
    "en": "A decoder turns an n-bit code into one active output out of two to the power n. Each output is an AND of the inputs or their complements.",
    "kn": "ಡಿಕೋಡರ್ n-ಬಿಟ್ ಸಂಕೇತವನ್ನು 2ⁿ ಔಟ್‌ಪುಟ್‌ಗಳಲ್ಲಿ ಒಂದು ಸಕ್ರಿಯ ಔಟ್‌ಪುಟ್ ಆಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ."
   },
   "formula": "D_0 = \\bar A\\bar B,\\; D_1 = \\bar A B,\\; D_2 = A\\bar B,\\; D_3 = AB"
  },
