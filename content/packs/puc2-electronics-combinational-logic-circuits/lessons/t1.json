  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "From the half adder truth table, write the sum-of-products expression for S and simplify it."
   },
   "steps": [
    {
     "en": "S = 1 in rows A B = 0 1 and 1 0."
    },
    {
     "en": "So S = ĀB + AB̄."
    },
    {
     "en": "ĀB + AB̄ is the definition of A ⊕ B."
    }
   ],
   "answer": {
    "en": "S = ĀB + AB̄ = A ⊕ B"
   },
