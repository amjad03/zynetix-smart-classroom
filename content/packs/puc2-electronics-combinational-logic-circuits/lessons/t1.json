 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "How does a chip add 1 + 1?",
    "kn": "ಚಿಪ್ 1 + 1 ಅನ್ನು ಹೇಗೆ ಕೂಡಿಸುತ್ತದೆ?"
   },
   "hook": {
    "en": "Every calculator and computer adds numbers with a few logic gates. In binary, 1 + 1 = 10: a sum bit and a carry bit. Today we build the circuit that does it.",
    "kn": "ಪ್ರತಿಯೊಂದು ಕ್ಯಾಲ್ಕುಲೇಟರ್ ಮತ್ತು ಕಂಪ್ಯೂಟರ್ ಕೆಲವೇ ಲಾಜಿಕ್ ಗೇಟ್‌ಗಳಿಂದ ಸಂಖ್ಯೆಗಳನ್ನು ಕೂಡಿಸುತ್ತದೆ. ದ್ವಿಮಾನದಲ್ಲಿ 1 + 1 = 10: ಒಂದು ಮೊತ್ತ ಬಿಟ್ ಮತ್ತು ಒಂದು ಕ್ಯಾರಿ ಬಿಟ್. ಇಂದು ಅದನ್ನು ಮಾಡುವ ಮಂಡಲವನ್ನು ಕಟ್ಟೋಣ."
   },
   "objectives": [
    {
     "en": "Define a combinational logic circuit"
    },
    {
     "en": "Design a half adder from its truth table"
    },
    {
     "en": "Build a full adder from two half adders and an OR gate"
    }
   ],
   "narration": {
    "en": "Every calculator and computer adds numbers with a few logic gates. In binary, 1 + 1 = 10: a sum bit and a carry bit. Today we build the circuit that does it.",
    "kn": "ಪ್ರತಿಯೊಂದು ಕ್ಯಾಲ್ಕುಲೇಟರ್ ಮತ್ತು ಕಂಪ್ಯೂಟರ್ ಕೆಲವೇ ಲಾಜಿಕ್ ಗೇಟ್‌ಗಳಿಂದ ಸಂಖ್ಯೆಗಳನ್ನು ಕೂಡಿಸುತ್ತದೆ. ದ್ವಿಮಾನದಲ್ಲಿ 1 + 1 = 10: ಒಂದು ಮೊತ್ತ ಬಿಟ್ ಮತ್ತು ಒಂದು ಕ್ಯಾರಿ ಬಿಟ್. ಇಂದು ಅದನ್ನು ಮಾಡುವ ಮಂಡಲವನ್ನು ಕಟ್ಟೋಣ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Combinational circuits and the half adder"
   },
   "body": {
    "en": "In a combinational circuit the output at any instant depends only on the present inputs; it has no memory. A half adder adds two bits A and B and gives a sum S and a carry C. From its truth table, $S = \\bar{A}B + A\\bar{B} = A\\oplus B$ and $C = AB$, so it needs one XOR gate and one AND gate."
   },
   "points": [
    {
     "en": "Combinational: output = f(present inputs), no memory"
    },
    {
     "en": "Half adder: S = A ⊕ B (XOR), C = A·B (AND)"
    },
    {
     "en": "It cannot accept a carry from a previous stage"
    }
   ],
   "narration": {
    "en": "A half adder adds two bits. The sum is A XOR B and the carry is A AND B, so one XOR gate and one AND gate are enough.",
    "kn": "ಅರ್ಧ ಸಂಕಲಕ ಎರಡು ಬಿಟ್‌ಗಳನ್ನು ಕೂಡಿಸುತ್ತದೆ. ಮೊತ್ತ A XOR B, ಕ್ಯಾರಿ A AND B. ಆದ್ದರಿಂದ ಒಂದು XOR ಮತ್ತು ಒಂದು AND ಗೇಟ್ ಸಾಕು."
   },
   "formula": "S = A\\oplus B, \\qquad C = A\\cdot B"
  },
