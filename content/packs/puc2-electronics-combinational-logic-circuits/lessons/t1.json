   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A full adder has A = 1, B = 0 and Cin = 1. Find S and Cout using the equations."
   },
   "steps": [
    {
     "en": "A ⊕ B = 1 ⊕ 0 = 1."
    },
    {
     "en": "S = (A ⊕ B) ⊕ Cin = 1 ⊕ 1 = 0."
    },
    {
     "en": "Cout = AB + Cin(A ⊕ B) = 0 + 1·1 = 1."
    },
    {
     "en": "Check: 1 + 0 + 1 = 2 = 10 in binary, so S = 0 and Cout = 1."
    }
   ],
   "answer": {
    "en": "S = 0, Cout = 1"
   },
   "narration": {
    "en": "Let us work this out together. A full adder has A = 1, B = 0 and Cin = 1. Find S and Cout using the equations."
   }
