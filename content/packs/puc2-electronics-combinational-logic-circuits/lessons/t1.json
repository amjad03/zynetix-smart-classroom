  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Full adder"
   },
   "body": {
    "en": "A full adder adds three bits: A, B and the carry-in $C_{in}$ from the previous stage. Its outputs are $S = A\\oplus B\\oplus C_{in}$ and $C_{out} = AB + BC_{in} + AC_{in} = AB + C_{in}(A\\oplus B)$. It can be built from two half adders and one OR gate: the first half adder adds A and B, the second adds its sum to $C_{in}$, and the OR gate combines the two carries."
   },
   "points": [
    {
     "en": "Inputs A, B, Cin; outputs S, Cout"
    },
    {
     "en": "S = A ⊕ B ⊕ Cin"
    },
    {
     "en": "Cout = AB + Cin(A ⊕ B)"
    },
    {
     "en": "Full adder = 2 half adders + 1 OR gate"
    }
   ],
   "narration": {
    "en": "A full adder also takes the carry-in. Its sum is the XOR of all three inputs, and its carry is AB plus Cin times A XOR B.",
    "kn": "ಪೂರ್ಣ ಸಂಕಲಕ ಕ್ಯಾರಿ-ಇನ್ ಅನ್ನೂ ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ. ಮೊತ್ತ ಮೂರೂ ಇನ್‌ಪುಟ್‌ಗಳ XOR; ಕ್ಯಾರಿ AB + Cin(A⊕B)."
   },
   "formula": "S = A\\oplus B\\oplus C_{in}, \\qquad C_{out} = AB + C_{in}(A\\oplus B)"
  },
