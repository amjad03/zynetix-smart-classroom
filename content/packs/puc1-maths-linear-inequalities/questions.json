[
 {
  "id": "1m05-q01",
  "chapterId": "puc1-maths-05-linear-inequalities",
  "topicId": "puc1-maths-05-linear-inequalities.t1",
  "stem": {
   "en": "Which of the following is a slack (non-strict) inequality?"
  },
  "options": [
   {
    "en": "3x + 2 < 7"
   },
   {
    "en": "x ≥ −2"
   },
   {
    "en": "y > 4"
   },
   {
    "en": "5 > 3"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "≤ and ≥ give slack inequalities; < and > give strict ones. 5 > 3 is a numerical inequality."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
