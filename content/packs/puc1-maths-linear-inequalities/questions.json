  "stem": {
   "en": "To 640 litres of an 8% acid solution, x litres of a 2% solution is added so that the mixture is more than 4% but less than 6% acid. Then:"
  },
  "options": [
   {
    "en": "320 < x < 1280"
   },
   {
    "en": "160 < x < 640"
   },
   {
    "en": "320 < x < 640"
   },
   {
    "en": "640 < x < 1280"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Acid = 51.2 + 0.02x in 640 + x litres. 0.04(640 + x) < 51.2 + 0.02x ⇒ x < 1280; 51.2 + 0.02x < 0.06(640 + x) ⇒ x > 320."
  },
  "exams": [
   "KCET",
   "COMEDK",
   "JEE"
  ],
  "difficulty": "hard",
  "tags": []
