{
 "chapterId": "puc1-maths-05-linear-inequalities",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-05-linear-inequalities.t2",
   "name": {
    "en": "Adding a number"
   },
   "tex": "a < b \\Rightarrow a \\pm c < b \\pm c",
   "note": {
    "en": "Sign unchanged"
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-05-linear-inequalities.t2",
   "name": {
    "en": "Multiplying by a positive number"
   },
   "tex": "a < b,\\ c > 0 \\Rightarrow ac < bc,\\ \\tfrac ac < \\tfrac bc"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-05-linear-inequalities.t2",
   "name": {
    "en": "Multiplying by a negative number"
   },
   "tex": "a < b,\\ c < 0 \\Rightarrow ac > bc,\\ \\tfrac ac > \\tfrac bc",
   "note": {
    "en": "The inequality reverses"
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Reciprocals (same sign)"
   },
   "tex": "0 < a < b \\Rightarrow \\tfrac1a > \\tfrac1b"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-05-linear-inequalities.t2",
   "name": {
    "en": "Squaring"
   },
   "tex": "0 \\le a < b \\Rightarrow a^2 < b^2",
   "note": {
    "en": "Not valid if a is negative"
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Interval notation"
   },
   "tex": "(a,b) = \\{a < x < b\\},\\ [a,b] = \\{a \\le x \\le b\\},\\ (a,b] = \\{a < x \\le b\\}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-maths-05-linear-inequalities.t3",
   "name": {
    "en": "System of inequalities"
   },
   "tex": "\\text{solution} = S_1 \\cap S_2 \\cap \\cdots",
   "note": {
    "en": "No common point means no solution"
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Modulus: less than"
   },
   "tex": "|x - a| < r \\iff a - r < x < a + r\\quad (r > 0)"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Modulus: greater than"
   },
   "tex": "|x - a| > r \\iff x < a - r\\ \\text{or}\\ x > a + r"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Triangle inequality"
   },
   "tex": "|x + y| \\le |x| + |y|,\\quad |x - y| \\ge \\big||x| - |y|\\big|"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-05-linear-inequalities.t2",
   "name": {
    "en": "Rational inequality"
   },
   "tex": "\\frac{x - a}{x - b} \\le 0 \\ (a > b) \\iff b < x \\le a",
   "note": {
    "en": "Bring to one side; never cross-multiply by an expression of unknown sign"
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Wavy-curve (sign) method"
   },
   "tex": "\\text{mark critical points; signs alternate across simple roots}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-05-linear-inequalities.t3",
   "name": {
    "en": "Half-plane test"
   },
   "tex": "ax + by < c:\\ \\text{test } (0,0);\\ \\text{true} \\Rightarrow \\text{origin side}",
   "note": {
    "en": "Use another test point if the line passes through the origin"
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-05-linear-inequalities.t3",
   "name": {
    "en": "Boundary line"
   },
   "tex": "\\le, \\ge:\\ \\text{solid line (included)};\\quad <, >:\\ \\text{dashed line (excluded)}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-05-linear-inequalities.t3",
   "name": {
    "en": "Vertical / horizontal lines"
   },
   "tex": "x > a:\\ \\text{right of } x = a;\\quad y < b:\\ \\text{below } y = b"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Feasible region"
   },
   "tex": "\\text{common region of all half-planes; corners from pairwise intersections}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-maths-05-linear-inequalities.t3",
   "name": {
    "en": "Shoelace area"
   },
   "tex": "A = \\tfrac12\\left|\\textstyle\\sum (x_iy_{i+1} - x_{i+1}y_i)\\right|",
   "note": {
    "en": "Area of a polygonal region from its corner points"
   }
  }
 ]
}
