  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Gain set by two resistors",
    "kn": "ಎರಡು ರೋಧಕಗಳಿಂದ ವರ್ಧನೆ"
   },
   "hook": {
    "en": "With an op-amp, the gain no longer depends on the transistors inside. Two resistors decide it, and you can read it straight off their values.",
    "kn": "ಆಪ್-ಆಂಪ್‌ನಲ್ಲಿ ವರ್ಧನೆ ಒಳಗಿನ ಟ್ರಾನ್ಸಿಸ್ಟರ್‌ಗಳ ಮೇಲೆ ಅವಲಂಬಿಸುವುದಿಲ್ಲ. ಎರಡು ರೋಧಕಗಳು ಅದನ್ನು ನಿರ್ಧರಿಸುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "Derive the gain of the inverting amplifier"
    },
    {
     "en": "Derive the gain of the non-inverting amplifier"
    },
    {
     "en": "Explain the voltage follower"
    }
   ],
   "narration": {
    "en": "With an op-amp, the gain no longer depends on the transistors inside. Two resistors decide it, and you can read it straight off their values.",
    "kn": "ಆಪ್-ಆಂಪ್‌ನಲ್ಲಿ ವರ್ಧನೆ ಒಳಗಿನ ಟ್ರಾನ್ಸಿಸ್ಟರ್‌ಗಳ ಮೇಲೆ ಅವಲಂಬಿಸುವುದಿಲ್ಲ. ಎರಡು ರೋಧಕಗಳು ಅದನ್ನು ನಿರ್ಧರಿಸುತ್ತವೆ."
   }
