  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Inverting amplifier"
   },
   "body": {
    "en": "The input $V_i$ is applied through $R_1$ to the inverting terminal; $R_f$ connects the output back to it; the non-inverting terminal is grounded. The inverting terminal is a virtual ground, so the current through $R_1$ is $I = V_i/R_1$. No current enters the op-amp, so the same current flows through $R_f$: $I = (0 - V_o)/R_f$. Equating, $A_v = V_o/V_i = -R_f/R_1$. The output is 180° out of phase and the input resistance is $R_1$."
   },
   "points": [
    {
     "en": "Av = −Rf/R1"
    },
    {
     "en": "Output inverted (180°)"
    },
    {
     "en": "Input resistance = R1"
    },
    {
     "en": "If Rf = R1: sign changer"
    }
   ],
   "narration": {
    "en": "For the inverting amplifier the gain is minus Rf over R1. The output is inverted, and the input resistance is R1.",
    "kn": "ಇನ್ವರ್ಟಿಂಗ್ ವರ್ಧಕದ ವರ್ಧನೆ Av = −Rf/R1. ಔಟ್‌ಪುಟ್ 180° ತಿರುಗಿರುತ್ತದೆ; ಇನ್‌ಪುಟ್ ರೋಧ R1."
   },
   "formula": "A_v = \\frac{V_o}{V_i} = -\\frac{R_f}{R_1}"
  },
