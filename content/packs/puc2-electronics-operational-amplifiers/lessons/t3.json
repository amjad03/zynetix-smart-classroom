   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "R1 = 10 kΩ, Rf = 100 kΩ and Vi = 0.5 V. Find the output as (a) an inverting amplifier, (b) a non-inverting amplifier."
   },
   "steps": [
    {
     "en": "(a) Av = −100/10 = −10, so Vo = −10 × 0.5 = −5 V."
    },
    {
     "en": "(b) Av = 1 + 100/10 = 11, so Vo = 11 × 0.5 = 5.5 V."
    }
   ],
   "answer": {
    "en": "(a) −5 V, (b) +5.5 V"
   },
