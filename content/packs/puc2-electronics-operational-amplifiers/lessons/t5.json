  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "An integrator has R = 10 kΩ and C = 1 µF. A steady +1 V is applied at t = 0 with the output at 0 V. Find Vo after 50 ms, and when it saturates (Vsat = ±13 V)."
   },
   "steps": [
    {
     "en": "RC = 10⁴ × 10⁻⁶ = 0.01 s = 10 ms."
    },
    {
     "en": "Slope = −Vi/RC = −1/0.01 = −100 V/s."
    },
    {
     "en": "After 50 ms: Vo = −100 × 0.05 = −5 V."
    },
    {
     "en": "It reaches −13 V at t = 13/100 = 0.13 s = 130 ms."
    }
   ],
   "answer": {
    "en": "−5 V; saturates after 130 ms"
   },
   "narration": {
    "en": "Let us work this out together. An integrator has R = 10 kΩ and C = 1 µF. A steady +1 V is applied at t = 0 with the output at 0 V. Find Vo after 50 ms, and when it saturates (Vsat = ±13 V)."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "A differentiator has R = 10 kΩ and C = 0.1 µF. Find the output amplitude for a 1 V peak, 1 kHz sine input."
   },
   "steps": [
    {
     "en": "RC = 10⁴ × 10⁻⁷ = 10⁻³ s."
    },
    {
     "en": "Vo = −RC × d(sin 2πft)/dt has amplitude 2πf RC Vm."
    },
    {
     "en": "Amplitude = 2π × 1000 × 10⁻³ × 1 = 6.28 V (a negative cosine)."
    }
   ],
   "answer": {
    "en": "About 6.28 V peak"
   },
   "narration": {
    "en": "Let us work this out together. A differentiator has R = 10 kΩ and C = 0.1 µF. Find the output amplitude for a 1 V peak, 1 kHz sine input."
   }
