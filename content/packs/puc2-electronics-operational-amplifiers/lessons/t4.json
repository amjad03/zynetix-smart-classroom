  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "An op-amp that does arithmetic",
    "kn": "ಅಂಕಗಣಿತ ಮಾಡುವ ಆಪ್-ಆಂಪ್"
   },
   "hook": {
    "en": "An audio mixer adds the signals of several microphones into one. Inside is an op-amp summing amplifier. The name operational amplifier comes from exactly these mathematical operations.",
    "kn": "ಆಡಿಯೋ ಮಿಕ್ಸರ್ ಹಲವು ಮೈಕ್ರೋಫೋನ್‌ಗಳ ಸಂಕೇತಗಳನ್ನು ಕೂಡಿಸುತ್ತದೆ. ಅದರೊಳಗೆ ಆಪ್-ಆಂಪ್ ಸಮ್ಮಿಂಗ್ ವರ್ಧಕವಿದೆ. ಕಾರ್ಯಾತ್ಮಕ ವರ್ಧಕ ಎಂಬ ಹೆಸರು ಈ ಗಣಿತ ಕ್ರಿಯೆಗಳಿಂದಲೇ ಬಂದಿದೆ."
   },
   "objectives": [
    {
     "en": "Derive the output of an inverting summing amplifier"
    },
    {
     "en": "Use it as a scaling adder and averager"
    },
    {
     "en": "Find the output of a subtractor"
    }
   ],
   "narration": {
    "en": "An audio mixer adds the signals of several microphones into one. Inside is an op-amp summing amplifier. The name operational amplifier comes from exactly these mathematical operations.",
    "kn": "ಆಡಿಯೋ ಮಿಕ್ಸರ್ ಹಲವು ಮೈಕ್ರೋಫೋನ್‌ಗಳ ಸಂಕೇತಗಳನ್ನು ಕೂಡಿಸುತ್ತದೆ. ಅದರೊಳಗೆ ಆಪ್-ಆಂಪ್ ಸಮ್ಮಿಂಗ್ ವರ್ಧಕವಿದೆ. ಕಾರ್ಯಾತ್ಮಕ ವರ್ಧಕ ಎಂಬ ಹೆಸರು ಈ ಗಣಿತ ಕ್ರಿಯೆಗಳಿಂದಲೇ ಬಂದಿದೆ."
   }
