  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A summing amplifier has Rf = 100 kΩ, R1 = 10 kΩ, R2 = 20 kΩ, R3 = 50 kΩ, with V1 = 0.2 V, V2 = 0.5 V and V3 = 1 V. Find Vo."
   },
   "steps": [
    {
     "en": "Vo = −(Rf/R1 V1 + Rf/R2 V2 + Rf/R3 V3)."
    },
    {
