  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Python already has names for errors",
    "kn": "ದೋಷಗಳಿಗೆ ಪೈಥಾನ್‌ನಲ್ಲೇ ಹೆಸರುಗಳಿವೆ"
   },
   "hook": {
    "en": "ValueError, TypeError, IndexError: Python names the common errors for you. Knowing the name tells you exactly what went wrong.",
    "kn": "ValueError, TypeError, IndexError: ಸಾಮಾನ್ಯ ದೋಷಗಳಿಗೆ ಪೈಥಾನ್ ಹೆಸರು ಕೊಟ್ಟಿದೆ. ಹೆಸರು ತಿಳಿದರೆ ಏನು ತಪ್ಪಾಯಿತು ಎಂಬುದು ಗೊತ್ತಾಗುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Name the common built-in exceptions"
    },
    {
     "en": "Match a situation to its exception"
    },
    {
     "en": "Read a traceback"
    }
   ],
   "narration": {
    "en": "ValueError, TypeError, IndexError: Python names the common errors for you. Knowing the name tells you exactly what went wrong.",
    "kn": "ValueError, TypeError, IndexError: ಸಾಮಾನ್ಯ ದೋಷಗಳಿಗೆ ಪೈಥಾನ್ ಹೆಸರು ಕೊಟ್ಟಿದೆ. ಹೆಸರು ತಿಳಿದರೆ ಏನು ತಪ್ಪಾಯಿತು ಎಂಬುದು ಗೊತ್ತಾಗುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Commonly occurring built-in exceptions"
   },
   "body": {
    "en": "Python’s standard library defines built-in exceptions for the commonly occurring errors. When one occurs, Python shows its name and a description, so the programmer can find the cause and take action."
   },
   "points": [
    {
     "en": "SyntaxError: error in the syntax of the code"
    },
    {
     "en": "ValueError: right data type but inappropriate value, e.g. int(\"abc\")"
    },
    {
     "en": "IOError: the file cannot be opened"
    },
    {
     "en": "KeyboardInterrupt: the user presses the interrupt key (Ctrl+C)"
    },
    {
     "en": "ImportError: the module definition is not found"
    },
    {
     "en": "EOFError: end of file reached by input() without reading data"
    },
    {
     "en": "ZeroDivisionError: denominator is zero"
    },
    {
     "en": "IndexError: index out of range"
    },
    {
     "en": "NameError: a name (variable) is not defined"
    },
    {
     "en": "IndentationError: incorrect indentation"
    },
    {
     "en": "TypeError: operation on an inappropriate type"
    },
    {
     "en": "OverflowError: result exceeds the maximum limit of a numeric type"
    }
   ],
   "narration": {
    "en": "Python’s standard library defines built-in exceptions for the commonly occurring errors. When one occurs, Python shows its name and a description, so the programmer can find the cause and take action.",
    "kn": "ಸಾಮಾನ್ಯವಾಗಿ ಆಗುವ ದೋಷಗಳಿಗೆ ಪೈಥಾನ್ ಅಂತರ್ನಿರ್ಮಿತ ವಿನಾಯಿತಿಗಳನ್ನು ಹೊಂದಿದೆ. ದೋಷದ ಹೆಸರು ಮತ್ತು ವಿವರಣೆ ನೋಡಿ ಕಾರಣ ಕಂಡುಹಿಡಿಯಬಹುದು."
   }
  },
