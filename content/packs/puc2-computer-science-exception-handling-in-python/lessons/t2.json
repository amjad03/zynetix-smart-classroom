  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Name the exception raised by each expression: int('abc'), '5' + 5, [1, 2][5], undefined_var, 10 / 0"
   },
   "steps": [
    {
     "en": "int('abc') → ValueError (right type, wrong value)"
    },
    {
     "en": "'5' + 5 → TypeError (str and int cannot be added)"
    },
    {
     "en": "[1, 2][5] → IndexError (index 5 is out of range)"
    },
    {
     "en": "undefined_var → NameError (name not defined)"
    },
    {
     "en": "10 / 0 → ZeroDivisionError"
    }
   ],
   "answer": {
    "en": "ValueError, TypeError, IndexError, NameError, ZeroDivisionError"
   },
   "narration": {
    "en": "Five small expressions, five different built-in exceptions. Name each one before I reveal it."
   }
  },
  {
   "id": "trick",
   "type": "trick",
   "heading": {
    "en": "Value or Type?"
   },
   "body": {
    "en": "If the data type is right but the value makes no sense, it is ValueError (int(\"abc\")). If the type itself is wrong for the operation, it is TypeError (\"5\" + 5)."
   },
   "narration": {
    "en": "Value or Type?. If the data type is right but the value makes no sense, it is ValueError (int(\"abc\")). If the type itself is wrong for the operation, it is TypeError (\"5\" + 5)."
   },
   "optional": true,
   "seconds": 90,
   "mnemonic": {
    "en": "Right type, wrong value → ValueError; wrong type → TypeError"
   }
  },
