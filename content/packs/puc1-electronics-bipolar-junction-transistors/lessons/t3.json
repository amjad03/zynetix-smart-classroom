 "title": {
  "en": "Transistor configurations: CB, CE and CC",
  "kn": "ಟ್ರಾನ್ಸಿಸ್ಟರ್ ಸಂರಚನೆಗಳು: ಸಿಬಿ, ಸಿಇ ಮತ್ತು ಸಿಸಿ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Three ways to connect three legs",
    "kn": "ಮೂರು ಕಾಲುಗಳನ್ನು ಜೋಡಿಸುವ ಮೂರು ವಿಧಾನಗಳು"
   },
   "hook": {
    "en": "A transistor has three terminals but a circuit needs two for input and two for output. So one terminal must be shared: which one you share decides how the amplifier behaves.",
    "kn": "ಟ್ರಾನ್ಸಿಸ್ಟರ್‌ಗೆ ಮೂರು ಟರ್ಮಿನಲ್‌ಗಳಿವೆ, ಆದರೆ ಇನ್‌ಪುಟ್‌ಗೆ ಎರಡು ಮತ್ತು ಔಟ್‌ಪುಟ್‌ಗೆ ಎರಡು ಬೇಕು. ಆದ್ದರಿಂದ ಒಂದು ಟರ್ಮಿನಲ್ ಸಾಮಾನ್ಯವಾಗಿರಬೇಕು."
   },
   "objectives": [
    {
     "en": "Identify CB, CE and CC configurations"
    },
    {
     "en": "Compare their gains, impedances and phase"
    }
   ],
   "narration": {
    "en": "A transistor has three terminals but a circuit needs two for input and two for output. So one terminal must be shared: which one you share decides how the amplifier behaves.",
    "kn": "ಟ್ರಾನ್ಸಿಸ್ಟರ್‌ಗೆ ಮೂರು ಟರ್ಮಿನಲ್‌ಗಳಿವೆ, ಆದರೆ ಇನ್‌ಪುಟ್‌ಗೆ ಎರಡು ಮತ್ತು ಔಟ್‌ಪುಟ್‌ಗೆ ಎರಡು ಬೇಕು. ಆದ್ದರಿಂದ ಒಂದು ಟರ್ಮಿನಲ್ ಸಾಮಾನ್ಯವಾಗಿರಬೇಕು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The three configurations"
   },
   "body": {
    "en": "In common base (CB) the input is between emitter and base and the output between collector and base. In common emitter (CE) the input is between base and emitter and the output between collector and emitter. In common collector (CC) the input is between base and collector and the output is taken across the emitter."
   },
   "points": [
    {
     "en": "CB: input at emitter, output at collector; current gain α < 1"
    },
    {
     "en": "CE: input at base, output at collector; current gain β"
    },
    {
     "en": "CC: input at base, output at emitter; current gain γ = 1 + β"
    }
   ],
   "narration": {
    "en": "The terminal common to input and output names the configuration: common base, common emitter or common collector.",
    "kn": "ಇನ್‌ಪುಟ್ ಮತ್ತು ಔಟ್‌ಪುಟ್‌ಗೆ ಸಾಮಾನ್ಯವಾಗಿರುವ ಟರ್ಮಿನಲ್ ಸಂರಚನೆಯ ಹೆಸರನ್ನು ನೀಡುತ್ತದೆ: ಸಾಮಾನ್ಯ ಬೇಸ್, ಸಾಮಾನ್ಯ ಎಮಿಟರ್ ಅಥವಾ ಸಾಮಾನ್ಯ ಕಲೆಕ್ಟರ್."
   },
   "formula": "\\gamma = \\frac{I_E}{I_B} = 1 + \\beta"
  },
