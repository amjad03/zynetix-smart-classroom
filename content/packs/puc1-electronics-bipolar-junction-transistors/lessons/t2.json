  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Current relations"
   },
   "body": {
    "en": "By Kirchhoff's current law the emitter current divides into base and collector currents: $I_E = I_B + I_C$. The common-base current gain is $\\alpha = I_C/I_E$ (slightly less than 1, typically 0.95–0.995). The common-emitter current gain is $\\beta = I_C/I_B$ (typically 20–300). They are related by $\\beta = \\alpha/(1-\\alpha)$ and $\\alpha = \\beta/(1+\\beta)$."
   },
   "points": [
    {
     "en": "I_E = I_B + I_C"
    },
    {
     "en": "α = I_C / I_E < 1"
    },
    {
     "en": "β = I_C / I_B ≫ 1"
    },
    {
     "en": "β = α/(1 − α)"
    }
   ],
   "narration": {
    "en": "The emitter current equals base current plus collector current. Alpha is collector current over emitter current, beta is collector current over base current, and beta equals alpha over one minus alpha.",
    "kn": "ಎಮಿಟರ್ ಪ್ರವಾಹ = ಬೇಸ್ ಪ್ರವಾಹ + ಕಲೆಕ್ಟರ್ ಪ್ರವಾಹ. ಆಲ್ಫಾ = Ic/Ie, ಬೀಟಾ = Ic/Ib, ಮತ್ತು ಬೀಟಾ = ಆಲ್ಫಾ/(1 − ಆಲ್ಫಾ)."
   },
