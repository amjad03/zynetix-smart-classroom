 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "A device that changed the world",
    "kn": "ಜಗತ್ತನ್ನೇ ಬದಲಿಸಿದ ಸಾಧನ"
   },
   "hook": {
    "en": "In 1947 three scientists at Bell Labs built a tiny device that replaced the bulky vacuum tube. Today a phone chip holds billions of them.",
    "kn": "1947ರಲ್ಲಿ ಬೆಲ್ ಲ್ಯಾಬ್ಸ್‌ನ ಮೂವರು ವಿಜ್ಞಾನಿಗಳು ದೊಡ್ಡ ನಿರ್ವಾತ ನಳಿಕೆಯ ಬದಲಿಗೆ ಒಂದು ಸಣ್ಣ ಸಾಧನವನ್ನು ತಯಾರಿಸಿದರು. ಇಂದು ಒಂದು ಫೋನ್ ಚಿಪ್‌ನಲ್ಲಿ ಅಂತಹ ಕೋಟಿಗಟ್ಟಲೆ ಸಾಧನಗಳಿವೆ."
   },
   "objectives": [
    {
     "en": "Describe the three regions of a BJT and their doping"
    },
    {
     "en": "Draw the symbols of NPN and PNP transistors"
    }
   ],
   "narration": {
    "en": "In 1947 three scientists at Bell Labs built a tiny device that replaced the bulky vacuum tube. Today a phone chip holds billions of them.",
    "kn": "1947ರಲ್ಲಿ ಬೆಲ್ ಲ್ಯಾಬ್ಸ್‌ನ ಮೂವರು ವಿಜ್ಞಾನಿಗಳು ದೊಡ್ಡ ನಿರ್ವಾತ ನಳಿಕೆಯ ಬದಲಿಗೆ ಒಂದು ಸಣ್ಣ ಸಾಧನವನ್ನು ತಯಾರಿಸಿದರು. ಇಂದು ಒಂದು ಫೋನ್ ಚಿಪ್‌ನಲ್ಲಿ ಅಂತಹ ಕೋಟಿಗಟ್ಟಲೆ ಸಾಧನಗಳಿವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Three layers, two junctions"
   },
   "body": {
    "en": "A bipolar junction transistor (BJT) is a three-layer semiconductor device: a thin base sandwiched between an emitter and a collector. In an NPN transistor a P-type base lies between N-type emitter and collector; in a PNP transistor an N-type base lies between P-type regions. It is called bipolar because both electrons and holes take part in conduction."
   },
   "points": [
    {
     "en": "Emitter: heavily doped, medium size, supplies carriers"
    },
    {
     "en": "Base: very thin (a few micrometres) and lightly doped"
    },
    {
     "en": "Collector: moderately doped and largest, collects carriers and dissipates heat"
    },
    {
     "en": "Two junctions: emitter–base (J_E) and collector–base (J_C)"
    }
   ],
   "narration": {
    "en": "A BJT has three layers, emitter, base and collector, and two junctions. The emitter is heavily doped, the base is thin and lightly doped, and the collector is the largest.",
    "kn": "ಬಿಜೆಟಿಯಲ್ಲಿ ಎಮಿಟರ್, ಬೇಸ್ ಮತ್ತು ಕಲೆಕ್ಟರ್ ಎಂಬ ಮೂರು ಪದರಗಳು ಮತ್ತು ಎರಡು ಸಂಧಿಗಳಿವೆ. ಎಮಿಟರ್ ಹೆಚ್ಚು ಡೋಪ್ ಆಗಿದೆ, ಬೇಸ್ ತೆಳುವಾಗಿದ್ದು ಕಡಿಮೆ ಡೋಪ್ ಆಗಿದೆ, ಕಲೆಕ್ಟರ್ ಅತ್ಯಂತ ದೊಡ್ಡದು."
   }
  },
