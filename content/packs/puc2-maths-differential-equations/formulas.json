{
 "chapterId": "puc2-maths-09-differential-equations",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Order"
   },
   "tex": "\\text{order} = \\text{highest derivative present}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-maths-09-differential-equations.t1",
   "name": {
    "en": "Degree"
   },
   "tex": "\\text{degree} = \\text{power of the highest derivative}",
   "note": {
    "en": "Only after the equation is a polynomial in derivatives (clear radicals / fractional powers). Undefined if derivatives sit inside sin, e^, ln, etc."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-09-differential-equations.t2",
   "name": {
    "en": "Arbitrary constants"
   },
   "tex": "n\\ \\text{constants} \\Rightarrow \\text{DE of order}\\ n",
   "note": {
    "en": "General solution of an order-n DE has n constants; a particular solution has none."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-09-differential-equations.t3",
   "name": {
    "en": "Variables separable"
   },
   "tex": "\\frac{dy}{dx} = f(x)g(y) \\Rightarrow \\int\\frac{dy}{g(y)} = \\int f(x)\\,dx + C"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-maths-09-differential-equations.t4",
   "name": {
    "en": "Reducible by substitution"
   },
   "tex": "\\frac{dy}{dx} = f(ax + by + c):\\quad v = ax + by + c,\\ v' = a + b\\,f(v)"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-09-differential-equations.t4",
   "name": {
    "en": "Homogeneous test"
   },
   "tex": "F(\\lambda x, \\lambda y) = F(x, y) \\iff \\frac{dy}{dx} = g\\left(\\frac yx\\right)"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-09-differential-equations.t4",
   "name": {
    "en": "Homogeneous: solving"
   },
   "tex": "y = vx,\\quad \\frac{dy}{dx} = v + x\\frac{dv}{dx}",
   "note": {
    "en": "For $\\frac{dx}{dy} = h\\left(\\frac xy\\right)$ use $x = vy$."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-09-differential-equations.t5",
   "name": {
    "en": "Linear first order"
   },
   "tex": "\\frac{dy}{dx} + P(x)y = Q(x),\\quad \\text{IF} = e^{\\int P\\,dx}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-maths-09-differential-equations.t2",
   "name": {
    "en": "Linear: solution"
   },
   "tex": "y\\cdot\\text{IF} = \\int Q\\cdot\\text{IF}\\,dx + C"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-09-differential-equations.t5",
   "name": {
    "en": "Linear in x"
   },
   "tex": "\\frac{dx}{dy} + P_1(y)x = Q_1(y),\\quad \\text{IF} = e^{\\int P_1dy}"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Bernoulli"
   },
   "tex": "\\frac{dy}{dx} + Py = Qy^n:\\quad z = y^{1 - n} \\Rightarrow \\frac{dz}{dx} + (1 - n)Pz = (1 - n)Q"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Exact differentials"
   },
   "tex": "x\\,dy + y\\,dx = d(xy),\\ \\frac{x\\,dy - y\\,dx}{x^2} = d\\left(\\frac yx\\right),\\ \\frac{x\\,dy - y\\,dx}{x^2 + y^2} = d\\left(\\tan^{-1}\\frac yx\\right)"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-09-differential-equations.t5",
   "name": {
    "en": "More exact forms"
   },
   "tex": "\\frac{x\\,dx + y\\,dy}{x^2 + y^2} = \\frac12 d\\ln(x^2 + y^2),\\quad \\frac{y\\,dx - x\\,dy}{y^2} = d\\left(\\frac xy\\right)"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-maths-09-differential-equations.t3",
   "name": {
    "en": "Growth / decay"
   },
   "tex": "\\frac{dN}{dt} = kN \\Rightarrow N = N_0e^{kt}",
   "note": {
    "en": "Half-life $T = \\frac{\\ln 2}{\\lambda}$; $N = N_0\\left(\\frac12\\right)^{t/T}$."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-09-differential-equations.t3",
   "name": {
    "en": "Newton's law of cooling"
   },
   "tex": "\\frac{dT}{dt} = -k(T - T_s) \\Rightarrow T - T_s = (T_0 - T_s)e^{-kt}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Tangent and normal facts"
   },
   "tex": "\\text{tangent: } Y - y = y'(X - x),\\quad y\\text{-intercept} = y - xy'",
   "note": {
    "en": "Normal: $(X - x) + y'(Y - y) = 0$; normal through origin ⇒ $x + yy' = 0$."
   }
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Second-order constant coefficients (forming DEs)"
   },
   "tex": "y = c_1e^{m_1x} + c_2e^{m_2x} \\Rightarrow y'' - (m_1 + m_2)y' + m_1m_2y = 0",
   "note": {
    "en": "$y = A\\cos kx + B\\sin kx \\Rightarrow y'' + k^2y = 0$."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-maths-09-differential-equations.t5",
   "name": {
    "en": "Clairaut form"
   },
   "tex": "y = xy' + f(y') \\Rightarrow y = cx + f(c)"
  }
 ]
}
