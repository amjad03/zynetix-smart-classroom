 "title": {
  "en": "Optoelectronic diodes: LED and photodiode",
  "kn": "ದೃಗ್-ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಡಯೋಡ್‌ಗಳು: LED ಮತ್ತು ಫೋಟೋಡಯೋಡ್"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Diodes that talk to light",
    "kn": "ಬೆಳಕಿನೊಂದಿಗೆ ಮಾತನಾಡುವ ಡಯೋಡ್‌ಗಳು"
   },
   "hook": {
    "en": "The TV remote flashes an infrared LED; the TV catches the flashes with a photodiode. One diode turns current into light, the other turns light into current.",
    "kn": "ಟಿವಿ ರಿಮೋಟ್ ಇನ್‌ಫ್ರಾರೆಡ್ LED ಮಿನುಗಿಸುತ್ತದೆ; ಟಿವಿ ಆ ಮಿನುಗನ್ನು ಫೋಟೋಡಯೋಡ್‌ನಿಂದ ಹಿಡಿಯುತ್ತದೆ. ಒಂದು ಡಯೋಡ್ ಪ್ರವಾಹವನ್ನು ಬೆಳಕಾಗಿ, ಇನ್ನೊಂದು ಬೆಳಕನ್ನು ಪ್ರವಾಹವಾಗಿ ಬದಲಿಸುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Explain the working of an LED and the choice of materials"
    },
    {
     "en": "Find the series resistor for an LED"
    },
    {
     "en": "Explain the working of a photodiode"
    }
   ],
   "narration": {
    "en": "The TV remote flashes an infrared LED; the TV catches the flashes with a photodiode. One diode turns current into light, the other turns light into current.",
    "kn": "ಟಿವಿ ರಿಮೋಟ್ ಇನ್‌ಫ್ರಾರೆಡ್ LED ಮಿನುಗಿಸುತ್ತದೆ; ಟಿವಿ ಆ ಮಿನುಗನ್ನು ಫೋಟೋಡಯೋಡ್‌ನಿಂದ ಹಿಡಿಯುತ್ತದೆ. ಒಂದು ಡಯೋಡ್ ಪ್ರವಾಹವನ್ನು ಬೆಳಕಾಗಿ, ಇನ್ನೊಂದು ಬೆಳಕನ್ನು ಪ್ರವಾಹವಾಗಿ ಬದಲಿಸುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Light emitting diode (LED)"
   },
   "body": {
    "en": "An LED is a forward-biased p-n junction made of a compound semiconductor. Electrons recombine with holes at the junction, and the energy (about E_g) comes out as light of wavelength $\\lambda \\approx 1240/E_g$ nm (E_g in eV). The colour depends on the material: GaAs gives infrared, GaAsP red to yellow, GaP green, and GaN/InGaN blue. LEDs have a forward drop of about 1.8–3.5 V, need a series resistor to limit current, and offer low power, long life and fast switching."
   },
   "points": [
    {
     "en": "Forward biased; recombination gives light"
    },
    {
     "en": "Colour set by the band gap of the material"
    },
    {
     "en": "Series resistor R = (V_S − V_F)/I_F"
    }
   ],
   "narration": {
    "en": "An LED is forward biased. Electrons and holes recombine and give out light whose colour depends on the band gap. Always use a series resistor.",
    "kn": "LED ಮುಮ್ಮುಖ ಬಯಾಸ್‌ನಲ್ಲಿರುತ್ತದೆ. ಎಲೆಕ್ಟ್ರಾನ್ ಮತ್ತು ರಂಧ್ರಗಳು ಪುನರ್ಸಂಯೋಜನೆಗೊಂಡು ಬೆಳಕು ನೀಡುತ್ತವೆ; ಬಣ್ಣ ಶಕ್ತಿ ಅಂತರವನ್ನು ಅವಲಂಬಿಸಿದೆ. ಸರಣಿ ರೋಧಕ ಯಾವಾಗಲೂ ಬಳಸಿ."
   },
   "formula": "R = \\frac{V_S - V_F}{I_F}"
  },
