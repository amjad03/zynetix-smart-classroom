{
 "chapterId": "puc2-physics-01-electric-charges-and-fields",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t2",
   "name": {
    "en": "Coulomb's law"
   },
   "tex": "F = \\frac{1}{4\\pi\\varepsilon_0}\\frac{q_1q_2}{r^2}",
   "note": {
    "en": "k = 9 × 10⁹ N m² C⁻²."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t3",
   "name": {
    "en": "Field and potential of point charge"
   },
   "tex": "E = \\frac{kq}{r^2},\\quad V = \\frac{kq}{r}",
   "note": {
    "en": "E = −dV/dr."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Gauss's law"
   },
   "tex": "\\oint\\vec E\\cdot d\\vec A = \\frac{q_{enc}}{\\varepsilon_0}",
   "note": {
    "en": "Use with symmetry."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Infinite sheet"
   },
   "tex": "E = \\frac{\\sigma}{2\\varepsilon_0}",
   "note": {
    "en": "Conductor surface: σ/ε₀."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Dipole on axis"
   },
   "tex": "E = \\frac{2kp}{r^3}",
   "note": {
    "en": "Equatorial: kp/r³."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Parallel-plate capacitor"
   },
   "tex": "C = \\frac{K\\varepsilon_0A}{d}",
   "note": {
    "en": "K = 1 for vacuum."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Energy in capacitor"
   },
   "tex": "U = \\tfrac12CV^2 = \\frac{Q^2}{2C}",
   "note": {
    "en": "Energy density ½ε₀E²."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Combination"
   },
   "tex": "C_{par} = \\sum C_i,\\quad \\frac{1}{C_{ser}} = \\sum\\frac{1}{C_i}",
   "note": {
    "en": "Opposite of resistors."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t1",
   "name": {
    "en": "Quantisation of charge"
   },
   "tex": "q = ne,\\quad e = 1.6\\times10^{-19}\\ \\text{C}",
   "note": {
    "en": "n is an integer; charge is also conserved and additive."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t2",
   "name": {
    "en": "Coulomb's law"
   },
   "tex": "F = \\dfrac{1}{4\\pi\\varepsilon_0}\\dfrac{q_1q_2}{r^2},\\quad \\dfrac{1}{4\\pi\\varepsilon_0} = 9\\times10^9\\ \\text{N m}^2\\text{C}^{-2}",
   "note": {
    "en": "\\varepsilon_0 = 8.85\\times10^{-12}\\ \\text{C}^2\\text{N}^{-1}\\text{m}^{-2}"
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t2",
   "name": {
    "en": "Force in a medium"
   },
   "tex": "F_{\\text{medium}} = \\dfrac{F_{\\text{vacuum}}}{K},\\quad K = \\varepsilon_r = \\varepsilon/\\varepsilon_0"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t2",
   "name": {
    "en": "Vector form / superposition"
   },
   "tex": "\\vec F_1 = \\sum_j \\dfrac{kq_1q_j}{r_{1j}^2}\\,\\hat r_{j1}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t3",
   "name": {
    "en": "Field of a point charge"
   },
   "tex": "\\vec E = \\dfrac{\\vec F}{q_0} = \\dfrac{kq}{r^2}\\hat r"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t2",
   "name": {
    "en": "Null point of two like charges"
   },
   "tex": "\\dfrac{x}{d - x} = \\sqrt{\\dfrac{q_1}{q_2}}",
   "note": {
    "en": "Between the charges, nearer the smaller one; for unlike charges it lies outside, beyond the smaller."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Dipole moment"
   },
   "tex": "\\vec p = q(2\\vec a),\\ \\text{from } -q \\text{ to } +q"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Dipole field: axial and equatorial"
   },
   "tex": "E_{\\text{axial}} = \\dfrac{2kp}{r^3},\\qquad E_{\\text{eq}} = \\dfrac{kp}{r^3}\\ (\\text{opposite to }\\vec p)",
   "note": {
    "en": "For r ≫ a."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Dipole in a uniform field"
   },
   "tex": "\\vec\\tau = \\vec p\\times\\vec E,\\quad U = -\\vec p\\cdot\\vec E,\\quad W_{\\theta_1\\to\\theta_2} = pE(\\cos\\theta_1 - \\cos\\theta_2)",
   "note": {
    "en": "Net force zero; stable at θ = 0, unstable at θ = 180°."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Dipole in a non-uniform field"
   },
   "tex": "F = p\\,\\dfrac{dE}{dr}\\ (\\vec p\\parallel\\vec E)",
   "note": {
    "en": "Moves toward the stronger field when aligned."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Charge densities"
   },
   "tex": "\\lambda = \\dfrac{dq}{dl},\\quad \\sigma = \\dfrac{dq}{dA},\\quad \\rho = \\dfrac{dq}{dV}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Electric flux"
   },
   "tex": "\\Phi = \\oint\\vec E\\cdot d\\vec A = EA\\cos\\theta"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Gauss's law"
   },
   "tex": "\\oint\\vec E\\cdot d\\vec A = \\dfrac{q_{\\text{enc}}}{\\varepsilon_0}",
   "note": {
    "en": "Charges outside add zero net flux, but they do affect E."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Charge at centre / corner of a cube"
   },
   "tex": "\\Phi_{\\text{face}} = \\dfrac{q}{6\\varepsilon_0}\\ (\\text{centre}),\\qquad \\Phi_{\\text{cube}} = \\dfrac{q}{8\\varepsilon_0}\\ (\\text{corner})"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Infinite line charge"
   },
   "tex": "E = \\dfrac{\\lambda}{2\\pi\\varepsilon_0 r}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Infinite plane sheet"
   },
   "tex": "E = \\dfrac{\\sigma}{2\\varepsilon_0}",
   "note": {
    "en": "Two sheets ±σ: σ/ε₀ between, 0 outside."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t5",
   "name": {
    "en": "Thin spherical shell"
   },
   "tex": "E = \\dfrac{kQ}{r^2}\\ (r\\ge R),\\qquad E = 0\\ (r<R)"
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t1",
   "name": {
    "en": "Uniformly charged solid sphere"
   },
   "tex": "E = \\dfrac{kQr}{R^3} = \\dfrac{\\rho r}{3\\varepsilon_0}\\ (r\\le R),\\qquad E = \\dfrac{kQ}{r^2}\\ (r\\ge R)"
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Ring on its axis"
   },
   "tex": "E = \\dfrac{kQx}{(R^2+x^2)^{3/2}},\\quad E_{\\max}\\ \\text{at}\\ x = \\dfrac{R}{\\sqrt2}"
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t3",
   "name": {
    "en": "Finite rod, point on its line"
   },
   "tex": "E = \\dfrac{kQ}{d(d+L)}",
   "note": {
    "en": "d = distance from the nearer end."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t1",
   "name": {
    "en": "Field near a conductor"
   },
   "tex": "E = \\dfrac{\\sigma}{\\varepsilon_0}\\ \\text{(normal to surface)},\\quad E_{\\text{inside}} = 0"
  },
  {
   "id": "zs-f30",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t4",
   "name": {
    "en": "Charge in a uniform field"
   },
   "tex": "a = \\dfrac{qE}{m},\\quad y = \\dfrac{qEL^2}{2mv^2}\\ \\text{(deflection between plates)}"
  },
  {
   "id": "zs-f31",
   "topicId": "puc2-physics-01-electric-charges-and-fields.t1",
   "name": {
    "en": "Hanging charged balls"
   },
   "tex": "\\tan\\theta = \\dfrac{F_e}{mg},\\quad x^3 = \\dfrac{q^2L}{2\\pi\\varepsilon_0mg}\\ (\\text{small }\\theta)",
   "note": {
    "en": "In a liquid the angle is unchanged if K = ρ/(ρ − σ)."
   }
  }
 ]
}
