{
 "chapterId": "puc1-physics-10-thermal-properties-of-matter",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t1",
   "name": {
    "en": "Temperature scales"
   },
   "tex": "\\dfrac{C}{100} = \\dfrac{F - 32}{180} = \\dfrac{K - 273.15}{100}",
   "note": {
    "en": "C = F at −40."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t1",
   "name": {
    "en": "General linear scale"
   },
   "tex": "\\dfrac{X - X_{\\text{ice}}}{X_{\\text{steam}} - X_{\\text{ice}}} = \\dfrac{C}{100}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t2",
   "name": {
    "en": "Linear, area, volume expansion"
   },
   "tex": "\\Delta L = L\\alpha\\Delta T,\\ \\ \\Delta A = A\\beta\\Delta T,\\ \\ \\Delta V = V\\gamma\\Delta T"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Relation between coefficients"
   },
   "tex": "\\beta = 2\\alpha,\\qquad \\gamma = 3\\alpha"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t2",
   "name": {
    "en": "Apparent expansion of a liquid"
   },
   "tex": "\\gamma_{\\text{app}} = \\gamma_{\\text{liquid}} - \\gamma_{\\text{vessel}}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t1",
   "name": {
    "en": "Density change"
   },
   "tex": "\\rho' = \\dfrac{\\rho}{1 + \\gamma\\Delta T} \\approx \\rho(1 - \\gamma\\Delta T)"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t1",
   "name": {
    "en": "Pendulum clock error"
   },
   "tex": "\\Delta t = \\tfrac12\\alpha\\,\\Delta\\theta\\times86\\,400\\ \\text{s per day}",
   "note": {
    "en": "Loses time when hotter, gains when colder."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t5",
   "name": {
    "en": "Constant length difference"
   },
   "tex": "L_1\\alpha_1 = L_2\\alpha_2"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t2",
   "name": {
    "en": "Anomalous expansion of water"
   },
   "tex": "\\rho_{\\max}\\ \\text{at}\\ 4\\,^\\circ\\text{C}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t3",
   "name": {
    "en": "Heat and specific heat"
   },
   "tex": "Q = mc\\Delta T,\\qquad C = mc",
   "note": {
    "en": "c(water) = 4186 J kg⁻¹ K⁻¹ ≈ 1 cal g⁻¹ °C⁻¹."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t4",
   "name": {
    "en": "Latent heat"
   },
   "tex": "Q = mL",
   "note": {
    "en": "L_f(ice) = 3.33×10⁵ J kg⁻¹ (80 cal g⁻¹); L_v(water) = 22.6×10⁵ J kg⁻¹ (540 cal g⁻¹)."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t3",
   "name": {
    "en": "Calorimetry (principle of mixtures)"
   },
   "tex": "\\text{heat lost} = \\text{heat gained}",
   "note": {
    "en": "With ice, first check whether all of it can melt."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t4",
   "name": {
    "en": "Triple point of water"
   },
   "tex": "273.16\\ \\text{K},\\ 611.7\\ \\text{Pa}\\ (\\approx 6.0\\times10^{-3}\\ \\text{atm})",
   "note": {
    "en": "Below the triple-point pressure a solid sublimes (e.g. dry ice at 1 atm)."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t5",
   "name": {
    "en": "Conduction"
   },
   "tex": "H = \\dfrac{dQ}{dt} = KA\\dfrac{T_1 - T_2}{L}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t2",
   "name": {
    "en": "Thermal resistance"
   },
   "tex": "R = \\dfrac{L}{KA}",
   "note": {
    "en": "Series: R's add; parallel: 1/R's add."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t3",
   "name": {
    "en": "Equivalent conductivity (equal L, A)"
   },
   "tex": "K_{\\text{series}} = \\dfrac{2K_1K_2}{K_1 + K_2},\\qquad K_{\\text{parallel}} = \\dfrac{K_1 + K_2}{2}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t1",
   "name": {
    "en": "Growth of ice on a pond"
   },
   "tex": "t = \\dfrac{\\rho L}{2K\\theta}x^2"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t5",
   "name": {
    "en": "Stefan–Boltzmann law"
   },
   "tex": "P = e\\sigma AT^4,\\qquad P_{\\text{net}} = e\\sigma A(T^4 - T_0^4)",
   "note": {
    "en": "σ = 5.67×10⁻⁸ W m⁻² K⁻⁴."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Wien's displacement law"
   },
   "tex": "\\lambda_mT = b = 2.9\\times10^{-3}\\ \\text{m K}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t6",
   "name": {
    "en": "Newton's law of cooling"
   },
   "tex": "-\\dfrac{dT}{dt} = k(T - T_0),\\quad T - T_0 = (T_i - T_0)e^{-kt}",
   "note": {
    "en": "Average form: (T₁ − T₂)/t = k[(T₁ + T₂)/2 − T₀]."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-10-thermal-properties-of-matter.t6",
   "name": {
    "en": "Rate of cooling of a body"
   },
   "tex": "-\\dfrac{dT}{dt} = \\dfrac{e\\sigma A(T^4 - T_0^4)}{mc}",
   "note": {
    "en": "Same material spheres: rate ∝ 1/r."
   }
  }
 ]
}
