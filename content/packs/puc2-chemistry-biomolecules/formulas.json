{
 "chapterId": "puc2-chemistry-10-biomolecules",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Classification of carbohydrates"
   },
   "tex": "\\text{monosaccharide} \\to \\text{oligosaccharide (2–10 units)} \\to \\text{polysaccharide}",
   "note": {
    "en": "Reducing sugars: all monosaccharides, maltose, lactose. Non-reducing: sucrose."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Glucose: open-chain evidence"
   },
   "tex": "\\text{HI}/\\Delta \\to n\\text{-hexane};\\ \\text{NH}_2\\text{OH} \\to \\text{oxime};\\ \\text{HCN} \\to \\text{cyanohydrin};\\ \\text{Br}_2/\\text{H}_2\\text{O} \\to \\text{gluconic acid}",
   "note": {
    "en": "Straight C₆ chain; C=O present; –CHO (aldehyde)."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Glucose: more evidence"
   },
   "tex": "(\\text{CH}_3\\text{CO})_2\\text{O} \\to \\text{pentaacetate (5 OH)};\\quad \\text{HNO}_3 \\to \\text{saccharic acid (1° OH)}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Glucose: cyclic-structure evidence"
   },
   "tex": "\\text{No Schiff's test, no NaHSO}_3\\ \\text{adduct; pentaacetate + NH}_2\\text{OH} \\to \\text{no reaction}",
   "note": {
    "en": "Six-membered pyranose ring formed by C-5 OH adding to C-1."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Anomers & mutarotation"
   },
   "tex": "\\alpha\\text{-D-glucose } (+112^\\circ) \\rightleftharpoons \\text{equilibrium } (+52.5^\\circ) \\rightleftharpoons \\beta\\text{-D-glucose } (+19^\\circ)",
   "note": {
    "en": "Differ at C-1 (anomeric carbon). Equilibrium ≈ 36% α, 64% β."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Stereocentres in glucose"
   },
   "tex": "\\text{open chain: 4 (C2–C5)};\\quad \\text{pyranose: 5};\\quad 2^4 = 16\\ \\text{aldohexoses}",
   "note": {
    "en": "D/L refers to the configuration at the highest-numbered stereocentre (C-5)."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-10-biomolecules.t1",
   "name": {
    "en": "Fructose"
   },
   "tex": "\\text{D-(–)-fructose: ketohexose (C=O at C-2), furanose ring}",
   "note": {
    "en": "Reduces Tollens / Fehling in alkaline medium."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-10-biomolecules.t2",
   "name": {
    "en": "Disaccharides"
   },
   "tex": "\\text{sucrose} = \\alpha\\text{-D-Glc}\\ (\\text{C1}) + \\beta\\text{-D-Fru}\\ (\\text{C2});\\ \\text{maltose} = \\alpha\\text{-Glc}(1\\to4)\\alpha\\text{-Glc};\\ \\text{lactose} = \\beta\\text{-Gal}(1\\to4)\\beta\\text{-Glc}",
   "note": {
    "en": "Sucrose non-reducing; maltose & lactose reducing."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-10-biomolecules.t2",
   "name": {
    "en": "Invert sugar"
   },
   "tex": "\\text{sucrose } (+66.5^\\circ) \\xrightarrow{\\text{H}^+\\ \\text{or invertase}} \\text{glucose } (+52.5^\\circ) + \\text{fructose } (-92.4^\\circ);\\ [\\alpha]_{\\text{mix}} \\approx -20^\\circ"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-10-biomolecules.t2",
   "name": {
    "en": "Polysaccharides"
   },
   "tex": "\\text{amylose: } \\alpha(1\\to4)\\ \\text{linear};\\ \\text{amylopectin: } \\alpha(1\\to4) + \\alpha(1\\to6);\\ \\text{cellulose: } \\beta(1\\to4);\\ \\text{glycogen: highly branched}",
   "note": {
    "en": "Starch = 15–20% amylose + 80–85% amylopectin."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-10-biomolecules.t3",
   "name": {
    "en": "Amino acids"
   },
   "tex": "\\text{H}_3\\text{N}^+\\text{–CHR–COO}^-\\ (\\text{zwitterion});\\ \\text{pH} < \\text{pI} \\to \\text{cation};\\ \\text{pH} > \\text{pI} \\to \\text{anion}",
   "note": {
    "en": "All natural α-amino acids except glycine are chiral and L. 10 essential: Val, Leu, Ile, Lys, Thr, Met, Phe, Trp, Arg, His."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-10-biomolecules.t3",
   "name": {
    "en": "Peptide bond and peptide mass"
   },
   "tex": "M(\\text{peptide of } n\\ \\text{residues}) = \\sum M_{\\text{amino acids}} - (n-1)\\times 18",
   "note": {
    "en": "Written N-terminus → C-terminus; n distinct residues → n! sequences."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-10-biomolecules.t3",
   "name": {
    "en": "Protein structure levels"
   },
   "tex": "1^\\circ\\ \\text{sequence};\\ 2^\\circ\\ \\alpha\\text{-helix},\\ \\beta\\text{-sheet (H-bonds)};\\ 3^\\circ\\ \\text{folding};\\ 4^\\circ\\ \\text{subunits}",
   "note": {
    "en": "Denaturation destroys 2°/3°, keeps 1°. Fibrous: insoluble (keratin); globular: soluble (insulin, albumin)."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-10-biomolecules.t4",
   "name": {
    "en": "Enzymes"
   },
   "tex": "\\text{maltose} \\xrightarrow{\\text{maltase}} 2\\,\\text{glucose};\\ \\text{sucrose} \\xrightarrow{\\text{invertase}} \\text{glucose + fructose}",
   "note": {
    "en": "Mostly globular proteins; lower activation energy; highly specific."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-10-biomolecules.t4",
   "name": {
    "en": "Vitamins"
   },
   "tex": "\\text{fat-soluble: A, D, E, K};\\quad \\text{water-soluble: B group, C}",
   "note": {
    "en": "Deficiency: A xerophthalmia; B₁ beriberi; B₂ cheilosis; B₆ convulsions; B₁₂ pernicious anaemia; C scurvy; D rickets; E RBC fragility; K longer clotting time."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-10-biomolecules.t5",
   "name": {
    "en": "Nucleic acids"
   },
   "tex": "\\text{nucleoside = base + sugar};\\quad \\text{nucleotide = base + sugar + phosphate}",
   "note": {
    "en": "Linked by 3′,5′-phosphodiester bonds."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-10-biomolecules.t5",
   "name": {
    "en": "DNA vs RNA"
   },
   "tex": "\\text{DNA: 2-deoxyribose; A, G, C, T};\\quad \\text{RNA: ribose; A, G, C, U}",
   "note": {
    "en": "DNA double helix (antiparallel). RNA types: mRNA, rRNA, tRNA."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-10-biomolecules.t5",
   "name": {
    "en": "Chargaff's rules"
   },
   "tex": "\\text{A} = \\text{T},\\ \\text{G} = \\text{C};\\quad \\text{A{=}T: 2 H-bonds},\\ \\text{G}\\equiv\\text{C: 3 H-bonds}",
   "note": {
    "en": "Purines (A, G) pair with pyrimidines (T/U, C)."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-10-biomolecules.t3",
   "name": {
    "en": "Periodate cleavage"
   },
   "tex": "\\text{glucose} + 5\\,\\text{HIO}_4 \\to 5\\,\\text{HCOOH} + \\text{HCHO}",
   "note": {
    "en": "One HIO₄ per C–C bond between oxygenated carbons (glycerol: 2)."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-10-biomolecules.t2",
   "name": {
    "en": "Osazone formation"
   },
   "tex": "\\text{glucose, fructose, mannose} \\xrightarrow{3\\,\\text{PhNHNH}_2} \\text{same osazone}",
   "note": {
    "en": "Only C-1 and C-2 are involved."
   }
  }
 ]
}
