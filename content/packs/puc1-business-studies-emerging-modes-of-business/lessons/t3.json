  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Arjun orders a pair of shoes listed at ₹2,400. The site gives 5% off for card payment and charges ₹60 for delivery. Find the amount he pays by card and name the stage at which payment happens."
   },
   "steps": [
    {
     "en": "Discount = 5% of ₹2,400 = ₹120."
    },
    {
     "en": "Price after discount = ₹2,400 − ₹120 = ₹2,280."
    },
    {
     "en": "Add delivery: ₹2,280 + ₹60 = ₹2,340. Payment happens in the purchase stage."
    }
   ],
   "answer": {
    "en": "₹2,340, paid in the purchase stage"
   },
   "narration": {
    "en": "Let us work through this case together. Arjun orders a pair of shoes listed at ₹2,400. The site gives 5% off for card payment and charges ₹60 for delivery. Find the amount he pays by card and name the stage at which payment happens."
   }
