 "title": {
  "en": "Online transactions and payment",
  "kn": "ಆನ್‌ಲೈನ್ ವಹಿವಾಟು ಮತ್ತು ಪಾವತಿ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Click, pay, receive",
    "kn": "ಕ್ಲಿಕ್, ಪಾವತಿ, ಸ್ವೀಕಾರ"
   },
   "hook": {
    "en": "Buying online feels like one click, but behind it are three stages: finding the product, placing and paying for the order, and getting it delivered.",
    "kn": "ಆನ್‌ಲೈನ್ ಖರೀದಿ ಒಂದೇ ಕ್ಲಿಕ್‌ನಂತೆ ಕಾಣುತ್ತದೆ, ಆದರೆ ಅದರ ಹಿಂದೆ ಮೂರು ಹಂತಗಳಿವೆ: ವಸ್ತು ಹುಡುಕುವುದು, ಆರ್ಡರ್ ಮತ್ತು ಪಾವತಿ, ಮತ್ತು ವಿತರಣೆ."
   },
   "objectives": [
    {
     "en": "Describe the stages of an online transaction"
    },
    {
     "en": "Explain the modes of online payment"
    }
   ],
   "narration": {
    "en": "Buying online feels like one click, but behind it are three stages: finding the product, placing and paying for the order, and getting it delivered.",
    "kn": "ಆನ್‌ಲೈನ್ ಖರೀದಿ ಒಂದೇ ಕ್ಲಿಕ್‌ನಂತೆ ಕಾಣುತ್ತದೆ, ಆದರೆ ಅದರ ಹಿಂದೆ ಮೂರು ಹಂತಗಳಿವೆ: ವಸ್ತು ಹುಡುಕುವುದು, ಆರ್ಡರ್ ಮತ್ತು ಪಾವತಿ, ಮತ್ತು ವಿತರಣೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Stages of an online transaction"
   },
   "body": {
    "en": "In the pre-purchase stage the buyer searches, compares and registers on the website. In the purchase stage the buyer places the order, usually through a shopping cart, and pays. In the delivery stage the goods are shipped and delivered; digital products such as e-books can be delivered online itself."
   },
   "points": [
    {
     "en": "Pre-purchase/sale: search, compare, register"
    },
    {
     "en": "Purchase/sale: cart, order, payment"
    },
    {
     "en": "Delivery: physical or online"
    }
   ],
   "narration": {
    "en": "In the pre-purchase stage the buyer searches, compares and registers on the website. In the purchase stage the buyer places the order, usually through a shopping cart, and pays. In the delivery stage the goods are shipped and delivered; digital products such as e-books can be delivered online itself.",
    "kn": "ಆನ್‌ಲೈನ್ ವಹಿವಾಟಿಗೆ ಖರೀದಿಪೂರ್ವ, ಖರೀದಿ ಮತ್ತು ವಿತರಣೆ ಎಂಬ ಮೂರು ಹಂತಗಳಿವೆ."
   }
