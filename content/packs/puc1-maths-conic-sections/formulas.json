{
 "chapterId": "puc1-maths-10-conic-sections",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-10-conic-sections.t2",
   "name": {
    "en": "Circle: centre–radius form"
   },
   "tex": "(x-h)^2+(y-k)^2 = r^2"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-10-conic-sections.t2",
   "name": {
    "en": "Circle: general form"
   },
   "tex": "x^2+y^2+2gx+2fy+c = 0,\\quad C(-g,-f),\\ r = \\sqrt{g^2+f^2-c}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-10-conic-sections.t2",
   "name": {
    "en": "Circle: diameter form"
   },
   "tex": "(x-x_1)(x-x_2)+(y-y_1)(y-y_2) = 0"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Power of a point / tangent length"
   },
   "tex": "S_1 = x_1^2+y_1^2+2gx_1+2fy_1+c,\\quad L = \\sqrt{S_1}",
   "note": {
    "en": "S₁ < 0 inside, = 0 on, > 0 outside."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-10-conic-sections.t3",
   "name": {
    "en": "Tangent, chord of contact, chord with midpoint"
   },
   "tex": "T = 0\\ \\ (\\text{tangent at / chord of contact from } P),\\qquad T = S_1\\ \\ (\\text{chord bisected at } P)"
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Tangency of y = mx + c with x² + y² = a²"
   },
   "tex": "c^2 = a^2(1+m^2)"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Common tangents of two circles"
   },
   "tex": "d>r_1+r_2:4,\\ \\ d = r_1+r_2:3,\\ \\ |r_1-r_2|<d<r_1+r_2:2,\\ \\ d = |r_1-r_2|:1,\\ \\ d<|r_1-r_2|:0"
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Parabola y² = 4ax"
   },
   "tex": "\\text{focus }(a,0),\\ \\ \\text{directrix }x = -a,\\ \\ \\text{LR} = 4a,\\ \\ e = 1",
   "note": {
    "en": "Similarly y² = −4ax, x² = ±4ay."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Parabola: focal distance and parameters"
   },
   "tex": "SP = x_1+a,\\quad P(at^2,2at),\\quad \\text{focal chord: } t_1t_2 = -1"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Parabola: tangent and normal"
   },
   "tex": "y = mx+\\dfrac am,\\qquad ty = x+at^2,\\qquad y = -tx+2at+at^3"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-10-conic-sections.t1",
   "name": {
    "en": "Normal meeting the parabola again"
   },
   "tex": "t_2 = -t_1-\\dfrac2{t_1}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Ellipse x²/a² + y²/b² = 1 (a > b)"
   },
   "tex": "c^2 = a^2-b^2,\\ \\ e = \\dfrac ca = \\sqrt{1-\\dfrac{b^2}{a^2}},\\ \\ \\text{foci }(\\pm ae,0)"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-10-conic-sections.t4",
   "name": {
    "en": "Ellipse: latus rectum and directrices"
   },
   "tex": "\\text{LR} = \\dfrac{2b^2}a,\\qquad x = \\pm\\dfrac ae"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Ellipse: focal property"
   },
   "tex": "PS+PS' = 2a,\\qquad PS = a-ex_1,\\ \\ PS' = a+ex_1"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Ellipse: tangent"
   },
   "tex": "\\dfrac{xx_1}{a^2}+\\dfrac{yy_1}{b^2} = 1,\\qquad y = mx\\pm\\sqrt{a^2m^2+b^2}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Hyperbola x²/a² − y²/b² = 1"
   },
   "tex": "c^2 = a^2+b^2,\\ \\ e = \\sqrt{1+\\dfrac{b^2}{a^2}},\\ \\ \\text{LR} = \\dfrac{2b^2}a,\\ \\ |PS-PS'| = 2a"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Hyperbola: asymptotes and tangent"
   },
   "tex": "y = \\pm\\dfrac bax,\\qquad y = mx\\pm\\sqrt{a^2m^2-b^2}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-maths-10-conic-sections.t5",
   "name": {
    "en": "Conjugate hyperbola"
   },
   "tex": "\\dfrac1{e_1^2}+\\dfrac1{e_2^2} = 1",
   "note": {
    "en": "Rectangular hyperbola (a = b): e = √2."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Director circles"
   },
   "tex": "\\text{ellipse: }x^2+y^2 = a^2+b^2,\\qquad \\text{hyperbola: }x^2+y^2 = a^2-b^2,\\qquad \\text{parabola: directrix}"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Vertical-major-axis ellipse x²/a² + y²/b² = 1 (b > a)"
   },
   "tex": "c^2 = b^2-a^2,\\ \\ e = \\dfrac cb,\\ \\ \\text{foci }(0,\\pm c),\\ \\ \\text{LR} = \\dfrac{2a^2}b"
  }
 ]
}
