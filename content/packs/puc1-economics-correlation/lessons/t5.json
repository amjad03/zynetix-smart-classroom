  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Marks of 5 students in Economics are 85, 60, 73, 40, 90 and in Statistics 93, 75, 65, 50, 80. Find Spearman's rank correlation."
   },
   "steps": [
    {
     "en": "Ranks in Economics (highest = 1): 2, 4, 3, 5, 1. Ranks in Statistics: 1, 3, 4, 5, 2."
    },
    {
     "en": "D = 1, 1, −1, 0, −1; D² = 1, 1, 1, 0, 1; ΣD² = 4."
    },
    {
     "en": "rs = 1 − (6 × 4) ÷ (125 − 5) = 1 − 24 ÷ 120 = 1 − 0.2 = 0.8."
    }
   ],
   "answer": {
    "en": "rs = 0.8 (high positive agreement)"
   },
   "narration": {
    "en": "Let us work this out together. Marks of 5 students in Economics are 85, 60, 73, 40, 90 and in Statistics 93, 75, 65, 50, 80. Find Spearman's rank correlation."
   }
