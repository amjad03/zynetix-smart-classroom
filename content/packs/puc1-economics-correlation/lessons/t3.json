  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find r by the direct method for X: 1, 2, 3, 4, 5 and Y: 2, 4, 5, 4, 5."
   },
   "steps": [
    {
     "en": "N = 5, ΣX = 15, ΣY = 20, ΣXY = 2 + 8 + 15 + 16 + 25 = 66."
    },
    {
     "en": "ΣX² = 55 and ΣY² = 4 + 16 + 25 + 16 + 25 = 86."
    },
    {
     "en": "Numerator = 5 × 66 − 15 × 20 = 330 − 300 = 30."
    },
    {
     "en": "Denominator = √(275 − 225) × √(430 − 400) = √50 × √30 = 38.73; r = 30 ÷ 38.73 ≈ 0.77."
    }
   ],
   "answer": {
    "en": "r ≈ 0.77, the same as the deviation method"
   },
   "narration": {
    "en": "Let us work this out together. Find r by the direct method for X: 1, 2, 3, 4, 5 and Y: 2, 4, 5, 4, 5."
