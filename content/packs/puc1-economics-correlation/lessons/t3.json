  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Karl Pearson's coefficient"
   },
   "body": {
    "en": "Karl Pearson's coefficient of correlation (product moment correlation) is $r = \\frac{\\text{Cov}(X,Y)}{\\sigma_X \\sigma_Y}$. Taking deviations from the means, $x = X - \\bar{X}$ and $y = Y - \\bar{Y}$, it becomes $r = \\frac{\\sum xy}{\\sqrt{\\sum x^2 \\sum y^2}}$.",
    "kn": "ಕಾರ್ಲ್ ಪಿಯರ್ಸನ್ ಗುಣಾಂಕ = X ಮತ್ತು Y ಯ ಸಹವಿಚಲನೆ ÷ ಅವುಗಳ ಪ್ರಮಾಣ ವಿಚಲನೆಗಳ ಗುಣಲಬ್ಧ. ಸರಾಸರಿಯಿಂದ ವಿಚಲನ ತೆಗೆದರೆ r = Σxy ÷ √(Σx² Σy²)."
   },
   "points": [
    {
     "en": "Find the means of X and Y"
    },
    {
     "en": "Take deviations x and y, and the products xy"
    },
    {
     "en": "Add up Σxy, Σx², Σy² and substitute"
    }
   ],
   "narration": {
    "en": "Karl Pearson's coefficient is the covariance of X and Y divided by the product of their standard deviations. Using deviations from the means, r equals sigma x y divided by the square root of sigma x squared times sigma y squared.",
    "kn": "ಕಾರ್ಲ್ ಪಿಯರ್ಸನ್ ಗುಣಾಂಕ = X ಮತ್ತು Y ಯ ಸಹವಿಚಲನೆ ÷ ಅವುಗಳ ಪ್ರಮಾಣ ವಿಚಲನೆಗಳ ಗುಣಲಬ್ಧ. ಸರಾಸರಿಯಿಂದ ವಿಚಲನ ತೆಗೆದರೆ r = Σxy ÷ √(Σx² Σy²)."
   },
   "formula": "r = \\frac{\\sum xy}{\\sqrt{\\sum x^2 \\, \\sum y^2}}"
  },
