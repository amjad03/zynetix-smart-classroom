{
 "chapterId": "puc1-chemistry-01-some-basic-concepts-of-chemistry",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Moles"
   },
   "tex": "n = \\frac{m}{M} = \\frac{N}{N_A} = \\frac{V_{STP}}{22.4}",
   "note": {
    "en": "N_A = 6.022 × 10²³."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molarity"
   },
   "tex": "M = \\frac{n_{solute}}{V_{solution}(\\text{L})}",
   "note": {
    "en": "Temperature dependent."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molality"
   },
   "tex": "m = \\frac{n_{solute}}{W_{solvent}(\\text{kg})}",
   "note": {
    "en": "Temperature independent."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Mole fraction"
   },
   "tex": "\\chi_A = \\frac{n_A}{n_A + n_B}",
   "note": {
    "en": "Sum of fractions = 1."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Normality"
   },
   "tex": "N = M\\times n\\text{-factor}",
   "note": {
    "en": "KMnO₄ (acid) n = 5."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Dilution"
   },
   "tex": "M_1V_1 = M_2V_2",
   "note": {
    "en": "Moles of solute unchanged."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molarity ↔ molality"
   },
   "tex": "m = \\frac{1000M}{1000d - MM_{solute}}",
   "note": {
    "en": "d in g/mL."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t1",
   "name": {
    "en": "SI base units"
   },
   "tex": "\\text{m, kg, s, A, K, mol, cd}",
   "note": {
    "en": "Litre is not SI: 1 L = 1 dm³ = 10⁻³ m³."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t2",
   "name": {
    "en": "Significant figures"
   },
   "tex": "0.00\\underline{2050} \\to 4,\\quad 3.200\\times10^{3} \\to 4",
   "note": {
    "en": "Leading zeros never count; trailing zeros count after a decimal point; exact numbers have infinite s.f."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t2",
   "name": {
    "en": "Rounding / operations"
   },
   "tex": "\\times,\\div:\\ \\text{least s.f.};\\qquad +,-:\\ \\text{least decimal places}",
   "note": {
    "en": "NCERT: dropping a 5 leaves an even preceding digit unchanged and raises an odd one."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t3",
   "name": {
    "en": "Laws of chemical combination"
   },
   "tex": "\\text{conservation of mass, definite, multiple proportions, Gay-Lussac, Avogadro}",
   "note": {
    "en": "Gay-Lussac: gas volumes react in simple ratios at the same T, P — not explained by Dalton."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Atomic mass unit"
   },
   "tex": "1\\,\\text{u} = \\tfrac{1}{12}\\,m(^{12}\\text{C}) = 1.66\\times10^{-24}\\,\\text{g} = \\tfrac{1}{N_A}\\,\\text{g}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Average atomic mass"
   },
   "tex": "\\bar{A} = \\sum_i x_i A_i",
   "note": {
    "en": "x_i = fractional abundance of each isotope."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t1",
   "name": {
    "en": "Mole"
   },
   "tex": "n = \\dfrac{m}{M} = \\dfrac{N}{N_A} = \\dfrac{V_{\\text{gas}}}{V_m}",
   "note": {
    "en": "N_A = 6.022 × 10²³ mol⁻¹. V_m = 22.7 L (273.15 K, 1 bar) or 22.4 L (273 K, 1 atm)."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t1",
   "name": {
    "en": "Molar mass from vapour density"
   },
   "tex": "M = 2 \\times \\text{VD}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Mass percentage of an element"
   },
   "tex": "\\%X = \\dfrac{(\\text{no. of X atoms}) \\times A_X}{M} \\times 100"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Minimum molar mass"
   },
   "tex": "M_{\\min} = \\dfrac{A_X}{(\\%X)/100}",
   "note": {
    "en": "Assumes one atom of X per molecule."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Empirical → molecular formula"
   },
   "tex": "n = \\dfrac{M}{M_{\\text{empirical}}},\\quad \\text{MF} = (\\text{EF})_n",
   "note": {
    "en": "Mass % ÷ atomic mass → divide by smallest → round to whole numbers."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t2",
   "name": {
    "en": "Combustion analysis"
   },
   "tex": "m_C = \\tfrac{12}{44}\\,m_{CO_2},\\qquad m_H = \\tfrac{2}{18}\\,m_{H_2O}",
   "note": {
    "en": "Oxygen by difference."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Limiting reagent"
   },
   "tex": "\\text{smallest } \\dfrac{n_i}{\\nu_i}",
   "note": {
    "en": "n_i = moles present, ν_i = stoichiometric coefficient; it fixes the amount of product."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Percentage yield / purity"
   },
   "tex": "\\%\\,\\text{yield} = \\dfrac{\\text{actual}}{\\text{theoretical}}\\times100,\\quad m_{\\text{impure}} = \\dfrac{m_{\\text{pure}}}{\\text{purity}}"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t3",
   "name": {
    "en": "Gaseous reactions"
   },
   "tex": "\\text{C}_x\\text{H}_y + \\left(x + \\tfrac{y}{4}\\right)\\text{O}_2 \\to x\\,\\text{CO}_2 + \\tfrac{y}{2}\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "Volume ratios = mole ratios at the same T, P."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t4",
   "name": {
    "en": "Mass percent"
   },
   "tex": "w\\% = \\dfrac{m_{\\text{solute}}}{m_{\\text{solution}}}\\times100"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Mole fraction"
   },
   "tex": "x_A = \\dfrac{n_A}{n_A + n_B},\\qquad x_A + x_B = 1"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molarity"
   },
   "tex": "M = \\dfrac{n_{\\text{solute}}}{V_{\\text{solution}}\\,(\\text{L})}",
   "note": {
    "en": "Changes with temperature."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molality"
   },
   "tex": "m = \\dfrac{n_{\\text{solute}}}{m_{\\text{solvent}}\\,(\\text{kg})}",
   "note": {
    "en": "Temperature independent (like mole fraction and mass %)."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t1",
   "name": {
    "en": "Molarity from mass % and density"
   },
   "tex": "M = \\dfrac{10\\,d\\,(w\\%)}{M_{\\text{solute}}}",
   "note": {
    "en": "d in g mL⁻¹."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molality from molarity"
   },
   "tex": "m = \\dfrac{1000\\,M}{1000\\,d - M\\,M_{\\text{solute}}}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-chemistry-01-some-basic-concepts-of-chemistry.t5",
   "name": {
    "en": "Molality from mole fraction"
   },
   "tex": "m = \\dfrac{1000\\,x_2}{x_1\\,M_1}",
   "note": {
    "en": "x₂ solute, x₁ solvent, M₁ molar mass of solvent."
   }
  },
  {
   "id": "zs-f30",
   "name": {
    "en": "Dilution and mixing"
   },
   "tex": "M_1V_1 = M_2V_2,\\qquad M_{\\text{mix}} = \\dfrac{M_1V_1 + M_2V_2}{V_1 + V_2}"
  }
 ]
}
