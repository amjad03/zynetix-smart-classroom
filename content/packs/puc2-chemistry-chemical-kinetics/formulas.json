{
 "chapterId": "puc2-chemistry-03-chemical-kinetics",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Rate law"
   },
   "tex": "r = k[A]^x[B]^y",
   "note": {
    "en": "Order = x + y (experimental)."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Zero order"
   },
   "tex": "[A] = [A]_0 - kt,\\quad t_{1/2} = \\frac{[A]_0}{2k}",
   "note": {
    "en": "t½ ∝ [A]₀."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t3",
   "name": {
    "en": "First order"
   },
   "tex": "k = \\frac{2.303}{t}\\log\\frac{[A]_0}{[A]}",
   "note": {
    "en": "Exponential decay."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t4",
   "name": {
    "en": "First-order half-life"
   },
   "tex": "t_{1/2} = \\frac{0.693}{k}",
   "note": {
    "en": "Independent of [A]₀."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Units of k"
   },
   "tex": "(\\text{mol L}^{-1})^{1-n}\\,\\text{s}^{-1}",
   "note": {
    "en": "n = overall order."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t5",
   "name": {
    "en": "Arrhenius equation"
   },
   "tex": "k = Ae^{-E_a/RT}",
   "note": {
    "en": "ln k vs 1/T slope = −Ea/R."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Two temperatures"
   },
   "tex": "\\log\\frac{k_2}{k_1} = \\frac{E_a}{2.303R}\\left(\\frac{1}{T_1} - \\frac{1}{T_2}\\right)",
   "note": {
    "en": "R = 8.314 J/mol K."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "99.9% completion"
   },
   "tex": "t_{99.9\\%} \\approx 10\\,t_{1/2}",
   "note": {
    "en": "First order."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t1",
   "name": {
    "en": "Rate and stoichiometry"
   },
   "tex": "a\\text{A} + b\\text{B} \\rightarrow c\\text{C}:\\ \\ r = -\\dfrac{1}{a}\\dfrac{d[\\text{A}]}{dt} = -\\dfrac{1}{b}\\dfrac{d[\\text{B}]}{dt} = \\dfrac{1}{c}\\dfrac{d[\\text{C}]}{dt}",
   "note": {
    "en": "Average rate = −Δ[R]/Δt; instantaneous rate = slope of tangent."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Rate law and order"
   },
   "tex": "r = k[\\text{A}]^x[\\text{B}]^y, \\quad \\text{order} = x + y",
   "note": {
    "en": "x, y found experimentally; may be 0, fractional or negative."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Molecularity"
   },
   "tex": "\\text{elementary step only};\\ 1, 2 \\text{ or (rarely) } 3",
   "note": {
    "en": "For elementary reactions order = molecularity. Slowest step is rate-determining."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t3",
   "name": {
    "en": "Zero order"
   },
   "tex": "[\\text{A}] = [\\text{A}]_0 - kt, \\qquad t_{1/2} = \\dfrac{[\\text{A}]_0}{2k}",
   "note": {
    "en": "e.g. 2NH₃ → N₂ + 3H₂ on hot Pt at high pressure; HI on gold."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "First order"
   },
   "tex": "k = \\dfrac{2.303}{t}\\log\\dfrac{[\\text{A}]_0}{[\\text{A}]}, \\qquad [\\text{A}] = [\\text{A}]_0e^{-kt}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t4",
   "name": {
    "en": "First-order half-life"
   },
   "tex": "t_{1/2} = \\dfrac{0.693}{k}",
   "note": {
    "en": "Independent of [A]₀. After n half-lives, fraction left = (1/2)ⁿ."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t6",
   "name": {
    "en": "First-order shortcuts"
   },
   "tex": "t_{75\\%} = 2t_{1/2},\\quad t_{90\\%} = 3.32\\,t_{1/2},\\quad t_{99\\%} = 2t_{90\\%},\\quad t_{99.9\\%} \\approx 10\\,t_{1/2}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t1",
   "name": {
    "en": "Gas phase first order (A → products)"
   },
   "tex": "k = \\dfrac{2.303}{t}\\log\\dfrac{p_0}{p_A}",
   "note": {
    "en": "For A → B + C: p_A = 2p₀ − P_t. For A → 2B + C: p_A = (3p₀ − P_t)/2."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t4",
   "name": {
    "en": "Half-life and order"
   },
   "tex": "t_{1/2} \\propto [\\text{A}]_0^{\\,1-n}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t3",
   "name": {
    "en": "Linear plots"
   },
   "tex": "\\text{zero: } [\\text{A}] \\text{ vs } t;\\ \\ \\text{first: } \\ln[\\text{A}] \\text{ vs } t \\ (\\text{slope } -k);\\ \\ \\text{second: } \\dfrac{1}{[\\text{A}]} \\text{ vs } t"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t4",
   "name": {
    "en": "Pseudo first order"
   },
   "tex": "r = k[\\text{A}][\\text{B}] \\approx k'[\\text{A}],\\ \\ k' = k[\\text{B}]_{\\text{excess}}",
   "note": {
    "en": "e.g. acid hydrolysis of ethyl acetate, inversion of cane sugar."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t3",
   "name": {
    "en": "Arrhenius equation"
   },
   "tex": "k = A\\,e^{-E_a/RT}, \\qquad \\ln k = \\ln A - \\dfrac{E_a}{RT}",
   "note": {
    "en": "Slope of ln k vs 1/T = −Ea/R; of log k vs 1/T = −Ea/2.303R."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Two temperatures"
   },
   "tex": "\\log\\dfrac{k_2}{k_1} = \\dfrac{E_a}{2.303R}\\left(\\dfrac{T_2 - T_1}{T_1T_2}\\right)",
   "note": {
    "en": "R = 8.314 J K⁻¹ mol⁻¹."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t6",
   "name": {
    "en": "Fraction of effective collisions"
   },
   "tex": "f = e^{-E_a/RT}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t2",
   "name": {
    "en": "Temperature coefficient"
   },
   "tex": "\\dfrac{k_{T+10}}{k_T} \\approx 2\\text{–}3"
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t6",
   "name": {
    "en": "Collision theory"
   },
   "tex": "r = P\\,Z_{AB}\\,e^{-E_a/RT}",
   "note": {
    "en": "P = steric (orientation) factor; Z_AB = collision frequency."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t5",
   "name": {
    "en": "Energy profile"
   },
   "tex": "\\Delta_r H = E_a(\\text{f}) - E_a(\\text{b}), \\qquad E_{\\text{threshold}} = E_a + E_{\\text{reactants}}"
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t6",
   "name": {
    "en": "Catalyst"
   },
   "tex": "k_{\\text{cat}}/k = e^{(E_a - E_a')/RT}",
   "note": {
    "en": "Lowers Ea for both directions equally; ΔH, ΔG and K unchanged."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-chemistry-03-chemical-kinetics.t3",
   "name": {
    "en": "Parallel first-order reactions"
   },
   "tex": "k_{\\text{overall}} = k_1 + k_2, \\qquad \\dfrac{[\\text{B}]}{[\\text{C}]} = \\dfrac{k_1}{k_2}"
  }
 ]
}
