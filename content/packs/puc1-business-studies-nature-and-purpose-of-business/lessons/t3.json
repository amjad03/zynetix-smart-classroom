   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Commerce: trade and auxiliaries to trade"
   },
   "body": {
    "en": "Commerce is trade plus the auxiliaries to trade. Trade is internal (wholesale and retail) or external (import, export and entrepot). The auxiliaries remove hindrances: transport removes place, warehousing removes time, insurance removes risk, banking removes finance, and advertising removes the hindrance of information."
   },
   "points": [
    {
     "en": "Commerce = Trade + Auxiliaries to trade"
    },
    {
     "en": "Transport → place; Warehousing → time"
    },
    {
     "en": "Insurance → risk; Banking → finance"
    },
    {
     "en": "Advertising and communication → information"
    }
   ],
   "narration": {
