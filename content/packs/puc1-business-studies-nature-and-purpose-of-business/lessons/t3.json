 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "From the field to your plate",
    "kn": "ಹೊಲದಿಂದ ನಿಮ್ಮ ತಟ್ಟೆಯವರೆಗೆ"
   },
   "hook": {
    "en": "Paddy grown in Mandya becomes rice in a mill, is carried by truck, stored in a godown, financed by a bank and sold in your local shop. Each step is a different kind of business activity.",
    "kn": "ಮಂಡ್ಯದಲ್ಲಿ ಬೆಳೆದ ಭತ್ತ ಗಿರಣಿಯಲ್ಲಿ ಅಕ್ಕಿಯಾಗಿ, ಲಾರಿಯಲ್ಲಿ ಸಾಗಿಸಲ್ಪಟ್ಟು, ಗೋದಾಮಿನಲ್ಲಿ ಸಂಗ್ರಹವಾಗಿ, ಅಂಗಡಿಯಲ್ಲಿ ಮಾರಾಟವಾಗುತ್ತದೆ. ಪ್ರತಿ ಹಂತವೂ ಬೇರೆ ಬೇರೆ ವ್ಯವಹಾರ ಚಟುವಟಿಕೆ."
   },
   "objectives": [
    {
     "en": "Classify business activities into industry and commerce"
    },
    {
     "en": "Distinguish primary, secondary and tertiary industries"
    },
    {
     "en": "Explain how auxiliaries to trade remove hindrances"
    }
   ],
   "narration": {
    "en": "Paddy grown in Mandya becomes rice in a mill, is carried by truck, stored in a godown, financed by a bank and sold in your local shop. Each step is a different kind of business activity.",
    "kn": "ಮಂಡ್ಯದಲ್ಲಿ ಬೆಳೆದ ಭತ್ತ ಗಿರಣಿಯಲ್ಲಿ ಅಕ್ಕಿಯಾಗಿ, ಲಾರಿಯಲ್ಲಿ ಸಾಗಿಸಲ್ಪಟ್ಟು, ಗೋದಾಮಿನಲ್ಲಿ ಸಂಗ್ರಹವಾಗಿ, ಅಂಗಡಿಯಲ್ಲಿ ಮಾರಾಟವಾಗುತ್ತದೆ. ಪ್ರತಿ ಹಂತವೂ ಬೇರೆ ಬೇರೆ ವ್ಯವಹಾರ ಚಟುವಟಿಕೆ."
   }
