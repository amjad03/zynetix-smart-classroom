  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Industry"
   },
   "body": {
    "en": "Primary industries are extractive (farming, mining, fishing, lumbering) or genetic (nurseries, poultry, fish hatcheries). Secondary industries are manufacturing, which can be analytical, synthetical, processing or assembling, and construction. Tertiary or service industries such as transport and banking support the other two."
   },
   "points": [
    {
     "en": "Primary: extractive and genetic"
    },
    {
     "en": "Secondary: manufacturing (analytical, synthetical, processing, assembling) and construction"
    },
    {
     "en": "Tertiary: service industries"
    }
   ],
   "narration": {
    "en": "Primary industries are extractive (farming, mining, fishing, lumbering) or genetic (nurseries, poultry, fish hatcheries). Secondary industries are manufacturing, which can be analytical, synthetical, processing or assembling, and construction. Tertiary or service industries such as transport and banking support the other two.",
    "kn": "ಪ್ರಾಥಮಿಕ ಕೈಗಾರಿಕೆಗಳು ಹೊರತೆಗೆಯುವ ಮತ್ತು ಜನನಿಕ; ದ್ವಿತೀಯ ಕೈಗಾರಿಕೆಗಳು ತಯಾರಿಕೆ ಮತ್ತು ನಿರ್ಮಾಣ; ತೃತೀಯ ಕೈಗಾರಿಕೆಗಳು ಸೇವಾ ಕೈಗಾರಿಕೆಗಳು."
   }
  },
