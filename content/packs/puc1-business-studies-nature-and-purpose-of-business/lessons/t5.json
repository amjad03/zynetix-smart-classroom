 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "No risk, no profit",
    "kn": "ಅಪಾಯವಿಲ್ಲದೆ ಲಾಭವಿಲ್ಲ"
   },
   "hook": {
    "en": "A mango trader buys a whole orchard's crop in March. A hailstorm in April could wipe it out, or a bumper market could double his money. Every business lives with such uncertainty.",
    "kn": "ಮಾವಿನ ವ್ಯಾಪಾರಿ ಮಾರ್ಚ್‌ನಲ್ಲಿ ಇಡೀ ತೋಟದ ಬೆಳೆ ಖರೀದಿಸುತ್ತಾನೆ. ಏಪ್ರಿಲ್‌ನ ಆಲಿಕಲ್ಲು ಮಳೆ ಎಲ್ಲವನ್ನೂ ನಾಶ ಮಾಡಬಹುದು ಅಥವಾ ಉತ್ತಮ ಮಾರುಕಟ್ಟೆ ಹಣವನ್ನು ದ್ವಿಗುಣಗೊಳಿಸಬಹುದು. ಪ್ರತಿ ವ್ಯವಹಾರವೂ ಇಂತಹ ಅನಿಶ್ಚಿತತೆಯೊಂದಿಗೆ ಬದುಕುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Explain the nature and causes of business risk"
    },
    {
     "en": "List the basic factors to consider when starting a business"
    }
   ],
   "narration": {
    "en": "A mango trader buys a whole orchard's crop in March. A hailstorm in April could wipe it out, or a bumper market could double his money. Every business lives with such uncertainty.",
    "kn": "ಮಾವಿನ ವ್ಯಾಪಾರಿ ಮಾರ್ಚ್‌ನಲ್ಲಿ ಇಡೀ ತೋಟದ ಬೆಳೆ ಖರೀದಿಸುತ್ತಾನೆ. ಏಪ್ರಿಲ್‌ನ ಆಲಿಕಲ್ಲು ಮಳೆ ಎಲ್ಲವನ್ನೂ ನಾಶ ಮಾಡಬಹುದು ಅಥವಾ ಉತ್ತಮ ಮಾರುಕಟ್ಟೆ ಹಣವನ್ನು ದ್ವಿಗುಣಗೊಳಿಸಬಹುದು. ಪ್ರತಿ ವ್ಯವಹಾರವೂ ಇಂತಹ ಅನಿಶ್ಚಿತತೆಯೊಂದಿಗೆ ಬದುಕುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Nature and causes of business risk"
   },
   "body": {
    "en": "Business risk is the possibility of inadequate profits or even losses due to uncertainties. It is an essential part of every business, its degree depends on the nature and size of the business, and profit is the reward for bearing it. Its causes are natural, human, economic and other causes such as political disturbances or exchange-rate changes."
   },
   "points": [
    {
     "en": "Natural: floods, earthquakes, heavy rains"
    },
    {
     "en": "Human: strikes, dishonesty, negligence"
    },
    {
     "en": "Economic: demand, competition, prices, technology"
    },
    {
     "en": "Other: political disturbance, mechanical failure, exchange rates"
    }
   ],
   "narration": {
    "en": "Business risk is the possibility of inadequate profits or even losses due to uncertainties. It is an essential part of every business, its degree depends on the nature and size of the business, and profit is the reward for bearing it. Its causes are natural, human, economic and other causes such as political disturbances or exchange-rate changes.",
    "kn": "ಅನಿಶ್ಚಿತತೆಗಳಿಂದ ಕಡಿಮೆ ಲಾಭ ಅಥವಾ ನಷ್ಟವಾಗುವ ಸಾಧ್ಯತೆಯೇ ವ್ಯವಹಾರದ ಅಪಾಯ. ಇದಕ್ಕೆ ನೈಸರ್ಗಿಕ, ಮಾನವ, ಆರ್ಥಿಕ ಮತ್ತು ಇತರ ಕಾರಣಗಳಿವೆ."
   }
