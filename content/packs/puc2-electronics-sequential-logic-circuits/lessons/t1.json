 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "A circuit that remembers",
    "kn": "ನೆನಪಿಟ್ಟುಕೊಳ್ಳುವ ಮಂಡಲ"
   },
   "hook": {
    "en": "Press a doorbell and the sound stops when you let go: no memory. Press a light switch and the light stays on: it remembers. Digital memory starts with two gates that feed each other.",
    "kn": "ಡೋರ್‌ಬೆಲ್ ಒತ್ತಿ ಬಿಟ್ಟರೆ ಶಬ್ದ ನಿಲ್ಲುತ್ತದೆ: ಸ್ಮರಣೆ ಇಲ್ಲ. ದೀಪದ ಸ್ವಿಚ್ ಒತ್ತಿದರೆ ದೀಪ ಉರಿಯುತ್ತಲೇ ಇರುತ್ತದೆ: ಅದು ನೆನಪಿಡುತ್ತದೆ. ಡಿಜಿಟಲ್ ಸ್ಮರಣೆ ಪರಸ್ಪರ ಉಣಿಸುವ ಎರಡು ಗೇಟ್‌ಗಳಿಂದ ಆರಂಭವಾಗುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Distinguish sequential from combinational circuits"
    },
    {
     "en": "Explain the SR latch built with NOR gates"
    },
    {
     "en": "Explain the active-low SR latch built with NAND gates"
    }
   ],
   "narration": {
    "en": "Press a doorbell and the sound stops when you let go: no memory. Press a light switch and the light stays on: it remembers. Digital memory starts with two gates that feed each other.",
    "kn": "ಡೋರ್‌ಬೆಲ್ ಒತ್ತಿ ಬಿಟ್ಟರೆ ಶಬ್ದ ನಿಲ್ಲುತ್ತದೆ: ಸ್ಮರಣೆ ಇಲ್ಲ. ದೀಪದ ಸ್ವಿಚ್ ಒತ್ತಿದರೆ ದೀಪ ಉರಿಯುತ್ತಲೇ ಇರುತ್ತದೆ: ಅದು ನೆನಪಿಡುತ್ತದೆ. ಡಿಜಿಟಲ್ ಸ್ಮರಣೆ ಪರಸ್ಪರ ಉಣಿಸುವ ಎರಡು ಗೇಟ್‌ಗಳಿಂದ ಆರಂಭವಾಗುತ್ತದೆ."
   }
