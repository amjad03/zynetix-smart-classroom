   "type": "example",
   "problem": {
    "en": "A NOR SR latch starts with Q = 0. The inputs (S, R) are applied in order: (1, 0), (0, 0), (0, 1), (0, 0). Find Q after each."
   },
   "steps": [
    {
     "en": "(1, 0): set → Q = 1."
    },
    {
     "en": "(0, 0): hold → Q stays 1."
    },
    {
     "en": "(0, 1): reset → Q = 0."
    },
    {
     "en": "(0, 0): hold → Q stays 0."
    }
   ],
   "answer": {
