   "tex": "2.4\\% \\text{ land area},\\ 8.1\\% \\text{ species diversity};\\ 12 \\text{ megadiversity nations}",
   "note": {
    "en": "≈45,000 plant species and twice as many animals."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t2",
   "name": {
