   },
   "tex": "\\text{birds: Colombia} \\approx 1400,\\ \\text{India} > 1200,\\ \\text{New York } 105,\\ \\text{Greenland } 56",
   "note": {
    "en": "Amazon: >40,000 plants, 3000 fishes, 1300 birds, 427 mammals, 427 amphibians, 378 reptiles, >1,25,000 invertebrates."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t2",
   "name": {
    "en": "Why tropics are richer"
   },
   "tex": "\\text{undisturbed (no glaciation), less seasonal, more solar energy}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t2",
   "name": {
    "en": "Species–area relationship"
   },
   "tex": "S = CA^{Z},\\quad \\log S = \\log C + Z \\log A",
   "note": {
    "en": "Alexander von Humboldt."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Z values"
   },
   "tex": "Z = 0.1\\text{–}0.2;\\ \\text{continents } 0.6\\text{–}1.2;\\ \\text{tropical frugivores } 1.15"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t3",
   "name": {
    "en": "Importance of diversity"
   },
   "tex": "\\text{Tilman: more species} \\Rightarrow \\text{less biomass variation, higher productivity}",
   "note": {
    "en": "Rivet popper hypothesis — Paul Ehrlich."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t3",
   "name": {
    "en": "Extinctions (IUCN 2004)"
   },
   "tex": "784 = 338 \\text{ vertebrates} + 359 \\text{ invertebrates} + 87 \\text{ plants}",
   "note": {
    "en": "Dodo (Mauritius), quagga (Africa), thylacine (Australia), Steller's sea cow (Russia); 3 tiger subspecies (Bali, Javan, Caspian). >15,500 species threatened."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t3",
   "name": {
    "en": "Threatened fractions"
   },
   "tex": "\\text{birds } 12\\%,\\ \\text{mammals } 23\\%,\\ \\text{amphibians } 32\\%,\\ \\text{gymnosperms } 31\\%",
   "note": {
    "en": "Sixth extinction is 100–1000 times faster than pre-human rates."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-13-biodiversity-and-conservation.t3",
   "name": {
    "en": "Evil Quartet"
   },
   "tex": "\\text{habitat loss, over-exploitation, alien invasions, co-extinction}",
   "note": {
    "en": "Rain forests 14% → ≤6%; Nile perch → >200 cichlids lost (Lake Victoria); Parthenium, Lantana, water hyacinth; Clarias gariepinus."
