{
 "chapterId": "puc1-maths-13-statistics",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-13-statistics.t1",
   "name": {
    "en": "Range"
   },
   "tex": "\\text{Range} = x_{\\max}-x_{\\min}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-13-statistics.t2",
   "name": {
    "en": "Mean deviation (ungrouped)"
   },
   "tex": "\\text{MD}(a) = \\frac1n\\sum|x_i-a|",
   "note": {
    "en": "a = mean or median; MD about the median is the least"
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-13-statistics.t5",
   "name": {
    "en": "Mean deviation (frequency data)"
   },
   "tex": "\\text{MD}(a) = \\frac{\\sum f_i|x_i-a|}{\\sum f_i}",
   "note": {
    "en": "for classes, x_i is the class mark"
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-13-statistics.t3",
   "name": {
    "en": "Median (grouped)"
   },
   "tex": "M = l+\\frac{\\frac N2-C}{f}\\times h",
   "note": {
    "en": "l lower limit, C cumulative frequency before the median class, f its frequency, h width"
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Variance"
   },
   "tex": "\\sigma^2 = \\frac1n\\sum(x_i-\\bar x)^2 = \\frac{\\sum x_i^2}{n}-\\bar x^2"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-13-statistics.t4",
   "name": {
    "en": "Variance (frequency data)"
   },
   "tex": "\\sigma^2 = \\frac{\\sum f_i(x_i-\\bar x)^2}{N} = \\frac{\\sum f_ix_i^2}{N}-\\bar x^2,\\quad N = \\sum f_i"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Standard deviation"
   },
   "tex": "\\sigma = \\sqrt{\\sigma^2}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-maths-13-statistics.t5",
   "name": {
    "en": "Shortcut (step-deviation) method"
   },
   "tex": "y_i = \\frac{x_i-A}{h}\\ \\Rightarrow\\ \\bar x = A+h\\bar y,\\quad \\sigma_x^2 = h^2\\left[\\frac{\\sum f_iy_i^2}{N}-\\left(\\frac{\\sum f_iy_i}{N}\\right)^2\\right]"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-maths-13-statistics.t4",
   "name": {
    "en": "Change of origin and scale"
   },
   "tex": "y = ax+b\\ \\Rightarrow\\ \\bar y = a\\bar x+b,\\quad \\sigma_y = |a|\\sigma_x,\\quad \\sigma_y^2 = a^2\\sigma_x^2",
   "note": {
    "en": "adding a constant changes the mean only; range, MD, SD unchanged"
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-13-statistics.t1",
   "name": {
    "en": "Coefficient of variation"
   },
   "tex": "\\text{CV} = \\frac{\\sigma}{\\bar x}\\times100",
   "note": {
    "en": "smaller CV = more consistent / less variable; this section was dropped from the rationalised NCERT book, so check your syllabus"
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-13-statistics.t4",
   "name": {
    "en": "Sum of squares from mean and variance"
   },
   "tex": "\\sum x_i^2 = n(\\sigma^2+\\bar x^2)"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-maths-13-statistics.t5",
   "name": {
    "en": "First n natural numbers"
   },
   "tex": "\\bar x = \\frac{n+1}2,\\qquad \\sigma^2 = \\frac{n^2-1}{12}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-13-statistics.t5",
   "name": {
    "en": "Arithmetic progression"
   },
   "tex": "\\sigma(a, a+d, \\dots, a+(n-1)d) = |d|\\sqrt{\\frac{n^2-1}{12}}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-13-statistics.t1",
   "name": {
    "en": "Two observations"
   },
   "tex": "\\sigma = \\frac{|a-b|}2,\\qquad \\text{MD about mean} = \\frac{|a-b|}2"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Combined mean"
   },
   "tex": "\\bar x = \\frac{n_1\\bar x_1+n_2\\bar x_2}{n_1+n_2}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Combined variance"
   },
   "tex": "\\sigma^2 = \\frac{n_1(\\sigma_1^2+d_1^2)+n_2(\\sigma_2^2+d_2^2)}{n_1+n_2},\\quad d_i = \\bar x_i-\\bar x"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-maths-13-statistics.t1",
   "name": {
    "en": "Correcting a wrong observation"
   },
   "tex": "\\sum x\\to\\sum x-x_{\\text{wrong}}+x_{\\text{right}},\\quad \\sum x^2\\to\\sum x^2-x_{\\text{wrong}}^2+x_{\\text{right}}^2",
   "note": {
    "en": "then recompute mean and variance"
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Inequalities"
   },
   "tex": "\\text{MD about mean}\\le\\sigma,\\qquad \\sigma^2\\ge0\\ (=0\\iff\\text{all }x_i\\text{ equal})"
  }
 ]
}
