 "title": {
  "en": "Standard deviation of a continuous frequency distribution",
  "kn": "ನಿರಂತರ ಆವೃತ್ತಿ ವಿತರಣೆಯ ಮಾನಕ ವಿಚಲನೆ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "The spread of a whole class's marks",
    "kn": "ಇಡೀ ತರಗತಿಯ ಅಂಕಗಳ ಹರಡುವಿಕೆ"
   },
   "hook": {
    "en": "Results are often grouped into classes such as 30–40 and 40–50. From such a table we can still find the standard deviation, using the class mid-points.",
    "kn": "ಫಲಿತಾಂಶಗಳನ್ನು 30–40, 40–50 ಎಂಬಂತೆ ವರ್ಗಗಳಾಗಿ ಗುಂಪು ಮಾಡುವುದು ಸಾಮಾನ್ಯ. ಅಂತಹ ಕೋಷ್ಟಕದಿಂದಲೂ ಮಧ್ಯಬಿಂದುಗಳನ್ನು ಬಳಸಿ ಮಾನಕ ವಿಚಲನೆ ಕಂಡುಹಿಡಿಯಬಹುದು."
   },
   "objectives": [
    {
     "en": "Find σ for grouped data using mid-points"
    },
    {
     "en": "Use step deviations to simplify the arithmetic"
    }
   ],
   "narration": {
    "en": "Results are often grouped into classes such as 30–40 and 40–50. From such a table we can still find the standard deviation, using the class mid-points.",
    "kn": "ಫಲಿತಾಂಶಗಳನ್ನು 30–40, 40–50 ಎಂಬಂತೆ ವರ್ಗಗಳಾಗಿ ಗುಂಪು ಮಾಡುವುದು ಸಾಮಾನ್ಯ. ಅಂತಹ ಕೋಷ್ಟಕದಿಂದಲೂ ಮಧ್ಯಬಿಂದುಗಳನ್ನು ಬಳಸಿ ಮಾನಕ ವಿಚಲನೆ ಕಂಡುಹಿಡಿಯಬಹುದು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Using mid-points"
   },
   "body": {
    "en": "Replace each class by its mid-point $x_i$ and treat the table as a discrete distribution: $\\sigma = \\frac1N\\sqrt{N\\sum f_ix_i^2 - \\left(\\sum f_ix_i\\right)^2}$.",
    "kn": "ಪ್ರತಿ ವರ್ಗದ ಎಲ್ಲ ಬೆಲೆಗಳು ಅದರ ಮಧ್ಯಬಿಂದುವಿನಲ್ಲಿವೆ ಎಂದು ಭಾವಿಸಿ, ಆವೃತ್ತಿ ಸೂತ್ರದಿಂದ σ ಕಂಡುಹಿಡಿಯಿರಿ."
   },
   "points": [],
   "narration": {
    "en": "Treat each class as if all its values sat at the mid-point, then use the frequency formula for sigma.",
    "kn": "ಪ್ರತಿ ವರ್ಗದ ಎಲ್ಲ ಬೆಲೆಗಳು ಅದರ ಮಧ್ಯಬಿಂದುವಿನಲ್ಲಿವೆ ಎಂದು ಭಾವಿಸಿ, ಆವೃತ್ತಿ ಸೂತ್ರದಿಂದ σ ಕಂಡುಹಿಡಿಯಿರಿ."
   },
   "formula": "\\sigma = \\frac{1}{N}\\sqrt{N\\sum f_i x_i^2 - \\left(\\sum f_i x_i\\right)^2}"
  },
