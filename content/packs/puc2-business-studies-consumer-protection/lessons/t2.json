  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Who is a consumer?"
   },
   "body": {
    "en": "Under the Consumer Protection Act, 2019, a consumer is a person who buys goods or hires or avails services for a consideration (paid, promised or partly paid), including the user of such goods or beneficiary of such services with the buyer's approval. It includes offline and online transactions. A person who buys goods for resale or for a commercial purpose is not a consumer.",
    "kn": "ಗ್ರಾಹಕರ ಸಂರಕ್ಷಣಾ ಕಾಯ್ದೆ 2019ರ ಪ್ರಕಾರ, ಪ್ರತಿಫಲಕ್ಕೆ ಸರಕು ಕೊಳ್ಳುವ ಅಥವಾ ಸೇವೆ ಪಡೆಯುವ ವ್ಯಕ್ತಿ ಗ್ರಾಹಕ. ಮರುಮಾರಾಟ ಅಥವಾ ವಾಣಿಜ್ಯ ಉದ್ದೇಶಕ್ಕೆ ಕೊಳ್ಳುವವನು ಗ್ರಾಹಕನಲ್ಲ."
   },
   "points": [
    {
     "en": "Includes online purchases"
    },
    {
     "en": "Includes the user with the buyer's approval"
    },
    {
     "en": "Excludes purchase for resale or commercial purpose"
    }
   ],
   "narration": {
    "en": "Under the Consumer Protection Act, 2019, a consumer is a person who buys goods or hires or avails services for a consideration (paid, promised or partly paid), including the user of such goods or beneficiary of such services with the buyer's approval. It includes offline and online transactions. A person who buys goods for resale or for a commercial purpose is not a consumer.",
    "kn": "ಗ್ರಾಹಕರ ಸಂರಕ್ಷಣಾ ಕಾಯ್ದೆ 2019ರ ಪ್ರಕಾರ, ಪ್ರತಿಫಲಕ್ಕೆ ಸರಕು ಕೊಳ್ಳುವ ಅಥವಾ ಸೇವೆ ಪಡೆಯುವ ವ್ಯಕ್ತಿ ಗ್ರಾಹಕ. ಮರುಮಾರಾಟ ಅಥವಾ ವಾಣಿಜ್ಯ ಉದ್ದೇಶಕ್ಕೆ ಕೊಳ್ಳುವವನು ಗ್ರಾಹಕನಲ್ಲ."
