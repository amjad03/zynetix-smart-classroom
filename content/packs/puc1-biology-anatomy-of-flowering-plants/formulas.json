{
 "chapterId": "puc1-biology-06-anatomy-of-flowering-plants",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t1",
   "name": {
    "en": "Meristems"
   },
   "tex": "\\text{primary: apical, intercalary};\\ \\text{secondary: vascular and cork cambium}"
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Parenchyma"
   },
   "tex": "\\text{isodiametric, thin cellulose walls; photosynthesis, storage}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t2",
   "name": {
    "en": "Collenchyma"
   },
   "tex": "\\text{corner thickening (cellulose, hemicellulose, pectin); no spaces}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t2",
   "name": {
    "en": "Sclerenchyma"
   },
   "tex": "\\text{fibres + sclereids; dead, lignified}",
   "note": {
    "en": "Sclereids: nut walls, guava, pear, sapota, legume seed coats, tea leaves."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t3",
   "name": {
    "en": "Xylem elements"
   },
   "tex": "\\text{tracheids, vessels, fibres (dead)};\\ \\text{xylem parenchyma (living)}",
   "note": {
    "en": "Vessels absent in gymnosperms."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t3",
   "name": {
    "en": "Phloem elements"
   },
   "tex": "\\text{sieve tubes, companion cells, phloem parenchyma, fibres}",
   "note": {
    "en": "Gymnosperms: sieve cells + albuminous cells. Phloem parenchyma absent in most monocots."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Xylem position"
   },
   "tex": "\\text{stem: endarch};\\ \\text{root: exarch}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t1",
   "name": {
    "en": "Primary phloem"
   },
   "tex": "\\text{protophloem (narrow)} \\to \\text{metaphloem (wide)}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t4",
   "name": {
    "en": "Tissue systems"
   },
   "tex": "\\text{epidermal},\\ \\text{ground},\\ \\text{vascular}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t4",
   "name": {
    "en": "Guard cells"
   },
   "tex": "\\text{bean-shaped (dumb-bell in grasses); inner wall thick}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t4",
   "name": {
    "en": "Vascular bundles"
   },
   "tex": "\\text{radial (root)};\\ \\text{conjoint open (dicot stem)};\\ \\text{conjoint closed (monocot)}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t5",
   "name": {
    "en": "Dicot root"
   },
   "tex": "2\\text{–}4\\ \\text{xylem patches; small pith; Casparian strips (suberin)}",
   "note": {
    "en": "Stele = pericycle + vascular bundles + pith."
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Monocot root"
   },
   "tex": ">6\\ \\text{(polyarch); large pith; no secondary growth}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t4",
   "name": {
    "en": "Dicot stem"
   },
   "tex": "\\text{collenchymatous hypodermis; starch sheath; ring of bundles}"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Monocot stem"
   },
   "tex": "\\text{sclerenchymatous hypodermis; scattered bundles; water cavities}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t6",
   "name": {
    "en": "Dorsiventral leaf"
   },
   "tex": "\\text{palisade (adaxial)} + \\text{spongy};\\ \\text{more stomata abaxially}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-06-anatomy-of-flowering-plants.t6",
   "name": {
    "en": "Isobilateral leaf"
   },
   "tex": "\\text{stomata on both sides; undifferentiated mesophyll; bulliform cells}"
  }
 ]
}
