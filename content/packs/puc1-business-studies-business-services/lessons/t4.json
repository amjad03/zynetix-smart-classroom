   "vars": [
    {
     "name": "sp",
     "expr": "if(md == 1, 50, if(md == 2, 40, if(md == 3, 600, 25)))"
    },
    {
     "name": "rate",
     "expr": "if(md == 1, 4, if(md == 2, 2.5, if(md == 3, 30, 1.5)))"
    },
    {
     "name": "fix",
     "expr": "if(md == 1, 500, if(md == 2, 3000, if(md == 3, 8000, 10000)))"
    },
    {
     "name": "hrs",
     "expr": "km/sp + if(md == 1, 1, if(md == 2, 6, if(md == 3, 4, 12)))"
    },
    {
     "name": "cost",
     "expr": "fix + rate*km*tn"
    },
    {
     "name": "prog",
     "expr": "clamp(t/hrs, 0, 1)"
    },
    {
     "name": "arrived",
     "expr": "t >= hrs"
