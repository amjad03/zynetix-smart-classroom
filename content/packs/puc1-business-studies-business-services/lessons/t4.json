  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Postal and telecom services"
   },
   "body": {
    "en": "India Post provides financial facilities such as savings schemes and money orders, mail facilities such as parcels, registration and insurance of letters, and allied services such as Speed Post. Telecom services include cellular mobile, fixed line, cable services, VSAT satellite links and DTH, which beams television directly to homes through a small dish."
   },
   "points": [
    {
     "en": "Post: financial, mail and allied facilities"
    },
    {
     "en": "Telecom: cellular, fixed line, cable, VSAT, DTH"
    }
   ],
   "narration": {
    "en": "India Post provides financial facilities such as savings schemes and money orders, mail facilities such as parcels, registration and insurance of letters, and allied services such as Speed Post. Telecom services include cellular mobile, fixed line, cable services, VSAT satellite links and DTH, which beams television directly to homes through a small dish.",
    "kn": "ಅಂಚೆ ಇಲಾಖೆ ಹಣಕಾಸು, ಅಂಚೆ ಮತ್ತು ಪೂರಕ ಸೇವೆಗಳನ್ನು ನೀಡುತ್ತದೆ. ದೂರಸಂಪರ್ಕ ಸೇವೆಗಳಲ್ಲಿ ಮೊಬೈಲ್, ಸ್ಥಿರ ದೂರವಾಣಿ, ಕೇಬಲ್, ವಿಸ್ಯಾಟ್ ಮತ್ತು ಡಿಟಿಎಚ್ ಸೇರಿವೆ."
   }
  },
