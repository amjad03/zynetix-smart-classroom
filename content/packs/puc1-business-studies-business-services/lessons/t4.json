  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Connecting buyers and sellers",
    "kn": "ಕೊಳ್ಳುವವರು ಮತ್ತು ಮಾರುವವರನ್ನು ಜೋಡಿಸುವುದು"
   },
   "hook": {
    "en": "An order placed on a phone call, a confirmation by courier and a truck carrying the goods: business needs communication and transport at every step.",
    "kn": "ಫೋನ್ ಕರೆಯ ಮೂಲಕ ಆರ್ಡರ್, ಅಂಚೆಯ ಮೂಲಕ ದೃಢೀಕರಣ, ಲಾರಿಯಲ್ಲಿ ಸರಕು ಸಾಗಣೆ – ವ್ಯವಹಾರಕ್ಕೆ ಪ್ರತಿ ಹಂತದಲ್ಲೂ ಸಂಪರ್ಕ ಮತ್ತು ಸಾರಿಗೆ ಬೇಕು."
   },
   "objectives": [
    {
     "en": "Describe postal and telecom services"
    },
    {
     "en": "Explain the role of transport in business"
    }
   ],
   "narration": {
    "en": "An order placed on a phone call, a confirmation by courier and a truck carrying the goods: business needs communication and transport at every step.",
    "kn": "ಫೋನ್ ಕರೆಯ ಮೂಲಕ ಆರ್ಡರ್, ಅಂಚೆಯ ಮೂಲಕ ದೃಢೀಕರಣ, ಲಾರಿಯಲ್ಲಿ ಸರಕು ಸಾಗಣೆ – ವ್ಯವಹಾರಕ್ಕೆ ಪ್ರತಿ ಹಂತದಲ್ಲೂ ಸಂಪರ್ಕ ಮತ್ತು ಸಾರಿಗೆ ಬೇಕು."
   }
