  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Services versus goods; types of services"
   },
   "body": {
    "en": "Goods are tangible, can be stored, are standardised and their ownership passes to the buyer; services are intangible, cannot be stored, vary each time and give no ownership. Services are of three types: business services such as banking, insurance, transport, warehousing and communication; social services such as health care and education provided voluntarily; and personal services such as tourism, recreation and restaurants."
   },
   "points": [
    {
     "en": "Goods: tangible, storable, standard, ownership transferred"
    },
    {
     "en": "Services: intangible, perishable, varied, no ownership"
    },
    {
     "en": "Business, social and personal services"
    }
   ],
   "narration": {
    "en": "Goods are tangible, can be stored, are standardised and their ownership passes to the buyer; services are intangible, cannot be stored, vary each time and give no ownership. Services are of three types: business services such as banking, insurance, transport, warehousing and communication; social services such as health care and education provided voluntarily; and personal services such as tourism, recreation and restaurants.",
    "kn": "ಸರಕುಗಳು ಮೂರ್ತ, ಸಂಗ್ರಹಿಸಬಹುದಾದವು; ಸೇವೆಗಳು ಅಮೂರ್ತ. ಸೇವೆಗಳು ವ್ಯವಹಾರ, ಸಾಮಾಜಿಕ ಮತ್ತು ವೈಯಕ್ತಿಕ ಎಂಬ ಮೂರು ಪ್ರಕಾರ."
   }
