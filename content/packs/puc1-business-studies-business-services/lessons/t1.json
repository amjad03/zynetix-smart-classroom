  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Nature of services: the five I's"
   },
   "body": {
    "en": "Services are intangible, so they cannot be touched and are judged by experience. They are inconsistent because each customer's need differs, inseparable because production and consumption happen together, they cannot be stored (inventory less), and they involve the customer in their delivery."
   },
   "points": [
    {
     "en": "Intangibility"
    },
    {
     "en": "Inconsistency"
    },
    {
     "en": "Inseparability"
    },
    {
     "en": "Inventory (less)"
    },
    {
     "en": "Involvement"
    }
   ],
   "narration": {
    "en": "Services are intangible, so they cannot be touched and are judged by experience. They are inconsistent because each customer's need differs, inseparable because production and consumption happen together, they cannot be stored (inventory less), and they involve the customer in their delivery.",
    "kn": "ಸೇವೆಗಳು ಅಮೂರ್ತ, ಅಸ್ಥಿರ, ಬೇರ್ಪಡಿಸಲಾಗದವು, ಸಂಗ್ರಹಿಸಲಾಗದವು ಮತ್ತು ಗ್ರಾಹಕರ ಪಾಲ್ಗೊಳ್ಳುವಿಕೆ ಇರುವಂತಹವು."
   }
