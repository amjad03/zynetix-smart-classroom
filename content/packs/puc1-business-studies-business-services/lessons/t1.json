 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "You can't hold a haircut",
    "kn": "ಕ್ಷೌರವನ್ನು ಕೈಯಲ್ಲಿ ಹಿಡಿಯಲಾಗದು"
   },
   "hook": {
    "en": "You can touch a shirt before buying it, but you cannot touch a bus ride or a bank transfer. Services are different from goods, and that changes how they are sold.",
    "kn": "ಅಂಗಿಯನ್ನು ಖರೀದಿಸುವ ಮೊದಲು ಮುಟ್ಟಬಹುದು, ಆದರೆ ಬಸ್ ಪ್ರಯಾಣ ಅಥವಾ ಬ್ಯಾಂಕ್ ವರ್ಗಾವಣೆಯನ್ನು ಮುಟ್ಟಲಾಗದು. ಸೇವೆಗಳು ಸರಕುಗಳಿಗಿಂತ ಭಿನ್ನ."
   },
   "objectives": [
    {
     "en": "Explain the five features of services"
    },
    {
     "en": "Distinguish services from goods"
    },
    {
     "en": "Classify services into business, social and personal"
    }
   ],
   "narration": {
    "en": "You can touch a shirt before buying it, but you cannot touch a bus ride or a bank transfer. Services are different from goods, and that changes how they are sold.",
    "kn": "ಅಂಗಿಯನ್ನು ಖರೀದಿಸುವ ಮೊದಲು ಮುಟ್ಟಬಹುದು, ಆದರೆ ಬಸ್ ಪ್ರಯಾಣ ಅಥವಾ ಬ್ಯಾಂಕ್ ವರ್ಗಾವಣೆಯನ್ನು ಮುಟ್ಟಲಾಗದು. ಸೇವೆಗಳು ಸರಕುಗಳಿಗಿಂತ ಭಿನ್ನ."
   }
