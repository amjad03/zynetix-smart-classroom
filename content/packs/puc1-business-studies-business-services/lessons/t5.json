  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Functions of warehousing"
   },
   "body": {
    "en": "Warehousing consolidates goods from different plants into one shipment, breaks the bulk into smaller lots, stock piles seasonal goods, offers value-added services such as packing and grading, stabilises prices by matching supply with demand, and helps in financing because the warehouse receipt can be pledged for a loan. Overall, it removes the hindrance of time."
   },
   "points": [
    {
     "en": "Consolidation"
    },
    {
     "en": "Break the bulk"
    },
    {
     "en": "Stock piling"
    },
    {
     "en": "Value-added services"
    },
    {
     "en": "Price stabilisation"
    },
    {
     "en": "Financing"
    }
   ],
   "narration": {
    "en": "Warehousing consolidates goods from different plants into one shipment, breaks the bulk into smaller lots, stock piles seasonal goods, offers value-added services such as packing and grading, stabilises prices by matching supply with demand, and helps in financing because the warehouse receipt can be pledged for a loan. Overall, it removes the hindrance of time.",
    "kn": "ಉಗ್ರಾಣಗಳು ಸರಕುಗಳ ಒಗ್ಗೂಡಿಸುವಿಕೆ, ಸಣ್ಣ ಪ್ರಮಾಣಕ್ಕೆ ವಿಭಜನೆ, ಸಂಗ್ರಹಣೆ, ಮೌಲ್ಯವರ್ಧಿತ ಸೇವೆ, ಬೆಲೆ ಸ್ಥಿರೀಕರಣ ಮತ್ತು ಹಣಕಾಸು ನೆರವು ನೀಡುತ್ತವೆ."
   }
