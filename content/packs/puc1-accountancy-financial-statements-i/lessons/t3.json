  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Sri Rama Traders has gross profit ₹72,000. Other items: salaries ₹18,000; rent ₹6,000; carriage outwards ₹2,000; advertisement ₹4,000; interest on loan ₹3,000; loss by fire ₹5,000; discount received ₹1,000; dividend received on investments ₹2,000. Find net profit and operating profit."
   },
   "steps": [
    {
     "en": "Indirect expenses and losses: 18,000 + 6,000 + 2,000 + 4,000 + 3,000 + 5,000 = ₹38,000."
    },
    {
     "en": "Net profit = 72,000 + 1,000 + 2,000 − 38,000 = ₹37,000."
    },
    {
     "en": "Operating profit = 37,000 + 3,000 (interest on loan) + 5,000 (loss by fire) − 2,000 (dividend) = ₹43,000."
    },
    {
     "en": "Check: GP 72,000 − operating expenses 30,000 + discount received 1,000 = ₹43,000."
    }
   ],
   "answer": {
    "en": "Net profit ₹37,000; operating profit ₹43,000."
   },
   "narration": {
    "en": "Let us work this out together. Sri Rama Traders has gross profit ₹72,000. Other items: salaries ₹18,000; rent ₹6,000; carriage outwards ₹2,000; advertisement ₹4,000; interest on loan ₹3,000; loss by fire ₹5,000; discount received ₹1,000; dividend received on investments ₹2,000. Find net profit and operating profit."
   }
