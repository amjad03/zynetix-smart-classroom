   "title": {
    "en": "Operating profit"
   },
   "body": {
    "en": "Operating profit is the profit from the normal business operations. It excludes non-operating items such as interest on loans, loss on sale of assets, loss by fire, dividends and interest received on investments, and profit on sale of assets."
   },
   "points": [
    {
     "en": "Add back non-operating expenses and losses"
    },
    {
     "en": "Deduct non-operating incomes"
    }
   ],
   "narration": {
    "en": "Operating profit is the profit from the normal business operations. It excludes non-operating items such as interest on loans, loss on sale of assets, loss by fire, dividends and interest received on investments, and profit on sale of assets.",
    "kn": "ಕಾರ್ಯಾಚರಣೆ ಲಾಭ ಎಂದರೆ ಸಾಮಾನ್ಯ ವ್ಯವಹಾರ ಚಟುವಟಿಕೆಗಳಿಂದ ಬರುವ ಲಾಭ. ಇದರಲ್ಲಿ ಸಾಲದ ಬಡ್ಡಿ, ಆಸ್ತಿ ಮಾರಾಟ ನಷ್ಟ, ಹೂಡಿಕೆಯ ಆದಾಯದಂತಹ ಕಾರ್ಯಾಚರಣೆಯಲ್ಲದ ಅಂಶಗಳು ಸೇರುವುದಿಲ್ಲ."
   },
   "formula": "\\text{Operating profit} = \\text{Net profit} + \\text{Non-operating expenses} - \\text{Non-operating incomes}"
  },
