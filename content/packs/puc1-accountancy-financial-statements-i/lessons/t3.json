   "heading": {
    "en": "From gross profit to net profit",
    "kn": "ಒಟ್ಟು ಲಾಭದಿಂದ ನಿವ್ವಳ ಲಾಭದವರೆಗೆ"
   },
   "hook": {
    "en": "The store made ₹72,000 gross profit. After paying salaries, rent and interest, how much is really left for the owner?",
    "kn": "ಅಂಗಡಿ ₹72,000 ಒಟ್ಟು ಲಾಭ ಗಳಿಸಿತು. ಸಂಬಳ, ಬಾಡಿಗೆ ಮತ್ತು ಬಡ್ಡಿ ಕೊಟ್ಟ ನಂತರ ಮಾಲೀಕನಿಗೆ ನಿಜವಾಗಿ ಎಷ್ಟು ಉಳಿಯುತ್ತದೆ?"
   },
   "objectives": [
    {
     "en": "Prepare a profit and loss account."
    },
    {
     "en": "Classify indirect expenses."
    },
    {
     "en": "Calculate operating profit."
    }
   ],
   "narration": {
    "en": "The store made ₹72,000 gross profit. After paying salaries, rent and interest, how much is really left for the owner?",
    "kn": "ಅಂಗಡಿ ₹72,000 ಒಟ್ಟು ಲಾಭ ಗಳಿಸಿತು. ಸಂಬಳ, ಬಾಡಿಗೆ ಮತ್ತು ಬಡ್ಡಿ ಕೊಟ್ಟ ನಂತರ ಮಾಲೀಕನಿಗೆ ನಿಜವಾಗಿ ಎಷ್ಟು ಉಳಿಯುತ್ತದೆ?"
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The profit and loss account"
   },
   "body": {
    "en": "It starts with gross profit on the credit side. Debit side: indirect expenses (office and administration such as salaries, rent, printing; selling and distribution such as carriage outwards, advertising; financial such as interest on loan; and losses such as loss by fire, depreciation). Credit side: other incomes such as discount received, commission received, interest and dividend received. The balance is net profit or net loss, transferred to capital."
   },
   "points": [
    {
     "en": "Office and administration expenses"
    },
    {
     "en": "Selling and distribution expenses"
    },
    {
     "en": "Financial expenses and abnormal losses"
    },
    {
     "en": "Other incomes on the credit side"
    }
   ],
   "narration": {
    "en": "It starts with gross profit on the credit side. Debit side: indirect expenses (office and administration such as salaries, rent, printing; selling and distribution such as carriage outwards, advertising; financial such as interest on loan; and losses such as loss by fire, depreciation). Credit side: other incomes such as discount received, commission received, interest and dividend received. The balance is net profit or net loss, transferred to capital.",
    "kn": "ಲಾಭ ನಷ್ಟ ಖಾತೆಯ ಕ್ರೆಡಿಟ್‌ನಲ್ಲಿ ಒಟ್ಟು ಲಾಭ ಮತ್ತು ಇತರ ಆದಾಯಗಳು, ಡೆಬಿಟ್‌ನಲ್ಲಿ ಪರೋಕ್ಷ ವೆಚ್ಚಗಳು ಮತ್ತು ನಷ್ಟಗಳು ಬರುತ್ತವೆ. ಬಾಕಿಯೇ ನಿವ್ವಳ ಲಾಭ ಅಥವಾ ನಷ್ಟ."
   },
   "formula": "\\text{Net profit} = \\text{Gross profit} + \\text{Other incomes} - \\text{Indirect expenses}"
  },
