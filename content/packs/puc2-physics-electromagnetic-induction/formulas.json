{
 "chapterId": "puc2-physics-06-electromagnetic-induction",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-06-electromagnetic-induction.t1",
   "name": {
    "en": "Magnetic flux"
   },
   "tex": "\\Phi = \\vec B\\cdot\\vec A = BA\\cos\\theta",
   "note": {
    "en": "theta is between B and the normal; unit weber."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-06-electromagnetic-induction.t2",
   "name": {
    "en": "Faraday's law with Lenz's sign"
   },
   "tex": "\\varepsilon = -N\\frac{d\\Phi}{dt}",
   "note": {
    "en": "Lenz's law follows from energy conservation."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-06-electromagnetic-induction.t3",
   "name": {
    "en": "Charge through a circuit"
   },
   "tex": "Q = \\frac{N\\,\\Delta\\Phi}{R}",
   "note": {
    "en": "Independent of the time taken."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-06-electromagnetic-induction.t3",
   "name": {
    "en": "Motional emf"
   },
   "tex": "\\varepsilon = Blv,\\quad \\varepsilon = \\int(\\vec v\\times\\vec B)\\cdot d\\vec l"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-06-electromagnetic-induction.t3",
   "name": {
    "en": "Rod / disc rotating about one end"
   },
   "tex": "\\varepsilon = \\tfrac12 B\\omega l^2",
   "note": {
    "en": "About midpoint: zero end-to-end."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-06-electromagnetic-induction.t3",
   "name": {
    "en": "Rod on rails with R"
   },
   "tex": "F = \\frac{B^2l^2v}{R},\\quad P = \\frac{B^2l^2v^2}{R},\\quad v_t = \\frac{mgR}{B^2l^2}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-06-electromagnetic-induction.t3",
   "name": {
    "en": "Rod on rails with C, force F"
   },
   "tex": "a = \\frac{F}{m + CB^2l^2}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-06-electromagnetic-induction.t1",
   "name": {
    "en": "Induced electric field"
   },
   "tex": "\\oint\\vec E\\cdot d\\vec l = -\\frac{d\\Phi_B}{dt}",
   "note": {
    "en": "Non-conservative. Solenoid: E = (r/2)dB/dt inside, (R^2/2r)dB/dt outside."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-06-electromagnetic-induction.t4",
   "name": {
    "en": "Self-inductance"
   },
   "tex": "N\\Phi = LI,\\quad \\varepsilon = -L\\frac{dI}{dt},\\quad L_{sol} = \\frac{\\mu_0\\mu_r N^2 A}{l}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-06-electromagnetic-induction.t4",
   "name": {
    "en": "Mutual inductance"
   },
   "tex": "N_2\\Phi_2 = MI_1,\\quad M = \\mu_0 n_1 N_2 A_2,\\quad M = k\\sqrt{L_1L_2}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-06-electromagnetic-induction.t5",
   "name": {
    "en": "Concentric coplanar rings (a much less than b)"
   },
   "tex": "M = \\frac{\\mu_0\\pi a^2}{2b}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Inductors in series (coupled)"
   },
   "tex": "L = L_1 + L_2 \\pm 2M"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-06-electromagnetic-induction.t2",
   "name": {
    "en": "Magnetic energy"
   },
   "tex": "U = \\tfrac12 LI^2,\\quad u = \\frac{B^2}{2\\mu_0}"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "LR growth"
   },
   "tex": "i = \\frac{\\varepsilon}{R}\\left(1 - e^{-t/\\tau}\\right),\\quad \\tau = \\frac{L}{R}",
   "note": {
    "en": "t = tau: 63%; half current at tau ln 2."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-06-electromagnetic-induction.t3",
   "name": {
    "en": "LR decay"
   },
   "tex": "i = i_0e^{-t/\\tau}",
   "note": {
    "en": "Ideal inductor: open circuit at t = 0+, wire in steady DC."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-06-electromagnetic-induction.t5",
   "name": {
    "en": "AC generator"
   },
   "tex": "\\varepsilon = NBA\\omega\\sin\\omega t,\\quad \\varepsilon_0 = NBA\\omega",
   "note": {
    "en": "emf max when coil plane is parallel to B (flux zero)."
   }
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Eddy currents"
   },
   "tex": "\\text{reduce by lamination; used in brakes, damping, induction furnace}"
  }
 ]
}
