{
 "chapterId": "puc1-physics-08-mechanical-properties-of-solids",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t4",
   "name": {
    "en": "Stress"
   },
   "tex": "\\text{stress} = \\dfrac{F}{A}\\quad(\\text{Pa} = \\text{N m}^{-2})",
   "note": {
    "en": "Tensile/compressive (normal), shearing (tangential) or hydraulic (pressure)."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Strains"
   },
   "tex": "\\text{longitudinal} = \\dfrac{\\Delta L}{L},\\quad \\text{shear} = \\theta \\approx \\dfrac{\\Delta x}{L},\\quad \\text{volume} = \\dfrac{\\Delta V}{V}",
   "note": {
    "en": "All strains are dimensionless."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t2",
   "name": {
    "en": "Hooke's law"
   },
   "tex": "\\text{stress} = k\\times\\text{strain}",
   "note": {
    "en": "Valid up to the proportional limit."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t3",
   "name": {
    "en": "Young's modulus"
   },
   "tex": "Y = \\dfrac{F/A}{\\Delta L/L} = \\dfrac{FL}{A\\,\\Delta L}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t3",
   "name": {
    "en": "Extension of a wire"
   },
   "tex": "\\Delta L = \\dfrac{FL}{AY} = \\dfrac{4FL}{\\pi d^2Y}",
   "note": {
    "en": "Same material and load: ΔL ∝ L/d²."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t4",
   "name": {
    "en": "Shear modulus (rigidity)"
   },
   "tex": "G = \\dfrac{F_t/A}{\\theta}",
   "note": {
    "en": "Shape changes, volume does not; G = 0 for fluids."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t4",
   "name": {
    "en": "Bulk modulus and compressibility"
   },
   "tex": "B = -\\dfrac{\\Delta p}{\\Delta V/V},\\qquad k = \\dfrac1B"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t4",
   "name": {
    "en": "Bulk modulus of an ideal gas"
   },
   "tex": "B_{\\text{iso}} = p,\\qquad B_{\\text{adia}} = \\gamma p"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t3",
   "name": {
    "en": "Poisson's ratio"
   },
   "tex": "\\sigma = \\dfrac{-\\Delta d/d}{\\Delta L/L},\\quad -1 < \\sigma < 0.5",
   "note": {
    "en": "σ = 0.5 means no volume change; practical values 0.2–0.4."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t1",
   "name": {
    "en": "Volume change of a stretched rod"
   },
   "tex": "\\dfrac{\\Delta V}{V} = \\dfrac{\\Delta L}{L}(1 - 2\\sigma)"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Relations between moduli"
   },
   "tex": "Y = 2G(1 + \\sigma) = 3B(1 - 2\\sigma)"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Elastic energy"
   },
   "tex": "U = \\tfrac12F\\,\\Delta L,\\qquad u = \\tfrac12\\,\\text{stress}\\times\\text{strain} = \\dfrac{\\text{stress}^2}{2Y}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t2",
   "name": {
    "en": "Wire as a spring"
   },
   "tex": "k = \\dfrac{YA}{L}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t5",
   "name": {
    "en": "Elongation under own weight"
   },
   "tex": "\\Delta L = \\dfrac{MgL}{2AY} = \\dfrac{\\rho gL^2}{2Y}",
   "note": {
    "en": "Equivalent to the full weight acting at the midpoint."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t5",
   "name": {
    "en": "Maximum length that hangs without breaking"
   },
   "tex": "L_{\\max} = \\dfrac{\\text{breaking stress}}{\\rho g}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Thermal stress in a clamped rod"
   },
   "tex": "\\text{stress} = Y\\alpha\\,\\Delta T,\\qquad F = YA\\alpha\\,\\Delta T"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-08-mechanical-properties-of-solids.t3",
   "name": {
    "en": "Typical Young's moduli"
   },
   "tex": "Y_{\\text{steel}} \\approx 2\\times10^{11}\\ \\text{Pa},\\ Y_{\\text{Cu}} \\approx 1.1\\times10^{11}\\ \\text{Pa}",
   "note": {
    "en": "Steel is 'more elastic' than rubber: larger Y."
   }
  }
 ]
}
