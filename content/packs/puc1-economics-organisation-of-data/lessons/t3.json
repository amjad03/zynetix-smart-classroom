   "title": {
    "en": "Designing classes"
   },
   "caption": {
    "en": "Choose the smallest value, the largest value and the class width. See how many classes you need and the class mark of the first class."
   },
   "narration": {
    "en": "Plan the classes of a frequency distribution."
   },
   "sliders": [
    {
     "name": "a",
     "label": {
      "en": "Smallest value"
     },
     "min": 0,
     "max": 50,
     "step": 1,
     "value": 12
    },
    {
     "name": "b",
     "label": {
      "en": "Largest value"
     },
     "min": 50,
     "max": 200,
     "step": 1,
     "value": 87
    },
    {
     "name": "h",
     "label": {
      "en": "Class width"
     },
     "min": 2,
     "max": 25,
     "step": 1,
     "value": 10
    }
   ],
   "readouts": [
    {
     "label": {
      "en": "Range"
     },
     "expr": "b - a",
     "digits": 0
    },
    {
     "label": {
      "en": "Number of classes"
     },
     "expr": "-floor(-(b - a)/h)",
     "digits": 0
    },
    {
     "label": {
      "en": "Class mark of first class"
     },
     "expr": "a + h/2",
     "digits": 1
    }
   ],
   "tryThis": [
    {
