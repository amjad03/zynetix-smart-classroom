 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Twenty numbers, four boxes",
    "kn": "ಇಪ್ಪತ್ತು ಸಂಖ್ಯೆ, ನಾಲ್ಕು ಪೆಟ್ಟಿಗೆ"
   },
   "hook": {
    "en": "Twenty marks written in a row tell you very little. Put them into four boxes and suddenly you can see where most students stand.",
    "kn": "ಸಾಲಾಗಿ ಬರೆದ ಇಪ್ಪತ್ತು ಅಂಕಗಳು ಹೆಚ್ಚೇನೂ ಹೇಳುವುದಿಲ್ಲ. ನಾಲ್ಕು ಪೆಟ್ಟಿಗೆಗಳಲ್ಲಿ ಹಾಕಿದರೆ ಹೆಚ್ಚಿನ ವಿದ್ಯಾರ್ಥಿಗಳು ಎಲ್ಲಿದ್ದಾರೆ ಎಂದು ಕಾಣುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Define class limits, class interval, class mark and frequency"
    },
    {
     "en": "Prepare a frequency distribution with tally marks"
    }
   ],
   "narration": {
    "en": "Twenty marks written in a row tell you very little. Put them into four boxes and suddenly you can see where most students stand.",
    "kn": "ಸಾಲಾಗಿ ಬರೆದ ಇಪ್ಪತ್ತು ಅಂಕಗಳು ಹೆಚ್ಚೇನೂ ಹೇಳುವುದಿಲ್ಲ. ನಾಲ್ಕು ಪೆಟ್ಟಿಗೆಗಳಲ್ಲಿ ಹಾಕಿದರೆ ಹೆಚ್ಚಿನ ವಿದ್ಯಾರ್ಥಿಗಳು ಎಲ್ಲಿದ್ದಾರೆ ಎಂದು ಕಾಣುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Terms of a frequency distribution"
   },
   "body": {
    "en": "A frequency distribution shows how the values of a variable are spread across classes. Each class has a lower class limit and an upper class limit. The class interval (width) is upper limit minus lower limit. The class mark (mid-value) is the average of the two limits. The frequency is the number of observations in the class.",
    "kn": "ಆವರ್ತನ ವಿತರಣೆ ಮೌಲ್ಯಗಳು ವರ್ಗಗಳಲ್ಲಿ ಹೇಗೆ ಹಂಚಿಕೆಯಾಗಿವೆ ಎಂದು ತೋರಿಸುತ್ತದೆ. ವರ್ಗಾಂತರ = ಮೇಲಿನ ಮಿತಿ − ಕೆಳಗಿನ ಮಿತಿ. ವರ್ಗ ಮಧ್ಯಬಿಂದು = ಎರಡು ಮಿತಿಗಳ ಸರಾಸರಿ."
   },
   "points": [
    {
     "en": "Class width = upper limit − lower limit"
    },
    {
     "en": "Class mark = (upper + lower) ÷ 2"
    },
    {
     "en": "Frequency = count in the class"
    }
   ],
   "narration": {
    "en": "A frequency distribution shows how the values of a variable are spread across classes. Each class has a lower class limit and an upper class limit. The class interval (width) is upper limit minus lower limit. The class mark (mid-value) is the average of the two limits. The frequency is the number of observations in the class.",
    "kn": "ಆವರ್ತನ ವಿತರಣೆ ಮೌಲ್ಯಗಳು ವರ್ಗಗಳಲ್ಲಿ ಹೇಗೆ ಹಂಚಿಕೆಯಾಗಿವೆ ಎಂದು ತೋರಿಸುತ್ತದೆ. ವರ್ಗಾಂತರ = ಮೇಲಿನ ಮಿತಿ − ಕೆಳಗಿನ ಮಿತಿ. ವರ್ಗ ಮಧ್ಯಬಿಂದು = ಎರಡು ಮಿತಿಗಳ ಸರಾಸರಿ."
   },
   "formula": "\\text{Class mark} = \\frac{\\text{Upper limit} + \\text{Lower limit}}{2}"
  },
