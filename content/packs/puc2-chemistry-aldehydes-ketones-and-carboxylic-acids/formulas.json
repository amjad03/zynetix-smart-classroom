{
 "chapterId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t2",
   "name": {
    "en": "Rosenmund reduction"
   },
   "tex": "\\text{RCOCl} \\xrightarrow{\\text{H}_2,\\ \\text{Pd–BaSO}_4} \\text{RCHO}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t2",
   "name": {
    "en": "Stephen reaction"
   },
   "tex": "\\text{RCN} \\xrightarrow{\\text{SnCl}_2/\\text{HCl}} \\text{RCH{=}NH} \\xrightarrow{\\text{H}_3\\text{O}^+} \\text{RCHO}",
   "note": {
    "en": "DIBAL-H also reduces nitriles / esters to aldehydes."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t2",
   "name": {
    "en": "Etard reaction"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{CH}_3 \\xrightarrow{\\text{CrO}_2\\text{Cl}_2,\\ \\text{CS}_2;\\ \\text{H}_3\\text{O}^+} \\text{C}_6\\text{H}_5\\text{CHO}",
   "note": {
    "en": "Also: CrO₃/(CH₃CO)₂O then hydrolysis; side-chain Cl₂/hν to C₆H₅CHCl₂ then H₂O."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t2",
   "name": {
    "en": "Gattermann–Koch reaction"
   },
   "tex": "\\text{C}_6\\text{H}_6 \\xrightarrow{\\text{CO},\\ \\text{HCl},\\ \\text{AlCl}_3/\\text{CuCl}} \\text{C}_6\\text{H}_5\\text{CHO}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t2",
   "name": {
    "en": "Ketones from nitriles / Friedel–Crafts"
   },
   "tex": "\\text{RCN} + \\text{R}'\\text{MgX} \\xrightarrow{\\text{H}_3\\text{O}^+} \\text{RCOR}';\\quad \\text{ArH} + \\text{RCOCl} \\xrightarrow{\\text{AlCl}_3} \\text{ArCOR}",
   "note": {
    "en": "Also 2 RCOCl + R′₂Cd → 2 RCOR′."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Nucleophilic addition reactivity"
   },
   "tex": "\\text{HCHO} > \\text{RCHO} > \\text{R}_2\\text{CO};\\quad \\text{aliphatic} > \\text{aromatic}",
   "note": {
    "en": "+I / +R and steric bulk lower reactivity."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Addition / addition–elimination products"
   },
   "tex": "\\text{HCN} \\to \\text{cyanohydrin};\\ \\text{NaHSO}_3 \\to \\text{bisulphite adduct};\\ \\text{NH}_2\\text{OH} \\to \\text{oxime};\\ \\text{NH}_2\\text{NH}_2 \\to \\text{hydrazone}",
   "note": {
    "en": "Semicarbazide → semicarbazone; 2,4-DNP → coloured hydrazone; optimum pH ≈ 3.5."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Clemmensen & Wolff–Kishner"
   },
   "tex": ">\\!\\text{C{=}O} \\xrightarrow{\\text{Zn–Hg/conc. HCl}} >\\!\\text{CH}_2;\\quad >\\!\\text{C{=}O} \\xrightarrow{\\text{NH}_2\\text{NH}_2;\\ \\text{KOH/glycol},\\ \\Delta} >\\!\\text{CH}_2",
   "note": {
    "en": "Acidic vs basic conditions."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Tests for aldehydes"
   },
   "tex": "\\text{RCHO} + 2[\\text{Ag(NH}_3)_2]^+ + 3\\text{OH}^- \\to \\text{RCOO}^- + 2\\text{Ag}\\downarrow + 2\\text{H}_2\\text{O} + 4\\text{NH}_3",
   "note": {
    "en": "Tollens: all aldehydes (+HCOOH). Fehling / Benedict (Cu₂O, red): aliphatic aldehydes only, not benzaldehyde."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Haloform reaction"
   },
   "tex": "\\text{RCOCH}_3 \\xrightarrow{\\text{NaOX}} \\text{RCOONa} + \\text{CHX}_3",
   "note": {
    "en": "Needs CH₃CO– (R = H, alkyl, aryl) or CH₃CH(OH)–. C=C not attacked."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Aldol condensation"
   },
   "tex": "2\\,\\text{CH}_3\\text{CHO} \\xrightarrow{\\text{dil. NaOH}} \\text{CH}_3\\text{CH(OH)CH}_2\\text{CHO} \\xrightarrow{\\Delta} \\text{CH}_3\\text{CH{=}CHCHO}",
   "note": {
    "en": "Needs α-H. Crossed aldol of two different aldehydes → 4 products. Claisen–Schmidt: ArCHO + ketone."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Cannizzaro reaction"
   },
   "tex": "2\\,\\text{HCHO} \\xrightarrow{\\text{conc. NaOH}} \\text{CH}_3\\text{OH} + \\text{HCOONa}",
   "note": {
    "en": "No α-H. Crossed: HCHO is oxidised to formate, the other aldehyde reduced to alcohol."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t5",
   "name": {
    "en": "Ring substitution"
   },
   "tex": "\\text{–CHO},\\ \\text{–COR},\\ \\text{–COOH}:\\ \\text{deactivating, meta-directing}",
   "note": {
    "en": "Benzoic acid does not undergo Friedel–Crafts."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t4",
   "name": {
    "en": "Carboxylic acids: preparation"
   },
   "tex": "\\text{RMgX} \\xrightarrow{\\text{CO}_2;\\ \\text{H}_3\\text{O}^+} \\text{RCOOH};\\quad \\text{RCN} \\xrightarrow{\\text{H}_3\\text{O}^+} \\text{RCOOH};\\quad \\text{ArR} \\xrightarrow{\\text{KMnO}_4/\\text{KOH}} \\text{ArCOOH}",
   "note": {
    "en": "Grignard and nitrile routes add one carbon."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t5",
   "name": {
    "en": "Acidity of carboxylic acids"
   },
   "tex": "\\text{F}_3\\text{CCOOH} > \\text{Cl}_3\\text{CCOOH} > \\text{Cl}_2\\text{CHCOOH} > \\text{FCH}_2\\text{COOH} > \\text{ClCH}_2\\text{COOH} > \\text{HCOOH} > \\text{C}_6\\text{H}_5\\text{COOH} > \\text{CH}_3\\text{COOH}",
   "note": {
    "en": "pKa: HCOOH 3.75, C₆H₅COOH 4.19, CH₃COOH 4.76. RCOOH > phenol > alcohol. Ortho effect: o-substituted benzoic acids are stronger."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t3",
   "name": {
    "en": "Acid derivatives"
   },
   "tex": "\\text{RCOOH} \\xrightarrow{\\text{SOCl}_2\\ /\\ \\text{PCl}_5\\ /\\ \\text{PCl}_3} \\text{RCOCl};\\quad \\text{RCOCl} > (\\text{RCO})_2\\text{O} > \\text{RCOOR}' > \\text{RCONH}_2",
   "note": {
    "en": "Reactivity towards nucleophilic acyl substitution. SOCl₂ preferred: SO₂ and HCl escape as gases."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t5",
   "name": {
    "en": "Decarboxylation"
   },
   "tex": "\\text{RCOONa} \\xrightarrow{\\text{NaOH/CaO},\\ \\Delta} \\text{RH} + \\text{Na}_2\\text{CO}_3",
   "note": {
    "en": "One carbon fewer."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t5",
   "name": {
    "en": "Kolbe electrolysis"
   },
   "tex": "2\\,\\text{RCOO}^- \\xrightarrow{-2e^-} \\text{R–R} + 2\\,\\text{CO}_2",
   "note": {
    "en": "Anode; H₂ at the cathode. Sodium propanoate → butane."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t5",
   "name": {
    "en": "Hell–Volhard–Zelinsky"
   },
   "tex": "\\text{RCH}_2\\text{COOH} \\xrightarrow{\\text{X}_2,\\ \\text{red P};\\ \\text{H}_2\\text{O}} \\text{RCHXCOOH}",
   "note": {
    "en": "Needs α-H; α-halo acid → α-amino acid with NH₃."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t5",
   "name": {
    "en": "Reduction of acids"
   },
   "tex": "\\text{RCOOH} \\xrightarrow{\\text{LiAlH}_4\\ \\text{or}\\ \\text{B}_2\\text{H}_6} \\text{RCH}_2\\text{OH}",
   "note": {
    "en": "NaBH₄ does not reduce –COOH. B₂H₆ does not readily reduce esters, nitro or halo groups."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-chemistry-08-aldehydes-ketones-and-carboxylic-acids.t2",
   "name": {
    "en": "Boiling point"
   },
   "tex": "\\text{RCOOH} > \\text{ROH} > \\text{RCHO} \\approx \\text{R}_2\\text{CO} > \\text{ether} > \\text{alkane}",
   "note": {
    "en": "Acids form H-bonded dimers, even in the vapour phase."
   }
  }
 ]
}
