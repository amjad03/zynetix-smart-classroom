{
 "chapterId": "puc1-biology-04-animal-kingdom",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-04-animal-kingdom.t1",
   "name": {
    "en": "Levels of organisation"
   },
   "tex": "\\text{cellular (Porifera)} \\to \\text{tissue (Cnidaria)} \\to \\text{organ (Platyhelminthes)} \\to \\text{organ system}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-04-animal-kingdom.t1",
   "name": {
    "en": "Germ layers"
   },
   "tex": "\\text{diploblastic: Cnidaria, Ctenophora};\\ \\text{triploblastic: Platyhelminthes onwards}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-04-animal-kingdom.t1",
   "name": {
    "en": "Coelom"
   },
   "tex": "\\text{acoelomate (flatworms)};\\ \\text{pseudocoelomate (roundworms)};\\ \\text{coelomate (Annelida onwards)}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-04-animal-kingdom.t1",
   "name": {
    "en": "Symmetry"
   },
   "tex": "\\text{radial: Cnidaria, Ctenophora, adult Echinodermata};\\ \\text{asymmetric: most sponges}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-04-animal-kingdom.t2",
   "name": {
    "en": "Porifera"
   },
   "tex": "\\text{ostia} \\to \\text{spongocoel} \\to \\text{osculum};\\ \\text{choanocytes}",
   "note": {
    "en": "Hermaphrodite; internal fertilisation; indirect development."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-04-animal-kingdom.t2",
   "name": {
    "en": "Cnidaria"
   },
   "tex": "\\text{cnidoblasts};\\ \\text{polyp} \\rightleftharpoons \\text{medusa (metagenesis, Obelia)}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-04-animal-kingdom.t2",
   "name": {
    "en": "Ctenophora"
   },
   "tex": "8\\ \\text{comb plates; bioluminescence; external fertilisation}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-04-animal-kingdom.t3",
   "name": {
    "en": "Platyhelminthes"
   },
   "tex": "\\text{flame cells; hooks and suckers; Taenia, Fasciola}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-04-animal-kingdom.t1",
   "name": {
    "en": "Aschelminthes"
   },
   "tex": "\\text{pseudocoelom; muscular pharynx; dioecious (female longer)}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-04-animal-kingdom.t3",
   "name": {
    "en": "Annelida"
   },
   "tex": "\\text{metamerism; nephridia; closed circulation; parapodia (Nereis)}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-04-animal-kingdom.t4",
   "name": {
    "en": "Arthropoda"
   },
   "tex": "\\text{largest phylum } (>2/3\\ \\text{species});\\ \\text{Malpighian tubules; open circulation}",
   "note": {
    "en": "Limulus: living fossil."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-04-animal-kingdom.t4",
   "name": {
    "en": "Mollusca"
   },
   "tex": "\\text{head, foot, visceral hump; mantle; radula}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-04-animal-kingdom.t4",
   "name": {
    "en": "Echinodermata"
   },
   "tex": "\\text{water vascular system; no excretory system; mouth ventral, anus dorsal}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-04-animal-kingdom.t4",
   "name": {
    "en": "Hemichordata"
   },
   "tex": "\\text{proboscis, collar, trunk; proboscis gland}"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Chordate features"
   },
   "tex": "\\text{notochord, dorsal hollow nerve cord, gill slits, post-anal tail; ventral heart}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Protochordates"
   },
   "tex": "\\text{Urochordata: notochord in larval tail};\\ \\text{Cephalochordata: head to tail, lifelong}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-04-animal-kingdom.t5",
   "name": {
    "en": "Fish hearts"
   },
   "tex": "\\text{Chondrichthyes, Osteichthyes: 2 chambers}",
   "note": {
    "en": "Cartilaginous: placoid scales, no air bladder, claspers. Bony: operculum, air bladder."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-04-animal-kingdom.t6",
   "name": {
    "en": "Amphibia and Reptilia"
   },
   "tex": "\\text{3-chambered heart (crocodile: 4)}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-04-animal-kingdom.t6",
   "name": {
    "en": "Aves and Mammalia"
   },
   "tex": "\\text{4-chambered heart; homoiothermous}",
   "note": {
    "en": "Birds: pneumatic bones, crop, gizzard, air sacs. Mammals: mammary glands, hair, pinnae; platypus oviparous."
   }
  }
 ]
}
