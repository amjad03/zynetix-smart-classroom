{
 "chapterId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t4",
   "name": {
    "en": "Effective nuclear charge"
   },
   "tex": "Z_{eff} = Z - \\sigma",
   "note": {
    "en": "σ from Slater's rules."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Mulliken electronegativity"
   },
   "tex": "\\chi_M = \\frac{IE + EA}{2}",
   "note": {
    "en": "IE, EA in eV."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Pauling scale"
   },
   "tex": "|\\chi_A - \\chi_B| = 0.208\\sqrt{\\Delta}",
   "note": {
    "en": "Δ in kcal/mol."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Ionic character (Hannay–Smith)"
   },
   "tex": "\\% = 16\\Delta\\chi + 3.5(\\Delta\\chi)^2",
   "note": {
    "en": "Δχ = 1.7 ≈ 50% ionic."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t4",
   "name": {
    "en": "Size trend"
   },
   "tex": "r_{cation} < r_{atom} < r_{anion}",
   "note": {
    "en": "Isoelectronic: more Z → smaller."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t3",
   "name": {
    "en": "Group number (s, p block)"
   },
   "tex": "\\text{Group} = 10 + \\text{valence e}^-\\ (\\text{p block})",
   "note": {
    "en": "s block: group = valence e⁻."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t1",
   "name": {
    "en": "Döbereiner triads"
   },
   "tex": "A_{\\text{middle}} \\approx \\dfrac{A_1 + A_3}{2}",
   "note": {
    "en": "e.g. Li, Na, K; Ca, Sr, Ba; Cl, Br, I. Newlands' octaves worked only up to Ca."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t1",
   "name": {
    "en": "Mendeleev"
   },
   "tex": "\\text{eka-B = Sc},\\ \\ \\text{eka-Al = Ga},\\ \\ \\text{eka-Si = Ge}",
   "note": {
    "en": "Arranged by atomic mass; left gaps; could not place isotopes or hydrogen satisfactorily."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t2",
   "name": {
    "en": "Modern periodic law (Moseley)"
   },
   "tex": "\\sqrt{\\nu} \\propto (Z - b)",
   "note": {
    "en": "Properties are a periodic function of atomic number."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t2",
   "name": {
    "en": "IUPAC names for Z > 100"
   },
   "tex": "0\\,\\text{nil},\\ 1\\,\\text{un},\\ 2\\,\\text{bi},\\ 3\\,\\text{tri},\\ 4\\,\\text{quad},\\ 5\\,\\text{pent},\\ 6\\,\\text{hex},\\ 7\\,\\text{sept},\\ 8\\,\\text{oct},\\ 9\\,\\text{enn} + \\text{ium}",
   "note": {
    "en": "e.g. 120 = Unbinilium (Ubn), 119 = Ununennium (Uue)."
   }
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Elements per period"
   },
   "tex": "2,\\ 8,\\ 8,\\ 18,\\ 18,\\ 32,\\ 32"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t3",
   "name": {
    "en": "Group from configuration"
   },
   "tex": "s:\\ \\text{group} = ns;\\quad p:\\ 10 + ns + np;\\quad d:\\ (n-1)d + ns",
   "note": {
    "en": "Period = highest principal quantum number; block = subshell receiving the last electron."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t3",
   "name": {
    "en": "General configurations"
   },
   "tex": "s: ns^{1-2};\\ \\ p: ns^2np^{1-6};\\ \\ d: (n-1)d^{1-10}ns^{0-2};\\ \\ f: (n-2)f^{1-14}(n-1)d^{0-1}ns^2"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t4",
   "name": {
    "en": "Atomic radius trend"
   },
   "tex": "\\text{decreases across a period, increases down a group}",
   "note": {
    "en": "Ga (135 pm) < Al (143 pm) — poor 3d shielding. Cation < atom < anion."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t4",
   "name": {
    "en": "Isoelectronic ions"
   },
   "tex": "\\text{N}^{3-} > \\text{O}^{2-} > \\text{F}^- > \\text{Na}^+ > \\text{Mg}^{2+} > \\text{Al}^{3+}",
   "note": {
    "en": "Same electrons: larger Z ⇒ smaller ion."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t4",
   "name": {
    "en": "Ionisation enthalpy"
   },
   "tex": "\\text{M(g)} \\to \\text{M}^+(\\text{g}) + e^-,\\quad \\Delta_i H_1 < \\Delta_i H_2 < \\Delta_i H_3",
   "note": {
    "en": "Increases across, decreases down. A big jump marks a noble-gas core."
   }
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "IE anomalies"
   },
   "tex": "\\text{Be} > \\text{B},\\ \\ \\text{N} > \\text{O},\\ \\ \\text{Mg} > \\text{Al},\\ \\ \\text{P} > \\text{S}",
   "note": {
    "en": "Period 2 IE₁ order: Li < B < Be < C < O < N < F < Ne."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Second IE (period 3)"
   },
   "tex": "\\text{Na} > \\text{Al} > \\text{Si} > \\text{Mg}",
   "note": {
    "en": "IE₂ (kJ mol⁻¹): Na 4562, Al 1817, Si 1577, Mg 1451."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t4",
   "name": {
    "en": "Key IE₁ values (kJ mol⁻¹)"
   },
   "tex": "\\text{H } 1312,\\ \\text{He } 2372,\\ \\text{Na } 496,\\ \\text{K } 419,\\ \\text{Cs } 376",
   "note": {
    "en": "Ga slightly > Al; Pb > Sn (poor 4f/5d shielding)."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Electron gain enthalpy"
   },
   "tex": "\\text{X(g)} + e^- \\to \\text{X}^-(\\text{g}),\\quad \\Delta_{eg}H < 0 \\text{ (usually)}",
   "note": {
    "en": "Noble gases positive (He +48, Ne +116, Ar +96); second Δeg H always positive (O: −141 then +780)."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Δeg H order"
   },
   "tex": "\\text{Cl} (-349) > \\text{F} (-328) > \\text{Br} (-325) > \\text{I} (-295)",
   "note": {
    "en": "Also S (−200) more negative than O (−141): small 2p shells repel added electrons."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Electronegativity (Pauling)"
   },
   "tex": "\\text{F } 4.0 > \\text{O } 3.5 > \\text{N} \\approx \\text{Cl } 3.0",
   "note": {
    "en": "Not measurable directly; increases across a period, decreases down a group."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Metallic character"
   },
   "tex": "\\text{increases down a group, decreases across a period}",
   "note": {
    "en": "Metalloids: B, Si, Ge, As, Sb, Te."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Nature of oxides"
   },
   "tex": "\\text{Na}_2\\text{O} > \\text{MgO (basic)},\\ \\text{Al}_2\\text{O}_3 \\text{ (amphoteric)},\\ \\text{SiO}_2 < \\text{P}_4\\text{O}_{10} < \\text{SO}_3 < \\text{Cl}_2\\text{O}_7 \\text{ (acidic)}",
   "note": {
    "en": "Neutral: CO, NO, N₂O. Amphoteric also BeO, SnO₂, ZnO."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t3",
   "name": {
    "en": "Valence"
   },
   "tex": "\\text{s, p: valence} = \\text{group } (1, 2) \\text{ or } 8 - \\text{group number } (15\\text{–}17)",
   "note": {
    "en": "Second-period elements: maximum covalency 4 (no d orbitals)."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-03-classification-of-elements-and-periodicity-in-properties.t5",
   "name": {
    "en": "Diagonal relationship"
   },
   "tex": "\\text{Li–Mg},\\ \\ \\text{Be–Al},\\ \\ \\text{B–Si}",
   "note": {
    "en": "Similar charge/radius ratio and electronegativity."
   }
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Gaseous ion formation"
   },
   "tex": "\\text{Na(g)} + \\text{Cl(g)} \\to \\text{Na}^+ + \\text{Cl}^-:\\ \\Delta H = IE + \\Delta_{eg}H = +147\\ \\text{kJ mol}^{-1}"
  }
 ]
}
