{
 "chapterId": "puc1-biology-02-biological-classification",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "History"
   },
   "tex": "\\text{Aristotle} \\to \\text{Linnaeus (2 kingdoms)} \\to \\text{Whittaker 1969 (5 kingdoms)}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-02-biological-classification.t1",
   "name": {
    "en": "Five kingdoms"
   },
   "tex": "\\text{Monera, Protista, Fungi, Plantae, Animalia}",
   "note": {
    "en": "Criteria: cell structure, body organisation, nutrition, reproduction, phylogeny."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Cell walls"
   },
   "tex": "\\text{Monera: polysaccharide + amino acid};\\ \\text{Fungi: chitin};\\ \\text{Plantae: cellulose};\\ \\text{Animalia: none}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-02-biological-classification.t2",
   "name": {
    "en": "Bacterial shapes"
   },
   "tex": "\\text{coccus, bacillus, vibrium, spirillum}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-02-biological-classification.t2",
   "name": {
    "en": "Archaebacteria"
   },
   "tex": "\\text{halophiles (salt)},\\ \\text{thermoacidophiles (hot springs)},\\ \\text{methanogens (biogas)}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-02-biological-classification.t2",
   "name": {
    "en": "Cyanobacteria"
   },
   "tex": "\\text{chl } a;\\ N_2 \\text{ fixed in heterocysts (Nostoc, Anabaena)}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-02-biological-classification.t2",
   "name": {
    "en": "Mycoplasma"
   },
   "tex": "\\text{no cell wall; smallest living cells; anaerobic survival}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-02-biological-classification.t3",
   "name": {
    "en": "Chrysophytes"
   },
   "tex": "\\text{diatoms: silica 'soap box' walls} \\to \\text{diatomaceous earth}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-02-biological-classification.t3",
   "name": {
    "en": "Dinoflagellates"
   },
   "tex": "\\text{cellulose plates; 2 flagella (longitudinal + transverse); Gonyaulax: red tide}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-02-biological-classification.t3",
   "name": {
    "en": "Euglenoids"
   },
   "tex": "\\text{pellicle; 2 flagella (short + long); mixotrophic}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-02-biological-classification.t3",
   "name": {
    "en": "Slime moulds"
   },
   "tex": "\\text{saprophytic; plasmodium; walled resistant spores}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Protozoa"
   },
   "tex": "\\text{Amoeba (amoeboid)};\\ \\text{Trypanosoma (flagellated)};\\ \\text{Paramoecium (ciliated)};\\ \\text{Plasmodium (sporozoan)}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-02-biological-classification.t4",
   "name": {
    "en": "Fungal sexual cycle"
   },
   "tex": "\\text{plasmogamy} \\to (n+n)\\ \\text{dikaryon} \\to \\text{karyogamy} \\to \\text{meiosis}",
   "note": {
    "en": "Dikaryophase in Ascomycetes and Basidiomycetes."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-02-biological-classification.t4",
   "name": {
    "en": "Phycomycetes"
   },
   "tex": "\\text{aseptate coenocytic; zoospores/aplanospores (endogenous); zygospores}",
   "note": {
    "en": "Mucor, Rhizopus, Albugo."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-02-biological-classification.t4",
   "name": {
    "en": "Ascomycetes"
   },
   "tex": "\\text{septate; conidia (exogenous); ascospores in asci (endogenous)}",
   "note": {
    "en": "Penicillium, yeast, Aspergillus, Claviceps, Neurospora; morels, truffles."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-02-biological-classification.t4",
   "name": {
    "en": "Basidiomycetes"
   },
   "tex": "\\text{no sex organs; somatic fusion; 4 basidiospores (exogenous)}",
   "note": {
    "en": "Agaricus, Ustilago (smut), Puccinia (rust)."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-02-biological-classification.t4",
   "name": {
    "en": "Deuteromycetes"
   },
   "tex": "\\text{imperfect fungi: only asexual (conidia)}",
   "note": {
    "en": "Alternaria, Colletotrichum, Trichoderma."
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Virus discoveries"
   },
   "tex": "\\text{Ivanowsky 1892};\\ \\text{Beijerinek 1898 (contagium vivum fluidum)};\\ \\text{Stanley 1935 (crystals)}"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Viral genomes"
   },
   "tex": "\\text{plant: ssRNA};\\ \\text{phage: dsDNA};\\ \\text{never both RNA and DNA}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-biology-02-biological-classification.t5",
   "name": {
    "en": "Viroids and prions"
   },
   "tex": "\\text{viroid: free RNA (Diener 1971, PSTV)};\\ \\text{prion: misfolded protein (BSE, CJD)}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-biology-02-biological-classification.t5",
   "name": {
    "en": "Lichens"
   },
   "tex": "\\text{phycobiont (alga)} + \\text{mycobiont (fungus)}",
   "note": {
    "en": "Pollution indicators: absent from polluted areas."
   }
  }
 ]
}
