   },
   "hook": {
    "en": "The electricity bill for March arrives in April. The insurance premium paid in October covers part of next year. Both must be adjusted.",
    "kn": "ಮಾರ್ಚ್ ತಿಂಗಳ ವಿದ್ಯುತ್ ಬಿಲ್ ಏಪ್ರಿಲ್‌ನಲ್ಲಿ ಬರುತ್ತದೆ. ಅಕ್ಟೋಬರ್‌ನಲ್ಲಿ ಕಟ್ಟಿದ ವಿಮಾ ಕಂತು ಮುಂದಿನ ವರ್ಷದ ಭಾಗಕ್ಕೂ ಸೇರುತ್ತದೆ. ಎರಡನ್ನೂ ಹೊಂದಿಸಬೇಕು."
   },
   "objectives": [
    {
     "en": "Adjust outstanding expenses."
    },
    {
     "en": "Adjust prepaid expenses."
    },
    {
     "en": "Show both in the profit and loss account and the balance sheet."
    }
   ],
