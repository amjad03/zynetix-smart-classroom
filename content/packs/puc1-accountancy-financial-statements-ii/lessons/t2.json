   "title": {
    "en": "Outstanding and prepaid expenses"
   },
   "caption": {
    "en": "Expense for the year = amount paid + outstanding − prepaid. Outstanding is a current liability; prepaid is a current asset."
   },
   "narration": {
    "en": "Move the sliders and see how much expense belongs to this year."
   },
   "sliders": [
    {
     "name": "M",
     "label": {
      "en": "Monthly salary (₹)"
     },
     "min": 1000,
     "max": 20000,
     "step": 500,
     "value": 5000
    },
    {
     "name": "n",
     "label": {
      "en": "Months of salary paid"
     },
     "min": 0,
     "max": 12,
     "step": 1,
     "value": 11
    },
    {
     "name": "Q",
     "label": {
      "en": "Annual insurance premium paid (₹)"
     },
     "min": 0,
     "max": 36000,
     "step": 1000,
     "value": 12000
    },
    {
     "name": "k",
     "label": {
      "en": "Months of insurance in this year"
     },
     "min": 0,
     "max": 12,
     "step": 1,
     "value": 6
    }
   ],
