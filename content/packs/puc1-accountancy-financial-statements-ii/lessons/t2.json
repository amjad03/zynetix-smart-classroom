  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Outstanding expenses"
   },
   "body": {
    "en": "An *outstanding* expense has been incurred in the current year but not yet paid. Entry: Expense A/c Dr To Outstanding Expense A/c. Treatment: add it to the expense in the profit and loss (or trading) account, and show it as a current liability in the balance sheet."
   },
   "points": [
    {
     "en": "Expense A/c Dr To *Outstanding* Expense A/c"
    },
    {
     "en": "Add to the expense"
    },
    {
     "en": "Current liability"
    }
   ],
   "narration": {
    "en": "An outstanding expense has been incurred in the current year but not yet paid. Entry: Expense A/c Dr To Outstanding Expense A/c. Treatment: add it to the expense in the profit and loss (or trading) account, and show it as a current liability in the balance sheet.",
    "kn": "ಬಾಕಿ ವೆಚ್ಚ ಎಂದರೆ ಈ ವರ್ಷ ಆಗಿದ್ದು ಇನ್ನೂ ಪಾವತಿಸದ ವೆಚ್ಚ. ಅದನ್ನು ಸಂಬಂಧಿತ ವೆಚ್ಚಕ್ಕೆ ಸೇರಿಸಿ, ಆಢಾವೆ ಪತ್ರದಲ್ಲಿ ಚಾಲ್ತಿ ಹೊಣೆಗಾರಿಕೆಯಾಗಿ ತೋರಿಸಲಾಗುತ್ತದೆ."
   },
   "reveal": true,
   "voice": [
    {
     "say": {
      "en": "An outstanding expense has been incurred in the current year but not yet paid. Entry: Expense A over c Dr To Outstanding Expense A over c. Treatment: add it to the expense in the profit and loss or trading account, and show it as a current liability in the balance sheet.",
      "kn": "ಬಾಕಿ ವೆಚ್ಚ ಎಂದರೆ ಈ ವರ್ಷ ಆಗಿದ್ದು ಇನ್ನೂ ಪಾವತಿಸದ ವೆಚ್ಚ. ಅದನ್ನು ಸಂಬಂಧಿತ ವೆಚ್ಚಕ್ಕೆ ಸೇರಿಸಿ, ಆಢಾವೆ ಪತ್ರದಲ್ಲಿ ಚಾಲ್ತಿ ಹೊಣೆಗಾರಿಕೆಯಾಗಿ ತೋರಿಸಲಾಗುತ್ತದೆ."
