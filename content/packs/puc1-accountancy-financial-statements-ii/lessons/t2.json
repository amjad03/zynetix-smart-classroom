  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "The trial balance of Sagar Enterprises on 31 March 2025 shows Salaries ₹55,000 (11 months) and Insurance ₹12,000 paid on 1 October 2024 for one year. Find the amounts for the profit and loss account and the balance sheet."
   },
   "steps": [
    {
     "en": "Monthly salary = 55,000 ÷ 11 = ₹5,000; March is outstanding: ₹5,000."
    },
    {
     "en": "Salaries in P&L = 55,000 + 5,000 = ₹60,000; outstanding salary ₹5,000 is a current liability."
    },
    {
     "en": "Insurance covers October 2024 to September 2025: 6 months (April–September 2025) are prepaid = 12,000 × 6/12 = ₹6,000."
    },
    {
     "en": "Insurance in P&L = 12,000 − 6,000 = ₹6,000; prepaid insurance ₹6,000 is a current asset."
    }
   ],
   "answer": {
    "en": "Salaries ₹60,000 (liability ₹5,000); insurance ₹6,000 (asset ₹6,000)."
   },
   "narration": {
    "en": "Let us work this out together. The trial balance of Sagar Enterprises on 31 March 2025 shows Salaries ₹55,000 (11 months) and Insurance ₹12,000 paid on 1 October 2024 for one year. Find the amounts for the profit and loss account and the balance sheet."
   }
