  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find the modulus and conjugate of (2 − i)(−2 + i)."
   },
   "steps": [
    {
     "en": "(2 − i)(−2 + i) = −4 + 2i + 2i − i² = −3 + 4i."
    },
    {
     "en": "Modulus √(9 + 16) = 5."
    },
    {
     "en": "Conjugate −3 − 4i."
    }
   ],
   "answer": {
    "en": "|z| = 5, z̄ = −3 − 4i"
   },
   "narration": {
    "en": "Let us solve this together. Find the modulus and conjugate of (2 − i)(−2 + i)."
   }
