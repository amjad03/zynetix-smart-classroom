{
 "chapterId": "puc1-maths-04-complex-numbers-and-quadratic-equations",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Roots"
   },
   "tex": "x = \\frac{-b\\pm\\sqrt{b^2 - 4ac}}{2a}",
   "note": {
    "en": "D = b² − 4ac."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Sum and product"
   },
   "tex": "\\alpha + \\beta = -\\frac ba,\\quad \\alpha\\beta = \\frac ca",
   "note": {
    "en": "Vieta's relations."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Equation from roots"
   },
   "tex": "x^2 - (\\alpha+\\beta)x + \\alpha\\beta = 0",
   "note": {
    "en": "Monic form."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Difference of roots"
   },
   "tex": "|\\alpha - \\beta| = \\frac{\\sqrt D}{|a|}",
   "note": {
    "en": "Quick from D."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Extreme value"
   },
   "tex": "y_{ext} = -\\frac{D}{4a}\\ \\text{at}\\ x = -\\frac{b}{2a}",
   "note": {
    "en": "Min if a > 0."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Cubes of roots"
   },
   "tex": "\\alpha^3 + \\beta^3 = (\\alpha+\\beta)^3 - 3\\alpha\\beta(\\alpha+\\beta)",
   "note": {
    "en": "Symmetric function."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Common root condition"
   },
   "tex": "(c_1a_2 - c_2a_1)^2 = (a_1b_2 - a_2b_1)(b_1c_2 - b_2c_1)",
   "note": {
    "en": "Exactly one common root."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t1",
   "name": {
    "en": "Powers of i"
   },
   "tex": "i^2 = -1,\\ i^{4k} = 1,\\ i^{4k+1} = i,\\ i^{4k+2} = -1,\\ i^{4k+3} = -i;\\ \\ \\textstyle\\sum_{r=0}^{3}i^{n+r} = 0"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "√a·√b caution"
   },
   "tex": "\\sqrt a\\sqrt b = \\sqrt{ab}\\ \\text{fails if } a, b<0:\\ \\sqrt{-4}\\sqrt{-9} = -6"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t3",
   "name": {
    "en": "Modulus and conjugate"
   },
   "tex": "|z| = \\sqrt{a^2+b^2},\\ z\\bar z = |z|^2,\\ z^{-1} = \\frac{\\bar z}{|z|^2}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t2",
   "name": {
    "en": "Conjugate rules"
   },
   "tex": "\\overline{z_1\\pm z_2} = \\bar z_1\\pm\\bar z_2,\\ \\overline{z_1z_2} = \\bar z_1\\bar z_2,\\ z+\\bar z = 2\\,\\mathrm{Re}\\,z,\\ z-\\bar z = 2i\\,\\mathrm{Im}\\,z"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t2",
   "name": {
    "en": "Modulus rules"
   },
   "tex": "|z_1z_2| = |z_1||z_2|,\\ \\left|\\tfrac{z_1}{z_2}\\right| = \\tfrac{|z_1|}{|z_2|},\\ |z_1+z_2|\\le|z_1|+|z_2|"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t2",
   "name": {
    "en": "Parallelogram identity"
   },
   "tex": "|z_1\\pm z_2|^2 = |z_1|^2+|z_2|^2\\pm2\\,\\mathrm{Re}(z_1\\bar z_2)"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t4",
   "name": {
    "en": "Polar form"
   },
   "tex": "z = r(\\cos\\theta+i\\sin\\theta),\\ r = |z|,\\ \\theta = \\arg z\\in(-\\pi,\\pi]",
   "note": {
    "en": "Find the quadrant first, then the reference angle tan⁻¹|b/a|."
   }
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Product / quotient"
   },
   "tex": "\\arg(z_1z_2) = \\arg z_1+\\arg z_2,\\ \\arg\\tfrac{z_1}{z_2} = \\arg z_1-\\arg z_2\\ (\\text{mod } 2\\pi)"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "De Moivre"
   },
   "tex": "(\\cos\\theta+i\\sin\\theta)^n = \\cos n\\theta+i\\sin n\\theta"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t1",
   "name": {
    "en": "Square root of a + ib"
   },
   "tex": "\\sqrt{a+ib} = \\pm\\left(\\sqrt{\\tfrac{|z|+a}2}+i\\,\\operatorname{sgn}(b)\\sqrt{\\tfrac{|z|-a}2}\\right)"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Cube roots of unity"
   },
   "tex": "1, \\omega, \\omega^2;\\ \\omega = \\tfrac{-1+\\sqrt3 i}2,\\ 1+\\omega+\\omega^2 = 0,\\ \\omega^3 = 1,\\ \\bar\\omega = \\omega^2"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Loci"
   },
   "tex": "|z-z_0| = r: \\text{circle};\\ |z-z_1| = |z-z_2|: \\text{perpendicular bisector}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Quadratic formula"
   },
   "tex": "ax^2+bx+c = 0\\Rightarrow x = \\frac{-b\\pm\\sqrt{D}}{2a},\\ D = b^2-4ac"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Nature of roots (real a, b, c)"
   },
   "tex": "D>0: \\text{real, distinct};\\ D = 0: \\text{real, equal};\\ D<0: \\text{conjugate non-real pair}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Sum and product"
   },
   "tex": "\\alpha+\\beta = -\\tfrac ba,\\ \\alpha\\beta = \\tfrac ca;\\ \\ x^2-(\\alpha+\\beta)x+\\alpha\\beta = 0"
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Symmetric functions"
   },
   "tex": "\\alpha^2+\\beta^2 = (\\alpha+\\beta)^2-2\\alpha\\beta,\\ \\alpha^3+\\beta^3 = (\\alpha+\\beta)^3-3\\alpha\\beta(\\alpha+\\beta),\\ |\\alpha-\\beta| = \\tfrac{\\sqrt D}{|a|}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Transformed roots"
   },
   "tex": "\\tfrac1\\alpha, \\tfrac1\\beta: cx^2+bx+a = 0;\\ \\ -\\alpha, -\\beta: ax^2-bx+c = 0;\\ \\ k\\alpha, k\\beta: ax^2+kbx+k^2c = 0"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Common root"
   },
   "tex": "(c_1a_2-c_2a_1)^2 = (a_1b_2-a_2b_1)(b_1c_2-b_2c_1)",
   "note": {
    "en": "Often quicker: subtract the equations to find the common root."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Sign of a quadratic"
   },
   "tex": "ax^2+bx+c>0\\ \\forall x\\iff a>0,\\ D<0;\\ \\ \\min = -\\tfrac{D}{4a}\\ \\text{at}\\ x = -\\tfrac b{2a}\\ (a>0)"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Location of roots (a > 0)"
   },
   "tex": "\\text{both roots} < k\\iff D\\ge0,\\ -\\tfrac b{2a}<k,\\ f(k)>0;\\ \\ k \\text{ between the roots}\\iff f(k)<0"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-maths-04-complex-numbers-and-quadratic-equations.t5",
   "name": {
    "en": "Roots in ratio"
   },
   "tex": "\\alpha:\\beta = m:n\\Rightarrow mnb^2 = (m+n)^2ac"
  },
  {
   "id": "zs-f29",
   "name": {
    "en": "Newton recurrence"
   },
   "tex": "a_n = \\alpha^n+\\beta^n:\\ a\\,a_{n}+b\\,a_{n-1}+c\\,a_{n-2} = 0"
  }
 ]
}
