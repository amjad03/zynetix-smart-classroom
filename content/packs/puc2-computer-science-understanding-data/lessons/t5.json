   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Same average, different stories",
    "kn": "ಒಂದೇ ಸರಾಸರಿ, ಬೇರೆ ಕಥೆಗಳು"
   },
   "hook": {
    "en": "Two batsmen both average 40 runs. One scores 38, 42, 40, 41, 39. The other scores 0, 100, 2, 95, 3. Who would you pick for a steady innings?",
    "kn": "ಇಬ್ಬರು ಬ್ಯಾಟ್ಸ್‌ಮನ್‌ಗಳ ಸರಾಸರಿ 40 ರನ್. ಒಬ್ಬರು 38, 42, 40, 41, 39; ಇನ್ನೊಬ್ಬರು 0, 100, 2, 95, 3 ಗಳಿಸುತ್ತಾರೆ. ಸ್ಥಿರ ಆಟಕ್ಕೆ ಯಾರನ್ನು ಆರಿಸುತ್ತೀರಿ?"
   },
   "objectives": [
    {
     "en": "Compute the range"
    },
    {
     "en": "Compute standard deviation"
    },
    {
     "en": "Interpret spread to compare consistency"
    }
   ],
   "narration": {
    "en": "Two batsmen both average 40 runs. One scores 38, 42, 40, 41, 39. The other scores 0, 100, 2, 95, 3. Who would you pick for a steady innings?",
    "kn": "ಇಬ್ಬರು ಬ್ಯಾಟ್ಸ್‌ಮನ್‌ಗಳ ಸರಾಸರಿ 40 ರನ್. ಒಬ್ಬರು 38, 42, 40, 41, 39; ಇನ್ನೊಬ್ಬರು 0, 100, 2, 95, 3 ಗಳಿಸುತ್ತಾರೆ. ಸ್ಥಿರ ಆಟಕ್ಕೆ ಯಾರನ್ನು ಆರಿಸುತ್ತೀರಿ?"
   }
