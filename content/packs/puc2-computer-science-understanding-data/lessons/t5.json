  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Range and standard deviation"
   },
   "body": {
    "en": "Measures of variability tell us how spread out the data is. Range = maximum − minimum; it is simple but uses only two values. Standard deviation ($\\sigma$) measures how far values lie from the mean on average: find the mean, square each deviation, average the squares, and take the square root. A small $\\sigma$ means the values are close together."
   },
   "points": [
    {
     "en": "Range = max − min"
    },
    {
     "en": "Small σ → consistent data; large σ → widely spread data"
    }
   ],
   "narration": {
    "en": "Range is the maximum minus the minimum. Standard deviation tells how far values are from the mean; a small standard deviation means consistent data.",
    "kn": "ವ್ಯಾಪ್ತಿ = ಗರಿಷ್ಠ − ಕನಿಷ್ಠ. ಪ್ರಮಾಣಿತ ವಿಚಲನೆ ಮೌಲ್ಯಗಳು ಸರಾಸರಿಯಿಂದ ಎಷ್ಟು ದೂರ ಇವೆ ಎಂದು ಹೇಳುತ್ತದೆ; ಅದು ಚಿಕ್ಕದಾದರೆ ದತ್ತಾಂಶ ಸ್ಥಿರ."
   },
   "formula": "\\sigma = \\sqrt{\\frac{\\sum_{i=1}^{n} (x_i - \\bar{x})^2}{n}}"
  },
