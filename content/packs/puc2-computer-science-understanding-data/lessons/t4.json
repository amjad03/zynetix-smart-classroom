  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Mean, median and mode"
   },
   "body": {
    "en": "The mean is the sum of the values divided by their number. The median is the middle value after sorting; for an even count it is the average of the two middle values. The mode is the value that occurs most often. The median is not much affected by extreme values (outliers), while the mean is."
   },
   "points": [
    {
     "en": "Mean = Σx / n"
    },
    {
     "en": "Median = middle value of sorted data"
    },
    {
     "en": "Mode = most frequent value"
    }
   ],
   "narration": {
    "en": "Mean is the sum divided by the count. Median is the middle of the sorted list. Mode is the value that appears most often.",
    "kn": "ಸರಾಸರಿ ಎಂದರೆ ಮೊತ್ತವನ್ನು ಸಂಖ್ಯೆಯಿಂದ ಭಾಗಿಸಿದುದು. ಮಧ್ಯಾಂಕ ವಿಂಗಡಿಸಿದ ಪಟ್ಟಿಯ ಮಧ್ಯದ ಮೌಲ್ಯ. ಬಹುಲಕ ಹೆಚ್ಚು ಬಾರಿ ಬರುವ ಮೌಲ್ಯ."
   },
   "formula": "\\bar{x} = \\frac{\\sum_{i=1}^{n} x_i}{n}"
  },
