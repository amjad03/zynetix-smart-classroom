  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "What is a 'typical' value?",
    "kn": "'ಸಾಮಾನ್ಯ' ಮೌಲ್ಯ ಎಂದರೇನು?"
   },
   "hook": {
    "en": "If someone asks how your class did in the test, you will not read out 60 marks. You will give one number that represents everyone. Which number should it be?",
    "kn": "ನಿಮ್ಮ ತರಗತಿ ಪರೀಕ್ಷೆಯಲ್ಲಿ ಹೇಗೆ ಮಾಡಿತು ಎಂದು ಕೇಳಿದರೆ 60 ಅಂಕಗಳನ್ನೂ ಓದುವುದಿಲ್ಲ. ಎಲ್ಲರನ್ನೂ ಪ್ರತಿನಿಧಿಸುವ ಒಂದು ಸಂಖ್ಯೆ ಹೇಳುತ್ತೀರಿ. ಅದು ಯಾವುದಾಗಬೇಕು?"
   },
   "objectives": [
    {
     "en": "Compute mean, median and mode"
    },
    {
     "en": "Choose the right measure when outliers are present"
    },
    {
     "en": "Use Python's statistics module"
    }
   ],
   "narration": {
    "en": "If someone asks how your class did in the test, you will not read out 60 marks. You will give one number that represents everyone. Which number should it be?",
    "kn": "ನಿಮ್ಮ ತರಗತಿ ಪರೀಕ್ಷೆಯಲ್ಲಿ ಹೇಗೆ ಮಾಡಿತು ಎಂದು ಕೇಳಿದರೆ 60 ಅಂಕಗಳನ್ನೂ ಓದುವುದಿಲ್ಲ. ಎಲ್ಲರನ್ನೂ ಪ್ರತಿನಿಧಿಸುವ ಒಂದು ಸಂಖ್ಯೆ ಹೇಳುತ್ತೀರಿ. ಅದು ಯಾವುದಾಗಬೇಕು?"
   }
