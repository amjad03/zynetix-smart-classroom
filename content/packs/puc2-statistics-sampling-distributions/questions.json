[
 {
  "id": "2t07-q01",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t1",
  "stem": {
   "en": "A numerical value computed from the observations of a sample is called a:"
  },
  "options": [
   {
    "en": "population"
   },
   {
    "en": "statistic"
   },
   {
    "en": "sampling frame"
   },
   {
    "en": "parameter"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "A statistic (such as x̄ or s) is a function of sample values; a parameter (such as μ or σ) describes the population."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q02",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t1",
  "stem": {
   "en": "The number of possible samples of size 2 that can be drawn without replacement from a population of 5 units is:"
  },
  "options": [
   {
    "en": "32"
   },
   {
    "en": "20"
   },
   {
    "en": "25"
   },
   {
    "en": "10"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Without replacement (order ignored): 5C2 = 10. With replacement it would be 5² = 25."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q03",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t1",
  "stem": {
   "en": "All samples of size 2 are drawn with replacement from the population {2, 4, 6}. The mean of the sample means is:"
  },
  "options": [
   {
    "en": "12"
   },
   {
    "en": "4"
   },
   {
    "en": "6"
   },
   {
    "en": "3"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "There are 9 samples; their means average to 36/9 = 4, the population mean. The sample mean is an unbiased estimate of μ."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q04",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t1",
  "stem": {
   "en": "Which of the following is a parameter?"
  },
  "options": [
   {
    "en": "The s.d. of marks of a sample of 30 students"
   },
   {
    "en": "The proportion of girls in a sample of 100"
   },
   {
    "en": "The mean height of 50 students chosen from a college"
   },
   {
    "en": "The mean μ of all PU students' heights in Karnataka"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "A parameter is a constant of the population. Every other option is computed from a sample, so it is a statistic."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q05",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t1",
  "stem": {
   "en": "All samples of size 2 are drawn without replacement from the population {1, 2, 3, 4}. The variance of the sampling distribution of the sample mean is:"
  },
  "options": [
   {
    "en": "1/2"
   },
   {
    "en": "5/12"
   },
   {
    "en": "5/8"
   },
   {
    "en": "5/4"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "The 6 sample means are 1.5, 2.0, 2.5, 2.5, 3.0, 3.5, with mean 2.5 and variance 0.4167 = 5/12. Check: (σ²/n)(N − n)/(N − 1) = (1.25/2)(2/3) = 5/12."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t07-q06",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "A population has s.d. 12. The standard error of the mean of a random sample of 36 is:"
  },
  "options": [
   {
    "en": "1/3"
   },
   {
    "en": "6"
   },
   {
    "en": "2"
   },
   {
    "en": "0.33"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "SE(x̄) = σ/√n = 12/√36 = 12/6 = 2."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q07",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "To halve the standard error of the sample mean, the sample size must be:"
  },
  "options": [
   {
    "en": "multiplied by 4"
   },
   {
    "en": "halved"
   },
   {
    "en": "doubled"
   },
   {
    "en": "multiplied by √2"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "SE = σ/√n; to make it half, √n must double, so n becomes 4n."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q08",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "The standard error of the sample proportion when P = 0.4 and n = 96 is:"
  },
  "options": [
   {
    "en": "0.5"
   },
   {
    "en": "0.0025"
   },
   {
    "en": "0.24"
   },
   {
    "en": "0.05"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "SE(p) = √(PQ/n) = √(0.4 × 0.6/96) = √0.0025 = 0.05."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q09",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "Two independent samples have n₁ = 50, σ₁ = 10 and n₂ = 72, σ₂ = 12. The standard error of x̄₁ − x̄₂ is:"
  },
  "options": [
   {
    "en": "2"
   },
   {
    "en": "1"
   },
   {
    "en": "√22"
   },
   {
    "en": "4"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "SE = √(σ₁²/n₁ + σ₂²/n₂) = √(100/50 + 144/72) = √(2 + 2) = 2."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q10",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "Two independent samples of sizes 100 and 150 come from populations with proportions 0.5 and 0.4. The standard error of p₁ − p₂ is about:"
  },
  "options": [
   {
    "en": "0.064"
   },
   {
    "en": "0.100"
   },
   {
    "en": "0.050"
   },
   {
    "en": "0.041"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "SE = √(P₁Q₁/n₁ + P₂Q₂/n₂) = √(0.25/100 + 0.24/150) = √(0.0025 + 0.0016) = √0.0041 ≈ 0.064."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t07-q11",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t3",
  "stem": {
   "en": "The mean of a chi-square distribution with 10 degrees of freedom is:"
  },
  "options": [
   {
    "en": "100"
   },
   {
    "en": "10"
   },
   {
    "en": "5"
   },
   {
    "en": "20"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "For χ² with n d.f., mean = n = 10 (variance 2n = 20)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q12",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t3",
  "stem": {
   "en": "If Z₁, Z₂, …, Zₙ are independent standard normal variates, then Z₁² + Z₂² + … + Zₙ² follows:"
  },
  "options": [
   {
    "en": "the F distribution with (1, n) d.f."
   },
   {
    "en": "the chi-square distribution with n d.f."
   },
   {
    "en": "the normal distribution N(0, n)"
   },
   {
    "en": "the t distribution with n d.f."
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "By definition, the sum of squares of n independent N(0, 1) variates is χ² with n degrees of freedom."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q13",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t3",
  "stem": {
   "en": "The standard deviation of a chi-square variate with 8 d.f. is:"
  },
  "options": [
   {
    "en": "8"
   },
   {
    "en": "16"
   },
   {
    "en": "2√2"
   },
   {
    "en": "4"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Variance = 2n = 16, so s.d. = 4."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q14",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t3",
  "stem": {
   "en": "The mode of the chi-square distribution with 6 degrees of freedom is:"
  },
  "options": [
   {
    "en": "3"
   },
   {
    "en": "6"
   },
   {
    "en": "4"
   },
   {
    "en": "12"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Mode = n − 2 = 6 − 2 = 4 (for n > 2)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q15",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t3",
  "stem": {
   "en": "X₁ ~ χ²(4) and X₂ ~ χ²(6) are independent. The variance of X₁ + X₂ is:"
  },
  "options": [
   {
    "en": "10"
   },
   {
    "en": "48"
   },
   {
    "en": "20"
   },
   {
    "en": "100"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "By the additive property X₁ + X₂ ~ χ²(10), whose variance is 2 × 10 = 20."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t07-q16",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t4",
  "stem": {
   "en": "The mean of Student's t distribution (n > 1) is:"
  },
  "options": [
   {
    "en": "n"
   },
   {
    "en": "1"
   },
   {
    "en": "n/(n − 2)"
   },
   {
    "en": "0"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The t curve is symmetric about 0, so its mean is 0."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q17",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t4",
  "stem": {
   "en": "As the degrees of freedom n → ∞, the t distribution tends to:"
  },
  "options": [
   {
    "en": "the Poisson distribution"
   },
   {
    "en": "the standard normal distribution"
   },
   {
    "en": "the chi-square distribution"
   },
   {
    "en": "the F distribution"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "For large n the t curve becomes N(0, 1); that is why large samples use the Z test."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q18",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t4",
  "stem": {
   "en": "The variance of a t variate with 10 degrees of freedom is:"
  },
  "options": [
   {
    "en": "10"
   },
   {
    "en": "0.8"
   },
   {
    "en": "1"
   },
   {
    "en": "1.25"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Variance = n/(n − 2) = 10/8 = 1.25."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q19",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t4",
  "stem": {
   "en": "Compared with the standard normal curve, the t curve (small n) is:"
  },
  "options": [
   {
    "en": "positively skewed"
   },
   {
    "en": "taller with thinner tails"
   },
   {
    "en": "exactly the same"
   },
   {
    "en": "flatter at the centre with thicker tails"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The t variance n/(n − 2) exceeds 1, so the curve is lower at 0 and has more area in the tails."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q20",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t4",
  "stem": {
   "en": "A t variate has variance 1.5. Its degrees of freedom are:"
  },
  "options": [
   {
    "en": "6"
   },
   {
    "en": "8"
   },
   {
    "en": "4"
   },
   {
    "en": "3"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "n/(n − 2) = 1.5 gives n = 1.5n − 3, so n = 6."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t07-q21",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t5",
  "stem": {
   "en": "The F variate takes values in the range:"
  },
  "options": [
   {
    "en": "0 to 1"
   },
   {
    "en": "−1 to 1"
   },
   {
    "en": "−∞ to ∞"
   },
   {
    "en": "0 to ∞"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "F is a ratio of two (scaled) chi-square variates, both non-negative, so F ≥ 0."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q22",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t5",
  "stem": {
   "en": "The mean of the F distribution with (5, 10) degrees of freedom is:"
  },
  "options": [
   {
    "en": "0.5"
   },
   {
    "en": "1.25"
   },
   {
    "en": "2"
   },
   {
    "en": "1"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Mean = n₂/(n₂ − 2) = 10/8 = 1.25; it depends only on the denominator d.f."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t07-q23",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t5",
  "stem": {
   "en": "If the upper 5% point of F(5, 10) is 3.33, the lower 5% point of F(10, 5) is about:"
  },
  "options": [
   {
    "en": "0.30"
   },
   {
    "en": "0.05"
   },
   {
    "en": "11.06"
   },
   {
    "en": "3.33"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Reciprocal property: F_lower(10, 5) = 1/F_upper(5, 10) = 1/3.33 ≈ 0.30."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q24",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t5",
  "stem": {
   "en": "If t follows Student's t distribution with n d.f., then t² follows:"
  },
  "options": [
   {
    "en": "N(0, 1)"
   },
   {
    "en": "χ² with n d.f."
   },
   {
    "en": "F(1, n)"
   },
   {
    "en": "F(n, 1)"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "t² = Z²/(χ²ₙ/n) = (χ²₁/1)/(χ²ₙ/n), which is F with (1, n) d.f."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q25",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t5",
  "stem": {
   "en": "An F distribution has mean 1.25. Its denominator degrees of freedom n₂ are:"
  },
  "options": [
   {
    "en": "8"
   },
   {
    "en": "12"
   },
   {
    "en": "5"
   },
   {
    "en": "10"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "n₂/(n₂ − 2) = 1.25 gives n₂ = 1.25n₂ − 2.5, so n₂ = 10."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t07-q26",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t3",
  "stem": {
   "en": "Z₁, …, Z₅ are independent N(0, 1) variates. The mean and variance of Z₁² + Z₂² + … + Z₅² are:"
  },
  "options": [
   {
    "en": "5 and 25"
   },
   {
    "en": "0 and 5"
   },
   {
    "en": "10 and 5"
   },
   {
    "en": "5 and 10"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The sum is χ² with 5 d.f.: mean 5, variance 2 × 5 = 10."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q27",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "A sample of 400 is drawn from a population with s.d. 20, and x̄ = 50. Using SE(x̄), the 95% confidence limits for μ are:"
  },
  "options": [
   {
    "en": "30.4 and 69.6"
   },
   {
    "en": "46.08 and 53.92"
   },
   {
    "en": "49.02 and 50.98"
   },
   {
    "en": "48.04 and 51.96"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "SE = 20/√400 = 1. Limits x̄ ± 1.96 SE = 50 ± 1.96 = 48.04 and 51.96."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t07-q28",
  "chapterId": "puc2-statistics-07-sampling-distributions",
  "topicId": "puc2-statistics-07-sampling-distributions.t2",
  "stem": {
   "en": "All samples of size 2 are drawn with replacement from the population {3, 6, 9}. The standard error of the sample mean is:"
  },
  "options": [
   {
    "en": "√2"
   },
   {
    "en": "3"
   },
   {
    "en": "√3"
   },
   {
    "en": "√6"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "σ² = [(3−6)² + 0 + (9−6)²]/3 = 6. SE = σ/√n = √6/√2 = √3 ≈ 1.732 (the s.d. of the 9 sample means)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 }
]
