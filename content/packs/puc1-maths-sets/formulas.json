{
 "chapterId": "puc1-maths-01-sets",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-01-sets.t3",
   "name": {
    "en": "Subsets and power set"
   },
   "tex": "n(A) = n\\Rightarrow n(P(A)) = 2^n,\\ \\text{proper subsets} = 2^n-1",
   "note": {
    "en": "∅ and A are always subsets of A; ∅ ⊆ every set."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-01-sets.t4",
   "name": {
    "en": "Subsets containing a given element"
   },
   "tex": "2^{n-1}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-01-sets.t3",
   "name": {
    "en": "Intervals"
   },
   "tex": "(a,b) = \\{a<x<b\\},\\ [a,b] = \\{a\\le x\\le b\\},\\ (a,b] = \\{a<x\\le b\\}",
   "note": {
    "en": "Round bracket = end excluded; ∞ always takes a round bracket."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-01-sets.t5",
   "name": {
    "en": "Difference"
   },
   "tex": "A-B = A\\cap B' = \\{x : x\\in A,\\ x\\notin B\\}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-01-sets.t5",
   "name": {
    "en": "Symmetric difference"
   },
   "tex": "A\\,\\Delta\\,B = (A-B)\\cup(B-A) = (A\\cup B)-(A\\cap B)"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-01-sets.t5",
   "name": {
    "en": "Complement laws"
   },
   "tex": "A\\cup A' = U,\\ A\\cap A' = \\varnothing,\\ (A')' = A,\\ U' = \\varnothing"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-maths-01-sets.t5",
   "name": {
    "en": "De Morgan's laws"
   },
   "tex": "(A\\cup B)' = A'\\cap B',\\quad (A\\cap B)' = A'\\cup B'"
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Distributive laws"
   },
   "tex": "A\\cup(B\\cap C) = (A\\cup B)\\cap(A\\cup C),\\ A\\cap(B\\cup C) = (A\\cap B)\\cup(A\\cap C)"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-maths-01-sets.t5",
   "name": {
    "en": "Difference over union / intersection"
   },
   "tex": "A-(B\\cup C) = (A-B)\\cap(A-C),\\ A-(B\\cap C) = (A-B)\\cup(A-C)"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Absorption"
   },
   "tex": "A\\cup(A\\cap B) = A,\\ A\\cap(A\\cup B) = A"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Subset criteria"
   },
   "tex": "A\\subseteq B\\iff A\\cup B = B\\iff A\\cap B = A\\iff A-B = \\varnothing\\iff B'\\subseteq A'"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Two sets"
   },
   "tex": "n(A\\cup B) = n(A)+n(B)-n(A\\cap B)"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Parts of two sets"
   },
   "tex": "n(A-B) = n(A)-n(A\\cap B),\\ n(A\\,\\Delta\\,B) = n(A)+n(B)-2n(A\\cap B)"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Three sets"
   },
   "tex": "n(A\\cup B\\cup C) = \\sum n(A)-\\sum n(A\\cap B)+n(A\\cap B\\cap C)"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-01-sets.t2",
   "name": {
    "en": "Exactly one / exactly two (three sets)"
   },
   "tex": "\\text{one} = \\sum n(A)-2\\sum n(A\\cap B)+3n(A\\cap B\\cap C);\\ \\ \\text{two} = \\sum n(A\\cap B)-3n(A\\cap B\\cap C)"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-maths-01-sets.t1",
   "name": {
    "en": "Complement count"
   },
   "tex": "n(A') = n(U)-n(A),\\ n(A'\\cap B') = n(U)-n(A\\cup B)"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Bounds on the overlap"
   },
   "tex": "\\max(0,\\ n(A)+n(B)-n(U))\\le n(A\\cap B)\\le\\min(n(A),n(B))"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Counting pairs of subsets of an n-set"
   },
   "tex": "A\\subseteq B: 3^n;\\quad A\\cup B = X: 3^n;\\quad A\\cap B = \\varnothing: 3^n;\\quad \\text{all pairs}: 4^n"
  }
 ]
}
