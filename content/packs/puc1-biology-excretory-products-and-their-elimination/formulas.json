   },
   "tex": "\\approx 10^6\\ \\text{per kidney}",
   "note": {
    "en": "Malpighian body = glomerulus + Bowman's capsule."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t1",
   "name": {
    "en": "Columns of Bertini"
   },
   "tex": "\\text{Cortex extending between medullary pyramids}"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "GFR"
   },
   "tex": "125\\ \\text{mL min}^{-1} \\approx 180\\ \\text{L day}^{-1}"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Reabsorption"
   },
   "tex": "\\dfrac{180 - 1.5}{180} \\approx 99\\%"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t2",
   "name": {
    "en": "Filtration layers"
   },
   "tex": "\\text{Endothelium} + \\text{basement membrane} + \\text{Bowman's epithelium (podocytes)}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "PCT"
   },
   "tex": "\\text{Nutrients} + 70\\text{–}80\\%\\ \\text{electrolytes \\& water reabsorbed}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t1",
   "name": {
    "en": "Loop of Henle"
   },
   "tex": "\\text{Descending: water out (concentrates); ascending: salt out, water-impermeable (dilutes)}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t1",
   "name": {
    "en": "DCT / collecting duct"
   },
   "tex": "\\text{DCT: conditional } Na^+, H_2O;\\ \\text{CD: water, urea to interstitium}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t3",
   "name": {
    "en": "Medullary gradient"
   },
   "tex": "300 \\to 1200\\ \\text{mOsmol L}^{-1}\\ (\\text{NaCl + urea});\\ \\text{urine up to} \\approx 4\\times\\ \\text{filtrate}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t4",
   "name": {
    "en": "ADH"
   },
   "tex": "\\text{Osmoreceptors} \\to \\text{hypothalamus} \\to \\text{ADH (neurohypophysis)} \\to \\uparrow H_2O\\ \\text{reabsorption}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "RAAS"
   },
   "tex": "\\text{Angiotensinogen} \\xrightarrow{\\text{renin}} \\text{Ang I} \\to \\text{Ang II} \\to \\text{vasoconstriction} + \\text{aldosterone}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t4",
   "name": {
    "en": "ANF"
   },
   "tex": "\\text{Atrial stretch} \\to ANF \\to \\text{vasodilation}, \\downarrow BP"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Urine"
   },
   "tex": "1\\text{–}1.5\\ \\text{L day}^{-1};\\ 25\\text{–}30\\ \\text{g urea};\\ pH \\approx 6.0"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t5",
   "name": {
    "en": "Micturition"
   },
   "tex": "\\text{Bladder smooth muscle contracts} + \\text{urethral sphincter relaxes}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-biology-16-excretory-products-and-their-elimination.t1",
   "name": {
