    "en": "Kidney position and size"
   },
   "tex": "T_{12} \\text{ to } L_3;\\ 10\\text{–}12 \\times 5\\text{–}7 \\times 2\\text{–}3\\ \\text{cm};\\ 120\\text{–}170\\ \\text{g}"
  },
  {
