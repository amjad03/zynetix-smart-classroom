[
 {
  "id": "1n03-q01",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t1",
  "stem": {
   "en": "The time period of a 50 Hz alternating voltage is:"
  },
  "options": [
   {
    "en": "2 ms"
   },
   {
    "en": "50 ms"
   },
   {
    "en": "20 ms"
   },
   {
    "en": "0.2 s"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "T = 1/f = 1/50 s = 0.02 s = 20 ms."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q02",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t1",
  "stem": {
   "en": "For v = 10 sin(628t) V, the frequency is about:"
  },
  "options": [
   {
    "en": "50 Hz"
   },
   {
    "en": "628 Hz"
   },
   {
    "en": "100 Hz"
   },
   {
    "en": "10 Hz"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "ω = 628 rad/s, f = ω/2π = 628/6.28 = 100 Hz."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q03",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t1",
  "stem": {
   "en": "Two currents are i₁ = I sin(ωt + 30°) and i₂ = I sin(ωt − 15°). Which statement is correct?"
  },
  "options": [
   {
    "en": "They are in phase"
   },
   {
    "en": "i₁ leads i₂ by 45°"
   },
   {
    "en": "i₁ leads i₂ by 15°"
   },
   {
    "en": "i₁ lags i₂ by 45°"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Phase difference = 30° − (−15°) = 45°, and i₁ has the larger phase angle, so it leads."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q04",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t1",
  "stem": {
   "en": "How many times per second does a 50 Hz alternating current become zero?"
  },
  "options": [
   {
    "en": "50"
   },
   {
    "en": "25"
   },
   {
    "en": "100"
   },
   {
    "en": "200"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Each cycle passes through zero twice, so 2 × 50 = 100 times per second."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q05",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t1",
  "stem": {
   "en": "The angular frequency of a 60 Hz supply is about:"
  },
  "options": [
   {
    "en": "314 rad/s"
   },
   {
    "en": "60 rad/s"
   },
   {
    "en": "377 rad/s"
   },
   {
    "en": "188 rad/s"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "ω = 2πf = 2 × 3.1416 × 60 = 377 rad/s. (314 rad/s is for 50 Hz.)"
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q06",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t2",
  "stem": {
   "en": "The RMS value of a sinusoidal voltage of peak 100 V is:"
  },
  "options": [
   {
    "en": "50 V"
   },
   {
    "en": "70.7 V"
   },
   {
    "en": "63.7 V"
   },
   {
    "en": "141.4 V"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "V_rms = V_m/√2 = 100 × 0.707 = 70.7 V."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q07",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t2",
  "stem": {
   "en": "The form factor of a sine wave is:"
  },
  "options": [
   {
    "en": "1.414"
   },
   {
    "en": "1"
   },
   {
    "en": "1.11"
   },
   {
    "en": "0.707"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Form factor = V_rms/V_av = 0.707/0.637 = 1.11."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q08",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t2",
  "stem": {
   "en": "The peak factor (crest factor) of a sine wave is:"
  },
  "options": [
   {
    "en": "1.11"
   },
   {
    "en": "1.414"
   },
   {
    "en": "0.637"
   },
   {
    "en": "2"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Peak factor = V_m/V_rms = √2 = 1.414."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q09",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t2",
  "stem": {
   "en": "The average value of a sinusoidal alternating current over one complete cycle is:"
  },
  "options": [
   {
    "en": "zero"
   },
   {
    "en": "0.637 I_m"
   },
   {
    "en": "I_m"
   },
   {
    "en": "0.707 I_m"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "The positive and negative half cycles are equal, so the full-cycle average is zero. 0.637 I_m is the half-cycle average."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q10",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t2",
  "stem": {
   "en": "The peak-to-peak value of a 220 V (RMS) sinusoidal supply is about:"
  },
  "options": [
   {
    "en": "440 V"
   },
   {
    "en": "396 V"
   },
   {
    "en": "622 V"
   },
   {
    "en": "311 V"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "V_m = 220 × 1.414 = 311 V; V_pp = 2 × 311 = 622 V."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "1n03-q11",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t3",
  "stem": {
   "en": "In a purely inductive AC circuit, the current:"
  },
  "options": [
   {
    "en": "is in phase with the voltage"
   },
   {
    "en": "leads the voltage by 90°"
   },
   {
    "en": "lags the voltage by 180°"
   },
   {
    "en": "lags the voltage by 90°"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The induced emf opposes changes in current, so the current reaches its peak a quarter cycle after the voltage."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q12",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t3",
  "stem": {
   "en": "When the frequency of the supply increases, the capacitive reactance:"
  },
  "options": [
   {
    "en": "becomes infinite"
   },
   {
    "en": "decreases"
   },
   {
    "en": "increases"
   },
   {
    "en": "remains constant"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "X_C = 1/(2πfC) is inversely proportional to frequency."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q13",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t3",
  "stem": {
   "en": "The inductive reactance of a 50 mH coil at 1 kHz is about:"
  },
  "options": [
   {
    "en": "31.4 Ω"
   },
   {
    "en": "3.14 kΩ"
   },
   {
    "en": "314 Ω"
   },
   {
    "en": "50 Ω"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "X_L = 2πfL = 2 × 3.1416 × 1000 × 0.05 = 314 Ω."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q14",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t3",
  "stem": {
   "en": "A capacitor blocks DC because for DC its reactance is:"
  },
  "options": [
   {
    "en": "infinite"
   },
   {
    "en": "equal to 1/C"
   },
   {
    "en": "zero"
   },
   {
    "en": "equal to its resistance"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "For DC f = 0, so X_C = 1/(2πfC) becomes infinite: no steady current flows."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q15",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t3",
  "stem": {
   "en": "The reactance of a 1 µF capacitor at 50 Hz is about:"
  },
  "options": [
   {
    "en": "314 Ω"
   },
   {
    "en": "31.8 kΩ"
   },
   {
    "en": "318 Ω"
   },
   {
    "en": "3183 Ω"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "X_C = 1/(2π × 50 × 10⁻⁶) = 1/(3.1416 × 10⁻⁴) ≈ 3183 Ω."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q16",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "A series RC circuit has R = 6 Ω and X_C = 8 Ω. Its impedance is:"
  },
  "options": [
   {
    "en": "10 Ω"
   },
   {
    "en": "14 Ω"
   },
   {
    "en": "48 Ω"
   },
   {
    "en": "2 Ω"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Z = √(6² + 8²) = √100 = 10 Ω."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q17",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "The power factor of a purely resistive AC circuit is:"
  },
  "options": [
   {
    "en": "0.5"
   },
   {
    "en": "1"
   },
   {
    "en": "0.707"
   },
   {
    "en": "0"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "In a pure resistor V and I are in phase, φ = 0, so cos φ = 1."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q18",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "A coil of R = 40 Ω and X_L = 30 Ω is connected to 200 V AC. The power consumed is:"
  },
  "options": [
   {
    "en": "640 W"
   },
   {
    "en": "800 W"
   },
   {
    "en": "480 W"
   },
   {
    "en": "1000 W"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Z = √(40² + 30²) = 50 Ω, I = 200/50 = 4 A, P = I²R = 16 × 40 = 640 W."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q19",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "In a series RC circuit connected to AC, the current:"
  },
  "options": [
   {
    "en": "leads the voltage by exactly 90°"
   },
   {
    "en": "leads the voltage by an angle between 0° and 90°"
   },
   {
    "en": "is in phase with the voltage"
   },
   {
    "en": "lags the voltage by an angle between 0° and 90°"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "tan φ = X_C/R; with both R and C present, φ lies between 0° and 90° and the current leads."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q20",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "A series RLC circuit with R = 12 Ω, X_L = 20 Ω and X_C = 4 Ω is connected to 100 V AC. The true power is:"
  },
  "options": [
   {
    "en": "300 W"
   },
   {
    "en": "180 W"
   },
   {
    "en": "500 W"
   },
   {
    "en": "400 W"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Z = √(12² + 16²) = 20 Ω, I = 5 A, P = I²R = 25 × 12 = 300 W (pf = 0.6)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "1n03-q21",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t5",
  "stem": {
   "en": "At series resonance, the impedance of an RLC circuit is:"
  },
  "options": [
   {
    "en": "maximum"
   },
   {
    "en": "minimum and equal to R"
   },
   {
    "en": "zero"
   },
   {
    "en": "equal to X_L + X_C"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "X_L and X_C cancel, leaving Z = R, the smallest possible value."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q22",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t5",
  "stem": {
   "en": "The resonant frequency of a series circuit with L = 1 H and C = 1 µF is about:"
  },
  "options": [
   {
    "en": "6.28 kHz"
   },
   {
    "en": "1000 Hz"
   },
   {
    "en": "50 Hz"
   },
   {
    "en": "159 Hz"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "f₀ = 1/(2π√(1 × 10⁻⁶)) = 1/(2π × 10⁻³) = 159 Hz."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q23",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t5",
  "stem": {
   "en": "A series resonant circuit is also called:"
  },
  "options": [
   {
    "en": "a tank circuit"
   },
   {
    "en": "a clipper circuit"
   },
   {
    "en": "a rejector circuit"
   },
   {
    "en": "an acceptor circuit"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "It offers minimum impedance and so accepts the resonant frequency. The parallel (tank) circuit is the rejector."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1n03-q24",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t5",
  "stem": {
   "en": "If the capacitance in a series LC circuit is made four times larger, the resonant frequency becomes:"
  },
  "options": [
   {
    "en": "double"
   },
   {
    "en": "one-fourth"
   },
   {
    "en": "half"
   },
   {
    "en": "four times"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "f₀ ∝ 1/√C, so 4C gives f₀/2."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q25",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t5",
  "stem": {
   "en": "A series resonant circuit has f₀ = 10 kHz and Q = 50. Its bandwidth is:"
  },
  "options": [
   {
    "en": "50 Hz"
   },
   {
    "en": "200 Hz"
   },
   {
    "en": "500 kHz"
   },
   {
    "en": "5 kHz"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "BW = f₀/Q = 10 000/50 = 200 Hz."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1n03-q26",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t3",
  "stem": {
   "en": "A pure inductor of 0.2 H is connected to a 220 V, 50 Hz supply. The current through it is about:"
  },
  "options": [
   {
    "en": "3.5 A"
   },
   {
    "en": "1.1 A"
   },
   {
    "en": "0.35 A"
   },
   {
    "en": "7.0 A"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "X_L = 2πfL = 2π × 50 × 0.2 = 62.8 Ω, so I = V/X_L = 220/62.8 ≈ 3.5 A. The current lags the voltage by 90°."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [
   "board-pattern"
  ]
 },
 {
  "id": "1n03-q27",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "A series RC circuit has R = 40 Ω and X_C = 30 Ω. Its power factor is:"
  },
  "options": [
   {
    "en": "0.8 lagging"
   },
   {
    "en": "0.8 leading"
   },
   {
    "en": "0.6 leading"
   },
   {
    "en": "0.75 lagging"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Z = √(40² + 30²) = 50 Ω and cos φ = R/Z = 40/50 = 0.8. In an RC circuit the current leads the voltage, so the power factor is 0.8 leading."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [
   "board-pattern"
  ]
 },
 {
  "id": "1n03-q28",
  "chapterId": "puc1-electronics-03-ac-fundamentals",
  "topicId": "puc1-electronics-03-ac-fundamentals.t4",
  "stem": {
   "en": "A coil of resistance 6 Ω and inductive reactance 8 Ω is connected to a 200 V AC supply. The true power consumed is:"
  },
  "options": [
   {
    "en": "4000 W"
   },
   {
    "en": "3200 W"
   },
   {
    "en": "2400 W"
   },
   {
    "en": "1200 W"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Z = √(6² + 8²) = 10 Ω, I = 200/10 = 20 A. Only the resistance uses power: P = I²R = 20² × 6 = 2400 W (or P = VI cos φ = 200 × 20 × 0.6)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [
   "board-pattern"
  ]
 }
]
