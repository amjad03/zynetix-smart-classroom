   "problem": {
    "en": "A coil with R = 30 Ω and X_L = 40 Ω is connected to 100 V AC. Find Z, I, the power factor and the power."
   },
   "steps": [
    {
     "en": "Z = √(30² + 40²) = √2500 = 50 Ω."
    },
    {
     "en": "I = 100/50 = 2 A; cos φ = R/Z = 30/50 = 0.6 (lagging)."
    },
    {
     "en": "P = VI cos φ = 100 × 2 × 0.6 = 120 W; check I²R = 4 × 30 = 120 W."
    }
   ],
