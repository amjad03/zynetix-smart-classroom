   "problem": {
    "en": "In a polygenic trait controlled by three genes (A, B, C) with additive effect, what fraction of the F2 from AaBbCc × AaBbCc is as dark as the darkest parent type AABBCC?"
   },
   "steps": [
    {
     "en": "Each gene: probability of AA from Aa × Aa = 1/4."
    },
    {
     "en": "The three genes assort independently, so P(AABBCC) = 1/4 × 1/4 × 1/4."
    },
    {
     "en": "= 1/64."
    }
   ],
