 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Why do people come in every shade?",
    "kn": "ಜನರು ಎಲ್ಲಾ ಬಣ್ಣಛಾಯೆಗಳಲ್ಲಿ ಏಕೆ ಇರುತ್ತಾರೆ?"
   },
   "hook": {
    "en": "Human height and skin colour are not just tall or short, dark or fair. They vary smoothly, because many genes act together.",
    "kn": "ಮಾನವನ ಎತ್ತರ ಮತ್ತು ಚರ್ಮದ ಬಣ್ಣ ಎರಡೇ ರೂಪದಲ್ಲಿಲ್ಲ; ಅನೇಕ ಜೀನ್‌ಗಳು ಒಟ್ಟಾಗಿ ಕೆಲಸ ಮಾಡುವುದರಿಂದ ಕ್ರಮೇಣ ಬದಲಾಗುತ್ತವೆ."
   },
   "narration": {
    "en": "Human height and skin colour are not just tall or short, dark or fair. They vary smoothly, because many genes act together.",
    "kn": "ಮಾನವನ ಎತ್ತರ ಮತ್ತು ಚರ್ಮದ ಬಣ್ಣ ಎರಡೇ ರೂಪದಲ್ಲಿಲ್ಲ; ಅನೇಕ ಜೀನ್‌ಗಳು ಒಟ್ಟಾಗಿ ಕೆಲಸ ಮಾಡುವುದರಿಂದ ಕ್ರಮೇಣ ಬದಲಾಗುತ್ತವೆ."
   }
