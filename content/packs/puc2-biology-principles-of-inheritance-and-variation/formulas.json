{
 "chapterId": "puc2-biology-04-principles-of-inheritance-and-variation",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "Monohybrid F2"
   },
   "tex": "3:1\\ \\text{(phenotype)},\\quad 1:2:1\\ \\text{(genotype)}",
   "note": {
    "en": "Complete dominance."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t3",
   "name": {
    "en": "Dihybrid F2"
   },
   "tex": "9:3:3:1",
   "note": {
    "en": "Independent assortment."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "Test crosses"
   },
   "tex": "\\text{mono } 1:1,\\quad \\text{di } 1:1:1:1",
   "note": {
    "en": "Cross with homozygous recessive."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "Gametes from n heterozygous loci"
   },
   "tex": "2^n",
   "note": {
    "en": "AaBbCc → 8."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t2",
   "name": {
    "en": "F2 genotypes / phenotypes"
   },
   "tex": "3^n\\ \\text{genotypes},\\quad 2^n\\ \\text{phenotypes}",
   "note": {
    "en": "Complete dominance at each locus."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t2",
   "name": {
    "en": "Incomplete dominance"
   },
   "tex": "1:2:1",
   "note": {
    "en": "Phenotype ratio = genotype ratio (snapdragon)."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t3",
   "name": {
    "en": "Map distance"
   },
   "tex": "1\\%\\ \\text{recombination} = 1\\ \\text{cM}",
   "note": {
    "en": "Higher RF → genes farther apart."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Hardy–Weinberg"
   },
   "tex": "p^2 + 2pq + q^2 = 1,\\quad p + q = 1",
   "note": {
    "en": "q² = recessive phenotype frequency."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t3",
   "name": {
    "en": "Mendel"
   },
   "tex": "1856\\text{–}1863;\\ 7\\ \\text{pairs of contrasting traits in pea}",
   "note": {
    "en": "Rediscovered 1900 by de Vries, Correns, von Tschermak."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t2",
   "name": {
    "en": "Pea dominant traits"
   },
   "tex": "\\text{tall, violet, axial, inflated pod, green pod, round seed, yellow seed}",
   "note": {
    "en": "Green is dominant for pod colour but recessive for seed colour."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "Monohybrid F2"
   },
   "tex": "3:1\\ \\text{(phenotype)};\\quad 1:2:1\\ \\text{(genotype)}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "Test cross"
   },
   "tex": "\\text{Tt} \\times \\text{tt} \\to 1:1;\\quad \\text{RrYy} \\times \\text{rryy} \\to 1:1:1:1"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t3",
   "name": {
    "en": "Dihybrid F2"
   },
   "tex": "9:3:3:1;\\ 9\\ \\text{genotypes},\\ 4\\ \\text{phenotypes}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "General counts (n heterozygous genes)"
   },
   "tex": "\\text{gametes} = 2^n;\\ \\text{genotypes} = 3^n;\\ \\text{phenotypes} = 2^n;\\ \\text{Punnett boxes} = 4^n"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t1",
   "name": {
    "en": "Incomplete dominance"
   },
   "tex": "\\text{snapdragon: RR (red) : Rr (pink) : rr (white)} = 1:2:1",
   "note": {
    "en": "Phenotypic ratio = genotypic ratio."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t2",
   "name": {
    "en": "Starch grain in pea"
   },
   "tex": "\\text{Bb: round seed (dominance), intermediate grains (incomplete dominance)}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t2",
   "name": {
    "en": "ABO blood group"
   },
   "tex": "I^A, I^B, i:\\ \\tfrac{n(n+1)}{2} = 6\\ \\text{genotypes},\\ 4\\ \\text{phenotypes}",
   "note": {
    "en": "AB shows co-dominance; multiple alleles studied in populations."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t4",
   "name": {
    "en": "Pleiotropy and polygeny"
   },
   "tex": "\\text{PKU: one gene, many effects};\\ \\text{skin colour: many genes, one trait}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t4",
   "name": {
    "en": "Polygenic F2 (3 genes)"
   },
   "tex": "1:6:15:20:15:6:1\\ \\ (7\\ \\text{classes, out of } 64)"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t3",
   "name": {
    "en": "Chromosomal theory"
   },
   "tex": "\\text{Sutton and Boveri, } 1902",
   "note": {
    "en": "Verified by Morgan in Drosophila."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t3",
   "name": {
    "en": "Linkage (Morgan)"
   },
   "tex": "\\text{white–yellow} = 1.3\\%;\\ \\text{white–miniature} = 37.2\\%",
   "note": {
    "en": "Sturtevant: recombination frequency used to map genes."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t4",
   "name": {
    "en": "Sex determination"
   },
   "tex": "\\text{XX–XO (grasshopper)},\\ \\text{XX–XY (human, Drosophila)},\\ \\text{ZW–ZZ (birds, female heterogametic)}",
   "note": {
    "en": "X body: Henking, 1891."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t4",
   "name": {
    "en": "Honey bee"
   },
   "tex": "\\text{male} = n = 16\\ (\\text{unfertilised egg});\\ \\text{female} = 2n = 32",
   "note": {
    "en": "Males make sperms by mitosis; no father, but a grandfather; can have grandsons, not sons."
   }
  },
  {
   "id": "zs-f24",
   "name": {
    "en": "Mutation"
   },
   "tex": "\\text{point (sickle-cell)};\\ \\text{frame-shift (insertion/deletion)};\\ \\text{mutagen: UV}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Sickle-cell anaemia"
   },
   "tex": "\\text{GAG} \\to \\text{GUG}:\\ \\text{Glu} \\to \\text{Val at 6th position of } \\beta\\text{-globin}",
   "note": {
    "en": "Autosomal recessive; HbAHbS carriers; qualitative defect."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Thalassemia"
   },
   "tex": "\\alpha:\\ \\text{HBA1, HBA2 (chr. 16)};\\ \\beta:\\ \\text{HBB (chr. 11)}",
   "note": {
    "en": "Autosomal recessive; quantitative defect (too few globins)."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Sex-linked recessive"
   },
   "tex": "\\text{haemophilia, colour blindness } (8\\%\\ \\text{males},\\ 0.4\\%\\ \\text{females})",
   "note": {
    "en": "Carrier mother × normal father: ½ of sons affected, ½ of daughters carriers."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Other Mendelian disorders"
   },
   "tex": "\\text{PKU, cystic fibrosis: autosomal recessive};\\ \\text{myotonic dystrophy: autosomal dominant}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Chromosomal disorders"
   },
   "tex": "\\text{Down: trisomy 21};\\ \\text{Klinefelter: 47, XXY};\\ \\text{Turner: 45, X0}",
   "note": {
    "en": "Aneuploidy: failure of chromatid segregation. Polyploidy: failure of cytokinesis (common in plants)."
   }
  },
  {
   "id": "zs-f30",
   "topicId": "puc2-biology-04-principles-of-inheritance-and-variation.t5",
   "name": {
    "en": "Pedigree symbols"
   },
   "tex": "\\square\\ \\text{male},\\ \\bigcirc\\ \\text{female},\\ \\text{filled} = \\text{affected},\\ \\text{double line} = \\text{consanguineous mating}"
  }
 ]
}
