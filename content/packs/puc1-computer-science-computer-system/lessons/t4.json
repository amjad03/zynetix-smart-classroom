   "heading": {
    "en": "Numbers that tell a story",
    "kn": "ಕತೆ ಹೇಳುವ ಸಂಖ್ಯೆಗಳು"
   },
   "hook": {
    "en": "78, 92, 65 — these numbers mean nothing alone. Tell me they are Ravi's marks in three subjects, and they become information. What changed?",
    "kn": "78, 92, 65 — ಈ ಸಂಖ್ಯೆಗಳಿಗೆ ಏಕಾಂಗಿಯಾಗಿ ಅರ್ಥವಿಲ್ಲ. ಇವು ರವಿಯ ಮೂರು ವಿಷಯಗಳ ಅಂಕಗಳು ಎಂದರೆ ಮಾಹಿತಿಯಾಗುತ್ತವೆ. ಏನು ಬದಲಾಯಿತು?"
   },
   "objectives": [
    {
     "en": "Distinguish data from information"
    },
    {
     "en": "Classify data as structured, semi-structured or unstructured"
    },
    {
     "en": "Describe data capture, storage, retrieval, deletion and recovery"
    }
   ],
   "narration": {
    "en": "78, 92, 65 — these numbers mean nothing alone. Tell me they are Ravi's marks in three subjects, and they become information. What changed?",
    "kn": "78, 92, 65 — ಈ ಸಂಖ್ಯೆಗಳಿಗೆ ಏಕಾಂಗಿಯಾಗಿ ಅರ್ಥವಿಲ್ಲ. ಇವು ರವಿಯ ಮೂರು ವಿಷಯಗಳ ಅಂಕಗಳು ಎಂದರೆ ಮಾಹಿತಿಯಾಗುತ್ತವೆ. ಏನು ಬದಲಾಯಿತು?"
   }
