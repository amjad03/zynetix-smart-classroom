{
 "chapterId": "puc2-biology-11-organisms-and-populations",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-11-organisms-and-populations.t1",
   "name": {
    "en": "Population attributes"
   },
   "tex": "\\text{birth rate, death rate, sex ratio, age distribution}",
   "note": {
    "en": "Rates are per capita, e.g. births ÷ population."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-11-organisms-and-populations.t1",
   "name": {
    "en": "Age pyramids"
   },
   "tex": "\\text{triangular: expanding;\\ bell: stable;\\ urn: declining}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-11-organisms-and-populations.t1",
   "name": {
    "en": "Measuring size"
   },
   "tex": "\\text{numbers, percent cover, biomass, pugmarks, faecal pellets}",
   "note": {
    "en": "Percent cover/biomass when one large plant vs many small ones."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-11-organisms-and-populations.t2",
   "name": {
    "en": "Population change"
   },
   "tex": "N_{t+1} = N_t + [(B + I) - (D + E)]"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-11-organisms-and-populations.t2",
   "name": {
    "en": "Exponential growth"
   },
   "tex": "\\frac{dN}{dt} = rN,\\quad N_t = N_0 e^{rt}",
   "note": {
    "en": "J-shaped curve; unlimited resources."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-11-organisms-and-populations.t2",
   "name": {
    "en": "Intrinsic rate of increase"
   },
   "tex": "r = b - d",
   "note": {
    "en": "Norway rat 0.015, flour beetle 0.12, India (1981) 0.0205."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-11-organisms-and-populations.t3",
   "name": {
    "en": "Logistic growth"
   },
   "tex": "\\frac{dN}{dt} = rN\\left(\\frac{K - N}{K}\\right)",
   "note": {
    "en": "Sigmoid; lag → acceleration → deceleration → asymptote at K. Verhulst-Pearl. Fastest growth at N = K/2."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-11-organisms-and-populations.t3",
   "name": {
    "en": "Life history variation"
   },
   "tex": "\\text{breed once: Pacific salmon, bamboo};\\ \\text{many times: birds, mammals}",
   "note": {
    "en": "Many small offspring: oysters, pelagic fishes; few large: birds, mammals."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-11-organisms-and-populations.t4",
   "name": {
    "en": "Interaction signs"
   },
   "tex": "\\text{mutualism } (+,+);\\ \\text{competition } (-,-);\\ \\text{predation, parasitism } (+,-);\\ \\text{commensalism } (+,0);\\ \\text{amensalism } (-,0)"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-11-organisms-and-populations.t4",
   "name": {
    "en": "Predation examples"
   },
   "tex": "\\text{prickly pear (Australia) controlled by a moth}",
   "note": {
    "en": "Monarch butterfly distasteful; Calotropis has cardiac glycosides; Pisaster removal → >10 invertebrate species extinct."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-11-organisms-and-populations.t4",
   "name": {
    "en": "Competition"
   },
   "tex": "\\text{Gause: competitive exclusion}",
   "note": {
    "en": "Abingdon tortoise vs goats (Galapagos); Connell: Balanus excludes Chthamalus; MacArthur: 5 warblers, resource partitioning."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-11-organisms-and-populations.t5",
   "name": {
    "en": "Parasitism"
   },
   "tex": "\\text{liver fluke: snail + fish (intermediate hosts)}",
   "note": {
    "en": "Adaptations: lose sense organs and digestive system, suckers, high fecundity. Brood parasitism: cuckoo in crow's nest."
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Commensalism"
   },
   "tex": "\\text{orchid on mango; barnacles on whale; cattle egret–cattle; sea anemone–clown fish}"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Mutualism"
   },
   "tex": "\\text{lichens, mycorrhizae, fig–wasp, Ophrys (pseudocopulation)}"
  }
 ]
}
