{
 "chapterId": "puc2-physics-04-moving-charges-and-magnetism",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Lorentz force"
   },
   "tex": "\\vec F = q(\\vec v\\times\\vec B)",
   "note": {
    "en": "No work done by magnetic force."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t2",
   "name": {
    "en": "Radius in a field"
   },
   "tex": "r = \\frac{mv}{qB}",
   "note": {
    "en": "Period 2πm/qB, independent of speed."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Force on a wire"
   },
   "tex": "\\vec F = I\\vec L\\times\\vec B",
   "note": {
    "en": "Max when wire ⟂ B."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t4",
   "name": {
    "en": "Long straight wire"
   },
   "tex": "B = \\frac{\\mu_0 I}{2\\pi r}",
   "note": {
    "en": "μ₀ = 4π × 10⁻⁷ T m/A."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t3",
   "name": {
    "en": "Centre of circular loop"
   },
   "tex": "B = \\frac{\\mu_0 I}{2R}",
   "note": {
    "en": "N turns: multiply by N."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t4",
   "name": {
    "en": "Solenoid"
   },
   "tex": "B = \\mu_0 nI",
   "note": {
    "en": "n = turns per unit length."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Torque on a loop"
   },
   "tex": "\\tau = NIAB\\sin\\theta",
   "note": {
    "en": "Magnetic moment m = NIA."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Faraday's law"
   },
   "tex": "\\varepsilon = -\\frac{d\\Phi_B}{dt}",
   "note": {
    "en": "Minus sign = Lenz's law."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Motional EMF"
   },
   "tex": "\\varepsilon = Bvl",
   "note": {
    "en": "Rod moving ⟂ to B."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Lorentz force"
   },
   "tex": "\\vec F = q(\\vec E + \\vec v\\times\\vec B)",
   "note": {
    "en": "Magnetic part does no work; speed is unchanged."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Force on a current"
   },
   "tex": "\\vec F = I\\,\\vec L\\times\\vec B,\\quad F = BIL\\sin\\theta",
   "note": {
    "en": "Any wire in a uniform field: use the straight line joining its ends."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t2",
   "name": {
    "en": "Circular motion in B"
   },
   "tex": "r = \\frac{mv}{qB} = \\frac{\\sqrt{2mK}}{qB} = \\frac{1}{B}\\sqrt{\\frac{2mV}{q}}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t2",
   "name": {
    "en": "Period and cyclotron frequency"
   },
   "tex": "T = \\frac{2\\pi m}{qB},\\quad \\nu_c = \\frac{qB}{2\\pi m}",
   "note": {
    "en": "Independent of speed (non-relativistic)."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t2",
   "name": {
    "en": "Helix"
   },
   "tex": "r = \\frac{mv\\sin\\theta}{qB},\\quad p = \\frac{2\\pi m v\\cos\\theta}{qB}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Velocity selector"
   },
   "tex": "v = \\frac{E}{B}",
   "note": {
    "en": "E and B perpendicular to each other and to v."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Cyclotron maximum energy"
   },
   "tex": "K_{max} = \\frac{q^2B^2R^2}{2m}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t3",
   "name": {
    "en": "Biot–Savart law"
   },
   "tex": "d\\vec B = \\frac{\\mu_0}{4\\pi}\\frac{I\\,d\\vec l\\times\\hat r}{r^2},\\quad \\mu_0 = 4\\pi\\times10^{-7}\\ \\text{T m/A}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t1",
   "name": {
    "en": "Finite straight wire"
   },
   "tex": "B = \\frac{\\mu_0 I}{4\\pi d}(\\sin\\alpha_1 + \\sin\\alpha_2)",
   "note": {
    "en": "Infinite: mu0 I/(2 pi d); semi-infinite from the foot: mu0 I/(4 pi d)."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t3",
   "name": {
    "en": "Circular loop: centre and axis"
   },
   "tex": "B_0 = \\frac{\\mu_0 I}{2R},\\quad B_x = \\frac{\\mu_0 I R^2}{2(R^2 + x^2)^{3/2}}",
   "note": {
    "en": "Arc of angle theta at centre: mu0 I theta/(4 pi R)."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t4",
   "name": {
    "en": "Ampere's circuital law"
   },
   "tex": "\\oint \\vec B\\cdot d\\vec l = \\mu_0 I_{\\text{enc}}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t4",
   "name": {
    "en": "Thick wire (radius R)"
   },
   "tex": "B_{in} = \\frac{\\mu_0 I r}{2\\pi R^2},\\quad B_{out} = \\frac{\\mu_0 I}{2\\pi r}"
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t4",
   "name": {
    "en": "Solenoid and toroid"
   },
   "tex": "B_{sol} = \\mu_0 n I\\ (\\text{end: } \\tfrac12\\mu_0 nI),\\quad B_{tor} = \\frac{\\mu_0 N I}{2\\pi r}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t5",
   "name": {
    "en": "Parallel wires"
   },
   "tex": "\\frac{F}{l} = \\frac{\\mu_0 I_1 I_2}{2\\pi d}",
   "note": {
    "en": "Like currents attract; unlike repel."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Magnetic moment of a loop"
   },
   "tex": "\\vec m = N I \\vec A",
   "note": {
    "en": "Direction by right-hand rule; unit A m^2."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Torque and energy of a loop"
   },
   "tex": "\\vec\\tau = \\vec m\\times\\vec B,\\quad U = -\\vec m\\cdot\\vec B",
   "note": {
    "en": "Work from stable to unstable = 2mB."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Orbiting electron"
   },
   "tex": "m = \\frac{evr}{2},\\quad \\frac{m}{L} = \\frac{e}{2m_e}",
   "note": {
    "en": "Any rotating body with uniform q/M ratio: q/(2M)."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Galvanometer"
   },
   "tex": "\\phi = \\frac{NAB}{k}I,\\quad S_I = \\frac{NAB}{k},\\quad S_V = \\frac{NAB}{kR}"
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Ammeter (shunt)"
   },
   "tex": "S = \\frac{I_g G}{I - I_g}",
   "note": {
    "en": "Small S in parallel."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-physics-04-moving-charges-and-magnetism.t6",
   "name": {
    "en": "Voltmeter (series resistance)"
   },
   "tex": "R = \\frac{V}{I_g} - G",
   "note": {
    "en": "Large R in series."
   }
  }
 ]
}
