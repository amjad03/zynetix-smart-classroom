  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Permutations of distinct objects"
   },
   "body": {
    "en": "A permutation is an arrangement in a definite order. The number of permutations of $n$ different objects taken $r$ at a time, without repetition, is ${}^nP_r = \\dfrac{n!}{(n-r)!}$. All $n$ at a time: ${}^nP_n = n!$. With repetition allowed: $n^r$.",
    "kn": "n ಬೇರೆ ಬೇರೆ ವಸ್ತುಗಳಿಂದ r ವಸ್ತುಗಳನ್ನು ಕ್ರಮವಾಗಿ ಜೋಡಿಸುವ ರೀತಿಗಳು ⁿPᵣ = n!/(n − r)!."
   },
   "points": [
    {
     "en": "ⁿPᵣ = n(n − 1)…(n − r + 1): r factors"
    },
    {
     "en": "With repetition: nʳ"
    }
   ],
   "narration": {
    "en": "n P r counts ordered arrangements of r objects chosen from n different ones. It equals n factorial divided by n minus r factorial.",
    "kn": "n ಬೇರೆ ಬೇರೆ ವಸ್ತುಗಳಿಂದ r ವಸ್ತುಗಳನ್ನು ಕ್ರಮವಾಗಿ ಜೋಡಿಸುವ ರೀತಿಗಳು ⁿPᵣ = n!/(n − r)!."
   },
   "formula": "{}^{n}P_{r} = \\frac{n!}{(n-r)!}, \\quad 0 \\le r \\le n"
  },
