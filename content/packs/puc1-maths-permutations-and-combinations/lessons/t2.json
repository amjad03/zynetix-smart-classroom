  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find n if ⁿP₄ = 20 · ⁿP₂."
   },
   "steps": [
    {
     "en": "n(n − 1)(n − 2)(n − 3) = 20 n(n − 1)."
    },
    {
     "en": "Cancel n(n − 1): (n − 2)(n − 3) = 20 = 5 × 4."
    },
    {
     "en": "n − 2 = 5, so n = 7."
    }
   ],
   "answer": {
    "en": "n = 7"
   },
   "narration": {
    "en": "Let us solve this together. Find n if ⁿP₄ = 20 · ⁿP₂."
   }
