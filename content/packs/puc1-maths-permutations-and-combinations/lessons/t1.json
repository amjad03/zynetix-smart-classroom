  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The multiplication principle"
   },
   "body": {
    "en": "If one event can occur in $m$ ways and, after it, a second event can occur in $n$ ways, the two events in order can occur in $m \\times n$ ways. This extends to any number of events. With repetition allowed each position keeps all its choices; without repetition the choices drop by one at each step.",
    "kn": "ಒಂದು ಘಟನೆ m ರೀತಿಗಳಲ್ಲಿ, ನಂತರ ಇನ್ನೊಂದು n ರೀತಿಗಳಲ್ಲಿ ನಡೆಯಬಹುದಾದರೆ, ಎರಡೂ ಸೇರಿ m × n ರೀತಿಗಳಲ್ಲಿ ನಡೆಯುತ್ತವೆ."
   },
   "points": [
    {
     "en": "Fill the most restricted place first"
    },
    {
     "en": "With repetition: n × n × …; without: n × (n − 1) × …"
    }
   ],
   "narration": {
    "en": "If one job can be done in m ways and then the next in n ways, together they can be done in m times n ways. Without repetition the number of choices drops at every step.",
    "kn": "ಒಂದು ಘಟನೆ m ರೀತಿಗಳಲ್ಲಿ, ನಂತರ ಇನ್ನೊಂದು n ರೀತಿಗಳಲ್ಲಿ ನಡೆಯಬಹುದಾದರೆ, ಎರಡೂ ಸೇರಿ m × n ರೀತಿಗಳಲ್ಲಿ ನಡೆಯುತ್ತವೆ."
   },
   "formula": "\\text{Total ways} = m \\times n \\times p \\times \\cdots"
  },
