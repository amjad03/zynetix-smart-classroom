{
 "chapterId": "puc1-maths-06-permutations-and-combinations",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-06-permutations-and-combinations.t1",
   "name": {
    "en": "Fundamental principle (multiplication)"
   },
   "tex": "m \\text{ ways then } n \\text{ ways} \\Rightarrow mn \\text{ ways}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-06-permutations-and-combinations.t1",
   "name": {
    "en": "Addition principle"
   },
   "tex": "m \\text{ ways or } n \\text{ ways (exclusive)} \\Rightarrow m + n"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-06-permutations-and-combinations.t2",
   "name": {
    "en": "Factorial"
   },
   "tex": "n! = n(n-1)\\cdots1,\\quad 0! = 1,\\quad n! = n\\,(n-1)!"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Permutations"
   },
   "tex": "^nP_r = \\frac{n!}{(n-r)!},\\quad {}^nP_n = n!"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-06-permutations-and-combinations.t2",
   "name": {
    "en": "Permutations with repetition allowed"
   },
   "tex": "n^r"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-06-permutations-and-combinations.t3",
   "name": {
    "en": "Permutations of alike objects"
   },
   "tex": "\\frac{n!}{p_1!\\,p_2!\\cdots p_k!}"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Circular permutations"
   },
   "tex": "(n-1)!;\\quad \\frac{(n-1)!}{2}\\ \\text{if clockwise = anticlockwise (necklace)}"
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Combinations"
   },
   "tex": "^nC_r = \\frac{n!}{r!\\,(n-r)!} = \\frac{^nP_r}{r!}"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Complementary combinations"
   },
   "tex": "^nC_r = {}^nC_{n-r};\\quad {}^nC_x = {}^nC_y \\Rightarrow x = y \\text{ or } x + y = n"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-06-permutations-and-combinations.t4",
   "name": {
    "en": "Pascal's rule"
   },
   "tex": "^nC_r + {}^nC_{r-1} = {}^{n+1}C_r"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-06-permutations-and-combinations.t2",
   "name": {
    "en": "Ratio of consecutive coefficients"
   },
   "tex": "\\frac{^nC_r}{^nC_{r-1}} = \\frac{n - r + 1}{r}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Recursive forms"
   },
   "tex": "^nC_r = \\frac nr\\,{}^{n-1}C_{r-1},\\quad {}^nP_r = n\\cdot{}^{n-1}P_{r-1}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Diagonals of an n-gon"
   },
   "tex": "^nC_2 - n = \\frac{n(n-3)}{2}"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Lines and triangles with m collinear points"
   },
   "tex": "^nC_2 - {}^mC_2 + 1;\\quad {}^nC_3 - {}^mC_3"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Non-negative integer solutions"
   },
   "tex": "x_1 + \\dots + x_r = n:\\ {}^{n+r-1}C_{r-1}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Positive integer solutions"
   },
   "tex": "x_1 + \\dots + x_r = n:\\ {}^{n-1}C_{r-1}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Number of divisors"
   },
   "tex": "N = p_1^{a_1}\\cdots p_k^{a_k} \\Rightarrow (a_1+1)\\cdots(a_k+1)"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-maths-06-permutations-and-combinations.t5",
   "name": {
    "en": "Equal groups"
   },
   "tex": "\\frac{(mn)!}{(n!)^m\\,m!}\\ \\text{unlabelled};\\quad \\frac{(mn)!}{(n!)^m}\\ \\text{distributed to } m \\text{ people}"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Onto distribution"
   },
   "tex": "n \\text{ distinct objects into 3 distinct boxes, none empty: } 3^n - 3\\cdot2^n + 3"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Derangements"
   },
   "tex": "D_n = n!\\left(1 - \\tfrac1{1!} + \\tfrac1{2!} - \\cdots + \\tfrac{(-1)^n}{n!}\\right);\\ D_3 = 2, D_4 = 9, D_5 = 44"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-maths-06-permutations-and-combinations.t3",
   "name": {
    "en": "Gap method (no two together)"
   },
   "tex": "\\text{arrange others, then choose } r \\text{ of the gaps: } {}^{m+1}C_r"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Rectangles on an n×n board"
   },
   "tex": "\\left({}^{n+1}C_2\\right)^2;\\quad \\text{squares} = \\sum_{k=1}^n k^2"
  }
 ]
}
