{
 "chapterId": "puc2-maths-04-determinants",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "2×2 determinant"
   },
   "tex": "\\begin{vmatrix}a&b\\\\c&d\\end{vmatrix} = ad-bc"
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-maths-04-determinants.t3",
   "name": {
    "en": "Minor and cofactor"
   },
   "tex": "A_{ij} = (-1)^{i+j}M_{ij};\\quad |A| = \\sum_j a_{ij}A_{ij}",
   "note": {
    "en": "Elements of one row times the cofactors of another row add to 0."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Basic properties"
   },
   "tex": "|A^T| = |A|;\\ \\text{swapping two rows changes the sign};\\ \\text{two equal or proportional rows}\\Rightarrow0"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Row operations"
   },
   "tex": "R_i\\to R_i+kR_j\\ \\text{leaves}\\ |A|\\ \\text{unchanged}"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Scalar multiple"
   },
   "tex": "|kA| = k^n|A|;\\ \\ |-A| = (-1)^n|A|"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-04-determinants.t1",
   "name": {
    "en": "Product"
   },
   "tex": "|AB| = |A||B|,\\ |A^m| = |A|^m,\\ |A^{-1}| = \\frac1{|A|}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-04-determinants.t1",
   "name": {
    "en": "Triangular / diagonal"
   },
   "tex": "|A| = a_{11}a_{22}\\cdots a_{nn}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-04-determinants.t1",
   "name": {
    "en": "Skew-symmetric of odd order"
   },
   "tex": "|A| = 0"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Vandermonde"
   },
   "tex": "\\begin{vmatrix}1&1&1\\\\a&b&c\\\\a^2&b^2&c^2\\end{vmatrix} = (a-b)(b-c)(c-a)"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Circulant"
   },
   "tex": "\\begin{vmatrix}a&b&c\\\\b&c&a\\\\c&a&b\\end{vmatrix} = -(a^3+b^3+c^3-3abc)"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-maths-04-determinants.t2",
   "name": {
    "en": "Area of a triangle"
   },
   "tex": "\\Delta = \\frac12\\left|\\begin{vmatrix}x_1&y_1&1\\\\x_2&y_2&1\\\\x_3&y_3&1\\end{vmatrix}\\right|;\\ \\ \\text{collinear}\\iff\\text{the determinant} = 0"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-04-determinants.t4",
   "name": {
    "en": "Adjoint"
   },
   "tex": "\\operatorname{adj}A = [A_{ij}]^T;\\ \\ A(\\operatorname{adj}A) = (\\operatorname{adj}A)A = |A|I"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-04-determinants.t4",
   "name": {
    "en": "Adjoint of 2×2"
   },
   "tex": "\\operatorname{adj}\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix} = \\begin{pmatrix}d&-b\\\\-c&a\\end{pmatrix};\\ \\ A+\\operatorname{adj}A = (\\operatorname{tr}A)I"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-maths-04-determinants.t4",
   "name": {
    "en": "Inverse"
   },
   "tex": "A^{-1} = \\frac{\\operatorname{adj}A}{|A|}\\quad (|A|\\ne0)"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-04-determinants.t4",
   "name": {
    "en": "Determinant of adjoint"
   },
   "tex": "|\\operatorname{adj}A| = |A|^{n-1},\\ \\ |\\operatorname{adj}(\\operatorname{adj}A)| = |A|^{(n-1)^2}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-maths-04-determinants.t4",
   "name": {
    "en": "Adjoint identities"
   },
   "tex": "\\operatorname{adj}(\\operatorname{adj}A) = |A|^{n-2}A,\\ \\operatorname{adj}(kA) = k^{n-1}\\operatorname{adj}A,\\ \\operatorname{adj}(AB) = \\operatorname{adj}B\\,\\operatorname{adj}A,\\ \\operatorname{adj}(A^T) = (\\operatorname{adj}A)^T"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-maths-04-determinants.t5",
   "name": {
    "en": "Solving AX = B"
   },
   "tex": "|A|\\ne0:\\ X = A^{-1}B\\ \\text{(unique)}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-maths-04-determinants.t5",
   "name": {
    "en": "Consistency when |A| = 0"
   },
   "tex": "(\\operatorname{adj}A)B\\ne O\\Rightarrow\\text{no solution};\\ (\\operatorname{adj}A)B = O\\Rightarrow\\text{infinitely many or none}",
   "note": {
    "en": "Check the latter case directly, e.g. by expressing one equation through the others."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Cramer's rule"
   },
   "tex": "x = \\frac{\\Delta_1}{\\Delta},\\ y = \\frac{\\Delta_2}{\\Delta},\\ z = \\frac{\\Delta_3}{\\Delta}\\quad(\\Delta\\ne0)"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-maths-04-determinants.t5",
   "name": {
    "en": "Homogeneous system"
   },
   "tex": "AX = O \\text{ has a non-trivial solution}\\iff |A| = 0"
  }
 ]
}
