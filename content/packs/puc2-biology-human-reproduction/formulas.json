{
 "chapterId": "puc2-biology-02-human-reproduction",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-02-human-reproduction.t1",
   "name": {
    "en": "Testis"
   },
   "tex": "4\\text{–}5\\ \\text{cm} \\times 2\\text{–}3\\ \\text{cm};\\ \\approx 250\\ \\text{lobules},\\ 1\\text{–}3\\ \\text{tubules each}",
   "note": {
    "en": "Scrotal temperature 2–2.5 °C below body temperature."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-02-human-reproduction.t1",
   "name": {
    "en": "Testis cells"
   },
   "tex": "\\text{Sertoli: nourish germ cells};\\ \\text{Leydig: androgens}"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Sperm route"
   },
   "tex": "\\text{seminiferous tubule} \\to \\text{rete testis} \\to \\text{vasa efferentia} \\to \\text{epididymis} \\to \\text{vas deferens} \\to \\text{ejaculatory duct} \\to \\text{urethra}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-02-human-reproduction.t1",
   "name": {
    "en": "Accessory glands"
   },
   "tex": "2\\ \\text{seminal vesicles} + 1\\ \\text{prostate} + 2\\ \\text{bulbourethral}",
   "note": {
    "en": "Seminal plasma: fructose, calcium, enzymes."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-02-human-reproduction.t3",
   "name": {
    "en": "Spermatogenesis"
   },
   "tex": "\\text{spermatogonium}\\ (46) \\to 1^{\\circ}\\ \\text{spermatocyte}\\ (46) \\xrightarrow{\\text{M I}} 2 \\times 2^{\\circ}\\ (23) \\xrightarrow{\\text{M II}} 4\\ \\text{spermatids}\\ (23)",
   "note": {
    "en": "Spermiogenesis: spermatid → sperm. Spermiation: release."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-02-human-reproduction.t1",
   "name": {
    "en": "Hormonal control (male)"
   },
   "tex": "\\text{GnRH} \\to \\text{LH} \\to \\text{Leydig};\\quad \\text{FSH} \\to \\text{Sertoli}"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Semen quality"
   },
   "tex": "200\\text{–}300 \\times 10^6\\ \\text{sperms};\\ \\geq 60\\%\\ \\text{normal shape},\\ \\geq 40\\%\\ \\text{vigorous motility}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-02-human-reproduction.t2",
   "name": {
    "en": "Oviduct"
   },
   "tex": "10\\text{–}12\\ \\text{cm}:\\ \\text{infundibulum (fimbriae)} \\to \\text{ampulla} \\to \\text{isthmus}",
   "note": {
    "en": "Ovary 2–4 cm long."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-02-human-reproduction.t2",
   "name": {
    "en": "Uterine wall"
   },
   "tex": "\\text{perimetrium} \\mid \\text{myometrium (contractions)} \\mid \\text{endometrium (cyclic)}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-02-human-reproduction.t2",
   "name": {
    "en": "Milk route"
   },
   "tex": "\\text{alveoli} \\to \\text{mammary tubules} \\to \\text{mammary duct} \\to \\text{mammary ampulla} \\to \\text{lactiferous duct}",
   "note": {
    "en": "15–20 mammary lobes per breast."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-02-human-reproduction.t3",
   "name": {
    "en": "Oogenesis"
   },
   "tex": "\\text{oogonia (fetal life)} \\to 1^{\\circ}\\ \\text{oocyte (arrested prophase I)}",
   "note": {
    "en": "Millions of oogonia per fetal ovary; 60,000–80,000 primary follicles left at puberty."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-02-human-reproduction.t5",
   "name": {
    "en": "Follicle sequence"
   },
   "tex": "\\text{primary} \\to \\text{secondary} \\to \\text{tertiary (antrum)} \\to \\text{Graafian}",
   "note": {
    "en": "Zona pellucida forms around the secondary oocyte."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-02-human-reproduction.t3",
   "name": {
    "en": "Meiosis in oogenesis"
   },
   "tex": "1^{\\circ} \\xrightarrow{\\text{M I, unequal}} 2^{\\circ}\\ \\text{oocyte} + \\text{PB}_1;\\quad 2^{\\circ} \\xrightarrow{\\text{M II on sperm entry}} \\text{ovum} + \\text{PB}_2",
   "note": {
    "en": "Ovulation releases the secondary oocyte."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Gamete yield"
   },
   "tex": "1\\ \\text{spermatocyte} \\to 4\\ \\text{sperms};\\quad 1\\ \\text{oocyte} \\to 1\\ \\text{ovum}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-02-human-reproduction.t4",
   "name": {
    "en": "Menstrual cycle"
   },
   "tex": "28/29\\ \\text{days}:\\ \\text{menses } (3\\text{–}5\\ \\text{d}) \\to \\text{follicular} \\to \\text{ovulation (day 14, LH surge)} \\to \\text{luteal}",
   "note": {
    "en": "Menarche at puberty; menopause around 50 years."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-02-human-reproduction.t4",
   "name": {
    "en": "Luteal phase"
   },
   "tex": "\\text{corpus luteum} \\to \\text{progesterone} \\to \\text{endometrium maintained}",
   "note": {
    "en": "No fertilisation → corpus luteum degenerates → menstruation."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-02-human-reproduction.t5",
   "name": {
    "en": "Fertilisation"
   },
   "tex": "\\text{ampullary region};\\ \\text{zona pellucida blocks polyspermy}",
   "note": {
    "en": "Sex decided by sperm (X or Y)."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-biology-02-human-reproduction.t5",
   "name": {
    "en": "Early development"
   },
   "tex": "\\text{zygote} \\to \\text{blastomeres} \\to \\text{morula } (8\\text{–}16) \\to \\text{blastocyst}",
   "note": {
    "en": "Blastocyst: trophoblast (attaches) + inner cell mass (embryo, stem cells)."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-biology-02-human-reproduction.t5",
   "name": {
    "en": "Placental hormones"
   },
   "tex": "\\text{hCG, hPL, estrogens, progestogens};\\ \\text{relaxin from ovary}",
   "note": {
    "en": "hCG, hPL and relaxin are produced only during pregnancy."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-biology-02-human-reproduction.t3",
   "name": {
    "en": "Foetal milestones"
   },
   "tex": "\\text{1 mo: heart};\\ \\text{2 mo: limbs, digits};\\ \\text{12 wk: major organs};\\ \\text{5 mo: movement, hair};\\ \\text{24 wk: eyelids, eyelashes}",
   "note": {
    "en": "Gestation about 9 months."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-biology-02-human-reproduction.t5",
   "name": {
    "en": "Parturition and lactation"
   },
   "tex": "\\text{foetal ejection reflex} \\to \\text{oxytocin} \\to \\text{uterine contractions}",
   "note": {
    "en": "Colostrum: first milk, rich in antibodies."
   }
  }
 ]
}
