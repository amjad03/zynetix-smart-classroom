{
 "chapterId": "puc2-chemistry-07-alcohols-phenols-and-ethers",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t2",
   "name": {
    "en": "Acid-catalysed hydration (Markovnikov)"
   },
   "tex": "\\text{CH}_3\\text{CH{=}CH}_2 \\xrightarrow{\\text{H}_2\\text{O},\\ \\text{H}^+} \\text{CH}_3\\text{CH(OH)CH}_3",
   "note": {
    "en": "Via carbocation, so rearrangements are possible."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t2",
   "name": {
    "en": "Hydroboration–oxidation (anti-Markovnikov)"
   },
   "tex": "\\text{RCH{=}CH}_2 \\xrightarrow{(i)\\ \\text{B}_2\\text{H}_6\\ (ii)\\ \\text{H}_2\\text{O}_2/\\text{OH}^-} \\text{RCH}_2\\text{CH}_2\\text{OH}",
   "note": {
    "en": "Syn addition, no rearrangement."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t2",
   "name": {
    "en": "Grignard routes to alcohols"
   },
   "tex": "\\text{HCHO} \\to 1^\\circ,\\quad \\text{RCHO} \\to 2^\\circ,\\quad \\text{R}_2\\text{CO} \\to 3^\\circ,\\quad \\text{RCOOR}' + 2\\,\\text{R}''\\text{MgX} \\to 3^\\circ",
   "note": {
    "en": "Followed by H₃O⁺ work-up."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t2",
   "name": {
    "en": "Reduction of carbonyls"
   },
   "tex": "\\text{RCHO} \\xrightarrow{\\text{NaBH}_4\\ \\text{or}\\ \\text{LiAlH}_4} \\text{RCH}_2\\text{OH},\\quad \\text{RCOOH} \\xrightarrow{\\text{LiAlH}_4} \\text{RCH}_2\\text{OH}",
   "note": {
    "en": "NaBH₄ does not reduce –COOH or isolated C=C."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t2",
   "name": {
    "en": "Phenol: cumene process"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{CH(CH}_3)_2 \\xrightarrow{\\text{O}_2} \\text{C}_6\\text{H}_5\\text{C(CH}_3)_2\\text{OOH} \\xrightarrow{\\text{H}^+/\\text{H}_2\\text{O}} \\text{C}_6\\text{H}_5\\text{OH} + \\text{CH}_3\\text{COCH}_3",
   "note": {
    "en": "Other routes: Dow (C₆H₅Cl + NaOH, 623 K, 300 atm); ArN₂⁺ + warm H₂O; ArSO₃H + NaOH fusion."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t3",
   "name": {
    "en": "Acidity order"
   },
   "tex": "\\text{picric acid} > p\\text{-nitrophenol} > \\text{phenol} > p\\text{-cresol} > \\text{H}_2\\text{O} > \\text{CH}_3\\text{OH} > 1^\\circ > 2^\\circ > 3^\\circ\\ \\text{alcohol}",
   "note": {
    "en": "pKa: phenol 10.0, ethanol ≈ 15.9. EWG (–NO₂, –Cl) increase, EDG (–CH₃, –OCH₃) decrease phenol acidity; o/p-NO₂ ≫ m-NO₂."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Lucas test"
   },
   "tex": "\\text{ROH} \\xrightarrow{\\text{conc. HCl} + \\text{ZnCl}_2} \\text{RCl}\\ (\\text{turbidity}):\\ 3^\\circ\\ \\text{immediate},\\ 2^\\circ\\ \\sim 5\\ \\text{min},\\ 1^\\circ\\ \\text{none at RT}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Oxidation of alcohols"
   },
   "tex": "1^\\circ \\xrightarrow{\\text{PCC}} \\text{RCHO};\\quad 1^\\circ \\xrightarrow{\\text{KMnO}_4/\\text{K}_2\\text{Cr}_2\\text{O}_7} \\text{RCOOH};\\quad 2^\\circ \\to \\text{ketone}",
   "note": {
    "en": "Cu at 573 K: 1° → aldehyde, 2° → ketone, 3° → alkene (dehydration)."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Dehydration of alcohols"
   },
   "tex": "\\text{C}_2\\text{H}_5\\text{OH} \\xrightarrow[443\\ \\text{K}]{\\text{conc. H}_2\\text{SO}_4} \\text{CH}_2{=}\\text{CH}_2;\\quad \\xrightarrow[413\\ \\text{K}]{} (\\text{C}_2\\text{H}_5)_2\\text{O}",
   "note": {
    "en": "Ease 3° > 2° > 1°; Saytzeff alkene; watch for hydride/methyl shifts."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Esterification (acyl–O cleavage)"
   },
   "tex": "\\text{RCOOH} + \\text{R}'\\text{OH} \\overset{\\text{H}^+}{\\rightleftharpoons} \\text{RCOOR}' + \\text{H}_2\\text{O}",
   "note": {
    "en": "The alcohol O stays in the ester. Phenols are acylated with RCOCl / pyridine."
   }
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Na with alcohols (H₂ count)"
   },
   "tex": "2\\,\\text{ROH} + 2\\,\\text{Na} \\to 2\\,\\text{RONa} + \\text{H}_2",
   "note": {
    "en": "½ mol H₂ per –OH; RMgX gives 1 mol RH (CH₄ with CH₃MgI) per –OH."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Kolbe's reaction"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{ONa} \\xrightarrow{\\text{CO}_2,\\ 400\\ \\text{K},\\ 4\\text{–}7\\ \\text{atm};\\ \\text{H}^+} o\\text{-HOC}_6\\text{H}_4\\text{COOH}",
   "note": {
    "en": "Salicylic acid → aspirin with (CH₃CO)₂O."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Reimer–Tiemann reaction"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{OH} \\xrightarrow{\\text{CHCl}_3,\\ \\text{aq. NaOH};\\ \\text{H}^+} o\\text{-HOC}_6\\text{H}_4\\text{CHO}",
   "note": {
    "en": "Electrophile: dichlorocarbene :CCl₂. With CCl₄ → salicylic acid."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t5",
   "name": {
    "en": "Bromination of phenol"
   },
   "tex": "\\text{Br}_2/\\text{H}_2\\text{O} \\to 2,4,6\\text{-tribromophenol (white ppt)};\\quad \\text{Br}_2/\\text{CS}_2,\\ 273\\ \\text{K} \\to o/p\\text{-bromophenol}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t4",
   "name": {
    "en": "Nitration of phenol"
   },
   "tex": "\\text{dil. HNO}_3,\\ 298\\ \\text{K} \\to o\\text{- + }p\\text{-nitrophenol};\\quad \\text{conc. H}_2\\text{SO}_4\\ \\text{then conc. HNO}_3 \\to \\text{picric acid}",
   "note": {
    "en": "o-Nitrophenol: intramolecular H-bond → steam volatile."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t5",
   "name": {
    "en": "Williamson ether synthesis (SN2)"
   },
   "tex": "\\text{R–X} + \\text{R}'\\text{–O}^-\\text{Na}^+ \\to \\text{R–O–R}' + \\text{NaX}",
   "note": {
    "en": "R–X must be methyl / 1°; 3° halides give alkenes (E2). Anisole: C₆H₅ONa + CH₃I."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t5",
   "name": {
    "en": "Cleavage of ethers by HI"
   },
   "tex": "\\text{CH}_3\\text{OC}_2\\text{H}_5 \\xrightarrow{\\text{HI}} \\text{CH}_3\\text{I} + \\text{C}_2\\text{H}_5\\text{OH};\\quad (\\text{CH}_3)_3\\text{COCH}_3 \\xrightarrow{\\text{HI}} (\\text{CH}_3)_3\\text{CI} + \\text{CH}_3\\text{OH}",
   "note": {
    "en": "SN2 → I⁻ attacks smaller group; 3° group → SN1. Ar–O–R gives ArOH + RI. Reactivity HI > HBr > HCl."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t1",
   "name": {
    "en": "Iodoform test"
   },
   "tex": "\\text{CH}_3\\text{CH(OH)–R} \\xrightarrow{\\text{I}_2/\\text{NaOH}} \\text{CHI}_3\\downarrow\\ (\\text{yellow})",
   "note": {
    "en": "R = H or C. Positive: ethanol, propan-2-ol; negative: methanol, propan-1-ol."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t3",
   "name": {
    "en": "Phenol with Zn dust / Na"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{OH} + \\text{Zn} \\to \\text{C}_6\\text{H}_6 + \\text{ZnO}",
   "note": {
    "en": "Phenol + NaOH → phenoxide; phenol does not react with NaHCO₃."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-07-alcohols-phenols-and-ethers.t3",
   "name": {
    "en": "Boiling point trend"
   },
   "tex": "\\text{alcohol} > \\text{ether} \\approx \\text{alkane (similar mass)}",
   "note": {
    "en": "Alcohol H-bonding; b.p. rises with C count and falls with branching."
   }
  }
 ]
}
