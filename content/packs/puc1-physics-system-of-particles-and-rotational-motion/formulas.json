{
 "chapterId": "puc1-physics-06-system-of-particles-and-rotational-motion",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Centre of mass"
   },
   "tex": "\\vec R_{cm} = \\dfrac{\\sum m_i\\vec r_i}{\\sum m_i},\\qquad \\vec R_{cm} = \\dfrac{1}{M}\\int\\vec r\\,dm"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Motion of the CM"
   },
   "tex": "M\\vec a_{cm} = \\vec F_{\\text{ext}},\\qquad \\vec P = M\\vec v_{cm}",
   "note": {
    "en": "Internal forces (explosions, mutual attraction) do not change the CM's motion."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Standard CM positions (from centre)"
   },
   "tex": "\\text{semicircular ring } \\dfrac{2R}{\\pi},\\ \\text{semicircular disc } \\dfrac{4R}{3\\pi},\\ \\text{solid hemisphere } \\dfrac{3R}{8},\\ \\text{hollow hemisphere } \\dfrac R2,\\ \\text{cone } \\dfrac h4\\ (\\text{from base})"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Removed portion (negative mass)"
   },
   "tex": "x_{cm} = \\dfrac{M_1x_1 - M_2x_2}{M_1 - M_2}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t2",
   "name": {
    "en": "Vector (cross) product"
   },
   "tex": "|\\vec A\\times\\vec B| = AB\\sin\\theta,\\quad \\hat i\\times\\hat j = \\hat k,\\quad \\vec A\\times\\vec B = -\\vec B\\times\\vec A"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t4",
   "name": {
    "en": "Rotational kinematics"
   },
   "tex": "\\omega = \\omega_0 + \\alpha t,\\quad \\theta = \\omega_0t + \\tfrac12\\alpha t^2,\\quad \\omega^2 = \\omega_0^2 + 2\\alpha\\theta,\\quad v = \\omega r,\\ a_t = \\alpha r"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Torque"
   },
   "tex": "\\vec\\tau = \\vec r\\times\\vec F,\\quad \\tau = rF\\sin\\theta = F\\,r_\\perp"
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Angular momentum"
   },
   "tex": "\\vec L = \\vec r\\times\\vec p,\\quad L = mvr_\\perp;\\qquad L = I\\omega\\ (\\text{rigid body, fixed axis})"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t5",
   "name": {
    "en": "Newton's second law for rotation"
   },
   "tex": "\\vec\\tau_{\\text{ext}} = \\dfrac{d\\vec L}{dt},\\qquad \\tau = I\\alpha"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t5",
   "name": {
    "en": "Conservation of angular momentum"
   },
   "tex": "\\tau_{\\text{ext}} = 0 \\Rightarrow I_1\\omega_1 = I_2\\omega_2"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t3",
   "name": {
    "en": "Equilibrium of a rigid body"
   },
   "tex": "\\sum\\vec F = 0,\\qquad \\sum\\vec\\tau = 0\\ (\\text{about any point})"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t4",
   "name": {
    "en": "Moment of inertia; radius of gyration"
   },
   "tex": "I = \\sum m_ir_i^2 = \\int r^2\\,dm,\\qquad I = Mk^2"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t5",
   "name": {
    "en": "Parallel-axis theorem"
   },
   "tex": "I = I_{cm} + Md^2"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t5",
   "name": {
    "en": "Perpendicular-axis theorem (lamina)"
   },
   "tex": "I_z = I_x + I_y"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Rods"
   },
   "tex": "I_{\\text{centre}} = \\dfrac{ML^2}{12},\\qquad I_{\\text{end}} = \\dfrac{ML^2}{3}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Ring and disc"
   },
   "tex": "\\text{ring: } MR^2\\ (\\text{axis}),\\ \\tfrac12MR^2\\ (\\text{diameter});\\quad \\text{disc: } \\tfrac12MR^2\\ (\\text{axis}),\\ \\tfrac14MR^2\\ (\\text{diameter})"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Spheres and cylinders"
   },
   "tex": "\\text{solid sphere } \\tfrac25MR^2,\\ \\text{hollow sphere } \\tfrac23MR^2,\\ \\text{solid cylinder } \\tfrac12MR^2,\\ \\text{thin-walled cylinder } MR^2"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t5",
   "name": {
    "en": "Rotational KE, work and power"
   },
   "tex": "K = \\tfrac12I\\omega^2 = \\dfrac{L^2}{2I},\\quad W = \\int\\tau\\,d\\theta,\\quad P = \\tau\\omega"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Rolling without slipping"
   },
   "tex": "v_{cm} = \\omega R,\\quad v_{\\text{top}} = 2v_{cm},\\quad v_{\\text{contact}} = 0"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "KE of a rolling body"
   },
   "tex": "K = \\tfrac12mv^2\\left(1 + \\dfrac{k^2}{R^2}\\right)"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Rolling down an incline"
   },
   "tex": "a = \\dfrac{g\\sin\\theta}{1 + k^2/R^2},\\quad v = \\sqrt{\\dfrac{2gh}{1 + k^2/R^2}},\\quad \\mu_{\\min} = \\dfrac{\\tan\\theta}{1 + R^2/k^2}",
   "note": {
    "en": "Order of arrival: solid sphere, disc/solid cylinder, hollow sphere, ring."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t2",
   "name": {
    "en": "Pure rolling from sliding (no initial spin)"
   },
   "tex": "v = \\dfrac{v_0}{1 + k^2/R^2}\\quad (\\text{sphere } \\tfrac57v_0)",
   "note": {
    "en": "Use angular momentum about the contact point."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t1",
   "name": {
    "en": "Yo-yo / string unwinding from a disc"
   },
   "tex": "a = \\dfrac{g}{1 + k^2/R^2} = \\tfrac23g,\\quad T = \\tfrac13mg\\ (\\text{disc})"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-06-system-of-particles-and-rotational-motion.t4",
   "name": {
    "en": "Block on a pulley of moment of inertia I"
   },
   "tex": "a = \\dfrac{mg}{m + I/R^2}"
  }
 ]
}
