{
 "chapterId": "puc2-biology-06-evolution",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-06-evolution.t5",
   "name": {
    "en": "Time scale"
   },
   "tex": "\\text{Universe} \\approx 20\\ \\text{bya};\\ \\text{Earth} \\approx 4.5\\ \\text{bya};\\ \\text{life} \\approx 4\\ \\text{bya}",
   "note": {
    "en": "First cellular forms ~2000 mya."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Origin-of-life theories"
   },
   "tex": "\\text{spontaneous generation (Pasteur disproved)};\\ \\text{panspermia};\\ \\text{chemical evolution (Oparin–Haldane)}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-06-evolution.t1",
   "name": {
    "en": "Miller (1953)"
   },
   "tex": "\\text{CH}_4 + \\text{H}_2 + \\text{NH}_3 + \\text{H}_2\\text{O} \\xrightarrow[800^\\circ\\text{C}]{\\text{electric discharge}} \\text{amino acids}",
   "note": {
    "en": "Reducing atmosphere, no free O₂."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-06-evolution.t2",
   "name": {
    "en": "Homologous (divergent)"
   },
   "tex": "\\text{same structure, different function}",
   "note": {
    "en": "Forelimbs of whale, bat, cheetah, human; vertebrate heart/brain; thorn of Bougainvillea & tendril of Cucurbita."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-06-evolution.t2",
   "name": {
    "en": "Analogous (convergent)"
   },
   "tex": "\\text{different structure, same function}",
   "note": {
    "en": "Wings of butterfly & bird; eye of Octopus & mammal; flippers of penguin & dolphin; sweet potato (root) & potato (stem)."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-06-evolution.t2",
   "name": {
    "en": "Industrial melanism"
   },
   "tex": "\\text{1850: white} > \\text{dark};\\quad \\text{1920: dark} > \\text{white}",
   "note": {
    "en": "Biston betularia, England; soot + loss of lichens. Lichens = pollution indicators."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-06-evolution.t2",
   "name": {
    "en": "Anthropogenic evolution"
   },
   "tex": "\\text{herbicide/pesticide-resistant pests},\\ \\text{antibiotic-resistant microbes}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-06-evolution.t3",
   "name": {
    "en": "Adaptive radiation"
   },
   "tex": "\\text{one ancestor} \\to \\text{many forms in different habitats}",
   "note": {
    "en": "Darwin's finches (Galapagos); Australian marsupials. Placental–marsupial look-alikes (wolf–Tasmanian wolf, anteater–numbat) = convergence."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-06-evolution.t3",
   "name": {
    "en": "Darwinism"
   },
   "tex": "\\text{branching descent} + \\text{natural selection};\\ \\text{fitness} = \\text{reproductive fitness}",
   "note": {
    "en": "HMS Beagle; Wallace — Malay Archipelago."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-06-evolution.t3",
   "name": {
    "en": "Lamarck vs de Vries"
   },
   "tex": "\\text{Lamarck: use/disuse, acquired characters};\\ \\text{de Vries: mutation, saltation}",
   "note": {
    "en": "De Vries worked on Oenothera lamarckiana; mutations random & directionless; Darwin's variations small & directional."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-06-evolution.t4",
   "name": {
    "en": "Hardy–Weinberg"
   },
   "tex": "p + q = 1,\\qquad p^2 + 2pq + q^2 = 1",
   "note": {
    "en": "AA = p², Aa = 2pq, aa = q²."
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Carriers among dominant phenotype"
   },
   "tex": "\\dfrac{2pq}{p^2 + 2pq}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-06-evolution.t4",
   "name": {
    "en": "Factors disturbing H–W"
   },
   "tex": "\\text{gene flow, genetic drift, mutation, recombination, natural selection}",
   "note": {
    "en": "Drastic drift in a new sample → founder effect."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Types of selection"
   },
   "tex": "\\text{stabilising (mean)},\\ \\text{directional (one end)},\\ \\text{disruptive (both ends)}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-06-evolution.t5",
   "name": {
    "en": "History of life (mya)"
   },
   "tex": "\\text{cells } 2000 \\to \\text{invertebrates } 500 \\to \\text{jawless fish } 350 \\to \\text{seaweeds } 320 \\to \\text{Ichthyosaurs } 200 \\to \\text{dinosaurs extinct } 65",
   "note": {
    "en": "Coelacanth (lobefin) caught 1938, South Africa; reptiles lay thick-shelled eggs; T. rex ~20 ft."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-06-evolution.t5",
   "name": {
    "en": "Hominid brain sizes"
   },
   "tex": "\\textit{H. habilis } 650\\text{–}800\\ \\text{cc} < \\textit{H. erectus } 900\\ \\text{cc} < \\text{Neanderthal } 1400\\ \\text{cc}",
   "note": {
    "en": "H. habilis: no meat; H. erectus (Java 1891, 1.5 mya): ate meat; Neanderthal: buried dead, 1,00,000–40,000 yr ago."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-06-evolution.t5",
   "name": {
    "en": "Human evolution timeline"
   },
   "tex": "\\text{Dryopithecus/Ramapithecus } 15\\ \\text{mya} \\to \\text{Australopithecines } 2\\ \\text{mya} \\to \\textit{H. sapiens}\\ 75{,}000\\text{–}10{,}000\\ \\text{yr}",
   "note": {
    "en": "Ramapithecus more man-like. Cave art ~18,000 yr; agriculture ~10,000 yr ago."
   }
  }
 ]
}
