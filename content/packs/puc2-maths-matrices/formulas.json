{
 "chapterId": "puc2-maths-03-matrices",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-maths-03-matrices.t5",
   "name": {
    "en": "Inverse"
   },
   "tex": "A^{-1} = \\frac{\\operatorname{adj}A}{|A|}",
   "note": {
    "en": "Exists iff |A| ≠ 0."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-maths-03-matrices.t2",
   "name": {
    "en": "Scalar multiple"
   },
   "tex": "|kA| = k^n|A|",
   "note": {
    "en": "n = order."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-03-matrices.t5",
   "name": {
    "en": "Adjoint determinant"
   },
   "tex": "|\\operatorname{adj}A| = |A|^{n-1}",
   "note": {
    "en": "adj(adj A) = |A|ⁿ⁻²A."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Double adjoint"
   },
   "tex": "|\\operatorname{adj}(\\operatorname{adj}A)| = |A|^{(n-1)^2}",
   "note": {
    "en": "Frequent JEE Main one-liner."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Reversal laws"
   },
   "tex": "(AB)^T = B^TA^T,\\quad (AB)^{-1} = B^{-1}A^{-1}",
   "note": {
    "en": "Order reverses."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-03-matrices.t5",
   "name": {
    "en": "Cayley–Hamilton (2×2)"
   },
   "tex": "A^2 - (\\operatorname{tr}A)A + |A|I = O",
   "note": {
    "en": "Use to find powers/inverse."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-03-matrices.t5",
   "name": {
    "en": "Cramer's rule"
   },
   "tex": "x = \\frac{D_x}{D},\\ y = \\frac{D_y}{D},\\ z = \\frac{D_z}{D}",
   "note": {
    "en": "D ≠ 0 → unique solution."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-03-matrices.t1",
   "name": {
    "en": "Area of triangle"
   },
   "tex": "\\Delta = \\frac12\\left|\\begin{vmatrix}x_1 & y_1 & 1\\\\ x_2 & y_2 & 1\\\\ x_3 & y_3 & 1\\end{vmatrix}\\right|",
   "note": {
    "en": "Zero ⇔ collinear."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Order and orders count"
   },
   "tex": "A_{m\\times n}\\ \\text{has } mn \\text{ entries};\\ \\text{orders with } N \\text{ entries} = \\text{number of divisors of } N"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-03-matrices.t1",
   "name": {
    "en": "Number of matrices"
   },
   "tex": "m\\times n \\text{ with entries from } k \\text{ values}: k^{mn}"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Product"
   },
   "tex": "(AB)_{ij} = \\sum_k a_{ik}b_{kj};\\quad A_{m\\times n}B_{n\\times p} = C_{m\\times p}",
   "note": {
    "en": "AB ≠ BA in general; AB = O does not imply A = O or B = O."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-03-matrices.t1",
   "name": {
    "en": "Square of a sum"
   },
   "tex": "(A+B)^2 = A^2+AB+BA+B^2",
   "note": {
    "en": "Equals A² + 2AB + B² only when AB = BA."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-03-matrices.t4",
   "name": {
    "en": "Transpose rules"
   },
   "tex": "(A^T)^T = A,\\ (A+B)^T = A^T+B^T,\\ (kA)^T = kA^T,\\ (AB)^T = B^TA^T"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-maths-03-matrices.t4",
   "name": {
    "en": "Symmetric / skew-symmetric"
   },
   "tex": "A^T = A;\\quad A^T = -A\\ (a_{ii} = 0)"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Decomposition"
   },
   "tex": "A = \\underbrace{\\tfrac12(A+A^T)}_{\\text{symmetric}}+\\underbrace{\\tfrac12(A-A^T)}_{\\text{skew}}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-maths-03-matrices.t4",
   "name": {
    "en": "Counting symmetric / skew n×n (k values)"
   },
   "tex": "k^{n(n+1)/2};\\quad k^{n(n-1)/2}\\ (\\text{if } 0 \\text{ allowed and the set is closed under } -)"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Products that preserve symmetry"
   },
   "tex": "AA^T,\\ A^TA,\\ B^TAB\\ (A \\text{ sym}) \\text{ are symmetric};\\ AB-BA \\text{ skew for symmetric } A,B"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Idempotent"
   },
   "tex": "A^2 = A;\\ \\ I-A \\text{ also idempotent}"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Involutory"
   },
   "tex": "A^2 = I\\iff A^{-1} = A"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Nilpotent"
   },
   "tex": "A^k = O\\Rightarrow (I-A)^{-1} = I+A+\\dots+A^{k-1}"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Orthogonal"
   },
   "tex": "AA^T = A^TA = I;\\ \\ \\text{rows (columns) are orthonormal}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Trace"
   },
   "tex": "\\operatorname{tr}(A+B) = \\operatorname{tr}A+\\operatorname{tr}B,\\ \\operatorname{tr}(AB) = \\operatorname{tr}(BA),\\ \\operatorname{tr}(A^TA) = \\sum a_{ij}^2"
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Cayley–Hamilton (2×2)"
   },
   "tex": "A^2-(\\operatorname{tr}A)A+(\\det A)I = O"
  },
  {
   "id": "zs-f24",
   "name": {
    "en": "Rotation matrix"
   },
   "tex": "R(\\alpha) = \\begin{pmatrix}\\cos\\alpha&-\\sin\\alpha\\\\ \\sin\\alpha&\\cos\\alpha\\end{pmatrix},\\ R(\\alpha)R(\\beta) = R(\\alpha+\\beta),\\ R(\\alpha)^n = R(n\\alpha)"
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Powers of special matrices"
   },
   "tex": "\\begin{pmatrix}1&1\\\\0&1\\end{pmatrix}^n = \\begin{pmatrix}1&n\\\\0&1\\end{pmatrix};\\ \\ A^2 = kA\\Rightarrow A^n = k^{n-1}A"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Binomial theorem"
   },
   "tex": "AB = BA\\Rightarrow (A+B)^n = \\sum\\binom nr A^{n-r}B^r",
   "note": {
    "en": "Typical use: A = I + N with N nilpotent."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-maths-03-matrices.t5",
   "name": {
    "en": "Inverse of a product"
   },
   "tex": "(AB)^{-1} = B^{-1}A^{-1},\\ (A^T)^{-1} = (A^{-1})^T"
  }
 ]
}
