{
 "chapterId": "puc1-physics-01-units-and-measurement",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-01-units-and-measurement.t3",
   "name": {
    "en": "Dimensional formula of force"
   },
   "tex": "[F] = [\\text{M}\\,\\text{L}\\,\\text{T}^{-2}]",
   "note": {
    "en": "Newton = kg m s⁻²."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-01-units-and-measurement.t3",
   "name": {
    "en": "Dimensions of energy"
   },
   "tex": "[E] = [\\text{M}\\,\\text{L}^2\\,\\text{T}^{-2}]",
   "note": {
    "en": "Same as work and torque."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-01-units-and-measurement.t3",
   "name": {
    "en": "Planck's constant"
   },
   "tex": "[h] = [\\text{M}\\,\\text{L}^2\\,\\text{T}^{-1}]",
   "note": {
    "en": "Same dimensions as angular momentum."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-01-units-and-measurement.t4",
   "name": {
    "en": "Relative error in a product"
   },
   "tex": "\\frac{\\Delta Q}{Q} = a\\frac{\\Delta x}{x} + b\\frac{\\Delta y}{y}\\quad (Q = x^a y^b)",
   "note": {
    "en": "Errors always add; powers multiply relative errors."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-01-units-and-measurement.t2",
   "name": {
    "en": "Error in sum or difference"
   },
   "tex": "\\Delta(x \\pm y) = \\Delta x + \\Delta y",
   "note": {
    "en": "Absolute errors add even for subtraction."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-01-units-and-measurement.t2",
   "name": {
    "en": "Least count of vernier"
   },
   "tex": "\\text{LC} = 1\\ \\text{MSD} - 1\\ \\text{VSD}",
   "note": {
    "en": "Screw gauge: LC = pitch / circular divisions."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-01-units-and-measurement.t1",
   "name": {
    "en": "Unit conversion"
   },
   "tex": "n_2 = n_1\\left[\\frac{M_1}{M_2}\\right]^a\\left[\\frac{L_1}{L_2}\\right]^b\\left[\\frac{T_1}{T_2}\\right]^c",
   "note": {
    "en": "nu = constant across unit systems."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-01-units-and-measurement.t1",
   "name": {
    "en": "SI base quantities"
   },
   "tex": "\\text{m, kg, s, A, K, mol, cd}",
   "note": {
    "en": "Also defined (dimensionless, once called supplementary units): radian (plane angle), steradian (solid angle)."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Plane and solid angle"
   },
   "tex": "d\\theta = \\dfrac{ds}{r}\\ (\\text{rad}),\\qquad d\\Omega = \\dfrac{dA}{r^2}\\ (\\text{sr})"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Parallax method"
   },
   "tex": "D = \\dfrac{b}{\\theta}\\ (\\theta\\ \\text{in rad})"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Useful units"
   },
   "tex": "1\\ \\text{ly} = 9.46\\times10^{15}\\ \\text{m},\\ 1\\ \\text{AU} = 1.496\\times10^{11}\\ \\text{m},\\ 1\\ \\text{pc} = 3.08\\times10^{16}\\ \\text{m},\\ 1\\ \\text{Å} = 10^{-10}\\ \\text{m},\\ 1\\ \\text{fermi} = 10^{-15}\\ \\text{m}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-01-units-and-measurement.t4",
   "name": {
    "en": "Changing units"
   },
   "tex": "n_1u_1 = n_2u_2,\\qquad n_2 = n_1\\left(\\dfrac{M_1}{M_2}\\right)^a\\left(\\dfrac{L_1}{L_2}\\right)^b\\left(\\dfrac{T_1}{T_2}\\right)^c",
   "note": {
    "en": "For a quantity of dimensions [MᵃLᵇTᶜ]; a bigger unit gives a smaller number."
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Common dimensions"
   },
   "tex": "F:[MLT^{-2}],\\ E,W,\\tau:[ML^2T^{-2}],\\ P:[ML^2T^{-3}],\\ p,J_{\\text{impulse}}:[MLT^{-1}],\\ L,h:[ML^2T^{-1}]"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "More dimensions"
   },
   "tex": "\\text{pressure, stress, }Y,\\ u_E:[ML^{-1}T^{-2}],\\ \\sigma_{\\text{surf}}:[MT^{-2}],\\ G:[M^{-1}L^3T^{-2}],\\ \\eta:[ML^{-1}T^{-1}]"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Electrical dimensions"
   },
   "tex": "q:[AT],\\ V:[ML^2T^{-3}A^{-1}],\\ \\varepsilon_0:[M^{-1}L^{-3}T^4A^2],\\ \\mu_0:[MLT^{-2}A^{-2}],\\ \\mu_0\\varepsilon_0 = 1/c^2"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-01-units-and-measurement.t4",
   "name": {
    "en": "Principle of homogeneity"
   },
   "tex": "[\\text{LHS}] = [\\text{RHS}],\\ \\text{every added term has the same dimensions}",
   "note": {
    "en": "Arguments of sin, exp, log must be dimensionless. A correct dimension does not prove an equation correct."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-01-units-and-measurement.t4",
   "name": {
    "en": "Dimensional analysis limits"
   },
   "tex": "\\text{cannot find pure numbers }(2\\pi,\\tfrac12),\\ \\text{nor handle sums or exp/trig functions}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-01-units-and-measurement.t1",
   "name": {
    "en": "Mean and absolute errors"
   },
   "tex": "\\bar a = \\dfrac{1}{n}\\sum a_i,\\quad \\Delta a_i = |a_i - \\bar a|,\\quad \\overline{\\Delta a} = \\dfrac{1}{n}\\sum\\Delta a_i"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Relative and percentage error"
   },
   "tex": "\\delta a = \\dfrac{\\overline{\\Delta a}}{\\bar a},\\qquad \\text{percentage error} = \\dfrac{\\overline{\\Delta a}}{\\bar a}\\times100\\%"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Error in sum or difference"
   },
   "tex": "Z = A \\pm B \\Rightarrow \\Delta Z = \\Delta A + \\Delta B",
   "note": {
    "en": "Absolute errors always add; a difference of close numbers has a large relative error."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-01-units-and-measurement.t4",
   "name": {
    "en": "Error in product or quotient"
   },
   "tex": "Z = AB\\ \\text{or}\\ A/B \\Rightarrow \\dfrac{\\Delta Z}{Z} = \\dfrac{\\Delta A}{A} + \\dfrac{\\Delta B}{B}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Error in powers"
   },
   "tex": "Z = \\dfrac{A^pB^q}{C^r} \\Rightarrow \\dfrac{\\Delta Z}{Z} = p\\dfrac{\\Delta A}{A} + q\\dfrac{\\Delta B}{B} + r\\dfrac{\\Delta C}{C}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-physics-01-units-and-measurement.t2",
   "name": {
    "en": "Significant figures: counting"
   },
   "tex": "\\text{non-zero digits, zeros between them, and trailing zeros after a decimal point count; leading zeros do not}",
   "note": {
    "en": "Scientific notation removes ambiguity: 4.700 × 10² has 4 s.f."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-01-units-and-measurement.t2",
   "name": {
    "en": "Significant figures: operations"
   },
   "tex": "\\times,\\div:\\ \\text{fewest s.f.};\\qquad +,-:\\ \\text{fewest decimal places}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-physics-01-units-and-measurement.t2",
   "name": {
    "en": "Rounding rule (NCERT)"
   },
   "tex": "\\text{drop a lone 5: preceding digit even} \\to \\text{unchanged, odd} \\to +1",
   "note": {
    "en": "2.745 → 2.74, 2.735 → 2.74."
   }
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Order of magnitude"
   },
   "tex": "N = a\\times10^b,\\ 0.5 \\le a < 5 \\Rightarrow \\text{order} = 10^b"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Vernier calliper"
   },
   "tex": "\\text{LC} = 1\\ \\text{MSD} - 1\\ \\text{VSD} = \\dfrac{1\\ \\text{MSD}}{N},\\quad \\text{reading} = \\text{MSR} + n\\times\\text{LC} - (\\text{zero error})"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-physics-01-units-and-measurement.t2",
   "name": {
    "en": "Screw gauge"
   },
   "tex": "\\text{LC} = \\dfrac{\\text{pitch}}{\\text{no. of circular divisions}},\\quad \\text{reading} = \\text{MSR} + n\\times\\text{LC} - (\\text{zero error})",
   "note": {
    "en": "Zero error carries its sign; positive error is subtracted."
   }
  }
 ]
}
