{
 "chapterId": "puc2-physics-11-dual-nature-of-radiation-and-matter",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t3",
   "name": {
    "en": "Photon energy"
   },
   "tex": "E = h\\nu = \\frac{hc}{\\lambda} = \\frac{1240}{\\lambda(\\text{nm})}\\ \\text{eV}",
   "note": {
    "en": "Fast mental calculator."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t3",
   "name": {
    "en": "Photoelectric equation"
   },
   "tex": "h\\nu = \\phi_0 + eV_0",
   "note": {
    "en": "Intensity affects current only."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t5",
   "name": {
    "en": "de Broglie wavelength"
   },
   "tex": "\\lambda = \\frac hp = \\frac{h}{\\sqrt{2mK}}",
   "note": {
    "en": "Electron: 12.27/√V Å."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Bohr energy"
   },
   "tex": "E_n = -13.6\\frac{Z^2}{n^2}\\ \\text{eV}",
   "note": {
    "en": "H ground state −13.6 eV."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Bohr radius"
   },
   "tex": "r_n = 0.529\\frac{n^2}{Z}\\ \\text{Å}",
   "note": {
    "en": "r ∝ n²/Z."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Rydberg formula"
   },
   "tex": "\\frac1\\lambda = RZ^2\\left(\\frac{1}{n_1^2} - \\frac{1}{n_2^2}\\right)",
   "note": {
    "en": "R ≈ 1.097 × 10⁷ m⁻¹."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t4",
   "name": {
    "en": "Radioactive decay"
   },
   "tex": "N = N_0e^{-\\lambda t},\\quad T_{1/2} = \\frac{0.693}{\\lambda}",
   "note": {
    "en": "Mean life τ = 1/λ."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t4",
   "name": {
    "en": "Mass–energy"
   },
   "tex": "E = \\Delta m\\,c^2,\\quad 1\\ \\text{u} = 931.5\\ \\text{MeV}",
   "note": {
    "en": "Binding energy from mass defect."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t3",
   "name": {
    "en": "Photon energy"
   },
   "tex": "E = h\\nu = \\dfrac{hc}{\\lambda}",
   "note": {
    "en": "$hc \\approx 1240$ eV nm $= 12400$ eV Å"
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t4",
   "name": {
    "en": "Photon momentum"
   },
   "tex": "p = \\dfrac{h}{\\lambda} = \\dfrac{E}{c}",
   "note": {
    "en": "Rest mass of a photon is zero; it always moves at c in vacuum"
   }
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Photon flux"
   },
   "tex": "N = \\dfrac{P}{h\\nu} = \\dfrac{P\\lambda}{hc}",
   "note": {
    "en": "Photons per second from a source of power P"
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Radiation force (normal incidence)"
   },
   "tex": "F = \\dfrac{P}{c}\\ (\\text{absorbed}),\\quad F = \\dfrac{2P}{c}\\ (\\text{reflected})",
   "note": {
    "en": "Partly reflecting at angle $\\theta$: $F_n = \\dfrac{IA\\cos^2\\theta}{c}(1 + r)$"
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t3",
   "name": {
    "en": "Einstein's photoelectric equation"
   },
   "tex": "K_\\text{max} = h\\nu - \\phi = eV_0"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t1",
   "name": {
    "en": "Work function and threshold"
   },
   "tex": "\\phi = h\\nu_0 = \\dfrac{hc}{\\lambda_0}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t2",
   "name": {
    "en": "Stopping potential line"
   },
   "tex": "V_0 = \\dfrac{h}{e}\\nu - \\dfrac{\\phi}{e}",
   "note": {
    "en": "Slope $h/e$ (same for all metals); $\\nu$-intercept $\\nu_0$; $V_0$-intercept $-\\phi/e$"
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t3",
   "name": {
    "en": "Kinetic energy in two wavelengths"
   },
   "tex": "eV_1 - eV_2 = hc\\left(\\dfrac{1}{\\lambda_1} - \\dfrac{1}{\\lambda_2}\\right)",
   "note": {
    "en": "Subtracting two Einstein equations eliminates φ"
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t2",
   "name": {
    "en": "Photocurrent"
   },
   "tex": "I = \\eta\\,\\dfrac{P}{h\\nu}\\,e",
   "note": {
    "en": "η = quantum efficiency; saturation current ∝ intensity"
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t2",
   "name": {
    "en": "Intensity vs frequency"
   },
   "tex": "I_\\text{sat} \\propto \\text{intensity},\\quad V_0 \\text{ depends only on } \\nu \\text{ and } \\phi",
   "note": {
    "en": "No emission below ν₀ however intense; no time lag"
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t5",
   "name": {
    "en": "de Broglie wavelength"
   },
   "tex": "\\lambda = \\dfrac{h}{p} = \\dfrac{h}{mv} = \\dfrac{h}{\\sqrt{2mK}}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t5",
   "name": {
    "en": "Charged particle through potential V"
   },
   "tex": "\\lambda = \\dfrac{h}{\\sqrt{2mqV}}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t5",
   "name": {
    "en": "Electron accelerated through V"
   },
   "tex": "\\lambda = \\dfrac{1.227}{\\sqrt{V}}\\ \\text{nm} = \\dfrac{12.27}{\\sqrt{V}}\\ \\text{Å}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Thermal particle"
   },
   "tex": "\\lambda = \\dfrac{h}{\\sqrt{3mkT}}",
   "note": {
    "en": "Using $K = \\tfrac32 kT$"
   }
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Comparisons"
   },
   "tex": "\\text{same } v: \\lambda \\propto \\tfrac1m;\\quad \\text{same } K: \\lambda \\propto \\tfrac{1}{\\sqrt m};\\quad \\text{same } V: \\lambda \\propto \\tfrac{1}{\\sqrt{mq}}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t3",
   "name": {
    "en": "Electron vs photon of same λ"
   },
   "tex": "E_\\gamma = pc,\\quad K_e = \\dfrac{p^2}{2m},\\quad \\dfrac{E_\\gamma}{K_e} = \\dfrac{2c}{v}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-physics-11-dual-nature-of-radiation-and-matter.t5",
   "name": {
    "en": "Davisson–Germer"
   },
   "tex": "V = 54\\ \\text{V} \\Rightarrow \\lambda = 0.167\\ \\text{nm},\\ \\text{peak at } 50^\\circ",
   "note": {
    "en": "Electron diffraction from Ni confirmed λ = h/p"
   }
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Constants"
   },
   "tex": "h = 6.63\\times10^{-34}\\ \\text{J s},\\ e = 1.6\\times10^{-19}\\ \\text{C},\\ m_e = 9.1\\times10^{-31}\\ \\text{kg}"
  }
 ]
}
