{
 "chapterId": "puc2-maths-05-continuity-and-differentiability",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t4",
   "name": {
    "en": "Power rule"
   },
   "tex": "\\frac{d}{dx}x^n = nx^{n-1}",
   "note": {
    "en": "Any real n."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t4",
   "name": {
    "en": "Product rule"
   },
   "tex": "(uv)' = u'v + uv'",
   "note": {
    "en": "Extend to three factors similarly."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t4",
   "name": {
    "en": "Quotient rule"
   },
   "tex": "\\left(\\frac uv\\right)' = \\frac{u'v - uv'}{v^2}",
   "note": {
    "en": "v ≠ 0."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t2",
   "name": {
    "en": "Chain rule"
   },
   "tex": "\\frac{dy}{dx} = \\frac{dy}{du}\\cdot\\frac{du}{dx}",
   "note": {
    "en": "Outside-in."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t3",
   "name": {
    "en": "Inverse trig"
   },
   "tex": "\\frac{d}{dx}\\sin^{-1}x = \\frac{1}{\\sqrt{1 - x^2}},\\quad \\frac{d}{dx}\\tan^{-1}x = \\frac{1}{1 + x^2}",
   "note": {
    "en": "|x| < 1 for sin⁻¹."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t5",
   "name": {
    "en": "Parametric"
   },
   "tex": "\\frac{dy}{dx} = \\frac{dy/dt}{dx/dt}",
   "note": {
    "en": "Second derivative needs care."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Tangent slope & normal"
   },
   "tex": "m_T = f'(x_1),\\quad m_N = -\\frac{1}{f'(x_1)}",
   "note": {
    "en": "Applications of derivatives."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Maxima test"
   },
   "tex": "f'(c) = 0,\\ f''(c) < 0 \\Rightarrow \\text{max}",
   "note": {
    "en": "f'' > 0 → min."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t1",
   "name": {
    "en": "Continuity at a point"
   },
   "tex": "\\lim_{x\\to c^-} f(x) = \\lim_{x\\to c^+} f(x) = f(c)",
   "note": {
    "en": "All three must exist and be equal."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t1",
   "name": {
    "en": "Algebra of continuous functions"
   },
   "tex": "f \\pm g,\\; fg,\\; \\dfrac{f}{g}\\,(g \\ne 0),\\; f\\circ g \\text{ are continuous if } f, g \\text{ are}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t1",
   "name": {
    "en": "Standard limits"
   },
   "tex": "\\lim_{x\\to0}\\dfrac{\\sin x}{x} = 1,\\quad \\lim_{x\\to0}\\dfrac{e^x - 1}{x} = 1,\\quad \\lim_{x\\to0}\\dfrac{\\log(1+x)}{x} = 1,\\quad \\lim_{x\\to0}\\dfrac{1 - \\cos x}{x^2} = \\dfrac12"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Derivative (first principles)"
   },
   "tex": "f'(c) = \\lim_{h\\to0}\\dfrac{f(c + h) - f(c)}{h}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t2",
   "name": {
    "en": "Differentiability test"
   },
   "tex": "\\text{LHD} = \\lim_{h\\to0^-}\\dfrac{f(c+h) - f(c)}{h} = \\text{RHD}",
   "note": {
    "en": "Differentiable ⇒ continuous; the converse fails (e.g. |x| at 0)."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Corners of modulus functions"
   },
   "tex": "|g(x)| \\text{ is non-differentiable where } g(x) = 0,\\ g'(x) \\ne 0",
   "note": {
    "en": "A factor (x − a) multiplying |x − a| removes the corner."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t4",
   "name": {
    "en": "Product and quotient rules"
   },
   "tex": "(uv)' = u'v + uv',\\qquad \\left(\\dfrac uv\\right)' = \\dfrac{u'v - uv'}{v^2}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t2",
   "name": {
    "en": "Chain rule"
   },
   "tex": "\\dfrac{dy}{dx} = \\dfrac{dy}{du}\\cdot\\dfrac{du}{dx}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t3",
   "name": {
    "en": "Inverse trig (sin, cos)"
   },
   "tex": "(\\sin^{-1}x)' = \\dfrac{1}{\\sqrt{1 - x^2}},\\quad (\\cos^{-1}x)' = -\\dfrac{1}{\\sqrt{1 - x^2}}",
   "note": {
    "en": "|x| < 1"
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t3",
   "name": {
    "en": "Inverse trig (tan, cot)"
   },
   "tex": "(\\tan^{-1}x)' = \\dfrac{1}{1 + x^2},\\quad (\\cot^{-1}x)' = -\\dfrac{1}{1 + x^2}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t3",
   "name": {
    "en": "Inverse trig (sec, cosec)"
   },
   "tex": "(\\sec^{-1}x)' = \\dfrac{1}{|x|\\sqrt{x^2 - 1}},\\quad (\\csc^{-1}x)' = -\\dfrac{1}{|x|\\sqrt{x^2 - 1}}",
   "note": {
    "en": "|x| > 1"
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t4",
   "name": {
    "en": "Exponential and log"
   },
   "tex": "(e^x)' = e^x,\\ (a^x)' = a^x\\log a,\\ (\\log x)' = \\dfrac1x,\\ (\\log_a x)' = \\dfrac{1}{x\\log a}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t4",
   "name": {
    "en": "Logarithmic differentiation"
   },
   "tex": "y = u^v \\Rightarrow \\dfrac{dy}{dx} = u^v\\left(v'\\log u + \\dfrac{v\\,u'}{u}\\right)"
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t3",
   "name": {
    "en": "Implicit differentiation"
   },
   "tex": "F(x, y) = 0:\\ \\text{differentiate term by term, treating } y = y(x),\\ (y^n)' = ny^{n-1}y'"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t5",
   "name": {
    "en": "Parametric first derivative"
   },
   "tex": "\\dfrac{dy}{dx} = \\dfrac{dy/dt}{dx/dt}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t5",
   "name": {
    "en": "Parametric second derivative"
   },
   "tex": "\\dfrac{d^2y}{dx^2} = \\dfrac{d}{dt}\\!\\left(\\dfrac{dy}{dx}\\right)\\Big/\\dfrac{dx}{dt}",
   "note": {
    "en": "Not (d²y/dt²)/(d²x/dt²)."
   }
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Derivative of f w.r.t. g"
   },
   "tex": "\\dfrac{df}{dg} = \\dfrac{f'(x)}{g'(x)}"
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t3",
   "name": {
    "en": "Useful substitutions"
   },
   "tex": "\\sqrt{1 - x^2}: x = \\sin\\theta;\\ \\ \\dfrac{2x}{1 \\pm x^2}, \\dfrac{1 - x^2}{1 + x^2}: x = \\tan\\theta;\\ \\ \\sqrt{1 \\pm x}: x = \\cos2\\theta",
   "note": {
    "en": "Always check the range of θ before simplifying sin⁻¹(sin 2θ) etc."
   }
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Rolle's theorem"
   },
   "tex": "f \\text{ cont. on } [a,b],\\ \\text{diff. on } (a,b),\\ f(a) = f(b) \\Rightarrow \\exists\\, c \\in (a,b):\\ f'(c) = 0",
   "note": {
    "en": "JEE Advanced only: dropped from rationalised NCERT and JEE Main 2024."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-maths-05-continuity-and-differentiability.t1",
   "name": {
    "en": "Lagrange's Mean Value Theorem"
   },
   "tex": "\\exists\\, c \\in (a, b):\\ f'(c) = \\dfrac{f(b) - f(a)}{b - a}",
   "note": {
    "en": "For a quadratic, c is the midpoint (a + b)/2. JEE Advanced only: dropped from rationalised NCERT and JEE Main 2024."
   }
  },
  {
   "id": "zs-f29",
   "name": {
    "en": "Greatest integer function"
   },
   "tex": "[x] \\text{ is discontinuous at every integer};\\ [g(x)] \\text{ can jump where } g(x) \\in \\mathbb{Z}"
  }
 ]
}
