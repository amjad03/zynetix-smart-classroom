 "title": {
  "en": "Statement of Profit and Loss",
  "kn": "ಲಾಭ ಮತ್ತು ನಷ್ಟದ ತಃಖ್ತೆ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Did the company earn a profit?",
    "kn": "ಕಂಪನಿ ಲಾಭ ಗಳಿಸಿತೇ?"
   },
   "hook": {
    "en": "The Statement of Profit and Loss is like a report card for the year: it starts with revenue and ends with the profit for the period.",
    "kn": "ಲಾಭ ಮತ್ತು ನಷ್ಟದ ತಃಖ್ತೆ ವರ್ಷದ ಪ್ರಗತಿ ಪತ್ರದಂತೆ: ಆದಾಯದಿಂದ ಆರಂಭವಾಗಿ ಆ ಅವಧಿಯ ಲಾಭದಲ್ಲಿ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "State the format of Part II of Schedule III"
    },
    {
     "en": "Classify incomes and expenses"
    },
    {
     "en": "Compute profit for the period"
    }
   ],
   "narration": {
    "en": "The Statement of Profit and Loss is like a report card for the year: it starts with revenue and ends with the profit for the period.",
    "kn": "ಲಾಭ ಮತ್ತು ನಷ್ಟದ ತಃಖ್ತೆ ವರ್ಷದ ಪ್ರಗತಿ ಪತ್ರದಂತೆ: ಆದಾಯದಿಂದ ಆರಂಭವಾಗಿ ಆ ಅವಧಿಯ ಲಾಭದಲ್ಲಿ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Format of the Statement of Profit and Loss"
   },
   "body": {
    "en": "I Revenue from operations; II Other income; III Total income (I + II); IV Expenses: cost of materials consumed, purchases of stock-in-trade, changes in inventories of finished goods, WIP and stock-in-trade, employee benefits expense, finance costs, depreciation and amortisation expense, other expenses; V Profit before tax (III − IV); VI Tax expense; VII Profit for the period (V − VI).",
    "kn": "ಕಾರ್ಯಾಚರಣಾ ಆದಾಯ ಮತ್ತು ಇತರ ಆದಾಯ ಸೇರಿ ಒಟ್ಟು ಆದಾಯ. ಒಟ್ಟು ವೆಚ್ಚ ಕಳೆದರೆ ತೆರಿಗೆ ಪೂರ್ವ ಲಾಭ; ತೆರಿಗೆ ಕಳೆದರೆ ಅವಧಿಯ ಲಾಭ."
   },
   "points": [
    {
     "en": "Changes in inventories = opening − closing"
    },
    {
     "en": "Interest → finance costs"
    },
    {
     "en": "Rent, advertisement, repairs → other expenses"
    }
   ],
   "narration": {
    "en": "Total income is revenue from operations plus other income. Subtract total expenses to get profit before tax, and subtract tax to get profit for the period.",
    "kn": "ಕಾರ್ಯಾಚರಣಾ ಆದಾಯ ಮತ್ತು ಇತರ ಆದಾಯ ಸೇರಿ ಒಟ್ಟು ಆದಾಯ. ಒಟ್ಟು ವೆಚ್ಚ ಕಳೆದರೆ ತೆರಿಗೆ ಪೂರ್ವ ಲಾಭ; ತೆರಿಗೆ ಕಳೆದರೆ ಅವಧಿಯ ಲಾಭ."
   },
   "formula": "\\text{Profit for the period} = (\\text{Revenue from operations} + \\text{Other income}) - \\text{Expenses} - \\text{Tax}"
  },
