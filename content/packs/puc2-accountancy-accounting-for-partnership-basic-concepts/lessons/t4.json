  {
   "id": "sim1",
   "type": "interactive",
   "kind": "scene",
   "title": {
    "en": "Interest on drawings: the average period",
    "kn": "ಸೆಳೆತದ ಮೇಲಿನ ಬಡ್ಡಿ: ಸರಾಸರಿ ಅವಧಿ"
   },
   "caption": {
    "en": "Each drawing earns interest from the day it is taken until the year end. Average those periods and charge interest once on the total drawings: total × rate × average months ÷ 12.",
    "kn": "ಪ್ರತಿ ಸೆಳೆತಕ್ಕೆ ತೆಗೆದ ದಿನದಿಂದ ವರ್ಷದ ಕೊನೆಯವರೆಗೆ ಬಡ್ಡಿ. ಆ ಅವಧಿಗಳ ಸರಾಸರಿ ತೆಗೆದು ಒಟ್ಟು ಸೆಳೆತದ ಮೇಲೆ ಒಮ್ಮೆ ಬಡ್ಡಿ: ಒಟ್ಟು × ದರ × ಸರಾಸರಿ ತಿಂಗಳು ÷ 12."
   },
   "seconds": 150,
   "optional": true,
   "sliders": [
    {
     "name": "amt",
     "label": {
      "en": "Each drawing"
     },
     "min": 1,
     "max": 20,
     "step": 1,
     "value": 5,
     "unit": "₹ '000"
    },
    {
     "name": "r",
     "label": {
      "en": "Rate of interest"
     },
     "min": 1,
     "max": 12,
     "step": 1,
     "value": 6,
     "unit": "% p.a."
    }
   ],
   "choices": [
    {
     "name": "ch",
     "label": {
      "en": "Drawings are made",
      "kn": "ಸೆಳೆತದ ಸಮಯ"
     },
     "options": [
      {
       "label": {
        "en": "Monthly, at the beginning"
       },
       "value": 1
      },
      {
       "label": {
        "en": "Monthly, in the middle"
       },
       "value": 2
      },
      {
       "label": {
        "en": "Monthly, at the end"
       },
       "value": 3
      },
      {
       "label": {
        "en": "Quarterly, at the beginning"
       },
       "value": 4
      },
      {
       "label": {
        "en": "Quarterly, at the end"
       },
       "value": 5
      }
     ],
     "value": 1
    }
   ],
   "vars": [
    {
     "name": "q",
     "expr": "ch >= 4"
    },
    {
     "name": "avg",
     "expr": "if(ch == 1, 6.5, if(ch == 2, 6, if(ch == 3, 5.5, if(ch == 4, 7.5, 4.5))))"
    },
    {
     "name": "off",
     "expr": "if(ch == 1, 0, if(ch == 2, 0.5, if(ch == 3, 1, if(ch == 4, 0, 3))))"
    },
    {
     "name": "tot",
     "expr": "amt*if(q, 4, 12)"
