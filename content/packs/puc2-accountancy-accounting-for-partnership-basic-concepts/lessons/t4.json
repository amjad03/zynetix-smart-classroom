  {
   "id": "ex1",
   "type": "example",
   "title": {
    "en": "Equal monthly drawings"
   },
   "problem": {
    "en": "A partner withdraws ₹5,000 at the beginning of every month. Interest on drawings is 6% p.a. Find the interest for the year."
   },
   "steps": [
    {
     "en": "Total drawings = 5,000 × 12 = ₹60,000."
    },
    {
     "en": "Average period (beginning of month) = 6.5 months."
    },
    {
     "en": "Interest = 60,000 × 6/100 × 6.5/12 = ₹1,950."
    }
   ],
   "answer": {
    "en": "₹1,950"
   },
