{
 "chapterId": "puc2-maths-02-inverse-trigonometric-functions",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "sin⁻¹"
   },
   "tex": "[-1,1]\\to\\left[-\\tfrac\\pi2,\\tfrac\\pi2\\right]"
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "cos⁻¹"
   },
   "tex": "[-1,1]\\to[0,\\pi]"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "tan⁻¹"
   },
   "tex": "\\mathbb R\\to\\left(-\\tfrac\\pi2,\\tfrac\\pi2\\right)"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "cot⁻¹"
   },
   "tex": "\\mathbb R\\to(0,\\pi)"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "sec⁻¹"
   },
   "tex": "|x|\\ge1\\to[0,\\pi]-\\left\\{\\tfrac\\pi2\\right\\}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "cosec⁻¹"
   },
   "tex": "|x|\\ge1\\to\\left[-\\tfrac\\pi2,\\tfrac\\pi2\\right]-\\{0\\}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t4",
   "name": {
    "en": "Negative arguments"
   },
   "tex": "\\sin^{-1}(-x) = -\\sin^{-1}x,\\ \\tan^{-1}(-x) = -\\tan^{-1}x,\\ \\operatorname{cosec}^{-1}(-x) = -\\operatorname{cosec}^{-1}x",
   "note": {
    "en": "These three functions are odd."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t4",
   "name": {
    "en": "Negative arguments (π − type)"
   },
   "tex": "\\cos^{-1}(-x) = \\pi-\\cos^{-1}x,\\ \\cot^{-1}(-x) = \\pi-\\cot^{-1}x,\\ \\sec^{-1}(-x) = \\pi-\\sec^{-1}x"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t4",
   "name": {
    "en": "Reciprocal arguments"
   },
   "tex": "\\operatorname{cosec}^{-1}x = \\sin^{-1}\\tfrac1x,\\ \\sec^{-1}x = \\cos^{-1}\\tfrac1x;\\ \\cot^{-1}x = \\tan^{-1}\\tfrac1x\\ (x>0)"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t4",
   "name": {
    "en": "Complementary pairs"
   },
   "tex": "\\sin^{-1}x+\\cos^{-1}x = \\tan^{-1}x+\\cot^{-1}x = \\sec^{-1}x+\\operatorname{cosec}^{-1}x = \\tfrac\\pi2"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "tan⁻¹x + tan⁻¹(1/x)"
   },
   "tex": "= \\tfrac\\pi2\\ (x>0),\\quad -\\tfrac\\pi2\\ (x<0)"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "Sum of tan⁻¹"
   },
   "tex": "\\tan^{-1}x+\\tan^{-1}y = \\tan^{-1}\\frac{x+y}{1-xy}\\ (xy<1);\\ \\ \\pi+\\tan^{-1}\\frac{x+y}{1-xy}\\ (x,y>0,\\ xy>1)"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t2",
   "name": {
    "en": "Difference of tan⁻¹"
   },
   "tex": "\\tan^{-1}x-\\tan^{-1}y = \\tan^{-1}\\frac{x-y}{1+xy}\\quad (xy>-1)"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t1",
   "name": {
    "en": "Double angle"
   },
   "tex": "2\\tan^{-1}x = \\tan^{-1}\\frac{2x}{1-x^2} = \\sin^{-1}\\frac{2x}{1+x^2} = \\cos^{-1}\\frac{1-x^2}{1+x^2}\\quad(|x|<1)",
   "note": {
    "en": "For the sin⁻¹ form |x| ≤ 1 suffices; for the cos⁻¹ form, x ≥ 0."
   }
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "2 sin⁻¹x"
   },
   "tex": "2\\sin^{-1}x = \\sin^{-1}\\!\\left(2x\\sqrt{1-x^2}\\right)\\ \\left(|x|\\le\\tfrac1{\\sqrt2}\\right);\\ \\ \\pi-2\\sin^{-1}x\\ \\left(\\tfrac1{\\sqrt2}<x\\le1\\right)"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Triple angle"
   },
   "tex": "3\\sin^{-1}x = \\sin^{-1}(3x-4x^3),\\ \\ 3\\tan^{-1}x = \\tan^{-1}\\frac{3x-x^3}{1-3x^2}\\quad\\left(|x|\\le\\tfrac12,\\ |x|<\\tfrac1{\\sqrt3}\\right)"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-maths-02-inverse-trigonometric-functions.t3",
   "name": {
    "en": "f⁻¹(f(x)) outside the principal range"
   },
   "tex": "\\sin^{-1}(\\sin x) = \\pi-x\\ \\text{on}\\ \\left[\\tfrac\\pi2,\\tfrac{3\\pi}2\\right];\\ \\ \\cos^{-1}(\\cos x) = 2\\pi-x\\ \\text{on}\\ [\\pi,2\\pi];\\ \\ \\tan^{-1}(\\tan x) = x-\\pi\\ \\text{on}\\ \\left(\\tfrac\\pi2,\\tfrac{3\\pi}2\\right)"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "f(f⁻¹(x))"
   },
   "tex": "\\sin(\\sin^{-1}x) = x\\ (|x|\\le1),\\quad \\tan(\\tan^{-1}x) = x\\ (x\\in\\mathbb R)"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Telescoping"
   },
   "tex": "\\tan^{-1}\\frac{a-b}{1+ab} = \\tan^{-1}a-\\tan^{-1}b",
   "note": {
    "en": "e.g. 1/(1 + n(n+1)) and 2/n² = 2/(1 + (n+1)(n−1))"
   }
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Useful value"
   },
   "tex": "\\tan^{-1}1+\\tan^{-1}2+\\tan^{-1}3 = \\pi"
  }
 ]
}
