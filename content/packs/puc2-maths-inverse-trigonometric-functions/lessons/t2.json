 "title": {
  "en": "Inverse tangent, cotangent, secant and cosecant",
  "kn": "ವಿಲೋಮ ಟ್ಯಾನ್, ಕಾಟ್, ಸೆಕ್ ಮತ್ತು ಕೊಸೆಕ್"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Four more inverses",
    "kn": "ಇನ್ನೂ ನಾಲ್ಕು ವಿಲೋಮಗಳು"
   },
   "hook": {
    "en": "A ladder leans so that its slope is 1. Its angle with the ground is tan⁻¹(1) = 45°. Every trigonometric ratio has an inverse once we fix the right branch.",
    "kn": "ಏಣಿಯ ಇಳಿಜಾರು 1 ಆದರೆ ನೆಲದೊಂದಿಗಿನ ಕೋನ tan⁻¹(1) = 45°. ಸರಿಯಾದ ಶಾಖೆ ಆರಿಸಿದರೆ ಪ್ರತಿ ತ್ರಿಕೋನಮಿತೀಯ ಅನುಪಾತಕ್ಕೂ ವಿಲೋಮ ಇದೆ."
   },
   "objectives": [
    {
     "en": "State domains and ranges of tan⁻¹, cot⁻¹, sec⁻¹, cosec⁻¹"
    },
    {
     "en": "Find principal values of these functions"
    }
   ],
   "narration": {
    "en": "A ladder leans so that its slope is 1. Its angle with the ground is tan⁻¹(1) = 45°. Every trigonometric ratio has an inverse once we fix the right branch.",
    "kn": "ಏಣಿಯ ಇಳಿಜಾರು 1 ಆದರೆ ನೆಲದೊಂದಿಗಿನ ಕೋನ tan⁻¹(1) = 45°. ಸರಿಯಾದ ಶಾಖೆ ಆರಿಸಿದರೆ ಪ್ರತಿ ತ್ರಿಕೋನಮಿತೀಯ ಅನುಪಾತಕ್ಕೂ ವಿಲೋಮ ಇದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "tan⁻¹ and cot⁻¹"
   },
   "body": {
    "en": "$\\tan^{-1} : R \\to (-\\pi/2, \\pi/2)$ and $\\cot^{-1} : R \\to (0, \\pi)$. Both are defined for every real number. The end points are excluded because tan is undefined at $\\pm\\pi/2$ and cot at $0, \\pi$.",
    "kn": "tan⁻¹ : R → (−π/2, π/2), cot⁻¹ : R → (0, π). ಎರಡೂ ಎಲ್ಲ ವಾಸ್ತವ ಸಂಖ್ಯೆಗಳಿಗೆ ವ್ಯಾಖ್ಯಾನಿತ."
   },
   "points": [
    {
     "en": "tan⁻¹: domain R, range (−π/2, π/2)"
    },
    {
     "en": "cot⁻¹: domain R, range (0, π)"
    }
   ],
   "narration": {
    "en": "Tan inverse and cot inverse accept every real number. Tan inverse gives angles strictly between minus pi by 2 and pi by 2; cot inverse gives angles strictly between zero and pi.",
    "kn": "tan⁻¹ : R → (−π/2, π/2), cot⁻¹ : R → (0, π). ಎರಡೂ ಎಲ್ಲ ವಾಸ್ತವ ಸಂಖ್ಯೆಗಳಿಗೆ ವ್ಯಾಖ್ಯಾನಿತ."
   }
  },
