{
 "chapterId": "puc2-physics-08-electromagnetic-waves",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-08-electromagnetic-waves.t1",
   "name": {
    "en": "Displacement current"
   },
   "tex": "i_d = \\varepsilon_0\\,\\dfrac{d\\Phi_E}{dt}",
   "note": {
    "en": "Equals the conduction current in the leads of a charging capacitor."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-08-electromagnetic-waves.t1",
   "name": {
    "en": "Ampere–Maxwell law"
   },
   "tex": "\\oint \\vec B\\cdot d\\vec l = \\mu_0\\left(i_c + \\varepsilon_0\\dfrac{d\\Phi_E}{dt}\\right)"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-08-electromagnetic-waves.t1",
   "name": {
    "en": "B inside a charging circular capacitor"
   },
   "tex": "B = \\dfrac{\\mu_0 i_d\\,r}{2\\pi R^2}\\ (r < R),\\qquad B = \\dfrac{\\mu_0 i_d}{2\\pi r}\\ (r > R)"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-08-electromagnetic-waves.t4",
   "name": {
    "en": "Speed in vacuum"
   },
   "tex": "c = \\dfrac{1}{\\sqrt{\\mu_0\\varepsilon_0}} \\approx 3\\times10^8\\ \\text{m/s}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "Speed in a medium"
   },
   "tex": "v = \\dfrac{1}{\\sqrt{\\mu\\varepsilon}} = \\dfrac{c}{\\sqrt{\\mu_r\\varepsilon_r}},\\qquad n = \\sqrt{\\mu_r\\varepsilon_r}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "Field ratio"
   },
   "tex": "\\dfrac{E_0}{B_0} = \\dfrac{E}{B} = c",
   "note": {
    "en": "E and B are in phase and perpendicular to each other and to the direction of travel."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "Plane wave along +z"
   },
   "tex": "E_x = E_0\\sin(kz - \\omega t),\\quad B_y = B_0\\sin(kz - \\omega t),\\quad k = \\dfrac{2\\pi}{\\lambda},\\ \\omega = 2\\pi f"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "Direction of propagation"
   },
   "tex": "\\hat v = \\hat E\\times\\hat B",
   "note": {
    "en": "Phase (kx − ωt) → +x; (kx + ωt) → −x."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Wave relations"
   },
   "tex": "c = f\\lambda = \\dfrac{\\omega}{k}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-08-electromagnetic-waves.t3",
   "name": {
    "en": "Energy densities"
   },
   "tex": "u_E = \\tfrac12\\varepsilon_0E^2 = u_B = \\dfrac{B^2}{2\\mu_0}",
   "note": {
    "en": "Energy is shared equally between the fields."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-08-electromagnetic-waves.t3",
   "name": {
    "en": "Average total energy density"
   },
   "tex": "\\langle u\\rangle = \\tfrac12\\varepsilon_0E_0^2 = \\varepsilon_0E_{rms}^2 = \\dfrac{B_0^2}{2\\mu_0}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-08-electromagnetic-waves.t3",
   "name": {
    "en": "Intensity"
   },
   "tex": "I = \\langle u\\rangle c = \\tfrac12 c\\varepsilon_0E_0^2 = \\dfrac{cB_0^2}{2\\mu_0}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "Point source"
   },
   "tex": "I = \\dfrac{P}{4\\pi r^2}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-08-electromagnetic-waves.t3",
   "name": {
    "en": "Momentum delivered"
   },
   "tex": "p = \\dfrac{U}{c}\\ \\text{(absorbed)},\\qquad p = \\dfrac{2U}{c}\\ \\text{(reflected)}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-08-electromagnetic-waves.t3",
   "name": {
    "en": "Radiation pressure (normal incidence)"
   },
   "tex": "P = \\dfrac{I}{c}\\ \\text{(absorber)},\\quad P = \\dfrac{2I}{c}\\ \\text{(reflector)},\\quad P = \\dfrac{(1 + r)I}{c}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-08-electromagnetic-waves.t3",
   "name": {
    "en": "Radiation pressure (oblique, perfect reflector)"
   },
   "tex": "P = \\dfrac{2I\\cos^2\\theta}{c}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "LC source"
   },
   "tex": "f = \\dfrac{1}{2\\pi\\sqrt{LC}},\\qquad \\lambda = 2\\pi c\\sqrt{LC}"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Spectrum (increasing λ)"
   },
   "tex": "\\gamma < \\text{X-ray} < \\text{UV} < \\text{visible} < \\text{IR} < \\text{microwave} < \\text{radio}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-08-electromagnetic-waves.t4",
   "name": {
    "en": "Approximate wavelength ranges"
   },
   "tex": "\\gamma < 10^{-3}\\,\\text{nm};\\ \\text{X}: 1\\,\\text{nm}\\text{–}10^{-3}\\,\\text{nm};\\ \\text{UV}: 400\\,\\text{nm}\\text{–}1\\,\\text{nm};\\ \\text{visible}: 400\\text{–}700\\,\\text{nm};\\ \\text{IR}: 1\\,\\text{mm}\\text{–}700\\,\\text{nm};\\ \\text{micro}: 0.1\\,\\text{m}\\text{–}1\\,\\text{mm};\\ \\text{radio} > 0.1\\,\\text{m}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-08-electromagnetic-waves.t2",
   "name": {
    "en": "Sources and uses"
   },
   "tex": "\\text{Radio: oscillating charges (LC)};\\ \\text{Micro: klystron, magnetron — radar, ovens};\\ \\text{IR: hot bodies — greenhouse, remote controls};\\ \\text{UV: Sun, arcs — LASIK, absorbed by ozone};\\ \\text{X: target hit by fast electrons};\\ \\gamma\\text{: nuclear decay}"
  }
 ]
}
