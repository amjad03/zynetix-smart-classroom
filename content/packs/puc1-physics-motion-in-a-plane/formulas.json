{
 "chapterId": "puc1-physics-03-motion-in-a-plane",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-03-motion-in-a-plane.t2",
   "name": {
    "en": "Magnitude and unit vector"
   },
   "tex": "|\\vec A| = \\sqrt{A_x^2 + A_y^2 + A_z^2},\\qquad \\hat A = \\dfrac{\\vec A}{|\\vec A|}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-03-motion-in-a-plane.t1",
   "name": {
    "en": "Resultant of two vectors"
   },
   "tex": "R = \\sqrt{A^2 + B^2 + 2AB\\cos\\theta},\\qquad \\tan\\alpha = \\dfrac{B\\sin\\theta}{A + B\\cos\\theta}",
   "note": {
    "en": "|A − B| ≤ R ≤ A + B."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Difference of vectors"
   },
   "tex": "|\\vec A - \\vec B| = \\sqrt{A^2 + B^2 - 2AB\\cos\\theta}",
   "note": {
    "en": "|A + B| = |A − B| ⇔ A ⊥ B."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-03-motion-in-a-plane.t1",
   "name": {
    "en": "Two equal vectors"
   },
   "tex": "R = 2A\\cos\\dfrac{\\theta}{2}",
   "note": {
    "en": "R = A when θ = 120°."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-03-motion-in-a-plane.t2",
   "name": {
    "en": "Resolution"
   },
   "tex": "A_x = A\\cos\\theta,\\quad A_y = A\\sin\\theta,\\quad A_{\\hat n} = \\vec A\\cdot\\hat n"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-03-motion-in-a-plane.t1",
   "name": {
    "en": "Lami's theorem"
   },
   "tex": "\\dfrac{F_1}{\\sin\\alpha} = \\dfrac{F_2}{\\sin\\beta} = \\dfrac{F_3}{\\sin\\gamma}",
   "note": {
    "en": "Three concurrent forces in equilibrium; each angle is opposite its force."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-03-motion-in-a-plane.t3",
   "name": {
    "en": "Motion in a plane (constant a)"
   },
   "tex": "\\vec v = \\vec u + \\vec at,\\qquad \\vec r = \\vec r_0 + \\vec ut + \\tfrac12\\vec at^2",
   "note": {
    "en": "Each component obeys the 1D equations independently."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-03-motion-in-a-plane.t4",
   "name": {
    "en": "Projectile: components"
   },
   "tex": "v_x = u\\cos\\theta,\\quad v_y = u\\sin\\theta - gt"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-03-motion-in-a-plane.t4",
   "name": {
    "en": "Time of flight, height, range"
   },
   "tex": "T = \\dfrac{2u\\sin\\theta}{g},\\quad H = \\dfrac{u^2\\sin^2\\theta}{2g},\\quad R = \\dfrac{u^2\\sin2\\theta}{g}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-03-motion-in-a-plane.t4",
   "name": {
    "en": "Projectile relations"
   },
   "tex": "R_{\\max} = \\dfrac{u^2}{g}\\ (45^\\circ),\\quad \\dfrac{H}{R} = \\dfrac{\\tan\\theta}{4},\\quad H = \\dfrac{gT^2}{8}",
   "note": {
    "en": "θ and 90° − θ give equal ranges, with T₁T₂ = 2R/g."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-03-motion-in-a-plane.t3",
   "name": {
    "en": "Equation of trajectory"
   },
   "tex": "y = x\\tan\\theta - \\dfrac{gx^2}{2u^2\\cos^2\\theta} = x\\tan\\theta\\left(1 - \\dfrac{x}{R}\\right)"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-03-motion-in-a-plane.t4",
   "name": {
    "en": "Horizontal projection from height h"
   },
   "tex": "t = \\sqrt{\\dfrac{2h}{g}},\\quad x = u\\sqrt{\\dfrac{2h}{g}},\\quad v = \\sqrt{u^2 + 2gh}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Velocity perpendicular to initial velocity"
   },
   "tex": "t = \\dfrac{u}{g\\sin\\theta}\\ (\\text{possible only if }\\theta \\ge 45^\\circ)"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-03-motion-in-a-plane.t4",
   "name": {
    "en": "Projectile on an incline (angle α)"
   },
   "tex": "R_{\\text{up}} = \\dfrac{2u^2\\sin\\beta\\cos(\\alpha + \\beta)}{g\\cos^2\\alpha},\\quad R_{\\max,\\text{up}} = \\dfrac{u^2}{g(1 + \\sin\\alpha)},\\quad R_{\\max,\\text{down}} = \\dfrac{u^2}{g(1 - \\sin\\alpha)}",
   "note": {
    "en": "β is measured from the incline."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-03-motion-in-a-plane.t3",
   "name": {
    "en": "Relative velocity"
   },
   "tex": "\\vec v_{AB} = \\vec v_A - \\vec v_B",
   "note": {
    "en": "Rain–man: v_rm = v_r − v_m; hold the umbrella along −v_rm."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "River crossing: minimum time"
   },
   "tex": "t = \\dfrac{d}{v_b},\\qquad \\text{drift} = \\dfrac{v_rd}{v_b}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-03-motion-in-a-plane.t3",
   "name": {
    "en": "River crossing: zero drift"
   },
   "tex": "\\sin\\theta = \\dfrac{v_r}{v_b}\\ (\\text{upstream}),\\qquad t = \\dfrac{d}{\\sqrt{v_b^2 - v_r^2}}",
   "note": {
    "en": "Needs v_b > v_r; if v_b < v_r, minimum drift = d√(v_r² − v_b²)/v_b."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-03-motion-in-a-plane.t5",
   "name": {
    "en": "Uniform circular motion"
   },
   "tex": "v = \\omega r,\\quad \\omega = \\dfrac{2\\pi}{T} = 2\\pi\\nu,\\quad a_c = \\dfrac{v^2}{r} = \\omega^2r"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-03-motion-in-a-plane.t5",
   "name": {
    "en": "Non-uniform circular motion"
   },
   "tex": "a_t = \\dfrac{dv}{dt},\\quad a_c = \\dfrac{v^2}{r},\\quad a = \\sqrt{a_t^2 + a_c^2}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-03-motion-in-a-plane.t4",
   "name": {
    "en": "Change of velocity on a circle"
   },
   "tex": "|\\Delta\\vec v| = 2v\\sin\\dfrac{\\theta}{2}",
   "note": {
    "en": "Quarter turn: √2 v; half turn: 2v. Average velocity over half a turn = 2v/π."
   }
  }
 ]
}
