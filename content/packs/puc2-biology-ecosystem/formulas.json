{
 "chapterId": "puc2-biology-12-ecosystem",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Exponential growth"
   },
   "tex": "\\frac{dN}{dt} = rN,\\quad N_t = N_0e^{rt}",
   "note": {
    "en": "J-shaped curve."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Logistic growth"
   },
   "tex": "\\frac{dN}{dt} = rN\\left(\\frac{K - N}{K}\\right)",
   "note": {
    "en": "S-shaped; fastest at N = K/2."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Population change"
   },
   "tex": "N_{t+1} = N_t + [(B + I) - (D + E)]",
   "note": {
    "en": "Natality, immigration, mortality, emigration."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-12-ecosystem.t5",
   "name": {
    "en": "Lindeman's 10% law"
   },
   "tex": "E_{n+1} \\approx 0.1\\,E_n",
   "note": {
    "en": "Energy pyramid always upright."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-12-ecosystem.t2",
   "name": {
    "en": "Productivity"
   },
   "tex": "\\text{NPP} = \\text{GPP} - R",
   "note": {
    "en": "Biosphere NPP ≈ 170 billion t/yr."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-12-ecosystem.t2",
   "name": {
    "en": "Species–area relation"
   },
   "tex": "\\log S = \\log C + Z\\log A",
   "note": {
    "en": "Z: 0.1–0.2 regions, 0.6–1.2 continents."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Hotspots"
   },
   "tex": "36\\ \\text{global},\\ 4\\ \\text{in India}",
   "note": {
    "en": "W. Ghats–Sri Lanka, Himalaya, Indo-Burma, Sundaland."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-12-ecosystem.t2",
   "name": {
    "en": "Biosphere NPP"
   },
   "tex": "\\approx 170 \\text{ billion t (dry wt) yr}^{-1};\\ \\text{oceans} \\approx 55 \\text{ billion t}",
   "note": {
    "en": "Oceans cover ~70% of surface yet give only about a third."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-12-ecosystem.t4",
   "name": {
    "en": "Solar energy capture"
   },
   "tex": "\\text{PAR} < 50\\% \\text{ of incident light};\\ \\text{plants capture } 2\\text{–}10\\% \\text{ of PAR}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-12-ecosystem.t3",
   "name": {
    "en": "Decomposition steps"
   },
   "tex": "\\text{fragmentation} \\to \\text{leaching} \\to \\text{catabolism} \\to \\text{humification} \\to \\text{mineralisation}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-12-ecosystem.t3",
   "name": {
    "en": "Decomposition rate"
   },
   "tex": "\\text{slow: lignin, chitin, cold, anaerobic};\\ \\text{fast: N-rich, sugars, warm, moist}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-12-ecosystem.t3",
   "name": {
    "en": "Humus"
   },
   "tex": "\\text{dark, amorphous, colloidal, resistant; nutrient reservoir}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-12-ecosystem.t4",
   "name": {
    "en": "Food chains"
   },
   "tex": "\\text{GFC: major in aquatic};\\ \\text{DFC: larger energy share on land}",
   "note": {
    "en": "DFC starts with dead organic matter; decomposers are saprotrophic fungi and bacteria."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Energy flow"
   },
   "tex": "\\text{unidirectional; ecosystems obey the 2nd law of thermodynamics}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-biology-12-ecosystem.t5",
   "name": {
    "en": "Pyramids"
   },
   "tex": "\\text{energy: always upright};\\ \\text{biomass in sea: inverted};\\ \\text{numbers on a tree: inverted}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-12-ecosystem.t5",
   "name": {
    "en": "Pyramid limitations"
   },
   "tex": "\\text{ignore multi-level species, food webs, saprophytes; assume simple chain}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-12-ecosystem.t1",
   "name": {
    "en": "Stratification and standing crop"
   },
   "tex": "\\text{trees} > \\text{shrubs} > \\text{herbs, grasses};\\ \\text{standing crop = living mass at a time}"
  }
 ]
}
