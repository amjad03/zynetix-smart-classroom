 "title": {
  "en": "Issue of shares at par and calls in arrears",
  "kn": "ಸಮಮೌಲ್ಯದಲ್ಲಿ ಷೇರುಗಳ ವಿತರಣೆ ಮತ್ತು ಬಾಕಿ ಕರೆಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Collecting share money in instalments",
    "kn": "ಷೇರು ಹಣವನ್ನು ಕಂತುಗಳಲ್ಲಿ ಸಂಗ್ರಹ"
   },
   "hook": {
    "en": "A company rarely asks for the full price of a share at once. It collects money on application, on allotment and on calls. What if someone does not pay a call?",
    "kn": "ಕಂಪನಿ ಷೇರಿನ ಪೂರ್ಣ ಬೆಲೆಯನ್ನು ಒಮ್ಮೆಗೆ ಕೇಳುವುದು ಅಪರೂಪ. ಅರ್ಜಿ, ಹಂಚಿಕೆ ಮತ್ತು ಕರೆಗಳಲ್ಲಿ ಹಣ ಸಂಗ್ರಹಿಸುತ್ತದೆ. ಯಾರಾದರೂ ಕರೆ ಹಣ ಕೊಡದಿದ್ದರೆ?"
   },
   "objectives": [
    {
     "en": "Pass journal entries for issue of shares payable in instalments"
    },
    {
     "en": "Record calls in arrears and calls in advance"
    }
   ],
   "narration": {
    "en": "A company rarely asks for the full price of a share at once. It collects money on application, on allotment and on calls. What if someone does not pay a call? Today we journalise an issue at par, with calls in arrears and in advance.",
    "kn": "ಕಂಪನಿ ಷೇರಿನ ಪೂರ್ಣ ಬೆಲೆಯನ್ನು ಒಮ್ಮೆಗೆ ಕೇಳುವುದು ಅಪರೂಪ. ಅರ್ಜಿ, ಹಂಚಿಕೆ ಮತ್ತು ಕರೆಗಳಲ್ಲಿ ಹಣ ಸಂಗ್ರಹಿಸುತ್ತದೆ. ಯಾರಾದರೂ ಕರೆ ಹಣ ಕೊಡದಿದ್ದರೆ? ಇಂದು ಸಮಮೌಲ್ಯದ ವಿತರಣೆ, ಬಾಕಿ ಮತ್ತು ಮುಂಗಡ ಕರೆಗಳ ನಮೂದುಗಳನ್ನು ಕಲಿಯೋಣ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Entries for an issue at par"
   },
   "body": {
    "en": "Application money received: Bank A/c Dr, To Share Application A/c. Transfer to capital: Share Application A/c Dr, To Share Capital A/c. Allotment due: Share Allotment A/c Dr, To Share Capital A/c; on receipt: Bank A/c Dr, To Share Allotment A/c. Each call follows the same two steps.",
    "kn": "ಅರ್ಜಿ ಹಣ ಸ್ವೀಕಾರ: ಬ್ಯಾಂಕ್ ಖರ್ಚು, ಷೇರು ಅರ್ಜಿಗೆ ಜಮಾ. ಬಂಡವಾಳಕ್ಕೆ ವರ್ಗ: ಷೇರು ಅರ್ಜಿ ಖರ್ಚು, ಷೇರು ಬಂಡವಾಳಕ್ಕೆ ಜಮಾ. ಹಂಚಿಕೆ ಮತ್ತು ಕರೆಗಳಿಗೆ ಇದೇ ಎರಡು ಹಂತಗಳು."
   },
   "points": [],
   "narration": {
    "en": "Application money received: Bank A/c Dr, To Share Application A/c. Transfer to capital: Share Application A/c Dr, To Share Capital A/c. Allotment due: Share Allotment A/c Dr, To Share Capital A/c; on receipt: Bank A/c Dr, To Share Allotment A/c. Each call follows the same two steps.",
    "kn": "ಅರ್ಜಿ ಹಣ ಸ್ವೀಕಾರ: ಬ್ಯಾಂಕ್ ಖರ್ಚು, ಷೇರು ಅರ್ಜಿಗೆ ಜಮಾ. ಬಂಡವಾಳಕ್ಕೆ ವರ್ಗ: ಷೇರು ಅರ್ಜಿ ಖರ್ಚು, ಷೇರು ಬಂಡವಾಳಕ್ಕೆ ಜಮಾ. ಹಂಚಿಕೆ ಮತ್ತು ಕರೆಗಳಿಗೆ ಇದೇ ಎರಡು ಹಂತಗಳು."
   }
