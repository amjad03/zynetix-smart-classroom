   "caption": {
    "en": "Shares of ₹10 are payable ₹3 on application, ₹4 on allotment, ₹2 on first call and ₹1 on final call. Some holders do not pay the calls: the unpaid money is calls in arrears.",
    "kn": "₹10 ಷೇರು: ಅರ್ಜಿಗೆ ₹3, ಹಂಚಿಕೆಗೆ ₹4, ಮೊದಲ ಕರೆಗೆ ₹2, ಅಂತಿಮ ಕರೆಗೆ ₹1. ಕೆಲವರು ಕರೆ ಹಣ ಕೊಡುವುದಿಲ್ಲ: ಅದು ಬಾಕಿ ಕರೆಗಳು."
   },
   "seconds": 150,
   "optional": true,
   "sliders": [
    {
     "name": "n",
     "label": {
      "en": "Shares issued"
     },
     "min": 10,
     "max": 100,
     "step": 5,
     "value": 50,
     "unit": "thousand"
    },
    {
     "name": "dn",
     "label": {
      "en": "Shares whose holders skip the calls"
     },
     "min": 0,
     "max": 10,
     "step": 1,
     "value": 2,
     "unit": "thousand"
    }
   ],
   "counters": [
    {
     "name": "st",
     "value": 0,
     "min": 0,
     "max": 4
    }
   ],
   "buttons": [
    {
     "label": {
      "en": "Next stage",
      "kn": "ಮುಂದಿನ ಹಂತ"
     },
     "icon": "next",
     "set": {
      "st": "st + 1"
     }
    },
    {
     "label": {
      "en": "Start again",
      "kn": "ಮತ್ತೆ ಆರಂಭಿಸಿ"
     },
     "icon": "reset",
     "set": {
      "st": 0
     }
    }
   ],
   "vars": [
    {
     "name": "cps",
     "expr": "3*(st >= 1) + 4*(st >= 2) + 2*(st >= 3) + (st >= 4)"
    },
    {
     "name": "cap",
     "expr": "n*cps"
    },
    {
     "name": "arr",
     "expr": "dn*(2*(st >= 3) + (st >= 4))"
    },
    {
     "name": "bank",
     "expr": "cap - arr"
    },
    {
     "name": "b0",
     "expr": "cap"
    },
    {
     "name": "b1",
     "expr": "bank"
    },
    {
     "name": "b2",
     "expr": "arr"
    },
    {
     "name": "blo",
     "expr": "min(0, b0, b1, b2)"
    },
    {
     "name": "bhi",
     "expr": "max(100, b0, b1, b2)"
    },
    {
     "name": "bk",
     "expr": "4.6/(bhi - blo)"
    }
   ],
