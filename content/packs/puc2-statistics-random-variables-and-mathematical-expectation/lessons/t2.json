  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Probability density function"
   },
   "body": {
    "en": "A continuous random variable X has a probability density function (p.d.f.) $f(x)$ with $f(x) \\ge 0$ and $\\int_{-\\infty}^{\\infty} f(x)\\,dx = 1$. Probabilities are areas: $P(a < X < b) = \\int_a^b f(x)\\,dx$. For any single value, $P(X = a) = 0$, so $<$ and $\\le$ give the same probability. The distribution function is $F(x) = \\int_{-\\infty}^{x} f(t)\\,dt$, and $E(X) = \\int x f(x)\\,dx$."
   },
   "points": [
    {
     "en": "f(x) ≥ 0, total area 1"
    },
    {
     "en": "P(a < X < b) = area from a to b"
    },
    {
     "en": "P(X = a) = 0"
    }
   ],
   "narration": {
    "en": "A probability density function is never negative and has total area one. The probability of an interval is the area under the curve over that interval.",
    "kn": "ಸಂಭವನೀಯತಾ ಸಾಂದ್ರತಾ ಫಲನ ಎಂದಿಗೂ ಋಣವಲ್ಲ, ಒಟ್ಟು ವಿಸ್ತೀರ್ಣ 1. ಒಂದು ಅಂತರದ ಸಂಭವನೀಯತೆ ಆ ಅಂತರದ ಮೇಲಿನ ವಕ್ರದ ಕೆಳಗಿನ ವಿಸ್ತೀರ್ಣ."
   },
   "formula": "P(a < X < b) = \\int_a^b f(x)\\,dx"
  },
