  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Mathematical expectation"
   },
   "body": {
    "en": "The mathematical expectation (expected value, mean) of a discrete random variable is $E(X) = \\sum x\\,p(x)$; for a continuous one, $E(X) = \\int x f(x)\\,dx$. It is the long-run average value of X over many repetitions. In a game, if the expected gain of the player is zero the game is fair."
   },
   "points": [
    {
     "en": "E(X) = Σx p(x)"
    },
    {
     "en": "Long-run average"
    },
    {
     "en": "Fair game: E(gain) = 0"
    }
   ],
   "narration": {
    "en": "The expectation of X is the sum of x times p of x. It is the long-run average. A game is fair if the expected gain is zero.",
    "kn": "X ನ ನಿರೀಕ್ಷೆ = Σ x·p(x). ಇದು ದೀರ್ಘಾವಧಿಯ ಸರಾಸರಿ. ನಿರೀಕ್ಷಿತ ಲಾಭ ಶೂನ್ಯವಾದರೆ ಆಟ ನ್ಯಾಯಯುತ."
   },
   "formula": "E(X) = \\sum x\\, p(x)"
  },
