  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A die is thrown. X is the number shown. Find E(X) and E(2X + 3)."
   },
   "steps": [
    {
     "en": "E(X) = (1 + 2 + 3 + 4 + 5 + 6) × 1/6 = 21/6 = 3.5."
    },
    {
     "en": "E(2X + 3) = 2E(X) + 3 = 2(3.5) + 3 = 10."
    }
   ],
   "answer": {
    "en": "E(X) = 3.5, E(2X + 3) = 10"
   },
   "narration": {
    "en": "Let us work this out together. A die is thrown. X is the number shown. Find E(X) and E(2X + 3)."
   }
