 "title": {
  "en": "Representation of algorithms: flowcharts and pseudocode",
  "kn": "ಕ್ರಮಾವಳಿಯ ನಿರೂಪಣೆ: ಪ್ರವಾಹ ನಕ್ಷೆ ಮತ್ತು ಹುಸಿ ಸಂಕೇತ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Draw it or write it",
    "kn": "ಚಿತ್ರಿಸಿ ಅಥವಾ ಬರೆಯಿರಿ"
   },
   "hook": {
    "en": "A plumber reads a pipe diagram; a cook reads a recipe in words. Programmers too have two ways to show an algorithm: a picture and structured text.",
    "kn": "ಪ್ಲಂಬರ್ ಕೊಳವೆ ನಕ್ಷೆ ಓದುತ್ತಾನೆ; ಅಡುಗೆಯವರು ಪದಗಳ ವಿಧಾನ ಓದುತ್ತಾರೆ. ಪ್ರೋಗ್ರಾಮರ್‌ಗಳಿಗೂ ಕ್ರಮಾವಳಿ ತೋರಿಸಲು ಎರಡು ದಾರಿ: ಚಿತ್ರ ಮತ್ತು ರಚನಾತ್ಮಕ ಪಠ್ಯ."
   },
   "objectives": [
    {
     "en": "Identify the standard flowchart symbols"
    },
    {
     "en": "Draw a flowchart for a simple problem"
    },
    {
     "en": "Write pseudocode using standard keywords"
    }
   ],
   "narration": {
    "en": "A plumber reads a pipe diagram; a cook reads a recipe in words. Programmers too have two ways to show an algorithm: a picture and structured text.",
    "kn": "ಪ್ಲಂಬರ್ ಕೊಳವೆ ನಕ್ಷೆ ಓದುತ್ತಾನೆ; ಅಡುಗೆಯವರು ಪದಗಳ ವಿಧಾನ ಓದುತ್ತಾರೆ. ಪ್ರೋಗ್ರಾಮರ್‌ಗಳಿಗೂ ಕ್ರಮಾವಳಿ ತೋರಿಸಲು ಎರಡು ದಾರಿ: ಚಿತ್ರ ಮತ್ತು ರಚನಾತ್ಮಕ ಪಠ್ಯ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Flowchart symbols"
   },
   "body": {
    "en": "A flowchart is a visual representation of an algorithm using standard shapes joined by arrows. The terminal symbol, an oval, marks Start and Stop. A rectangle is a process step, such as a calculation. A parallelogram is input or output. A diamond is a decision, with one arrow for each answer (Yes/No). Arrows, called flow lines, show the order of steps."
   },
   "points": [
    {
     "en": "Oval: Start / Stop"
    },
    {
     "en": "Rectangle: process"
    },
    {
     "en": "Parallelogram: input / output"
    },
    {
     "en": "Diamond: decision"
    },
    {
     "en": "Arrow: flow of control"
    }
   ],
   "narration": {
    "en": "A flowchart is a visual representation of an algorithm using standard shapes joined by arrows. The terminal symbol, an oval, marks Start and Stop. A rectangle is a process step, such as a calculation. A parallelogram is input or output. A diamond is a decision, with one arrow for each answer (Yes/No). Arrows, called flow lines, show the order of steps.",
    "kn": "ಪ್ರವಾಹ ನಕ್ಷೆ ಕ್ರಮಾವಳಿಯ ಚಿತ್ರರೂಪ. ಅಂಡಾಕಾರ — ಪ್ರಾರಂಭ/ಅಂತ್ಯ; ಆಯತ — ಪ್ರಕ್ರಿಯೆ; ಸಮಾಂತರ ಚತುರ್ಭುಜ — ಒಳಹರಿವು/ಹೊರಹರಿವು; ವಜ್ರಾಕಾರ — ನಿರ್ಧಾರ; ಬಾಣಗಳು — ಹರಿವಿನ ದಿಕ್ಕು."
   }
  },
