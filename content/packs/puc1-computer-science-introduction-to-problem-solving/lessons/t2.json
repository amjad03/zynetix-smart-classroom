  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Pseudocode"
   },
   "body": {
    "en": "Pseudocode is a non-formal, language-independent way of writing an algorithm in structured English. It is meant for humans, not for computers. Common keywords are INPUT, COMPUTE, PRINT, INCREMENT, DECREMENT, IF/ELSE, WHILE, TRUE and FALSE. Pseudocode is easy to convert into a program in any language."
   },
   "points": [
    {
     "en": "Structured English, not a real language"
    },
    {
     "en": "Keywords: INPUT, COMPUTE, PRINT, IF/ELSE, WHILE"
    },
    {
     "en": "Easy to convert into any programming language"
    }
   ],
   "narration": {
    "en": "Pseudocode is a non-formal, language-independent way of writing an algorithm in structured English. It is meant for humans, not for computers. Common keywords are INPUT, COMPUTE, PRINT, INCREMENT, DECREMENT, IF/ELSE, WHILE, TRUE and FALSE. Pseudocode is easy to convert into a program in any language.",
    "kn": "ಹುಸಿ ಸಂಕೇತ (ಸ್ಯೂಡೋಕೋಡ್) ಕ್ರಮಾವಳಿಯನ್ನು ರಚನಾತ್ಮಕ ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಬರೆಯುವ ಅನೌಪಚಾರಿಕ, ಭಾಷಾ-ಸ್ವತಂತ್ರ ವಿಧಾನ. INPUT, COMPUTE, PRINT, IF/ELSE, WHILE ಮುಂತಾದ ಪದಗಳನ್ನು ಬಳಸುತ್ತದೆ."
   }
  },
  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Write pseudocode to find the area and perimeter of a rectangle."
   },
   "steps": [
    {
     "en": "INPUT length"
    },
    {
     "en": "INPUT breadth"
    },
    {
     "en": "COMPUTE area = length * breadth"
    },
    {
     "en": "COMPUTE perimeter = 2 * (length + breadth)"
    },
    {
     "en": "PRINT area, perimeter"
    }
   ],
   "answer": {
    "en": "For length 5 and breadth 3 the pseudocode prints area 15 and perimeter 16."
   },
   "narration": {
    "en": "Let us work through this together. Write pseudocode to find the area and perimeter of a rectangle."
   }
  },
