[
 {
  "id": "1t03-q01",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t1",
  "stem": {
   "en": "Classification of data according to years is called:"
  },
  "options": [
   {
    "en": "Qualitative classification"
   },
   {
    "en": "Chronological classification"
   },
   {
    "en": "Geographical classification"
   },
   {
    "en": "Quantitative classification"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Arrangement by time (years, months) is chronological or temporal classification."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q02",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t1",
  "stem": {
   "en": "Classifying the population into literates and illiterates is:"
  },
  "options": [
   {
    "en": "Manifold classification"
   },
   {
    "en": "Chronological classification"
   },
   {
    "en": "Simple (dichotomous) classification"
   },
   {
    "en": "Continuous classification"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "One attribute divided into two classes (possessing and not possessing it) is simple or dichotomous classification."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q03",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t1",
  "stem": {
   "en": "Classifying the population of Karnataka by districts is:"
  },
  "options": [
   {
    "en": "Manifold classification"
   },
   {
    "en": "Quantitative classification"
   },
   {
    "en": "Geographical classification"
   },
   {
    "en": "Chronological classification"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Classification by place (state, district, taluk) is geographical or spatial classification."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q04",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t1",
  "stem": {
   "en": "Classifying students by their marks into classes 0–10, 10–20, … is:"
  },
  "options": [
   {
    "en": "Qualitative classification"
   },
   {
    "en": "Quantitative classification"
   },
   {
    "en": "Chronological classification"
   },
   {
    "en": "Geographical classification"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Marks are a measurable variable, so this is classification by a variable: quantitative classification."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t03-q05",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t2",
  "stem": {
   "en": "The number of students in a class is a:"
  },
  "options": [
   {
    "en": "Attribute"
   },
   {
    "en": "Constant"
   },
   {
    "en": "Continuous variable"
   },
   {
    "en": "Discrete variable"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "It takes only whole-number values (40, 41, …), so it is discrete. Height or weight would be continuous."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q06",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t2",
  "stem": {
   "en": "In tally marks, a frequency of 7 is shown as:"
  },
  "options": [
   {
    "en": "Two bundles of four strokes"
   },
   {
    "en": "One bundle of seven strokes"
   },
   {
    "en": "One bundle of five (four strokes crossed by a fifth) and two strokes"
   },
   {
    "en": "Seven separate strokes"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Tally marks are grouped in fives: four vertical strokes crossed by the fifth. 7 = 5 + 2."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q07",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t2",
  "stem": {
   "en": "In a frequency distribution, the sum of all the frequencies is equal to:"
  },
  "options": [
   {
    "en": "The largest value"
   },
   {
    "en": "The total number of observations, N"
   },
   {
    "en": "The mid-value of the middle class"
   },
   {
    "en": "The number of classes"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Each observation is counted once, so Σf = N."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q08",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t2",
  "stem": {
   "en": "In the data 3, 2, 3, 4, 2, 3, 1, 3, 2, 4, the frequency of the value 3 is:"
  },
  "options": [
   {
    "en": "10"
   },
   {
    "en": "3"
   },
   {
    "en": "4"
   },
   {
    "en": "2"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "The value 3 appears 4 times."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t03-q09",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t3",
  "stem": {
   "en": "The mid-value of the class 40–50 is:"
  },
  "options": [
   {
    "en": "40"
   },
   {
    "en": "50"
   },
   {
    "en": "10"
   },
   {
    "en": "45"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Mid-value = (40 + 50)/2 = 45."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q10",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t3",
  "stem": {
   "en": "In the exclusive method, the class 10–20 includes:"
  },
  "options": [
   {
    "en": "Values from 10 to 20, both included"
   },
   {
    "en": "Values above 10 up to 20"
   },
   {
    "en": "Values from 10 up to but not including 20"
   },
   {
    "en": "Only the values 10 and 20"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "In the exclusive method the upper limit is excluded; 20 goes into the class 20–30."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q11",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t3",
  "stem": {
   "en": "The classes are 10–19, 20–29, 30–39 (inclusive). The class boundaries of 20–29 are:"
  },
  "options": [
   {
    "en": "19–29"
   },
   {
    "en": "20.5–29.5"
   },
   {
    "en": "20–30"
   },
   {
    "en": "19.5–29.5"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Gap d = 20 − 19 = 1; subtract d/2 = 0.5 from the lower limit and add it to the upper limit: 19.5–29.5."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q12",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t3",
  "stem": {
   "en": "By Sturges' rule, the number of classes for N = 200 observations is about:"
  },
  "options": [
   {
    "en": "20"
   },
   {
    "en": "9"
   },
   {
    "en": "7"
   },
   {
    "en": "8"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "k = 1 + 3.322 log₁₀ 200 = 1 + 3.322 × 2.3010 = 8.644 ≈ 9."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t03-q13",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t4",
  "stem": {
   "en": "In a less-than cumulative frequency distribution, the cumulative frequencies are written against the:"
  },
  "options": [
   {
    "en": "Upper class boundaries"
   },
   {
    "en": "Lower class boundaries"
   },
   {
    "en": "Class widths"
   },
   {
    "en": "Mid-values"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "\"Less than 20\" counts all values below the upper boundary 20 of the class 10–20."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q14",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t4",
  "stem": {
   "en": "The frequencies of five classes are 5, 8, 12, 15 and 10. The less-than cumulative frequency of the third class is:"
  },
  "options": [
   {
    "en": "37"
   },
   {
    "en": "13"
   },
   {
    "en": "12"
   },
   {
    "en": "25"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Less-than cf: 5, 5 + 8 = 13, 13 + 12 = 25, … The third is 25."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q15",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t4",
  "stem": {
   "en": "In a distribution with N = 40, a class has frequency 10. Its relative frequency is:"
  },
  "options": [
   {
    "en": "0.4"
   },
   {
    "en": "0.25"
   },
   {
    "en": "25"
   },
   {
    "en": "4"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Relative frequency = f/N = 10/40 = 0.25 (25%)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q16",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t4",
  "stem": {
   "en": "In a more-than cumulative frequency distribution, the cumulative frequency of the first class equals:"
  },
  "options": [
   {
    "en": "N, the total frequency"
   },
   {
    "en": "The frequency of the first class"
   },
   {
    "en": "The frequency of the last class"
   },
   {
    "en": "Zero"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "\"More than or equal to\" the lowest boundary includes every observation, so it equals N."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t03-q17",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t5",
  "stem": {
   "en": "The headings of the columns of a statistical table are called:"
  },
  "options": [
   {
    "en": "Head note"
   },
   {
    "en": "Stubs"
   },
   {
    "en": "Captions"
   },
   {
    "en": "Body"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Column headings are captions; row headings are stubs."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t03-q18",
  "chapterId": "puc1-statistics-03-classification-and-tabulation",
  "topicId": "puc1-statistics-03-classification-and-tabulation.t5",
  "stem": {
   "en": "The headings of the rows of a statistical table are called:"
  },
  "options": [
   {
    "en": "Stubs"
   },
   {
    "en": "Captions"
   },
   {
    "en": "Title"
   },
   {
    "en": "Footnotes"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Stubs are the row designations in the left-most column."
