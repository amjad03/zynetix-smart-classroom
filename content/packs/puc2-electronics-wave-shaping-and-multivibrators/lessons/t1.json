   "problem": {
    "en": "A 10 V step is applied to an RC circuit with RC = 1 ms. Find the capacitor voltage after 2 ms."
   },
   "steps": [
    {
     "en": "vC = V(1 − e^(−t/RC)) = 10(1 − e^(−2))."
