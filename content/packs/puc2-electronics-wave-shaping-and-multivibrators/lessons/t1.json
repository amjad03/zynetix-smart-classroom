   "aim": {
    "en": "To study the charging and discharging of a capacitor through a resistor and determine the time constant."
   },
   "optional": true,
   "seconds": 150,
   "narration": {
    "en": "On the RC bench, watch the capacitor charge and discharge. Read the time at which it reaches 63 percent: that is RC."
   }
