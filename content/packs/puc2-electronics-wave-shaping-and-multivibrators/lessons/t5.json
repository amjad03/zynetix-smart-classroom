   "problem": {
    "en": "A 555 astable has RA = 1 kΩ, RB = 10 kΩ and C = 0.1 µF. Find tH, tL, the frequency and the duty cycle."
   },
   "steps": [
    {
     "en": "tH = 0.693 × 11 kΩ × 0.1 µF = 0.762 ms."
    },
    {
     "en": "tL = 0.693 × 10 kΩ × 0.1 µF = 0.693 ms."
    },
    {
     "en": "f = 1.44/((1 + 20) kΩ × 0.1 µF) = 1.44/(2.1 × 10⁻³) = 686 Hz."
    },
    {
     "en": "D = 11/21 = 52.4%."
    }
   ],
