{
 "chapterId": "puc1-biology-14-breathing-and-exchange-of-gases",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t1",
   "name": {
    "en": "Respiratory organs"
   },
   "tex": "\\text{Flatworms: diffusion; earthworm: cuticle; insects: tracheae; fishes: gills; amphibians: lungs + skin}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t1",
   "name": {
    "en": "Thoracic chamber"
   },
   "tex": "\\text{Dorsal: vertebral column; ventral: sternum; lateral: ribs; floor: diaphragm}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t1",
   "name": {
    "en": "Trachea divides"
   },
   "tex": "\\text{At the level of the 5th thoracic vertebra}",
   "note": {
    "en": "Airways up to initial bronchioles have incomplete cartilaginous rings."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Conducting vs exchange part"
   },
   "tex": "\\text{Nostrils} \\to \\text{terminal bronchioles (conducting)};\\ \\text{alveoli + ducts (exchange)}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t2",
   "name": {
    "en": "Tidal volume"
   },
   "tex": "TV \\approx 500\\ \\text{mL};\\ \\text{minute ventilation} \\approx 6000\\text{–}8000\\ \\text{mL min}^{-1}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t2",
   "name": {
    "en": "Reserve and residual volumes"
   },
   "tex": "IRV = 2500\\text{–}3000,\\ ERV = 1000\\text{–}1100,\\ RV = 1100\\text{–}1200\\ \\text{mL}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t2",
   "name": {
    "en": "Inspiratory / expiratory capacity"
   },
   "tex": "IC = TV + IRV,\\quad EC = TV + ERV"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t2",
   "name": {
    "en": "Functional residual capacity"
   },
   "tex": "FRC = ERV + RV"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t2",
   "name": {
    "en": "Vital capacity"
   },
   "tex": "VC = ERV + TV + IRV"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t2",
   "name": {
    "en": "Total lung capacity"
   },
   "tex": "TLC = VC + RV = RV + ERV + TV + IRV"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t3",
   "name": {
    "en": "Partial pressures (mm Hg)"
   },
   "tex": "\\begin{array}{lcc} & pO_2 & pCO_2 \\\\ \\text{Atmosphere} & 159 & 0.3 \\\\ \\text{Alveoli} & 104 & 40 \\\\ \\text{Deoxy blood} & 40 & 45 \\\\ \\text{Oxy blood} & 95 & 40 \\\\ \\text{Tissues} & 40 & 45 \\end{array}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t3",
   "name": {
    "en": "Solubility"
   },
   "tex": "\\text{Solubility of } CO_2 \\approx 20\\text{–}25 \\times O_2"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "O₂ transport"
   },
   "tex": "97\\%\\ \\text{as oxyhaemoglobin (RBC)},\\ 3\\%\\ \\text{dissolved in plasma};\\ 1\\ \\text{Hb} \\to \\max 4\\,O_2"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "CO₂ transport"
   },
   "tex": "70\\%\\ HCO_3^-,\\ 20\\text{–}25\\%\\ \\text{carbamino-Hb},\\ 7\\%\\ \\text{dissolved}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t4",
   "name": {
    "en": "Carbonic anhydrase reaction"
   },
   "tex": "CO_2 + H_2O \\rightleftharpoons H_2CO_3 \\rightleftharpoons HCO_3^- + H^+",
   "note": {
    "en": "High in RBCs, minute in plasma."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Gas delivered per 100 mL blood"
   },
   "tex": "O_2 \\to \\text{tissues}: 5\\ \\text{mL};\\quad CO_2 \\to \\text{alveoli}: 4\\ \\text{mL}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t4",
   "name": {
    "en": "O₂ binding conditions"
   },
   "tex": "\\text{Alveoli: } \\uparrow pO_2, \\downarrow pCO_2, \\downarrow H^+, \\downarrow T;\\ \\text{tissues: the reverse}",
   "note": {
    "en": "Oxygen dissociation curve is sigmoid."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t5",
   "name": {
    "en": "Regulation"
   },
   "tex": "\\text{Rhythm centre: medulla; pneumotaxic centre: pons (shortens inspiration)}",
   "note": {
    "en": "Chemosensitive area responds to CO₂ and H⁺; O₂ role insignificant."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t5",
   "name": {
    "en": "Disorders"
   },
   "tex": "\\text{Asthma: bronchi inflamed; emphysema: alveolar walls damaged; occupational: fibrosis}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-biology-14-breathing-and-exchange-of-gases.t5",
   "name": {
    "en": "Breathing rate"
   },
   "tex": "12\\text{–}16\\ \\text{breaths min}^{-1}"
  }
 ]
}
