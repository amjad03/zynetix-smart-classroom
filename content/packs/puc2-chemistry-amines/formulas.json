{
 "chapterId": "puc2-chemistry-09-amines",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-09-amines.t2",
   "name": {
    "en": "Reduction of nitro compounds"
   },
   "tex": "\\text{ArNO}_2 \\xrightarrow{\\text{Sn/HCl or Fe/HCl;\\ NaOH}} \\text{ArNH}_2",
   "note": {
    "en": "Fe/HCl preferred: FeCl₂ hydrolysis regenerates HCl. Also H₂/Pd."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-09-amines.t2",
   "name": {
    "en": "Ammonolysis of alkyl halides"
   },
   "tex": "\\text{RX} \\xrightarrow{\\text{NH}_3} \\text{RNH}_2 \\to \\text{R}_2\\text{NH} \\to \\text{R}_3\\text{N} \\to \\text{R}_4\\text{N}^+\\text{X}^-",
   "note": {
    "en": "Mixture; excess NH₃ favours 1°. Halide reactivity RI > RBr > RCl."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-09-amines.t2",
   "name": {
    "en": "Nitrile / amide reduction"
   },
   "tex": "\\text{RCN} \\xrightarrow{\\text{LiAlH}_4\\ \\text{or}\\ \\text{H}_2/\\text{Ni}} \\text{RCH}_2\\text{NH}_2;\\quad \\text{RCONH}_2 \\xrightarrow{\\text{LiAlH}_4} \\text{RCH}_2\\text{NH}_2",
   "note": {
    "en": "RX → RCN → amine: one carbon more (ascent)."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-09-amines.t2",
   "name": {
    "en": "Gabriel phthalimide synthesis"
   },
   "tex": "\\text{phthalimide} \\xrightarrow{\\text{KOH}} \\text{N}^-\\text{K}^+ \\xrightarrow{\\text{RX}} \\text{N–R} \\xrightarrow{\\text{NaOH(aq)}} \\text{RNH}_2",
   "note": {
    "en": "Pure 1° aliphatic amines only — not aryl amines."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-09-amines.t2",
   "name": {
    "en": "Hofmann bromamide degradation"
   },
   "tex": "\\text{RCONH}_2 + \\text{Br}_2 + 4\\,\\text{NaOH} \\to \\text{RNH}_2 + \\text{Na}_2\\text{CO}_3 + 2\\,\\text{NaBr} + 2\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "Amine has one carbon fewer (descent)."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-09-amines.t3",
   "name": {
    "en": "Basicity: aqueous phase"
   },
   "tex": "(\\text{CH}_3)_2\\text{NH} > \\text{CH}_3\\text{NH}_2 > (\\text{CH}_3)_3\\text{N} > \\text{NH}_3;\\quad (\\text{C}_2\\text{H}_5)_2\\text{NH} > (\\text{C}_2\\text{H}_5)_3\\text{N} > \\text{C}_2\\text{H}_5\\text{NH}_2 > \\text{NH}_3",
   "note": {
    "en": "+I, solvation of the cation and steric effects combine."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-09-amines.t3",
   "name": {
    "en": "Basicity: gas phase"
   },
   "tex": "3^\\circ > 2^\\circ > 1^\\circ > \\text{NH}_3",
   "note": {
    "en": "Only the +I effect operates."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-09-amines.t3",
   "name": {
    "en": "Aromatic amines"
   },
   "tex": "\\text{alkylamines} > \\text{NH}_3 > \\text{C}_6\\text{H}_5\\text{NH}_2 > (\\text{C}_6\\text{H}_5)_2\\text{NH}",
   "note": {
    "en": "pKb aniline 9.38. EDG (–OCH₃, –CH₃) increase, EWG (–NO₂, –Cl) decrease basicity. Benzylamine (pKb ≈ 4.7) behaves like an alkylamine."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-09-amines.t4",
   "name": {
    "en": "Carbylamine test (1° amines)"
   },
   "tex": "\\text{RNH}_2 + \\text{CHCl}_3 + 3\\,\\text{KOH (alc)} \\xrightarrow{\\Delta} \\text{RNC} + 3\\,\\text{KCl} + 3\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "Foul-smelling isocyanide; 2° and 3° amines negative."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-09-amines.t4",
   "name": {
    "en": "Hinsberg test"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{SO}_2\\text{Cl}:\\ 1^\\circ \\to \\text{soluble in KOH};\\ 2^\\circ \\to \\text{insoluble};\\ 3^\\circ \\to \\text{no reaction}",
   "note": {
    "en": "The 1° sulphonamide has an acidic N–H."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-09-amines.t4",
   "name": {
    "en": "Nitrous acid"
   },
   "tex": "\\text{RNH}_2 \\xrightarrow{\\text{NaNO}_2/\\text{HCl}} \\text{ROH} + \\text{N}_2\\uparrow;\\quad \\text{ArNH}_2 \\xrightarrow[273\\text{–}278\\ \\text{K}]{\\text{NaNO}_2/\\text{HCl}} \\text{ArN}_2^+\\text{Cl}^-",
   "note": {
    "en": "2° amines → yellow N-nitrosamines."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-09-amines.t4",
   "name": {
    "en": "Acylation / protection"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{NH}_2 + (\\text{CH}_3\\text{CO})_2\\text{O} \\xrightarrow{\\text{pyridine}} \\text{C}_6\\text{H}_5\\text{NHCOCH}_3",
   "note": {
    "en": "Moderates –NH₂ activation for mono-bromination / p-nitration; remove by hydrolysis."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-09-amines.t4",
   "name": {
    "en": "Electrophilic substitution of aniline"
   },
   "tex": "\\text{Br}_2/\\text{H}_2\\text{O} \\to 2,4,6\\text{-tribromoaniline};\\quad \\text{HNO}_3/\\text{H}_2\\text{SO}_4 \\to p\\ 51\\%,\\ m\\ 47\\%,\\ o\\ 2\\%",
   "note": {
    "en": "m-Product from anilinium ion. Sulphonation → sulphanilic acid (zwitterion). No Friedel–Crafts (salt with AlCl₃)."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-09-amines.t5",
   "name": {
    "en": "Sandmeyer / Gattermann"
   },
   "tex": "\\text{ArN}_2^+ \\xrightarrow{\\text{CuCl/HCl, CuBr/HBr, CuCN/KCN}} \\text{ArCl, ArBr, ArCN};\\quad \\xrightarrow{\\text{Cu/HX}} \\text{ArX}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-09-amines.t5",
   "name": {
    "en": "Other diazonium replacements"
   },
   "tex": "\\text{ArN}_2^+ \\xrightarrow{\\text{KI}} \\text{ArI};\\ \\xrightarrow{\\text{HBF}_4;\\ \\Delta} \\text{ArF};\\ \\xrightarrow{\\text{H}_2\\text{O},\\ \\Delta} \\text{ArOH};\\ \\xrightarrow{\\text{H}_3\\text{PO}_2\\ \\text{or}\\ \\text{C}_2\\text{H}_5\\text{OH}} \\text{ArH}",
   "note": {
    "en": "ArF route = Balz–Schiemann."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-09-amines.t5",
   "name": {
    "en": "Azo coupling"
   },
   "tex": "\\text{ArN}_2^+ + \\text{C}_6\\text{H}_5\\text{OH} \\xrightarrow{\\text{OH}^-} p\\text{-HOC}_6\\text{H}_4\\text{N{=}NAr (orange)};\\quad + \\text{C}_6\\text{H}_5\\text{NH}_2 \\xrightarrow{\\text{H}^+} p\\text{-aminoazobenzene (yellow)}",
   "note": {
    "en": "Para coupling; β-naphthol gives a red / orange dye."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-09-amines.t3",
   "name": {
    "en": "Boiling point / solubility"
   },
   "tex": "1^\\circ > 2^\\circ > 3^\\circ\\ \\text{(isomeric amines)};\\quad \\text{alcohol} > \\text{amine} > \\text{alkane}",
   "note": {
    "en": "N–H···N weaker than O–H···O."
   }
  }
 ]
}
