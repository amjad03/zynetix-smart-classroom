{
 "chapterId": "puc1-biology-18-neural-control-and-coordination",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t1",
   "name": {
    "en": "Divisions"
   },
   "tex": "\\text{CNS (brain + spinal cord)};\\ \\text{PNS: somatic + autonomic (sympathetic + parasympathetic)}"
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Fibre direction"
   },
   "tex": "\\text{Afferent: organ} \\to \\text{CNS};\\ \\text{efferent: CNS} \\to \\text{organ}"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Neuron parts"
   },
   "tex": "\\text{Cell body + dendrites (Nissl's granules)} + \\text{axon} \\to \\text{synaptic knobs}"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Neuron types"
   },
   "tex": "\\text{Multipolar: cerebral cortex; bipolar: retina; unipolar: embryo}"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Myelination"
   },
   "tex": "\\text{Myelinated: spinal \\& cranial nerves; gaps = nodes of Ranvier}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t3",
   "name": {
    "en": "Resting ion distribution"
   },
   "tex": "[K^+]_{in} \\gg [K^+]_{out},\\quad [Na^+]_{out} \\gg [Na^+]_{in}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t3",
   "name": {
    "en": "Na⁺–K⁺ pump"
   },
   "tex": "3\\,Na^+ \\text{ out} : 2\\,K^+ \\text{ in}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t3",
   "name": {
    "en": "Resting potential"
   },
   "tex": "\\text{Outside } (+),\\ \\text{inside } (-) \\Rightarrow \\text{polarised}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t3",
   "name": {
    "en": "Action potential"
   },
   "tex": "Na^+ \\text{ influx} \\to \\text{depolarisation};\\ K^+ \\text{ efflux} \\to \\text{repolarisation}"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Synapses"
   },
   "tex": "\\text{Electrical: faster, rare};\\ \\text{chemical: cleft + neurotransmitter}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Meninges"
   },
   "tex": "\\text{Dura mater (outer)} \\to \\text{arachnoid} \\to \\text{pia mater (inner)}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Forebrain"
   },
   "tex": "\\text{Cerebrum (corpus callosum), thalamus, hypothalamus}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Cortex"
   },
   "tex": "\\text{Grey matter: cell bodies; white matter: myelinated tracts}",
   "note": {
    "en": "Association areas: intersensory associations, memory, communication."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Hypothalamus"
   },
   "tex": "\\text{Temperature, hunger, thirst; neurosecretory cells}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Limbic system"
   },
   "tex": "\\text{Amygdala, hippocampus} + \\text{hypothalamus: sexual behaviour, emotion, motivation}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Midbrain"
   },
   "tex": "\\text{Corpora quadrigemina (dorsal); cerebral aqueduct}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Hindbrain"
   },
   "tex": "\\text{Pons (tracts), cerebellum (convoluted), medulla (respiration, CVS, gastric)}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-18-neural-control-and-coordination.t5",
   "name": {
    "en": "Brain stem"
   },
   "tex": "\\text{Midbrain} + \\text{hindbrain}"
  }
 ]
}
