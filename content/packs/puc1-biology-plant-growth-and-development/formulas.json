{
 "chapterId": "puc1-biology-13-plant-growth-and-development",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-13-plant-growth-and-development.t1",
   "name": {
    "en": "Plant growth"
   },
   "tex": "\\text{indeterminate (open) — meristems}",
   "note": {
    "en": "Maize root apex: > 17,500 cells/h. Watermelon cells: up to 3,50,000 × in size."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Measurement"
   },
   "tex": "\\text{pollen tube: length};\\ \\text{dorsiventral leaf: surface area}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-13-plant-growth-and-development.t1",
   "name": {
    "en": "Phases of growth"
   },
   "tex": "\\text{meristematic} \\to \\text{elongation} \\to \\text{maturation}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-13-plant-growth-and-development.t1",
   "name": {
    "en": "Arithmetic growth"
   },
   "tex": "L_t = L_0 + rt",
   "note": {
    "en": "Linear curve; one daughter cell keeps dividing."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-13-plant-growth-and-development.t1",
   "name": {
    "en": "Geometric growth"
   },
   "tex": "W_1 = W_0\\, e^{rt}",
   "note": {
    "en": "r = relative growth rate = efficiency index. Cells after n divisions: 2ⁿ."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-13-plant-growth-and-development.t1",
   "name": {
    "en": "Sigmoid curve"
   },
   "tex": "\\text{lag} \\to \\text{log (exponential)} \\to \\text{stationary}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-13-plant-growth-and-development.t5",
   "name": {
    "en": "Growth rates"
   },
   "tex": "\\text{AGR} = \\Delta W/\\Delta t;\\quad \\text{RGR} = \\dfrac{\\Delta W}{W_0\\,\\Delta t}",
   "note": {
    "en": "Leaf 5→10 cm² (RGR 100%) vs 50→55 cm² (10%): same AGR."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-13-plant-growth-and-development.t2",
   "name": {
    "en": "Conditions"
   },
   "tex": "\\text{water, O}_2,\\ \\text{nutrients, optimum temperature; light and gravity}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-13-plant-growth-and-development.t2",
   "name": {
    "en": "Differentiation cycle"
   },
   "tex": "\\text{differentiation} \\to \\text{dedifferentiation} \\to \\text{redifferentiation}",
   "note": {
    "en": "Dedifferentiation: interfascicular cambium, cork cambium from parenchyma."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-13-plant-growth-and-development.t2",
   "name": {
    "en": "Plasticity (heterophylly)"
   },
   "tex": "\\text{phase: cotton, coriander, larkspur};\\ \\text{environment: buttercup}"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "PGR chemistry"
   },
   "tex": "\\text{IAA: indole};\\ \\text{kinetin: adenine};\\ \\text{ABA: carotenoid};\\ \\text{GA}_3\\text{: terpene};\\ \\text{C}_2\\text{H}_4\\text{: gas}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-13-plant-growth-and-development.t3",
   "name": {
    "en": "Discoveries"
   },
   "tex": "\\text{Darwins: canary grass};\\ \\text{Went: oat};\\ \\text{Kurosawa: } Gibberella\\ fujikuroi;\\ \\text{Skoog \\& Miller: kinetin}",
   "note": {
    "en": "Cousins: ethylene from ripe oranges. ABA = inhibitor-B = abscission II = dormin (1960s). Zeatin: corn kernels, coconut milk."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-13-plant-growth-and-development.t4",
   "name": {
    "en": "Auxins"
   },
   "tex": "\\text{natural: IAA, IBA};\\ \\text{synthetic: NAA, 2,4-D}",
   "note": {
    "en": "Rooting, pineapple flowering, apical dominance (tea, hedges), parthenocarpy (tomato), dicot weedicide, xylem differentiation."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-13-plant-growth-and-development.t4",
   "name": {
    "en": "Gibberellins"
   },
   "tex": "> 100\\ \\text{GAs};\\ \\text{GA}_3\\ \\text{first and most studied}",
   "note": {
    "en": "Grape stalk length, apple shape, delay senescence, malting, sugarcane +20 t/acre, conifer maturity, bolting."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-13-plant-growth-and-development.t5",
   "name": {
    "en": "Cytokinins"
   },
   "tex": "\\text{cytokinesis; overcome apical dominance; delay senescence}",
   "note": {
    "en": "Synthesised in root apices, shoot buds, young fruits."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-13-plant-growth-and-development.t5",
   "name": {
    "en": "Ethylene"
   },
   "tex": "\\text{ripening, respiratory climacteric, abscission, female flowers in cucumber}",
   "note": {
    "en": "Ethephon releases ethylene slowly. Also apical hook, deep-water rice elongation, mango flowering, peanut germination."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-13-plant-growth-and-development.t5",
   "name": {
    "en": "Abscisic acid"
   },
   "tex": "\\text{stress hormone: stomatal closure, seed dormancy}",
   "note": {
    "en": "General growth inhibitor; antagonist to GAs."
   }
  }
 ]
}
