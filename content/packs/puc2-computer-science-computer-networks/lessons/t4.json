  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Mesh, ring and bus"
   },
   "body": {
    "en": "Topology is the arrangement of computers and devices in a *network*. Mesh: each device is connected to every other device; it is very reliable and secure but needs many cables, $n(n-1)/2$ links for n nodes. Ring: each node is connected to two neighbours, forming a closed loop; data travels in one direction, so one broken link can stop the ring. Bus: all nodes are connected to one backbone cable with terminators at the ends; it is cheap, but a fault in the backbone stops the network."
   },
   "points": [
    {
     "en": "Mesh: n(n−1)/2 links, very reliable, costly"
    },
    {
     "en": "Ring: closed loop, one-way data"
    },
    {
     "en": "Bus: one backbone cable, cheap, backbone failure is fatal"
    }
   ],
   "narration": {
    "en": "In a mesh every device connects to every other, so it is reliable but costly. A ring is a closed loop, and a bus uses one backbone cable.",
    "kn": "ಮೆಶ್‌ನಲ್ಲಿ ಪ್ರತಿ ಸಾಧನ ಉಳಿದೆಲ್ಲಕ್ಕೆ ಜೋಡಿತ; ವಿಶ್ವಾಸಾರ್ಹ ಆದರೆ ದುಬಾರಿ. ರಿಂಗ್ ಮುಚ್ಚಿದ ವೃತ್ತ; ಬಸ್ ಒಂದೇ ಬೆನ್ನೆಲುಬು ಕೇಬಲ್ ಬಳಸುತ್ತದೆ."
   },
   "formula": "\\text{Links in a full mesh} = \\frac{n(n-1)}{2}",
   "reveal": true,
   "voice": [
    {
     "say": {
      "en": "In a mesh every device connects to every other, so it is reliable but costly. A ring is a closed loop, and a bus uses one backbone cable. Mesh: n(n-1)/2 links, very reliable, costly.",
      "kn": "ಮೆಶ್‌ನಲ್ಲಿ ಪ್ರತಿ ಸಾಧನ ಉಳಿದೆಲ್ಲಕ್ಕೆ ಜೋಡಿತ; ವಿಶ್ವಾಸಾರ್ಹ ಆದರೆ ದುಬಾರಿ. ರಿಂಗ್ ಮುಚ್ಚಿದ ವೃತ್ತ; ಬಸ್ ಒಂದೇ ಬೆನ್ನೆಲುಬು ಕೇಬಲ್ ಬಳಸುತ್ತದೆ."
     }
    },
    {
     "say": {
      "en": "Ring: closed loop, one-way data."
     }
    },
    {
     "say": {
      "en": "Bus: one backbone cable, cheap, backbone failure is fatal."
     }
    }
   ]
  },
