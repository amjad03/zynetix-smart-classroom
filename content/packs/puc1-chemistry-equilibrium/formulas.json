{
 "chapterId": "puc1-chemistry-06-equilibrium",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Kp–Kc relation"
   },
   "tex": "K_p = K_c(RT)^{\\Delta n_g}",
   "note": {
    "en": "Δn_g = 0 → Kp = Kc."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-06-equilibrium.t4",
   "name": {
    "en": "Ionic product of water"
   },
   "tex": "K_w = [\\text{H}^+][\\text{OH}^-] = 10^{-14}",
   "note": {
    "en": "At 298 K."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "pH"
   },
   "tex": "\\text{pH} = -\\log[\\text{H}^+],\\quad \\text{pH} + \\text{pOH} = 14",
   "note": {
    "en": "At 25 °C."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Weak acid"
   },
   "tex": "[\\text{H}^+] = \\sqrt{K_aC},\\quad \\alpha = \\sqrt{K_a/C}",
   "note": {
    "en": "Ostwald dilution law."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Henderson equation"
   },
   "tex": "\\text{pH} = \\text{p}K_a + \\log\\frac{[\\text{salt}]}{[\\text{acid}]}",
   "note": {
    "en": "Buffer: best at pH = pKa."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Salt of WA + SB"
   },
   "tex": "\\text{pH} = 7 + \\tfrac12(\\text{p}K_a + \\log C)",
   "note": {
    "en": "Basic solution."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-06-equilibrium.t6",
   "name": {
    "en": "Ksp for AxBy"
   },
   "tex": "K_{sp} = x^x y^y s^{x+y}",
   "note": {
    "en": "AB: s², AB₂: 4s³."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-06-equilibrium.t4",
   "name": {
    "en": "Kw–Ka–Kb"
   },
   "tex": "K_a K_b = K_w",
   "note": {
    "en": "For a conjugate pair."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-06-equilibrium.t2",
   "name": {
    "en": "Law of mass action"
   },
   "tex": "a\\text{A} + b\\text{B} \\rightleftharpoons c\\text{C} + d\\text{D}:\\ \\ K_c = \\dfrac{[\\text{C}]^c[\\text{D}]^d}{[\\text{A}]^a[\\text{B}]^b}",
   "note": {
    "en": "Pure solids and liquids are omitted. K depends only on temperature."
   }
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Manipulating K"
   },
   "tex": "\\text{reverse: } 1/K;\\ \\ \\times n: K^n;\\ \\ \\text{add equations: } K_1K_2"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-06-equilibrium.t3",
   "name": {
    "en": "Reaction quotient"
   },
   "tex": "Q < K: \\text{forward};\\ \\ Q = K: \\text{equilibrium};\\ \\ Q > K: \\text{backward}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Degree of dissociation (PCl₅ type)"
   },
   "tex": "K_p = \\dfrac{\\alpha^2 P}{1 - \\alpha^2}",
   "note": {
    "en": "A ⇌ B + C; for N₂O₄ ⇌ 2NO₂: K_p = 4α²P/(1 − α²)."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-06-equilibrium.t3",
   "name": {
    "en": "Le Chatelier"
   },
   "tex": "\\text{stress} \\Rightarrow \\text{shift that opposes it}",
   "note": {
    "en": "↑p → fewer gas moles; ↑T favours endothermic side; inert gas at const V: no shift; at const p: towards more moles; catalyst: no shift."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-06-equilibrium.t2",
   "name": {
    "en": "van 't Hoff equation"
   },
   "tex": "\\log\\dfrac{K_2}{K_1} = \\dfrac{\\Delta H^\\circ}{2.303R}\\left(\\dfrac{1}{T_1} - \\dfrac{1}{T_2}\\right)"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-06-equilibrium.t1",
   "name": {
    "en": "Ionic product of water"
   },
   "tex": "K_w = [\\text{H}^+][\\text{OH}^-] = 1.0\\times10^{-14}\\ (298\\ \\text{K}),\\ \\ \\text{pH} + \\text{pOH} = 14",
   "note": {
    "en": "K_w rises with T; neutral water has pH < 7 above 25 °C."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-06-equilibrium.t4",
   "name": {
    "en": "pH"
   },
   "tex": "\\text{pH} = -\\log[\\text{H}^+]",
   "note": {
    "en": "Very dilute strong acid (10⁻⁸ M): include water's H⁺ → pH ≈ 6.98."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Weak acid (Ostwald)"
   },
   "tex": "K_a = \\dfrac{c\\alpha^2}{1 - \\alpha} \\approx c\\alpha^2,\\ \\ \\alpha = \\sqrt{K_a/c},\\ \\ [\\text{H}^+] = \\sqrt{K_a c}",
   "note": {
    "en": "Same form for weak bases with K_b and [OH⁻]."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-06-equilibrium.t4",
   "name": {
    "en": "Conjugate pair"
   },
   "tex": "K_a K_b = K_w, \\qquad \\text{p}K_a + \\text{p}K_b = 14"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Polyprotic acid"
   },
   "tex": "K_{a1} \\gg K_{a2};\\ \\ [\\text{S}^{2-}] = \\dfrac{K_{a1}K_{a2}[\\text{H}_2\\text{S}]}{[\\text{H}^+]^2}",
   "note": {
    "en": "In pure H₂S solution, [S²⁻] ≈ K_a2."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Common-ion effect (weak acid + strong acid)"
   },
   "tex": "\\alpha = \\dfrac{K_a}{[\\text{H}^+]_{\\text{strong}}}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Hydrolysis: weak acid + strong base salt"
   },
   "tex": "\\text{pH} = 7 + \\tfrac12\\text{p}K_a + \\tfrac12\\log c",
   "note": {
    "en": "K_h = K_w/K_a. e.g. CH₃COONa: basic."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Hydrolysis: strong acid + weak base salt"
   },
   "tex": "\\text{pH} = 7 - \\tfrac12\\text{p}K_b - \\tfrac12\\log c",
   "note": {
    "en": "e.g. NH₄Cl: acidic."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Hydrolysis: weak acid + weak base salt"
   },
   "tex": "\\text{pH} = 7 + \\tfrac12(\\text{p}K_a - \\text{p}K_b)",
   "note": {
    "en": "Independent of concentration; CH₃COONH₄ ≈ 7."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Henderson–Hasselbalch"
   },
   "tex": "\\text{pH} = \\text{p}K_a + \\log\\dfrac{[\\text{salt}]}{[\\text{acid}]}, \\qquad \\text{pOH} = \\text{p}K_b + \\log\\dfrac{[\\text{salt}]}{[\\text{base}]}",
   "note": {
    "en": "Best buffer when [salt] = [acid] (pH = pKa); dilution does not change buffer pH."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-06-equilibrium.t6",
   "name": {
    "en": "Solubility product"
   },
   "tex": "\\text{A}_x\\text{B}_y:\\ K_{sp} = x^x y^y s^{x+y}",
   "note": {
    "en": "AB: s²; AB₂: 4s³; A₂B₃ / A₃B₂: 108s⁵; AB₃: 27s⁴."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-06-equilibrium.t6",
   "name": {
    "en": "Precipitation condition"
   },
   "tex": "Q_{sp} > K_{sp} \\Rightarrow \\text{precipitate}",
   "note": {
    "en": "Remember dilution on mixing. Salt needing the lowest [ion] precipitates first."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-chemistry-06-equilibrium.t6",
   "name": {
    "en": "Solubility with a common ion"
   },
   "tex": "s = \\dfrac{K_{sp}}{[\\text{common ion}]^{n}}",
   "note": {
    "en": "e.g. AgCl in 0.01 M NaCl: s = K_sp/0.01."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-chemistry-06-equilibrium.t5",
   "name": {
    "en": "Acid–base indicators"
   },
   "tex": "\\text{pH range} \\approx \\text{p}K_{\\text{In}} \\pm 1",
   "note": {
    "en": "Phenolphthalein 8.3–10 (weak acid vs strong base); methyl orange 3.1–4.4 (strong acid vs weak base)."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-chemistry-06-equilibrium.t4",
   "name": {
    "en": "Acid–base concepts"
   },
   "tex": "\\text{Arrhenius (H}^+/\\text{OH}^-\\text{ in water)} \\subset \\text{Brønsted (H}^+\\text{ donor/acceptor)} \\subset \\text{Lewis (e}^-\\text{-pair acceptor/donor)}",
   "note": {
    "en": "Oxoacid strength rises with number of O: HClO₄ > HClO₃ > HClO₂ > HClO."
   }
  }
 ]
}
