[
 {
  "id": "1c06-q01",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t1",
  "stem": {
   "en": "At chemical equilibrium:"
  },
  "options": [
   {
    "en": "the rates of the forward and backward reactions are equal"
   },
   {
    "en": "the forward and backward reactions stop"
   },
   {
    "en": "the concentrations of reactants and products are always equal"
   },
   {
    "en": "only the forward reaction continues"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Equilibrium is dynamic: both reactions continue at equal rates, so concentrations stay constant (not necessarily equal)."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1c06-q02",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t1",
  "stem": {
   "en": "When a bottle of soda water is opened, it fizzes. This is best explained by:"
  },
  "options": [
   {
    "en": "Raoult's law"
   },
   {
    "en": "the law of mass action"
   },
   {
    "en": "Le Chatelier's principle for temperature"
   },
   {
    "en": "Henry's law"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The CO₂ dissolved under high pressure; on opening, its pressure falls and, by Henry's law, its solubility falls, so gas escapes."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1c06-q03",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t1",
  "stem": {
   "en": "Ice and water are in equilibrium at 1 atm. The temperature of this system is:"
  },
  "options": [
   {
    "en": "0 K"
   },
   {
    "en": "100 K"
   },
   {
    "en": "273 K"
   },
   {
    "en": "373 K"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "The normal melting point of ice is 273 K (0 °C); at this temperature ice and water coexist at 1 atm."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1c06-q04",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t1",
  "stem": {
   "en": "Using a mixture of H₂ and D₂ in the Haber process shows that ammonia containing deuterium forms even after equilibrium. This proves that equilibrium is:"
  },
  "options": [
   {
    "en": "static"
   },
   {
    "en": "dynamic"
   },
   {
    "en": "reached only from the reactant side"
   },
   {
    "en": "independent of temperature"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Deuterium keeps getting into ammonia, so the forward and backward reactions are still going on at equilibrium: it is dynamic."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1c06-q05",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t1",
  "stem": {
   "en": "Which of the following is NOT a characteristic of chemical equilibrium?"
  },
  "options": [
   {
    "en": "A catalyst changes the equilibrium composition"
   },
   {
    "en": "It is possible only in a closed system"
   },
   {
    "en": "It can be reached from either direction"
   },
   {
    "en": "Measurable properties become constant"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "A catalyst speeds up the forward and backward reactions equally; it shortens the time to reach equilibrium but does not change the composition."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1c06-q06",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t2",
  "stem": {
   "en": "For which reaction is Kp = Kc?"
  },
  "options": [
   {
    "en": "N₂ + 3H₂ ⇌ 2NH₃"
   },
   {
    "en": "PCl₅ ⇌ PCl₃ + Cl₂"
   },
   {
    "en": "2SO₂ + O₂ ⇌ 2SO₃"
   },
   {
    "en": "H₂ + I₂ ⇌ 2HI"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "For H₂ + I₂ ⇌ 2HI, Δn = 2 − 2 = 0, so Kp = Kc(RT)⁰ = Kc."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1c06-q07",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t2",
  "stem": {
   "en": "For CaCO₃(s) ⇌ CaO(s) + CO₂(g), Kp equals:"
  },
  "options": [
   {
    "en": "p(CaO) × p(CO₂) / p(CaCO₃)"
   },
   {
    "en": "1 / p(CO₂)"
   },
   {
    "en": "p(CO₂)"
   },
   {
    "en": "[CaO][CO₂]/[CaCO₃]"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Pure solids are left out of the expression, so Kp = p(CO₂)."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1c06-q08",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t2",
  "stem": {
   "en": "The unit of Kc for N₂(g) + 3H₂(g) ⇌ 2NH₃(g) is:"
  },
  "options": [
   {
    "en": "mol L⁻¹"
   },
   {
    "en": "L² mol⁻²"
   },
   {
    "en": "mol² L⁻²"
   },
   {
    "en": "no unit"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Kc = [NH₃]²/([N₂][H₂]³) has unit (mol L⁻¹)^(2−4) = (mol L⁻¹)⁻² = L² mol⁻²."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1c06-q09",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t2",
  "stem": {
   "en": "For 2SO₂(g) + O₂(g) ⇌ 2SO₃(g) the equilibrium constant is K. The equilibrium constant for SO₃(g) ⇌ SO₂(g) + ½O₂(g) is:"
  },
  "options": [
   {
    "en": "1/√K"
   },
   {
    "en": "1/K²"
   },
   {
    "en": "√K"
   },
   {
    "en": "1/K"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Reversing gives 1/K; halving the equation takes the square root: (1/K)^½ = 1/√K."
  },
  "exams": [
   "NEET",
   "JEE",
   "KCET"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1c06-q10",
  "chapterId": "puc1-chemistry-06-equilibrium",
  "topicId": "puc1-chemistry-06-equilibrium.t2",
  "stem": {
   "en": "1.0 mol each of A and B are placed in a 1 L flask. For A + B ⇌ C + D, Kc = 4. The equilibrium concentration of C is:"
  },
  "options": [
   {
    "en": "0.50 M"
   },
   {
    "en": "0.33 M"
   },
   {
    "en": "0.75 M"
   },
   {
    "en": "0.67 M"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "x²/(1 − x)² = 4 ⇒ x/(1 − x) = 2 ⇒ x = 2/3 ≈ 0.67 M."
  },
  "exams": [
   "NEET",
   "JEE",
   "KCET"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
