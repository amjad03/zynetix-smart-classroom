 "title": {
  "en": "Decimal to other number systems",
  "kn": "ದಶಮಾನದಿಂದ ಇತರ ಸಂಖ್ಯಾ ಪದ್ಧತಿಗಳಿಗೆ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Divide and collect the remainders",
    "kn": "ಭಾಗಿಸಿ, ಶೇಷಗಳನ್ನು ಸಂಗ್ರಹಿಸಿ"
   },
   "hook": {
    "en": "Your roll number is 45. How would a computer write it in binary? One simple method, repeated division, gives the answer.",
    "kn": "ನಿಮ್ಮ ಹಾಜರಿ ಸಂಖ್ಯೆ 45. ಗಣಕಯಂತ್ರ ಅದನ್ನು ದ್ವಿಮಾನದಲ್ಲಿ ಹೇಗೆ ಬರೆಯುತ್ತದೆ? ಪುನರಾವರ್ತಿತ ಭಾಗಾಕಾರ ಎಂಬ ಸರಳ ವಿಧಾನ ಉತ್ತರ ನೀಡುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Convert a decimal integer to binary, octal and hexadecimal by repeated division"
    },
    {
     "en": "Convert a decimal fraction to binary by repeated multiplication"
    }
   ],
   "narration": {
    "en": "Your roll number is 45. How would a computer write it in binary? One simple method, repeated division, gives the answer.",
    "kn": "ನಿಮ್ಮ ಹಾಜರಿ ಸಂಖ್ಯೆ 45. ಗಣಕಯಂತ್ರ ಅದನ್ನು ದ್ವಿಮಾನದಲ್ಲಿ ಹೇಗೆ ಬರೆಯುತ್ತದೆ? ಪುನರಾವರ್ತಿತ ಭಾಗಾಕಾರ ಎಂಬ ಸರಳ ವಿಧಾನ ಉತ್ತರ ನೀಡುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Repeated division for whole numbers"
   },
   "body": {
    "en": "To convert a decimal integer to base b, divide it by b repeatedly and write down each remainder, until the quotient becomes 0. Reading the remainders from the last to the first (bottom to top) gives the number in base b. For hexadecimal, remainders 10 to 15 are written as A to F."
   },
   "points": [
    {
     "en": "Divide by 2, 8 or 16"
    },
    {
     "en": "Write each remainder"
    },
    {
     "en": "Stop when the quotient is 0"
    },
    {
     "en": "Read remainders bottom to top"
    }
   ],
   "narration": {
    "en": "To convert a decimal integer to base b, divide it by b repeatedly and write down each remainder, until the quotient becomes 0. Reading the remainders from the last to the first (bottom to top) gives the number in base b. For hexadecimal, remainders 10 to 15 are written as A to F.",
    "kn": "ದಶಮಾನ ಪೂರ್ಣಾಂಕವನ್ನು b ಆಧಾರಕ್ಕೆ ಬದಲಿಸಲು ಭಾಗಲಬ್ಧ 0 ಆಗುವವರೆಗೆ b ಯಿಂದ ಪದೇ ಪದೇ ಭಾಗಿಸಿ ಶೇಷಗಳನ್ನು ಬರೆಯಿರಿ. ಶೇಷಗಳನ್ನು ಕೆಳಗಿನಿಂದ ಮೇಲಕ್ಕೆ ಓದಿದರೆ ಉತ್ತರ ಸಿಗುತ್ತದೆ."
   }
  },
