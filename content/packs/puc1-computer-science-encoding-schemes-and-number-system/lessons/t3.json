  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Repeated multiplication for fractions"
   },
   "body": {
    "en": "To convert a decimal fraction to binary, multiply the fractional part by 2. The integer part of the product (0 or 1) is the next binary digit after the point. Repeat with the new fractional part until it becomes 0 or you have enough digits. Read the digits from top to bottom. For example, 0.375 × 2 = 0.75 (0), 0.75 × 2 = 1.5 (1), 0.5 × 2 = 1.0 (1), so $0.375 = (0.011)_2$."
   },
   "points": [
    {
     "en": "Multiply the fraction by 2"
    },
    {
     "en": "Take the integer part as the next bit"
    },
    {
     "en": "Read bits top to bottom"
    }
   ],
   "narration": {
    "en": "To convert a decimal fraction to binary, multiply the fractional part by 2. The integer part of the product (0 or 1) is the next binary digit after the point. Repeat with the new fractional part until it becomes 0 or you have enough digits. Read the digits from top to bottom. For example, 0.375 × 2 = 0.75 (0), 0.75 × 2 = 1.5 (1), 0.5 × 2 = 1.0 (1), so $0.375 = (0.011)_2$.",
    "kn": "ದಶಮಾನ ಭಿನ್ನಾಂಶವನ್ನು ದ್ವಿಮಾನಕ್ಕೆ ಬದಲಿಸಲು ಭಿನ್ನಾಂಶ ಭಾಗವನ್ನು 2 ರಿಂದ ಗುಣಿಸಿ; ಗುಣಲಬ್ಧದ ಪೂರ್ಣಾಂಕ ಭಾಗವೇ ಮುಂದಿನ ಅಂಕಿ. ಭಿನ್ನಾಂಶ 0 ಆಗುವವರೆಗೆ ಮುಂದುವರಿಸಿ, ಅಂಕಿಗಳನ್ನು ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಓದಿ."
   }
  },
