   ],
   "readouts": [
    {
     "label": {
      "en": "Binary"
     },
     "expr": "(floor(n/2^0)-2*floor(n/2^1))*10^0+(floor(n/2^1)-2*floor(n/2^2))*10^1+(floor(n/2^2)-2*floor(n/2^3))*10^2+(floor(n/2^3)-2*floor(n/2^4))*10^3+(floor(n/2^4)-2*floor(n/2^5))*10^4+(floor(n/2^5)-2*floor(n/2^6))*10^5+(floor(n/2^6)-2*floor(n/2^7))*10^6+(floor(n/2^7)-2*floor(n/2^8))*10^7",
     "digits": 0
    },
    {
     "label": {
      "en": "Octal"
     },
     "expr": "(floor(n/8^0)-8*floor(n/8^1))*10^0+(floor(n/8^1)-8*floor(n/8^2))*10^1+(floor(n/8^2)-8*floor(n/8^3))*10^2",
     "digits": 0
    },
    {
     "label": {
      "en": "Bits needed"
     },
     "expr": "floor(ln(n)/ln(2)+0.0000001)+1",
     "digits": 0
    }
   ],
   "tryThis": [
    {
     "en": "Set 25 and check the board’s answer 11001."
    },
    {
     "en": "Find the smallest number that needs 8 bits."
    },
    {
     "en": "Compare n and 2n: what happens to the binary digits?"
    }
   ],
   "narration": {
    "en": "Move the decimal number and read its binary and octal forms, and how many bits it needs. Set 25 and check the board’s answer 11001."
