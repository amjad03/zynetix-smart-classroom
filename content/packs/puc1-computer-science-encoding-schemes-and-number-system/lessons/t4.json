 "title": {
  "en": "Other number systems to decimal",
  "kn": "ಇತರ ಸಂಖ್ಯಾ ಪದ್ಧತಿಗಳಿಂದ ದಶಮಾನಕ್ಕೆ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Multiply by place value and add",
    "kn": "ಸ್ಥಾನ ಮೌಲ್ಯದಿಂದ ಗುಣಿಸಿ ಕೂಡಿಸಿ"
   },
   "hook": {
    "en": "A website colour code says 7D for green. How much green is that out of 255? Let us convert it to decimal.",
    "kn": "ವೆಬ್‌ಸೈಟ್ ಬಣ್ಣ ಸಂಕೇತದಲ್ಲಿ ಹಸಿರಿಗೆ 7D ಇದೆ. 255 ರಲ್ಲಿ ಅದು ಎಷ್ಟು? ಅದನ್ನು ದಶಮಾನಕ್ಕೆ ಬದಲಿಸೋಣ."
   },
   "objectives": [
    {
     "en": "Convert binary, octal and hexadecimal numbers to decimal"
    },
    {
     "en": "Convert binary fractions to decimal"
    }
   ],
   "narration": {
    "en": "A website colour code says 7D for green. How much green is that out of 255? Let us convert it to decimal.",
    "kn": "ವೆಬ್‌ಸೈಟ್ ಬಣ್ಣ ಸಂಕೇತದಲ್ಲಿ ಹಸಿರಿಗೆ 7D ಇದೆ. 255 ರಲ್ಲಿ ಅದು ಎಷ್ಟು? ಅದನ್ನು ದಶಮಾನಕ್ಕೆ ಬದಲಿಸೋಣ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Expand with place values"
   },
   "body": {
    "en": "To convert a number in base b to decimal, multiply each digit by its place value (b raised to its position) and add the products. Positions to the left of the point are 0, 1, 2, … and those to the right are −1, −2, … For example, $(101.101)_2 = 4 + 0 + 1 + 0.5 + 0 + 0.125 = 5.625$."
   },
   "points": [
    {
     "en": "Binary place values: …, 8, 4, 2, 1 . ½, ¼, ⅛"
    },
    {
     "en": "Octal: …, 64, 8, 1"
    },
    {
     "en": "Hexadecimal: …, 256, 16, 1"
    }
   ],
   "narration": {
    "en": "To convert a number in base b to decimal, multiply each digit by its place value (b raised to its position) and add the products. Positions to the left of the point are 0, 1, 2, … and those to the right are −1, −2, … For example, $(101.101)_2 = 4 + 0 + 1 + 0.5 + 0 + 0.125 = 5.625$.",
    "kn": "b ಆಧಾರದ ಸಂಖ್ಯೆಯನ್ನು ದಶಮಾನಕ್ಕೆ ಬದಲಿಸಲು ಪ್ರತಿ ಅಂಕಿಯನ್ನು ಅದರ ಸ್ಥಾನ ಮೌಲ್ಯದಿಂದ ಗುಣಿಸಿ ಎಲ್ಲವನ್ನೂ ಕೂಡಿಸಿ. ಬಿಂದುವಿನ ಎಡಕ್ಕೆ ಸ್ಥಾನಗಳು 0, 1, 2…, ಬಲಕ್ಕೆ −1, −2…"
   },
   "formula": "(d_2 d_1 d_0 . d_{-1})_b = d_2 b^2 + d_1 b + d_0 + d_{-1} b^{-1}"
  },
