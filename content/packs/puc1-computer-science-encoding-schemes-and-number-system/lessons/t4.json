  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Convert (101101)₂, (257)₈ and (1AF)₁₆ to decimal."
   },
   "steps": [
    {
     "en": "(101101)₂ = 32 + 0 + 8 + 4 + 0 + 1 = 45."
    },
    {
     "en": "(257)₈ = 2 × 64 + 5 × 8 + 7 = 128 + 40 + 7 = 175."
    },
    {
     "en": "(1AF)₁₆ = 1 × 256 + 10 × 16 + 15 = 256 + 160 + 15 = 431."
    }
   ],
   "answer": {
    "en": "45, 175 and 431"
   },
   "narration": {
    "en": "Let us work through this together. Convert (101101)₂, (257)₈ and (1AF)₁₆ to decimal."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Convert (1011.101)₂ to decimal."
   },
   "steps": [
    {
     "en": "Integer part: 8 + 0 + 2 + 1 = 11."
    },
    {
     "en": "Fraction part: 1 × ½ + 0 × ¼ + 1 × ⅛ = 0.5 + 0.125 = 0.625."
    },
    {
     "en": "Total = 11 + 0.625."
    }
   ],
   "answer": {
    "en": "(1011.101)₂ = (11.625)₁₀"
   },
   "narration": {
    "en": "Let us work through this together. Convert (1011.101)₂ to decimal."
   }
