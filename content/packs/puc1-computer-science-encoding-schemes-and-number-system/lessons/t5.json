   "problem": {
    "en": "Convert (11010111)₂ to octal and to hexadecimal."
   },
   "steps": [
    {
     "en": "Octal: group in threes from the right: 011 | 010 | 111 → 3 | 2 | 7."
    },
    {
     "en": "Hexadecimal: group in fours: 1101 | 0111 → D | 7."
    },
    {
     "en": "Check: both equal 215 in decimal."
    }
   ],
   "answer": {
    "en": "(327)₈ and (D7)₁₆"
   },
   "narration": {
