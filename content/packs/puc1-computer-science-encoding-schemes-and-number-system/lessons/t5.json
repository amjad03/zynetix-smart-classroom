 "topicId": "puc1-computer-science-02-encoding-schemes-and-number-system.t5",
 "title": {
  "en": "Binary, octal and hexadecimal conversions",
  "kn": "ದ್ವಿಮಾನ, ಅಷ್ಟಮಾನ ಮತ್ತು ಷೋಡಶಮಾನ ಪರಿವರ್ತನೆಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Shortcuts through binary",
    "kn": "ದ್ವಿಮಾನದ ಮೂಲಕ ಶಾರ್ಟ್‌ಕಟ್"
   },
   "hook": {
    "en": "Converting octal to hexadecimal through decimal is long. Since 8 and 16 are both powers of 2, binary gives us a shortcut. Let us find it.",
    "kn": "ಅಷ್ಟಮಾನದಿಂದ ಷೋಡಶಮಾನಕ್ಕೆ ದಶಮಾನದ ಮೂಲಕ ಬದಲಿಸುವುದು ದೀರ್ಘ. 8 ಮತ್ತು 16 ಎರಡೂ 2 ರ ಘಾತಗಳಾದ್ದರಿಂದ ದ್ವಿಮಾನ ಶಾರ್ಟ್‌ಕಟ್ ನೀಡುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Convert binary to octal and hexadecimal by grouping bits"
    },
    {
     "en": "Convert octal and hexadecimal to binary"
    },
    {
     "en": "Convert octal to hexadecimal through binary"
    }
   ],
   "narration": {
    "en": "Converting octal to hexadecimal through decimal is long. Since 8 and 16 are both powers of 2, binary gives us a shortcut. Let us find it.",
    "kn": "ಅಷ್ಟಮಾನದಿಂದ ಷೋಡಶಮಾನಕ್ಕೆ ದಶಮಾನದ ಮೂಲಕ ಬದಲಿಸುವುದು ದೀರ್ಘ. 8 ಮತ್ತು 16 ಎರಡೂ 2 ರ ಘಾತಗಳಾದ್ದರಿಂದ ದ್ವಿಮಾನ ಶಾರ್ಟ್‌ಕಟ್ ನೀಡುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Grouping bits"
   },
   "body": {
    "en": "Binary to octal: starting from the binary point, make groups of 3 bits (add 0s on the left if needed) and replace each group by its octal digit. Binary to hexadecimal: make groups of 4 bits and replace each by its hex digit. Going back, write each octal digit as 3 bits or each hex digit as 4 bits. To go from octal to hexadecimal (or back), first convert to binary and then regroup."
   },
   "points": [
    {
     "en": "Octal ↔ binary: 3 bits per digit"
    },
    {
     "en": "Hex ↔ binary: 4 bits per digit"
    },
    {
     "en": "Group from the binary point outwards; pad with 0s"
    },
    {
     "en": "Octal ↔ hex: go through binary"
    }
   ],
   "narration": {
    "en": "Binary to octal: starting from the binary point, make groups of 3 bits (add 0s on the left if needed) and replace each group by its octal digit. Binary to hexadecimal: make groups of 4 bits and replace each by its hex digit. Going back, write each octal digit as 3 bits or each hex digit as 4 bits. To go from octal to hexadecimal (or back), first convert to binary and then regroup.",
    "kn": "ದ್ವಿಮಾನದಿಂದ ಅಷ್ಟಮಾನಕ್ಕೆ: ಬಲದಿಂದ 3 ಬಿಟ್‌ಗಳ ಗುಂಪು ಮಾಡಿ. ಷೋಡಶಮಾನಕ್ಕೆ: 4 ಬಿಟ್‌ಗಳ ಗುಂಪು. ಹಿಂತಿರುಗಲು ಪ್ರತಿ ಅಷ್ಟಮಾನ ಅಂಕಿಯನ್ನು 3 ಬಿಟ್‌ಗಳಾಗಿ, ಷೋಡಶಮಾನ ಅಂಕಿಯನ್ನು 4 ಬಿಟ್‌ಗಳಾಗಿ ಬರೆಯಿರಿ. ಅಷ್ಟಮಾನದಿಂದ ಷೋಡಶಮಾನಕ್ಕೆ ದ್ವಿಮಾನದ ಮೂಲಕ ಹೋಗಿ."
   }
  },
