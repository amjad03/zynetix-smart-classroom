   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Convert (127)₈ to hexadecimal."
   },
   "steps": [
    {
     "en": "Write each octal digit as 3 bits: 1 → 001, 2 → 010, 7 → 111, giving 001010111."
    },
    {
     "en": "Regroup in fours from the right: 0000 | 0101 | 0111."
    },
    {
     "en": "Replace each group: 0 | 5 | 7."
    }
   ],
