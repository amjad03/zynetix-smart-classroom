   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find the decimal value of (3A)₁₆ and of (725)₈ using place values."
   },
   "steps": [
    {
     "en": "(3A)₁₆ = 3 × 16¹ + A × 16⁰ = 3 × 16 + 10 × 1."
    },
    {
     "en": "= 48 + 10 = 58."
    },
    {
     "en": "(725)₈ = 7 × 8² + 2 × 8¹ + 5 × 8⁰ = 448 + 16 + 5 = 469."
    }
   ],
   "answer": {
    "en": "(3A)₁₆ = 58; (725)₈ = 469"
   },
   "narration": {
    "en": "Let us work through this together. Find the decimal value of (3A)₁₆ and of (725)₈ using place values."
   }
