  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Ten fingers, two switches",
    "kn": "ಹತ್ತು ಬೆರಳುಗಳು, ಎರಡು ಸ್ವಿಚ್‌ಗಳು"
   },
   "hook": {
    "en": "We count in tens because we have ten fingers. A computer has only switches that are on or off. So what base does it count in?",
    "kn": "ನಮಗೆ ಹತ್ತು ಬೆರಳುಗಳಿರುವುದರಿಂದ ಹತ್ತರ ಆಧಾರದಲ್ಲಿ ಎಣಿಸುತ್ತೇವೆ. ಗಣಕಯಂತ್ರದಲ್ಲಿ ಆನ್ ಅಥವಾ ಆಫ್ ಇರುವ ಸ್ವಿಚ್‌ಗಳು ಮಾತ್ರ ಇವೆ. ಅದು ಯಾವ ಆಧಾರದಲ್ಲಿ ಎಣಿಸುತ್ತದೆ?"
   },
   "objectives": [
    {
     "en": "State the base and symbols of decimal, binary, octal and hexadecimal systems"
    },
    {
     "en": "Write the place value of each digit"
    },
    {
     "en": "Give uses of the hexadecimal system"
    }
   ],
   "narration": {
    "en": "We count in tens because we have ten fingers. A computer has only switches that are on or off. So what base does it count in?",
    "kn": "ನಮಗೆ ಹತ್ತು ಬೆರಳುಗಳಿರುವುದರಿಂದ ಹತ್ತರ ಆಧಾರದಲ್ಲಿ ಎಣಿಸುತ್ತೇವೆ. ಗಣಕಯಂತ್ರದಲ್ಲಿ ಆನ್ ಅಥವಾ ಆಫ್ ಇರುವ ಸ್ವಿಚ್‌ಗಳು ಮಾತ್ರ ಇವೆ. ಅದು ಯಾವ ಆಧಾರದಲ್ಲಿ ಎಣಿಸುತ್ತದೆ?"
   }
