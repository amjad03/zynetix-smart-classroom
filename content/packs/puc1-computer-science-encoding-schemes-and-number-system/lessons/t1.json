   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Write the ASCII codes of the word \"CAT\" in decimal and in 7-bit binary."
   },
   "steps": [
    {
     "en": "C, A and T are capital letters; A = 65, so C = 67 and T = 84."
    },
    {
     "en": "67 = 1000011, 65 = 1000001, 84 = 1010100 in binary."
    },
    {
     "en": "So CAT is stored as 1000011 1000001 1010100."
    }
   ],
   "answer": {
    "en": "Decimal: 67 65 84; binary: 1000011 1000001 1010100"
   },
