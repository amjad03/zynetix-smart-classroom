 "title": {
  "en": "Mortality rates: crude and specific death rates",
  "kn": "ಮರಣ ದರಗಳು: ಸ್ಥೂಲ ಮತ್ತು ನಿರ್ದಿಷ್ಟ ಮರಣ ದರ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Measuring deaths fairly",
    "kn": "ಮರಣಗಳನ್ನು ನ್ಯಾಯವಾಗಿ ಅಳೆಯುವುದು"
   },
   "hook": {
    "en": "A retirement town and a college town both had 400 deaths last year. Are they equally healthy? We need death rates, not just death counts.",
    "kn": "ನಿವೃತ್ತರ ಪಟ್ಟಣ ಮತ್ತು ಕಾಲೇಜು ಪಟ್ಟಣ ಎರಡರಲ್ಲೂ ಕಳೆದ ವರ್ಷ 400 ಮರಣಗಳಾದವು. ಎರಡೂ ಸಮಾನ ಆರೋಗ್ಯಕರವೇ? ನಮಗೆ ಮರಣ ಸಂಖ್ಯೆಯಲ್ಲ, ಮರಣ ದರ ಬೇಕು."
   },
   "objectives": [
    {
     "en": "Calculate the crude death rate (CDR)"
    },
    {
     "en": "Calculate specific death rates (SDR)"
    },
    {
     "en": "State merits and demerits of CDR"
    }
   ],
   "narration": {
    "en": "A retirement town and a college town both had 400 deaths last year. Are they equally healthy? We need death rates, not just death counts.",
    "kn": "ನಿವೃತ್ತರ ಪಟ್ಟಣ ಮತ್ತು ಕಾಲೇಜು ಪಟ್ಟಣ ಎರಡರಲ್ಲೂ ಕಳೆದ ವರ್ಷ 400 ಮರಣಗಳಾದವು. ಎರಡೂ ಸಮಾನ ಆರೋಗ್ಯಕರವೇ? ನಮಗೆ ಮರಣ ಸಂಖ್ಯೆಯಲ್ಲ, ಮರಣ ದರ ಬೇಕು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Crude death rate (CDR)"
   },
   "body": {
    "en": "The crude death rate is the number of deaths in a year per 1000 of the mid-year population: $\\text{CDR} = \\frac{D}{P} \\times 1000$. Merits: simple, needs only total deaths and total population. Demerit: it ignores the age and sex composition, so it is not suitable for comparing two places with different age structures."
   },
   "points": [
    {
     "en": "Merit: easy to compute and understand"
    },
    {
     "en": "Demerit: ignores age–sex composition"
    },
    {
     "en": "Not fit for comparing two regions"
    }
   ],
   "narration": {
    "en": "Crude death rate is deaths divided by mid-year population, times one thousand. It is simple, but it ignores the age and sex composition.",
    "kn": "ಸ್ಥೂಲ ಮರಣ ದರ = ಮರಣಗಳು ÷ ಮಧ್ಯವರ್ಷದ ಜನಸಂಖ್ಯೆ × 1000. ಇದು ಸರಳ, ಆದರೆ ವಯಸ್ಸು ಮತ್ತು ಲಿಂಗ ಸಂಯೋಜನೆಯನ್ನು ಕಡೆಗಣಿಸುತ್ತದೆ."
   },
   "formula": "\\text{CDR} = \\frac{D}{P} \\times 1000"
  },
