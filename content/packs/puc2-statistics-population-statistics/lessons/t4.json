 "title": {
  "en": "Fertility rates: CBR, GFR, SFR and TFR",
  "kn": "ಫಲವತ್ತತೆ ದರಗಳು: CBR, GFR, SFR ಮತ್ತು TFR"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "How many children per woman?",
    "kn": "ಪ್ರತಿ ಮಹಿಳೆಗೆ ಎಷ್ಟು ಮಕ್ಕಳು?"
   },
   "hook": {
    "en": "News reports say India's fertility rate is now close to two children per woman. How is such a number calculated from birth records?",
    "kn": "ಭಾರತದ ಫಲವತ್ತತೆ ದರ ಈಗ ಪ್ರತಿ ಮಹಿಳೆಗೆ ಸುಮಾರು ಎರಡು ಮಕ್ಕಳು ಎಂದು ವರದಿಗಳು ಹೇಳುತ್ತವೆ. ಜನನ ದಾಖಲೆಗಳಿಂದ ಈ ಸಂಖ್ಯೆಯನ್ನು ಹೇಗೆ ಲೆಕ್ಕಿಸುತ್ತಾರೆ?"
   },
   "objectives": [
    {
     "en": "Compute CBR and GFR"
    },
    {
     "en": "Compute specific fertility rates"
    },
    {
     "en": "Compute the total fertility rate"
    }
   ],
   "narration": {
    "en": "News reports say India's fertility rate is now close to two children per woman. How is such a number calculated from birth records?",
    "kn": "ಭಾರತದ ಫಲವತ್ತತೆ ದರ ಈಗ ಪ್ರತಿ ಮಹಿಳೆಗೆ ಸುಮಾರು ಎರಡು ಮಕ್ಕಳು ಎಂದು ವರದಿಗಳು ಹೇಳುತ್ತವೆ. ಜನನ ದಾಖಲೆಗಳಿಂದ ಈ ಸಂಖ್ಯೆಯನ್ನು ಹೇಗೆ ಲೆಕ್ಕಿಸುತ್ತಾರೆ?"
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Crude birth rate and general fertility rate"
   },
   "body": {
    "en": "Crude birth rate: $\\text{CBR} = \\frac{B}{P} \\times 1000$, births per thousand of the whole population. It is crude because men, children and old women cannot give birth. General fertility rate uses only women of child-bearing age (15–49): $\\text{GFR} = \\frac{B}{W_{15-49}} \\times 1000$."
   },
   "points": [
    {
     "en": "CBR: base is the whole population"
    },
    {
     "en": "GFR: base is women aged 15–49"
    },
    {
     "en": "GFR ignores the age distribution within 15–49"
    }
   ],
   "narration": {
    "en": "Crude birth rate divides births by the whole population. General fertility rate divides births by the number of women aged fifteen to forty-nine.",
    "kn": "ಸ್ಥೂಲ ಜನನ ದರವು ಜನನಗಳನ್ನು ಒಟ್ಟು ಜನಸಂಖ್ಯೆಯಿಂದ ಭಾಗಿಸುತ್ತದೆ. ಸಾಮಾನ್ಯ ಫಲವತ್ತತೆ ದರವು ಜನನಗಳನ್ನು 15 ರಿಂದ 49 ವಯಸ್ಸಿನ ಮಹಿಳೆಯರ ಸಂಖ್ಯೆಯಿಂದ ಭಾಗಿಸುತ್ತದೆ."
   },
   "formula": "\\text{GFR} = \\frac{B}{W_{15\\text{–}49}} \\times 1000"
  },
