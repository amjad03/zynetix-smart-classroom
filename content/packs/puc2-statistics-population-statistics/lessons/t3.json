  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Standardised death rate: direct method"
   },
   "body": {
    "en": "To compare two places we apply each place's own specific death rates to a common standard population $A_x$ (often the population of the state or country). The standardised death rate is $\\text{STDR} = \\frac{\\sum A_x\\,\\text{SDR}_x}{\\sum A_x}$. The place with the lower STDR is the healthier one, because the age structure is now the same for both."
   },
   "points": [
    {
     "en": "Standard population: same weights for both places"
    },
    {
     "en": "Lower STDR → healthier place"
    },
    {
     "en": "Use STDR, not CDR, for comparison"
    }
   ],
   "narration": {
    "en": "The standardised death rate applies each town's own specific death rates to one common standard population. The town with the lower standardised rate is healthier.",
    "kn": "ಪ್ರಮಾಣೀಕೃತ ಮರಣ ದರದಲ್ಲಿ ಪ್ರತಿ ಪಟ್ಟಣದ ನಿರ್ದಿಷ್ಟ ಮರಣ ದರಗಳನ್ನು ಒಂದೇ ಪ್ರಮಾಣಿತ ಜನಸಂಖ್ಯೆಗೆ ಅನ್ವಯಿಸುತ್ತೇವೆ. ಕಡಿಮೆ ಪ್ರಮಾಣೀಕೃತ ದರದ ಪಟ್ಟಣ ಹೆಚ್ಚು ಆರೋಗ್ಯಕರ."
   },
   "formula": "\\text{STDR} = \\frac{\\sum A_x \\cdot \\text{SDR}_x}{\\sum A_x}"
  },
