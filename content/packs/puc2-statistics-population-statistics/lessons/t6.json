  {
   "id": "sim1",
   "type": "interactive",
   "title": {
    "en": "A life table curve",
    "kn": "ಜೀವ ಕೋಷ್ಟಕ ವಕ್ರ"
   },
   "narration": {
    "en": "Out of 1000 babies born together, lₓ are still alive at age x (yellow). The area under the curve to the right of x is Tₓ, the total years they will still live, so the expectation of life is eₓ = Tₓ/lₓ. Raise the mortality level and watch the curve fall earlier."
   },
   "seconds": 150,
   "optional": true,
   "kind": "scene",
   "caption": {
    "en": "Out of 1000 babies born together, lₓ are still alive at age x (yellow). The area under the curve to the right of x is Tₓ, the total years they will still live, so the expectation of life is eₓ = Tₓ/lₓ. Raise the mortality level and watch the curve fall earlier.",
    "kn": "ಒಟ್ಟಿಗೆ ಹುಟ್ಟಿದ 1000 ಶಿಶುಗಳಲ್ಲಿ x ವಯಸ್ಸಿನಲ್ಲಿ lₓ ಜೀವಂತ (ಹಳದಿ). x ನ ಬಲಕ್ಕೆ ವಕ್ರದ ಕೆಳಗಿನ ವಿಸ್ತೀರ್ಣ Tₓ, ಅವರು ಇನ್ನೂ ಬದುಕುವ ಒಟ್ಟು ವರ್ಷಗಳು; ಹಾಗಾಗಿ ಜೀವಿತ ನಿರೀಕ್ಷೆ eₓ = Tₓ/lₓ. ಮರಣ ಮಟ್ಟ ಹೆಚ್ಚಿಸಿ, ವಕ್ರ ಬೇಗ ಇಳಿಯುವುದನ್ನು ನೋಡಿ."
   },
   "tryThis": [
    {
     "en": "What is the expectation of life at birth now? At age 60?"
    },
    {
     "en": "Raise the mortality level. Which falls faster, e₀ or e₆₀?"
    },
    {
     "en": "Does e₁ come out more than e₀ minus 1? What does that tell you?"
    }
   ],
   "sliders": [
    {
     "name": "X",
     "label": {
      "en": "Age x",
      "kn": "ವಯಸ್ಸು x"
     },
     "min": 0,
     "max": 100,
     "step": 5,
     "value": 60,
     "unit": "years"
    },
    {
     "name": "Ak",
     "label": {
      "en": "Mortality level",
      "kn": "ಮರಣ ಮಟ್ಟ"
     },
     "min": 2,
     "max": 30,
     "step": 1,
     "value": 6
    }
   ],
   "vars": [
    {
     "name": "Am",
     "expr": "Ak/100000"
    },
    {
     "name": "lX",
     "expr": "1000*exp(-0.0008*(X) - Am/0.085*(exp(0.085*(X)) - 1))"
    },
    {
     "name": "l1",
     "expr": "1000*exp(-0.0008*(X + 1) - Am/0.085*(exp(0.085*(X + 1)) - 1))"
    },
