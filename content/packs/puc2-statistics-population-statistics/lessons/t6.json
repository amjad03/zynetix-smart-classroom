  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Columns of the life table"
   },
   "body": {
    "en": "$d_x = l_x - l_{x+1}$ (deaths between x and x+1); $q_x = d_x/l_x$ (probability of dying); $p_x = 1 - q_x$ (probability of surviving); $L_x = (l_x + l_{x+1})/2$ (years lived between x and x+1); $T_x = L_x + L_{x+1} + \\dots$ (total future years lived); $e_x^0 = T_x/l_x$ (complete expectation of life at age x)."
   },
   "points": [
    {
     "en": "Tₓ is summed from the bottom of the table upwards"
    },
    {
     "en": "qₓ + pₓ = 1"
    }
   ],
   "narration": {
    "en": "From l x we get d x, the deaths; q x, the probability of dying; p x, of surviving; L x, the years lived in the year; T x, all future years; and e x, the expectation of life, which is T x over l x.",
    "kn": "lₓ ನಿಂದ dₓ (ಮರಣಗಳು), qₓ (ಸಾಯುವ ಸಂಭವನೀಯತೆ), pₓ (ಬದುಕುವ ಸಂಭವನೀಯತೆ), Lₓ, Tₓ ಮತ್ತು ಜೀವಿತಾವಧಿ ನಿರೀಕ್ಷೆ eₓ = Tₓ/lₓ ದೊರೆಯುತ್ತವೆ."
   },
   "formula": "e_x^0 = \\frac{T_x}{l_x}, \\quad T_x = \\sum_{y \\ge x} L_y"
  },
