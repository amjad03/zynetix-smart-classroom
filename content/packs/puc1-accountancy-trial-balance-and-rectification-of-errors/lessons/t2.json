  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "From the following balances of Ganesh Traders on 31 March 2025, prepare a trial balance and find the capital: Cash ₹12,000; Bank ₹18,000; Debtors ₹25,000; Furniture ₹30,000; Purchases ₹60,000; Salaries ₹15,000; Rent ₹6,000; Drawings ₹4,000; Sales ₹95,000; Creditors ₹20,000; Capital ?"
   },
   "steps": [
    {
     "en": "Debit column: 12,000 + 18,000 + 25,000 + 30,000 + 60,000 + 15,000 + 6,000 + 4,000 = ₹1,70,000."
    },
    {
     "en": "Credit column without capital: Sales 95,000 + Creditors 20,000 = ₹1,15,000."
    },
    {
     "en": "Capital is a credit balance: 1,70,000 − 1,15,000 = ₹55,000."
    },
    {
     "en": "Trial balance totals: Debit ₹1,70,000 = Credit ₹1,70,000."
    }
   ],
   "answer": {
    "en": "Capital = ₹55,000; trial balance totals ₹1,70,000."
   },
   "narration": {
    "en": "Let us work this out together. From the following balances of Ganesh Traders on 31 March 2025, prepare a trial balance and find the capital: Cash ₹12,000; Bank ₹18,000; Debtors ₹25,000; Furniture ₹30,000; Purchases ₹60,000; Salaries ₹15,000; Rent ₹6,000; Drawings ₹4,000; Sales ₹95,000; Creditors ₹20,000; Capital ?"
   }
