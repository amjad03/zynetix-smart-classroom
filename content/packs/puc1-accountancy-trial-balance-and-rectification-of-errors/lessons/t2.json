   "title": {
    "en": "Methods of preparing a trial balance"
   },
   "body": {
    "en": "Totals method: the debit and credit totals of every account are listed. Balance method: only the net balance of each account is listed; this is the most commonly used method. Totals-cum-balance method: both totals and balances are shown. In every method the two columns must agree."
   },
   "points": [
    {
     "en": "Totals method"
    },
    {
     "en": "Balance method (most used)"
    },
    {
     "en": "Totals-cum-balance method"
    }
   ],
   "narration": {
    "en": "Totals method: the debit and credit totals of every account are listed. Balance method: only the net balance of each account is listed; this is the most commonly used method. Totals-cum-balance method: both totals and balances are shown. In every method the two columns must agree.",
    "kn": "ಒಟ್ಟು ಮೊತ್ತ ವಿಧಾನ, ಬಾಕಿ ವಿಧಾನ ಮತ್ತು ಒಟ್ಟು-ಬಾಕಿ ವಿಧಾನ ಎಂಬ ಮೂರು ವಿಧಾನಗಳಿವೆ. ಬಾಕಿ ವಿಧಾನವನ್ನು ಹೆಚ್ಚಾಗಿ ಬಳಸುತ್ತಾರೆ. ಎಲ್ಲಾ ವಿಧಾನಗಳಲ್ಲೂ ಎರಡು ಕಾಲಂಗಳು ತಾಳೆಯಾಗಬೇಕು."
   }
  },
