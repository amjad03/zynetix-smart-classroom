  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q12",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t3",
  "stem": {
   "en": "The mean deviation about the median of 3, 6, 9, 14, 18 is:"
  },
  "options": [
   {
    "en": "4.6"
   },
   {
    "en": "9"
   },
