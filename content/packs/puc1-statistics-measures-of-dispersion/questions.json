[
 {
  "id": "1t06-q01",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t1",
  "stem": {
   "en": "The range of 12, 7, 19, 25 and 10 is:"
  },
  "options": [
   {
    "en": "25"
   },
   {
    "en": "18"
   },
   {
    "en": "15"
   },
   {
    "en": "13"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Range = largest − smallest = 25 − 7 = 18."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q02",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t1",
  "stem": {
   "en": "If the largest value is 80 and the smallest is 20, the coefficient of range is:"
  },
  "options": [
   {
    "en": "60"
   },
   {
    "en": "0.75"
   },
   {
    "en": "0.25"
   },
   {
    "en": "0.6"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Coefficient of range = (H − L)/(H + L) = 60/100 = 0.6."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q03",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t1",
  "stem": {
   "en": "Which of these is a relative measure of dispersion?"
  },
  "options": [
   {
    "en": "Range"
   },
   {
    "en": "Quartile deviation"
   },
   {
    "en": "Standard deviation"
   },
   {
    "en": "Coefficient of variation"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Relative measures are ratios free of units, like the coefficient of variation. The other three are in the units of the data."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q04",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t1",
  "stem": {
   "en": "For the classes 5–10, 10–15, 15–20, 20–25 and 25–30, the range is:"
  },
  "options": [
   {
    "en": "20"
   },
   {
    "en": "5"
   },
   {
    "en": "25"
   },
   {
    "en": "30"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "For a continuous distribution, range = upper limit of the highest class − lower limit of the lowest class = 30 − 5 = 25."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t06-q05",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t2",
  "stem": {
   "en": "If Q₁ = 30 and Q₃ = 50, the quartile deviation is:"
  },
  "options": [
   {
    "en": "40"
   },
   {
    "en": "0.25"
   },
   {
    "en": "10"
   },
   {
    "en": "20"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Q.D. = (Q₃ − Q₁)/2 = 20/2 = 10."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q06",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t2",
  "stem": {
   "en": "Quartile deviation is also called the:"
  },
  "options": [
   {
    "en": "semi-interquartile range"
   },
   {
    "en": "interquartile range"
   },
   {
    "en": "probable error"
   },
   {
    "en": "mean deviation"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Q.D. = (Q₃ − Q₁)/2 is half the interquartile range, hence semi-interquartile range."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q07",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t2",
  "stem": {
   "en": "If Q₁ = 30 and Q₃ = 50, the coefficient of quartile deviation is:"
  },
  "options": [
   {
    "en": "0.4"
   },
   {
    "en": "0.25"
   },
   {
    "en": "0.5"
   },
   {
    "en": "10"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Coefficient of Q.D. = (Q₃ − Q₁)/(Q₃ + Q₁) = 20/80 = 0.25."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q08",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t2",
  "stem": {
   "en": "For the values 3, 5, 8, 10, 12, 15, 18, the quartile deviation is:"
  },
  "options": [
   {
    "en": "7.5"
   },
   {
    "en": "5"
   },
   {
    "en": "10"
   },
   {
    "en": "4"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "n = 7: Q₁ = (n + 1)/4 = 2nd value = 5; Q₃ = 3(n + 1)/4 = 6th value = 15. Q.D. = (15 − 5)/2 = 5."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t06-q09",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t3",
  "stem": {
   "en": "The mean deviation about the mean of 2, 4, 6, 8, 10 is:"
  },
  "options": [
   {
    "en": "2.83"
   },
   {
    "en": "2.4"
   },
   {
    "en": "6"
   },
   {
    "en": "2"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Mean = 6. |x − 6| = 4, 2, 0, 2, 4; sum 12. M.D. = 12/5 = 2.4."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q10",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t3",
  "stem": {
   "en": "Mean deviation is least when deviations are taken about the:"
  },
  "options": [
   {
    "en": "geometric mean"
   },
   {
    "en": "mean"
   },
   {
    "en": "median"
   },
   {
    "en": "mode"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "The sum of absolute deviations Σ|x − A| is minimum when A is the median."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t06-q11",
  "chapterId": "puc1-statistics-06-measures-of-dispersion",
  "topicId": "puc1-statistics-06-measures-of-dispersion.t3",
  "stem": {
   "en": "If the mean deviation about the mean is 3 and the mean is 15, the coefficient of mean deviation is:"
