 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Square away the signs",
    "kn": "ಚಿಹ್ನೆಗಳನ್ನು ವರ್ಗದಿಂದ ತೆಗೆಯಿರಿ"
   },
   "hook": {
    "en": "Mean deviation drops the signs by force. Squaring the deviations removes them in a way algebra likes, and gives the most used measure of spread: the standard deviation.",
    "kn": "ಸರಾಸರಿ ವಿಚಲನೆ ಚಿಹ್ನೆಗಳನ್ನು ಬಲವಂತವಾಗಿ ಬಿಡುತ್ತದೆ. ವಿಚಲನೆಗಳನ್ನು ವರ್ಗ ಮಾಡಿದರೆ ಚಿಹ್ನೆಗಳು ಸಹಜವಾಗಿ ಹೋಗುತ್ತವೆ; ಅದರಿಂದ ಹೆಚ್ಚು ಬಳಸುವ ಮಾನಕ ವಿಚಲನೆ ಸಿಗುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Define S.D. and variance"
    },
    {
     "en": "Compute S.D. for raw, discrete and grouped data"
    },
    {
     "en": "Use the step-deviation method"
    }
   ],
   "narration": {
    "en": "Mean deviation drops the signs by force. Squaring the deviations removes them in a way algebra likes, and gives the most used measure of spread: the standard deviation.",
    "kn": "ಸರಾಸರಿ ವಿಚಲನೆ ಚಿಹ್ನೆಗಳನ್ನು ಬಲವಂತವಾಗಿ ಬಿಡುತ್ತದೆ. ವಿಚಲನೆಗಳನ್ನು ವರ್ಗ ಮಾಡಿದರೆ ಚಿಹ್ನೆಗಳು ಸಹಜವಾಗಿ ಹೋಗುತ್ತವೆ; ಅದರಿಂದ ಹೆಚ್ಚು ಬಳಸುವ ಮಾನಕ ವಿಚಲನೆ ಸಿಗುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Standard deviation"
   },
   "body": {
    "en": "Standard deviation σ (Karl Pearson, 1893) is the positive square root of the mean of the squared deviations from the arithmetic mean: $\\sigma = \\sqrt{\\sum (x - \\bar{x})^2 / n}$. Its square $\\sigma^2$ is the variance. A useful form is $\\sigma^2 = \\sum x^2/n - \\bar{x}^2$: the mean of squares minus the square of the mean.",
    "kn": "ಮಾನಕ ವಿಚಲನೆ σ ಎಂದರೆ ಅಂಕಗಣಿತ ಸರಾಸರಿಯಿಂದ ವಿಚಲನೆಗಳ ವರ್ಗಗಳ ಸರಾಸರಿಯ ಧನ ವರ್ಗಮೂಲ. ಅದರ ವರ್ಗ σ² ವ್ಯತ್ಯಾಸಾಂಕ. σ² = ವರ್ಗಗಳ ಸರಾಸರಿ − ಸರಾಸರಿಯ ವರ್ಗ."
   },
   "points": [
    {
     "en": "Always taken about the mean"
    },
    {
     "en": "Variance = σ²"
    },
    {
     "en": "Best measure of dispersion for further algebra"
    }
   ],
   "formula": "\\sigma = \\sqrt{\\frac{\\sum (x-\\bar{x})^2}{n}} = \\sqrt{\\frac{\\sum x^2}{n} - \\bar{x}^2}",
   "narration": {
    "en": "Standard deviation σ (Karl Pearson, 1893) is the positive square root of the mean of the squared deviations from the arithmetic mean: \\sigma = \\sqrt{\\sum (x - \\bar{x})^2 / n}. Its square \\sigma^2 is the variance. A useful form is \\sigma^2 = \\sum x^2/n - \\bar{x}^2: the mean of squares minus the square of the mean.",
    "kn": "ಮಾನಕ ವಿಚಲನೆ σ ಎಂದರೆ ಅಂಕಗಣಿತ ಸರಾಸರಿಯಿಂದ ವಿಚಲನೆಗಳ ವರ್ಗಗಳ ಸರಾಸರಿಯ ಧನ ವರ್ಗಮೂಲ. ಅದರ ವರ್ಗ σ² ವ್ಯತ್ಯಾಸಾಂಕ. σ² = ವರ್ಗಗಳ ಸರಾಸರಿ − ಸರಾಸರಿಯ ವರ್ಗ."
   }
  },
