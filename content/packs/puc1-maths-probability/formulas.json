{
 "chapterId": "puc1-maths-14-probability",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-14-probability.t4",
   "name": {
    "en": "Classical probability"
   },
   "tex": "P(E) = \\frac{n(E)}{n(S)}",
   "note": {
    "en": "for a finite sample space of equally likely outcomes"
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-14-probability.t4",
   "name": {
    "en": "Axioms"
   },
   "tex": "P(E)\\ge0,\\quad P(S) = 1,\\quad E\\cap F = \\varnothing\\Rightarrow P(E\\cup F) = P(E)+P(F)"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Range and complement"
   },
   "tex": "0\\le P(E)\\le1,\\qquad P(\\varnothing) = 0,\\qquad P(E') = 1-P(E)"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-14-probability.t4",
   "name": {
    "en": "Number of events"
   },
   "tex": "|S| = n\\ \\Rightarrow\\ 2^n\\ \\text{events}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-14-probability.t3",
   "name": {
    "en": "Mutually exclusive / exhaustive"
   },
   "tex": "E\\cap F = \\varnothing\\ \\ (\\text{mutually exclusive}),\\qquad E_1\\cup\\cdots\\cup E_n = S\\ \\ (\\text{exhaustive})"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-14-probability.t5",
   "name": {
    "en": "Addition rule"
   },
   "tex": "P(A\\cup B) = P(A)+P(B)-P(A\\cap B)"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Three events"
   },
   "tex": "P(A\\cup B\\cup C) = \\sum P(A)-\\sum P(A\\cap B)+P(A\\cap B\\cap C)"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-maths-14-probability.t2",
   "name": {
    "en": "Only A / exactly one"
   },
   "tex": "P(A\\cap B') = P(A)-P(A\\cap B),\\quad P(\\text{exactly one}) = P(A)+P(B)-2P(A\\cap B)"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "De Morgan"
   },
   "tex": "P(A'\\cap B') = 1-P(A\\cup B),\\qquad P(A'\\cup B') = 1-P(A\\cap B)"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Bounds"
   },
   "tex": "\\max\\{0, P(A)+P(B)-1\\}\\le P(A\\cap B)\\le\\min\\{P(A), P(B)\\}\\le P(A\\cup B)\\le P(A)+P(B)"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-14-probability.t2",
   "name": {
    "en": "Subset rule"
   },
   "tex": "A\\subseteq B\\Rightarrow P(A)\\le P(B),\\quad P(B-A) = P(B)-P(A)"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Odds"
   },
   "tex": "\\text{odds in favour } a:b\\ \\Rightarrow\\ P(E) = \\frac a{a+b};\\quad \\text{odds against } a:b\\ \\Rightarrow\\ P(E) = \\frac b{a+b}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "At least one"
   },
   "tex": "P(\\text{at least one}) = 1-P(\\text{none})"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-14-probability.t1",
   "name": {
    "en": "Coins and dice"
   },
   "tex": "n\\ \\text{coins}: 2^n\\ \\text{outcomes},\\quad n\\ \\text{dice}: 6^n;\\quad P(k\\ \\text{heads in } n) = \\frac{\\binom nk}{2^n}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-14-probability.t1",
   "name": {
    "en": "Two dice: sums"
   },
   "tex": "n(\\text{sum} = s) = 6-|s-7|,\\quad s = 2, \\dots, 12"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Pack of cards"
   },
   "tex": "52\\ \\text{cards}: 4\\ \\text{suits}\\times13;\\ 12\\ \\text{face cards};\\ 4\\ \\text{aces}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Leap year Sundays"
   },
   "tex": "P(53\\ \\text{Sundays}) = \\frac27\\ (\\text{leap}),\\quad \\frac17\\ (\\text{non-leap})"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Round table neighbours"
   },
   "tex": "P(\\text{two given people adjacent among } n) = \\frac2{n-1}"
  }
 ]
}
