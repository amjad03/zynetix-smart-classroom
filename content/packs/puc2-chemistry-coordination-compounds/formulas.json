{
 "chapterId": "puc2-chemistry-05-coordination-compounds",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-05-coordination-compounds.t1",
   "name": {
    "en": "EAN rule"
   },
   "tex": "\\text{EAN} = Z - \\text{O.S.} + 2\\times\\text{CN}",
   "note": {
    "en": "Stable when equals next noble gas."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-05-coordination-compounds.t4",
   "name": {
    "en": "Spin-only moment"
   },
   "tex": "\\mu = \\sqrt{n(n+2)}\\ \\text{BM}",
   "note": {
    "en": "n = unpaired d electrons."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "CFSE (octahedral)"
   },
   "tex": "\\text{CFSE} = (-0.4\\,n_{t_{2g}} + 0.6\\,n_{e_g})\\Delta_o",
   "note": {
    "en": "Add pairing energy if needed."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "Tetrahedral splitting"
   },
   "tex": "\\Delta_t = \\tfrac49\\Delta_o",
   "note": {
    "en": "Usually high spin."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Overall stability constant"
   },
   "tex": "\\beta_n = K_1K_2\\cdots K_n",
   "note": {
    "en": "Higher β → more stable."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-05-coordination-compounds.t3",
   "name": {
    "en": "Geometrical isomers [MA₂B₂] (square planar)"
   },
   "tex": "\\text{cis + trans} = 2",
   "note": {
    "en": "Tetrahedral MA₂B₂ shows none."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "Spectrochemical series"
   },
   "tex": "\\text{I}^- < \\text{Cl}^- < \\text{F}^- < \\text{OH}^- < \\text{H}_2\\text{O} < \\text{NH}_3 < \\text{en} < \\text{CN}^- < \\text{CO}",
   "note": {
    "en": "Left = weak field, right = strong field."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-05-coordination-compounds.t1",
   "name": {
    "en": "Werner's theory"
   },
   "tex": "\\text{primary valence} = \\text{oxidation state};\\ \\ \\text{secondary valence} = \\text{CN}",
   "note": {
    "en": "Only counter-ions (outside [ ]) precipitate with AgNO₃; CoCl₃·5NH₃ = [Co(NH₃)₅Cl]Cl₂ → 2 AgCl."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-05-coordination-compounds.t2",
   "name": {
    "en": "Oxidation state of the metal"
   },
   "tex": "x + \\sum(\\text{ligand charges}) = \\text{charge on the complex ion}",
   "note": {
    "en": "Neutral: NH₃, H₂O, CO, en, PPh₃. Anionic: Cl⁻, CN⁻, NO₂⁻, C₂O₄²⁻, EDTA⁴⁻."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-05-coordination-compounds.t1",
   "name": {
    "en": "Denticity"
   },
   "tex": "\\text{en, ox}^{2-}\\ (2),\\ \\ \\text{dien}\\ (3),\\ \\ \\text{EDTA}^{4-}\\ (6)",
   "note": {
    "en": "Ambidentate: NO₂⁻ (N/O), SCN⁻ (S/N), CN⁻ (C/N)."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-05-coordination-compounds.t2",
   "name": {
    "en": "Nomenclature rules"
   },
   "tex": "\\text{cation first; ligands alphabetical; metal (O.S.)}",
   "note": {
    "en": "Anionic ligands end in -o (chlorido, cyanido); anionic complex: metal + -ate (ferrate, cuprate, argentate, plumbate)."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "Spectrochemical series"
   },
   "tex": "\\text{I}^- < \\text{Br}^- < \\text{SCN}^- < \\text{Cl}^- < \\text{S}^{2-} < \\text{F}^- < \\text{OH}^- < \\text{C}_2\\text{O}_4^{2-} < \\text{H}_2\\text{O} < \\text{NCS}^- < \\text{EDTA}^{4-} < \\text{NH}_3 < \\text{en} < \\text{CN}^- < \\text{CO}",
   "note": {
    "en": "Strong-field ligands give low-spin complexes."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "Octahedral splitting"
   },
   "tex": "t_{2g}: -0.4\\,\\Delta_o,\\qquad e_g: +0.6\\,\\Delta_o",
   "note": {
    "en": "Barycentre preserved."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-05-coordination-compounds.t4",
   "name": {
    "en": "CFSE (octahedral)"
   },
   "tex": "\\text{CFSE} = (-0.4\\,n_{t_{2g}} + 0.6\\,n_{e_g})\\,\\Delta_o\\ (+\\,mP)",
   "note": {
    "en": "Low-spin d⁶: −2.4 Δₒ; high-spin d⁵: 0; d³: −1.2 Δₒ; high-spin d⁴: −0.6 Δₒ."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "Tetrahedral splitting"
   },
   "tex": "\\Delta_t = \\tfrac{4}{9}\\,\\Delta_o;\\quad e: -0.6\\,\\Delta_t,\\ \\ t_2: +0.4\\,\\Delta_t",
   "note": {
    "en": "Δₜ < P, so tetrahedral complexes are high spin."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "High vs low spin"
   },
   "tex": "\\Delta_o > P \\Rightarrow \\text{low spin};\\quad \\Delta_o < P \\Rightarrow \\text{high spin}",
   "note": {
    "en": "Only d⁴–d⁷ octahedral ions have a choice."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-05-coordination-compounds.t4",
   "name": {
    "en": "VBT hybridisation"
   },
   "tex": "\\text{CN } 4: sp^3\\ (\\text{tetrahedral}),\\ dsp^2\\ (\\text{square planar});\\ \\ \\text{CN } 6: d^2sp^3\\ (\\text{inner}),\\ sp^3d^2\\ (\\text{outer})",
   "note": {
    "en": "[Ni(CN)₄]²⁻ dsp²; [NiCl₄]²⁻ sp³; [Co(NH₃)₆]³⁺ d²sp³; [CoF₆]³⁻ sp³d²; [Ni(NH₃)₆]²⁺ sp³d²."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-05-coordination-compounds.t5",
   "name": {
    "en": "Colour and Δ"
   },
   "tex": "\\Delta_o = \\frac{N_A h c}{\\lambda_{\\max}}",
   "note": {
    "en": "Colour seen is complementary to the absorbed colour. [Ti(H₂O)₆]³⁺: λ ≈ 498 nm, Δₒ ≈ 240 kJ mol⁻¹, violet."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-05-coordination-compounds.t3",
   "name": {
    "en": "Structural isomerism"
   },
   "tex": "\\text{ionisation, linkage, coordination, solvate (hydrate)}",
   "note": {
    "en": "Hydrate isomers of CrCl₃·6H₂O: violet [Cr(H₂O)₆]Cl₃, grey-green [Cr(H₂O)₅Cl]Cl₂·H₂O, dark green [Cr(H₂O)₄Cl₂]Cl·2H₂O."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-05-coordination-compounds.t3",
   "name": {
    "en": "Geometrical isomer counts"
   },
   "tex": "[\\text{Ma}_2\\text{b}_2]_{sq}: 2;\\ \\ [\\text{Ma}_4\\text{b}_2]: 2;\\ \\ [\\text{Ma}_3\\text{b}_3]: 2\\ (fac/mer);\\ \\ [\\text{Ma}_2\\text{b}_2\\text{c}_2]: 5",
   "note": {
    "en": "Tetrahedral MA₂B₂ shows no geometrical isomerism."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-chemistry-05-coordination-compounds.t3",
   "name": {
    "en": "Stereoisomer counts (with en)"
   },
   "tex": "[\\text{M(AA)}_3]: 2;\\ \\ [\\text{M(AA)}_2\\text{b}_2]: 3;\\ \\ [\\text{M(AA)a}_2\\text{b}_2]: 4;\\ \\ [\\text{Ma}_2\\text{b}_2\\text{c}_2]: 6",
   "note": {
    "en": "cis-[M(AA)₂b₂] is chiral; trans is not. Square planar complexes are almost never chiral."
   }
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Stability constants"
   },
   "tex": "\\beta_n = K_1 K_2 \\cdots K_n,\\qquad \\log\\beta_n = \\sum \\log K_i",
   "note": {
    "en": "Usually K₁ > K₂ > … ; chelates are extra stable (chelate effect, entropy)."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-chemistry-05-coordination-compounds.t6",
   "name": {
    "en": "Synergic bonding in carbonyls"
   },
   "tex": "\\text{M} \\leftarrow \\text{C}\\ (\\sigma),\\quad \\text{M} \\rightarrow \\pi^*(\\text{CO})",
   "note": {
    "en": "Back-bonding lengthens C–O and lowers ν(CO)."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-chemistry-05-coordination-compounds.t2",
   "name": {
    "en": "Carbonyl structures"
   },
   "tex": "\\text{Ni(CO)}_4\\ \\text{tetrahedral},\\ \\text{Fe(CO)}_5\\ \\text{TBP},\\ \\text{Cr(CO)}_6\\ \\text{octahedral}",
   "note": {
    "en": "Mn₂(CO)₁₀ has a Mn–Mn bond; Co₂(CO)₈ has a Co–Co bond and two bridging CO."
   }
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "18-electron rule"
   },
   "tex": "\\text{valence e}^-(\\text{M}) + 2 \\times (\\text{no. of CO}) = 18",
   "note": {
    "en": "Fe(CO)₅, Cr(CO)₆, Ni(CO)₄ obey it; V(CO)₆ is 17e."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-chemistry-05-coordination-compounds.t6",
   "name": {
    "en": "Applications"
   },
   "tex": "\\text{EDTA (Ca}^{2+}\\text{/Mg}^{2+}\\text{ hardness), cisplatin, [RhCl(PPh}_3)_3]",
   "note": {
    "en": "Chlorophyll Mg, haemoglobin Fe, vitamin B₁₂ Co; Ni purified as Ni(CO)₄ (Mond); Ag/Au extracted as [M(CN)₂]⁻."
   }
  }
 ]
}
