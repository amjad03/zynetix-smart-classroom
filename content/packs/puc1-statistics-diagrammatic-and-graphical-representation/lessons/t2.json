   "problem": {
    "en": "Family A: Food 8000, Rent 5000, Education 3000, Others 4000. Family B: Food 9000, Rent 9000, Education 6000, Others 6000. Find the percentages and the cumulative percentages for a percentage bar diagram."
   },
   "steps": [
    {
     "en": "A total = 20,000. Percentages: 40, 25, 15, 20. Cumulative: 40, 65, 80, 100."
    },
    {
     "en": "B total = 30,000. Percentages: 30, 30, 20, 20. Cumulative: 30, 60, 80, 100."
    },
    {
     "en": "Draw two bars of height 100 and divide them at the cumulative percentages."
    }
   ],
   "answer": {
    "en": "A: 40, 65, 80, 100; B: 30, 60, 80, 100"
   },
