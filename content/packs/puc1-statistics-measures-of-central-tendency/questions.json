  "tags": []
 },
 {
  "id": "1t05-q18",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t5",
  "stem": {
   "en": "The harmonic mean of 2, 3 and 6 is:"
  },
  "options": [
   {
    "en": "11"
   },
   {
    "en": "3.67"
   },
   {
    "en": "3"
   },
   {
    "en": "1"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "HM = n/Σ(1/x) = 3/(1/2 + 1/3 + 1/6) = 3/1 = 3."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q19",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t5",
  "stem": {
   "en": "For two positive numbers, AM = 10 and GM = 8. Their HM is:"
