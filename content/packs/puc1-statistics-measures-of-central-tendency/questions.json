    "en": "34"
   },
   {
    "en": "42"
   },
   {
    "en": "39"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Mode = 3 Median − 2 Mean = 3 × 38 − 2 × 40 = 114 − 80 = 34."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
