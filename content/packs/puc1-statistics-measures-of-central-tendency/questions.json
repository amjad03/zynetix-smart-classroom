  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t5",
  "stem": {
   "en": "The geometric mean of 4 and 25 is:"
  },
  "options": [
   {
    "en": "29"
   },
   {
    "en": "14.5"
   },
   {
    "en": "10"
   },
   {
    "en": "100"
   }
  ],
