 {
  "id": "1t05-q11",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t3",
  "stem": {
   "en": "For a frequency distribution with open-end classes, the most suitable average is the:"
  },
  "options": [
   {
    "en": "Geometric mean"
   },
   {
    "en": "Harmonic mean"
   },
   {
    "en": "Median"
   },
   {
    "en": "Arithmetic mean"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "The median needs only the middle part of the distribution, so open ends do not matter. It is also not affected by extreme values."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q12",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t3",
  "stem": {
   "en": "In a distribution with N = 50, the median class is 30–40, the cumulative frequency before it is 20 and its frequency is 10. The median is:"
  },
  "options": [
   {
    "en": "25"
   },
   {
    "en": "35"
   },
   {
    "en": "30"
   },
   {
    "en": "40"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Median = L + (N/2 − cf)/f × h = 30 + (25 − 20)/10 × 10 = 35."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1t05-q13",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t4",
  "stem": {
   "en": "The mode of 2, 3, 5, 3, 7, 3, 5 is:"
  },
  "options": [
   {
    "en": "7"
   },
   {
    "en": "3"
   },
   {
    "en": "5"
   },
   {
    "en": "4"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "3 occurs three times, more often than any other value."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q14",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t4",
  "stem": {
   "en": "The modal class is 40–50 with frequency 20; the classes before and after it have frequencies 12 and 16. The mode is:"
  },
  "options": [
   {
    "en": "45"
   },
   {
    "en": "46.67"
   },
   {
    "en": "43.33"
   },
   {
    "en": "48"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Mode = L + (f₁ − f₀)/(2f₁ − f₀ − f₂) × h = 40 + (20 − 12)/(40 − 12 − 16) × 10 = 40 + 8/12 × 10 = 46.67."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [],
  "solution": [
   {
    "en": "Mode = L + (f₁ − f₀)/(2f₁ − f₀ − f₂) × h = 40 + (20 − 12)/(40 − 12 − 16) × 10 = 40 + 8/12 × 10 = 46.67."
   }
  ]
 },
 {
  "id": "1t05-q15",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t4",
  "stem": {
