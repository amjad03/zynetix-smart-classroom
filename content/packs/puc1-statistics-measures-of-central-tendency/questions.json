[
 {
  "id": "1t05-q01",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t1",
  "stem": {
   "en": "The arithmetic mean of 12, 15, 18, 21 and 24 is:"
  },
  "options": [
   {
    "en": "15"
   },
   {
    "en": "90"
   },
   {
    "en": "21"
   },
   {
    "en": "18"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "x̄ = Σx/n = 90/5 = 18."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q02",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t1",
  "stem": {
   "en": "Find the mean: x = 1, 2, 3, 4 with frequencies f = 3, 5, 8, 4."
  },
  "options": [
   {
    "en": "2.75"
   },
   {
    "en": "2.5"
   },
   {
    "en": "2.65"
   },
   {
    "en": "3"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Σfx = 3 + 10 + 24 + 16 = 53; N = 20; x̄ = 53/20 = 2.65."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q03",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t1",
  "stem": {
   "en": "In the step-deviation method of finding the mean, the deviation d is calculated as:"
  },
  "options": [
   {
    "en": "d = m − A"
   },
   {
    "en": "d = (m − A)/c"
   },
   {
    "en": "d = m/c − A"
   },
   {
    "en": "d = (A − m) × c"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "m = mid-value, A = assumed mean, c = class width; then x̄ = A + (Σfd/N) × c."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q04",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t1",
  "stem": {
   "en": "The mean of 10 observations is 25. Later it is found that one value 30 was wrongly read as 50. The correct mean is:"
  },
  "options": [
   {
    "en": "27"
   },
   {
    "en": "22"
   },
   {
    "en": "23"
   },
   {
    "en": "25"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Wrong Σx = 250. Correct Σx = 250 − 50 + 30 = 230. Correct mean = 230/10 = 23."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [],
  "solution": [
   {
    "en": "Wrong Σx = 250."
   },
   {
    "en": "Correct Σx = 250 − 50 + 30 = 230."
   },
   {
    "en": "Correct mean = 230/10 = 23."
   }
  ]
 },
 {
  "id": "1t05-q05",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t2",
  "stem": {
   "en": "The sum of the deviations of observations from their arithmetic mean is always:"
  },
  "options": [
   {
    "en": "Zero"
   },
   {
    "en": "Minimum but positive"
   },
   {
    "en": "Equal to N"
   },
   {
    "en": "Equal to the mean"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Σ(x − x̄) = Σx − n x̄ = 0, since n x̄ = Σx."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q06",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t2",
  "stem": {
   "en": "Group A has 30 students with mean marks 50; group B has 20 students with mean marks 60. The combined mean is:"
  },
  "options": [
   {
    "en": "55"
   },
   {
    "en": "110"
   },
   {
    "en": "54"
   },
   {
    "en": "56"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "x̄₁₂ = (30 × 50 + 20 × 60)/(30 + 20) = (1500 + 1200)/50 = 54."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1t05-q07",
  "chapterId": "puc1-statistics-05-measures-of-central-tendency",
  "topicId": "puc1-statistics-05-measures-of-central-tendency.t2",
  "stem": {
