[
 {
  "id": "2t09-q01",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t1",
  "stem": {
   "en": "Variation in output caused by a worn-out cutting tool is due to:"
  },
  "options": [
   {
    "en": "an assignable cause"
   },
   {
    "en": "random sampling error"
   },
   {
    "en": "a chance cause"
   },
   {
    "en": "natural variation of the process"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "A worn tool is a specific, identifiable cause that can be found and removed: an assignable cause."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q02",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t1",
  "stem": {
   "en": "The control limits of a Shewhart control chart are usually set at:"
  },
  "options": [
   {
    "en": "mean ± 2 standard errors"
   },
   {
    "en": "the largest and smallest observations"
   },
   {
    "en": "mean ± 1 standard error"
   },
   {
    "en": "mean ± 3 standard errors"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Shewhart charts use 3σ limits: CL ± 3 SE of the statistic plotted."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q03",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t1",
  "stem": {
   "en": "If a process is in control and the statistic is normally distributed, the proportion of points expected outside 3σ control limits is about:"
  },
  "options": [
   {
    "en": "4.55%"
   },
   {
    "en": "5%"
   },
   {
    "en": "1%"
   },
   {
    "en": "0.27%"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "P(|Z| > 3) = 0.0027 ≈ 0.27%. So a point outside the limits signals an assignable cause."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q04",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t1",
  "stem": {
   "en": "Product control is achieved mainly through:"
  },
  "options": [
   {
    "en": "X̄ and R charts"
   },
   {
    "en": "c charts"
   },
   {
    "en": "index numbers"
   },
   {
    "en": "acceptance sampling plans"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Process control uses control charts during production; product control inspects finished lots by acceptance sampling."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q05",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t1",
  "stem": {
   "en": "A process has mean 50 and s.d. 6. Samples of size 4 are taken. The 3σ control limits for the sample mean are:"
  },
  "options": [
   {
    "en": "44 and 56"
   },
   {
    "en": "41 and 59"
   },
   {
    "en": "32 and 68"
   },
   {
    "en": "47 and 53"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "SE(x̄) = 6/√4 = 3. Limits = 50 ± 3 × 3 = 41 and 59."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t09-q06",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t2",
  "stem": {
   "en": "For samples of size 5 (A₂ = 0.577), X̿ = 20 and R̄ = 5. The UCL of the X̄ chart is:"
  },
  "options": [
   {
    "en": "17.115"
   },
   {
    "en": "20.577"
   },
   {
    "en": "22.885"
   },
   {
    "en": "25.000"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "UCL = X̿ + A₂R̄ = 20 + 0.577 × 5 = 22.885."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q07",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t2",
  "stem": {
   "en": "For samples of size 5, D₃ = 0. The lower control limit of the R chart is:"
  },
  "options": [
   {
    "en": "R̄"
   },
   {
    "en": "−R̄"
   },
   {
    "en": "0"
   },
   {
    "en": "3R̄"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "LCL = D₃R̄ = 0 × R̄ = 0."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q08",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t2",
  "stem": {
   "en": "For samples of size 5 (D₄ = 2.114), R̄ = 5.8. The UCL of the R chart is about:"
  },
  "options": [
   {
    "en": "2.11"
   },
   {
    "en": "12.26"
   },
   {
    "en": "8.80"
   },
   {
    "en": "3.35"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "UCL = D₄R̄ = 2.114 × 5.8 = 12.26."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q09",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t2",
  "stem": {
   "en": "The X̄ chart and the R chart together control:"
  },
  "options": [
   {
    "en": "the level (mean) and the variability (range) of the process"
   },
   {
    "en": "the number of defects and the fraction defective"
   },
   {
    "en": "the lot quality after production"
   },
   {
    "en": "only the variability of the process"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "The X̄ chart watches the process average; the R chart watches its spread."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q10",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t2",
  "stem": {
   "en": "An X̄ chart (n = 5, A₂ = 0.577) has UCL = 47.55 and LCL = 40.85. Then X̿ and R̄ are:"
  },
  "options": [
   {
    "en": "X̿ = 44.2, R̄ = 3.35"
   },
   {
    "en": "X̿ = 6.69, R̄ = 5.8"
   },
   {
    "en": "X̿ = 44.2, R̄ = 11.6"
   },
   {
    "en": "X̿ = 44.2, R̄ = 5.8"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "X̿ = (UCL + LCL)/2 = 44.2. A₂R̄ = (UCL − LCL)/2 = 3.347, so R̄ = 3.347/0.577 = 5.8."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t09-q11",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t3",
  "stem": {
   "en": "A c chart is used to control:"
  },
  "options": [
   {
    "en": "the range of a sample"
   },
   {
    "en": "the mean of a measurable characteristic"
   },
   {
    "en": "the fraction defective in a sample"
   },
   {
    "en": "the number of defects per unit"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "c = number of defects in one unit (a sheet of glass, a bale of cloth). It follows a Poisson distribution."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q12",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t3",
  "stem": {
   "en": "For a c chart with c̄ = 4, the upper control limit is:"
  },
  "options": [
   {
    "en": "7"
   },
   {
    "en": "10"
   },
   {
    "en": "12"
   },
   {
    "en": "16"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "UCL = c̄ + 3√c̄ = 4 + 3 × 2 = 10."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q13",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t3",
  "stem": {
   "en": "For a p chart with p̄ = 0.1 and sample size n = 100, the UCL is:"
  },
  "options": [
   {
    "en": "0.19"
   },
   {
    "en": "0.10"
   },
   {
    "en": "0.40"
   },
   {
    "en": "0.13"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "UCL = p̄ + 3√(p̄q̄/n) = 0.1 + 3√(0.09/100) = 0.1 + 3 × 0.03 = 0.19."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q14",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t3",
  "stem": {
   "en": "Samples of 50 are inspected and p̄ = 0.08. The control limits of the np chart are about:"
  },
  "options": [
   {
    "en": "UCL = 7.00, LCL = 1.00"
   },
   {
    "en": "UCL = 9.75, LCL = −1.75"
   },
   {
    "en": "UCL = 9.75, LCL = 0"
   },
   {
    "en": "UCL = 0.20, LCL = 0"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "np̄ = 4; SE = √(np̄q̄) = √(4 × 0.92) = 1.918. UCL = 4 + 3 × 1.918 = 9.75; LCL = 4 − 5.75 < 0, taken as 0."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q15",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t3",
  "stem": {
   "en": "For a c chart, UCL = 18. The central line and the LCL are:"
  },
  "options": [
   {
    "en": "CL = 12, LCL = 6"
   },
   {
    "en": "CL = 9, LCL = 9"
   },
   {
    "en": "CL = 6, LCL = 0"
   },
   {
    "en": "CL = 9, LCL = 0"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "c̄ + 3√c̄ = 18. Put √c̄ = u: u² + 3u − 18 = 0, so u = 3, c̄ = 9. LCL = 9 − 9 = 0."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t09-q16",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t4",
  "stem": {
   "en": "Producer's risk is the probability of:"
  },
  "options": [
   {
    "en": "accepting a good lot"
   },
   {
    "en": "rejecting a lot of good (acceptable) quality"
   },
   {
    "en": "inspecting the whole lot"
   },
   {
    "en": "accepting a lot of bad quality"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "The producer loses when a good lot (quality at AQL) is rejected. Consumer's risk is accepting a bad lot (quality at LTPD)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q17",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t4",
  "stem": {
   "en": "An OC curve of a sampling plan shows:"
  },
  "options": [
   {
    "en": "the cost of inspection against lot size"
   },
   {
    "en": "the number of defects against the sample number"
   },
   {
    "en": "the probability of accepting a lot against the lot fraction defective"
   },
   {
    "en": "the control limits against sample size"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "The operating characteristic curve plots Pa against the lot quality p."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t09-q18",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t4",
  "stem": {
   "en": "A single sampling plan has n = 50 and c = 1. For a lot with 2% defectives, using the Poisson approximation (e⁻¹ = 0.3679), the probability of acceptance is about:"
  },
  "options": [
   {
    "en": "0.9800"
   },
   {
    "en": "0.2642"
   },
   {
    "en": "0.7358"
   },
   {
    "en": "0.3679"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "m = np = 50 × 0.02 = 1. Pa = P(d ≤ 1) = e⁻¹(1 + 1) = 2 × 0.3679 = 0.7358."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q19",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t4",
  "stem": {
   "en": "In a single sampling plan (N, n, c), the lot is accepted if the number of defectives d in the sample satisfies:"
  },
  "options": [
   {
    "en": "d ≥ c + n"
   },
   {
    "en": "d = n"
   },
   {
    "en": "d > c"
   },
   {
    "en": "d ≤ c"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Inspect n items; accept if d ≤ c, otherwise reject (and, in rectifying inspection, inspect the whole lot)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q20",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t4",
  "stem": {
   "en": "For the plan N = 1000, n = 50, c = 1 and a lot with Pa = 0.7358, the average total inspection ATI = n + (1 − Pa)(N − n) is about:"
  },
  "options": [
   {
    "en": "301"
   },
   {
    "en": "1000"
   },
   {
    "en": "749"
   },
   {
    "en": "50"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "ATI = 50 + (1 − 0.7358) × 950 = 50 + 251.0 ≈ 301."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t09-q21",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t2",
  "stem": {
   "en": "Ten samples of size 5 give Σx̄ = 442 and ΣR = 58. With A₂ = 0.577, the control limits of the X̄ chart are:"
  },
  "options": [
   {
    "en": "0 and 12.26"
   },
   {
    "en": "40.85 and 47.55"
   },
   {
    "en": "26.80 and 61.60"
   },
   {
    "en": "39.85 and 48.55"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "X̿ = 44.2, R̄ = 5.8; A₂R̄ = 3.347; limits 44.2 ± 3.35 = 40.85 and 47.55."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q22",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t3",
  "stem": {
   "en": "Twenty samples of 50 items gave a total of 100 defectives. The upper control limit of the p chart is about:"
  },
  "options": [
   {
    "en": "0.128"
   },
   {
    "en": "0.227"
   },
   {
    "en": "0.234"
   },
   {
    "en": "0.300"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "p̄ = 100/1000 = 0.1. UCL = 0.1 + 3√(0.1 × 0.9/50) = 0.1 + 3 × 0.0424 = 0.227."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t09-q23",
  "chapterId": "puc2-statistics-09-statistical-quality-control",
  "topicId": "puc2-statistics-09-statistical-quality-control.t4",
  "stem": {
   "en": "A double sampling plan: n₁ = 50, c₁ = 1; n₂ = 100, c₂ = 4. The first sample has 2 defectives and the second sample has 2 defectives. The decision is:"
  },
  "options": [
   {
    "en": "reject the lot after the second sample"
   },
   {
    "en": "accept the lot"
   },
   {
    "en": "reject the lot after the first sample"
   },
   {
    "en": "inspect a third sample"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "d₁ = 2 > c₁ = 1 but ≤ c₂ = 4, so a second sample is taken. d₁ + d₂ = 4 ≤ c₂ = 4: accept."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 }
]
