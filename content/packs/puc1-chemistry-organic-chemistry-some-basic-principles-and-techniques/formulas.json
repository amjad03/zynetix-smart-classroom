{
 "chapterId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t2",
   "name": {
    "en": "Degree of unsaturation"
   },
   "tex": "\\text{DBE} = C - \\frac{H}{2} - \\frac{X}{2} + \\frac{N}{2} + 1",
   "note": {
    "en": "Rings + π bonds."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t5",
   "name": {
    "en": "Hyperconjugation count"
   },
   "tex": "\\text{Structures} = \\text{no. of }\\alpha\\text{-H}",
   "note": {
    "en": "tert-Butyl cation: 9."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t3",
   "name": {
    "en": "Stereoisomers"
   },
   "tex": "N = 2^n",
   "note": {
    "en": "n chiral centres, no symmetry."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t3",
   "name": {
    "en": "Specific rotation"
   },
   "tex": "[\\alpha] = \\frac{\\alpha_{obs}}{l\\,c}",
   "note": {
    "en": "l in dm, c in g/mL."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Enantiomeric excess"
   },
   "tex": "ee = \\frac{|R - S|}{R + S}\\times100",
   "note": {
    "en": "Racemic: ee = 0."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t4",
   "name": {
    "en": "Carbocation stability"
   },
   "tex": "3^\\circ > 2^\\circ > 1^\\circ > \\text{CH}_3^+",
   "note": {
    "en": "Benzylic/allylic even more stable."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t1",
   "name": {
    "en": "Hybridisation from σ bonds + lone pairs"
   },
   "tex": "2 \\Rightarrow sp\\ (180^\\circ),\\quad 3 \\Rightarrow sp^2\\ (120^\\circ),\\quad 4 \\Rightarrow sp^3\\ (109.5^\\circ)",
   "note": {
    "en": "% s-character: sp 50, sp² 33, sp³ 25 — electronegativity of C rises with s-character."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t2",
   "name": {
    "en": "IUPAC suffix priority"
   },
   "tex": "-\\text{COOH} > -\\text{SO}_3\\text{H} > \\text{ester} > \\text{acid halide} > \\text{amide} > -\\text{CN} > -\\text{CHO} > \\text{C=O} > -\\text{OH} > -\\text{NH}_2",
   "note": {
    "en": "Halogens, –NO₂, –OR are always prefixes. Lowest locant to principal group, then multiple bonds, then substituents."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t2",
   "name": {
    "en": "Ene/yne locants"
   },
   "tex": "\\text{tie in lowest locants} \\Rightarrow \\text{double bond gets the lower number}",
   "note": {
    "en": "e.g. pent-1-en-4-yne."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t3",
   "name": {
    "en": "Structural isomerism"
   },
   "tex": "\\text{chain, position, functional group, metamerism}",
   "note": {
    "en": "C₄H₁₀O: 7 structural isomers (4 alcohols + 3 ethers)."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t4",
   "name": {
    "en": "Bond fission"
   },
   "tex": "\\text{homolytic} \\rightarrow \\text{free radicals};\\quad \\text{heterolytic} \\rightarrow \\text{carbocation} + \\text{carbanion (ions)}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t4",
   "name": {
    "en": "Geometry of intermediates"
   },
   "tex": "\\text{CH}_3^+: sp^2\\ (\\text{planar});\\quad \\text{CH}_3^-: sp^3\\ (\\text{pyramidal});\\quad \\dot{\\text{C}}\\text{H}_3: sp^2"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t4",
   "name": {
    "en": "Carbocation / free radical stability"
   },
   "tex": "\\text{benzyl} \\approx \\text{allyl} > 3^\\circ > 2^\\circ > 1^\\circ > \\text{CH}_3",
   "note": {
    "en": "Stabilised by resonance, hyperconjugation and +I groups. (C₆H₅)₃C⁺ is very stable."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t4",
   "name": {
    "en": "Carbanion stability"
   },
   "tex": "\\text{CH}_3^- > 1^\\circ > 2^\\circ > 3^\\circ",
   "note": {
    "en": "Stabilised by −I/−R groups (e.g. ⁻CH₂NO₂) and by higher s-character (HC≡C⁻)."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t5",
   "name": {
    "en": "Inductive effect order (−I)"
   },
   "tex": "-\\text{NO}_2 > -\\text{CN} > -\\text{COOH} > -\\text{F} > -\\text{Cl} > -\\text{Br} > -\\text{I} > -\\text{OCH}_3 > -\\text{OH} > -\\text{C}_6\\text{H}_5",
   "note": {
    "en": "Sources differ on where –COOH sits relative to –F; F > Cl > Br > I is certain. +I: (CH₃)₃C– > (CH₃)₂CH– > CH₃CH₂– > CH₃–. Permanent, decreases rapidly along the chain."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t2",
   "name": {
    "en": "Acid strength from −I"
   },
   "tex": "\\text{FCH}_2\\text{COOH} > \\text{ClCH}_2\\text{COOH} > \\text{BrCH}_2\\text{COOH} > \\text{CH}_3\\text{COOH} > \\text{CH}_3\\text{CH}_2\\text{COOH}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t5",
   "name": {
    "en": "Resonance (mesomeric) effect"
   },
   "tex": "+R: -\\text{OH}, -\\text{OR}, -\\text{NH}_2, -\\text{X};\\quad -R: -\\text{NO}_2, -\\text{CN}, -\\text{CHO}, -\\text{COOH}",
   "note": {
    "en": "Canonical structures are imaginary; the hybrid is more stable than any of them."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t2",
   "name": {
    "en": "Bond order from resonance"
   },
   "tex": "\\text{bond order} = \\dfrac{\\text{total bonds between the atoms}}{\\text{number of equivalent positions}}",
   "note": {
    "en": "CO₃²⁻: 4/3; carboxylate C–O: 1.5; benzene C–C: 1.5 (139 pm)."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t5",
   "name": {
    "en": "Hyperconjugation"
   },
   "tex": "\\text{no. of hyperconjugative structures} = \\text{no. of } \\alpha\\text{-H}",
   "note": {
    "en": "σ(C–H) → empty p or π*. (CH₃)₃C⁺ has 9 α-H; CH₃CH₂⁺ has 3."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t5",
   "name": {
    "en": "Electromeric effect"
   },
   "tex": "\\text{temporary; only multiple bonds; only in presence of reagent }(+E \\text{ or } -E)"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Purification methods"
   },
   "tex": "\\text{sublimation (camphor, naphthalene)};\\ \\text{reduced-pressure distillation (glycerol)};\\ \\text{steam distillation (aniline)}",
   "note": {
    "en": "Fractional distillation for close b.p. (crude oil); crystallisation by solubility difference."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Steam distillation"
   },
   "tex": "p_{\\text{atm}} = p_{\\text{organic}} + p_{\\text{water}}",
   "note": {
    "en": "Liquid distils below its own b.p.; must be steam-volatile and water-immiscible."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Retardation factor"
   },
   "tex": "R_f = \\dfrac{\\text{distance moved by substance}}{\\text{distance moved by solvent front}}",
   "note": {
    "en": "Paper chromatography = partition; TLC/column = adsorption. Less adsorbed component elutes first."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Lassaigne's test"
   },
   "tex": "\\text{N}: \\text{Fe}_4[\\text{Fe(CN)}_6]_3 \\text{ (Prussian blue)};\\ \\ \\text{S}: [\\text{Fe(CN)}_5\\text{NOS}]^{4-} \\text{ (violet)};\\ \\ \\text{N + S}: [\\text{Fe(SCN)}]^{2+} \\text{ (blood red)}",
   "note": {
    "en": "Halogens: AgCl white, AgBr pale yellow, AgI yellow (boil with HNO₃ first). Compounds without C (N₂H₄) fail the N test."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Phosphorus test"
   },
   "tex": "(\\text{NH}_4)_3\\text{PO}_4\\cdot12\\text{MoO}_3 \\ (\\text{yellow})"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Carbon and hydrogen (Liebig)"
   },
   "tex": "\\%\\text{C} = \\dfrac{12}{44}\\cdot\\dfrac{m_{\\text{CO}_2}}{m}\\times100,\\qquad \\%\\text{H} = \\dfrac{2}{18}\\cdot\\dfrac{m_{\\text{H}_2\\text{O}}}{m}\\times100"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Nitrogen — Dumas"
   },
   "tex": "\\%\\text{N} = \\dfrac{28}{22400}\\cdot\\dfrac{V_{\\text{STP}}}{m}\\times100,\\quad V_{\\text{STP}} = V\\,\\dfrac{(P - p_{\\text{aq}})}{760}\\cdot\\dfrac{273}{T}"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t2",
   "name": {
    "en": "Nitrogen — Kjeldahl"
   },
   "tex": "\\%\\text{N} = \\dfrac{1.4\\,M\\,V\\,(\\text{basicity})}{m}",
   "note": {
    "en": "M in mol L⁻¹, V in mL, m in g; basicity = 2 for H₂SO₄. Not for nitro, azo or ring N (pyridine)."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Halogen — Carius"
   },
   "tex": "\\%\\text{X} = \\dfrac{\\text{at. mass of X}}{\\text{mol. mass of AgX}}\\cdot\\dfrac{m_{\\text{AgX}}}{m}\\times100"
  },
  {
   "id": "zs-f30",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t6",
   "name": {
    "en": "Sulphur and phosphorus"
   },
   "tex": "\\%\\text{S} = \\dfrac{32}{233}\\cdot\\dfrac{m_{\\text{BaSO}_4}}{m}\\times100,\\qquad \\%\\text{P} = \\dfrac{62}{222}\\cdot\\dfrac{m_{\\text{Mg}_2\\text{P}_2\\text{O}_7}}{m}\\times100"
  },
  {
   "id": "zs-f31",
   "topicId": "puc1-chemistry-08-organic-chemistry-some-basic-principles-and-techniques.t3",
   "name": {
    "en": "Molecular formula"
   },
   "tex": "\\text{molecular formula} = n \\times \\text{empirical formula},\\quad n = \\dfrac{M}{\\text{empirical formula mass}}",
   "note": {
    "en": "% O is found by difference."
   }
  }
 ]
}
