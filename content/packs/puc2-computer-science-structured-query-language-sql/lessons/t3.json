  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Insert two students, correct one student's marks, and delete students with marks below 65."
   },
   "steps": [
    {
     "en": "INSERT INTO STUDENT VALUES (4, 'Kiran', 'M', 'Mangaluru', NULL);"
    },
    {
     "en": "INSERT INTO STUDENT VALUES (5, 'Arjun', 'M', 'Mysuru', 64);"
    },
    {
     "en": "UPDATE STUDENT SET Marks = 70 WHERE RollNo = 4;"
    },
    {
     "en": "DELETE FROM STUDENT WHERE Marks < 65;"
    }
   ],
   "answer": {
    "en": "Kiran's marks become 70; Arjun (64) is deleted; Kiran stays."
   },
   "narration": {
    "en": "Let us work through this together. Insert two students, correct one student's marks, and delete students with marks below 65."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Table T(ID INT PRIMARY KEY, Name VARCHAR(20) NOT NULL, Fee INT DEFAULT 1000). Predict the result of each statement."
   },
   "steps": [
    {
     "en": "INSERT INTO T (ID, Name) VALUES (1, 'X');  → row (1, 'X', 1000): Fee takes its DEFAULT."
    },
    {
     "en": "INSERT INTO T (ID) VALUES (2);  → error: Name violates NOT NULL."
    },
    {
     "en": "INSERT INTO T VALUES (1, 'Y', 500);  → error: duplicate primary key 1."
    }
   ],
   "answer": {
    "en": "Only the first insert succeeds; T has one row (1, 'X', 1000)."
   },
   "narration": {
    "en": "Let us work through this together. Table T(ID INT PRIMARY KEY, Name VARCHAR(20) NOT NULL, Fee INT DEFAULT 1000). Predict the result of each statement."
   }
