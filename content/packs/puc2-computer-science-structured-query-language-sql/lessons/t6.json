   "problem": {
    "en": "DANCE(SNo, Name, Class) has (1, Aastha, 7A), (2, Mahira, 6A), (3, Mohit, 7B), (4, Sanjay, 7A). MUSIC has (1, Mehak, 8A), (2, Mahira, 6A), (3, Lavanya, 7A), (4, Sanjay, 7A), (5, Abhay, 8A). Find who is in both clubs, and the size of DANCE × MUSIC."
   },
   "steps": [
    {
     "en": "SELECT Name, Class FROM DANCE INTERSECT SELECT Name, Class FROM MUSIC;"
    },
    {
     "en": "Common (Name, Class) pairs: (Mahira, 6A) and (Sanjay, 7A)."
    },
    {
     "en": "SELECT Name, Class FROM DANCE EXCEPT SELECT Name, Class FROM MUSIC; gives Aastha 7A and Mohit 7B (MINUS in the textbook)."
    },
    {
     "en": "DANCE × MUSIC: degree 3 + 3 = 6, cardinality 4 × 5 = 20."
    }
   ],
