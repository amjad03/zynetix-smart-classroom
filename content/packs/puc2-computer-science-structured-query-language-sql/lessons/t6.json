  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "UNION, INTERSECT, MINUS and Cartesian product"
   },
   "body": {
    "en": "Set operations need union-compatible relations (same number of attributes, matching domains). UNION gives tuples in either relation, without duplicates. INTERSECT gives tuples common to both. MINUS (EXCEPT in standard SQL) gives tuples in the first but not in the second. The Cartesian product pairs every tuple of one relation with every tuple of the other: its degree is the sum and its cardinality is the product."
   },
   "points": [
    {
     "en": "UNION: in A or B"
    },
    {
     "en": "INTERSECT: in both"
    },
    {
     "en": "MINUS / EXCEPT: in A, not in B"
    },
    {
     "en": "A × B: degree = d₁ + d₂, cardinality = n₁ × n₂"
    }
   ],
   "narration": {
    "en": "UNION combines, INTERSECT keeps common tuples, MINUS keeps tuples only in the first. A Cartesian product adds degrees and multiplies cardinalities.",
    "kn": "UNION ಸಂಯೋಜಿಸುತ್ತದೆ, INTERSECT ಸಾಮಾನ್ಯ ಟ್ಯೂಪಲ್ ಉಳಿಸುತ್ತದೆ, MINUS ಮೊದಲದರಲ್ಲಿ ಮಾತ್ರ ಇರುವವು. ಕಾರ್ಟೀಸಿಯನ್ ಗುಣಲಬ್ಧದಲ್ಲಿ ಡಿಗ್ರಿ ಕೂಡುತ್ತವೆ, ಕಾರ್ಡಿನಾಲಿಟಿ ಗುಣಿಸುತ್ತವೆ."
   },
   "formula": "\\text{degree}(A\\times B)=d_A+d_B,\\quad \\text{cardinality}(A\\times B)=n_A\\times n_B"
  },
