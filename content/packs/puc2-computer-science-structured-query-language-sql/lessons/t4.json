 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Asking questions of the data",
    "kn": "ದತ್ತಾಂಶಕ್ಕೆ ಪ್ರಶ್ನೆ ಕೇಳುವುದು"
   },
   "hook": {
    "en": "Who scored above 75? Which students are from Mysuru? Whose marks are missing? One command, SELECT, answers all of these.",
    "kn": "75 ಕ್ಕಿಂತ ಹೆಚ್ಚು ಅಂಕ ಯಾರು ಪಡೆದರು? ಮೈಸೂರಿನವರು ಯಾರು? ಯಾರ ಅಂಕ ಇಲ್ಲ? SELECT ಎಂಬ ಒಂದೇ ಆಜ್ಞೆ ಇವೆಲ್ಲಕ್ಕೂ ಉತ್ತರಿಸುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Write SELECT with WHERE, relational and logical operators"
    },
    {
     "en": "Use DISTINCT, BETWEEN, IN, LIKE, IS NULL"
    },
    {
     "en": "Sort with ORDER BY"
    }
   ],
   "narration": {
    "en": "Who scored above 75? Which students are from Mysuru? Whose marks are missing? One command, SELECT, answers all of these.",
    "kn": "75 ಕ್ಕಿಂತ ಹೆಚ್ಚು ಅಂಕ ಯಾರು ಪಡೆದರು? ಮೈಸೂರಿನವರು ಯಾರು? ಯಾರ ಅಂಕ ಇಲ್ಲ? SELECT ಎಂಬ ಒಂದೇ ಆಜ್ಞೆ ಇವೆಲ್ಲಕ್ಕೂ ಉತ್ತರಿಸುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "SELECT ... FROM ... WHERE"
   },
   "body": {
    "en": "SELECT columns FROM table WHERE condition; returns matching rows; SELECT * returns all columns. Conditions use relational operators (=, <, >, <=, >=, <> or !=) and logical operators (AND, OR, NOT). DISTINCT removes duplicate rows. A column alias renames a column in the output: SELECT SName AS Name."
   },
   "points": [
    {
     "en": "* = all columns"
    },
    {
     "en": "Relational: = < > <= >= <>"
    },
    {
     "en": "Logical: AND, OR, NOT"
    },
    {
     "en": "DISTINCT removes duplicates; AS gives an alias"
    }
   ],
   "narration": {
    "en": "SELECT picks columns, FROM names the table, and WHERE keeps only rows that satisfy the condition.",
    "kn": "SELECT ಕಾಲಂಗಳನ್ನು ಆರಿಸುತ್ತದೆ, FROM ಕೋಷ್ಟಕ ಹೆಸರಿಸುತ್ತದೆ, WHERE ಷರತ್ತು ಪೂರೈಸುವ ಸಾಲುಗಳನ್ನು ಮಾತ್ರ ಉಳಿಸುತ್ತದೆ."
   }
  },
