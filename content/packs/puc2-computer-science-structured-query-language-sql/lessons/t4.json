   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "BETWEEN, IN, LIKE, NULL and ORDER BY"
   },
   "body": {
    "en": "BETWEEN a AND b includes both ends. IN (list) matches any value in the list. LIKE matches patterns: % stands for zero or more characters, _ for exactly one character. NULL is tested with IS NULL or IS NOT NULL, never with =. ORDER BY column sorts the result, ascending by default; add DESC for descending."
   },
   "points": [
    {
     "en": "BETWEEN is inclusive"
    },
    {
     "en": "LIKE: % = any number of chars, _ = one char"
    },
    {
     "en": "IS NULL / IS NOT NULL"
    },
    {
     "en": "ORDER BY ... ASC | DESC"
    }
   ],
   "narration": {
    "en": "BETWEEN includes both ends, IN matches a list, LIKE matches patterns with percent and underscore, NULL needs IS NULL, and ORDER BY sorts.",
    "kn": "BETWEEN ಎರಡೂ ತುದಿಗಳನ್ನು ಒಳಗೊಳ್ಳುತ್ತದೆ, IN ಪಟ್ಟಿಗೆ ಹೊಂದಿಸುತ್ತದೆ, LIKE % ಮತ್ತು _ ಬಳಸಿ ಮಾದರಿ ಹುಡುಕುತ್ತದೆ, NULL ಗೆ IS NULL ಬೇಕು, ORDER BY ವಿಂಗಡಿಸುತ್ತದೆ."
   }
  },
