  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "How much should the firm produce?",
    "kn": "ಸಂಸ್ಥೆ ಎಷ್ಟು ಉತ್ಪಾದಿಸಬೇಕು?"
   },
   "hook": {
    "en": "Producing one more crate adds ₹12 to revenue. If it adds only ₹10 to cost, produce it. If it adds ₹14, do not. That is profit maximisation in one line.",
    "kn": "ಇನ್ನೊಂದು ಕ್ರೇಟ್ ಆದಾಯಕ್ಕೆ ₹12 ಸೇರಿಸುತ್ತದೆ. ವೆಚ್ಚಕ್ಕೆ ₹10 ಮಾತ್ರ ಸೇರಿಸಿದರೆ ಉತ್ಪಾದಿಸಿ; ₹14 ಸೇರಿಸಿದರೆ ಬೇಡ. ಇದೇ ಲಾಭ ಗರಿಷ್ಠೀಕರಣ."
   },
   "objectives": [
    {
     "en": "State the three conditions for profit maximisation"
    },
    {
     "en": "Find the profit-maximising output from a table"
    },
    {
     "en": "Show profit on a diagram"
    }
   ],
   "narration": {
    "en": "Producing one more crate adds ₹12 to revenue. If it adds only ₹10 to cost, produce it. If it adds ₹14, do not. That is profit maximisation in one line.",
    "kn": "ಇನ್ನೊಂದು ಕ್ರೇಟ್ ಆದಾಯಕ್ಕೆ ₹12 ಸೇರಿಸುತ್ತದೆ. ವೆಚ್ಚಕ್ಕೆ ₹10 ಮಾತ್ರ ಸೇರಿಸಿದರೆ ಉತ್ಪಾದಿಸಿ; ₹14 ಸೇರಿಸಿದರೆ ಬೇಡ. ಇದೇ ಲಾಭ ಗರಿಷ್ಠೀಕರಣ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Conditions for profit maximisation"
   },
   "body": {
    "en": "Profit is $\\pi = TR - TC$. A competitive firm maximises profit at output $q_0$ where: (1) price equals marginal cost, $p = MC$; (2) MC is non-decreasing (rising) at $q_0$; (3) in the short run, price is at least the minimum AVC; in the long run, price is at least the minimum LRAC. If p > MC, producing more raises profit; if p < MC, producing less raises profit."
   },
   "points": [
    {
     "en": "1: p = MC"
    },
    {
     "en": "2: MC rising at that output"
    },
    {
     "en": "3: SR p ≥ min AVC; LR p ≥ min LRAC"
    }
   ],
   "narration": {
    "en": "A competitive firm maximises profit where price equals marginal cost, with marginal cost rising, and with price covering minimum AVC in the short run.",
    "kn": "ಬೆಲೆ = ಸೀಮಾಂತ ವೆಚ್ಚ, ಸೀಮಾಂತ ವೆಚ್ಚ ಏರುತ್ತಿರುವುದು, ಮತ್ತು ಅಲ್ಪಾವಧಿಯಲ್ಲಿ ಬೆಲೆ ಕನಿಷ್ಠ AVC ಗಿಂತ ಕಡಿಮೆ ಇಲ್ಲದಿರುವುದು – ಇವು ಲಾಭ ಗರಿಷ್ಠೀಕರಣದ ಷರತ್ತುಗಳು."
   },
   "formula": "\\pi = TR - TC,\\quad p = MC"
  },
