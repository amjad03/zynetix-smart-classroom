{
 "chapterId": "puc1-maths-03-trigonometric-functions",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-03-trigonometric-functions.t2",
   "name": {
    "en": "Pythagorean identity"
   },
   "tex": "\\sin^2\\theta + \\cos^2\\theta = 1",
   "note": {
    "en": "1 + tan²θ = sec²θ."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Compound angle"
   },
   "tex": "\\sin(A\\pm B) = \\sin A\\cos B \\pm \\cos A\\sin B",
   "note": {
    "en": "cos(A ± B) = cosAcosB ∓ sinAsinB."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-03-trigonometric-functions.t5",
   "name": {
    "en": "Double angle"
   },
   "tex": "\\cos2\\theta = 1 - 2\\sin^2\\theta = \\frac{1 - \\tan^2\\theta}{1 + \\tan^2\\theta}",
   "note": {
    "en": "sin2θ = 2 sinθ cosθ."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-03-trigonometric-functions.t5",
   "name": {
    "en": "Triple angle"
   },
   "tex": "\\sin3\\theta = 3\\sin\\theta - 4\\sin^3\\theta",
   "note": {
    "en": "cos3θ = 4cos³θ − 3cosθ."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-03-trigonometric-functions.t3",
   "name": {
    "en": "Range of a sinθ + b cosθ"
   },
   "tex": "[-\\sqrt{a^2 + b^2},\\ \\sqrt{a^2 + b^2}]",
   "note": {
    "en": "Frequently asked max/min."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-03-trigonometric-functions.t2",
   "name": {
    "en": "General solution"
   },
   "tex": "\\sin\\theta = \\sin\\alpha \\Rightarrow \\theta = n\\pi + (-1)^n\\alpha",
   "note": {
    "en": "cos: 2nπ ± α; tan: nπ + α."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Sine rule"
   },
   "tex": "\\frac{a}{\\sin A} = \\frac{b}{\\sin B} = \\frac{c}{\\sin C} = 2R",
   "note": {
    "en": "R = circumradius."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Cosine rule"
   },
   "tex": "\\cos A = \\frac{b^2 + c^2 - a^2}{2bc}",
   "note": {
    "en": "Area = ½bc sin A."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-maths-03-trigonometric-functions.t1",
   "name": {
    "en": "Radian–degree"
   },
   "tex": "\\pi\\ \\text{rad} = 180^\\circ;\\ \\ 1' = \\left(\\tfrac1{60}\\right)^\\circ;\\ \\ l = r\\theta\\ (\\theta \\text{ in radians})"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-03-trigonometric-functions.t2",
   "name": {
    "en": "Signs (ASTC)"
   },
   "tex": "\\text{I: all} > 0;\\ \\text{II: } \\sin;\\ \\text{III: } \\tan;\\ \\text{IV: } \\cos"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Allied angles"
   },
   "tex": "\\sin(\\pi-x) = \\sin x,\\ \\cos(\\pi-x) = -\\cos x,\\ \\sin(\\tfrac\\pi2+x) = \\cos x,\\ \\tan(\\pi+x) = \\tan x"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Compound angles"
   },
   "tex": "\\sin(A\\pm B) = \\sin A\\cos B\\pm\\cos A\\sin B,\\ \\cos(A\\pm B) = \\cos A\\cos B\\mp\\sin A\\sin B"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-03-trigonometric-functions.t2",
   "name": {
    "en": "tan of a sum"
   },
   "tex": "\\tan(A\\pm B) = \\frac{\\tan A\\pm\\tan B}{1\\mp\\tan A\\tan B}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-03-trigonometric-functions.t5",
   "name": {
    "en": "Double angle"
   },
   "tex": "\\sin2x = 2\\sin x\\cos x = \\frac{2\\tan x}{1+\\tan^2x},\\ \\cos2x = 1-2\\sin^2x = 2\\cos^2x-1 = \\frac{1-\\tan^2x}{1+\\tan^2x}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-03-trigonometric-functions.t5",
   "name": {
    "en": "Triple angle"
   },
   "tex": "\\sin3x = 3\\sin x-4\\sin^3x,\\ \\cos3x = 4\\cos^3x-3\\cos x,\\ \\tan3x = \\frac{3\\tan x-\\tan^3x}{1-3\\tan^2x}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-maths-03-trigonometric-functions.t2",
   "name": {
    "en": "Half angle"
   },
   "tex": "\\sin^2\\tfrac x2 = \\tfrac{1-\\cos x}2,\\ \\cos^2\\tfrac x2 = \\tfrac{1+\\cos x}2,\\ \\tan\\tfrac x2 = \\tfrac{1-\\cos x}{\\sin x}",
   "note": {
    "en": "Fix the sign from the quadrant of x/2."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-maths-03-trigonometric-functions.t4",
   "name": {
    "en": "Sum to product"
   },
   "tex": "\\sin C+\\sin D = 2\\sin\\tfrac{C+D}2\\cos\\tfrac{C-D}2,\\ \\cos C+\\cos D = 2\\cos\\tfrac{C+D}2\\cos\\tfrac{C-D}2,\\ \\cos C-\\cos D = -2\\sin\\tfrac{C+D}2\\sin\\tfrac{C-D}2"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-maths-03-trigonometric-functions.t4",
   "name": {
    "en": "Product to sum"
   },
   "tex": "2\\sin A\\cos B = \\sin(A+B)+\\sin(A-B),\\ 2\\sin A\\sin B = \\cos(A-B)-\\cos(A+B)"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Squares"
   },
   "tex": "\\sin^2A-\\sin^2B = \\sin(A+B)\\sin(A-B) = \\cos^2B-\\cos^2A"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Special values"
   },
   "tex": "\\sin18^\\circ = \\tfrac{\\sqrt5-1}4,\\ \\cos36^\\circ = \\tfrac{\\sqrt5+1}4,\\ \\tan15^\\circ = 2-\\sqrt3,\\ \\tan22.5^\\circ = \\sqrt2-1"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Product of three"
   },
   "tex": "\\sin x\\sin(60^\\circ-x)\\sin(60^\\circ+x) = \\tfrac14\\sin3x;\\ \\text{same for cos};\\ \\tan x\\tan(60^\\circ-x)\\tan(60^\\circ+x) = \\tan3x"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Cosine doubling chain"
   },
   "tex": "\\cos A\\cos2A\\cos4A\\cdots\\cos2^{n-1}A = \\frac{\\sin2^nA}{2^n\\sin A}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-maths-03-trigonometric-functions.t3",
   "name": {
    "en": "Range of a sin x + b cos x"
   },
   "tex": "-\\sqrt{a^2+b^2}\\le a\\sin x+b\\cos x\\le\\sqrt{a^2+b^2}"
  },
  {
   "id": "zs-f24",
   "name": {
    "en": "Powers"
   },
   "tex": "\\sin^4x+\\cos^4x = 1-\\tfrac12\\sin^22x,\\ \\sin^6x+\\cos^6x = 1-\\tfrac34\\sin^22x"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-maths-03-trigonometric-functions.t3",
   "name": {
    "en": "Periods"
   },
   "tex": "\\sin x, \\cos x: 2\\pi;\\ \\tan x: \\pi;\\ f(kx): \\tfrac{T}{|k|};\\ |\\sin x|+|\\cos x|: \\tfrac\\pi2"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "General solutions"
   },
   "tex": "\\sin x = \\sin\\alpha\\Rightarrow x = n\\pi+(-1)^n\\alpha;\\ \\cos x = \\cos\\alpha\\Rightarrow x = 2n\\pi\\pm\\alpha;\\ \\tan x = \\tan\\alpha\\Rightarrow x = n\\pi+\\alpha"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Zeros"
   },
   "tex": "\\sin x = 0\\iff x = n\\pi;\\ \\cos x = 0\\iff x = (2n+1)\\tfrac\\pi2;\\ \\sin^2x = \\sin^2\\alpha\\iff x = n\\pi\\pm\\alpha"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-maths-03-trigonometric-functions.t2",
   "name": {
    "en": "Triangle identities (A + B + C = π)"
   },
   "tex": "\\tan A+\\tan B+\\tan C = \\tan A\\tan B\\tan C;\\ \\sum\\tan\\tfrac A2\\tan\\tfrac B2 = 1;\\ \\sum\\sin2A = 4\\prod\\sin A",
   "note": {
    "en": "Also cos A + cos B + cos C = 1 + 4 Π sin(A/2)."
   }
  },
  {
   "id": "zs-f29",
   "name": {
    "en": "Solving equations"
   },
   "tex": "\\text{factor, never cancel a factor that can be } 0;\\ \\text{check } \\cos x\\ne0 \\text{ when tan or sec appears}"
  }
 ]
}
