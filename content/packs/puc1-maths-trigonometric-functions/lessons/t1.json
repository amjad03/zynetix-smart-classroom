   "heading": {
    "en": "A new unit for angles",
    "kn": "ಕೋನಕ್ಕೆ ಹೊಸ ಅಳತೆ"
   },
   "hook": {
    "en": "Wrap the radius of a wheel along its rim. The angle it covers at the centre is one radian, a little over 57 degrees.",
    "kn": "ಚಕ್ರದ ತ್ರಿಜ್ಯವನ್ನು ಅದರ ಅಂಚಿನ ಮೇಲೆ ಸುತ್ತಿ. ಕೇಂದ್ರದಲ್ಲಿ ಅದು ಉಂಟುಮಾಡುವ ಕೋನವೇ ಒಂದು ರೇಡಿಯನ್, ಸುಮಾರು 57 ಡಿಗ್ರಿ."
   },
   "objectives": [
    {
     "en": "Measure angles in degrees and radians"
    },
    {
     "en": "Convert between them"
    },
    {
     "en": "Use l = rθ"
    }
   ],
   "narration": {
    "en": "Wrap the radius of a wheel along its rim. The angle it covers at the centre is one radian, a little over 57 degrees.",
    "kn": "ಚಕ್ರದ ತ್ರಿಜ್ಯವನ್ನು ಅದರ ಅಂಚಿನ ಮೇಲೆ ಸುತ್ತಿ. ಕೇಂದ್ರದಲ್ಲಿ ಅದು ಉಂಟುಮಾಡುವ ಕೋನವೇ ಒಂದು ರೇಡಿಯನ್, ಸುಮಾರು 57 ಡಿಗ್ರಿ."
   }
