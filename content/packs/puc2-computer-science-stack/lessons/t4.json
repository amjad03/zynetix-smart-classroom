  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Convert A * (B + C) − D / E to postfix, showing the stack."
   },
   "steps": [
    {
     "en": "A → output A; * → push: stack [*]; ( → push: [*, (]"
    },
    {
     "en": "B → AB; + → push (top is \"(\"): [*, (, +]; C → ABC"
    },
    {
     "en": ") → pop + until (: output ABC+, stack [*]"
    },
    {
     "en": "− → * has higher precedence, pop it: ABC+*; push −: [−]; D → ABC+*D"
    },
    {
     "en": "/ → higher than −, push: [−, /]; E → ABC+*DE; end → pop / and −"
    }
   ],
   "answer": {
    "en": "ABC+*DE/-"
   },
   "narration": {
    "en": "Let us convert step by step and write the stack after every symbol."
   }
  },
