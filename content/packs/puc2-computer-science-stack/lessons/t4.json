  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Algorithm: infix to postfix"
   },
   "body": {
    "en": "Scan the infix expression from left to right with an empty stack and an empty output string. An operand goes straight to the output. A left parenthesis is pushed. On a right parenthesis, pop operators to the output until the matching left parenthesis, which is discarded. On an operator, pop to the output every operator on top that has higher or equal precedence (stopping at a left parenthesis), then push the new operator. At the end, pop all remaining operators to the output."
   },
   "points": [
    {
     "en": "Operand → output"
    },
    {
     "en": "( → push; ) → pop until ("
    },
    {
     "en": "Operator → pop higher/equal precedence, then push"
    },
    {
     "en": "End → pop everything"
    }
   ],
   "narration": {
    "en": "Scan the infix expression from left to right with an empty stack and an empty output string. An operand goes straight to the output. A left parenthesis is pushed. On a right parenthesis, pop operators to the output until the matching left parenthesis, which is discarded. On an operator, pop to the output every operator on top that has higher or equal precedence (stopping at a left parenthesis), then push the new operator. At the end, pop all remaining operators to the output.",
    "kn": "ಎಡದಿಂದ ಬಲಕ್ಕೆ ಓದಿ. ಆಪರಾಂಡ್ ನೇರವಾಗಿ ಔಟ್‌ಪುಟ್‌ಗೆ. ( ಅನ್ನು PUSH. ) ಬಂದಾಗ ( ವರೆಗೆ POP. ಆಪರೇಟರ್ ಬಂದಾಗ ಹೆಚ್ಚು ಅಥವಾ ಸಮಾನ ಆದ್ಯತೆಯವನ್ನು POP ಮಾಡಿ ನಂತರ PUSH. ಕೊನೆಗೆ ಉಳಿದುದೆಲ್ಲ POP."
   }
  },
