  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Infix, prefix and postfix"
   },
   "body": {
    "en": "In infix notation the operator is placed between the operands (x + y). In prefix notation, also called Polish notation after the mathematician Jan Łukasiewicz, the operator comes before the operands (+xy). In postfix notation, or reverse Polish notation, it comes after them (xy+). Prefix and postfix need no parentheses, because the position of the operators fixes the order of evaluation."
   },
   "points": [
    {
     "en": "Infix: (x + y) * z"
    },
    {
     "en": "Prefix: * + x y z"
    },
    {
     "en": "Postfix: x y + z *"
    },
    {
     "en": "Precedence: * and / before + and −"
    }
   ],
   "narration": {
    "en": "In infix notation the operator is placed between the operands (x + y). In prefix notation, also called Polish notation after the mathematician Jan Łukasiewicz, the operator comes before the operands (+xy). In postfix notation, or reverse Polish notation, it comes after them (xy+). Prefix and postfix need no parentheses, because the position of the operators fixes the order of evaluation.",
    "kn": "ಇನ್‌ಫಿಕ್ಸ್: ಆಪರೇಟರ್ ಆಪರಾಂಡ್‌ಗಳ ನಡುವೆ (x + y). ಪ್ರಿಫಿಕ್ಸ್ (ಪೋಲಿಶ್): ಮೊದಲು (+xy). ಪೋಸ್ಟ್‌ಫಿಕ್ಸ್ (ರಿವರ್ಸ್ ಪೋಲಿಶ್): ನಂತರ (xy+). ಪ್ರಿಫಿಕ್ಸ್ ಮತ್ತು ಪೋಸ್ಟ್‌ಫಿಕ್ಸ್‌ಗೆ ಆವರಣ ಬೇಕಿಲ್ಲ."
   }
  },
