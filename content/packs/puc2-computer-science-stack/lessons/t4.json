  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Where does the operator go?",
    "kn": "ಆಪರೇಟರ್ ಎಲ್ಲಿ ಬರುತ್ತದೆ?"
   },
   "hook": {
    "en": "We write 3 + 4, but a calculator finds 3 4 + easier. Without brackets or precedence rules it knows exactly what to do next.",
    "kn": "ನಾವು 3 + 4 ಎಂದು ಬರೆಯುತ್ತೇವೆ, ಆದರೆ ಕ್ಯಾಲ್ಕುಲೇಟರ್‌ಗೆ 3 4 + ಸುಲಭ. ಆವರಣ ಅಥವಾ ಆದ್ಯತೆ ನಿಯಮಗಳಿಲ್ಲದೆ ಮುಂದೇನು ಎಂದು ಅದಕ್ಕೆ ತಿಳಿಯುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Write expressions in infix, prefix and postfix"
    },
    {
     "en": "Convert infix to postfix using a stack"
    },
    {
     "en": "Apply operator precedence during conversion"
    }
   ],
   "narration": {
    "en": "We write 3 + 4, but a calculator finds 3 4 + easier. Without brackets or precedence rules it knows exactly what to do next.",
    "kn": "ನಾವು 3 + 4 ಎಂದು ಬರೆಯುತ್ತೇವೆ, ಆದರೆ ಕ್ಯಾಲ್ಕುಲೇಟರ್‌ಗೆ 3 4 + ಸುಲಭ. ಆವರಣ ಅಥವಾ ಆದ್ಯತೆ ನಿಯಮಗಳಿಲ್ಲದೆ ಮುಂದೇನು ಎಂದು ಅದಕ್ಕೆ ತಿಳಿಯುತ್ತದೆ."
   }
