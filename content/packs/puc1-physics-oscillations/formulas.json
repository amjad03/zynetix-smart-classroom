{
 "chapterId": "puc1-physics-13-oscillations",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "SHM displacement"
   },
   "tex": "x = A\\sin(\\omega t + \\phi)",
   "note": {
    "en": "a = −ω²x."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-13-oscillations.t2",
   "name": {
    "en": "Speed in SHM"
   },
   "tex": "v = \\omega\\sqrt{A^2 - x^2}",
   "note": {
    "en": "Max ωA at mean position."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-13-oscillations.t3",
   "name": {
    "en": "Spring–mass period"
   },
   "tex": "T = 2\\pi\\sqrt{\\frac mk}",
   "note": {
    "en": "Independent of g."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-13-oscillations.t5",
   "name": {
    "en": "Simple pendulum"
   },
   "tex": "T = 2\\pi\\sqrt{\\frac Lg}",
   "note": {
    "en": "Small amplitudes only."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-13-oscillations.t2",
   "name": {
    "en": "Wave speed"
   },
   "tex": "v = f\\lambda",
   "note": {
    "en": "Speed set by the medium."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-13-oscillations.t5",
   "name": {
    "en": "Speed on a string"
   },
   "tex": "v = \\sqrt{\\frac{T}{\\mu}}",
   "note": {
    "en": "μ = mass per unit length."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Closed pipe harmonics"
   },
   "tex": "f_n = \\frac{(2n-1)v}{4L}",
   "note": {
    "en": "Only odd harmonics."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Doppler effect"
   },
   "tex": "f' = f\\,\\frac{v \\pm v_o}{v \\mp v_s}",
   "note": {
    "en": "Upper signs when approaching."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Beats"
   },
   "tex": "f_{beat} = |f_1 - f_2|",
   "note": {
    "en": "Audible if below ~10 Hz."
   }
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Period and frequency"
   },
   "tex": "T = \\dfrac1\\nu = \\dfrac{2\\pi}{\\omega}"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "SHM condition"
   },
   "tex": "F = -kx,\\qquad a = \\dfrac{d^2x}{dt^2} = -\\omega^2x,\\qquad \\omega = \\sqrt{k/m}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-13-oscillations.t2",
   "name": {
    "en": "Displacement"
   },
   "tex": "x = A\\cos(\\omega t + \\phi)\\ \\text{or}\\ A\\sin(\\omega t + \\phi)",
   "note": {
    "en": "ωt + φ is the phase; φ is the phase constant."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-13-oscillations.t3",
   "name": {
    "en": "Velocity"
   },
   "tex": "v = \\pm\\omega\\sqrt{A^2 - x^2},\\qquad v_{\\max} = \\omega A",
   "note": {
    "en": "Velocity leads displacement by π/2."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-13-oscillations.t2",
   "name": {
    "en": "Acceleration"
   },
   "tex": "a = -\\omega^2x,\\qquad a_{\\max} = \\omega^2A",
   "note": {
    "en": "Acceleration and displacement differ in phase by π."
   }
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Two-point data"
   },
   "tex": "\\omega^2 = \\dfrac{v_1^2 - v_2^2}{x_2^2 - x_1^2},\\qquad A^2 = \\dfrac{v_1^2x_2^2 - v_2^2x_1^2}{v_1^2 - v_2^2}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-13-oscillations.t4",
   "name": {
    "en": "Energy in SHM"
   },
   "tex": "K = \\tfrac12m\\omega^2(A^2 - x^2),\\quad U = \\tfrac12m\\omega^2x^2,\\quad E = \\tfrac12kA^2",
   "note": {
    "en": "K and U oscillate at 2ν; ⟨K⟩ = ⟨U⟩ = E/2. K = U at x = A/√2."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-13-oscillations.t2",
   "name": {
    "en": "SHM and uniform circular motion"
   },
   "tex": "x = A\\cos(\\omega t + \\phi)\\ \\text{is the projection of a point on a circle of radius } A"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Superposition of same-frequency SHMs"
   },
   "tex": "A = \\sqrt{A_1^2 + A_2^2 + 2A_1A_2\\cos\\phi},\\qquad \\tan\\delta = \\dfrac{A_2\\sin\\phi}{A_1 + A_2\\cos\\phi}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-13-oscillations.t3",
   "name": {
    "en": "Spring–block"
   },
   "tex": "T = 2\\pi\\sqrt{m/k}",
   "note": {
    "en": "Same for a vertical spring: T = 2π√(Δl/g), Δl = static extension."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-physics-13-oscillations.t3",
   "name": {
    "en": "Springs in series and parallel"
   },
   "tex": "\\dfrac1{k_s} = \\dfrac1{k_1} + \\dfrac1{k_2},\\qquad k_p = k_1 + k_2"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-13-oscillations.t3",
   "name": {
    "en": "Cutting a spring"
   },
   "tex": "kL = \\text{constant}",
   "note": {
    "en": "A piece of length L/n has constant nk."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-13-oscillations.t1",
   "name": {
    "en": "Two bodies joined by a spring"
   },
   "tex": "T = 2\\pi\\sqrt{\\mu/k},\\qquad \\mu = \\dfrac{m_1m_2}{m_1 + m_2}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-physics-13-oscillations.t5",
   "name": {
    "en": "Simple pendulum"
   },
   "tex": "T = 2\\pi\\sqrt{L/g}",
   "note": {
    "en": "Small angles only; independent of mass and amplitude."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-13-oscillations.t5",
   "name": {
    "en": "Pendulum in accelerating frames"
   },
   "tex": "T = 2\\pi\\sqrt{L/g_{\\text{eff}}};\\ \\ g_{\\text{eff}} = g \\pm a\\ (\\text{lift up/down}),\\ \\sqrt{g^2 + a^2}\\ (\\text{horizontal})"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-physics-13-oscillations.t3",
   "name": {
    "en": "Physical (compound) pendulum"
   },
   "tex": "T = 2\\pi\\sqrt{\\dfrac{I}{mgd}}",
   "note": {
    "en": "Rod pivoted at an end: T = 2π√(2L/3g)."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-physics-13-oscillations.t4",
   "name": {
    "en": "Liquid in a U-tube"
   },
   "tex": "T = 2\\pi\\sqrt{\\dfrac{L}{2g}}",
   "note": {
    "en": "L = total length of the liquid column."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-physics-13-oscillations.t1",
   "name": {
    "en": "Floating body"
   },
   "tex": "T = 2\\pi\\sqrt{\\dfrac hg}",
   "note": {
    "en": "h = submerged depth at equilibrium."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-physics-13-oscillations.t4",
   "name": {
    "en": "Tunnel through the Earth"
   },
   "tex": "T = 2\\pi\\sqrt{R/g} \\approx 84\\ \\text{min}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-physics-13-oscillations.t4",
   "name": {
    "en": "SHM from a potential"
   },
   "tex": "k_{\\text{eff}} = \\left.\\dfrac{d^2U}{dx^2}\\right|_{x_0},\\qquad \\left.\\dfrac{dU}{dx}\\right|_{x_0} = 0"
  },
  {
   "id": "zs-f30",
   "topicId": "puc1-physics-13-oscillations.t5",
   "name": {
    "en": "Seconds pendulum"
   },
   "tex": "T = 2\\ \\text{s},\\qquad L \\approx 0.99\\ \\text{m}\\ (g = 9.8\\ \\text{m s}^{-2})"
  }
 ]
}
