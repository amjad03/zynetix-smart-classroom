{
 "chapterId": "puc1-biology-10-cell-cycle-and-cell-division",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t1",
   "name": {
    "en": "Cycle duration"
   },
   "tex": "\\text{human cell} \\approx 24\\ \\text{h};\\ \\text{yeast} \\approx 90\\ \\text{min}",
   "note": {
    "en": "M phase ≈ 1 h; interphase > 95% of the cycle."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t1",
   "name": {
    "en": "Phases"
   },
   "tex": "G_1 \\to S \\to G_2 \\to M",
   "note": {
    "en": "G0: quiescent (e.g. heart cells), exit from G1."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t1",
   "name": {
    "en": "S phase"
   },
   "tex": "\\text{DNA}: 2C \\to 4C;\\ \\text{chromosome number unchanged } (2n)",
   "note": {
    "en": "Centriole duplicates in cytoplasm (animal cells)."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Mitosis location"
   },
   "tex": "\\text{animals: diploid somatic cells};\\ \\text{plants: haploid and diploid}"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Prophase"
   },
   "tex": "\\text{condensation; centrosomes to poles; Golgi, ER, nucleolus, envelope disappear}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t2",
   "name": {
    "en": "Metaphase"
   },
   "tex": "\\text{chromosomes at metaphase plate; spindle on kinetochores}",
   "note": {
    "en": "Best stage to study chromosome morphology."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Anaphase"
   },
   "tex": "\\text{centromeres split; chromatids} \\to \\text{poles}"
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Telophase"
   },
   "tex": "\\text{decondensation; envelope, nucleolus, Golgi, ER reform}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t3",
   "name": {
    "en": "Cytokinesis"
   },
   "tex": "\\text{animal: furrow};\\ \\text{plant: cell plate (centre} \\to \\text{periphery)}",
   "note": {
    "en": "Syncytium if karyokinesis without cytokinesis — coconut liquid endosperm."
   }
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Chromosome / chromatid count"
   },
   "tex": "\\text{metaphase: } 2n\\ \\text{chromosomes}, 4n\\ \\text{chromatids};\\ \\text{anaphase: } 4n\\ \\text{chromosomes}"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Meiosis"
   },
   "tex": "\\text{2 divisions},\\ 1\\ \\text{DNA replication} \\to 4\\ \\text{haploid cells}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t4",
   "name": {
    "en": "Prophase I"
   },
   "tex": "\\text{leptotene} \\to \\text{zygotene} \\to \\text{pachytene} \\to \\text{diplotene} \\to \\text{diakinesis}",
   "note": {
    "en": "Zygotene: synapsis, synaptonemal complex, bivalent. Pachytene: recombination nodules, crossing over (recombinase). Diplotene: chiasmata; can last months–years in vertebrate oocytes. Diakinesis: terminalisation."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t4",
   "name": {
    "en": "Meiosis I vs II"
   },
   "tex": "\\text{A-I: homologues separate};\\ \\text{A-II: centromeres split}",
   "note": {
    "en": "Interkinesis: short, no DNA replication."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-10-cell-cycle-and-cell-division.t4",
   "name": {
    "en": "DNA content through meiosis"
   },
   "tex": "2C\\ (G_1) \\to 4C\\ (G_2) \\to 2C\\ (\\text{after M-I}) \\to C\\ (\\text{after M-II})"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Meioses needed"
   },
   "tex": "\\text{pollen} = \\tfrac{N}{4};\\ \\text{functional megaspores} = N",
   "note": {
    "en": "One microspore mother cell → 4 pollen; one megaspore mother cell → 1 functional megaspore."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Significance"
   },
   "tex": "\\text{mitosis: growth, repair, N/C ratio};\\ \\text{meiosis: constant chromosome number, variation}"
  }
 ]
}
