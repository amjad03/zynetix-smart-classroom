{
 "chapterId": "puc1-biology-09-biomolecules",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-09-biomolecules.t1",
   "name": {
    "en": "Chemical analysis"
   },
   "tex": "\\text{tissue} + \\text{Cl}_3\\text{CCOOH} \\to \\text{acid-soluble pool (filtrate)} + \\text{acid-insoluble (retentate)}",
   "note": {
    "en": "Ash = inorganic elements after burning."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-09-biomolecules.t1",
   "name": {
    "en": "Elements: crust vs body (% wt)"
   },
   "tex": "\\text{C}: 0.03 \\text{ vs } 18.5;\\ \\text{O}: 46.6 \\text{ vs } 65.0;\\ \\text{Si}: 27.7 \\text{ vs negligible}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-09-biomolecules.t2",
   "name": {
    "en": "Cell composition"
   },
   "tex": "\\text{water } 70\\text{–}90\\%,\\ \\text{protein } 10\\text{–}15,\\ \\text{nucleic acid } 5\\text{–}7,\\ \\text{carbohydrate } 3,\\ \\text{lipid } 2,\\ \\text{ions } 1"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-09-biomolecules.t1",
   "name": {
    "en": "Amino acid"
   },
   "tex": "\\text{H}_2\\text{N–C}_\\alpha\\text{H(R)–COOH}",
   "note": {
    "en": "R: H (glycine), CH₃ (alanine), CH₂OH (serine). Acidic: glutamic acid; basic: lysine; neutral: valine; aromatic: Tyr, Phe, Trp. Zwitterion at a particular pH."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-09-biomolecules.t1",
   "name": {
    "en": "Fatty acids"
   },
   "tex": "\\text{palmitic } \\text{C}_{16};\\ \\text{arachidonic } \\text{C}_{20}\\ (\\text{incl. COOH carbon})",
   "note": {
    "en": "Glycerol = trihydroxy propane. Oils: lower melting point (gingelly oil). Lecithin = phospholipid."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-09-biomolecules.t3",
   "name": {
    "en": "Nucleosides and nucleotides"
   },
   "tex": "\\text{base} + \\text{sugar} = \\text{nucleoside};\\ + \\text{phosphate} = \\text{nucleotide}",
   "note": {
    "en": "Adenosine vs adenylic acid. Purines: A, G. Pyrimidines: C, U, T."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-09-biomolecules.t1",
   "name": {
    "en": "Secondary metabolites"
   },
   "tex": "\\text{alkaloids: morphine, codeine};\\ \\text{toxins: abrin, ricin};\\ \\text{lectins: concanavalin A}",
   "note": {
    "en": "Drugs: vinblastin, curcumin. Essential oil: lemon grass oil. Polymers: rubber, gums, cellulose. Pigments: carotenoids, anthocyanins."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-09-biomolecules.t2",
   "name": {
    "en": "Macromolecules"
   },
   "tex": "M \\geq 10\\,000\\ \\text{Da};\\ \\text{acid-soluble pool: } 18\\text{–}800\\ \\text{Da}",
   "note": {
    "en": "Lipids (< 800 Da) appear in acid-insoluble fraction as membrane vesicles."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-09-biomolecules.t2",
   "name": {
    "en": "Abundant proteins"
   },
   "tex": "\\text{RuBisCO (biosphere)};\\ \\text{collagen (animal world)}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-09-biomolecules.t1",
   "name": {
    "en": "Protein functions"
   },
   "tex": "\\text{collagen: ground substance};\\ \\text{trypsin: enzyme};\\ \\text{insulin: hormone};\\ \\text{GLUT-4: glucose transport}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-09-biomolecules.t3",
   "name": {
    "en": "Polysaccharides"
   },
   "tex": "\\text{cellulose, starch, glycogen} = (\\text{glucose})_n;\\ \\text{inulin} = (\\text{fructose})_n",
   "note": {
    "en": "Starch helix holds I₂ (blue); cellulose cannot. Right end reducing, left non-reducing. Chitin: amino-sugars, arthropod exoskeleton."
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Protein structure"
   },
   "tex": "\\text{1°: sequence (N}\\to\\text{C)};\\ \\text{2°: right-handed helix};\\ \\text{4°: Hb} = 2\\alpha + 2\\beta"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-09-biomolecules.t2",
   "name": {
    "en": "Bonds"
   },
   "tex": "\\text{peptide (–CO–NH–)},\\ \\text{glycosidic},\\ \\text{phosphodiester } (3' \\to 5')",
   "note": {
    "en": "Peptide and glycosidic bonds are formed by dehydration."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-09-biomolecules.t4",
   "name": {
    "en": "Carbonic anhydrase"
   },
   "tex": "200\\ \\text{h}^{-1} \\to 600\\,000\\ \\text{s}^{-1}:\\ \\approx 10^7\\times",
   "note": {
    "en": "CO₂ + H₂O ⇌ H₂CO₃."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-09-biomolecules.t4",
   "name": {
    "en": "Enzyme basics"
   },
   "tex": "E + S \\rightleftharpoons ES \\to EP \\to E + P",
   "note": {
    "en": "ES complex is transient; enzymes lower activation energy. Ribozymes: nucleic acid enzymes. Thermophile enzymes stable to 80–90 °C."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-09-biomolecules.t5",
   "name": {
    "en": "Substrate saturation"
   },
   "tex": "v \\to V_{\\max}\\ \\text{as}\\ [S] \\uparrow",
   "note": {
    "en": "Vmax not exceeded: all enzyme molecules occupied."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-09-biomolecules.t5",
   "name": {
    "en": "Competitive inhibition"
   },
   "tex": "\\text{malonate} \\dashv \\text{succinic dehydrogenase}",
   "note": {
    "en": "Inhibitor resembles substrate and competes for active site."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-09-biomolecules.t5",
   "name": {
    "en": "Enzyme classes"
   },
   "tex": "\\text{oxidoreductases, transferases, hydrolases, lyases, isomerases, ligases}",
   "note": {
    "en": "Lyases: remove groups leaving double bonds. Ligases: join C–O, C–S, C–N, P–O. Transferases: groups other than H."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-09-biomolecules.t5",
   "name": {
    "en": "Cofactors"
   },
   "tex": "\\text{prosthetic group (haem)};\\ \\text{coenzyme (NAD, NADP — niacin)};\\ \\text{metal (Zn}^{2+}\\text{ — carboxypeptidase)}",
   "note": {
    "en": "Apoenzyme = protein part; removing the cofactor abolishes activity."
   }
  }
 ]
}
