{
 "chapterId": "puc2-maths-07-integrals",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-maths-07-integrals.t2",
   "name": {
    "en": "Power"
   },
   "tex": "\\int x^n\\,dx = \\frac{x^{n+1}}{n+1} + C",
   "note": {
    "en": "n ≠ −1."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-maths-07-integrals.t1",
   "name": {
    "en": "Standard inverse"
   },
   "tex": "\\int\\frac{dx}{a^2 + x^2} = \\frac1a\\tan^{-1}\\frac xa + C",
   "note": {
    "en": "Completing the square leads here."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-07-integrals.t3",
   "name": {
    "en": "Log form"
   },
   "tex": "\\int\\frac{dx}{x^2 - a^2} = \\frac{1}{2a}\\ln\\left|\\frac{x - a}{x + a}\\right| + C",
   "note": {
    "en": "Partial fractions."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-07-integrals.t4",
   "name": {
    "en": "By parts"
   },
   "tex": "\\int uv\\,dx = u\\int v\\,dx - \\int\\left(u'\\int v\\,dx\\right)dx",
   "note": {
    "en": "Choose u by ILATE."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-maths-07-integrals.t2",
   "name": {
    "en": "eˣ pattern"
   },
   "tex": "\\int e^x\\big(f(x) + f'(x)\\big)dx = e^xf(x) + C",
   "note": {
    "en": "Spot f and f′."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-07-integrals.t6",
   "name": {
    "en": "King's property"
   },
   "tex": "\\int_a^b f(x)\\,dx = \\int_a^b f(a + b - x)\\,dx",
   "note": {
    "en": "Add to original integral."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-07-integrals.t6",
   "name": {
    "en": "Odd/even"
   },
   "tex": "\\int_{-a}^{a}f = \\begin{cases}2\\int_0^a f & f\\ \\text{even}\\\\ 0 & f\\ \\text{odd}\\end{cases}",
   "note": {
    "en": "Check symmetry first."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-07-integrals.t5",
   "name": {
    "en": "Area between curves"
   },
   "tex": "A = \\int_a^b(y_1 - y_2)\\,dx",
   "note": {
    "en": "Upper minus lower."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-maths-07-integrals.t2",
   "name": {
    "en": "Power rule"
   },
   "tex": "\\int x^n\\,dx = \\frac{x^{n+1}}{n+1} + C,\\quad n \\ne -1",
   "note": {
    "en": "For $n = -1$: $\\int\\frac{dx}{x} = \\ln|x| + C$."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-07-integrals.t4",
   "name": {
    "en": "Exponential"
   },
   "tex": "\\int e^{ax}dx = \\frac{e^{ax}}{a} + C,\\qquad \\int a^x dx = \\frac{a^x}{\\ln a} + C"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-maths-07-integrals.t4",
   "name": {
    "en": "Basic trig"
   },
   "tex": "\\int\\sin x = -\\cos x,\\ \\int\\cos x = \\sin x,\\ \\int\\sec^2x = \\tan x,\\ \\int\\csc^2x = -\\cot x"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-07-integrals.t4",
   "name": {
    "en": "Trig logs"
   },
   "tex": "\\int\\tan x = \\ln|\\sec x|,\\ \\int\\cot x = \\ln|\\sin x|,\\ \\int\\sec x = \\ln|\\sec x + \\tan x|,\\ \\int\\csc x = \\ln|\\csc x - \\cot x|"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-07-integrals.t3",
   "name": {
    "en": "Linear substitution"
   },
   "tex": "\\int f(ax + b)\\,dx = \\frac1a F(ax + b) + C"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "f'/f and f^n f'"
   },
   "tex": "\\int\\frac{f'(x)}{f(x)}dx = \\ln|f(x)| + C,\\quad \\int f^n f'\\,dx = \\frac{f^{n+1}}{n+1} + C"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-07-integrals.t1",
   "name": {
    "en": "Standard: sum of squares"
   },
   "tex": "\\int\\frac{dx}{x^2 + a^2} = \\frac1a\\tan^{-1}\\frac xa + C"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-maths-07-integrals.t1",
   "name": {
    "en": "Standard: difference of squares"
   },
   "tex": "\\int\\frac{dx}{x^2 - a^2} = \\frac{1}{2a}\\ln\\left|\\frac{x - a}{x + a}\\right|,\\quad \\int\\frac{dx}{a^2 - x^2} = \\frac{1}{2a}\\ln\\left|\\frac{a + x}{a - x}\\right|"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-maths-07-integrals.t1",
   "name": {
    "en": "Standard: square roots"
   },
   "tex": "\\int\\frac{dx}{\\sqrt{a^2 - x^2}} = \\sin^{-1}\\frac xa,\\quad \\int\\frac{dx}{\\sqrt{x^2 \\pm a^2}} = \\ln\\left|x + \\sqrt{x^2 \\pm a^2}\\right|"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-maths-07-integrals.t2",
   "name": {
    "en": "Root of quadratic (integrand)"
   },
   "tex": "\\int\\sqrt{a^2 - x^2}\\,dx = \\frac x2\\sqrt{a^2 - x^2} + \\frac{a^2}{2}\\sin^{-1}\\frac xa + C",
   "note": {
    "en": "$\\int\\sqrt{x^2 \\pm a^2}\\,dx = \\frac x2\\sqrt{x^2 \\pm a^2} \\pm \\frac{a^2}{2}\\ln\\left|x + \\sqrt{x^2 \\pm a^2}\\right| + C$."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-maths-07-integrals.t3",
   "name": {
    "en": "Linear over quadratic"
   },
   "tex": "px + q = A\\frac{d}{dx}(ax^2 + bx + c) + B",
   "note": {
    "en": "Then split into an f'/f part and a completed-square part."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-maths-07-integrals.t3",
   "name": {
    "en": "Partial fractions"
   },
   "tex": "\\frac{px + q}{(x - a)(x - b)} = \\frac{A}{x - a} + \\frac{B}{x - b}",
   "note": {
    "en": "Repeated factor $(x - a)^2$: use $\\frac{A}{x - a} + \\frac{B}{(x - a)^2}$; irreducible quadratic: $\\frac{Cx + D}{x^2 + px + q}$. Divide first if the fraction is improper."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-maths-07-integrals.t4",
   "name": {
    "en": "Integration by parts"
   },
   "tex": "\\int u\\,v\\,dx = u\\int v\\,dx - \\int\\left(u'\\int v\\,dx\\right)dx",
   "note": {
    "en": "Choose u by ILATE: Inverse trig, Log, Algebraic, Trig, Exponential."
   }
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "e^{ax} sin bx"
   },
   "tex": "\\int e^{ax}\\sin bx\\,dx = \\frac{e^{ax}}{a^2 + b^2}(a\\sin bx - b\\cos bx) + C",
   "note": {
    "en": "$\\int e^{ax}\\cos bx\\,dx = \\frac{e^{ax}}{a^2 + b^2}(a\\cos bx + b\\sin bx) + C$."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-maths-07-integrals.t2",
   "name": {
    "en": "Half-angle substitution"
   },
   "tex": "t = \\tan\\frac x2:\\ \\sin x = \\frac{2t}{1 + t^2},\\ \\cos x = \\frac{1 - t^2}{1 + t^2},\\ dx = \\frac{2\\,dt}{1 + t^2}",
   "note": {
    "en": "For $\\int\\frac{dx}{a + b\\cos x}$, $\\int\\frac{dx}{a + b\\sin x}$."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-maths-07-integrals.t5",
   "name": {
    "en": "Fundamental theorem"
   },
   "tex": "\\int_a^b f(x)\\,dx = F(b) - F(a),\\quad F' = f"
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Leibniz rule"
   },
   "tex": "\\frac{d}{dx}\\int_{u(x)}^{v(x)}f(t)\\,dt = f(v)\\,v' - f(u)\\,u'"
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-maths-07-integrals.t6",
   "name": {
    "en": "Half-interval property"
   },
   "tex": "\\int_0^{2a}f = \\begin{cases}2\\int_0^a f & f(2a - x) = f(x)\\\\ 0 & f(2a - x) = -f(x)\\end{cases}"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Periodic function"
   },
   "tex": "\\int_0^{nT}f(x)\\,dx = n\\int_0^Tf(x)\\,dx\\quad(\\text{period } T)"
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-maths-07-integrals.t3",
   "name": {
    "en": "Wallis' formula"
   },
   "tex": "\\int_0^{\\pi/2}\\sin^nx\\,dx = \\int_0^{\\pi/2}\\cos^nx\\,dx = \\frac{(n - 1)(n - 3)\\cdots}{n(n - 2)\\cdots}\\times\\begin{cases}\\frac\\pi2 & n\\ \\text{even}\\\\ 1 & n\\ \\text{odd}\\end{cases}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-maths-07-integrals.t5",
   "name": {
    "en": "Limit of a sum"
   },
   "tex": "\\lim_{n\\to\\infty}\\frac1n\\sum_{r=1}^{n}f\\left(\\frac rn\\right) = \\int_0^1f(x)\\,dx",
   "note": {
    "en": "If $r$ runs to $kn$, the upper limit becomes $k$."
   }
  },
  {
   "id": "zs-f30",
   "name": {
    "en": "Useful results"
   },
   "tex": "\\int_0^{\\pi/2}\\ln\\sin x\\,dx = -\\frac\\pi2\\ln 2,\\qquad \\int_0^{\\pi/4}\\ln(1 + \\tan x)\\,dx = \\frac\\pi8\\ln 2"
  }
 ]
}
