   "type": "example",
   "problem": {
    "en": "A human diploid cell has 6.6 × 10⁹ bp of DNA. Find the total length of DNA."
   },
   "steps": [
    {
     "en": "Distance between adjacent base pairs = 0.34 nm = 0.34 × 10⁻⁹ m."
    },
    {
     "en": "Length = 6.6 × 10⁹ × 0.34 × 10⁻⁹ m."
    },
    {
     "en": "= 2.244 m, about 2.2 m."
    }
   ],
   "answer": {
