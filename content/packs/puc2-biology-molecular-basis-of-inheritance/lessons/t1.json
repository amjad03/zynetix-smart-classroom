  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "A DNA sample has 20% adenine. Find the percentage of guanine and cytosine."
   },
   "steps": [
    {
     "en": "By Chargaff's rule, T = A = 20%, so A + T = 40%."
    },
    {
     "en": "G + C = 100 − 40 = 60%, and G = C."
    },
    {
     "en": "G = C = 30%."
    }
   ],
   "answer": {
    "en": "Guanine 30%, cytosine 30%"
