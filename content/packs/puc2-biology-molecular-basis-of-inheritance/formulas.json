{
 "chapterId": "puc2-biology-05-molecular-basis-of-inheritance",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t1",
   "name": {
    "en": "Nucleoside vs nucleotide"
   },
   "tex": "\\text{base} + \\text{pentose} \\xrightarrow{\\text{N-glycosidic}} \\text{nucleoside} \\xrightarrow{+\\,\\text{PO}_4\\ (\\text{phosphoester, 5}'\\text{-OH})} \\text{nucleotide}",
   "note": {
    "en": "Nucleotides join by 3′–5′ phosphodiester bonds."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t1",
   "name": {
    "en": "Chargaff's rules (dsDNA)"
   },
   "tex": "A = T,\\quad G = C,\\quad \\dfrac{A+G}{T+C} = 1",
   "note": {
    "en": "Purine always pairs with pyrimidine."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t1",
   "name": {
    "en": "Hydrogen bonds"
   },
   "tex": "A{=}T\\ (2\\ \\text{H-bonds}),\\qquad G{\\equiv}C\\ (3\\ \\text{H-bonds})",
   "note": {
    "en": "Total H-bonds = 2(A–T pairs) + 3(G–C pairs)."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t1",
   "name": {
    "en": "B-DNA dimensions"
   },
   "tex": "\\text{pitch} = 3.4\\ \\text{nm},\\ \\ 10\\ \\text{bp/turn},\\ \\ \\text{rise} = 0.34\\ \\text{nm/bp}",
   "note": {
    "en": "Right-handed helix; antiparallel strands."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t6",
   "name": {
    "en": "Length of DNA"
   },
   "tex": "L = (\\text{no. of bp}) \\times 0.34 \\times 10^{-9}\\ \\text{m}",
   "note": {
    "en": "Human diploid: 6.6 × 10⁹ bp ≈ 2.2 m; E. coli: 4.6 × 10⁶ bp."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t1",
   "name": {
    "en": "Nucleosome"
   },
   "tex": "\\text{histone octamer} + \\sim 200\\ \\text{bp DNA};\\ \\ \\text{H1 = linker}",
   "note": {
    "en": "Histones rich in Lys, Arg (+ve). Euchromatin active/light; heterochromatin inactive/dark."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t2",
   "name": {
    "en": "Genetic-material experiments"
   },
   "tex": "\\text{Griffith (1928)} \\to \\text{Avery–MacLeod–McCarty} \\to \\text{Hershey–Chase (1952)}",
   "note": {
    "en": "DNase blocks transformation; ³²P (DNA) enters bacteria, ³⁵S (protein) does not."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t3",
   "name": {
    "en": "Meselson–Stahl (semiconservative)"
   },
   "tex": "\\text{after } n \\text{ generations: } \\dfrac{\\text{hybrid}}{\\text{total}} = \\dfrac{2}{2^{n}}\\ \\ (n \\ge 1)",
   "note": {
    "en": "¹⁵NH₄Cl → ¹⁴NH₄Cl, CsCl gradient; Taylor used ³H-thymidine on Vicia faba."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t3",
   "name": {
    "en": "Replication rate (E. coli)"
   },
   "tex": "4.6\\times10^{6}\\ \\text{bp in } 38\\ \\text{min} \\approx 2000\\ \\text{bp s}^{-1}",
   "note": {
    "en": "DNA pol works 5′→3′ only; leading continuous, lagging as Okazaki fragments joined by ligase."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t4",
   "name": {
    "en": "Template vs coding strand"
   },
   "tex": "\\text{mRNA} = \\text{coding strand (5}'\\to3') \\text{ with } T \\to U",
   "note": {
    "en": "Template strand is 3′→5′. Promoter upstream (5′), terminator downstream (3′)."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t4",
   "name": {
    "en": "RNA polymerases"
   },
   "tex": "\\text{Prokaryote: one pol } (\\sigma \\text{ init}, \\rho \\text{ term});\\ \\text{Eukaryote: I} \\to \\text{28S,18S,5.8S; II} \\to \\text{hnRNA; III} \\to \\text{tRNA, 5S, snRNA}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t4",
   "name": {
    "en": "hnRNA processing"
   },
   "tex": "\\text{splicing (remove introns)} + \\text{5}'\\text{ cap (m}^7\\text{GTP)} + \\text{3}'\\text{ poly-A tail (200–300 A)}",
   "note": {
    "en": "Tailing is template-independent."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t5",
   "name": {
    "en": "Genetic code"
   },
   "tex": "4^{3} = 64 \\text{ codons} = 61 \\text{ sense} + 3 \\text{ stop (UAA, UAG, UGA)}",
   "note": {
    "en": "Triplet, degenerate, unambiguous, nearly universal, comma-less, non-overlapping; AUG = Met + start; Met & Trp have one codon each."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t5",
   "name": {
    "en": "Polypeptide length"
   },
   "tex": "\\text{amino acids} = \\dfrac{\\text{coding nucleotides (start to stop)}}{3} - 1",
   "note": {
    "en": "The stop codon adds no amino acid."
   }
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Frame-shift"
   },
   "tex": "\\pm 1, 2 \\text{ bases} \\Rightarrow \\text{frame shift};\\quad \\pm 3 \\text{ bases} \\Rightarrow \\pm 1 \\text{ amino acid}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t5",
   "name": {
    "en": "Translation"
   },
   "tex": "\\text{aa} + \\text{tRNA} + \\text{ATP} \\to \\text{aa-tRNA};\\ \\ \\text{peptide bond: 23S rRNA (ribozyme)}",
   "note": {
    "en": "tRNA: clover-leaf (2D), inverted L (3D). UTRs at 5′ and 3′ ends aid efficient translation."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t6",
   "name": {
    "en": "lac operon"
   },
   "tex": "i \\to \\text{repressor (constitutive)};\\ z \\to \\beta\\text{-galactosidase},\\ y \\to \\text{permease},\\ a \\to \\text{transacetylase}",
   "note": {
    "en": "Inducer: lactose (allolactose) inactivates repressor — negative regulation."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t6",
   "name": {
    "en": "Human genome facts"
   },
   "tex": "3164.7\\times10^{6}\\ \\text{bp};\\ \\sim 30{,}000 \\text{ genes};\\ 99.9\\%\\ \\text{identical};\\ <2\\%\\ \\text{coding}",
   "note": {
    "en": "Avg gene 3000 bases; dystrophin 2.4 Mb; Chr 1 most genes (2968), Y fewest (231); 1.4 million SNPs. HGP 1990–2003; BAC/YAC; Sanger sequencing."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-biology-05-molecular-basis-of-inheritance.t6",
   "name": {
    "en": "DNA fingerprinting"
   },
   "tex": "\\text{VNTR (mini-satellite, 0.1–20 kb)} \\xrightarrow{\\text{Southern blot}} \\text{band pattern}",
   "note": {
    "en": "Alec Jeffreys. Isolation → restriction digest → electrophoresis → blotting → hybridise probe → autoradiography. Polymorphism = heritable variant at frequency > 0.01."
   }
  }
 ]
}
