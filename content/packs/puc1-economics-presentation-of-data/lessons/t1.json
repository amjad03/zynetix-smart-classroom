  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Tabulate: \"Out of 120 students, 50 were boys of whom 30 passed, and of the 70 girls 56 passed.\""
   },
   "steps": [
    {
     "en": "Stubs (rows): Boys, Girls, Total. Captions (columns): Passed, Failed, Total."
    },
    {
     "en": "Boys: passed 30, failed 50 − 30 = 20, total 50. Girls: passed 56, failed 70 − 56 = 14, total 70."
    },
    {
     "en": "Total: passed 86, failed 34, total 120. Check: 86 + 34 = 120."
    }
   ],
   "answer": {
    "en": "Boys 30/20/50, Girls 56/14/70, Total 86/34/120"
   },
   "narration": {
    "en": "Let us work this out together. Tabulate: \"Out of 120 students, 50 were boys of whom 30 passed, and of the 70 girls 56 passed.\""
   }
  },
