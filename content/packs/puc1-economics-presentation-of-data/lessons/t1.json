  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Parts of a table"
   },
   "body": {
    "en": "A table arranges data in rows and columns. Its parts are: table number, title, captions (column headings), stubs (row headings), body (the figures), unit of measurement, source note and footnotes. Tables may be classified by time, place, quality or quantity.",
    "kn": "ಕೋಷ್ಟಕದ ಭಾಗಗಳು: ಕೋಷ್ಟಕ ಸಂಖ್ಯೆ, ಶೀರ್ಷಿಕೆ, ಕಾಲಂ ಶೀರ್ಷಿಕೆ (ಕ್ಯಾಪ್ಶನ್), ಸಾಲು ಶೀರ್ಷಿಕೆ (ಸ್ಟಬ್), ಮುಖ್ಯ ಭಾಗ, ಅಳತೆಯ ಘಟಕ, ಮೂಲ ಟಿಪ್ಪಣಿ."
   },
   "points": [
    {
     "en": "Captions = column headings"
    },
    {
     "en": "Stubs = row headings"
    },
    {
     "en": "Body = the data"
    },
    {
     "en": "Source note = origin of data"
    }
   ],
   "narration": {
    "en": "A table arranges data in rows and columns. Its parts are: table number, title, captions (column headings), stubs (row headings), body (the figures), unit of measurement, source note and footnotes. Tables may be classified by time, place, quality or quantity.",
    "kn": "ಕೋಷ್ಟಕದ ಭಾಗಗಳು: ಕೋಷ್ಟಕ ಸಂಖ್ಯೆ, ಶೀರ್ಷಿಕೆ, ಕಾಲಂ ಶೀರ್ಷಿಕೆ (ಕ್ಯಾಪ್ಶನ್), ಸಾಲು ಶೀರ್ಷಿಕೆ (ಸ್ಟಬ್), ಮುಖ್ಯ ಭಾಗ, ಅಳತೆಯ ಘಟಕ, ಮೂಲ ಟಿಪ್ಪಣಿ."
   }
  },
