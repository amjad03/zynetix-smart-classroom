   "type": "example",
   "problem": {
    "en": "A family spends ₹12,000: food ₹6,000, rent ₹3,000, education ₹1,500, clothing ₹900, others ₹600. Find the pie angles."
   },
   "steps": [
    {
     "en": "Food = 6,000/12,000 × 360° = 180°; Rent = 3,000/12,000 × 360° = 90°."
    },
    {
     "en": "Education = 1,500/12,000 × 360° = 45°; Clothing = 900/12,000 × 360° = 27°."
    },
    {
     "en": "Others = 600/12,000 × 360° = 18°."
    },
    {
     "en": "Check: 180 + 90 + 45 + 27 + 18 = 360°."
    }
   ],
