 "topicId": "puc1-economics-04-presentation-of-data.t2",
 "title": {
  "en": "Bar diagrams and pie diagram",
  "kn": "ಸ್ತಂಭ ಚಿತ್ರಗಳು ಮತ್ತು ವೃತ್ತ ಚಿತ್ರ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "A picture is worth a thousand numbers",
    "kn": "ಒಂದು ಚಿತ್ರ ಸಾವಿರ ಸಂಖ್ಯೆಗಳಿಗೆ ಸಮ"
   },
   "hook": {
    "en": "Where does a family's money go each month? Cut a circle like a pizza and the biggest slice shouts the answer.",
    "kn": "ಕುಟುಂಬದ ಹಣ ಪ್ರತಿ ತಿಂಗಳು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತದೆ? ವೃತ್ತವನ್ನು ಪಿಜ್ಜಾದಂತೆ ಕತ್ತರಿಸಿದರೆ ದೊಡ್ಡ ತುಂಡು ಉತ್ತರ ಹೇಳುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Draw simple, multiple and component bar diagrams"
    },
    {
     "en": "Calculate angles for a pie diagram"
    }
   ],
   "narration": {
    "en": "Where does a family's money go each month? Cut a circle like a pizza and the biggest slice shouts the answer.",
    "kn": "ಕುಟುಂಬದ ಹಣ ಪ್ರತಿ ತಿಂಗಳು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತದೆ? ವೃತ್ತವನ್ನು ಪಿಜ್ಜಾದಂತೆ ಕತ್ತರಿಸಿದರೆ ದೊಡ್ಡ ತುಂಡು ಉತ್ತರ ಹೇಳುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Bar diagrams"
   },
   "body": {
    "en": "Bar diagrams are one-dimensional: bars of equal width and equal gaps, whose heights show the values. A simple bar diagram shows one variable. A multiple bar diagram puts two or more bars side by side to compare. A component (sub-divided) bar diagram splits each bar into parts of the total.",
    "kn": "ಸ್ತಂಭ ಚಿತ್ರಗಳು ಏಕ-ಆಯಾಮದವು: ಸಮ ಅಗಲ, ಸಮ ಅಂತರ; ಎತ್ತರ ಮೌಲ್ಯ ತೋರಿಸುತ್ತದೆ. ಸರಳ, ಬಹು ಮತ್ತು ಘಟಕ ಸ್ತಂಭ ಚಿತ್ರಗಳು ಇವೆ."
   },
   "points": [
    {
     "en": "Simple bar: one series"
    },
    {
     "en": "Multiple bar: comparison of two or more series"
    },
    {
     "en": "Component bar: parts of a whole"
    }
   ],
   "narration": {
    "en": "Bar diagrams are one-dimensional: bars of equal width and equal gaps, whose heights show the values. A simple bar diagram shows one variable. A multiple bar diagram puts two or more bars side by side to compare. A component (sub-divided) bar diagram splits each bar into parts of the total.",
    "kn": "ಸ್ತಂಭ ಚಿತ್ರಗಳು ಏಕ-ಆಯಾಮದವು: ಸಮ ಅಗಲ, ಸಮ ಅಂತರ; ಎತ್ತರ ಮೌಲ್ಯ ತೋರಿಸುತ್ತದೆ. ಸರಳ, ಬಹು ಮತ್ತು ಘಟಕ ಸ್ತಂಭ ಚಿತ್ರಗಳು ಇವೆ."
   }
  },
