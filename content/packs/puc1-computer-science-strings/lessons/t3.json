  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Print each character of \"Hello\" on the same line separated by spaces, using a while loop."
   },
   "steps": [
    {
     "en": "str1 = \"Hello\""
    },
    {
     "en": "index = 0"
    },
    {
     "en": "while index < len(str1):"
    },
    {
     "en": "    print(str1[index], end=\" \")"
    },
    {
     "en": "    index += 1"
    },
    {
     "en": "index takes values 0, 1, 2, 3, 4; the loop stops when index becomes 5."
    }
   ],
   "answer": {
    "en": "H e l l o "
   },
   "narration": {
    "en": "Let us trace this code together. Print each character of \"Hello\" on the same line separated by spaces, using a while loop. Predict the output before we run it."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Count the uppercase letters and digits in \"Exam2025ON\"."
   },
   "steps": [
    {
     "en": "s = \"Exam2025ON\""
    },
    {
     "en": "up = 0"
    },
    {
     "en": "dig = 0"
    },
    {
     "en": "for ch in s:"
    },
    {
     "en": "    if ch.isupper():"
    },
    {
     "en": "        up += 1"
    },
    {
     "en": "    elif ch.isdigit():"
    },
    {
     "en": "        dig += 1"
    },
    {
     "en": "print(\"Upper:\", up, \"Digits:\", dig)"
    },
    {
     "en": "E, O and N are uppercase; 2, 0, 2, 5 are digits."
    }
   ],
   "answer": {
    "en": "Upper: 3 Digits: 4"
   },
   "narration": {
    "en": "Let us trace this code together. Count the uppercase letters and digits in \"Exam2025ON\". Predict the output before we run it."
   }
