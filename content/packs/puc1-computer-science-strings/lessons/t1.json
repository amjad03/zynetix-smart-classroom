  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "What is a string?"
   },
   "body": {
    "en": "A string is a sequence of Unicode characters enclosed in single, double or triple quotes. Triple quotes allow a string to span several lines. Each character has an index: from 0 at the left, or from -1 at the right.",
    "kn": "ಸ್ಟ್ರಿಂಗ್ ಎಂದರೆ ಏಕ, ಎರಡು ಅಥವಾ ಮೂರು ಉದ್ಧರಣ ಚಿಹ್ನೆಗಳೊಳಗಿನ ಯುನಿಕೋಡ್ ಅಕ್ಷರಗಳ ಸರಣಿ. ಪ್ರತಿ ಅಕ್ಷರಕ್ಕೆ ಎಡದಿಂದ 0 ರಿಂದ, ಬಲದಿಂದ -1 ರಿಂದ ಇಂಡೆಕ್ಸ್ ಇದೆ."
   },
   "points": [
    {
     "en": "For a string of length n, indices run from 0 to n-1, or from -n to -1"
    },
    {
     "en": "An index outside this range gives IndexError"
    }
   ],
   "narration": {
    "en": "A string is a sequence of Unicode characters enclosed in single, double or triple quotes. Triple quotes allow a string to span several lines. Each character has an index: from 0 at the left, or from -1 at the right.",
    "kn": "ಸ್ಟ್ರಿಂಗ್ ಎಂದರೆ ಏಕ, ಎರಡು ಅಥವಾ ಮೂರು ಉದ್ಧರಣ ಚಿಹ್ನೆಗಳೊಳಗಿನ ಯುನಿಕೋಡ್ ಅಕ್ಷರಗಳ ಸರಣಿ. ಪ್ರತಿ ಅಕ್ಷರಕ್ಕೆ ಎಡದಿಂದ 0 ರಿಂದ, ಬಲದಿಂದ -1 ರಿಂದ ಇಂಡೆಕ್ಸ್ ಇದೆ."
   },
   "formula": "s[-k] = s[n-k]"
  },
