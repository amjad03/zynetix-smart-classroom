{
 "chapterId": "puc1-chemistry-05-thermodynamics",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-05-thermodynamics.t1",
   "name": {
    "en": "First law"
   },
   "tex": "\\Delta U = q + w",
   "note": {
    "en": "Chemistry convention: w on system is +."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Enthalpy"
   },
   "tex": "\\Delta H = \\Delta U + \\Delta n_g RT",
   "note": {
    "en": "Δn_g = gas moles change."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-05-thermodynamics.t5",
   "name": {
    "en": "Gibbs energy"
   },
   "tex": "\\Delta G = \\Delta H - T\\Delta S",
   "note": {
    "en": "ΔG < 0 spontaneous."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "ΔG° and K"
   },
   "tex": "\\Delta G^\\circ = -2.303RT\\log K",
   "note": {
    "en": "K > 1 ⇔ ΔG° < 0."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-chemistry-05-thermodynamics.t1",
   "name": {
    "en": "Hess's law"
   },
   "tex": "\\Delta H_r = \\sum\\Delta H_f(\\text{P}) - \\sum\\Delta H_f(\\text{R})",
   "note": {
    "en": "State function — path independent."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "From bond energies"
   },
   "tex": "\\Delta H_r = \\sum BE(\\text{R}) - \\sum BE(\\text{P})",
   "note": {
    "en": "Reactants minus products here."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Isothermal reversible work"
   },
   "tex": "w = -2.303\\,nRT\\log\\frac{V_2}{V_1}",
   "note": {
    "en": "Expansion: w < 0."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "Entropy change"
   },
   "tex": "\\Delta S = \\frac{q_{rev}}{T}",
   "note": {
    "en": "Phase change: ΔH/T."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Pressure–volume work"
   },
   "tex": "w = -p_{\\text{ext}}\\Delta V",
   "note": {
    "en": "Free expansion (p_ext = 0): w = 0. 1 L atm = 101.3 J; 1 L bar = 100 J."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Isothermal reversible work (ideal gas)"
   },
   "tex": "w = -2.303\\,nRT\\log\\dfrac{V_2}{V_1} = -2.303\\,nRT\\log\\dfrac{p_1}{p_2}",
   "note": {
    "en": "ΔU = 0 so q = −w. Reversible work is the maximum work."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-05-thermodynamics.t1",
   "name": {
    "en": "Adiabatic process"
   },
   "tex": "q = 0,\\ \\ \\Delta U = w = nC_V\\Delta T;\\ \\ TV^{\\gamma-1} = \\text{const},\\ \\ pV^\\gamma = \\text{const}",
   "note": {
    "en": "γ = 5/3 (monatomic), 7/5 (diatomic)."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Enthalpy"
   },
   "tex": "H = U + pV, \\qquad \\Delta H = \\Delta U + \\Delta n_g RT",
   "note": {
    "en": "Δn_g counts only gaseous moles (products − reactants). ΔH = q_p, ΔU = q_V."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Heat capacities"
   },
   "tex": "q = nC\\Delta T, \\quad C_p - C_V = R, \\quad \\gamma = C_p/C_V",
   "note": {
    "en": "Monatomic: C_V = 3R/2, C_p = 5R/2."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Calorimetry"
   },
   "tex": "q = C_{\\text{cal}}\\Delta T",
   "note": {
    "en": "Bomb calorimeter (constant V) gives ΔU; coffee-cup (constant p) gives ΔH."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-05-thermodynamics.t3",
   "name": {
    "en": "Hess's law"
   },
   "tex": "\\Delta_r H = \\sum \\Delta H_{\\text{steps}}",
   "note": {
    "en": "Equations can be added, reversed (change sign) or multiplied (scale ΔH)."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-05-thermodynamics.t3",
   "name": {
    "en": "From enthalpies of formation"
   },
   "tex": "\\Delta_r H^\\circ = \\sum \\nu\\,\\Delta_f H^\\circ(\\text{products}) - \\sum \\nu\\,\\Delta_f H^\\circ(\\text{reactants})",
   "note": {
    "en": "Δf H° = 0 for elements in reference state (O₂(g), C(graphite), Br₂(l))."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "From bond enthalpies (gas phase)"
   },
   "tex": "\\Delta_r H = \\sum \\text{B.E.(bonds broken)} - \\sum \\text{B.E.(bonds formed)}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-05-thermodynamics.t2",
   "name": {
    "en": "Enthalpy of neutralisation"
   },
   "tex": "\\text{H}^+ + \\text{OH}^- \\rightarrow \\text{H}_2\\text{O}: \\ \\Delta H = -57.1\\ \\text{kJ mol}^{-1}",
   "note": {
    "en": "Less negative when a weak acid or base is involved (ionisation absorbs heat)."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "Born–Haber cycle (NaCl)"
   },
   "tex": "\\Delta_f H = \\Delta_{\\text{sub}}H + IE + \\tfrac12 D(\\text{Cl}_2) + \\Delta_{eg}H + U_{\\text{lattice formation}}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "Resonance energy"
   },
   "tex": "E_{\\text{res}} = \\Delta H_{\\text{calc}} - \\Delta H_{\\text{obs}}",
   "note": {
    "en": "Benzene: 3(−119) − (−208) → 149 kJ mol⁻¹ more stable."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "Entropy change"
   },
   "tex": "\\Delta S = \\dfrac{q_{\\text{rev}}}{T}, \\qquad \\Delta S_{\\text{iso}} = nR\\ln\\dfrac{V_2}{V_1}",
   "note": {
    "en": "Phase change: ΔS = ΔH_trans / T_trans."
   }
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Second law"
   },
   "tex": "\\Delta S_{\\text{total}} = \\Delta S_{\\text{sys}} + \\Delta S_{\\text{surr}} > 0\\ (\\text{spontaneous}),\\ \\ = 0\\ (\\text{equilibrium})",
   "note": {
    "en": "ΔS_surr = −ΔH_sys / T."
   }
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Third law"
   },
   "tex": "S \\rightarrow 0 \\text{ as } T \\rightarrow 0\\ \\text{K (perfect crystal)}"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-05-thermodynamics.t5",
   "name": {
    "en": "Gibbs energy"
   },
   "tex": "\\Delta G = \\Delta H - T\\Delta S = -T\\Delta S_{\\text{total}}",
   "note": {
    "en": "ΔG < 0 spontaneous; = 0 equilibrium; > 0 non-spontaneous (at constant T, p)."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-05-thermodynamics.t3",
   "name": {
    "en": "Sign table"
   },
   "tex": "(-,+): \\text{always};\\ (+,-): \\text{never};\\ (-,-): T < \\Delta H/\\Delta S;\\ (+,+): T > \\Delta H/\\Delta S",
   "note": {
    "en": "Signs of (ΔH, ΔS)."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-05-thermodynamics.t4",
   "name": {
    "en": "ΔG° and K"
   },
   "tex": "\\Delta G^\\circ = -RT\\ln K = -2.303RT\\log K",
   "note": {
    "en": "K > 1 ⇔ ΔG° < 0. 2.303 × 8.314 × 298 ≈ 5706 J mol⁻¹."
   }
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "ΔG and Q"
   },
   "tex": "\\Delta G = \\Delta G^\\circ + RT\\ln Q"
  }
 ]
}
