 {
  "id": "1c05-q05",
  "chapterId": "puc1-chemistry-05-thermodynamics",
  "topicId": "puc1-chemistry-05-thermodynamics.t2",
  "stem": {
   "en": "A gas expands from 1 L to 5 L against a constant external pressure of 2 atm. The work done on the gas is:"
  },
  "options": [
   {
    "en": "+8 L atm"
   },
   {
    "en": "−10 L atm"
   },
   {
    "en": "−2 L atm"
   },
   {
    "en": "−8 L atm"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "w = −pₑₓΔV = −2 × (5 − 1) = −8 L atm (about −810 J)."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
