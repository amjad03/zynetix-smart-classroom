 {
  "id": "1c05-q07",
  "chapterId": "puc1-chemistry-05-thermodynamics",
  "topicId": "puc1-chemistry-05-thermodynamics.t2",
  "stem": {
   "en": "For which reaction is ΔH equal to ΔU?"
  },
  "options": [
   {
    "en": "PCl₅(g) → PCl₃(g) + Cl₂(g)"
   },
   {
    "en": "H₂(g) + Cl₂(g) → 2HCl(g)"
   },
   {
    "en": "2SO₂(g) + O₂(g) → 2SO₃(g)"
   },
   {
    "en": "N₂(g) + 3H₂(g) → 2NH₃(g)"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "ΔH = ΔU + Δn_g RT; only for H₂ + Cl₂ → 2HCl is Δn_g = 2 − 2 = 0."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "1c05-q08",
  "chapterId": "puc1-chemistry-05-thermodynamics",
  "topicId": "puc1-chemistry-05-thermodynamics.t2",
  "stem": {
   "en": "For CO(g) + ½O₂(g) → CO₂(g) at 298 K, ΔH − ΔU is about:"
  },
  "options": [
   {
    "en": "0"
   },
   {
    "en": "−1.24 kJ"
   },
   {
    "en": "+1.24 kJ"
   },
   {
    "en": "−2.48 kJ"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Δn_g = 1 − 1.5 = −0.5; Δn_g RT = −0.5 × 8.314 × 298 = −1239 J ≈ −1.24 kJ."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "1c05-q09",
  "chapterId": "puc1-chemistry-05-thermodynamics",
  "topicId": "puc1-chemistry-05-thermodynamics.t2",
  "stem": {
   "en": "One mole of an ideal gas expands isothermally and reversibly from 10 L to 100 L at 300 K. The work done on the gas is about:"
  },
  "options": [
   {
    "en": "+5.74 kJ"
   },
   {
    "en": "−2.49 kJ"
   },
   {
    "en": "−0.75 kJ"
   },
   {
    "en": "−5.74 kJ"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "w = −2.303 nRT log(V_f/V_i) = −2.303 × 1 × 8.314 × 300 × log 10 = −5744 J ≈ −5.74 kJ."
  },
  "exams": [
   "PUC",
   "KCET",
   "COMEDK",
   "NEET",
   "JEE"
  ],
  "difficulty": "hard",
  "tags": []
 },
