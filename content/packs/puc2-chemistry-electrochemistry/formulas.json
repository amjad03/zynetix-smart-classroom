{
 "chapterId": "puc2-chemistry-02-electrochemistry",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Cell EMF"
   },
   "tex": "E^\\circ_{cell} = E^\\circ_{cathode} - E^\\circ_{anode}",
   "note": {
    "en": "Reduction potentials."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-02-electrochemistry.t2",
   "name": {
    "en": "Nernst equation"
   },
   "tex": "E = E^\\circ - \\frac{0.0591}{n}\\log Q",
   "note": {
    "en": "At 298 K."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Free energy"
   },
   "tex": "\\Delta G = -nFE",
   "note": {
    "en": "E > 0 → spontaneous."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-02-electrochemistry.t2",
   "name": {
    "en": "Equilibrium constant"
   },
   "tex": "\\log K = \\frac{nE^\\circ}{0.0591}",
   "note": {
    "en": "At 298 K."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-02-electrochemistry.t4",
   "name": {
    "en": "Faraday's law"
   },
   "tex": "m = \\frac{MIt}{nF}",
   "note": {
    "en": "F = 96500 C/mol."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Molar conductivity"
   },
   "tex": "\\Lambda_m = \\frac{1000\\,\\kappa}{M}",
   "note": {
    "en": "Units S cm² mol⁻¹."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Kohlrausch & α"
   },
   "tex": "\\Lambda^\\circ_m = \\nu_+\\lambda^\\circ_+ + \\nu_-\\lambda^\\circ_-,\\quad \\alpha = \\frac{\\Lambda_m}{\\Lambda^\\circ_m}",
   "note": {
    "en": "For weak electrolytes."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-02-electrochemistry.t2",
   "name": {
    "en": "Cell constant"
   },
   "tex": "G^* = \\frac lA = \\kappa R",
   "note": {
    "en": "κ = G*/R."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Cell emf"
   },
   "tex": "E^\\circ_{\\text{cell}} = E^\\circ_{\\text{cathode}} - E^\\circ_{\\text{anode}} = E^\\circ_{\\text{right}} - E^\\circ_{\\text{left}}",
   "note": {
    "en": "Anode (left): oxidation, negative in a galvanic cell. Cathode (right): reduction."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Cell notation"
   },
   "tex": "\\text{Zn}\\,|\\,\\text{Zn}^{2+}(aq)\\,\\|\\,\\text{Cu}^{2+}(aq)\\,|\\,\\text{Cu}",
   "note": {
    "en": "Daniell cell, E° = 1.10 V. || = salt bridge."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "SHE"
   },
   "tex": "\\text{Pt}\\,|\\,\\text{H}_2(1\\ \\text{bar})\\,|\\,\\text{H}^+(1\\ \\text{M}),\\quad E^\\circ = 0",
   "note": {
    "en": "More negative E° ⇒ stronger reducing agent (Li strongest); more positive ⇒ stronger oxidant (F₂)."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-02-electrochemistry.t2",
   "name": {
    "en": "Nernst equation (half-cell)"
   },
   "tex": "E = E^\\circ - \\dfrac{0.059}{n}\\log\\dfrac{[\\text{reduced}]}{[\\text{oxidised}]}",
   "note": {
    "en": "At 298 K, 2.303RT/F = 0.059 V."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-02-electrochemistry.t2",
   "name": {
    "en": "Nernst equation (cell)"
   },
   "tex": "E_{\\text{cell}} = E^\\circ_{\\text{cell}} - \\dfrac{0.059}{n}\\log Q"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Hydrogen electrode"
   },
   "tex": "E_{\\text{H}^+/\\text{H}_2} = -0.059\\,\\text{pH}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Concentration cell"
   },
   "tex": "E = \\dfrac{0.059}{n}\\log\\dfrac{C_{\\text{cathode}}}{C_{\\text{anode}}}",
   "note": {
    "en": "E° = 0; emf comes only from the concentration difference."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Gibbs energy"
   },
   "tex": "\\Delta_r G = -nFE_{\\text{cell}}, \\quad \\Delta_r G^\\circ = -nFE^\\circ_{\\text{cell}}",
   "note": {
    "en": "F = 96 500 C mol⁻¹."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-02-electrochemistry.t2",
   "name": {
    "en": "Equilibrium constant"
   },
   "tex": "\\log K_c = \\dfrac{nE^\\circ_{\\text{cell}}}{0.059}, \\qquad \\Delta_r G^\\circ = -2.303RT\\log K_c"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-02-electrochemistry.t1",
   "name": {
    "en": "Combining half-cell potentials"
   },
   "tex": "n_3E^\\circ_3 = n_1E^\\circ_1 + n_2E^\\circ_2",
   "note": {
    "en": "Add ΔG°, not E°."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Entropy and enthalpy from emf"
   },
   "tex": "\\Delta S = nF\\left(\\dfrac{\\partial E}{\\partial T}\\right)_P, \\quad \\Delta H = -nFE + nFT\\left(\\dfrac{\\partial E}{\\partial T}\\right)_P"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Resistance, conductance"
   },
   "tex": "R = \\rho\\dfrac{l}{A}, \\quad G = \\dfrac{1}{R}, \\quad \\kappa = \\dfrac{1}{\\rho} = \\dfrac{G^*}{R}",
   "note": {
    "en": "Cell constant G* = l/A (m⁻¹). κ in S m⁻¹."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Molar conductivity"
   },
   "tex": "\\Lambda_m = \\dfrac{\\kappa}{c} \\ (\\text{S m}^2\\,\\text{mol}^{-1}), \\quad \\Lambda_m = \\dfrac{1000\\,\\kappa}{M} \\ (\\text{S cm}^2\\,\\text{mol}^{-1})",
   "note": {
    "en": "κ in S cm⁻¹ and M in mol L⁻¹ for the second form. On dilution κ falls, Λm rises."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Strong electrolytes (Debye–Hückel–Onsager)"
   },
   "tex": "\\Lambda_m = \\Lambda_m^\\circ - A\\sqrt{c}",
   "note": {
    "en": "A depends on electrolyte type, solvent and T."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Kohlrausch's law"
   },
   "tex": "\\Lambda_m^\\circ = \\nu_+\\lambda_+^\\circ + \\nu_-\\lambda_-^\\circ",
   "note": {
    "en": "e.g. Λ°(CH₃COOH) = Λ°(HCl) + Λ°(CH₃COONa) − Λ°(NaCl)."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-chemistry-02-electrochemistry.t3",
   "name": {
    "en": "Weak electrolytes"
   },
   "tex": "\\alpha = \\dfrac{\\Lambda_m}{\\Lambda_m^\\circ}, \\qquad K_a = \\dfrac{c\\alpha^2}{1 - \\alpha}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-chemistry-02-electrochemistry.t4",
   "name": {
    "en": "Faraday's first law"
   },
   "tex": "w = ZIt = \\dfrac{M\\,I\\,t}{nF}",
   "note": {
    "en": "1 F = charge of 1 mol electrons = 96 500 C."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-chemistry-02-electrochemistry.t4",
   "name": {
    "en": "Faraday's second law"
   },
   "tex": "\\dfrac{w_1}{w_2} = \\dfrac{E_1}{E_2}",
   "note": {
    "en": "Same charge through cells in series; E = equivalent mass = M/n."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc2-chemistry-02-electrochemistry.t4",
   "name": {
    "en": "Electrolysis products (inert electrodes)"
   },
   "tex": "\\text{NaCl(aq)}: \\text{H}_2 \\,|\\, \\text{Cl}_2; \\quad \\text{CuSO}_4\\text{(aq)}: \\text{Cu} \\,|\\, \\text{O}_2; \\quad \\text{Na}_2\\text{SO}_4\\text{(aq)}: \\text{H}_2 \\,|\\, \\text{O}_2",
   "note": {
    "en": "Cl₂ forms over O₂ because of the overpotential of O₂. Molten NaCl gives Na | Cl₂."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-chemistry-02-electrochemistry.t5",
   "name": {
    "en": "Lead storage battery (discharge)"
   },
   "tex": "\\text{Pb} + \\text{PbO}_2 + 2\\text{H}_2\\text{SO}_4 \\rightarrow 2\\text{PbSO}_4 + 2\\text{H}_2\\text{O}",
   "note": {
    "en": "Secondary cell; electrolyte 38% H₂SO₄; acid density falls on discharge."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-chemistry-02-electrochemistry.t5",
   "name": {
    "en": "Primary cells"
   },
   "tex": "\\text{Dry cell} \\approx 1.5\\ \\text{V};\\quad \\text{Zn(Hg)} + \\text{HgO} \\rightarrow \\text{ZnO} + \\text{Hg}\\ (1.35\\ \\text{V})",
   "note": {
    "en": "Dry cell: Zn anode, graphite/MnO₂ cathode, NH₄Cl + ZnCl₂ paste. Mercury cell voltage is constant."
   }
  },
  {
   "id": "zs-f30",
   "topicId": "puc2-chemistry-02-electrochemistry.t5",
   "name": {
    "en": "H₂–O₂ fuel cell"
   },
   "tex": "\\text{Cathode: } \\text{O}_2 + 2\\text{H}_2\\text{O} + 4e^- \\rightarrow 4\\text{OH}^-;\\ \\ \\text{Anode: } 2\\text{H}_2 + 4\\text{OH}^- \\rightarrow 4\\text{H}_2\\text{O} + 4e^-"
  },
  {
   "id": "zs-f31",
   "topicId": "puc2-chemistry-02-electrochemistry.t5",
   "name": {
    "en": "Corrosion (rusting)"
   },
   "tex": "2\\text{Fe} + \\text{O}_2 + 4\\text{H}^+ \\rightarrow 2\\text{Fe}^{2+} + 2\\text{H}_2\\text{O};\\ \\ \\text{rust} = \\text{Fe}_2\\text{O}_3\\cdot x\\text{H}_2\\text{O}",
   "note": {
    "en": "E°cell = 1.67 V. Prevented by paint, galvanising (Zn) or sacrificial Mg/Zn anodes."
   }
  }
 ]
}
