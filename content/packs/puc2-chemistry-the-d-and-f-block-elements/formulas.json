{
 "chapterId": "puc2-chemistry-04-the-d-and-f-block-elements",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t1",
   "name": {
    "en": "General configuration (d-block)"
   },
   "tex": "(n-1)d^{1\\text{–}10}\\,ns^{1\\text{–}2}",
   "note": {
    "en": "Pd is 4d¹⁰ 5s⁰. Transition element: incomplete d in the atom or a common ion (so Zn, Cd, Hg are not)."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t1",
   "name": {
    "en": "Exceptional 3d configurations"
   },
   "tex": "\\text{Cr}: [\\text{Ar}]\\,3d^5 4s^1,\\qquad \\text{Cu}: [\\text{Ar}]\\,3d^{10} 4s^1",
   "note": {
    "en": "Half-filled / fully filled d sub-shells are extra stable."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t2",
   "name": {
    "en": "Ions: remove 4s before 3d"
   },
   "tex": "\\text{Fe}^{2+} = 3d^6,\\ \\ \\text{Fe}^{3+} = 3d^5,\\ \\ \\text{Mn}^{2+} = 3d^5,\\ \\ \\text{Cu}^{2+} = 3d^9",
   "note": {
    "en": "4s fills first but also empties first."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t4",
   "name": {
    "en": "Spin-only magnetic moment"
   },
   "tex": "\\mu = \\sqrt{n(n+2)}\\ \\text{BM}",
   "note": {
    "en": "n = unpaired electrons: 1 → 1.73, 2 → 2.83, 3 → 3.87, 4 → 4.90, 5 → 5.92 BM."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t3",
   "name": {
    "en": "Oxidation states"
   },
   "tex": "\\text{Max} = (n-1)d + ns\\ \\text{electrons up to Mn } (+7)",
   "note": {
    "en": "Most states at Mn; Sc only +3, Zn only +2. Higher states stabilised by O (Mn₂O₇) more than by F (MnF₄)."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t3",
   "name": {
    "en": "E° anomalies (M²⁺/M)"
   },
   "tex": "E^\\circ_{\\text{Cu}^{2+}/\\text{Cu}} = +0.34\\ \\text{V (only positive)}",
   "note": {
    "en": "Mn (d⁵), Zn (d¹⁰) and Ni (large −ΔhydH) are more negative than the trend."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "E° (M³⁺/M²⁺)"
   },
   "tex": "\\text{Co}\\,(+1.97) > \\text{Mn}\\,(+1.57) > \\text{Fe}\\,(+0.77) > \\text{V}\\,(-0.26) > \\text{Ti}\\,(-0.37) > \\text{Cr}\\,(-0.41)",
   "note": {
    "en": "Mn³⁺, Co³⁺ oxidants; Cr²⁺ reductant (→ t₂g³)."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t4",
   "name": {
    "en": "Colour"
   },
   "tex": "\\text{d–d transition needs } d^1\\text{–}d^9",
   "note": {
    "en": "Sc³⁺, Ti⁴⁺ (d⁰), Cu⁺, Zn²⁺ (d¹⁰) colourless. MnO₄⁻, Cr₂O₇²⁻ coloured by charge transfer (LMCT)."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Chromate ⇌ dichromate"
   },
   "tex": "2\\,\\text{CrO}_4^{2-} + 2\\,\\text{H}^+ \\rightleftharpoons \\text{Cr}_2\\text{O}_7^{2-} + \\text{H}_2\\text{O}",
   "note": {
    "en": "Yellow ⇌ orange; Cr stays +6. Dichromate: two tetrahedra sharing one O, Cr–O–Cr ≈ 126°."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Chromite to chromate"
   },
   "tex": "4\\,\\text{FeCr}_2\\text{O}_4 + 8\\,\\text{Na}_2\\text{CO}_3 + 7\\,\\text{O}_2 \\rightarrow 8\\,\\text{Na}_2\\text{CrO}_4 + 2\\,\\text{Fe}_2\\text{O}_3 + 8\\,\\text{CO}_2",
   "note": {
    "en": "Then acidify → Na₂Cr₂O₇, + KCl → K₂Cr₂O₇."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Dichromate in acid"
   },
   "tex": "\\text{Cr}_2\\text{O}_7^{2-} + 14\\,\\text{H}^+ + 6e^- \\rightarrow 2\\,\\text{Cr}^{3+} + 7\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "E° = 1.33 V; n-factor 6 (equivalent mass M/6). Oxidises Fe²⁺, I⁻ → I₂, H₂S → S, Sn²⁺ → Sn⁴⁺."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Manganate from MnO₂"
   },
   "tex": "2\\,\\text{MnO}_2 + 4\\,\\text{KOH} + \\text{O}_2 \\rightarrow 2\\,\\text{K}_2\\text{MnO}_4 + 2\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "Green manganate (d¹, paramagnetic)."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Manganate disproportionation"
   },
   "tex": "3\\,\\text{MnO}_4^{2-} + 4\\,\\text{H}^+ \\rightarrow 2\\,\\text{MnO}_4^- + \\text{MnO}_2 + 2\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "Commercially: electrolytic oxidation of manganate in alkali."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Permanganate: acidic"
   },
   "tex": "\\text{MnO}_4^- + 8\\,\\text{H}^+ + 5e^- \\rightarrow \\text{Mn}^{2+} + 4\\,\\text{H}_2\\text{O}",
   "note": {
    "en": "E° = 1.52 V; n-factor 5. Fe²⁺ → Fe³⁺, C₂O₄²⁻ → CO₂, I⁻ → I₂, NO₂⁻ → NO₃⁻."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t5",
   "name": {
    "en": "Permanganate: neutral / faintly alkaline"
   },
   "tex": "\\text{MnO}_4^- + 2\\,\\text{H}_2\\text{O} + 3e^- \\rightarrow \\text{MnO}_2 + 4\\,\\text{OH}^-",
   "note": {
    "en": "n-factor 3. I⁻ → IO₃⁻, S₂O₃²⁻ → SO₄²⁻, Mn²⁺ → MnO₂."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t2",
   "name": {
    "en": "Oxide character"
   },
   "tex": "\\text{MnO (basic)} \\to \\text{Mn}_2\\text{O}_7\\ (\\text{acidic});\\quad \\text{Cr}_2\\text{O}_3,\\ \\text{V}_2\\text{O}_5\\ \\text{amphoteric}",
   "note": {
    "en": "Acidity rises with oxidation state."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t1",
   "name": {
    "en": "Lanthanoid configuration"
   },
   "tex": "[\\text{Xe}]\\,4f^{1\\text{–}14}\\,5d^{0\\text{–}1}\\,6s^2",
   "note": {
    "en": "5d¹ in La, Ce, Gd (4f⁷), Lu (4f¹⁴). Common state +3; Ce⁴⁺ oxidant, Eu²⁺/Yb²⁺ reductants."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t6",
   "name": {
    "en": "Lanthanoid contraction"
   },
   "tex": "r(\\text{La}^{3+}) > \\dots > r(\\text{Lu}^{3+})",
   "note": {
    "en": "Poor 4f shielding. Zr ≈ Hf, Nb ≈ Ta; basicity La(OH)₃ > … > Lu(OH)₃."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t6",
   "name": {
    "en": "Actinoids"
   },
   "tex": "[\\text{Rn}]\\,5f^{1\\text{–}14}\\,6d^{0\\text{–}1}\\,7s^2",
   "note": {
    "en": "All radioactive; wider oxidation-state range (up to +7 for Np, Pu); actinoid contraction > lanthanoid contraction."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t4",
   "name": {
    "en": "Interstitial compounds and alloys"
   },
   "tex": "\\text{TiC},\\ \\text{Mn}_4\\text{N},\\ \\text{Fe}_3\\text{H}",
   "note": {
    "en": "Hard, high m.p., metallic conduction, inert. Mischmetal ≈ 95% Ln + 5% Fe: lighter flints."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-chemistry-04-the-d-and-f-block-elements.t4",
   "name": {
    "en": "Catalysts"
   },
   "tex": "\\text{V}_2\\text{O}_5\\ (\\text{contact}),\\ \\text{Fe}\\ (\\text{Haber}),\\ \\text{Ni}\\ (\\text{hydrogenation}),\\ \\text{TiCl}_4 + \\text{AlR}_3\\ (\\text{Ziegler–Natta})",
   "note": {
    "en": "Variable oxidation states and surface adsorption."
   }
  }
 ]
}
