  {
   "id": "ex1",
   "type": "example",
   "title": {
    "en": "Worked example"
   },
   "problem": {
    "en": "Silicon (nᵢ = 1.5 × 10¹⁰ cm⁻³) is doped with 10¹⁶ phosphorus atoms per cm³. Find the electron and hole concentrations at room temperature."
   },
   "steps": [
    {
     "en": "Phosphorus is a donor, so the crystal is n-type and n ≈ N_D = 10¹⁶ cm⁻³."
    },
    {
     "en": "Mass action law: p = nᵢ²/n = (1.5 × 10¹⁰)²/10¹⁶."
    },
    {
     "en": "p = 2.25 × 10²⁰ / 10¹⁶ = 2.25 × 10⁴ cm⁻³."
    }
   ],
   "answer": {
    "en": "n = 10¹⁶ cm⁻³ (majority); p = 2.25 × 10⁴ cm⁻³ (minority)"
   },
   "narration": {
    "en": "Let us solve this together. Silicon (nᵢ = 1.5 × 10¹⁰ cm⁻³) is doped with 10¹⁶ phosphorus atoms per cm³. Find the electron and hole concentrations at room temperature."
   }
  },
