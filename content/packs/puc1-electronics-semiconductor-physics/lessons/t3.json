 "title": {
  "en": "Extrinsic semiconductors: n-type and p-type",
  "kn": "ಬಾಹ್ಯ ಅರೆವಾಹಕಗಳು: n-ವಿಧ ಮತ್ತು p-ವಿಧ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "One atom in a million",
    "kn": "ಹತ್ತು ಲಕ್ಷದಲ್ಲಿ ಒಂದು ಪರಮಾಣು"
   },
   "hook": {
    "en": "Add about one impurity atom for every million silicon atoms and the conductivity can rise by a factor of a thousand or more. This is doping.",
    "kn": "ಪ್ರತಿ ಹತ್ತು ಲಕ್ಷ ಸಿಲಿಕಾನ್ ಪರಮಾಣುಗಳಿಗೆ ಒಂದು ಅಪದ್ರವ್ಯ ಪರಮಾಣು ಸೇರಿಸಿದರೆ ವಾಹಕತೆ ಸಾವಿರ ಪಟ್ಟು ಅಥವಾ ಹೆಚ್ಚು ಏರಬಹುದು. ಇದೇ ಡೋಪಿಂಗ್."
   },
   "objectives": [
    {
     "en": "Explain doping with donor and acceptor impurities"
    },
    {
     "en": "Identify majority and minority carriers"
    },
    {
     "en": "Use the mass action law np = nᵢ²"
    }
   ],
   "narration": {
    "en": "Add about one impurity atom for every million silicon atoms and the conductivity can rise by a factor of a thousand or more. This is doping.",
    "kn": "ಪ್ರತಿ ಹತ್ತು ಲಕ್ಷ ಸಿಲಿಕಾನ್ ಪರಮಾಣುಗಳಿಗೆ ಒಂದು ಅಪದ್ರವ್ಯ ಪರಮಾಣು ಸೇರಿಸಿದರೆ ವಾಹಕತೆ ಸಾವಿರ ಪಟ್ಟು ಅಥವಾ ಹೆಚ್ಚು ಏರಬಹುದು. ಇದೇ ಡೋಪಿಂಗ್."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Donors make n-type, acceptors make p-type"
   },
   "body": {
    "en": "Doping is adding a tiny, controlled amount of impurity to a pure semiconductor. A pentavalent impurity (phosphorus, arsenic, antimony) uses four electrons in bonds and donates the fifth: it is a donor, and the crystal is n-type with electrons as majority carriers. A trivalent impurity (boron, aluminium, gallium, indium) completes only three bonds and leaves a hole: it is an acceptor, and the crystal is p-type with holes as majority carriers."
   },
   "points": [
    {
     "en": "Donors (group 15): P, As, Sb → n-type"
    },
    {
     "en": "Acceptors (group 13): B, Al, Ga, In → p-type"
    },
    {
     "en": "The crystal stays electrically neutral"
    }
   ],
   "narration": {
    "en": "Pentavalent donors such as phosphorus give an extra electron and make n-type. Trivalent acceptors such as boron leave a hole and make p-type.",
    "kn": "ಫಾಸ್ಫರಸ್‌ನಂತಹ ಪಂಚವೇಲೆನ್ಸೀಯ ದಾನಿಗಳು ಹೆಚ್ಚುವರಿ ಎಲೆಕ್ಟ್ರಾನ್ ನೀಡಿ n-ವಿಧ ಮಾಡುತ್ತವೆ. ಬೋರಾನ್‌ನಂತಹ ತ್ರಿವೇಲೆನ್ಸೀಯ ಸ್ವೀಕಾರಕಗಳು ರಂಧ್ರ ಬಿಟ್ಟು p-ವಿಧ ಮಾಡುತ್ತವೆ."
   }
  },
