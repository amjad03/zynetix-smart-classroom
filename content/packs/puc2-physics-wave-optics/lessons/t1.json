  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Ripples that make new ripples",
    "kn": "ಹೊಸ ಅಲೆಗಳನ್ನು ಹುಟ್ಟಿಸುವ ಅಲೆಗಳು"
   },
   "hook": {
    "en": "Drop a stone in a pond and circles spread out. Huygens imagined that every point on a circle starts its own tiny ripple, and that explains how light travels.",
    "kn": "ಕೊಳಕ್ಕೆ ಕಲ್ಲು ಹಾಕಿದರೆ ವೃತ್ತಾಕಾರದ ಅಲೆಗಳು ಹರಡುತ್ತವೆ. ವೃತ್ತದ ಪ್ರತಿಯೊಂದು ಬಿಂದುವೂ ಹೊಸ ಚಿಕ್ಕ ಅಲೆಯನ್ನು ಹುಟ್ಟಿಸುತ್ತದೆ ಎಂದು ಹೈಗೆನ್ಸ್ ಊಹಿಸಿದರು."
   },
   "objectives": [
    {
     "en": "Define a wavefront"
    },
    {
     "en": "Identify spherical, cylindrical and plane wavefronts"
    },
    {
     "en": "State Huygens principle"
    }
   ],
   "narration": {
    "en": "Drop a stone in a pond and circles spread out. Huygens imagined that every point on a circle starts its own tiny ripple, and that explains how light travels.",
    "kn": "ಕೊಳಕ್ಕೆ ಕಲ್ಲು ಹಾಕಿದರೆ ವೃತ್ತಾಕಾರದ ಅಲೆಗಳು ಹರಡುತ್ತವೆ. ವೃತ್ತದ ಪ್ರತಿಯೊಂದು ಬಿಂದುವೂ ಹೊಸ ಚಿಕ್ಕ ಅಲೆಯನ್ನು ಹುಟ್ಟಿಸುತ್ತದೆ ಎಂದು ಹೈಗೆನ್ಸ್ ಊಹಿಸಿದರು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Wavefronts"
   },
   "body": {
    "en": "A wavefront is a surface on which the disturbance has the same phase at a given time. A point source gives spherical wavefronts, a linear source gives cylindrical ones, and far from any source a small part of the wavefront is plane. Rays are normal to the wavefronts, and the wavefront moves with the wave speed.",
    "kn": "ಒಂದೇ ಕಲೆಯಲ್ಲಿ ಕಂಪಿಸುವ ಬಿಂದುಗಳ ಮೇಲ್ಮೈಯೇ ತರಂಗಮುಖ. ಬಿಂದು ಆಕರ: ಗೋಳೀಯ; ರೇಖಾ ಆಕರ: ಸಿಲಿಂಡರಾಕಾರ; ದೂರದಲ್ಲಿ: ಸಮತಲ. ಕಿರಣ ತರಂಗಮುಖಕ್ಕೆ ಲಂಬ."
   },
   "points": [
    {
     "en": "Point source → spherical"
    },
    {
     "en": "Line source → cylindrical"
    },
    {
     "en": "Distant source → plane"
    },
    {
     "en": "Ray ⊥ wavefront"
    }
   ],
   "narration": {
    "en": "A wavefront is a surface on which the disturbance has the same phase at a given time. A point source gives spherical wavefronts, a linear source gives cylindrical ones, and far from any source a small part of the wavefront is plane. Rays are normal to the wavefronts, and the wavefront moves with the wave speed.",
    "kn": "ಒಂದೇ ಕಲೆಯಲ್ಲಿ ಕಂಪಿಸುವ ಬಿಂದುಗಳ ಮೇಲ್ಮೈಯೇ ತರಂಗಮುಖ. ಬಿಂದು ಆಕರ: ಗೋಳೀಯ; ರೇಖಾ ಆಕರ: ಸಿಲಿಂಡರಾಕಾರ; ದೂರದಲ್ಲಿ: ಸಮತಲ. ಕಿರಣ ತರಂಗಮುಖಕ್ಕೆ ಲಂಬ."
   }
  },
