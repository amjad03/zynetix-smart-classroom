  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A plane wavefront moves through water (n = 4/3). How far do the secondary wavelets spread in 1 ns?"
   },
   "steps": [
    {
     "en": "v = c/n = 3 × 10⁸/(4/3) = 2.25 × 10⁸ m/s."
    },
    {
     "en": "Radius = vt = 2.25 × 10⁸ × 10⁻⁹ = 0.225 m."
    }
   ],
   "answer": {
    "en": "22.5 cm"
   },
   "narration": {
    "en": "Let us solve this together. A plane wavefront moves through water (n = 4/3). How far do the secondary wavelets spread in 1 ns?"
   }
