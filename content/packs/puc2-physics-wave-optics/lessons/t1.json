  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Huygens principle"
   },
   "body": {
    "en": "Each point on a wavefront acts as a source of secondary wavelets that spread out with the speed of the wave. After a time $t$, the new wavefront is the forward envelope (common tangent) of all wavelets of radius $vt$. The backward wave is ignored.",
    "kn": "ತರಂಗಮುಖದ ಪ್ರತಿಯೊಂದು ಬಿಂದುವೂ ದ್ವಿತೀಯಕ ಅಲೆಗಳ ಆಕರ. t ಕಾಲದ ನಂತರ ಈ ಅಲೆಗಳ ಮುಂಭಾಗದ ಸಾಮಾನ್ಯ ಸ್ಪರ್ಶಕವೇ ಹೊಸ ತರಂಗಮುಖ."
   },
   "points": [
    {
     "en": "Wavelet radius = vt"
    },
    {
     "en": "New wavefront = forward envelope"
    }
   ],
   "narration": {
    "en": "Each point on a wavefront acts as a source of secondary wavelets that spread out with the speed of the wave. After a time t, the new wavefront is the forward envelope (common tangent) of all wavelets of radius vt. The backward wave is ignored.",
    "kn": "ತರಂಗಮುಖದ ಪ್ರತಿಯೊಂದು ಬಿಂದುವೂ ದ್ವಿತೀಯಕ ಅಲೆಗಳ ಆಕರ. t ಕಾಲದ ನಂತರ ಈ ಅಲೆಗಳ ಮುಂಭಾಗದ ಸಾಮಾನ್ಯ ಸ್ಪರ್ಶಕವೇ ಹೊಸ ತರಂಗಮುಖ."
   }
  },
