{
 "chapterId": "puc2-physics-10-wave-optics",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-10-wave-optics.t1",
   "name": {
    "en": "Huygens' principle"
   },
   "tex": "\\text{Every point of a wavefront is a source of secondary wavelets; new wavefront = forward envelope}",
   "note": {
    "en": "Rays are normal to wavefronts. Point source → spherical, line source → cylindrical, distant source → plane."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-10-wave-optics.t2",
   "name": {
    "en": "Refraction (wave theory)"
   },
   "tex": "\\dfrac{\\sin i}{\\sin r} = \\dfrac{v_1}{v_2} = \\dfrac{n_2}{n_1} = \\dfrac{\\lambda_1}{\\lambda_2}",
   "note": {
    "en": "Frequency is unchanged at a boundary."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Doppler shift of light"
   },
   "tex": "\\dfrac{\\Delta\\lambda}{\\lambda} = \\dfrac{v_r}{c}\\ (v \\ll c)",
   "note": {
    "en": "Red-shift: receding; blue-shift: approaching."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-10-wave-optics.t3",
   "name": {
    "en": "Phase and path difference"
   },
   "tex": "\\phi = \\dfrac{2\\pi}{\\lambda}\\,\\Delta x"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Resultant amplitude and intensity"
   },
   "tex": "A^2 = a_1^2 + a_2^2 + 2a_1a_2\\cos\\phi,\\qquad I = I_1 + I_2 + 2\\sqrt{I_1I_2}\\cos\\phi"
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Identical sources"
   },
   "tex": "I = 4I_0\\cos^2\\dfrac\\phi2 = I_{\\max}\\cos^2\\dfrac\\phi2"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-10-wave-optics.t3",
   "name": {
    "en": "Maxima / minima ratio"
   },
   "tex": "\\dfrac{I_{\\max}}{I_{\\min}} = \\left(\\dfrac{\\sqrt{I_1} + \\sqrt{I_2}}{\\sqrt{I_1} - \\sqrt{I_2}}\\right)^2",
   "note": {
    "en": "Intensity ∝ slit width ∝ amplitude²."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Conditions (YDSE)"
   },
   "tex": "\\text{bright: } \\Delta x = n\\lambda;\\quad \\text{dark: } \\Delta x = (2n - 1)\\dfrac\\lambda2;\\quad \\Delta x = \\dfrac{yd}{D}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-10-wave-optics.t3",
   "name": {
    "en": "Fringe positions and width"
   },
   "tex": "y_n = \\dfrac{n\\lambda D}{d},\\quad y'_n = \\dfrac{(2n - 1)\\lambda D}{2d},\\quad \\beta = \\dfrac{\\lambda D}{d},\\quad \\theta_\\beta = \\dfrac\\lambda d"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-10-wave-optics.t2",
   "name": {
    "en": "YDSE in a medium"
   },
   "tex": "\\beta' = \\dfrac{\\beta}{n}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-10-wave-optics.t3",
   "name": {
    "en": "Thin sheet over one slit"
   },
   "tex": "\\text{shift} = \\dfrac{(\\mu - 1)tD}{d} = \\dfrac{(\\mu - 1)t}{\\lambda}\\,\\beta",
   "note": {
    "en": "Pattern shifts towards the covered slit; fringe width unchanged."
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Shifted source / oblique beam"
   },
   "tex": "\\text{source up by } y \\Rightarrow \\text{centre down by } \\dfrac{yD}{L};\\quad \\text{oblique beam at } \\theta \\Rightarrow \\text{central max at } \\theta"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-10-wave-optics.t3",
   "name": {
    "en": "Coinciding bright fringes"
   },
   "tex": "n_1\\lambda_1 = n_2\\lambda_2"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-10-wave-optics.t4",
   "name": {
    "en": "Single-slit diffraction"
   },
   "tex": "\\text{minima: } a\\sin\\theta = n\\lambda;\\quad \\text{secondary maxima} \\approx \\left(n + \\tfrac12\\right)\\lambda"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-10-wave-optics.t4",
   "name": {
    "en": "Central maximum width"
   },
   "tex": "2\\theta = \\dfrac{2\\lambda}{a},\\qquad W = \\dfrac{2\\lambda D}{a}",
   "note": {
    "en": "Twice the width of a secondary maximum; secondary maxima weaken with order."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Fresnel distance"
   },
   "tex": "z_F = \\dfrac{a^2}{\\lambda}",
   "note": {
    "en": "Ray optics is valid for distances much less than z_F."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-10-wave-optics.t4",
   "name": {
    "en": "Fringes inside central diffraction envelope"
   },
   "tex": "|m| < \\dfrac da \\Rightarrow N = 2\\dfrac da - 1\\ (\\text{integer } d/a)"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Resolving power"
   },
   "tex": "\\Delta\\theta_{\\text{telescope}} = \\dfrac{1.22\\lambda}{D},\\qquad d_{\\min}^{\\text{microscope}} = \\dfrac{1.22\\lambda}{2n\\sin\\beta}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-10-wave-optics.t5",
   "name": {
    "en": "Malus' law"
   },
   "tex": "I = I_0\\cos^2\\theta",
   "note": {
    "en": "Unpolarised light through one polaroid: I₀/2 for any orientation."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-10-wave-optics.t5",
   "name": {
    "en": "Polaroid between crossed polaroids"
   },
   "tex": "I = \\dfrac{I_0}{8}\\sin^2 2\\theta",
   "note": {
    "en": "Rotating at ω: intensity varies at 4ω."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-physics-10-wave-optics.t5",
   "name": {
    "en": "Brewster's law"
   },
   "tex": "\\tan\\theta_B = n,\\qquad \\theta_B + r = 90^\\circ",
   "note": {
    "en": "Reflected light fully polarised perpendicular to the plane of incidence."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-physics-10-wave-optics.t3",
   "name": {
    "en": "Coherence"
   },
   "tex": "\\text{same frequency and constant phase difference}",
   "note": {
    "en": "Two independent lamps are incoherent — no steady fringes."
   }
  }
 ]
}
