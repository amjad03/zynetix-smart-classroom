[
 {
  "id": "2t06-q01",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t1",
  "stem": {
   "en": "X follows a binomial distribution with n = 10 and p = 0.3. The mean of X is:"
  },
  "options": [
   {
    "en": "0.3"
   },
   {
    "en": "7"
   },
   {
    "en": "2.1"
   },
   {
    "en": "3"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Mean = np = 10 × 0.3 = 3. (2.1 is the variance npq.)"
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t06-q02",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t1",
  "stem": {
   "en": "For any binomial distribution with 0 < p < 1, which statement is always true?"
  },
  "options": [
   {
    "en": "Mean equals variance"
   },
   {
    "en": "Mean is less than variance"
   },
   {
    "en": "Mean is greater than variance"
   },
   {
    "en": "Variance is greater than n"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Variance = npq = mean × q, and q < 1, so the variance is always less than the mean."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t06-q03",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t1",
  "stem": {
   "en": "A fair coin is tossed 5 times. The probability of getting exactly 2 heads is:"
  },
  "options": [
   {
    "en": "5/32"
   },
   {
    "en": "1/32"
   },
   {
    "en": "3/16"
   },
   {
    "en": "5/16"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "P(X = 2) = 5C2 (1/2)^5 = 10/32 = 5/16 (= 0.3125)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t06-q04",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t1",
  "stem": {
   "en": "The mean and variance of a binomial distribution are 4 and 3. The parameters n and p are:"
  },
  "options": [
   {
    "en": "n = 12, p = 1/3"
   },
   {
    "en": "n = 8, p = 1/2"
   },
   {
    "en": "n = 16, p = 1/4"
   },
   {
    "en": "n = 16, p = 3/4"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "q = variance/mean = 3/4, so p = 1/4 and n = mean/p = 4 ÷ 1/4 = 16."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [],
  "solution": [
   {
    "en": "q = variance/mean = 3/4, so p = 1/4 and n = mean/p = 4 ÷ 1/4 = 16."
   }
  ]
 },
 {
  "id": "2t06-q05",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t1",
  "stem": {
   "en": "A binomial variate X has mean 6 and variance 2. P(X = 9) is:"
  },
  "options": [
   {
    "en": "9 (2/3)^8 (1/3)"
   },
   {
    "en": "(2/3)^9"
   },
   {
    "en": "(1/3)^9"
   },
   {
    "en": "(2/3)^6"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "q = 2/6 = 1/3, p = 2/3, n = 6 ÷ (2/3) = 9. P(X = 9) = 9C9 p^9 = (2/3)^9 ≈ 0.0260."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t06-q06",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t2",
  "stem": {
   "en": "A Poisson variate has mean 4. Its standard deviation is:"
  },
  "options": [
   {
    "en": "16"
   },
   {
    "en": "2"
   },
   {
    "en": "4"
   },
   {
    "en": "1"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "In a Poisson distribution mean = variance = λ = 4, so s.d. = √4 = 2."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t06-q07",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t2",
  "stem": {
   "en": "The Poisson distribution is a limiting case of the binomial distribution when:"
  },
  "options": [
   {
    "en": "n → ∞, p → 1 and np stays finite"
   },
   {
    "en": "n → 0 and p → ∞"
   },
   {
    "en": "n → ∞, p → 0 and np = λ stays finite"
   },
   {
    "en": "n is small and p = 0.5"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Rare events in a very large number of trials: n large, p small, np = λ finite."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t06-q08",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t2",
  "stem": {
   "en": "For a Poisson variate with λ = 2, P(X = 0) is (e⁻² = 0.1353):"
  },
  "options": [
   {
    "en": "0.5000"
   },
   {
    "en": "0.1353"
   },
   {
    "en": "0.2707"
   },
   {
    "en": "0.8647"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "P(X = 0) = e^(−λ) = e^(−2) = 0.1353. (0.2707 is P(X = 1); 0.8647 is P(X ≥ 1).)"
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t06-q09",
  "chapterId": "puc2-statistics-06-theoretical-distributions",
  "topicId": "puc2-statistics-06-theoretical-distributions.t2",
  "stem": {
   "en": "For a Poisson variate X, P(X = 1) = P(X = 2). The mean of X is:"
  },
  "options": [
   {
    "en": "4"
   },
   {
    "en": "2"
   },
   {
    "en": "1/2"
   },
   {
    "en": "1"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "e^(−λ) λ = e^(−λ) λ²/2 gives λ = 2."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": [],
  "solution": [
   {
    "en": "e^(−λ) λ = e^(−λ) λ²/2 gives λ = 2."
   }
  ]
 },
 {
