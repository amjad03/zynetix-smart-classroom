{
 "chapterId": "puc1-physics-14-waves",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-physics-14-waves.t1",
   "name": {
    "en": "Progressive wave"
   },
   "tex": "y = A\\sin(kx - \\omega t + \\phi)",
   "note": {
    "en": "kx − ωt: travels along +x; kx + ωt: along −x. Any f(x ∓ vt) is a wave."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-14-waves.t2",
   "name": {
    "en": "Wave relations"
   },
   "tex": "k = \\dfrac{2\\pi}{\\lambda},\\quad \\omega = 2\\pi\\nu,\\quad v = \\nu\\lambda = \\dfrac\\omega k"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Phase difference and path difference"
   },
   "tex": "\\Delta\\phi = \\dfrac{2\\pi}{\\lambda}\\Delta x,\\qquad \\Delta\\phi = \\omega\\Delta t"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-14-waves.t1",
   "name": {
    "en": "Particle velocity"
   },
   "tex": "v_p = \\dfrac{\\partial y}{\\partial t},\\quad v_{p,\\max} = A\\omega,\\quad \\dfrac{v_{p,\\max}}{v} = Ak"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-14-waves.t3",
   "name": {
    "en": "Transverse waves on a string"
   },
   "tex": "v = \\sqrt{\\dfrac T\\mu}",
   "note": {
    "en": "μ = mass per unit length. Hanging rope: v = √(gy), time to climb = 2√(L/g)."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-14-waves.t1",
   "name": {
    "en": "Longitudinal waves"
   },
   "tex": "v = \\sqrt{\\dfrac B\\rho}\\ (\\text{fluid}),\\qquad v = \\sqrt{\\dfrac Y\\rho}\\ (\\text{thin rod})"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-14-waves.t3",
   "name": {
    "en": "Speed of sound in a gas (Laplace)"
   },
   "tex": "v = \\sqrt{\\dfrac{\\gamma P}{\\rho}} = \\sqrt{\\dfrac{\\gamma RT}{M}}",
   "note": {
    "en": "Newton's isothermal √(P/ρ) gives about 280 m s⁻¹ for air — too low."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-physics-14-waves.t3",
   "name": {
    "en": "Temperature dependence"
   },
   "tex": "v \\propto \\sqrt T,\\qquad v_t \\approx v_0 + 0.61\\,t\\ \\text{m s}^{-1}\\ (\\text{air},\\ t \\text{ in } ^\\circ\\text{C})",
   "note": {
    "en": "Independent of pressure at constant T; increases with humidity."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-14-waves.t2",
   "name": {
    "en": "Pressure amplitude"
   },
   "tex": "\\Delta P_0 = Bks_0",
   "note": {
    "en": "Pressure wave is π/2 out of phase with the displacement wave."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "Superposition (same ω, k)"
   },
   "tex": "A_R = \\sqrt{A_1^2 + A_2^2 + 2A_1A_2\\cos\\phi};\\quad \\text{equal } A:\\ A_R = 2A\\cos(\\phi/2)"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Intensity extremes"
   },
   "tex": "\\dfrac{I_{\\max}}{I_{\\min}} = \\left(\\dfrac{\\sqrt{I_1} + \\sqrt{I_2}}{\\sqrt{I_1} - \\sqrt{I_2}}\\right)^2"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "Reflection"
   },
   "tex": "\\text{rigid end / denser medium: phase change } \\pi;\\quad \\text{free end / rarer medium: } 0"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "Stationary wave"
   },
   "tex": "y = 2A\\sin kx\\cos\\omega t",
   "note": {
    "en": "Nodes λ/2 apart; node to antinode λ/4; no net energy transport."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "String fixed at both ends"
   },
   "tex": "\\nu_n = \\dfrac{n v}{2L} = \\dfrac{n}{2L}\\sqrt{\\dfrac T\\mu},\\quad n = 1, 2, 3, \\dots",
   "note": {
    "en": "All harmonics; n loops in the n-th mode."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "Open pipe"
   },
   "tex": "\\nu_n = \\dfrac{nv}{2L},\\quad n = 1, 2, 3, \\dots",
   "note": {
    "en": "Displacement antinodes at both ends."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "Closed pipe"
   },
   "tex": "\\nu_n = \\dfrac{(2n - 1)v}{4L}",
   "note": {
    "en": "Only odd harmonics; displacement node / pressure antinode at the closed end."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-14-waves.t4",
   "name": {
    "en": "End correction and resonance tube"
   },
   "tex": "L + e = \\dfrac\\lambda4,\\quad e \\approx 0.6r,\\quad \\lambda = 2(l_2 - l_1),\\quad e = \\dfrac{l_2 - 3l_1}{2}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-14-waves.t5",
   "name": {
    "en": "Beats"
   },
   "tex": "\\nu_{\\text{beat}} = |\\nu_1 - \\nu_2|",
   "note": {
    "en": "Waxing a fork lowers its frequency; filing raises it."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-14-waves.t3",
   "name": {
    "en": "Doppler effect (sound)"
   },
   "tex": "\\nu' = \\nu\\,\\dfrac{v + v_o}{v - v_s}",
   "note": {
    "en": "Signs for observer moving towards / source moving towards the other; reverse signs for 'away'."
   }
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Echo from a wall approached at speed u"
   },
   "tex": "\\nu'' = \\nu\\,\\dfrac{v + u}{v - u}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-14-waves.t3",
   "name": {
    "en": "Thermal tension in a clamped wire"
   },
   "tex": "T = YA\\alpha\\Delta\\theta \\Rightarrow v = \\sqrt{\\dfrac{Y\\alpha\\Delta\\theta}{\\rho}}"
  }
 ]
}
