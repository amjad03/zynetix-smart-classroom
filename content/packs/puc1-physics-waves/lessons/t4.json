 "title": {
  "en": "Superposition, reflection and standing waves",
  "kn": "ಅಧ್ಯಾರೋಪಣ ತತ್ವ, ತರಂಗಗಳ ಪ್ರತಿಫಲನ ಮತ್ತು ನಿಂತ ತರಂಗಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Why does a flute play only certain notes?",
    "kn": "ಕೊಳಲು ಕೆಲವು ಸ್ವರಗಳನ್ನು ಮಾತ್ರ ಏಕೆ ನುಡಿಸುತ್ತದೆ?"
   },
   "hook": {
    "en": "Blow across a bottle and you get one clear note. Add water and the note rises. Waves bouncing back and forth inside fit only certain wavelengths.",
    "kn": "ಬಾಟಲಿಯ ಮೇಲೆ ಊದಿದರೆ ಒಂದು ಸ್ಪಷ್ಟ ಸ್ವರ ಬರುತ್ತದೆ. ನೀರು ಸೇರಿಸಿದರೆ ಸ್ವರ ಏರುತ್ತದೆ. ಒಳಗೆ ಹಿಂದೆ ಮುಂದೆ ಪ್ರತಿಫಲಿಸುವ ತರಂಗಗಳಿಗೆ ಕೆಲವು ತರಂಗದೂರಗಳು ಮಾತ್ರ ಹೊಂದುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "State the principle of superposition"
    },
    {
     "en": "Describe reflection at rigid and open boundaries"
    },
    {
     "en": "Find normal modes of strings and pipes"
    }
   ],
   "narration": {
    "en": "Blow across a bottle and you get one clear note. Add water and the note rises. Waves bouncing back and forth inside fit only certain wavelengths.",
    "kn": "ಬಾಟಲಿಯ ಮೇಲೆ ಊದಿದರೆ ಒಂದು ಸ್ಪಷ್ಟ ಸ್ವರ ಬರುತ್ತದೆ. ನೀರು ಸೇರಿಸಿದರೆ ಸ್ವರ ಏರುತ್ತದೆ. ಒಳಗೆ ಹಿಂದೆ ಮುಂದೆ ಪ್ರತಿಫಲಿಸುವ ತರಂಗಗಳಿಗೆ ಕೆಲವು ತರಂಗದೂರಗಳು ಮಾತ್ರ ಹೊಂದುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Superposition and reflection"
   },
   "body": {
    "en": "When two or more waves overlap, the resultant displacement is the algebraic sum of the individual displacements: y = y₁ + y₂. In phase they add (constructive interference); out of phase by π they cancel (destructive). A wave reflected from a rigid boundary returns with a phase change of π (a crest returns as a trough). At an open boundary it reflects with no phase change.",
    "kn": "ತರಂಗಗಳು ಅತಿಕ್ರಮಿಸಿದಾಗ ಫಲಿತ ಸ್ಥಾನಪಲ್ಲಟ ಪ್ರತ್ಯೇಕ ಸ್ಥಾನಪಲ್ಲಟಗಳ ಬೀಜಗಣಿತ ಮೊತ್ತ. ದೃಢ ಗಡಿಯಿಂದ ಪ್ರತಿಫಲನದಲ್ಲಿ π ಹಂತ ಬದಲಾವಣೆ; ತೆರೆದ ಗಡಿಯಲ್ಲಿ ಇಲ್ಲ."
   },
   "points": [
    {
     "en": "y = y₁ + y₂"
    },
    {
     "en": "Rigid boundary: phase change π"
    },
    {
     "en": "Open boundary: no phase change"
    }
   ],
   "narration": {
    "en": "When two or more waves overlap, the resultant displacement is the algebraic sum of the individual displacements: y = y₁ + y₂. In phase they add (constructive interference); out of phase by π they cancel (destructive). A wave reflected from a rigid boundary returns with a phase change of π (a crest returns as a trough). At an open boundary it reflects with no phase change.",
    "kn": "ತರಂಗಗಳು ಅತಿಕ್ರಮಿಸಿದಾಗ ಫಲಿತ ಸ್ಥಾನಪಲ್ಲಟ ಪ್ರತ್ಯೇಕ ಸ್ಥಾನಪಲ್ಲಟಗಳ ಬೀಜಗಣಿತ ಮೊತ್ತ. ದೃಢ ಗಡಿಯಿಂದ ಪ್ರತಿಫಲನದಲ್ಲಿ π ಹಂತ ಬದಲಾವಣೆ; ತೆರೆದ ಗಡಿಯಲ್ಲಿ ಇಲ್ಲ."
   },
   "formula": "y = y_1 + y_2"
  },
