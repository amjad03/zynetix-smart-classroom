   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Write the truth table of Y = A·B + Ā (inputs A and B)."
   },
   "steps": [
    {
     "en": "A = 0, B = 0: 0 + 1 = 1."
    },
    {
     "en": "A = 0, B = 1: 0 + 1 = 1."
    },
    {
     "en": "A = 1, B = 0: 0 + 0 = 0."
    },
    {
     "en": "A = 1, B = 1: 1 + 0 = 1."
    }
   ],
   "answer": {
    "en": "Y = 1, 1, 0, 1"
   },
   "narration": {
    "en": "Let us solve this together. Write the truth table of Y = A·B + Ā (inputs A and B)."
