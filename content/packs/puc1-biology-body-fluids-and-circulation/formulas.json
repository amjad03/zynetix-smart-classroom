{
 "chapterId": "puc1-biology-15-body-fluids-and-circulation",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t5",
   "name": {
    "en": "Cardiac output"
   },
   "tex": "CO = SV\\times HR \\approx 70\\ \\text{mL}\\times72 \\approx 5\\ \\text{L/min}",
   "note": {
    "en": "Doubles+ during exercise."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Vital capacity"
   },
   "tex": "VC = TV + IRV + ERV",
   "note": {
    "en": "≈ 3.5–4.5 L."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Total lung capacity"
   },
   "tex": "TLC = VC + RV",
   "note": {
    "en": "TV ≈ 500 mL, RV ≈ 1.1–1.2 L."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Glomerular filtration rate"
   },
   "tex": "GFR \\approx 125\\ \\text{mL/min} \\approx 180\\ \\text{L/day}",
   "note": {
    "en": "≈ 99% reabsorbed."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t1",
   "name": {
    "en": "Blood counts"
   },
   "tex": "\\text{RBC} \\approx 5\\text{–}5.5\\times10^6,\\ \\text{WBC} \\approx 6\\text{–}8\\times10^3\\ \\text{per mm}^3",
   "note": {
    "en": "Platelets 1.5–3.5 lakh/mm³."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t2",
   "name": {
    "en": "O₂ delivery"
   },
   "tex": "\\approx 5\\ \\text{mL O}_2\\ \\text{per 100 mL blood}",
   "note": {
    "en": "Under normal resting conditions."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "CO₂ transport"
   },
   "tex": "70\\%\\ \\text{HCO}_3^-,\\ 20\\text{–}25\\%\\ \\text{carbamino},\\ 7\\%\\ \\text{dissolved}",
   "note": {
    "en": "Carbonic anhydrase in RBCs."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t3",
   "name": {
    "en": "Resting membrane potential"
   },
   "tex": "\\approx -70\\ \\text{mV}",
   "note": {
    "en": "Maintained by Na⁺/K⁺ pump (3 Na⁺ out, 2 K⁺ in)."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Blood composition"
   },
   "tex": "\\text{Plasma } 55\\%,\\ \\text{formed elements } 45\\%;\\ \\text{plasma water } 90\\text{–}92\\%,\\ \\text{proteins } 6\\text{–}8\\%"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t1",
   "name": {
    "en": "Plasma proteins"
   },
   "tex": "\\text{Fibrinogen: clotting; globulins: defence; albumins: osmotic balance}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t1",
   "name": {
    "en": "Serum"
   },
   "tex": "\\text{Serum} = \\text{plasma} - \\text{clotting factors}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "RBC count and life"
   },
   "tex": "5\\text{–}5.5 \\times 10^6\\ \\text{mm}^{-3};\\ 120\\ \\text{days};\\ \\text{destroyed in spleen}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t1",
   "name": {
    "en": "Haemoglobin"
   },
   "tex": "12\\text{–}16\\ \\text{g per } 100\\ \\text{mL}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t1",
   "name": {
    "en": "WBC count"
   },
   "tex": "6000\\text{–}8000\\ \\text{mm}^{-3}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t1",
   "name": {
    "en": "Differential WBC"
   },
   "tex": "N\\,60\\text{–}65 > L\\,20\\text{–}25 > M\\,6\\text{–}8 > E\\,2\\text{–}3 > B\\,0.5\\text{–}1\\ (\\%)",
   "note": {
    "en": "Neutrophils + monocytes phagocytic; basophils release histamine, serotonin, heparin."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Platelets"
   },
   "tex": "1.5\\text{–}3.5 \\times 10^5\\ \\text{mm}^{-3};\\ \\text{from megakaryocytes}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t2",
   "name": {
    "en": "ABO groups"
   },
   "tex": "\\begin{array}{lll} A & \\text{antigen A} & \\text{anti-B} \\\\ B & \\text{antigen B} & \\text{anti-A} \\\\ AB & A,B & \\text{none} \\\\ O & \\text{none} & \\text{anti-A, anti-B} \\end{array}",
   "note": {
    "en": "O universal donor; AB universal recipient."
   }
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Rh factor"
   },
   "tex": "\\approx 80\\%\\ \\text{Rh}^+;\\ \\text{Rh}^- \\text{ mother} \\times \\text{Rh}^+ \\text{ foetus} \\Rightarrow \\text{erythroblastosis foetalis}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t2",
   "name": {
    "en": "Coagulation"
   },
   "tex": "\\text{Prothrombin} \\xrightarrow{\\text{thrombokinase}} \\text{thrombin};\\ \\text{fibrinogen} \\xrightarrow{\\text{thrombin}} \\text{fibrin}",
   "note": {
    "en": "Ca²⁺ essential."
   }
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Heart chambers"
   },
   "tex": "\\text{Fish 2; amphibians, reptiles 3; crocodiles, birds, mammals 4}"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Circulation types"
   },
   "tex": "\\text{Fish: single; amphibians/reptiles: incomplete double; birds/mammals: double}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Valves"
   },
   "tex": "\\text{Right AV: tricuspid; left AV: bicuspid (mitral); semilunar at aorta \\& pulmonary artery}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t3",
   "name": {
    "en": "Conducting system"
   },
   "tex": "SAN \\to AVN \\to \\text{bundle of His} \\to \\text{bundle branches} \\to \\text{Purkinje fibres}",
   "note": {
    "en": "SAN (pacemaker) fires 70–75 min⁻¹."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t4",
   "name": {
    "en": "Cardiac cycle"
   },
   "tex": "T = \\dfrac{60}{72} \\approx 0.8\\ \\text{s}"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t5",
   "name": {
    "en": "Cardiac output"
   },
   "tex": "CO = SV \\times HR \\approx 70 \\times 72 \\approx 5\\ \\text{L min}^{-1}"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Ventricular filling"
   },
   "tex": "\\approx 70\\%\\ \\text{passive (joint diastole)} + 30\\%\\ \\text{atrial systole}"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Heart sounds"
   },
   "tex": "\\text{Lub: AV valves close; dub: semilunar valves close}"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t4",
   "name": {
    "en": "ECG"
   },
   "tex": "P: \\text{atrial depolarisation};\\ QRS: \\text{ventricular depolarisation};\\ T: \\text{ventricular repolarisation}",
   "note": {
    "en": "End of T = end of systole; heart rate = QRS count per minute."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t5",
   "name": {
    "en": "Neural regulation"
   },
   "tex": "\\text{Sympathetic} \\uparrow HR, CO;\\ \\text{parasympathetic} \\downarrow;\\ \\text{centre in medulla}"
  },
  {
   "id": "zs-f30",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t5",
   "name": {
    "en": "Blood pressure"
   },
   "tex": "\\text{Normal } 120/80;\\ \\text{hypertension} \\ge 140/90\\ \\text{mm Hg}"
  },
  {
   "id": "zs-f31",
   "topicId": "puc1-biology-15-body-fluids-and-circulation.t2",
   "name": {
    "en": "Lymph"
   },
   "tex": "\\text{Lacteals in villi absorb fats}"
  }
 ]
}
