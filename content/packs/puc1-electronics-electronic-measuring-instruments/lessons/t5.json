 "topicId": "puc1-electronics-11-electronic-measuring-instruments.t5",
 "title": {
  "en": "Measurements with the CRO and the function generator",
  "kn": "CRO ಮತ್ತು ಫಂಕ್ಷನ್ ಜನರೇಟರ್‌ನಿಂದ ಅಳತೆಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Count the boxes",
    "kn": "ಚೌಕಗಳನ್ನು ಎಣಿಸಿ"
   },
   "hook": {
    "en": "The CRO screen is a grid of boxes. Count how many boxes a waveform covers, multiply by the knob setting, and you have its voltage and frequency.",
    "kn": "CRO ಪರದೆ ಚೌಕಗಳ ಜಾಲ. ತರಂಗ ಎಷ್ಟು ಚೌಕಗಳನ್ನು ಆವರಿಸುತ್ತದೆ ಎಂದು ಎಣಿಸಿ, ಗುಂಡಿಯ ಸೆಟ್ಟಿಂಗ್‌ನಿಂದ ಗುಣಿಸಿ: ವೋಲ್ಟೇಜ್ ಮತ್ತು ಆವೃತ್ತಿ ಸಿಗುತ್ತವೆ."
   },
   "objectives": [
    {
     "en": "Measure voltage, period and frequency with a CRO"
    },
    {
     "en": "Find frequency ratio and phase with Lissajous figures"
    },
    {
     "en": "Describe the function generator"
    }
   ],
   "narration": {
    "en": "The CRO screen is a grid of boxes. Count how many boxes a waveform covers, multiply by the knob setting, and you have its voltage and frequency.",
    "kn": "CRO ಪರದೆ ಚೌಕಗಳ ಜಾಲ. ತರಂಗ ಎಷ್ಟು ಚೌಕಗಳನ್ನು ಆವರಿಸುತ್ತದೆ ಎಂದು ಎಣಿಸಿ, ಗುಂಡಿಯ ಸೆಟ್ಟಿಂಗ್‌ನಿಂದ ಗುಣಿಸಿ: ವೋಲ್ಟೇಜ್ ಮತ್ತು ಆವೃತ್ತಿ ಸಿಗುತ್ತವೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Measuring voltage and frequency"
   },
   "body": {
    "en": "The screen is marked in divisions (usually 10 across and 8 up). Voltage: $V_{pp}$ = (vertical divisions, peak to peak) × (volts/div setting); then $V_m = V_{pp}/2$ and $V_{rms} = V_m/\\sqrt{2}$ for a sine wave. Time: the period T = (horizontal divisions for one cycle) × (time/div setting), and the frequency f = 1/T. The CRO can also show the shape of a waveform, its rise time and the phase between two signals on a dual-trace screen."
   },
   "points": [
    {
     "en": "V_pp = divisions × V/div"
    },
    {
     "en": "T = divisions × time/div; f = 1/T"
    },
    {
     "en": "V_rms = V_pp/(2√2) for a sine wave"
    }
   ],
   "narration": {
    "en": "Peak-to-peak voltage is the number of vertical divisions times the volts per division. The period is the horizontal divisions times the time per division, and the frequency is one over the period.",
    "kn": "ಶಿಖರದಿಂದ-ಶಿಖರ ವೋಲ್ಟೇಜ್ = ಲಂಬ ವಿಭಾಗಗಳು × ವೋಲ್ಟ್ ಪ್ರತಿ ವಿಭಾಗ. ಆವರ್ತ ಕಾಲ = ಅಡ್ಡ ವಿಭಾಗಗಳು × ಕಾಲ ಪ್ರತಿ ವಿಭಾಗ; ಆವೃತ್ತಿ = 1/ಆವರ್ತ ಕಾಲ."
   },
   "formula": "V_{pp} = n_y \\times (\\text{V/div}),\\qquad f = \\frac{1}{n_x \\times (\\text{time/div})}"
  },
