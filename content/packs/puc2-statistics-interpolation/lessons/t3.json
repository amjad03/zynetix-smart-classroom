  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Find the missing values y₁ and y₄: y₀ = 5, y₁ = ?, y₂ = 15, y₃ = 35, y₄ = ?, y₅ = 135."
   },
   "steps": [
    {
     "en": "Four values known ⇒ assume Δ⁴y₀ = 0 and Δ⁴y₁ = 0."
    },
    {
     "en": "Δ⁴y₀ = 0: y₄ − 4(35) + 6(15) − 4y₁ + 5 = 0 ⇒ y₄ − 4y₁ = 45."
    },
    {
     "en": "Δ⁴y₁ = 0: 135 − 4y₄ + 6(35) − 4(15) + y₁ = 0 ⇒ y₁ − 4y₄ = -285."
    },
    {
     "en": "Solving: y₄ = 4y₁ + 45; y₁ − 4(4y₁ + 45) = -285 ⇒ 15y₁ = 105 ⇒ y₁ = 7, y₄ = 73."
    }
   ],
   "answer": {
    "en": "y₁ = 7, y₄ = 73"
   },
   "narration": {
    "en": "Let us work this out together. Find the missing values y₁ and y₄: y₀ = 5, y₁ = ?, y₂ = 15, y₃ = 35, y₄ = ?, y₅ = 135."
   }
