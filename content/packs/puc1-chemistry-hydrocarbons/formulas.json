{
 "chapterId": "puc1-chemistry-09-hydrocarbons",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Alkane general formula"
   },
   "tex": "\\text{C}_n\\text{H}_{2n+2}",
   "note": {
    "en": "Saturated."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Alkene / cycloalkane"
   },
   "tex": "\\text{C}_n\\text{H}_{2n}",
   "note": {
    "en": "DBE = 1."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Alkyne"
   },
   "tex": "\\text{C}_n\\text{H}_{2n-2}",
   "note": {
    "en": "DBE = 2."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Combustion"
   },
   "tex": "\\text{C}_x\\text{H}_y + \\left(x + \\tfrac y4\\right)\\text{O}_2 \\to x\\text{CO}_2 + \\tfrac y2\\text{H}_2\\text{O}",
   "note": {
    "en": "Use for eudiometry."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Hückel's rule"
   },
   "tex": "\\pi\\ \\text{electrons} = 4n + 2",
   "note": {
    "en": "Aromatic if planar, cyclic, conjugated."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Wurtz reaction"
   },
   "tex": "2\\,\\text{RX} + 2\\,\\text{Na} \\to \\text{R–R} + 2\\,\\text{NaX}",
   "note": {
    "en": "Gives even-carbon alkanes."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Monochlorination products"
   },
   "tex": "\\text{count} = \\text{distinct H environments}",
   "note": {
    "en": "Count chemically different H."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "General formulae"
   },
   "tex": "\\text{alkane } \\text{C}_n\\text{H}_{2n+2};\\ \\text{alkene } \\text{C}_n\\text{H}_{2n};\\ \\text{alkyne } \\text{C}_n\\text{H}_{2n-2}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-09-hydrocarbons.t3",
   "name": {
    "en": "Wurtz reaction"
   },
   "tex": "2\\text{R–X} + 2\\text{Na} \\xrightarrow{\\text{dry ether}} \\text{R–R} + 2\\text{NaX}",
   "note": {
    "en": "Methane cannot be made; mixed halides give mixtures."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Decarboxylation"
   },
   "tex": "\\text{RCOONa} + \\text{NaOH} \\xrightarrow{\\text{CaO},\\,\\Delta} \\text{R–H} + \\text{Na}_2\\text{CO}_3",
   "note": {
    "en": "One carbon fewer than the acid."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Kolbe electrolysis"
   },
   "tex": "2\\text{RCOO}^- \\rightarrow \\text{R–R} + 2\\text{CO}_2 + 2e^- \\ (\\text{anode})",
   "note": {
    "en": "H₂ at cathode. Sodium ethanoate → ethane; propanoate → butane. Methane cannot be made."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Halogenation of alkanes"
   },
   "tex": "\\text{F}_2 > \\text{Cl}_2 > \\text{Br}_2 > \\text{I}_2;\\quad 3^\\circ\\text{H} > 2^\\circ\\text{H} > 1^\\circ\\text{H}",
   "note": {
    "en": "Free-radical chain (initiation, propagation, termination). Iodination is reversible: use HIO₃/HNO₃."
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Product ratio in chlorination"
   },
   "tex": "\\%\\ \\text{product} \\propto (\\text{no. of H}) \\times (\\text{relative reactivity}),\\quad 3^\\circ : 2^\\circ : 1^\\circ = 5 : 3.8 : 1"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Aromatisation and isomerisation"
   },
   "tex": "n\\text{-C}_6\\text{H}_{14} \\xrightarrow[773\\,\\text{K},\\ 10\\text{–}20\\,\\text{atm}]{\\text{Cr}_2\\text{O}_3/\\text{V}_2\\text{O}_5/\\text{Mo}_2\\text{O}_3} \\text{C}_6\\text{H}_6",
   "note": {
    "en": "n-Heptane → toluene. Anhydrous AlCl₃/HCl isomerises n-alkanes to branched ones."
   }
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Combustion"
   },
   "tex": "\\text{C}_x\\text{H}_y + \\left(x + \\tfrac{y}{4}\\right)\\text{O}_2 \\rightarrow x\\,\\text{CO}_2 + \\tfrac{y}{2}\\,\\text{H}_2\\text{O}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-09-hydrocarbons.t2",
   "name": {
    "en": "Ethane conformations"
   },
   "tex": "E_{\\text{eclipsed}} - E_{\\text{staggered}} \\approx 12.5\\ \\text{kJ mol}^{-1}",
   "note": {
    "en": "Torsional strain; conformers cannot be isolated at room temperature."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-09-hydrocarbons.t3",
   "name": {
    "en": "Geometrical isomerism"
   },
   "tex": "\\text{abC=Cab}: \\text{cis has higher b.p. and } \\mu;\\ \\text{trans has higher m.p.}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Alkynes to alkenes"
   },
   "tex": "\\text{Lindlar (Pd/BaSO}_4 + \\text{quinoline)} \\rightarrow \\textit{cis};\\quad \\text{Na/liq. NH}_3 \\rightarrow \\textit{trans}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-09-hydrocarbons.t1",
   "name": {
    "en": "Alkene preparation"
   },
   "tex": "\\text{alc. KOH on R–X};\\ \\ \\text{Zn on vicinal dihalide};\\ \\ \\text{conc. H}_2\\text{SO}_4 \\text{ on alcohol (Saytzeff product)}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-09-hydrocarbons.t3",
   "name": {
    "en": "Markovnikov and Kharasch"
   },
   "tex": "\\text{CH}_3\\text{CH=CH}_2 + \\text{HBr} \\rightarrow \\text{CH}_3\\text{CHBrCH}_3;\\ \\ \\xrightarrow{\\text{peroxide}} \\text{CH}_3\\text{CH}_2\\text{CH}_2\\text{Br}",
   "note": {
    "en": "Peroxide effect only with HBr. Watch for carbocation rearrangements (hydride / methyl shifts)."
   }
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Oxidation of alkenes"
   },
   "tex": "\\text{Baeyer's (cold dil. alk. KMnO}_4) \\rightarrow \\text{diol};\\ \\ \\text{hot KMnO}_4/\\text{H}^+ \\rightarrow \\text{ketone / acid};\\ =\\!\\text{CH}_2 \\rightarrow \\text{CO}_2"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-09-hydrocarbons.t3",
   "name": {
    "en": "Ozonolysis"
   },
   "tex": "\\text{R}_2\\text{C=CR}'_2 \\xrightarrow{\\text{O}_3,\\ \\text{Zn/H}_2\\text{O}} \\text{R}_2\\text{C=O} + \\text{O=CR}'_2",
   "note": {
    "en": "Benzene → 3 glyoxal."
   }
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-chemistry-09-hydrocarbons.t4",
   "name": {
    "en": "Ethyne preparation"
   },
   "tex": "\\text{CaC}_2 + 2\\text{H}_2\\text{O} \\rightarrow \\text{C}_2\\text{H}_2 + \\text{Ca(OH)}_2",
   "note": {
    "en": "Also from vicinal dihalides with alc. KOH then NaNH₂."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-09-hydrocarbons.t4",
   "name": {
    "en": "Acidity of hydrocarbons"
   },
   "tex": "\\text{HC}{\\equiv}\\text{CH} > \\text{H}_2\\text{C=CH}_2 > \\text{H}_3\\text{C–CH}_3",
   "note": {
    "en": "Terminal alkynes give precipitates with ammoniacal AgNO₃ / Cu₂Cl₂ and H₂ with Na."
   }
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Hydration of alkynes"
   },
   "tex": "\\text{HC}{\\equiv}\\text{CH} \\xrightarrow{\\text{Hg}^{2+}/\\text{H}_2\\text{SO}_4} \\text{CH}_3\\text{CHO};\\quad \\text{RC}{\\equiv}\\text{CH} \\rightarrow \\text{RCOCH}_3"
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Cyclic polymerisation"
   },
   "tex": "3\\,\\text{C}_2\\text{H}_2 \\xrightarrow{\\text{red-hot Fe tube, 873 K}} \\text{C}_6\\text{H}_6"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Hückel's rule"
   },
   "tex": "\\text{planar, cyclic, fully conjugated, } (4n + 2)\\ \\pi\\ e^-",
   "note": {
    "en": "Aromatic: benzene, C₅H₅⁻, C₇H₇⁺, C₃H₃⁺, pyridine. 4n π: antiaromatic."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-chemistry-09-hydrocarbons.t4",
   "name": {
    "en": "Benzene preparation"
   },
   "tex": "\\text{C}_6\\text{H}_5\\text{COONa} \\xrightarrow{\\text{NaOH/CaO}} \\text{C}_6\\text{H}_6;\\quad \\text{C}_6\\text{H}_5\\text{OH} \\xrightarrow{\\text{Zn dust}} \\text{C}_6\\text{H}_6"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Electrophiles in EAS"
   },
   "tex": "\\text{NO}_2^+ (\\text{HNO}_3/\\text{H}_2\\text{SO}_4);\\ \\text{Cl}^+ (\\text{Cl}_2/\\text{FeCl}_3);\\ \\text{SO}_3;\\ \\text{R}^+, \\text{RCO}^+ (\\text{AlCl}_3)",
   "note": {
    "en": "Mechanism: electrophile → arenium ion (σ-complex) → loss of H⁺."
   }
  },
  {
   "id": "zs-f30",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Directive influence"
   },
   "tex": "o/p: -\\text{OH}, -\\text{NH}_2, -\\text{OR}, -\\text{R}, -\\text{X};\\quad m: -\\text{NO}_2, -\\text{CN}, -\\text{CHO}, -\\text{COOH}, -\\text{SO}_3\\text{H}",
   "note": {
    "en": "Halogens deactivate but are o/p directing."
   }
  },
  {
   "id": "zs-f31",
   "topicId": "puc1-chemistry-09-hydrocarbons.t4",
   "name": {
    "en": "Addition to benzene"
   },
   "tex": "\\text{C}_6\\text{H}_6 + 3\\text{Cl}_2 \\xrightarrow{h\\nu} \\text{C}_6\\text{H}_6\\text{Cl}_6\\ (\\text{BHC});\\quad \\text{C}_6\\text{H}_6 + 3\\text{H}_2 \\xrightarrow{\\text{Ni}} \\text{C}_6\\text{H}_{12}"
  },
  {
   "id": "zs-f32",
   "topicId": "puc1-chemistry-09-hydrocarbons.t5",
   "name": {
    "en": "Resonance energy of benzene"
   },
   "tex": "E_{\\text{res}} = \\Delta H_{\\text{hyd}}(\\text{benzene}) - 3\\,\\Delta H_{\\text{hyd}}(\\text{cyclohexene}) \\approx 150\\ \\text{kJ mol}^{-1}",
   "note": {
    "en": "All C–C = 139 pm. Polynuclear hydrocarbons such as 3,4-benzpyrene are carcinogenic."
   }
  }
 ]
}
