{
 "chapterId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t4",
   "name": {
    "en": "Hybridisation number"
   },
   "tex": "H = \\tfrac12(V + M - C + A)",
   "note": {
    "en": "2 sp, 3 sp², 4 sp³, 5 sp³d, 6 sp³d²."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Bond order"
   },
   "tex": "\\text{B.O.} = \\frac{N_b - N_a}{2}",
   "note": {
    "en": "Higher B.O. → shorter, stronger."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Dipole moment"
   },
   "tex": "\\mu = q\\times d",
   "note": {
    "en": "1 D = 3.336 × 10⁻³⁰ C m."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Percentage ionic character"
   },
   "tex": "\\%\\ \\text{ionic} = \\frac{\\mu_{obs}}{\\mu_{ionic}}\\times100",
   "note": {
    "en": "Compare with 100% ionic estimate."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t1",
   "name": {
    "en": "Formal charge"
   },
   "tex": "FC = V - L - \\tfrac12 B",
   "note": {
    "en": "L = lone-pair e⁻, B = bonding e⁻."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Magnetic moment (MOT)"
   },
   "tex": "\\mu = \\sqrt{n(n+2)}\\ \\text{BM}",
   "note": {
    "en": "O₂: n = 2 → 2.83 BM."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t1",
   "name": {
    "en": "Formal charge"
   },
   "tex": "\\text{FC} = V - L - \\tfrac12 B",
   "note": {
    "en": "V = valence electrons, L = non-bonding electrons, B = bonding electrons. The best Lewis structure has the smallest formal charges."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t1",
   "name": {
    "en": "Octet-rule exceptions"
   },
   "tex": "\\text{incomplete: BeCl}_2, \\text{BCl}_3;\\ \\ \\text{odd-electron: NO, NO}_2;\\ \\ \\text{expanded: PCl}_5, \\text{SF}_6, \\text{IF}_7",
   "note": {
    "en": "Expanded octets need vacant d orbitals (period 3 onwards)."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Lattice enthalpy trend"
   },
   "tex": "U \\propto \\dfrac{z_+ z_-}{r_+ + r_-}",
   "note": {
    "en": "Higher charge, smaller ions → larger lattice enthalpy (MgO ≫ NaCl). Ionic bonds favoured by low IE, high |Δeg H|, high U."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Dipole moment"
   },
   "tex": "\\mu = q \\times d, \\quad 1\\ \\text{D} = 3.336\\times10^{-30}\\ \\text{C m} = 10^{-18}\\ \\text{esu cm}",
   "note": {
    "en": "Vector sum of bond (and lone-pair) moments: CO₂, BF₃, CH₄, CCl₄, XeF₄ have μ = 0. μ(NH₃) = 1.47 D > μ(NF₃) = 0.23 D."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Percentage ionic character"
   },
   "tex": "\\%\\,\\text{ionic} = \\dfrac{\\mu_{\\text{obs}}}{e \\times d} \\times 100"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Fajans' rules"
   },
   "tex": "\\text{covalent character} \\uparrow \\text{ with small, highly charged cation; large, highly charged anion}",
   "note": {
    "en": "Pseudo-noble-gas (18-e) cations such as Cu⁺, Ag⁺ polarise more than noble-gas-type cations."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t3",
   "name": {
    "en": "Steric number (VSEPR)"
   },
   "tex": "\\text{SN} = \\tfrac12\\left(V + M - c_+ + a_-\\right) = \\text{bp} + \\text{lp}",
   "note": {
    "en": "V = valence e⁻ of central atom, M = monovalent atoms attached; divalent O counts 0 in M. Repulsion: lp–lp > lp–bp > bp–bp."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t4",
   "name": {
    "en": "SN → hybridisation"
   },
   "tex": "2: sp;\\ 3: sp^2;\\ 4: sp^3;\\ 5: sp^3d;\\ 6: sp^3d^2;\\ 7: sp^3d^3"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t3",
   "name": {
    "en": "SN 4 shapes"
   },
   "tex": "\\text{4 bp: tetrahedral (CH}_4\\text{)};\\ \\text{3 bp 1 lp: pyramidal (NH}_3\\text{)};\\ \\text{2 bp 2 lp: bent (H}_2\\text{O)}",
   "note": {
    "en": "Angles 109.5°, 107°, 104.5°."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t3",
   "name": {
    "en": "SN 5 shapes"
   },
   "tex": "\\text{5 bp: TBP (PCl}_5\\text{)};\\ \\text{4,1: see-saw (SF}_4\\text{)};\\ \\text{3,2: T-shape (ClF}_3\\text{)};\\ \\text{2,3: linear (XeF}_2, \\text{I}_3^-\\text{)}",
   "note": {
    "en": "Lone pairs always go equatorial."
   }
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "SN 6 and 7 shapes"
   },
   "tex": "\\text{6,0: octahedral (SF}_6\\text{)};\\ \\text{5,1: square pyramidal (BrF}_5, \\text{XeOF}_4\\text{)};\\ \\text{4,2: square planar (XeF}_4, \\text{ICl}_4^-\\text{)};\\ \\text{7,0: pentagonal bipyramidal (IF}_7\\text{)}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t5",
   "name": {
    "en": "Hybridisation geometry"
   },
   "tex": "sp: 180^\\circ;\\ \\ sp^2: 120^\\circ;\\ \\ sp^3: 109^\\circ28'",
   "note": {
    "en": "s-character: sp 50%, sp² 33%, sp³ 25%. More s-character → shorter, stronger bond, more electronegative orbital."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t4",
   "name": {
    "en": "σ and π bonds"
   },
   "tex": "\\text{single} = 1\\sigma;\\ \\ \\text{double} = 1\\sigma + 1\\pi;\\ \\ \\text{triple} = 1\\sigma + 2\\pi",
   "note": {
    "en": "σ: head-on overlap (s–s, s–p_z, p_z–p_z); π: sideways overlap. s with p_y on the z-axis gives zero overlap."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Bond order (MOT)"
   },
   "tex": "\\text{B.O.} = \\tfrac12\\left(N_b - N_a\\right)",
   "note": {
    "en": "B.O. ↑ → bond length ↓, bond enthalpy ↑, stability ↑. B.O. = 0 → molecule does not exist (He₂, Be₂)."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t5",
   "name": {
    "en": "MO order up to N₂ (≤ 14 e⁻)"
   },
   "tex": "\\sigma1s < \\sigma^*1s < \\sigma2s < \\sigma^*2s < (\\pi2p_x = \\pi2p_y) < \\sigma2p_z < (\\pi^*2p_x = \\pi^*2p_y) < \\sigma^*2p_z",
   "note": {
    "en": "Due to s–p mixing. For O₂ and F₂, σ2p_z lies below π2p."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t5",
   "name": {
    "en": "Key MO results"
   },
   "tex": "\\text{B.O.: O}_2^+\\ 2.5,\\ \\text{O}_2\\ 2,\\ \\text{O}_2^-\\ 1.5,\\ \\text{O}_2^{2-}\\ 1;\\ \\ \\text{N}_2\\ 3,\\ \\text{N}_2^+ = \\text{N}_2^-\\ 2.5",
   "note": {
    "en": "Paramagnetic: B₂, O₂, O₂⁺, O₂⁻, NO, N₂⁺. Diamagnetic: C₂, N₂, F₂, O₂²⁻, CO, CN⁻, NO⁺."
   }
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Isoelectronic species"
   },
   "tex": "\\text{same electron count} \\Rightarrow \\text{same B.O.: } \\text{N}_2, \\text{CO}, \\text{CN}^-, \\text{NO}^+, \\text{C}_2^{2-} \\ (14\\,e^-,\\ \\text{B.O. } 3)"
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Resonance bond order"
   },
   "tex": "\\text{B.O.} = \\dfrac{\\text{total bonds between the atoms}}{\\text{number of resonating positions}}",
   "note": {
    "en": "CO₃²⁻ 1.33; NO₃⁻ 1.33; O₃, NO₂⁻, RCOO⁻ 1.5; C₆H₆ (C–C) 1.5."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t2",
   "name": {
    "en": "Halogen bond enthalpy"
   },
   "tex": "\\text{Cl}_2 > \\text{Br}_2 > \\text{F}_2 > \\text{I}_2",
   "note": {
    "en": "F₂ is weak due to lone-pair repulsion in the short bond."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-04-chemical-bonding-and-molecular-structure.t5",
   "name": {
    "en": "Hydrogen bonding"
   },
   "tex": "\\text{X–H}\\cdots\\text{Y},\\ \\ \\text{X, Y} = \\text{F, O, N}",
   "note": {
    "en": "Intermolecular (H₂O, HF, p-nitrophenol) raises bp; intramolecular (o-nitrophenol, salicylaldehyde) lowers bp. bp: H₂O > HF > NH₃."
   }
  }
 ]
}
