    },
    {
     "name": "e_pi",
     "expr": "if(hv, clamp(nm - 6, 0, 4), clamp(nm - 4, 0, 4))"
    },
    {
     "name": "e_sp",
     "expr": "if(hv, clamp(nm - 4, 0, 2), clamp(nm - 8, 0, 2))"
    },
    {
     "name": "e_pis",
     "expr": "clamp(nm - 10, 0, 4)"
    },
    {
     "name": "e_sps",
     "expr": "clamp(nm - 14, 0, 2)"
    },
    {
     "name": "bo",
     "expr": "(e_s + e_pi + e_sp - e_ss - e_pis - e_sps)/2"
    },
    {
     "name": "unp",
     "expr": "if(e_pi <= 2, e_pi, 4 - e_pi) + if(e_pis <= 2, e_pis, 4 - e_pis) + (e_sp == 1) + (e_s == 1) + (e_ss == 1) + (e_sps == 1)"
    }
