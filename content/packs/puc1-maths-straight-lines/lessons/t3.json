 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Where two roads cross",
    "kn": "ಎರಡು ರಸ್ತೆಗಳು ಸಂಧಿಸುವಲ್ಲಿ"
   },
   "hook": {
    "en": "Two roads meet at a circle. If we know only their slopes, can we find the angle at which they cross?",
    "kn": "ಎರಡು ರಸ್ತೆಗಳು ವೃತ್ತದಲ್ಲಿ ಸೇರುತ್ತವೆ. ಅವುಗಳ ಇಳಿಜಾರುಗಳು ಮಾತ್ರ ತಿಳಿದಿದ್ದರೆ, ಅವು ಸಂಧಿಸುವ ಕೋನವನ್ನು ಕಂಡುಹಿಡಿಯಬಹುದೇ?"
   },
   "objectives": [
    {
     "en": "Use tan θ = |(m₂ − m₁)/(1 + m₁m₂)|"
    },
    {
     "en": "Find an unknown slope from a given angle"
    }
   ],
   "narration": {
    "en": "Two roads meet at a circle. If we know only their slopes, can we find the angle at which they cross?",
    "kn": "ಎರಡು ರಸ್ತೆಗಳು ವೃತ್ತದಲ್ಲಿ ಸೇರುತ್ತವೆ. ಅವುಗಳ ಇಳಿಜಾರುಗಳು ಮಾತ್ರ ತಿಳಿದಿದ್ದರೆ, ಅವು ಸಂಧಿಸುವ ಕೋನವನ್ನು ಕಂಡುಹಿಡಿಯಬಹುದೇ?"
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The angle formula"
   },
   "body": {
    "en": "If lines $L_1$ and $L_2$ have slopes $m_1$ and $m_2$ with $1 + m_1 m_2 \\neq 0$, the acute angle $\\theta$ between them satisfies $\\tan\\theta = \\left|\\frac{m_2 - m_1}{1 + m_1 m_2}\\right|$. The obtuse angle is $180^\\circ - \\theta$. If $1 + m_1 m_2 = 0$, the lines are perpendicular.",
    "kn": "m₁, m₂ ಇಳಿಜಾರುಗಳ ರೇಖೆಗಳ ನಡುವಿನ ಲಘುಕೋನ θ ಗೆ tan θ = |(m₂ − m₁)/(1 + m₁m₂)|. ವಿಶಾಲಕೋನ 180° − θ."
   },
   "points": [
    {
     "en": "Modulus gives the acute angle"
    },
    {
     "en": "1 + m₁m₂ = 0 means perpendicular"
    }
   ],
   "narration": {
    "en": "The acute angle between two lines comes from tan theta equals the modulus of m two minus m one, over one plus m one m two.",
    "kn": "m₁, m₂ ಇಳಿಜಾರುಗಳ ರೇಖೆಗಳ ನಡುವಿನ ಲಘುಕೋನ θ ಗೆ tan θ = |(m₂ − m₁)/(1 + m₁m₂)|. ವಿಶಾಲಕೋನ 180° − θ."
   },
   "formula": "\\tan\\theta = \\left|\\frac{m_2-m_1}{1+m_1m_2}\\right|"
  },
  {
   "id": "wb1",
   "type": "whiteboard",
   "title": {
    "en": "Angle between two lines"
   },
   "narration": {
    "en": "Two lines make angles theta 1 and theta 2 with the x-axis. The angle between them is the difference, theta 2 minus theta 1."
   },
   "steps": [
    {
     "say": {
      "en": "Two lines make angles theta 1 and theta 2 with the x-axis. The angle between them is the difference, theta 2 minus theta 1."
     },
     "draw": [
      {
       "kind": "axes",
       "from": [
        5,
        5
       ],
       "to": [
        47,
        54
       ],
       "x": [
        -3,
        3
       ],
       "y": [
        -3.5,
        3.5
       ],
       "color": "white"
      },
      {
       "kind": "plot",
       "fn": "x",
       "color": "yellow"
      },
      {
       "kind": "plot",
       "fn": "sqrt(3)*x",
       "color": "green"
      },
      {
       "kind": "text",
       "at": [
        35.8,
        22.5
       ],
       "text": {
        "en": "m₁ = 1"
       },
       "size": 3,
       "color": "yellow"
      },
      {
       "kind": "text",
       "at": [
        20.5,
        6.4
       ],
       "text": {
        "en": "m₂ = √3"
       },
       "size": 3,
       "color": "green"
      },
      {
       "kind": "math",
       "at": [
        52,
        4
       ],
       "tex": "\\theta = \\theta_2 - \\theta_1",
       "size": 4,
       "color": "white"
      }
     ]
    },
    {
     "say": {
      "en": "Take tan of both sides and use the tan of a difference. Since tan theta 1 is m 1 and tan theta 2 is m 2, we get the formula; the modulus gives the acute angle."
     },
     "draw": [
      {
       "kind": "math",
       "at": [
        52,
        13
       ],
       "tex": "\\tan\\theta = \\frac{\\tan\\theta_2-\\tan\\theta_1}{1+\\tan\\theta_1\\tan\\theta_2}",
       "size": 3,
       "color": "white"
      },
      {
       "kind": "math",
       "at": [
        52,
        26
       ],
       "tex": "\\tan\\theta = \\left|\\frac{m_2-m_1}{1+m_1m_2}\\right|",
       "size": 4,
       "color": "yellow"
      }
     ]
    },
    {
     "say": {
      "en": "For slopes 1 and root 3, tan theta is 2 minus root 3, so the angle is 15 degrees: 60 minus 45."
     },
     "draw": [
      {
       "kind": "text",
       "at": [
        52,
        39
       ],
       "text": {
        "en": "m₁ = 1, m₂ = √3"
       },
       "size": 3,
       "color": "white"
      },
      {
       "kind": "math",
       "at": [
        52,
        45
       ],
       "tex": "\\tan\\theta = \\frac{\\sqrt3-1}{1+\\sqrt3} = 2-\\sqrt3",
       "size": 3,
       "color": "white"
      },
      {
       "kind": "text",
       "at": [
        52,
        54
       ],
       "text": {
        "en": "θ = 15°"
       },
       "size": 3,
       "color": "green"
      }
     ]
    },
    {
     "say": {
      "en": "Two crossing lines make two angles, theta and 180 minus theta. If 1 plus m 1 m 2 is zero the lines are perpendicular."
     },
     "draw": [
      {
       "kind": "text",
       "at": [
        5,
        55.5
       ],
       "text": {
        "en": "Angles: θ and 180° − θ"
       },
       "size": 3,
       "color": "orange"
      }
     ]
    }
   ]
  },
