{
 "chapterId": "puc1-maths-09-straight-lines",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-09-straight-lines.t1",
   "name": {
    "en": "Section formula"
   },
   "tex": "\\left(\\frac{mx_2 + nx_1}{m+n},\\ \\frac{my_2 + ny_1}{m+n}\\right)",
   "note": {
    "en": "Internal division m : n."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-09-straight-lines.t5",
   "name": {
    "en": "Point–line distance"
   },
   "tex": "d = \\frac{|ax_1 + by_1 + c|}{\\sqrt{a^2 + b^2}}",
   "note": {
    "en": "Parallel lines: |c₁ − c₂|/√(a² + b²)."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-maths-09-straight-lines.t2",
   "name": {
    "en": "Angle between lines"
   },
   "tex": "\\tan\\theta = \\left|\\frac{m_1 - m_2}{1 + m_1m_2}\\right|",
   "note": {
    "en": "⟂ when m₁m₂ = −1."
   }
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Circle"
   },
   "tex": "x^2 + y^2 + 2gx + 2fy + c = 0,\\ r = \\sqrt{g^2 + f^2 - c}",
   "note": {
    "en": "Centre (−g, −f)."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Parabola"
   },
   "tex": "y^2 = 4ax,\\ \\text{focus }(a,0),\\ \\text{LR} = 4a",
   "note": {
    "en": "Tangent: y = mx + a/m."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Ellipse"
   },
   "tex": "\\frac{x^2}{a^2} + \\frac{y^2}{b^2} = 1,\\ b^2 = a^2(1 - e^2)",
   "note": {
    "en": "Tangent: c² = a²m² + b²."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Hyperbola"
   },
   "tex": "\\frac{x^2}{a^2} - \\frac{y^2}{b^2} = 1,\\ b^2 = a^2(e^2 - 1)",
   "note": {
    "en": "Tangent: c² = a²m² − b²."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Circle tangency"
   },
   "tex": "c^2 = a^2(1 + m^2)",
   "note": {
    "en": "y = mx + c to x² + y² = a²."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "Slope"
   },
   "tex": "m = \\tan\\theta = \\dfrac{y_2-y_1}{x_2-x_1}",
   "note": {
    "en": "Undefined for vertical lines; $0$ for horizontal lines."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-09-straight-lines.t2",
   "name": {
    "en": "Parallel / perpendicular"
   },
   "tex": "m_1 = m_2\\ \\ \\text{(parallel)},\\qquad m_1m_2 = -1\\ \\ \\text{(perpendicular)}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-maths-09-straight-lines.t3",
   "name": {
    "en": "Angle between two lines"
   },
   "tex": "\\tan\\theta = \\left|\\dfrac{m_1-m_2}{1+m_1m_2}\\right|",
   "note": {
    "en": "Gives the acute angle."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-maths-09-straight-lines.t2",
   "name": {
    "en": "Collinearity"
   },
   "tex": "x_1(y_2-y_3)+x_2(y_3-y_1)+x_3(y_1-y_2) = 0",
   "note": {
    "en": "Or equal slopes AB = BC."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-09-straight-lines.t1",
   "name": {
    "en": "Area of a triangle"
   },
   "tex": "\\Delta = \\tfrac12\\left|x_1(y_2-y_3)+x_2(y_3-y_1)+x_3(y_1-y_2)\\right|"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-09-straight-lines.t1",
   "name": {
    "en": "Section formula (internal, m : n)"
   },
   "tex": "\\left(\\dfrac{mx_2+nx_1}{m+n},\\ \\dfrac{my_2+ny_1}{m+n}\\right)",
   "note": {
    "en": "Replace n by −n for external division."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "Point–slope form"
   },
   "tex": "y-y_1 = m(x-x_1)"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "Two-point form"
   },
   "tex": "y-y_1 = \\dfrac{y_2-y_1}{x_2-x_1}(x-x_1)"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "Slope–intercept form"
   },
   "tex": "y = mx+c"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "Intercept form"
   },
   "tex": "\\dfrac xa+\\dfrac yb = 1"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-maths-09-straight-lines.t5",
   "name": {
    "en": "Normal form"
   },
   "tex": "x\\cos\\omega+y\\sin\\omega = p",
   "note": {
    "en": "$p\\ge0$ is the distance from the origin; $\\omega$ the angle of the normal."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "General form"
   },
   "tex": "Ax+By+C = 0:\\quad m = -\\tfrac AB,\\ \\ x\\text{-int} = -\\tfrac CA,\\ \\ y\\text{-int} = -\\tfrac CB"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-maths-09-straight-lines.t5",
   "name": {
    "en": "Distance of a point from a line"
   },
   "tex": "d = \\dfrac{|Ax_1+By_1+C|}{\\sqrt{A^2+B^2}}"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-maths-09-straight-lines.t5",
   "name": {
    "en": "Distance between parallel lines"
   },
   "tex": "d = \\dfrac{|C_1-C_2|}{\\sqrt{A^2+B^2}}",
   "note": {
    "en": "Make the x, y coefficients identical first."
   }
  },
  {
   "id": "zs-f23",
   "name": {
    "en": "Foot of perpendicular / image"
   },
   "tex": "\\dfrac{x-x_1}A = \\dfrac{y-y_1}B = -k\\,\\dfrac{Ax_1+By_1+C}{A^2+B^2}",
   "note": {
    "en": "k = 1 for the foot, k = 2 for the image."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-maths-09-straight-lines.t2",
   "name": {
    "en": "Parallel and perpendicular lines to Ax + By + C = 0"
   },
   "tex": "Ax+By+k = 0,\\qquad Bx-Ay+k = 0"
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Family through the intersection"
   },
   "tex": "(A_1x+B_1y+C_1)+\\lambda(A_2x+B_2y+C_2) = 0"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Concurrency of three lines"
   },
   "tex": "\\begin{vmatrix}A_1&B_1&C_1\\\\A_2&B_2&C_2\\\\A_3&B_3&C_3\\end{vmatrix} = 0"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-maths-09-straight-lines.t2",
   "name": {
    "en": "Angle bisectors"
   },
   "tex": "\\dfrac{A_1x+B_1y+C_1}{\\sqrt{A_1^2+B_1^2}} = \\pm\\dfrac{A_2x+B_2y+C_2}{\\sqrt{A_2^2+B_2^2}}",
   "note": {
    "en": "With both C's positive, the + sign gives the bisector of the angle containing the origin."
   }
  },
  {
   "id": "zs-f28",
   "name": {
    "en": "Same / opposite side of a line"
   },
   "tex": "(Ax_1+By_1+C)(Ax_2+By_2+C)\\ \\begin{cases}>0 & \\text{same side}\\\\<0 & \\text{opposite sides}\\end{cases}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-maths-09-straight-lines.t4",
   "name": {
    "en": "Parametric (distance) form"
   },
   "tex": "(x,y) = (x_1+r\\cos\\theta,\\ y_1+r\\sin\\theta)",
   "note": {
    "en": "r = signed distance along the line."
   }
  },
  {
   "id": "zs-f30",
   "topicId": "puc1-maths-09-straight-lines.t1",
   "name": {
    "en": "Area of a parallelogram of lines"
   },
   "tex": "\\left|\\dfrac{(c_1-c_2)(d_1-d_2)}{m_1-m_2}\\right|",
   "note": {
    "en": "Sides $y = m_1x+c_{1,2}$ and $y = m_2x+d_{1,2}$."
   }
  }
 ]
}
