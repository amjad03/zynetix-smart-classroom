{
 "chapterId": "puc2-physics-13-nuclei",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-13-nuclei.t1",
   "name": {
    "en": "Composition"
   },
   "tex": "^{A}_{Z}\\text{X}:\\ Z\\ \\text{protons},\\ N = A - Z\\ \\text{neutrons}",
   "note": {
    "en": "Isotopes: same Z; isobars: same A; isotones: same N"
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-13-nuclei.t2",
   "name": {
    "en": "Nuclear radius"
   },
   "tex": "R = R_0A^{1/3},\\quad R_0 \\approx 1.2\\ \\text{fm}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-13-nuclei.t2",
   "name": {
    "en": "Nuclear density"
   },
   "tex": "\\rho = \\dfrac{3m_u}{4\\pi R_0^3} \\approx 2.3\\times10^{17}\\ \\text{kg/m}^3",
   "note": {
    "en": "Independent of A"
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-13-nuclei.t1",
   "name": {
    "en": "Atomic mass unit"
   },
   "tex": "1\\ \\text{u} = 1.6605\\times10^{-27}\\ \\text{kg} \\equiv 931.5\\ \\text{MeV}/c^2"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-13-nuclei.t3",
   "name": {
    "en": "Mass–energy"
   },
   "tex": "E = mc^2",
   "note": {
    "en": "1 g ↔ 9 × 10¹³ J"
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-13-nuclei.t1",
   "name": {
    "en": "Mass defect"
   },
   "tex": "\\Delta m = Zm_p + (A - Z)m_n - M_\\text{nucleus}",
   "note": {
    "en": "With atomic masses use m(¹H) in place of mₚ"
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-13-nuclei.t3",
   "name": {
    "en": "Binding energy"
   },
   "tex": "E_B = \\Delta m\\,c^2 = \\Delta m(\\text{u}) \\times 931.5\\ \\text{MeV}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-13-nuclei.t3",
   "name": {
    "en": "Binding energy per nucleon"
   },
   "tex": "\\dfrac{E_B}{A}\\ \\text{peaks} \\approx 8.8\\ \\text{MeV at } ^{56}\\text{Fe};\\ \\approx 8\\ \\text{MeV for } 30 < A < 170",
   "note": {
    "en": "Low for light nuclei, falls slowly for heavy ones (Coulomb repulsion)"
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-13-nuclei.t3",
   "name": {
    "en": "Q-value"
   },
   "tex": "Q = (\\Sigma m_\\text{initial} - \\Sigma m_\\text{final})c^2 = \\Sigma E_{B,\\text{final}} - \\Sigma E_{B,\\text{initial}}",
   "note": {
    "en": "Q > 0: energy released"
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-13-nuclei.t4",
   "name": {
    "en": "Nuclear force"
   },
   "tex": "\\text{short range (few fm), charge independent, saturating, repulsive below} \\sim 0.8\\ \\text{fm}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-13-nuclei.t5",
   "name": {
    "en": "Fission"
   },
   "tex": "^{235}\\text{U} + n \\to \\text{fragments} + 2\\text{–}3\\,n + \\sim 200\\ \\text{MeV}",
   "note": {
    "en": "Moderator slows neutrons; control rods (Cd, B) absorb them"
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-13-nuclei.t5",
   "name": {
    "en": "Fusion"
   },
   "tex": "^{2}\\text{H} + {^3}\\text{H} \\to {^4}\\text{He} + n + 17.6\\ \\text{MeV};\\quad 4\\,^1\\text{H} \\to {^4}\\text{He}: 26.7\\ \\text{MeV}",
   "note": {
    "en": "Needs ~10⁷ K to overcome the Coulomb barrier"
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-13-nuclei.t3",
   "name": {
    "en": "Energy sharing in two-body break-up"
   },
   "tex": "K_1 = Q\\,\\dfrac{m_2}{m_1 + m_2}",
   "note": {
    "en": "Lighter product takes more energy (e.g. α-decay, D–T neutron)"
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Decay law (JEE Advanced)"
   },
   "tex": "N = N_0e^{-\\lambda t} = N_0\\left(\\tfrac12\\right)^{t/T_{1/2}},\\quad A = \\lambda N"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Half-life and mean life (JEE Advanced)"
   },
   "tex": "T_{1/2} = \\dfrac{\\ln 2}{\\lambda} = \\dfrac{0.693}{\\lambda},\\quad \\tau = \\dfrac{1}{\\lambda} = 1.44\\,T_{1/2}"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Parallel decay modes (JEE Advanced)"
   },
   "tex": "\\lambda = \\lambda_1 + \\lambda_2,\\quad \\dfrac{1}{T} = \\dfrac{1}{T_1} + \\dfrac{1}{T_2}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "α, β, γ changes (JEE Advanced)"
   },
   "tex": "\\alpha: (Z, A) \\to (Z-2, A-4);\\ \\beta^-: Z \\to Z+1;\\ \\beta^+: Z \\to Z-1;\\ \\gamma: \\text{no change}"
  }
 ]
}
