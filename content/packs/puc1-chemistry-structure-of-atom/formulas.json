{
 "chapterId": "puc1-chemistry-02-structure-of-atom",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Bohr energy"
   },
   "tex": "E_n = -13.6\\frac{Z^2}{n^2}\\ \\text{eV}",
   "note": {
    "en": "= −2.18 × 10⁻¹⁸ Z²/n² J."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Bohr radius"
   },
   "tex": "r_n = 0.529\\frac{n^2}{Z}\\ \\text{Å}",
   "note": {
    "en": "H-like species only."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-chemistry-02-structure-of-atom.t4",
   "name": {
    "en": "de Broglie"
   },
   "tex": "\\lambda = \\frac{h}{mv}",
   "note": {
    "en": "Bohr orbit: 2πr = nλ."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-chemistry-02-structure-of-atom.t4",
   "name": {
    "en": "Heisenberg uncertainty"
   },
   "tex": "\\Delta x\\cdot\\Delta p \\ge \\frac{h}{4\\pi}",
   "note": {
    "en": "Significant only for microscopic particles."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-chemistry-02-structure-of-atom.t5",
   "name": {
    "en": "Nodes"
   },
   "tex": "\\text{radial} = n - l - 1,\\quad \\text{angular} = l",
   "note": {
    "en": "Total nodes = n − 1."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Orbital angular momentum"
   },
   "tex": "L = \\sqrt{l(l+1)}\\,\\frac{h}{2\\pi}",
   "note": {
    "en": "s orbital: L = 0."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-chemistry-02-structure-of-atom.t2",
   "name": {
    "en": "Spin-only magnetic moment"
   },
   "tex": "\\mu = \\sqrt{n(n+2)}\\ \\text{BM}",
   "note": {
    "en": "n = unpaired electrons."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-chemistry-02-structure-of-atom.t1",
   "name": {
    "en": "Particles"
   },
   "tex": "e = 1.602\\times10^{-19}\\,\\text{C},\\ m_e = 9.11\\times10^{-31}\\,\\text{kg},\\ m_p \\approx m_n \\approx 1.67\\times10^{-27}\\,\\text{kg}",
   "note": {
    "en": "e/m of electron = 1.758 × 10¹¹ C kg⁻¹ (Thomson); e from Millikan's oil-drop experiment."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-chemistry-02-structure-of-atom.t1",
   "name": {
    "en": "Nuclear composition"
   },
   "tex": "^{A}_{Z}\\text{X}:\\ \\ p = Z,\\ n = A - Z",
   "note": {
    "en": "Isotopes: same Z; isobars: same A; isotones: same A − Z; isoelectronic: same number of electrons."
   }
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Distance of closest approach"
   },
   "tex": "r_0 = \\dfrac{1}{4\\pi\\varepsilon_0}\\,\\dfrac{2Ze^2}{K}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-chemistry-02-structure-of-atom.t4",
   "name": {
    "en": "Wave relations"
   },
   "tex": "c = \\nu\\lambda,\\qquad \\bar{\\nu} = \\dfrac{1}{\\lambda}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-chemistry-02-structure-of-atom.t2",
   "name": {
    "en": "Planck's quantum"
   },
   "tex": "E = h\\nu = \\dfrac{hc}{\\lambda},\\qquad E(\\text{eV}) = \\dfrac{1240}{\\lambda(\\text{nm})}",
   "note": {
    "en": "h = 6.626 × 10⁻³⁴ J s; 1 eV = 1.602 × 10⁻¹⁹ J."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-chemistry-02-structure-of-atom.t2",
   "name": {
    "en": "Photoelectric effect"
   },
   "tex": "h\\nu = h\\nu_0 + \\tfrac12 m v_{\\max}^2",
   "note": {
    "en": "K_max depends on ν, not intensity; number of electrons ∝ intensity; no emission below ν₀."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Rydberg formula"
   },
   "tex": "\\bar{\\nu} = \\dfrac{1}{\\lambda} = R_H Z^2\\left(\\dfrac{1}{n_1^2} - \\dfrac{1}{n_2^2}\\right)",
   "note": {
    "en": "R_H = 109 677 cm⁻¹ ≈ 1.097 × 10⁷ m⁻¹."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Spectral series"
   },
   "tex": "n_1 = 1, 2, 3, 4, 5:\\ \\text{Lyman (UV), Balmer (visible), Paschen, Brackett, Pfund (IR)}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Number of spectral lines"
   },
   "tex": "N = \\dfrac{(n_2 - n_1)(n_2 - n_1 + 1)}{2}",
   "note": {
    "en": "From n₂ to ground state: n(n − 1)/2."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Bohr radius"
   },
   "tex": "r_n = 0.529\\,\\dfrac{n^2}{Z}\\ \\text{Å}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Bohr energy"
   },
   "tex": "E_n = -13.6\\,\\dfrac{Z^2}{n^2}\\ \\text{eV} = -2.18\\times10^{-18}\\,\\dfrac{Z^2}{n^2}\\ \\text{J}",
   "note": {
    "en": "IE(H) = 13.6 eV = 1312 kJ mol⁻¹; E = −KE, PE = −2 KE."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Bohr velocity and period"
   },
   "tex": "v_n = 2.18\\times10^{6}\\,\\dfrac{Z}{n}\\ \\text{m s}^{-1},\\qquad T \\propto \\dfrac{n^3}{Z^2}"
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-chemistry-02-structure-of-atom.t3",
   "name": {
    "en": "Angular momentum"
   },
   "tex": "mvr = \\dfrac{nh}{2\\pi}\\ (\\text{Bohr}),\\qquad L = \\sqrt{l(l+1)}\\,\\dfrac{h}{2\\pi}\\ (\\text{orbital})"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-chemistry-02-structure-of-atom.t4",
   "name": {
    "en": "de Broglie wavelength"
   },
   "tex": "\\lambda = \\dfrac{h}{mv} = \\dfrac{h}{p} = \\dfrac{h}{\\sqrt{2mK}} = \\dfrac{h}{\\sqrt{2mqV}}",
   "note": {
    "en": "Electron: λ = 12.27/√V Å. 2πr = nλ in a Bohr orbit."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-chemistry-02-structure-of-atom.t4",
   "name": {
    "en": "Heisenberg uncertainty"
   },
   "tex": "\\Delta x\\,\\Delta p \\ge \\dfrac{h}{4\\pi},\\qquad \\Delta x\\,\\Delta v \\ge \\dfrac{h}{4\\pi m}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-chemistry-02-structure-of-atom.t5",
   "name": {
    "en": "Quantum numbers"
   },
   "tex": "l = 0 \\ldots (n-1),\\quad m_l = -l \\ldots +l,\\quad m_s = \\pm\\tfrac12",
   "note": {
    "en": "s, p, d, f ↔ l = 0, 1, 2, 3."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-chemistry-02-structure-of-atom.t5",
   "name": {
    "en": "Orbitals and electrons"
   },
   "tex": "\\text{subshell: } 2l + 1 \\text{ orbitals};\\quad \\text{shell: } n^2 \\text{ orbitals},\\ 2n^2\\ e^-"
  },
  {
   "id": "zs-f25",
   "topicId": "puc1-chemistry-02-structure-of-atom.t5",
   "name": {
    "en": "Nodes"
   },
   "tex": "\\text{radial} = n - l - 1,\\quad \\text{angular} = l,\\quad \\text{total} = n - 1"
  },
  {
   "id": "zs-f26",
   "topicId": "puc1-chemistry-02-structure-of-atom.t6",
   "name": {
    "en": "Aufbau (n + l) rule"
   },
   "tex": "1s\\,2s\\,2p\\,3s\\,3p\\,4s\\,3d\\,4p\\,5s\\,4d\\,5p\\,6s\\,4f\\,5d\\,6p\\,7s",
   "note": {
    "en": "Lower n + l fills first; for equal n + l, lower n first."
   }
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-chemistry-02-structure-of-atom.t6",
   "name": {
    "en": "Pauli and Hund"
   },
   "tex": "\\text{no two } e^- \\text{ share all four quantum numbers; pair only after each degenerate orbital is singly filled}"
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-chemistry-02-structure-of-atom.t6",
   "name": {
    "en": "Exceptional configurations"
   },
   "tex": "\\text{Cr: [Ar]}3d^5 4s^1,\\qquad \\text{Cu: [Ar]}3d^{10} 4s^1",
   "note": {
    "en": "Half-filled and filled subshells: symmetry + exchange energy (d⁵ has ⁵C₂ = 10 exchanges)."
   }
  },
  {
   "id": "zs-f29",
   "name": {
    "en": "Ions of d-block elements"
   },
   "tex": "\\text{remove } 4s \\text{ before } 3d:\\ \\ \\text{Fe}^{3+} = [\\text{Ar}]3d^5"
  }
 ]
}
