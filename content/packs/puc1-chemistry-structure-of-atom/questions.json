  "stem": {
   "en": "According to the (n + l) rule, which of these orbitals has the lowest energy?"
  },
  "options": [
   {
    "en": "5s"
   },
   {
    "en": "3d"
   },
   {
    "en": "4s"
   },
   {
    "en": "4p"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "n + l: 3d = 5, 4s = 4, 4p = 5, 5s = 5; the lowest is 4s."
  },
