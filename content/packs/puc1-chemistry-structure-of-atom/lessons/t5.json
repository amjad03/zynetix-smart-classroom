  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Orbitals and quantum numbers"
   },
   "body": {
    "en": "Schrödinger’s equation gives wave functions ψ for the electron; ψ$^2$ is the probability density, and an orbital is the region where the electron is most likely to be found. Each orbital is labelled by n (principal: 1, 2, 3… shell and energy), l (azimuthal: 0 to n − 1, subshell s, p, d, f and shape) and $m_l$ (magnetic: −l to +l, orientation). The spin quantum number $m_s$ = +½ or −½ describes the electron itself.",
    "kn": "ಕಕ್ಷಕ ಎಂದರೆ ಎಲೆಕ್ಟ್ರಾನ್ ಸಿಗುವ ಸಂಭವನೀಯತೆ ಹೆಚ್ಚಿರುವ ಪ್ರದೇಶ. ಪ್ರಧಾನ (n), ದಿಗಂಶ (l), ಕಾಂತೀಯ (mₗ) ಮತ್ತು ಗಿರಕಿ (mₛ) ಕ್ವಾಂಟಮ್ ಸಂಖ್ಯೆಗಳು ಎಲೆಕ್ಟ್ರಾನ್‌ನ ವಿಳಾಸ."
   },
   "points": [
    {
     "en": "n = 1, 2, 3…"
    },
    {
     "en": "l = 0 … n − 1 (s, p, d, f)"
    },
    {
     "en": "mₗ = −l … +l (2l + 1 orbitals)"
    },
    {
     "en": "mₛ = ±½"
    }
   ],
   "narration": {
    "en": "An orbital is the region where an electron is most likely to be found. The principal quantum number n gives the shell, l gives the subshell and shape, m l gives the orientation, and m s gives the spin.",
    "kn": "ಕಕ್ಷಕ ಎಂದರೆ ಎಲೆಕ್ಟ್ರಾನ್ ಸಿಗುವ ಸಂಭವನೀಯತೆ ಹೆಚ್ಚಿರುವ ಪ್ರದೇಶ. ಪ್ರಧಾನ (n), ದಿಗಂಶ (l), ಕಾಂತೀಯ (mₗ) ಮತ್ತು ಗಿರಕಿ (mₛ) ಕ್ವಾಂಟಮ್ ಸಂಖ್ಯೆಗಳು ಎಲೆಕ್ಟ್ರಾನ್‌ನ ವಿಳಾಸ."
   },
   "formula": "\\text{orbitals in shell } n = n^2, \\quad \\text{maximum electrons} = 2n^2"
  },
