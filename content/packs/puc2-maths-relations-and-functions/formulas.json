{
 "chapterId": "puc2-maths-01-relations-and-functions",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Relation"
   },
   "tex": "R\\subseteq A\\times B;\\quad \\text{number of relations on } A = 2^{n^2}",
   "note": {
    "en": "n = |A|"
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Reflexive"
   },
   "tex": "(a,a)\\in R\\ \\ \\forall a\\in A;\\quad \\text{count} = 2^{n^2-n}"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Symmetric"
   },
   "tex": "(a,b)\\in R\\Rightarrow(b,a)\\in R;\\quad \\text{count} = 2^{n(n+1)/2}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-01-relations-and-functions.t1",
   "name": {
    "en": "Reflexive and symmetric"
   },
   "tex": "\\text{count} = 2^{n(n-1)/2}"
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Transitive"
   },
   "tex": "(a,b),(b,c)\\in R\\Rightarrow(a,c)\\in R"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-01-relations-and-functions.t2",
   "name": {
    "en": "Equivalence relation"
   },
   "tex": "\\text{reflexive}+\\text{symmetric}+\\text{transitive}",
   "note": {
    "en": "Classes partition A; for n = 1, 2, 3, 4 there are 1, 2, 5, 15 equivalence relations (Bell numbers)."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-01-relations-and-functions.t2",
   "name": {
    "en": "Equivalence class"
   },
   "tex": "[a] = \\{x\\in A : xRa\\};\\quad [a] = [b]\\ \\text{or}\\ [a]\\cap[b] = \\varnothing"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-01-relations-and-functions.t2",
   "name": {
    "en": "Identity relation"
   },
   "tex": "I_A = \\{(a,a):a\\in A\\}",
   "note": {
    "en": "Smallest equivalence relation; A × A is the largest."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-maths-01-relations-and-functions.t3",
   "name": {
    "en": "One-one (injective)"
   },
   "tex": "f(x_1) = f(x_2)\\Rightarrow x_1 = x_2",
   "note": {
    "en": "A strictly monotonic function is one-one."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-01-relations-and-functions.t3",
   "name": {
    "en": "Onto (surjective)"
   },
   "tex": "\\text{Range}(f) = \\text{codomain}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-maths-01-relations-and-functions.t3",
   "name": {
    "en": "Number of functions"
   },
   "tex": "|A| = m,\\ |B| = n:\\quad n^m"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-01-relations-and-functions.t3",
   "name": {
    "en": "Number of one-one functions"
   },
   "tex": "{}^nP_m = \\frac{n!}{(n-m)!}\\quad (m\\le n)"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-01-relations-and-functions.t3",
   "name": {
    "en": "Number of onto functions"
   },
   "tex": "\\sum_{r=0}^{n}(-1)^r\\binom nr(n-r)^m\\quad (m\\ge n)",
   "note": {
    "en": "e.g. 4 → 3 gives 81 − 48 + 3 = 36"
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-maths-01-relations-and-functions.t3",
   "name": {
    "en": "Bijections of an n-set"
   },
   "tex": "n!;\\quad \\text{derangements } D_n = n!\\sum_{r=0}^n\\frac{(-1)^r}{r!}",
   "note": {
    "en": "D₃ = 2, D₄ = 9, D₅ = 44"
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-01-relations-and-functions.t2",
   "name": {
    "en": "Finite sets of equal size"
   },
   "tex": "|A| = |B| < \\infty:\\ f \\text{ one-one}\\iff f\\text{ onto}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-maths-01-relations-and-functions.t4",
   "name": {
    "en": "Composition"
   },
   "tex": "(g\\circ f)(x) = g(f(x));\\quad g\\circ f\\ne f\\circ g\\ \\text{in general}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-maths-01-relations-and-functions.t4",
   "name": {
    "en": "Composition and inverse"
   },
   "tex": "(g\\circ f)^{-1} = f^{-1}\\circ g^{-1}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-maths-01-relations-and-functions.t5",
   "name": {
    "en": "Invertible function"
   },
   "tex": "f\\ \\text{invertible}\\iff f\\ \\text{bijective};\\quad f^{-1}\\circ f = I_A,\\ f\\circ f^{-1} = I_B"
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Finding an inverse"
   },
   "tex": "y = f(x)\\ \\Rightarrow\\ \\text{solve for } x\\ \\Rightarrow\\ f^{-1}(y)"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Self-inverse Möbius map"
   },
   "tex": "f(x) = \\frac{ax+b}{cx+d}\\ \\text{with}\\ a+d = 0\\Rightarrow f\\circ f = I"
  }
 ]
}
