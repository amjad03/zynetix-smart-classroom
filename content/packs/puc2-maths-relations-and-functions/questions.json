[
 {
  "id": "2m01-q01",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t1",
  "stem": {
   "en": "How many relations are there on the set A = {a, b}?"
  },
  "options": [
   {
    "en": "2"
   },
   {
    "en": "16"
   },
   {
    "en": "8"
   },
   {
    "en": "4"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "A × A has 2 × 2 = 4 pairs, so there are 2⁴ = 16 subsets, i.e. 16 relations."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2m01-q02",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t1",
  "stem": {
   "en": "The relation R = {(a, b) : a ≤ b} on the set of real numbers is:"
  },
  "options": [
   {
    "en": "Reflexive and transitive but not symmetric"
   },
   {
    "en": "Reflexive and symmetric but not transitive"
   },
   {
    "en": "Symmetric and transitive but not reflexive"
   },
   {
    "en": "An equivalence relation"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "a ≤ a (reflexive); a ≤ b, b ≤ c give a ≤ c (transitive); but 1 ≤ 2 while 2 ≤ 1 is false (not symmetric)."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2m01-q03",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t1",
  "stem": {
   "en": "On A = {1, 2, 3}, R = {(1, 1), (2, 2), (3, 3), (1, 2)} is:"
  },
  "options": [
   {
    "en": "Symmetric and transitive but not reflexive"
   },
   {
    "en": "An equivalence relation"
   },
   {
    "en": "Reflexive and symmetric but not transitive"
   },
   {
    "en": "Reflexive and transitive but not symmetric"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "All (a, a) are present, so R is reflexive. (1, 2) ∈ R but (2, 1) ∉ R, so it is not symmetric. Every chain gives a pair already in R, so it is transitive."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2m01-q04",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t1",
  "stem": {
   "en": "On the set of all lines in a plane, the relation \"L₁ is perpendicular to L₂\" is:"
  },
  "options": [
   {
    "en": "Reflexive and symmetric only"
   },
   {
    "en": "Symmetric but neither reflexive nor transitive"
   },
   {
    "en": "An equivalence relation"
   },
   {
    "en": "Transitive only"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "No line is perpendicular to itself; if L₁ ⊥ L₂ then L₂ ⊥ L₁; but L₁ ⊥ L₂ and L₂ ⊥ L₃ make L₁ parallel to L₃, not perpendicular."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2m01-q05",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t2",
  "stem": {
   "en": "On Z, a R b if a − b is divisible by 5. How many distinct equivalence classes are there?"
  },
  "options": [
   {
    "en": "4"
   },
   {
    "en": "1"
   },
   {
    "en": "Infinitely many"
   },
   {
    "en": "5"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The classes are the remainders 0, 1, 2, 3, 4 on division by 5."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2m01-q06",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t2",
  "stem": {
   "en": "Which of these is an equivalence relation on the set of all triangles in a plane?"
  },
  "options": [
   {
    "en": "\"is similar to\""
   },
   {
    "en": "\"has a smaller perimeter than\""
   },
   {
    "en": "\"is inscribed in\""
   },
   {
    "en": "\"has a greater area than\""
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Similarity is reflexive, symmetric and transitive. \"Greater area\" and \"smaller perimeter\" are not reflexive or symmetric; \"inscribed in\" is not reflexive."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2m01-q07",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t2",
  "stem": {
   "en": "R = {(a, b) : |a − b| is even} on A = {1, 2, 3, 4, 5}. The equivalence class [2] is:"
  },
  "options": [
   {
    "en": "{2}"
   },
   {
    "en": "{1, 3, 5}"
   },
   {
    "en": "{1, 2, 3, 4, 5}"
   },
   {
    "en": "{2, 4}"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "b is related to 2 when b − 2 is even, i.e. b is even: [2] = {2, 4}."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK",
   "JEE"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2m01-q08",
  "chapterId": "puc2-maths-01-relations-and-functions",
  "topicId": "puc2-maths-01-relations-and-functions.t2",
  "stem": {
   "en": "Let A = {1, 2, 3}. The number of relations on A containing (1, 2) and (1, 3) that are reflexive and symmetric but not transitive is:"
  },
  "options": [
   {
    "en": "2"
   },
   {
    "en": "4"
   },
   {
    "en": "1"
   },
   {
    "en": "3"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "R must contain (1,1), (2,2), (3,3), (1,2), (2,1), (1,3), (3,1). This R is not transitive since (2,1), (1,3) ∈ R but (2,3) ∉ R. Adding (2,3) forces (3,2) and gives A × A, which is transitive. So exactly one relation works."
  },
  "exams": [
   "KCET",
   "COMEDK",
   "JEE"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
