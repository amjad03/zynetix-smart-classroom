  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "f(x) = x², g(x) = 2x + 1. Find g∘f and f∘g, and compare them at x = 1."
   },
   "steps": [
    {
     "en": "(g∘f)(x) = g(x²) = 2x² + 1."
    },
    {
     "en": "(f∘g)(x) = f(2x + 1) = (2x + 1)²."
    },
    {
     "en": "At x = 1: g∘f gives 3, f∘g gives 9."
    }
   ],
   "answer": {
    "en": "g∘f ≠ f∘g"
   },
   "narration": {
    "en": "Let us solve this together. f(x) = x², g(x) = 2x + 1. Find g∘f and f∘g, and compare them at x = 1."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "f(x) = 8x³ and g(x) = x^(1/3). Find g∘f and f∘g."
   },
   "steps": [
    {
     "en": "(g∘f)(x) = (8x³)^(1/3) = 2x."
    },
    {
     "en": "(f∘g)(x) = 8(x^(1/3))³ = 8x."
    }
   ],
   "answer": {
    "en": "g∘f(x) = 2x, f∘g(x) = 8x"
   },
   "narration": {
    "en": "Let us solve this together. f(x) = 8x³ and g(x) = x^(1/3). Find g∘f and f∘g."
   }
