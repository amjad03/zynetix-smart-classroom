 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "A machine after a machine",
    "kn": "ಯಂತ್ರದ ನಂತರ ಯಂತ್ರ"
   },
   "hook": {
    "en": "A juicer turns fruit into juice, and a freezer turns juice into ice candy. Joining the two machines gives a new one: fruit in, ice candy out. That is composition.",
    "kn": "ಜ್ಯೂಸರ್ ಹಣ್ಣನ್ನು ರಸವಾಗಿಸುತ್ತದೆ, ಫ್ರೀಜರ್ ರಸವನ್ನು ಐಸ್ ಕ್ಯಾಂಡಿಯಾಗಿಸುತ್ತದೆ. ಎರಡನ್ನೂ ಜೋಡಿಸಿದರೆ ಹೊಸ ಯಂತ್ರ: ಹಣ್ಣು ಒಳಗೆ, ಐಸ್ ಕ್ಯಾಂಡಿ ಹೊರಗೆ. ಇದೇ ಸಂಯೋಜನೆ."
   },
   "objectives": [
    {
     "en": "Form g∘f and f∘g"
    },
    {
     "en": "See that composition is not commutative"
    },
    {
     "en": "Use composition with modulus and rational functions"
    }
   ],
   "narration": {
    "en": "A juicer turns fruit into juice, and a freezer turns juice into ice candy. Joining the two machines gives a new one: fruit in, ice candy out. That is composition.",
    "kn": "ಜ್ಯೂಸರ್ ಹಣ್ಣನ್ನು ರಸವಾಗಿಸುತ್ತದೆ, ಫ್ರೀಜರ್ ರಸವನ್ನು ಐಸ್ ಕ್ಯಾಂಡಿಯಾಗಿಸುತ್ತದೆ. ಎರಡನ್ನೂ ಜೋಡಿಸಿದರೆ ಹೊಸ ಯಂತ್ರ: ಹಣ್ಣು ಒಳಗೆ, ಐಸ್ ಕ್ಯಾಂಡಿ ಹೊರಗೆ. ಇದೇ ಸಂಯೋಜನೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "g∘f"
   },
   "body": {
    "en": "If $f : A \\to B$ and $g : B \\to C$, the composition $g \\circ f : A \\to C$ is defined by $(g \\circ f)(x) = g(f(x))$. Apply $f$ first, then $g$. In general $g \\circ f \\ne f \\circ g$, but composition is associative.",
    "kn": "f : A → B, g : B → C ಆದರೆ (g∘f)(x) = g(f(x)). ಮೊದಲು f, ನಂತರ g. ಸಾಮಾನ್ಯವಾಗಿ g∘f ≠ f∘g."
   },
   "points": [
    {
     "en": "Read g∘f right to left: f first"
    },
    {
     "en": "g∘f ≠ f∘g in general"
    },
    {
     "en": "h∘(g∘f) = (h∘g)∘f"
    },
    {
     "en": "If f and g are one-one (onto), so is g∘f"
    }
   ],
   "narration": {
    "en": "g of f means: apply f first, then g. Usually g of f and f of g are different functions, but composition is associative.",
    "kn": "f : A → B, g : B → C ಆದರೆ (g∘f)(x) = g(f(x)). ಮೊದಲು f, ನಂತರ g. ಸಾಮಾನ್ಯವಾಗಿ g∘f ≠ f∘g."
   },
   "formula": "(g \\circ f)(x) = g(f(x))"
  },
