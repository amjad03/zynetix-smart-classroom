   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "f : R → R, f(x) = 4x + 3. Find f⁻¹."
   },
   "steps": [
    {
     "en": "f is one-one and onto (a non-constant linear function)."
    },
    {
     "en": "y = 4x + 3 ⇒ x = (y − 3)/4."
    },
    {
     "en": "So f⁻¹(y) = (y − 3)/4."
    }
   ],
   "answer": {
    "en": "f⁻¹(x) = (x − 3)/4"
   },
   "narration": {
    "en": "Let us solve this together. f : R → R, f(x) = 4x + 3. Find f⁻¹."
   }
