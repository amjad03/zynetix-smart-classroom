 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Same remainder, same team",
    "kn": "ಒಂದೇ ಶೇಷ, ಒಂದೇ ತಂಡ"
   },
   "hook": {
    "en": "Divide every integer by 2 and look at the remainder: the whole of Z splits neatly into evens and odds. Relations that sort a set into such groups are called equivalence relations.",
    "kn": "ಪ್ರತಿ ಪೂರ್ಣಾಂಕವನ್ನು 2 ರಿಂದ ಭಾಗಿಸಿ ಶೇಷ ನೋಡಿ: Z ಸಮ ಮತ್ತು ಬೆಸ ಸಂಖ್ಯೆಗಳಾಗಿ ವಿಭಜನೆಯಾಗುತ್ತದೆ. ಹೀಗೆ ಗುಂಪು ಮಾಡುವ ಸಂಬಂಧಗಳೇ ಸಮಾನತಾ ಸಂಬಂಧಗಳು."
   },
   "objectives": [
    {
     "en": "Define an equivalence relation"
    },
    {
     "en": "Find equivalence classes"
    },
    {
     "en": "See how classes partition a set"
    }
   ],
   "narration": {
    "en": "Divide every integer by 2 and look at the remainder: the whole of Z splits neatly into evens and odds. Relations that sort a set into such groups are called equivalence relations.",
    "kn": "ಪ್ರತಿ ಪೂರ್ಣಾಂಕವನ್ನು 2 ರಿಂದ ಭಾಗಿಸಿ ಶೇಷ ನೋಡಿ: Z ಸಮ ಮತ್ತು ಬೆಸ ಸಂಖ್ಯೆಗಳಾಗಿ ವಿಭಜನೆಯಾಗುತ್ತದೆ. ಹೀಗೆ ಗುಂಪು ಮಾಡುವ ಸಂಬಂಧಗಳೇ ಸಮಾನತಾ ಸಂಬಂಧಗಳು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Equivalence relation"
   },
   "body": {
    "en": "A relation that is reflexive, symmetric and transitive is an equivalence relation. Example: on $Z$, $R = \\{(a, b) : 2 \\text{ divides } a - b\\}$ is an equivalence relation.",
    "kn": "ಸ್ವವಾಚಕ, ಸಮಮಿತೀಯ ಮತ್ತು ಸಂಕ್ರಾಮಕ ಆಗಿರುವ ಸಂಬಂಧವೇ ಸಮಾನತಾ ಸಂಬಂಧ."
   },
   "points": [
    {
     "en": "\"Is equal to\", \"is similar to\", \"has the same remainder as\" are equivalence relations"
    },
    {
     "en": "\"Is less than\" is not (not reflexive, not symmetric)"
    }
   ],
   "narration": {
    "en": "A relation that is reflexive, symmetric and transitive at the same time is called an equivalence relation.",
    "kn": "ಸ್ವವಾಚಕ, ಸಮಮಿತೀಯ ಮತ್ತು ಸಂಕ್ರಾಮಕ ಆಗಿರುವ ಸಂಬಂಧವೇ ಸಮಾನತಾ ಸಂಬಂಧ."
   }
  },
