 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Roll numbers and students",
    "kn": "ಕ್ರಮ ಸಂಖ್ಯೆಗಳು ಮತ್ತು ವಿದ್ಯಾರ್ಥಿಗಳು"
   },
   "hook": {
    "en": "Every student in this room has exactly one roll number, and no two students share one. That is a one-one function. If every roll number is used, it is onto as well.",
    "kn": "ಈ ತರಗತಿಯ ಪ್ರತಿ ವಿದ್ಯಾರ್ಥಿಗೆ ಒಂದೇ ಕ್ರಮ ಸಂಖ್ಯೆ, ಇಬ್ಬರಿಗೆ ಒಂದೇ ಸಂಖ್ಯೆ ಇಲ್ಲ. ಇದು ಏಕೈಕ ಫಲನ. ಎಲ್ಲ ಕ್ರಮ ಸಂಖ್ಯೆಗಳು ಬಳಕೆಯಾದರೆ ಅದು ಮೇಲ್ಮುಖವೂ ಹೌದು."
   },
   "objectives": [
    {
     "en": "Define one-one (injective) and onto (surjective) functions"
    },
    {
     "en": "Prove a function is a bijection"
    },
    {
     "en": "Count functions between finite sets"
    }
   ],
   "narration": {
    "en": "Every student in this room has exactly one roll number, and no two students share one. That is a one-one function. If every roll number is used, it is onto as well.",
    "kn": "ಈ ತರಗತಿಯ ಪ್ರತಿ ವಿದ್ಯಾರ್ಥಿಗೆ ಒಂದೇ ಕ್ರಮ ಸಂಖ್ಯೆ, ಇಬ್ಬರಿಗೆ ಒಂದೇ ಸಂಖ್ಯೆ ಇಲ್ಲ. ಇದು ಏಕೈಕ ಫಲನ. ಎಲ್ಲ ಕ್ರಮ ಸಂಖ್ಯೆಗಳು ಬಳಕೆಯಾದರೆ ಅದು ಮೇಲ್ಮುಖವೂ ಹೌದು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "One-one, onto, bijective"
   },
   "body": {
    "en": "$f : X \\to Y$ is one-one (injective) if $f(x_1) = f(x_2)$ implies $x_1 = x_2$. It is onto (surjective) if every $y \\in Y$ is $f(x)$ for some $x \\in X$, i.e. range = codomain. A function that is both is a bijection.",
    "kn": "f(x₁) = f(x₂) ⇒ x₁ = x₂ ಆದರೆ f ಏಕೈಕ (one-one). ಪ್ರತಿ y ∈ Y ಗೆ ಪೂರ್ವಪ್ರತಿಬಿಂಬ ಇದ್ದರೆ, ಅಂದರೆ ವ್ಯಾಪ್ತಿ = ಸಹಪ್ರದೇಶ ಆದರೆ f ಮೇಲ್ಮುಖ (onto). ಎರಡೂ ಆದರೆ ದ್ವಿಮುಖ (bijective)."
   },
   "points": [
    {
     "en": "One-one: different inputs, different outputs"
    },
    {
     "en": "Onto: range equals codomain"
    },
    {
     "en": "Bijective: both"
    }
   ],
   "narration": {
    "en": "A function is one-one if different inputs always give different outputs. It is onto if every element of the codomain is actually reached. If it is both, it is a bijection.",
    "kn": "f(x₁) = f(x₂) ⇒ x₁ = x₂ ಆದರೆ f ಏಕೈಕ (one-one). ಪ್ರತಿ y ∈ Y ಗೆ ಪೂರ್ವಪ್ರತಿಬಿಂಬ ಇದ್ದರೆ, ಅಂದರೆ ವ್ಯಾಪ್ತಿ = ಸಹಪ್ರದೇಶ ಆದರೆ f ಮೇಲ್ಮುಖ (onto). ಎರಡೂ ಆದರೆ ದ್ವಿಮುಖ (bijective)."
   },
   "formula": "f(x_1) = f(x_2) \\Rightarrow x_1 = x_2"
  },
