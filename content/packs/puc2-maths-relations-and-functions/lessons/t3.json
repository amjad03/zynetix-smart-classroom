  {
   "id": "concept2",
   "type": "concept",
   "title": {
    "en": "Counting functions"
   },
   "body": {
    "en": "If $n(A) = m$ and $n(B) = n$, there are $n^m$ functions from $A$ to $B$. When $m \\le n$, the number of one-one functions is $n(n-1)\\cdots(n-m+1)$. When $m = n$, a function between finite sets is one-one exactly when it is onto, and there are $n!$ bijections.",
    "kn": "n(A) = m, n(B) = n ಆದರೆ A ಯಿಂದ B ಗೆ nᵐ ಫಲನಗಳಿವೆ. m = n ಆದಾಗ ದ್ವಿಮುಖ ಫಲನಗಳ ಸಂಖ್ಯೆ n!."
   },
   "points": [
    {
     "en": "All functions: nᵐ"
    },
    {
     "en": "One-one (m ≤ n): ⁿPₘ"
    },
    {
     "en": "Bijections (m = n): n!"
    }
   ],
   "narration": {
    "en": "From a set of m elements to a set of n elements there are n to the power m functions. One-one functions number n P m, and when the sets have equal size there are n factorial bijections.",
    "kn": "n(A) = m, n(B) = n ಆದರೆ A ಯಿಂದ B ಗೆ nᵐ ಫಲನಗಳಿವೆ. m = n ಆದಾಗ ದ್ವಿಮುಖ ಫಲನಗಳ ಸಂಖ್ಯೆ n!."
   }
  },
