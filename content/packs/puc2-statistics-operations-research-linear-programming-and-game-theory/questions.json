[
 {
  "id": "2t10-q01",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t1",
  "stem": {
   "en": "In a linear programming problem, the linear function that is to be maximised or minimised is called the:"
  },
  "options": [
   {
    "en": "constraint"
   },
   {
    "en": "feasible region"
   },
   {
    "en": "decision variable"
   },
   {
    "en": "objective function"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "The objective function, e.g. Z = 40x + 30y, measures profit or cost; the constraints limit the choice."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q02",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t1",
  "stem": {
   "en": "The conditions x ≥ 0, y ≥ 0 in an LPP are called:"
  },
  "options": [
   {
    "en": "optimal solutions"
   },
   {
    "en": "objective functions"
   },
   {
    "en": "non-negativity constraints"
   },
   {
    "en": "redundant constraints"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Quantities produced or bought cannot be negative, so every LPP includes non-negativity restrictions."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q03",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t1",
  "stem": {
   "en": "A firm makes x units of A (profit ₹40 each) and y units of B (profit ₹30 each). The objective function is:"
  },
  "options": [
   {
    "en": "Maximise Z = 70(x + y)"
   },
   {
    "en": "Maximise Z = 40x + 30y"
   },
   {
    "en": "Minimise Z = 40x + 30y"
   },
   {
    "en": "Maximise Z = 30x + 40y"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Total profit = 40 per A × x + 30 per B × y, to be maximised."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q04",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t1",
  "stem": {
   "en": "Each unit of A needs 2 hours and each unit of B needs 1 hour on a machine available for 100 hours. The machine constraint is:"
  },
  "options": [
   {
    "en": "x + 2y ≤ 100"
   },
   {
    "en": "2x + y = 100"
   },
   {
    "en": "2x + y ≤ 100"
   },
   {
    "en": "2x + y ≥ 100"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Hours used = 2x + y and they cannot exceed the 100 hours available."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q05",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t1",
  "stem": {
   "en": "Food F₁ has 2 units of vitamin A per kg and food F₂ has 4 units per kg. A diet must give at least 40 units. With x kg of F₁ and y kg of F₂, the vitamin constraint is:"
  },
  "options": [
   {
    "en": "2x + 4y ≤ 40"
   },
   {
    "en": "x + y ≥ 40"
   },
   {
    "en": "2x + 4y ≥ 40"
   },
   {
    "en": "4x + 2y ≥ 40"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "\"At least\" gives ≥: vitamin from the diet = 2x + 4y must be 40 or more. (Such a diet problem is usually a minimisation of cost.)"
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t10-q06",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t2",
  "stem": {
   "en": "If an LPP has an optimal solution, it occurs at:"
  },
  "options": [
   {
    "en": "any point outside the feasible region"
   },
   {
    "en": "the origin always"
   },
   {
    "en": "the centre of the feasible region"
   },
   {
    "en": "a corner point (vertex) of the feasible region"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "For a linear objective over a convex polygon, the optimum is at a vertex (or along an edge between two vertices)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q07",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t2",
  "stem": {
   "en": "The feasible region of an LPP is the set of points that:"
  },
  "options": [
   {
    "en": "make the objective function zero"
   },
   {
    "en": "lie on the axes"
   },
   {
    "en": "satisfy at least one constraint"
   },
   {
    "en": "satisfy all the constraints including non-negativity"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Only points that obey every constraint and x, y ≥ 0 are feasible."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q08",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t2",
  "stem": {
   "en": "The corner points of a feasible region are (0, 0), (4, 0), (3, 1.5) and (0, 3). The maximum of Z = 5x + 4y is:"
  },
  "options": [
   {
    "en": "12"
   },
   {
    "en": "27"
   },
   {
    "en": "20"
   },
   {
    "en": "21"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Z = 0, 20, 15 + 6 = 21, 12. Maximum 21 at (3, 1.5)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q09",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t2",
  "stem": {
   "en": "Maximise Z = 40x + 30y subject to 2x + y ≤ 100, x + y ≤ 80, x, y ≥ 0. The optimal solution is:"
  },
  "options": [
   {
    "en": "x = 20, y = 60, Z = 2600"
   },
   {
    "en": "x = 0, y = 80, Z = 2400"
   },
   {
    "en": "x = 50, y = 0, Z = 2000"
   },
   {
    "en": "x = 40, y = 40, Z = 2800"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Corners (0, 0), (50, 0), (20, 60), (0, 80) give Z = 0, 2000, 2600, 2400. (40, 40) is not feasible: 2(40) + 40 = 120 > 100."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q10",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t2",
  "stem": {
   "en": "Minimise Z = 3x + 2y subject to x + y ≥ 8, 3x + 5y ≥ 30, x, y ≥ 0. The minimum value of Z is:"
  },
  "options": [
   {
    "en": "21"
   },
   {
    "en": "16"
   },
   {
    "en": "12"
   },
   {
    "en": "30"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "The feasible region is unbounded with corners (0, 8), (5, 3), (10, 0): Z = 16, 21, 30. Minimum 16 at (0, 8)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t10-q11",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t3",
  "stem": {
   "en": "In a two-person zero-sum game:"
  },
  "options": [
   {
    "en": "both players can gain together"
   },
   {
    "en": "the payoffs always add to 100"
   },
   {
    "en": "there must be a saddle point"
   },
   {
    "en": "the gain of one player equals the loss of the other"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Zero-sum: what A wins, B loses, so the sum of their gains is zero."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q12",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t3",
  "stem": {
   "en": "A game has a saddle point when:"
  },
  "options": [
   {
    "en": "the matrix is square"
   },
   {
    "en": "maximin value = minimax value"
   },
   {
    "en": "all payoffs are positive"
   },
   {
    "en": "maximin value > minimax value"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "If max of row minima equals min of column maxima, that common entry is the saddle point and the value of the game."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q13",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t3",
  "stem": {
   "en": "For the payoff matrix (to A) with rows (−1, 2, −2), (6, 4, 5), (3, −1, 0), the value of the game is:"
  },
  "options": [
   {
    "en": "4"
   },
   {
    "en": "5"
   },
   {
    "en": "−1"
   },
   {
    "en": "6"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Row minima −2, 4, −1 → maximin 4. Column maxima 6, 4, 5 → minimax 4. Saddle point (A₂, B₂), value 4."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q14",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t3",
  "stem": {
   "en": "A game is said to be fair if:"
  },
  "options": [
   {
    "en": "its value is zero"
   },
   {
    "en": "both players have two strategies"
   },
   {
    "en": "its value is positive"
   },
   {
    "en": "it has a saddle point"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "Value 0 means neither player gains in the long run."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q15",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t3",
  "stem": {
   "en": "The payoff matrix to A has rows (p, 6, 2), (−1, p, −7), (−2, 4, p). The game is strictly determinable for:"
  },
  "options": [
   {
    "en": "p ≥ 2"
   },
   {
    "en": "−1 ≤ p ≤ 2"
   },
   {
    "en": "−2 ≤ p ≤ 6"
   },
   {
    "en": "−7 ≤ p ≤ −1"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Ignoring p, the row minima give maximin 2 and the column maxima give minimax −1. A saddle point needs −1 ≤ value ≤ 2, i.e. −1 ≤ p ≤ 2 (then maximin = minimax = p)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t10-q16",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t4",
  "stem": {
   "en": "A mixed strategy is one in which a player:"
  },
  "options": [
   {
    "en": "always plays the same strategy"
   },
   {
    "en": "copies the opponent"
   },
   {
    "en": "chooses among strategies with fixed probabilities"
   },
   {
    "en": "plays a strategy not in the matrix"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Without a saddle point, each player randomises: e.g. A₁ with probability p₁ and A₂ with p₂ = 1 − p₁."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q17",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t4",
  "stem": {
   "en": "For the matching-pennies game with rows (1, −1) and (−1, 1), the value of the game is:"
  },
  "options": [
   {
    "en": "0"
   },
   {
    "en": "1/2"
   },
   {
    "en": "1"
   },
   {
    "en": "−1"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "p₁ = (1 + 1)/(1 + 1 + 1 + 1) = 1/2 and v = (1 − 1)/4 = 0: a fair game."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q18",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t4",
  "stem": {
   "en": "For the game with rows (3, −1) and (−2, 4), the probability with which A should play A₁ is:"
  },
  "options": [
   {
    "en": "0.3"
   },
   {
    "en": "0.5"
   },
   {
    "en": "0.4"
   },
   {
    "en": "0.6"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "p₁ = (a₂₂ − a₂₁)/(a₁₁ + a₂₂ − a₁₂ − a₂₁) = (4 + 2)/(3 + 4 + 1 + 2) = 6/10 = 0.6."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q19",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t4",
  "stem": {
   "en": "The value of the game with rows (5, 1) and (3, 4) is:"
  },
  "options": [
   {
    "en": "3.4"
   },
   {
    "en": "3"
   },
   {
    "en": "2.5"
   },
   {
    "en": "4"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "No saddle point (maximin 3 ≠ minimax 4). v = (a₁₁a₂₂ − a₁₂a₂₁)/(a₁₁ + a₂₂ − a₁₂ − a₂₁) = (20 − 3)/(5 + 4 − 1 − 3) = 17/5 = 3.4."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q20",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t4",
  "stem": {
   "en": "For the game with rows (2, 5) and (4, 1), the optimal strategy of B (probabilities of B₁, B₂) is:"
  },
  "options": [
   {
    "en": "(3/4, 1/4)"
   },
   {
    "en": "(2/3, 1/3)"
   },
   {
    "en": "(1/3, 2/3)"
   },
   {
    "en": "(1/2, 1/2)"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Denominator 2 + 1 − 5 − 4 = −6. q₁ = (a₂₂ − a₁₂)/(−6) = (1 − 5)/(−6) = 2/3, q₂ = 1/3. (A plays (1/2, 1/2); v = (2 − 20)/(−6) = 3.)"
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
 {
  "id": "2t10-q21",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t5",
  "stem": {
   "en": "For player A (the maximising player), a row can be deleted if:"
  },
  "options": [
   {
    "en": "every element of it is ≤ the corresponding element of another row"
   },
   {
    "en": "it contains the largest element"
   },
   {
    "en": "every element of it is ≥ the corresponding element of another row"
   },
   {
    "en": "it contains a zero"
   }
  ],
  "answer": 0,
  "explanation": {
   "en": "A would never choose a row that is never better than another row: it is dominated."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q22",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t5",
  "stem": {
   "en": "For player B (the minimising player), a column can be deleted if:"
  },
  "options": [
   {
    "en": "every element of it is ≤ the corresponding element of another column"
   },
   {
    "en": "it contains the smallest element"
   },
   {
    "en": "every element of it is ≥ the corresponding element of another column"
   },
   {
    "en": "its sum is zero"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "B pays A's gain, so B never uses a column that always costs at least as much as another."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t10-q23",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t5",
  "stem": {
   "en": "In the payoff matrix with rows A₁ (1, 7, 2), A₂ (6, 2, 7), A₃ (5, 1, 6), which row is dominated?"
  },
  "options": [
   {
    "en": "A₂, by A₃"
   },
   {
    "en": "No row is dominated"
   },
   {
    "en": "A₁, by A₂"
   },
   {
    "en": "A₃, by A₂"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "A₃ = (5, 1, 6) ≤ A₂ = (6, 2, 7) element by element, so A₃ is deleted."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q24",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t5",
  "stem": {
   "en": "After deleting A₃ and the dominated column B₃ from the matrix with rows (1, 7, 2), (6, 2, 7), (5, 1, 6), the value of the game is:"
  },
  "options": [
   {
    "en": "2"
   },
   {
    "en": "3.5"
   },
   {
    "en": "6"
   },
   {
    "en": "4"
   }
  ],
  "answer": 3,
  "explanation": {
   "en": "Reduced 2 × 2: rows (1, 7), (6, 2). D = 1 + 2 − 7 − 6 = −10; v = (2 − 42)/(−10) = 4. A plays (0.4, 0.6, 0), B plays (0.5, 0.5, 0)."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "medium",
  "tags": []
 },
 {
  "id": "2t10-q25",
  "chapterId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory",
  "topicId": "puc2-statistics-10-operations-research-linear-programming-and-game-theory.t5",
  "stem": {
   "en": "Using dominance, the value of the game with rows (4, 2, 5), (1, 6, 7), (3, 1, 4) is:"
  },
  "options": [
   {
    "en": "18/7"
   },
   {
    "en": "3"
   },
   {
    "en": "22/7"
   },
   {
    "en": "4"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Row 3 ≤ row 1: delete A₃. Then column 3 ≥ column 1: delete B₃. Rows (4, 2), (1, 6): D = 4 + 6 − 2 − 1 = 7; v = (24 − 2)/7 = 22/7 ≈ 3.14."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "hard",
  "tags": []
 },
