{
 "chapterId": "puc2-maths-08-application-of-integrals",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-maths-08-application-of-integrals.t1",
   "name": {
    "en": "Area under a curve (x-axis)"
   },
   "tex": "A = \\int_a^b|f(x)|\\,dx",
   "note": {
    "en": "Split at the zeros of f; a signed integral can be 0 while the area is not."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Area w.r.t. y-axis"
   },
   "tex": "A = \\int_c^d|g(y)|\\,dy\\quad(x = g(y))"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-08-application-of-integrals.t4",
   "name": {
    "en": "Area between two curves"
   },
   "tex": "A = \\int_a^b\\big(f(x) - g(x)\\big)\\,dx,\\quad f \\ge g\\ \\text{on}\\ [a, b]",
   "note": {
    "en": "Limits are the x-coordinates of the intersection points; switch upper/lower curve where they cross."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Horizontal strips"
   },
   "tex": "A = \\int_c^d\\big(x_{\\text{right}}(y) - x_{\\text{left}}(y)\\big)\\,dy"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-maths-08-application-of-integrals.t3",
   "name": {
    "en": "Circle"
   },
   "tex": "x^2 + y^2 = r^2:\\quad A = \\pi r^2",
   "note": {
    "en": "Sector of angle $\\theta$: $\\frac12r^2\\theta$."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-08-application-of-integrals.t3",
   "name": {
    "en": "Ellipse"
   },
   "tex": "\\frac{x^2}{a^2} + \\frac{y^2}{b^2} = 1:\\quad A = \\pi ab"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-08-application-of-integrals.t3",
   "name": {
    "en": "Ellipse and chord"
   },
   "tex": "A_{\\text{minor segment}} = \\frac{\\pi ab}{4} - \\frac{ab}{2} = \\frac{ab(\\pi - 2)}{4}",
   "note": {
    "en": "Chord $\\frac xa + \\frac yb = 1$."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Parabola and latus rectum"
   },
   "tex": "y^2 = 4ax,\\ x = a:\\quad A = \\frac83a^2"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Two parabolas"
   },
   "tex": "y^2 = 4ax\\ \\text{and}\\ x^2 = 4by:\\quad A = \\frac{16ab}{3}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Parabola and line"
   },
   "tex": "A = \\frac{|a|(\\beta - \\alpha)^3}{6}",
   "note": {
    "en": "Area between $y = ax^2 + bx + c$ and a line meeting it at $x = \\alpha, \\beta$ (or the x-axis between its roots)."
   }
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "y = x^2 and y = kx"
   },
   "tex": "A = \\frac{k^3}{6}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Parabola and horizontal line"
   },
   "tex": "y = x^2,\\ y = k:\\quad A = \\frac43k^{3/2}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "One arch of sine"
   },
   "tex": "\\int_0^\\pi\\sin x\\,dx = 2,\\qquad \\int_0^{\\pi}|\\cos x|\\,dx = 2"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Log and exponential"
   },
   "tex": "\\int_1^a\\ln x\\,dx = a\\ln a - a + 1,\\qquad \\int_0^{\\ln a}e^xdx = a - 1"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-08-application-of-integrals.t2",
   "name": {
    "en": "Symmetry"
   },
   "tex": "\\text{Region symmetric about an axis} \\Rightarrow A = 2\\times(\\text{one half})"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "|x| + |y| = a"
   },
   "tex": "A = 2a^2",
   "note": {
    "en": "A square with diagonals 2a."
   }
  }
 ]
}
