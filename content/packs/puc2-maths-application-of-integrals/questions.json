  "stem": {
   "en": "The area bounded by y = x³, the x-axis and the lines x = 0 and x = 2 is:"
  },
  "options": [
   {
    "en": "8 sq. units"
   },
   {
    "en": "4 sq. units"
   },
   {
    "en": "2 sq. units"
   },
   {
    "en": "16/3 sq. units"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "Area = ∫₀² x³ dx = [x⁴/4]₀² = 16/4 = 4 sq. units."
  },
  "exams": [
