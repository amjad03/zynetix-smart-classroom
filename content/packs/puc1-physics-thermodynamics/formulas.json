{
 "chapterId": "puc1-physics-11-thermodynamics",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "First law"
   },
   "tex": "\\Delta Q = \\Delta U + W",
   "note": {
    "en": "W is work done by the gas."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Work in isothermal process"
   },
   "tex": "W = nRT\\ln\\frac{V_2}{V_1}",
   "note": {
    "en": "ΔU = 0 for ideal gas."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "Adiabatic relation"
   },
   "tex": "PV^\\gamma = \\text{const},\\quad TV^{\\gamma-1} = \\text{const}",
   "note": {
    "en": "No heat exchange."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "Adiabatic work"
   },
   "tex": "W = \\frac{P_1V_1 - P_2V_2}{\\gamma - 1}",
   "note": {
    "en": "Positive for expansion."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "Mayer's relation"
   },
   "tex": "C_p - C_v = R",
   "note": {
    "en": "Per mole of ideal gas."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "γ values"
   },
   "tex": "\\gamma_{mono} = \\tfrac53,\\quad \\gamma_{dia} = \\tfrac75",
   "note": {
    "en": "Diatomic at ordinary temperatures."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-physics-11-thermodynamics.t5",
   "name": {
    "en": "Carnot efficiency"
   },
   "tex": "\\eta = 1 - \\frac{T_2}{T_1}",
   "note": {
    "en": "Temperatures in kelvin."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Refrigerator COP"
   },
   "tex": "\\beta = \\frac{T_2}{T_1 - T_2}",
   "note": {
    "en": "Higher when temperatures are close."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-physics-11-thermodynamics.t1",
   "name": {
    "en": "Zeroth law"
   },
   "tex": "A \\sim C,\\ B \\sim C \\Rightarrow A \\sim B",
   "note": {
    "en": "Defines temperature."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "First law"
   },
   "tex": "\\Delta Q = \\Delta U + \\Delta W",
   "note": {
    "en": "ΔW = work done BY the system; Q > 0 when heat is absorbed."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "Work by a gas"
   },
   "tex": "W = \\int P\\,dV = \\text{area under the } P\\text{–}V \\text{ curve}",
   "note": {
    "en": "Cycle: area enclosed; clockwise ⟹ positive work by the gas."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-physics-11-thermodynamics.t1",
   "name": {
    "en": "Internal energy of an ideal gas"
   },
   "tex": "\\Delta U = nC_V\\Delta T",
   "note": {
    "en": "Depends only on T; path-independent."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "Mayer's relation and γ"
   },
   "tex": "C_P - C_V = R,\\qquad \\gamma = \\dfrac{C_P}{C_V}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-physics-11-thermodynamics.t2",
   "name": {
    "en": "Heat capacities"
   },
   "tex": "\\text{mono: } C_V = \\tfrac32R,\\ \\gamma = \\tfrac53;\\quad \\text{diatomic: } C_V = \\tfrac52R,\\ \\gamma = \\tfrac75"
  },
  {
   "id": "zs-f15",
   "name": {
    "en": "Mixture of gases"
   },
   "tex": "C_V = \\dfrac{n_1C_{V1} + n_2C_{V2}}{n_1 + n_2}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Isothermal process"
   },
   "tex": "PV = \\text{const},\\ \\Delta U = 0,\\ W = Q = nRT\\ln\\dfrac{V_2}{V_1}"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Adiabatic process"
   },
   "tex": "PV^\\gamma = \\text{const},\\ TV^{\\gamma-1} = \\text{const},\\ P^{1-\\gamma}T^\\gamma = \\text{const}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Adiabatic work"
   },
   "tex": "W = \\dfrac{P_1V_1 - P_2V_2}{\\gamma - 1} = \\dfrac{nR(T_1 - T_2)}{\\gamma - 1}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Isochoric and isobaric"
   },
   "tex": "V\\ \\text{const}: W = 0,\\ Q = nC_V\\Delta T;\\quad P\\ \\text{const}: W = P\\Delta V,\\ Q = nC_P\\Delta T"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Slopes on P–V diagram"
   },
   "tex": "\\left(\\dfrac{dP}{dV}\\right)_{\\text{adia}} = \\gamma\\left(\\dfrac{dP}{dV}\\right)_{\\text{iso}} = -\\gamma\\dfrac{P}{V}"
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Polytropic process"
   },
   "tex": "PV^x = \\text{const}:\\ W = \\dfrac{nR\\Delta T}{1 - x},\\quad C = C_V + \\dfrac{R}{1 - x}",
   "note": {
    "en": "x = 0 isobaric, 1 isothermal, γ adiabatic, ∞ isochoric."
   }
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-physics-11-thermodynamics.t4",
   "name": {
    "en": "Efficiency of a heat engine"
   },
   "tex": "\\eta = \\dfrac{W}{Q_1} = 1 - \\dfrac{Q_2}{Q_1}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-physics-11-thermodynamics.t5",
   "name": {
    "en": "Carnot efficiency"
   },
   "tex": "\\eta = 1 - \\dfrac{T_2}{T_1}",
   "note": {
    "en": "Kelvin temperatures; independent of the working substance (Carnot's theorem)."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc1-physics-11-thermodynamics.t5",
   "name": {
    "en": "Carnot engines in series (equal efficiency)"
   },
   "tex": "T = \\sqrt{T_1T_2}"
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Refrigerator"
   },
   "tex": "\\alpha = \\dfrac{Q_2}{W} = \\dfrac{T_2}{T_1 - T_2}\\ (\\text{Carnot})"
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "Heat pump"
   },
   "tex": "\\dfrac{Q_1}{W} = \\dfrac{T_1}{T_1 - T_2} = \\alpha + 1"
  },
  {
   "id": "zs-f27",
   "topicId": "puc1-physics-11-thermodynamics.t4",
   "name": {
    "en": "Second law"
   },
   "tex": "\\eta < 1;\\ \\text{heat does not flow cold} \\to \\text{hot by itself}",
   "note": {
    "en": "Kelvin–Planck and Clausius statements."
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc1-physics-11-thermodynamics.t3",
   "name": {
    "en": "Cyclic process"
   },
   "tex": "\\Delta U = 0,\\quad Q_{\\text{net}} = W_{\\text{net}}"
  },
  {
   "id": "zs-f29",
   "topicId": "puc1-physics-11-thermodynamics.t4",
   "name": {
    "en": "Free expansion of an ideal gas"
   },
   "tex": "Q = 0,\\ W = 0,\\ \\Delta U = 0,\\ \\Delta T = 0",
   "note": {
    "en": "Irreversible; not a PV^γ process."
   }
  }
 ]
}
