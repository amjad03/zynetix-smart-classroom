   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "A Carnot engine works between 500 K and 300 K and absorbs 1000 J per cycle. Find its efficiency, the work done and the heat rejected per cycle."
   },
   "steps": [
    {
     "en": "η = 1 − 300/500 = 0.4."
    },
    {
     "en": "W = ηQ₁ = 0.4 × 1000 = 400 J."
    },
    {
     "en": "Q₂ = Q₁ − W = 600 J."
    }
   ],
