{
 "chapterId": "puc2-physics-05-magnetism-and-matter",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Dipole field: axial"
   },
   "tex": "B_{ax} = \\frac{\\mu_0}{4\\pi}\\frac{2m}{r^3}",
   "note": {
    "en": "Along m."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-05-magnetism-and-matter.t1",
   "name": {
    "en": "Dipole field: equatorial"
   },
   "tex": "B_{eq} = \\frac{\\mu_0}{4\\pi}\\frac{m}{r^3}",
   "note": {
    "en": "Opposite to m."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-05-magnetism-and-matter.t1",
   "name": {
    "en": "Dipole field: general point"
   },
   "tex": "B = \\frac{\\mu_0 m}{4\\pi r^3}\\sqrt{1 + 3\\cos^2\\theta},\\quad \\tan\\alpha = \\tfrac12\\tan\\theta"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-05-magnetism-and-matter.t2",
   "name": {
    "en": "Torque and potential energy"
   },
   "tex": "\\tau = mB\\sin\\theta,\\quad U = -mB\\cos\\theta",
   "note": {
    "en": "W(theta1 to theta2) = mB(cos theta1 - cos theta2)."
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Oscillating magnet"
   },
   "tex": "T = 2\\pi\\sqrt{\\frac{I}{mB}}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-05-magnetism-and-matter.t1",
   "name": {
    "en": "Moment of a solenoid / bar magnet"
   },
   "tex": "m = NIA = p\\,(2l)",
   "note": {
    "en": "Bent into semicircle: 2m/pi; L-shape at midpoint: m/sqrt2."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-05-magnetism-and-matter.t3",
   "name": {
    "en": "Gauss's law for magnetism"
   },
   "tex": "\\oint \\vec B\\cdot d\\vec A = 0",
   "note": {
    "en": "No magnetic monopoles; field lines are closed loops."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-05-magnetism-and-matter.t4",
   "name": {
    "en": "Magnetic intensity and magnetisation"
   },
   "tex": "\\vec B = \\mu_0(\\vec H + \\vec M),\\quad H = nI"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-05-magnetism-and-matter.t4",
   "name": {
    "en": "Susceptibility and permeability"
   },
   "tex": "M = \\chi H,\\quad \\mu_r = 1 + \\chi,\\quad \\mu = \\mu_r\\mu_0"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-05-magnetism-and-matter.t5",
   "name": {
    "en": "Diamagnetic"
   },
   "tex": "-1 \\le \\chi < 0,\\quad \\mu_r < 1",
   "note": {
    "en": "Pushed to weaker field; superconductor chi = -1 (Meissner)."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-05-magnetism-and-matter.t5",
   "name": {
    "en": "Paramagnetic (Curie's law)"
   },
   "tex": "\\chi = \\frac{C}{T},\\quad M = C\\frac{B}{T}",
   "note": {
    "en": "Small positive chi; T in kelvin."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-05-magnetism-and-matter.t5",
   "name": {
    "en": "Ferromagnetic (Curie–Weiss)"
   },
   "tex": "\\chi = \\frac{C}{T - T_C}\\ \\ (T > T_C)",
   "note": {
    "en": "Above Curie temperature becomes paramagnetic."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-05-magnetism-and-matter.t5",
   "name": {
    "en": "Hysteresis"
   },
   "tex": "\\text{loss per unit volume per cycle} = \\oint H\\,dB",
   "note": {
    "en": "Permanent magnet: high retentivity and coercivity. Core / electromagnet: low coercivity, high permeability."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-05-magnetism-and-matter.t1",
   "name": {
    "en": "Earth's field components"
   },
   "tex": "B_H = B\\cos\\delta,\\quad B_V = B\\sin\\delta,\\quad \\tan\\delta = \\frac{B_V}{B_H}",
   "note": {
    "en": "Dip 90 degrees at magnetic poles, 0 at magnetic equator."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-05-magnetism-and-matter.t1",
   "name": {
    "en": "Apparent dip"
   },
   "tex": "\\tan\\delta' = \\frac{\\tan\\delta}{\\cos\\alpha},\\quad \\cot^2\\delta = \\cot^2\\delta_1 + \\cot^2\\delta_2",
   "note": {
    "en": "Second form: two perpendicular planes."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-05-magnetism-and-matter.t1",
   "name": {
    "en": "Neutral point (N-pole north)"
   },
   "tex": "\\frac{\\mu_0}{4\\pi}\\frac{m}{r^3} = B_H",
   "note": {
    "en": "Neutral points on equatorial line."
   }
  }
 ]
}
