  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Motive, motivation, motivator"
   },
   "body": {
    "en": "A motive is an inner state that energises behaviour towards a goal (hunger, need for recognition). Motivation is the process of stimulating people to act to achieve goals. A motivator is the technique used to motivate, such as pay, bonus, promotion or recognition. Motivation is an internal feeling, produces goal-directed behaviour, can be positive or negative, and is a complex process.",
    "kn": "ಉದ್ದೇಶ (ಮೋಟಿವ್) ಒಳಗಿನ ಸ್ಥಿತಿ; ಪ್ರೇರಣೆ ಗುರಿ ಸಾಧನೆಗೆ ಉತ್ತೇಜಿಸುವ ಪ್ರಕ್ರಿಯೆ; ಪ್ರೇರಕ ಎಂದರೆ ವೇತನ, ಬಡ್ತಿ, ಮನ್ನಣೆ ಮುಂತಾದ ತಂತ್ರ."
   },
   "points": [
    {
     "en": "Positive motivation: reward, promotion"
    },
    {
     "en": "Negative motivation: punishment, stopping increment"
    }
   ],
   "narration": {
    "en": "A motive is an inner state that energises behaviour towards a goal (hunger, need for recognition). Motivation is the process of stimulating people to act to achieve goals. A motivator is the technique used to motivate, such as pay, bonus, promotion or recognition. Motivation is an internal feeling, produces goal-directed behaviour, can be positive or negative, and is a complex process.",
    "kn": "ಉದ್ದೇಶ (ಮೋಟಿವ್) ಒಳಗಿನ ಸ್ಥಿತಿ; ಪ್ರೇರಣೆ ಗುರಿ ಸಾಧನೆಗೆ ಉತ್ತೇಜಿಸುವ ಪ್ರಕ್ರಿಯೆ; ಪ್ರೇರಕ ಎಂದರೆ ವೇತನ, ಬಡ್ತಿ, ಮನ್ನಣೆ ಮುಂತಾದ ತಂತ್ರ."
   }
  },
