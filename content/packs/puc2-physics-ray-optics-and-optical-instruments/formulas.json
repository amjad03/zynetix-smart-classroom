{
 "chapterId": "puc2-physics-09-ray-optics-and-optical-instruments",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "Mirror formula"
   },
   "tex": "\\frac1v + \\frac1u = \\frac1f,\\quad f = \\frac R2",
   "note": {
    "en": "Use sign convention consistently."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Lens formula"
   },
   "tex": "\\frac1v - \\frac1u = \\frac1f",
   "note": {
    "en": "Magnification m = v/u."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Lens maker's"
   },
   "tex": "\\frac1f = (\\mu - 1)\\left(\\frac{1}{R_1} - \\frac{1}{R_2}\\right)",
   "note": {
    "en": "In a medium use μ_rel."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t3",
   "name": {
    "en": "Snell's law"
   },
   "tex": "\\mu_1\\sin i = \\mu_2\\sin r",
   "note": {
    "en": "Critical angle sin C = 1/μ."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Power of lens"
   },
   "tex": "P = \\frac{1}{f(\\text{m})}",
   "note": {
    "en": "Combination: P = P₁ + P₂."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t5",
   "name": {
    "en": "Prism (minimum deviation)"
   },
   "tex": "\\mu = \\frac{\\sin\\frac{A + \\delta_m}{2}}{\\sin\\frac A2}",
   "note": {
    "en": "Thin prism: δ = (μ − 1)A."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t2",
   "name": {
    "en": "YDSE fringe width"
   },
   "tex": "\\beta = \\frac{\\lambda D}{d}",
   "note": {
    "en": "In medium: β/μ."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Single-slit minima"
   },
   "tex": "a\\sin\\theta = n\\lambda",
   "note": {
    "en": "Central max width = 2λD/a."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "NCERT sign convention"
   },
   "tex": "\\text{Distances from pole / optical centre; along incident light } (+),\\ \\text{against } (-);\\ \\text{heights up } (+)",
   "note": {
    "en": "Concave mirror f < 0, convex mirror f > 0; convex lens f > 0, concave lens f < 0. Real object: u < 0."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Mirror formula"
   },
   "tex": "\\dfrac1v + \\dfrac1u = \\dfrac1f,\\qquad f = \\dfrac R2"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "Mirror magnification"
   },
   "tex": "m = \\dfrac{h'}{h} = -\\dfrac vu",
   "note": {
    "en": "m < 0 real & inverted; m > 0 virtual & erect."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "Speed and length of image (mirror)"
   },
   "tex": "\\dfrac{dv}{dt} = -\\dfrac{v^2}{u^2}\\dfrac{du}{dt},\\qquad \\text{longitudinal } m_L = -m^2"
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "Plane mirrors"
   },
   "tex": "\\text{rotation } \\theta \\Rightarrow \\text{reflected ray turns } 2\\theta;\\quad N = \\dfrac{360^\\circ}{\\theta} - 1\\ (\\text{even ratio})",
   "note": {
    "en": "Minimum mirror height for a full image = half the person's height."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t2",
   "name": {
    "en": "Snell's law and refractive index"
   },
   "tex": "n_1\\sin i = n_2\\sin r,\\qquad n = \\dfrac cv,\\qquad \\lambda_{\\text{medium}} = \\dfrac{\\lambda_0}{n}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t2",
   "name": {
    "en": "Apparent depth / normal shift"
   },
   "tex": "d_{\\text{app}} = \\dfrac{d}{n},\\qquad \\text{shift} = t\\left(1 - \\dfrac1n\\right),\\qquad d_{\\text{app}} = \\sum\\dfrac{t_i}{n_i}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t3",
   "name": {
    "en": "Critical angle and TIR"
   },
   "tex": "\\sin C = \\dfrac{n_{\\text{rarer}}}{n_{\\text{denser}}},\\qquad r_{\\text{circle}} = \\dfrac{h}{\\sqrt{n^2 - 1}}",
   "note": {
    "en": "TIR: denser → rarer and i > C. Diamond C ≈ 24°."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t3",
   "name": {
    "en": "Optical fibre"
   },
   "tex": "n_0\\sin\\theta_a = \\sqrt{n_1^2 - n_2^2}\\ (\\text{numerical aperture})",
   "note": {
    "en": "Core index n₁ > cladding index n₂."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Refraction at a spherical surface"
   },
   "tex": "\\dfrac{n_2}{v} - \\dfrac{n_1}{u} = \\dfrac{n_2 - n_1}{R}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Lens maker's formula"
   },
   "tex": "\\dfrac1f = \\left(\\dfrac{n_{\\text{lens}}}{n_{\\text{medium}}} - 1\\right)\\left(\\dfrac1{R_1} - \\dfrac1{R_2}\\right)"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Thin lens formula"
   },
   "tex": "\\dfrac1v - \\dfrac1u = \\dfrac1f,\\qquad m = \\dfrac vu"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Power and combinations"
   },
   "tex": "P = \\dfrac1{f\\,(\\text{m})}\\ \\text{D},\\qquad P = P_1 + P_2\\ (\\text{contact}),\\qquad \\dfrac1F = \\dfrac1{f_1} + \\dfrac1{f_2} - \\dfrac{d}{f_1f_2}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Displacement method"
   },
   "tex": "f = \\dfrac{D^2 - d^2}{4D},\\qquad D \\ge 4f\\ \\text{for a real image}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "Silvered lens"
   },
   "tex": "P_{\\text{eq}} = 2P_{\\text{lens}} + P_{\\text{mirror}}",
   "note": {
    "en": "Plano-convex, plane face silvered: F = R/[2(n−1)]; curved face silvered: F = R/(2n)."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t4",
   "name": {
    "en": "Cut lenses"
   },
   "tex": "\\text{cut along axis: } f;\\quad \\text{cut perpendicular to axis: } 2f"
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t5",
   "name": {
    "en": "Prism"
   },
   "tex": "A = r_1 + r_2,\\qquad \\delta = i + e - A,\\qquad n = \\dfrac{\\sin\\frac{A + \\delta_m}{2}}{\\sin\\frac A2}",
   "note": {
    "en": "At minimum deviation i = e and r₁ = r₂ = A/2."
   }
  },
  {
   "id": "zs-f26",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t5",
   "name": {
    "en": "Thin prism and dispersion"
   },
   "tex": "\\delta = (n - 1)A,\\qquad \\omega = \\dfrac{n_v - n_r}{n_y - 1}"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Achromatic doublet"
   },
   "tex": "\\dfrac{\\omega_1}{f_1} + \\dfrac{\\omega_2}{f_2} = 0"
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t6",
   "name": {
    "en": "Scattering"
   },
   "tex": "I_{\\text{scattered}} \\propto \\dfrac1{\\lambda^4}",
   "note": {
    "en": "Blue sky, red sunset; large drops scatter all colours (white clouds)."
   }
  },
  {
   "id": "zs-f29",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t6",
   "name": {
    "en": "Simple microscope"
   },
   "tex": "m = 1 + \\dfrac Df\\ (\\text{image at } D),\\qquad m = \\dfrac Df\\ (\\text{image at } \\infty)"
  },
  {
   "id": "zs-f30",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t6",
   "name": {
    "en": "Compound microscope"
   },
   "tex": "m = m_om_e,\\quad m_o = \\dfrac{v_o}{u_o},\\quad m_e = \\dfrac{D}{f_e}\\ (\\infty)\\ \\text{or}\\ 1 + \\dfrac{D}{f_e}\\ (D);\\quad m \\approx \\dfrac{L}{f_o}\\dfrac{D}{f_e}"
  },
  {
   "id": "zs-f31",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t6",
   "name": {
    "en": "Astronomical telescope"
   },
   "tex": "m = \\dfrac{f_o}{f_e},\\ L = f_o + f_e\\ (\\text{normal});\\qquad m = \\dfrac{f_o}{f_e}\\left(1 + \\dfrac{f_e}{D}\\right)\\ (\\text{image at } D)"
  },
  {
   "id": "zs-f32",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t1",
   "name": {
    "en": "Image of a distant object"
   },
   "tex": "h' = f\\alpha\\ (\\alpha \\text{ in rad})"
  },
  {
   "id": "zs-f33",
   "topicId": "puc2-physics-09-ray-optics-and-optical-instruments.t6",
   "name": {
    "en": "Eye defects"
   },
   "tex": "\\text{Myopia: concave},\\ f = -(\\text{far point});\\quad \\text{Hypermetropia: convex};\\quad \\text{Astigmatism: cylindrical};\\quad \\text{Presbyopia: bifocal}"
  }
 ]
}
