{
 "chapterId": "puc1-biology-12-respiration-in-plants",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Aerobic respiration"
   },
   "tex": "\\text{C}_6\\text{H}_{12}\\text{O}_6 + 6\\text{O}_2 \\to 6\\text{CO}_2 + 6\\text{H}_2\\text{O} + \\text{energy}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-12-respiration-in-plants.t1",
   "name": {
    "en": "Glycolysis (EMP)"
   },
   "tex": "\\text{glucose} \\to 2\\ \\text{pyruvate};\\ \\text{cytoplasm}",
   "note": {
    "en": "Embden, Meyerhof, Parnas. ATP used: glucose→G6P (hexokinase), F6P→F1,6BP. ATP made: BPGA→PGA, PEP→pyruvate. NADH: PGAL→BPGA."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-12-respiration-in-plants.t4",
   "name": {
    "en": "Glycolysis yield"
   },
   "tex": "4\\ \\text{ATP} - 2\\ \\text{ATP} = 2\\ \\text{ATP (net)} + 2\\ \\text{NADH}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-12-respiration-in-plants.t2",
   "name": {
    "en": "Alcoholic fermentation"
   },
   "tex": "\\text{pyruvate} \\xrightarrow{\\text{decarboxylase}} \\text{acetaldehyde} + \\text{CO}_2 \\xrightarrow{\\text{ADH}} \\text{ethanol}",
   "note": {
    "en": "Yeast dies at ≈ 13% alcohol. < 7% of glucose energy released."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-12-respiration-in-plants.t2",
   "name": {
    "en": "Lactic fermentation"
   },
   "tex": "\\text{pyruvate} + \\text{NADH} \\xrightarrow{\\text{LDH}} \\text{lactate} + \\text{NAD}^+"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-12-respiration-in-plants.t3",
   "name": {
    "en": "Link reaction"
   },
   "tex": "\\text{pyruvate} + \\text{CoA} + \\text{NAD}^+ \\xrightarrow{\\text{PDH, Mg}^{2+}} \\text{acetyl CoA} + \\text{CO}_2 + \\text{NADH}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-12-respiration-in-plants.t3",
   "name": {
    "en": "TCA cycle (per turn)"
   },
   "tex": "3\\ \\text{NADH} + 1\\ \\text{FADH}_2 + 1\\ \\text{GTP} + 2\\ \\text{CO}_2",
   "note": {
    "en": "Citrate synthase: acetyl CoA + OAA → citrate. GTP at succinyl CoA → succinate. OAA must be replenished."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-12-respiration-in-plants.t3",
   "name": {
    "en": "Per pyruvate (matrix)"
   },
   "tex": "\\text{pyruvate} + 4\\text{NAD}^+ + \\text{FAD} + 2\\text{H}_2\\text{O} + \\text{ADP} + \\text{P}_i \\to 3\\text{CO}_2 + 4\\text{NADH} + 4\\text{H}^+ + \\text{FADH}_2 + \\text{ATP}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-12-respiration-in-plants.t4",
   "name": {
    "en": "ETS complexes"
   },
   "tex": "\\text{I: NADH DH};\\ \\text{II: succinate DH};\\ \\text{III: cyt } bc_1;\\ \\text{IV: cyt } c\\ \\text{oxidase};\\ \\text{V: ATP synthase}",
   "note": {
    "en": "Ubiquinone: mobile carrier in membrane. Cyt c: small protein, outer surface of inner membrane, between III and IV. IV has cyt a, a₃ and 2 Cu centres."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-12-respiration-in-plants.t4",
   "name": {
    "en": "P/O yields"
   },
   "tex": "\\text{NADH} \\to 3\\ \\text{ATP};\\ \\text{FADH}_2 \\to 2\\ \\text{ATP}",
   "note": {
    "en": "O₂ is final H acceptor (oxidative phosphorylation)."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-12-respiration-in-plants.t4",
   "name": {
    "en": "ATP synthase"
   },
   "tex": "F_0\\ (\\text{integral, H}^+\\ \\text{channel}) + F_1\\ (\\text{head, ATP synthesis})",
   "note": {
    "en": "2 H⁺ pass through F₀ per ATP."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-12-respiration-in-plants.t5",
   "name": {
    "en": "Balance sheet"
   },
   "tex": "10\\ \\text{NADH} \\times 3 + 2\\ \\text{FADH}_2 \\times 2 + 4\\ \\text{ATP} = 38\\ \\text{ATP}",
   "note": {
    "en": "Assumes sequential pathway, glycolytic NADH enters mitochondria, no diversion, only glucose respired."
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "CO₂ per glucose"
   },
   "tex": "2\\ (\\text{link}) + 4\\ (\\text{TCA}) = 6"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-12-respiration-in-plants.t5",
   "name": {
    "en": "Amphibolic pathway"
   },
   "tex": "\\text{glycerol} \\to \\text{PGAL};\\ \\text{fatty acids} \\to \\text{acetyl CoA};\\ \\text{amino acids} \\to \\text{pyruvate / acetyl CoA / TCA}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-12-respiration-in-plants.t5",
   "name": {
    "en": "Respiratory quotient"
   },
   "tex": "\\text{RQ} = \\dfrac{\\text{volume of CO}_2\\ \\text{evolved}}{\\text{volume of O}_2\\ \\text{consumed}}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-12-respiration-in-plants.t5",
   "name": {
    "en": "RQ values"
   },
   "tex": "\\text{carbohydrate} = 1;\\ \\text{fat} \\approx 0.7;\\ \\text{protein} \\approx 0.9;\\ \\text{organic acids} > 1;\\ \\text{anaerobic} = \\infty",
   "note": {
    "en": "Tripalmitin: 102 CO₂ / 145 O₂ = 0.7. Malic acid 4/3; oxalic acid 4."
   }
  }
 ]
}
