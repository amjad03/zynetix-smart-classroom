{
 "chapterId": "puc2-physics-07-alternating-current",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-07-alternating-current.t1",
   "name": {
    "en": "rms and peak"
   },
   "tex": "I_{rms} = \\frac{I_0}{\\sqrt2},\\quad V_{rms} = \\frac{V_0}{\\sqrt2}",
   "note": {
    "en": "General: rms = sqrt of the mean of i^2."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-07-alternating-current.t1",
   "name": {
    "en": "Half-cycle average"
   },
   "tex": "\\bar I_{1/2} = \\frac{2I_0}{\\pi}\\approx0.637I_0",
   "note": {
    "en": "Full-cycle average of a sinusoid is zero."
   }
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Reactances"
   },
   "tex": "X_L = \\omega L,\\quad X_C = \\frac{1}{\\omega C}"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Phase relations"
   },
   "tex": "R:\\ \\phi = 0;\\quad L:\\ i\\ \\text{lags}\\ v\\ \\text{by}\\ \\tfrac\\pi2;\\quad C:\\ i\\ \\text{leads}\\ v\\ \\text{by}\\ \\tfrac\\pi2"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-07-alternating-current.t3",
   "name": {
    "en": "Series LCR impedance"
   },
   "tex": "Z = \\sqrt{R^2 + (X_L - X_C)^2},\\quad V = \\sqrt{V_R^2 + (V_L - V_C)^2}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-07-alternating-current.t3",
   "name": {
    "en": "Phase angle"
   },
   "tex": "\\tan\\phi = \\frac{X_L - X_C}{R}",
   "note": {
    "en": "Positive: inductive (lags); negative: capacitive (leads)."
   }
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Resonance"
   },
   "tex": "\\omega_0 = \\frac{1}{\\sqrt{LC}},\\quad Z_{min} = R,\\quad I_{max} = \\frac{V}{R}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-07-alternating-current.t3",
   "name": {
    "en": "Quality factor"
   },
   "tex": "Q = \\frac{\\omega_0 L}{R} = \\frac1R\\sqrt{\\frac LC} = \\frac{\\omega_0}{\\Delta\\omega}",
   "note": {
    "en": "At resonance V_L = V_C = QV."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-07-alternating-current.t1",
   "name": {
    "en": "Bandwidth and half-power points"
   },
   "tex": "\\Delta\\omega = \\frac RL,\\quad \\omega_{1,2}\\approx\\omega_0\\mp\\frac{R}{2L}"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Average power"
   },
   "tex": "P = V_{rms}I_{rms}\\cos\\phi = I_{rms}^2R = \\tfrac12V_0I_0\\cos\\phi"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-07-alternating-current.t4",
   "name": {
    "en": "Power factor"
   },
   "tex": "\\cos\\phi = \\frac RZ",
   "note": {
    "en": "Pure L or C: 0 (wattless). Wattless current: I sin phi."
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Max power by varying R"
   },
   "tex": "R = |X_L - X_C|,\\quad P_{max} = \\frac{V^2}{2|X_L - X_C|}"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "LC oscillations"
   },
   "tex": "q = Q_0\\cos\\omega t,\\quad \\omega = \\frac{1}{\\sqrt{LC}},\\quad I_0 = \\omega Q_0",
   "note": {
    "en": "Energies oscillate at 2 omega; total Q0^2/2C constant."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "LC – mechanical analogy"
   },
   "tex": "L\\leftrightarrow m,\\quad C\\leftrightarrow\\frac1k,\\quad q\\leftrightarrow x,\\quad i\\leftrightarrow v"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-07-alternating-current.t4",
   "name": {
    "en": "Parallel LC (ideal) at resonance"
   },
   "tex": "Z\\to\\infty,\\quad I_{source}\\to0",
   "note": {
    "en": "Rejector circuit."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc2-physics-07-alternating-current.t5",
   "name": {
    "en": "Transformer"
   },
   "tex": "\\frac{V_s}{V_p} = \\frac{N_s}{N_p} = \\frac{I_p}{I_s}\\ (\\text{ideal}),\\quad \\eta = \\frac{P_{out}}{P_{in}}",
   "note": {
    "en": "Losses: copper, eddy, hysteresis, flux leakage. No action on steady DC."
   }
  }
 ]
}
