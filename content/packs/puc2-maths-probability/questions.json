 {
  "id": "2m13-q10",
  "chapterId": "puc2-maths-13-probability",
  "topicId": "puc2-maths-13-probability.t2",
  "stem": {
   "en": "If A and B are mutually exclusive events with P(A) > 0 and P(B) > 0, then A and B are:"
  },
  "options": [
   {
    "en": "always independent"
   },
   {
    "en": "independent only if P(A) = P(B)"
   },
   {
    "en": "never independent"
   },
   {
    "en": "complementary events"
   }
  ],
  "answer": 2,
  "explanation": {
   "en": "Mutually exclusive gives P(A ∩ B) = 0, but P(A)P(B) > 0, so P(A ∩ B) ≠ P(A)P(B). They cannot be independent. They need not be complementary."
  },
  "exams": [
   "PUC",
   "CBSE",
   "KCET",
   "COMEDK",
   "JEE"
  ],
  "difficulty": "hard",
  "tags": []
 },
