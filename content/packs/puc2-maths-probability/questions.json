[
 {
  "id": "2m13-q01",
  "chapterId": "puc2-maths-13-probability",
  "topicId": "puc2-maths-13-probability.t1",
  "stem": {
   "en": "If P(E) = 0.6, P(F) = 0.3 and P(E ∩ F) = 0.2, then P(E|F) is:"
  },
  "options": [
   {
    "en": "1/3"
   },
   {
    "en": "2/3"
   },
   {
    "en": "1/2"
   },
   {
    "en": "1/6"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "P(E|F) = P(E ∩ F)/P(F) = 0.2/0.3 = 2/3."
  },
