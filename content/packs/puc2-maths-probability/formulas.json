{
 "chapterId": "puc2-maths-13-probability",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-maths-13-probability.t2",
   "name": {
    "en": "Addition rule"
   },
   "tex": "P(A\\cup B) = P(A) + P(B) - P(A\\cap B)",
   "note": {
    "en": "Mutually exclusive: last term 0."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Conditional probability"
   },
   "tex": "P(A\\mid B) = \\frac{P(A\\cap B)}{P(B)}",
   "note": {
    "en": "P(B) > 0."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-maths-13-probability.t2",
   "name": {
    "en": "Independence"
   },
   "tex": "P(A\\cap B) = P(A)\\,P(B)",
   "note": {
    "en": "Not the same as mutually exclusive."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-maths-13-probability.t3",
   "name": {
    "en": "Total probability"
   },
   "tex": "P(A) = \\sum_i P(E_i)P(A\\mid E_i)",
   "note": {
    "en": "E_i partition the sample space."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-maths-13-probability.t3",
   "name": {
    "en": "Bayes' theorem"
   },
   "tex": "P(E_i\\mid A) = \\frac{P(E_i)P(A\\mid E_i)}{\\sum_j P(E_j)P(A\\mid E_j)}",
   "note": {
    "en": "Reverse conditioning."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Binomial distribution"
   },
   "tex": "P(X = r) = \\binom nr p^rq^{n-r}",
   "note": {
    "en": "q = 1 − p."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Binomial mean & variance"
   },
   "tex": "\\mu = np,\\quad \\sigma^2 = npq",
   "note": {
    "en": "Variance < mean always."
   }
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "At least one"
   },
   "tex": "P = 1 - q^n",
   "note": {
    "en": "Complement trick."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Conditional probability"
   },
   "tex": "P(A\\mid B) = \\dfrac{P(A\\cap B)}{P(B)},\\quad P(B)\\ne0"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-maths-13-probability.t1",
   "name": {
    "en": "Properties of conditional probability"
   },
   "tex": "P(S\\mid B) = P(B\\mid B) = 1,\\quad P(A'\\mid B) = 1 - P(A\\mid B)",
   "note": {
    "en": "$P(A\\mid B) + P(A\\mid B')$ need not be 1"
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-maths-13-probability.t2",
   "name": {
    "en": "Multiplication rule"
   },
   "tex": "P(A\\cap B) = P(A)P(B\\mid A) = P(B)P(A\\mid B)",
   "note": {
    "en": "$P(A\\cap B\\cap C) = P(A)P(B\\mid A)P(C\\mid A\\cap B)$"
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-maths-13-probability.t2",
   "name": {
    "en": "Independent events"
   },
   "tex": "P(A\\cap B) = P(A)P(B) \\iff P(A\\mid B) = P(A)",
   "note": {
    "en": "then A and B′, A′ and B, A′ and B′ are also independent"
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-maths-13-probability.t3",
   "name": {
    "en": "Mutual independence of three events"
   },
   "tex": "\\text{pairwise products} \\text{ and } P(A\\cap B\\cap C) = P(A)P(B)P(C)",
   "note": {
    "en": "pairwise independence alone is not enough"
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-maths-13-probability.t2",
   "name": {
    "en": "Exclusive vs independent"
   },
   "tex": "P(A), P(B) > 0 \\text{ and } A\\cap B = \\varnothing \\Rightarrow A, B \\text{ are not independent}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-maths-13-probability.t2",
   "name": {
    "en": "At least one of independent events"
   },
   "tex": "P(\\text{at least one}) = 1 - \\prod(1 - p_i)"
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Exactly one of two events"
   },
   "tex": "P(A) + P(B) - 2P(A\\cap B)"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-maths-13-probability.t3",
   "name": {
    "en": "Theorem of total probability"
   },
   "tex": "P(A) = \\sum_{i} P(E_i)P(A\\mid E_i)",
   "note": {
    "en": "E₁, …, Eₙ a partition of the sample space"
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-maths-13-probability.t3",
   "name": {
    "en": "Bayes' theorem"
   },
   "tex": "P(E_i\\mid A) = \\dfrac{P(E_i)P(A\\mid E_i)}{\\sum_j P(E_j)P(A\\mid E_j)}"
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Probability distribution"
   },
   "tex": "p_i\\ge0,\\qquad \\sum p_i = 1"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Mean (expectation)"
   },
   "tex": "\\mu = E(X) = \\sum x_ip_i"
  },
  {
   "id": "zs-f21",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Variance and SD"
   },
   "tex": "\\operatorname{Var}(X) = E(X^2) - [E(X)]^2 = \\sum x_i^2p_i - \\mu^2,\\qquad \\sigma = \\sqrt{\\operatorname{Var}(X)}"
  },
  {
   "id": "zs-f22",
   "name": {
    "en": "Linear change"
   },
   "tex": "E(aX + b) = aE(X) + b,\\qquad \\operatorname{Var}(aX + b) = a^2\\operatorname{Var}(X)"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Binomial distribution"
   },
   "tex": "P(X = r) = \\binom{n}{r}p^rq^{n - r},\\quad q = 1 - p,\\ r = 0, 1, \\ldots, n"
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Binomial mean and variance"
   },
   "tex": "E(X) = np,\\qquad \\operatorname{Var}(X) = npq,\\qquad \\operatorname{Var} < \\text{mean}"
  },
  {
   "id": "zs-f25",
   "name": {
    "en": "Binomial mode"
   },
   "tex": "\\text{mode} = \\lfloor(n + 1)p\\rfloor",
   "note": {
    "en": "if (n + 1)p is an integer, both (n + 1)p and (n + 1)p − 1 are modes"
   }
  },
  {
   "id": "zs-f26",
   "name": {
    "en": "First success on trial k"
   },
   "tex": "P(X = k) = q^{k - 1}p,\\qquad E(X) = \\dfrac1p"
  },
  {
   "id": "zs-f27",
   "name": {
    "en": "Alternate throwing (first player wins)"
   },
   "tex": "P(\\text{first wins}) = \\dfrac{p}{1 - q^2}",
   "note": {
    "en": "for three players in turn: p/(1 − q³), qp/(1 − q³), q²p/(1 − q³)"
   }
  },
  {
   "id": "zs-f28",
   "topicId": "puc2-maths-13-probability.t4",
   "name": {
    "en": "Sum of two dice"
   },
   "tex": "E = 7,\\qquad \\operatorname{Var} = \\dfrac{35}{6}",
   "note": {
    "en": "one die: mean 7/2, variance 35/12"
   }
  }
 ]
}
