    "en": "200 pF"
   },
   {
    "en": "100 pF"
   },
   {
    "en": "400 pF"
   },
   {
    "en": "50 pF"
   }
  ],
  "answer": 1,
  "explanation": {
   "en": "CT = C1C2/(C1 + C2) = 200 × 200/400 = 100 pF."
  },
  "exams": [
   "PUC"
  ],
  "difficulty": "easy",
  "format": "mcq",
  "tags": []
 },
 {
