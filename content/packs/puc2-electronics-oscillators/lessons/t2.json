 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Radio frequencies from coils and capacitors",
    "kn": "ಸುರುಳಿ ಮತ್ತು ಧಾರಕಗಳಿಂದ ರೇಡಿಯೋ ಆವೃತ್ತಿ"
   },
   "hook": {
    "en": "The local oscillator inside every radio receiver is an LC oscillator. Split the coil and you have a Hartley oscillator; split the capacitor and you have a Colpitts.",
    "kn": "ಪ್ರತಿ ರೇಡಿಯೋ ಗ್ರಾಹಕದೊಳಗಿನ ಸ್ಥಳೀಯ ಆಂದೋಲಕ LC ಆಂದೋಲಕ. ಸುರುಳಿಯನ್ನು ವಿಭಜಿಸಿದರೆ ಹಾರ್ಟ್ಲೆ, ಧಾರಕವನ್ನು ವಿಭಜಿಸಿದರೆ ಕಾಲ್ಪಿಟ್ಸ್ ಆಂದೋಲಕ."
   },
   "objectives": [
    {
     "en": "Draw the tank circuits of Hartley and Colpitts oscillators"
    },
    {
     "en": "Calculate their frequencies"
    },
    {
     "en": "Compare the two"
    }
   ],
   "narration": {
    "en": "The local oscillator inside every radio receiver is an LC oscillator. Split the coil and you have a Hartley oscillator; split the capacitor and you have a Colpitts.",
    "kn": "ಪ್ರತಿ ರೇಡಿಯೋ ಗ್ರಾಹಕದೊಳಗಿನ ಸ್ಥಳೀಯ ಆಂದೋಲಕ LC ಆಂದೋಲಕ. ಸುರುಳಿಯನ್ನು ವಿಭಜಿಸಿದರೆ ಹಾರ್ಟ್ಲೆ, ಧಾರಕವನ್ನು ವಿಭಜಿಸಿದರೆ ಕಾಲ್ಪಿಟ್ಸ್ ಆಂದೋಲಕ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Hartley oscillator"
   },
   "body": {
    "en": "In a Hartley oscillator the tank has a tapped coil ($L_1$ and $L_2$) with a capacitor C across the whole coil. The tap is at AC ground, so the two ends of the coil are 180° apart; the voltage across $L_2$ is fed back to the amplifier input while the amplifier itself gives 180°. The frequency is $f = 1/(2\\pi\\sqrt{L_T C})$ with $L_T = L_1 + L_2 + 2M$, where M is the mutual inductance between the two parts."
   },
   "points": [
    {
     "en": "Tapped (split) inductor, one capacitor"
    },
    {
     "en": "LT = L1 + L2 + 2M"
    },
    {
     "en": "Easily tuned with a variable capacitor"
    }
   ],
   "narration": {
    "en": "The Hartley oscillator uses a tapped coil. Its frequency uses the total inductance L1 plus L2 plus twice the mutual inductance.",
    "kn": "ಹಾರ್ಟ್ಲೆ ಆಂದೋಲಕದಲ್ಲಿ ಟ್ಯಾಪ್ ಮಾಡಿದ ಸುರುಳಿ ಇದೆ. ಆವೃತ್ತಿಗೆ ಒಟ್ಟು ಪ್ರೇರಕತೆ L1 + L2 + 2M ಬಳಸುತ್ತೇವೆ."
   },
   "formula": "f = \\frac{1}{2\\pi\\sqrt{(L_1 + L_2 + 2M)\\,C}}"
  },
