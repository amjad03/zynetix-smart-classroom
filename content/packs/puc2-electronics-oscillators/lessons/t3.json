 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "No coils for audio",
    "kn": "ಶ್ರವ್ಯ ಆವೃತ್ತಿಗೆ ಸುರುಳಿ ಬೇಡ"
   },
   "hook": {
    "en": "At audio frequencies an LC tank would need huge, heavy coils. Instead we can use only resistors and capacitors to produce the 180° phase shift.",
    "kn": "ಶ್ರವ್ಯ ಆವೃತ್ತಿಗಳಲ್ಲಿ LC ಟ್ಯಾಂಕ್‌ಗೆ ದೊಡ್ಡ ಭಾರೀ ಸುರುಳಿಗಳು ಬೇಕು. ಬದಲಿಗೆ ರೋಧಕ ಮತ್ತು ಧಾರಕಗಳಿಂದಲೇ 180° ಹಂತ ಸ್ಥಾನಾಂತರ ಪಡೆಯಬಹುದು."
   },
   "objectives": [
    {
     "en": "Explain how three RC sections give 180°"
    },
    {
     "en": "Use f = 1/(2πRC√6)"
    },
    {
     "en": "State the minimum gain and the merits and demerits"
    }
   ],
   "narration": {
    "en": "At audio frequencies an LC tank would need huge, heavy coils. Instead we can use only resistors and capacitors to produce the 180° phase shift.",
    "kn": "ಶ್ರವ್ಯ ಆವೃತ್ತಿಗಳಲ್ಲಿ LC ಟ್ಯಾಂಕ್‌ಗೆ ದೊಡ್ಡ ಭಾರೀ ಸುರುಳಿಗಳು ಬೇಕು. ಬದಲಿಗೆ ರೋಧಕ ಮತ್ತು ಧಾರಕಗಳಿಂದಲೇ 180° ಹಂತ ಸ್ಥಾನಾಂತರ ಪಡೆಯಬಹುದು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Working of the RC phase-shift oscillator"
   },
   "body": {
    "en": "The amplifier (a CE stage or an inverting op-amp) gives 180°. Its output is fed back through three identical RC sections. A single RC section cannot shift the phase by 90° at a finite frequency, so three are used; at the oscillation frequency each gives 60°, total 180°. The loop phase is then 360°. For three equal sections $f = 1/(2\\pi RC\\sqrt6)$, and at that frequency the network attenuates the signal to $\\beta = 1/29$, so the amplifier gain must be at least 29."
   },
   "points": [
    {
     "en": "Amplifier: 180°; 3 RC sections: 3 × 60° = 180°"
    },
    {
     "en": "f = 1/(2πRC√6)"
    },
    {
     "en": "β = 1/29 ⇒ A ≥ 29"
    }
   ],
   "narration": {
    "en": "Three RC sections each shift the phase by sixty degrees. The frequency is one over two pi R C root six, and the gain must be at least twenty-nine.",
    "kn": "ಮೂರು RC ವಿಭಾಗಗಳು ತಲಾ 60° ಹಂತ ಸ್ಥಾನಾಂತರ ನೀಡುತ್ತವೆ. ಆವೃತ್ತಿ f = 1/(2πRC√6); ವರ್ಧಕದ ವರ್ಧನೆ ಕನಿಷ್ಠ 29 ಇರಬೇಕು."
   },
   "formula": "f = \\frac{1}{2\\pi R C\\sqrt{6}}, \\qquad A \\ge 29"
  },
