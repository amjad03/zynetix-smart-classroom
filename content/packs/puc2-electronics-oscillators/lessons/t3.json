  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "An RC phase-shift oscillator uses R = 10 kΩ and C = 0.01 µF in each section. Find its frequency."
   },
   "steps": [
    {
     "en": "RC = 10⁴ × 10⁻⁸ = 10⁻⁴ s."
    },
    {
     "en": "2πRC√6 = 2π × 10⁻⁴ × 2.449 = 1.539e-03 s."
    },
    {
     "en": "f = 649.7 Hz."
    }
   ],
   "answer": {
    "en": "About 650 Hz"
   },
   "narration": {
    "en": "Let us work this out together. An RC phase-shift oscillator uses R = 10 kΩ and C = 0.01 µF in each section. Find its frequency."
   }
  },
  {
   "id": "ex2",
   "type": "example",
   "problem": {
    "en": "Design an RC phase-shift oscillator for 1 kHz using C = 10 nF."
   },
   "steps": [
    {
     "en": "R = 1/(2πf C√6)."
    },
    {
     "en": "R = 1/(2π × 1000 × 10⁻⁸ × 2.449) = 6497 Ω."
    },
    {
     "en": "Use R ≈ 6.5 kΩ (nearest standard 6.8 kΩ gives about 955 Hz), with an amplifier gain of at least 29."
    }
