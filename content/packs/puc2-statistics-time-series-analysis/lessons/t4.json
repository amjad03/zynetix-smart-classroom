   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Fit a straight-line trend by least squares to production (thousand tonnes) 50, 55, 57, 60, 63, 67, 68 for 2018–2024. Find the trend values and estimate production for 2026."
   },
   "steps": [
    {
     "en": "Origin 2021, unit 1 year: X = −3, −2, −1, 0, 1, 2, 3."
    },
    {
     "en": "Σy = 420, ΣXy = 84, ΣX² = 28."
    },
    {
     "en": "a = 420/7 = 60; b = 84/28 = 3. Trend: y = 60 + 3X."
    },
    {
     "en": "Trend values: 51, 54, 57, 60, 63, 66, 69."
    },
    {
     "en": "2026: X = 5, y = 60 + 15 = 75 thousand tonnes."
    }
   ],
   "answer": {
    "en": "y = 60 + 3X; 2026 estimate 75 thousand tonnes"
   },
   "narration": {
    "en": "Let us work this out together. Fit a straight-line trend by least squares to production (thousand tonnes) 50, 55, 57, 60, 63, 67, 68 for 2018–2024. Find the trend values and estimate production for 2026."
   }
