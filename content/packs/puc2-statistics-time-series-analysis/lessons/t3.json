 "title": {
  "en": "Measurement of trend by moving averages",
  "kn": "ಚಲಿತ ಸರಾಸರಿಗಳಿಂದ ಪ್ರವೃತ್ತಿ ಮಾಪನ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Smoothing out the bumps",
    "kn": "ಏರಿಳಿತಗಳನ್ನು ನಯಗೊಳಿಸುವುದು"
   },
   "hook": {
    "en": "Cricket commentators quote a batter's average over the last few matches, not just the last score. A moving average does the same for a time series.",
    "kn": "ಕ್ರಿಕೆಟ್ ವೀಕ್ಷಕವಿವರಣೆಗಾರರು ಕೊನೆಯ ಸ್ಕೋರ್ ಮಾತ್ರವಲ್ಲ, ಕೊನೆಯ ಕೆಲವು ಪಂದ್ಯಗಳ ಸರಾಸರಿ ಹೇಳುತ್ತಾರೆ. ಚಲಿತ ಸರಾಸರಿ ಕಾಲ ಶ್ರೇಣಿಗೆ ಅದನ್ನೇ ಮಾಡುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Compute 3-yearly and 5-yearly moving averages"
    },
    {
     "en": "Compute 4-yearly centred moving averages"
    },
    {
     "en": "State merits and demerits of the method"
    }
   ],
   "narration": {
    "en": "Cricket commentators quote a batter's average over the last few matches, not just the last score. A moving average does the same for a time series.",
    "kn": "ಕ್ರಿಕೆಟ್ ವೀಕ್ಷಕವಿವರಣೆಗಾರರು ಕೊನೆಯ ಸ್ಕೋರ್ ಮಾತ್ರವಲ್ಲ, ಕೊನೆಯ ಕೆಲವು ಪಂದ್ಯಗಳ ಸರಾಸರಿ ಹೇಳುತ್ತಾರೆ. ಚಲಿತ ಸರಾಸರಿ ಕಾಲ ಶ್ರೇಣಿಗೆ ಅದನ್ನೇ ಮಾಡುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Moving averages"
   },
   "body": {
    "en": "An m-yearly moving average is the sequence of averages of m successive values, each placed against the middle of its period. For odd m (3, 5) the average falls against a year. For even m (4) it falls between two years, so we centre it by averaging two successive moving averages. Choosing m equal to the period of the cycle removes the cyclical (or seasonal) fluctuation and leaves the trend."
   },
   "points": [
    {
     "en": "Odd period: centred automatically"
    },
    {
     "en": "Even period: centre by 2-item averages"
    },
    {
     "en": "Merit: flexible, removes periodic swings"
    },
    {
     "en": "Demerit: loses values at both ends; no equation"
    }
   ],
   "narration": {
    "en": "A moving average replaces each value by the average of m neighbouring values. With an even period we centre the averages. The period should match the length of the cycle.",
    "kn": "ಚಲಿತ ಸರಾಸರಿಯು ಪ್ರತಿ ಮೌಲ್ಯವನ್ನು m ನೆರೆಯ ಮೌಲ್ಯಗಳ ಸರಾಸರಿಯಿಂದ ಬದಲಿಸುತ್ತದೆ. ಸಮ ಅವಧಿಯಾದರೆ ಕೇಂದ್ರೀಕರಿಸಬೇಕು. ಅವಧಿ ಚಕ್ರದ ಉದ್ದಕ್ಕೆ ಸಮವಿರಬೇಕು."
   },
   "formula": "\\text{3-yr MA at } t = \\frac{y_{t-1} + y_t + y_{t+1}}{3}"
  },
