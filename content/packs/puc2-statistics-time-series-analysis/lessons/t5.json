 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "When the trend bends",
    "kn": "ಪ್ರವೃತ್ತಿ ಬಾಗಿದಾಗ"
   },
   "hook": {
    "en": "Mobile data use in India did not grow by the same amount each year: it grew faster and faster. A straight line cannot follow it; a parabola can.",
    "kn": "ಭಾರತದಲ್ಲಿ ಮೊಬೈಲ್ ಡೇಟಾ ಬಳಕೆ ಪ್ರತಿ ವರ್ಷ ಸಮಾನವಾಗಿ ಬೆಳೆಯಲಿಲ್ಲ; ಹೆಚ್ಚು ಹೆಚ್ಚು ವೇಗವಾಗಿ ಬೆಳೆಯಿತು. ಸರಳರೇಖೆ ಅದನ್ನು ಹಿಂಬಾಲಿಸಲಾರದು; ಪರವಲಯ ಹಿಂಬಾಲಿಸಬಲ್ಲದು."
   },
   "objectives": [
    {
     "en": "Write the normal equations of a parabolic trend"
    },
    {
     "en": "Fit y = a + bX + cX² by least squares"
    },
    {
     "en": "Recognise when an exponential trend is suitable"
    }
   ],
   "narration": {
    "en": "Mobile data use in India did not grow by the same amount each year: it grew faster and faster. A straight line cannot follow it; a parabola can.",
    "kn": "ಭಾರತದಲ್ಲಿ ಮೊಬೈಲ್ ಡೇಟಾ ಬಳಕೆ ಪ್ರತಿ ವರ್ಷ ಸಮಾನವಾಗಿ ಬೆಳೆಯಲಿಲ್ಲ; ಹೆಚ್ಚು ಹೆಚ್ಚು ವೇಗವಾಗಿ ಬೆಳೆಯಿತು. ಸರಳರೇಖೆ ಅದನ್ನು ಹಿಂಬಾಲಿಸಲಾರದು; ಪರವಲಯ ಹಿಂಬಾಲಿಸಬಲ್ಲದು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Parabolic (second-degree) trend"
   },
   "body": {
    "en": "For $y = a + bX + cX^2$, least squares gives three normal equations. With the origin at the middle year, $\\sum X = \\sum X^3 = 0$, and they reduce to $\\sum y = na + c\\sum X^2$, $\\sum Xy = b\\sum X^2$, $\\sum X^2 y = a\\sum X^2 + c\\sum X^4$. Solve the first and third together for a and c; b comes directly from the second."
   },
   "points": [
    {
     "en": "b = ΣXy/ΣX²"
    },
    {
     "en": "Solve Σy = na + cΣX² and ΣX²y = aΣX² + cΣX⁴"
    },
    {
     "en": "c > 0: trend bends upward"
    }
   ],
   "narration": {
    "en": "For a parabolic trend the three normal equations, with the origin at the middle, give b directly, and a and c from two simultaneous equations.",
    "kn": "ಪರವಲಯ ಪ್ರವೃತ್ತಿಗೆ ಮೂರು ಸಾಮಾನ್ಯ ಸಮೀಕರಣಗಳು; ಮಧ್ಯವನ್ನು ಮೂಲವಾಗಿಸಿದರೆ b ನೇರವಾಗಿ, a ಮತ್ತು c ಎರಡು ಏಕಕಾಲಿಕ ಸಮೀಕರಣಗಳಿಂದ ದೊರೆಯುತ್ತವೆ."
   },
   "formula": "\\sum y = na + c\\sum X^2, \\quad \\sum Xy = b\\sum X^2, \\quad \\sum X^2y = a\\sum X^2 + c\\sum X^4"
  },
