  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Fit a parabolic trend y = a + bX + cX² to the values 10, 13, 15, 23, 30 for 2020–2024 and estimate the trend for 2025."
   },
   "steps": [
    {
     "en": "Origin 2022: X = −2, −1, 0, 1, 2. ΣX² = 10, ΣX⁴ = 34."
