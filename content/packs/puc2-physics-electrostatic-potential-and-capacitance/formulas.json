{
 "chapterId": "puc2-physics-02-electrostatic-potential-and-capacitance",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t1",
   "name": {
    "en": "Potential and potential difference"
   },
   "tex": "V = \\dfrac{W_{\\infty\\to P}}{q_0},\\qquad V_A - V_B = \\int_A^B\\vec E\\cdot d\\vec l",
   "note": {
    "en": "Path independent: the electrostatic field is conservative."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t1",
   "name": {
    "en": "Point charge"
   },
   "tex": "V = \\dfrac{kq}{r}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t1",
   "name": {
    "en": "System of charges"
   },
   "tex": "V = k\\sum_i\\dfrac{q_i}{r_i}",
   "note": {
    "en": "Scalar sum — no components needed."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t1",
   "name": {
    "en": "Dipole potential"
   },
   "tex": "V = \\dfrac{kp\\cos\\theta}{r^2}",
   "note": {
    "en": "Zero everywhere on the equatorial plane."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t2",
   "name": {
    "en": "Field from potential"
   },
   "tex": "\\vec E = -\\nabla V,\\quad E_x = -\\dfrac{\\partial V}{\\partial x},\\quad E = \\dfrac{\\Delta V}{\\Delta r}\\ \\text{(uniform)}",
   "note": {
    "en": "E points toward decreasing V and is normal to equipotentials."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Work by field"
   },
   "tex": "W_{A\\to B} = q(V_A - V_B)"
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t2",
   "name": {
    "en": "Potential energy of two charges"
   },
   "tex": "U = \\dfrac{kq_1q_2}{r}",
   "note": {
    "en": "For many charges, add over every pair once."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t1",
   "name": {
    "en": "Charge in external field; dipole"
   },
   "tex": "U = qV(\\vec r),\\qquad U_{\\text{dipole}} = -pE\\cos\\theta"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t2",
   "name": {
    "en": "Conducting sphere / shell"
   },
   "tex": "V = \\dfrac{kQ}{R}\\ (r\\le R),\\qquad V = \\dfrac{kQ}{r}\\ (r\\ge R)"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t2",
   "name": {
    "en": "Uniform solid non-conducting sphere"
   },
   "tex": "V(r) = \\dfrac{kQ(3R^2 - r^2)}{2R^3}\\ (r\\le R),\\quad V_{\\text{centre}} = \\dfrac{3}{2}V_{\\text{surface}}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t2",
   "name": {
    "en": "Connected spheres"
   },
   "tex": "\\dfrac{q_1}{q_2} = \\dfrac{r_1}{r_2},\\qquad \\dfrac{\\sigma_1}{\\sigma_2} = \\dfrac{r_2}{r_1}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t4",
   "name": {
    "en": "Capacitance"
   },
   "tex": "C = \\dfrac{Q}{V},\\quad 1\\ \\text{F} = 1\\ \\text{C V}^{-1},\\quad [M^{-1}L^{-2}T^4A^2]"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Parallel-plate capacitor"
   },
   "tex": "C = \\dfrac{K\\varepsilon_0A}{d}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t2",
   "name": {
    "en": "Isolated sphere; spherical capacitor"
   },
   "tex": "C = 4\\pi\\varepsilon_0R,\\qquad C = \\dfrac{4\\pi\\varepsilon_0ab}{b-a}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t4",
   "name": {
    "en": "Partial slab"
   },
   "tex": "C = \\dfrac{\\varepsilon_0A}{d - t + t/K}",
   "note": {
    "en": "Metal slab: K → ∞, C = ε₀A/(d − t)."
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Two dielectrics"
   },
   "tex": "\\text{stacked: } C = \\dfrac{2K_1K_2}{K_1+K_2}C_0,\\qquad \\text{side by side: } C = \\dfrac{K_1+K_2}{2}C_0"
  },
  {
   "id": "zs-f17",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t5",
   "name": {
    "en": "Series and parallel"
   },
   "tex": "\\dfrac{1}{C_s} = \\sum\\dfrac{1}{C_i},\\qquad C_p = \\sum C_i",
   "note": {
    "en": "Series: same Q; parallel: same V."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t5",
   "name": {
    "en": "Energy stored"
   },
   "tex": "U = \\dfrac{1}{2}CV^2 = \\dfrac{Q^2}{2C} = \\dfrac{1}{2}QV",
   "note": {
    "en": "Battery supplies QV; half is lost as heat while charging."
   }
  },
  {
   "id": "zs-f19",
   "name": {
    "en": "Energy density"
   },
   "tex": "u = \\dfrac{1}{2}\\varepsilon_0E^2\\ \\ (\\tfrac12 K\\varepsilon_0E^2 \\text{ in a dielectric})"
  },
  {
   "id": "zs-f20",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t1",
   "name": {
    "en": "Force between plates"
   },
   "tex": "F = \\dfrac{Q^2}{2\\varepsilon_0A} = \\dfrac{1}{2}\\varepsilon_0E^2A"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "Dielectric inserted"
   },
   "tex": "\\text{battery on: } V\\ \\text{fixed},\\ Q,C,U\\times K;\\qquad \\text{isolated: } Q\\ \\text{fixed},\\ C\\times K,\\ V,E,U\\div K"
  },
  {
   "id": "zs-f22",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t3",
   "name": {
    "en": "Bound charge in a dielectric"
   },
   "tex": "E = \\dfrac{E_0}{K},\\qquad \\sigma_b = \\sigma\\left(1 - \\dfrac{1}{K}\\right)"
  },
  {
   "id": "zs-f23",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t4",
   "name": {
    "en": "Charge sharing"
   },
   "tex": "V = \\dfrac{C_1V_1 + C_2V_2}{C_1 + C_2},\\qquad \\Delta U = \\dfrac{C_1C_2(V_1 - V_2)^2}{2(C_1 + C_2)}",
   "note": {
    "en": "Opposite plates joined: use C₁V₁ − C₂V₂."
   }
  },
  {
   "id": "zs-f24",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t4",
   "name": {
    "en": "Force on a dielectric slab (battery on)"
   },
   "tex": "F = \\dfrac{\\varepsilon_0bV^2(K-1)}{2d}",
   "note": {
    "en": "Pulls the slab in; independent of how far it is in."
   }
  },
  {
   "id": "zs-f25",
   "topicId": "puc2-physics-02-electrostatic-potential-and-capacitance.t4",
   "name": {
    "en": "Balanced capacitor bridge"
   },
   "tex": "\\dfrac{C_1}{C_2} = \\dfrac{C_3}{C_4}",
   "note": {
    "en": "The middle capacitor then carries no charge."
   }
  }
 ]
}
