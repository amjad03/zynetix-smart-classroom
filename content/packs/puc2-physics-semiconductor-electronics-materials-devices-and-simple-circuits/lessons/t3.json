   "vars": [
    {
     "name": "Nd",
     "expr": "if(ty == 0, 0, 10^s)"
    },
    {
     "name": "maj",
     "expr": "Nd/2 + sqrt((Nd/2)^2 + 2.25e32)"
    },
    {
     "name": "mnr",
     "expr": "2.25e32/maj"
    },
    {
     "name": "ne",
     "expr": "if(ty == 2, mnr, maj)"
    },
    {
     "name": "nh",
     "expr": "if(ty == 2, maj, mnr)"
    },
    {
     "name": "ee",
     "expr": "floor(log(ne))"
    },
    {
     "name": "em",
     "expr": "ne/10^ee"
    },
    {
     "name": "he",
     "expr": "floor(log(nh))"
    },
    {
     "name": "hm",
     "expr": "nh/10^he"
    },
    {
     "name": "nd",
     "expr": "clamp(round(s - 16), 1, 8)"
    },
    {
     "name": "nE",
     "expr": "clamp(round(4 + 4*log(ne/1.5e16)), 0, 40)"
