{
 "chapterId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t1",
   "name": {
    "en": "Band gaps"
   },
   "tex": "E_g:\\ \\text{C} \\approx 5.4,\\ \\text{Si} \\approx 1.1,\\ \\text{Ge} \\approx 0.7\\ \\text{eV}",
   "note": {
    "en": "Insulator > 3 eV; conductor: bands overlap"
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t2",
   "name": {
    "en": "Intrinsic semiconductor"
   },
   "tex": "n_e = n_h = n_i"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Mass-action law"
   },
   "tex": "n_e n_h = n_i^2"
  },
  {
   "id": "zs-f4",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t3",
   "name": {
    "en": "n-type / p-type"
   },
   "tex": "n\\text{-type}: n_e \\approx N_D \\gg n_h;\\quad p\\text{-type}: n_h \\approx N_A \\gg n_e",
   "note": {
    "en": "Donors: P, As, Sb (group 15); acceptors: B, Al, Ga, In (group 13). Both types are neutral"
   }
  },
  {
   "id": "zs-f5",
   "name": {
    "en": "Conductivity"
   },
   "tex": "\\sigma = e(n_e\\mu_e + n_h\\mu_h),\\quad \\rho = 1/\\sigma"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t1",
   "name": {
    "en": "Temperature dependence"
   },
   "tex": "n_i \\propto T^{3/2}e^{-E_g/2kT}",
   "note": {
    "en": "Resistivity of a semiconductor falls with temperature"
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t4",
   "name": {
    "en": "Barrier potential"
   },
   "tex": "V_0 \\approx 0.7\\ \\text{V (Si)},\\ 0.3\\ \\text{V (Ge)}",
   "note": {
    "en": "Field in depletion region points n → p"
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t4",
   "name": {
    "en": "Bias"
   },
   "tex": "\\text{forward: barrier } V_0 - V,\\ \\text{narrow depletion};\\ \\text{reverse: } V_0 + V,\\ \\text{wide}"
  },
  {
   "id": "zs-f9",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t4",
   "name": {
    "en": "Diode current with drop"
   },
   "tex": "I = \\dfrac{V - V_\\text{knee}}{R}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t4",
   "name": {
    "en": "Dynamic resistance"
   },
   "tex": "r_d = \\dfrac{\\Delta V}{\\Delta I}"
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t5",
   "name": {
    "en": "Half-wave rectifier"
   },
   "tex": "V_\\text{dc} = \\dfrac{V_m}{\\pi},\\quad V_\\text{rms} = \\dfrac{V_m}{2},\\quad f_\\text{out} = f",
   "note": {
    "en": "PIV = Vₘ"
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t5",
   "name": {
    "en": "Full-wave rectifier"
   },
   "tex": "V_\\text{dc} = \\dfrac{2V_m}{\\pi},\\quad V_\\text{rms} = \\dfrac{V_m}{\\sqrt2},\\quad f_\\text{out} = 2f",
   "note": {
    "en": "Bridge: 2 diodes conduct per half cycle"
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t5",
   "name": {
    "en": "Capacitor filter"
   },
   "tex": "\\text{ripple small when } RC \\gg T_\\text{ripple}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t4",
   "name": {
    "en": "Zener regulator"
   },
   "tex": "I_R = \\dfrac{V_\\text{in} - V_Z}{R_s},\\quad I_L = \\dfrac{V_Z}{R_L},\\quad I_Z = I_R - I_L",
   "note": {
    "en": "Zener: heavily doped, used in reverse breakdown"
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-14-semiconductor-electronics-materials-devices-and-simple-circuits.t4",
   "name": {
    "en": "Optoelectronic devices"
   },
   "tex": "\\lambda_\\text{max} = \\dfrac{hc}{E_g},\\quad E_\\text{photon (LED)} \\approx E_g",
   "note": {
    "en": "Photodiode: reverse bias; LED: forward bias; solar cell: no bias, I–V in 4th quadrant"
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Basic gates"
   },
   "tex": "\\text{OR}: A + B;\\ \\text{AND}: A\\cdot B;\\ \\text{NOT}: \\bar A;\\ \\text{NAND}: \\overline{A\\cdot B};\\ \\text{NOR}: \\overline{A + B}",
   "note": {
    "en": "Gates: NEET / JEE Main / KCET / COMEDK"
   }
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "De Morgan's theorems"
   },
   "tex": "\\overline{A + B} = \\bar A\\cdot\\bar B,\\quad \\overline{A\\cdot B} = \\bar A + \\bar B"
  },
  {
   "id": "zs-f18",
   "name": {
    "en": "Universal gates"
   },
   "tex": "\\text{NAND/NOR with tied inputs} = \\text{NOT};\\ \\overline{\\bar A\\cdot\\bar B} = A + B;\\ \\overline{\\bar A + \\bar B} = A\\cdot B"
  }
 ]
}
