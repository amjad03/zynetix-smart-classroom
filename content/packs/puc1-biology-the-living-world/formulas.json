{
 "chapterId": "puc1-biology-01-the-living-world",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-01-the-living-world.t3",
   "name": {
    "en": "Classification"
   },
   "tex": "\\text{grouping into convenient categories (taxa) by easily observable characters}",
   "note": {
    "en": "Taxa can be at any level: plants, wheat, animals, mammals, dogs."
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-01-the-living-world.t1",
   "name": {
    "en": "Identification before naming"
   },
   "tex": "\\text{correct description} \\to \\text{identification} \\to \\text{nomenclature}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-01-the-living-world.t1",
   "name": {
    "en": "Need for scientific names"
   },
   "tex": "\\text{local names vary from place to place}",
   "note": {
    "en": "One standard name for each organism all over the world."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-01-the-living-world.t4",
   "name": {
    "en": "Species"
   },
   "tex": "\\text{individuals with fundamental similarities; distinct morphological differences from related species}",
   "note": {
    "en": "Potato, tomato, brinjal: three species of Solanum."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-01-the-living-world.t3",
   "name": {
    "en": "Systematics"
   },
   "tex": "\\textit{systema} = \\text{systematic arrangement}",
   "note": {
    "en": "Linnaeus: Systema Naturae. Now includes identification, nomenclature, classification and evolutionary relationships."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Known species"
   },
   "tex": "1.7\\text{–}1.8\\ \\text{million}"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Nomenclature codes"
   },
   "tex": "\\text{plants: ICBN};\\ \\text{animals: ICZN}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-01-the-living-world.t2",
   "name": {
    "en": "Binomial rules"
   },
   "tex": "\\textit{Genus}\\ \\textit{epithet}\\ \\text{Author}",
   "note": {
    "en": "Latin, italics; genus capitalised, epithet small; handwritten — underline separately; e.g. Mangifera indica Linn."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-01-the-living-world.t3",
   "name": {
    "en": "Processes of taxonomy"
   },
   "tex": "\\text{characterisation} \\to \\text{identification} \\to \\text{nomenclature} \\to \\text{classification}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-01-the-living-world.t5",
   "name": {
    "en": "Taxonomic hierarchy"
   },
   "tex": "\\text{Kingdom} > \\text{Phylum/Division} > \\text{Class} > \\text{Order} > \\text{Family} > \\text{Genus} > \\text{Species}",
   "note": {
    "en": "Going up: fewer common characters, more organisms."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-01-the-living-world.t5",
   "name": {
    "en": "Man"
   },
   "tex": "\\textit{Homo sapiens}:\\ \\text{Hominidae, Primata, Mammalia, Chordata}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Housefly"
   },
   "tex": "\\textit{Musca domestica}:\\ \\text{Muscidae, Diptera, Insecta, Arthropoda}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-01-the-living-world.t4",
   "name": {
    "en": "Mango"
   },
   "tex": "\\textit{Mangifera indica}:\\ \\text{Anacardiaceae, Sapindales, Dicotyledonae, Angiospermae}"
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "Wheat"
   },
   "tex": "\\textit{Triticum aestivum}:\\ \\text{Poaceae, Poales, Monocotyledonae, Angiospermae}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-01-the-living-world.t4",
   "name": {
    "en": "Genus and family examples"
   },
   "tex": "\\textit{Panthera}\\ (\\text{lion, leopard, tiger}) + \\textit{Felis}\\ (\\text{cat}) \\subset \\text{Felidae}",
   "note": {
    "en": "Felidae + Canidae ⊂ Carnivora; Solanum, Petunia, Datura ⊂ Solanaceae."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-01-the-living-world.t5",
   "name": {
    "en": "Plant order example"
   },
   "tex": "\\text{Convolvulaceae} + \\text{Solanaceae} \\subset \\text{Polymoniales}"
  }
 ]
}
