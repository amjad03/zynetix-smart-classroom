{
 "chapterId": "puc1-biology-19-chemical-coordination-and-integration",
 "formulas": [
  {
   "id": "zs-f1",
   "name": {
    "en": "Hormone"
   },
   "tex": "\\text{Non-nutrient intercellular messenger, produced in trace amounts}"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t1",
   "name": {
    "en": "Hypothalamic hormones"
   },
   "tex": "\\text{GnRH} \\uparrow \\text{gonadotrophins};\\ \\text{somatostatin} \\downarrow GH",
   "note": {
    "en": "Reach anterior pituitary via portal circulation."
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t2",
   "name": {
    "en": "Pituitary parts"
   },
   "tex": "\\text{Adenohypophysis: pars distalis + pars intermedia};\\ \\text{neurohypophysis: pars nervosa}",
   "note": {
    "en": "Located in sella turcica."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t2",
   "name": {
    "en": "Pars distalis"
   },
   "tex": "GH,\\ PRL,\\ TSH,\\ ACTH,\\ LH,\\ FSH"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t2",
   "name": {
    "en": "Neurohypophysis"
   },
   "tex": "\\text{Stores/releases oxytocin \\& vasopressin (made in hypothalamus)}"
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "GH disorders"
   },
   "tex": "\\uparrow \\text{child: gigantism};\\ \\downarrow: \\text{dwarfism};\\ \\uparrow \\text{adult: acromegaly}"
  },
  {
   "id": "zs-f7",
   "name": {
    "en": "Gonadotrophins"
   },
   "tex": "\\text{LH: androgens (male), ovulation + corpus luteum (female); FSH: follicles, spermatogenesis}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t2",
   "name": {
    "en": "ADH deficiency"
   },
   "tex": "\\text{Diabetes insipidus}"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Pineal"
   },
   "tex": "\\text{Melatonin: diurnal rhythm, sleep–wake cycle}"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t3",
   "name": {
    "en": "Thyroid"
   },
   "tex": "T_4,\\ T_3 \\to BMR;\\ TCT \\to \\downarrow Ca^{2+}",
   "note": {
    "en": "Two lobes joined by isthmus."
   }
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Thyroid disorders"
   },
   "tex": "\\text{Goitre (iodine}\\downarrow),\\ \\text{cretinism, Graves' disease (exophthalmic goitre)}"
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "Parathyroid"
   },
   "tex": "4\\ \\text{glands};\\ PTH \\to \\uparrow Ca^{2+}\\ (\\text{hypercalcaemic})"
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Thymus"
   },
   "tex": "\\text{Thymosins: T-cell differentiation; degenerates with age}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t4",
   "name": {
    "en": "Adrenal medulla"
   },
   "tex": "\\text{Adrenaline, noradrenaline (catecholamines): fight or flight}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t2",
   "name": {
    "en": "Adrenal cortex zones"
   },
   "tex": "\\text{Inner: reticularis; middle: fasciculata; outer: glomerulosa}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t4",
   "name": {
    "en": "Corticoids"
   },
   "tex": "\\text{Cortisol: gluconeogenesis, anti-inflammatory; aldosterone: } \\uparrow Na^+, H_2O,\\ \\downarrow K^+"
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t4",
   "name": {
    "en": "Addison's disease"
   },
   "tex": "\\downarrow \\text{adrenal cortex hormones}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t4",
   "name": {
    "en": "Pancreas"
   },
   "tex": "\\alpha\\text{-cells: glucagon (hyperglycaemic)};\\ \\beta\\text{-cells: insulin (hypoglycaemic)}",
   "note": {
    "en": "1–2 million islets, 1–2% of pancreatic tissue."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t1",
   "name": {
    "en": "Gonads"
   },
   "tex": "\\text{Leydig cells: testosterone; follicles: estrogen; corpus luteum: progesterone}"
  },
  {
   "id": "zs-f20",
   "name": {
    "en": "Other hormones"
   },
   "tex": "ANF\\ (\\text{atria}, \\downarrow BP);\\ \\text{erythropoietin (JG cells)}"
  },
  {
   "id": "zs-f21",
   "name": {
    "en": "GI hormones"
   },
   "tex": "\\text{Gastrin: HCl; secretin: } HCO_3^-;\\ CCK: \\text{enzymes + bile};\\ GIP: \\text{inhibits}"
  },
  {
   "id": "zs-f22",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t1",
   "name": {
    "en": "Chemical classes"
   },
   "tex": "\\text{Peptide (insulin), steroid (cortisol), iodothyronine } (T_4),\\ \\text{amino-acid derivative (adrenaline)}"
  },
  {
   "id": "zs-f23",
   "topicId": "puc1-biology-19-chemical-coordination-and-integration.t5",
   "name": {
    "en": "Mechanism"
   },
   "tex": "\\text{Membrane receptor} \\to \\text{second messenger (cAMP, } IP_3, Ca^{2+});\\ \\text{intracellular receptor} \\to \\text{gene expression}"
  }
 ]
}
