   "heading": {
    "en": "The balance that never breaks",
    "kn": "ಎಂದಿಗೂ ತಪ್ಪದ ಸಮತೋಲನ"
   },
   "hook": {
    "en": "Whatever a business does, buying, selling or paying, one equation always stays true. Let us test it with a real set of transactions.",
    "kn": "ವ್ಯವಹಾರ ಏನೇ ಮಾಡಲಿ, ಕೊಳ್ಳಲಿ, ಮಾರಲಿ ಅಥವಾ ಪಾವತಿಸಲಿ, ಒಂದು ಸಮೀಕರಣ ಯಾವಾಗಲೂ ಸರಿಯಾಗಿರುತ್ತದೆ. ಅದನ್ನು ವ್ಯವಹಾರಗಳಿಂದ ಪರೀಕ್ಷಿಸೋಣ."
   },
   "objectives": [
    {
     "en": "State the accounting equation"
    },
    {
     "en": "Show the effect of transactions on assets, liabilities and capital"
    }
   ],
   "narration": {
    "en": "Whatever a business does, buying, selling or paying, one equation always stays true. Let us test it with a real set of transactions.",
    "kn": "ವ್ಯವಹಾರ ಏನೇ ಮಾಡಲಿ, ಕೊಳ್ಳಲಿ, ಮಾರಲಿ ಅಥವಾ ಪಾವತಿಸಲಿ, ಒಂದು ಸಮೀಕರಣ ಯಾವಾಗಲೂ ಸರಿಯಾಗಿರುತ್ತದೆ. ಅದನ್ನು ವ್ಯವಹಾರಗಳಿಂದ ಪರೀಕ್ಷಿಸೋಣ."
