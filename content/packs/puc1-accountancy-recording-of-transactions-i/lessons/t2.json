  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "The accounting equation"
   },
   "body": {
    "en": "Based on the dual aspect concept, the resources of a business (assets) always equal the claims on them: the claims of outsiders (liabilities) and of the owner (capital). Revenue and profit increase capital; expenses, losses and drawings decrease it. Every transaction changes the equation, but the two sides always remain equal.",
    "kn": "ದ್ವಿಮುಖ ಪರಿಕಲ್ಪನೆಯ ಪ್ರಕಾರ ಆಸ್ತಿಗಳು ಯಾವಾಗಲೂ ಹೊಣೆಗಾರಿಕೆ ಮತ್ತು ಬಂಡವಾಳದ ಮೊತ್ತಕ್ಕೆ ಸಮ. ಆದಾಯ ಬಂಡವಾಳ ಹೆಚ್ಚಿಸುತ್ತದೆ; ವೆಚ್ಚ ಮತ್ತು ಸೆಳೆತ ಅದನ್ನು ಕಡಿಮೆ ಮಾಡುತ್ತವೆ."
   },
   "points": [
    {
     "en": "A = L + C"
    },
    {
     "en": "Capital = Assets − Liabilities"
    },
    {
     "en": "Expenses and drawings reduce capital"
    }
   ],
   "narration": {
    "en": "Based on the dual aspect concept, the resources of a business (assets) always equal the claims on them: the claims of outsiders (liabilities) and of the owner (capital). Revenue and profit increase capital; expenses, losses and drawings decrease it. Every transaction changes the equation, but the two sides always remain equal.",
    "kn": "ದ್ವಿಮುಖ ಪರಿಕಲ್ಪನೆಯ ಪ್ರಕಾರ ಆಸ್ತಿಗಳು ಯಾವಾಗಲೂ ಹೊಣೆಗಾರಿಕೆ ಮತ್ತು ಬಂಡವಾಳದ ಮೊತ್ತಕ್ಕೆ ಸಮ. ಆದಾಯ ಬಂಡವಾಳ ಹೆಚ್ಚಿಸುತ್ತದೆ; ವೆಚ್ಚ ಮತ್ತು ಸೆಳೆತ ಅದನ್ನು ಕಡಿಮೆ ಮಾಡುತ್ತವೆ."
   },
   "formula": "A = L + C"
  },
