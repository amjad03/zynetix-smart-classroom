  {
   "id": "ex1",
   "type": "example",
   "problem": {
    "en": "Show the accounting equation for Raj: (1) started business with cash ₹2,00,000; (2) bought goods on credit from Sunil ₹50,000; (3) bought furniture for cash ₹30,000; (4) sold goods costing ₹20,000 for ₹28,000 cash; (5) paid rent ₹4,000; (6) withdrew ₹3,000 for personal use."
   },
   "steps": [
    {
     "en": "(1) Cash 2,00,000 = Capital 2,00,000."
    },
    {
     "en": "(2) Stock +50,000; Creditors +50,000 → Assets 2,50,000 = L 50,000 + C 2,00,000."
    },
    {
     "en": "(3) Cash −30,000; Furniture +30,000 → totals unchanged."
    },
    {
     "en": "(4) Cash +28,000; Stock −20,000; Capital +8,000 (profit) → Assets 2,58,000 = L 50,000 + C 2,08,000."
    },
    {
     "en": "(5) Cash −4,000; Capital −4,000. (6) Cash −3,000; Capital −3,000."
    },
    {
     "en": "Final: Cash 1,91,000 + Stock 30,000 + Furniture 30,000 = 2,51,000 = Creditors 50,000 + Capital 2,01,000."
    }
   ],
   "answer": {
    "en": "Assets ₹2,51,000 = Liabilities ₹50,000 + Capital ₹2,01,000"
   },
   "narration": {
    "en": "Let us work this out step by step. Show the accounting equation for Raj: (1) started business with cash ₹2,00,000; (2) bought goods on credit from Sunil ₹50,000; (3) bought furniture for cash ₹30,000; (4) sold goods costing ₹20,000 for ₹28,000 cash; (5) paid rent ₹4,000; (6) withdrew ₹3,000 for personal use."
   }
