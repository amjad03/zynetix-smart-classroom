  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Account, debit and credit"
   },
   "body": {
    "en": "An account is a summarised record of all transactions relating to one item, such as cash, a person or an expense. It is drawn in a T shape: the left side is the debit (Dr) side and the right side is the credit (Cr) side. Debit and credit do not mean good or bad; they only show the side on which an amount is written.",
    "kn": "ಖಾತೆ ಒಂದು ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಎಲ್ಲಾ ವ್ಯವಹಾರಗಳ ಸಂಕ್ಷಿಪ್ತ ದಾಖಲೆ. ಎಡಭಾಗ ಡೆಬಿಟ್, ಬಲಭಾಗ ಕ್ರೆಡಿಟ್."
   },
   "points": [
    {
     "en": "Dr: left side"
    },
    {
     "en": "Cr: right side"
    }
   ],
   "narration": {
    "en": "An account is a summarised record of all transactions relating to one item, such as cash, a person or an expense. It is drawn in a T shape: the left side is the debit (Dr) side and the right side is the credit (Cr) side. Debit and credit do not mean good or bad; they only show the side on which an amount is written.",
    "kn": "ಖಾತೆ ಒಂದು ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಎಲ್ಲಾ ವ್ಯವಹಾರಗಳ ಸಂಕ್ಷಿಪ್ತ ದಾಖಲೆ. ಎಡಭಾಗ ಡೆಬಿಟ್, ಬಲಭಾಗ ಕ್ರೆಡಿಟ್."
