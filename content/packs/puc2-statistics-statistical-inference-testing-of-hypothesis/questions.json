  ],
  "difficulty": "easy",
  "tags": []
 },
 {
  "id": "2t08-q17",
  "chapterId": "puc2-statistics-08-statistical-inference-testing-of-hypothesis",
  "topicId": "puc2-statistics-08-statistical-inference-testing-of-hypothesis.t4",
  "stem": {
   "en": "For a t-test of the difference of two means with independent samples of sizes 10 and 12, the degrees of freedom are:"
  },
  "options": [
   {
    "en": "22"
   },
   {
    "en": "20"
   },
   {
