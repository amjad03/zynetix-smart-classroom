  "topicId": "puc2-statistics-08-statistical-inference-testing-of-hypothesis.t5",
  "stem": {
   "en": "For the chi-square test of a population variance with a sample of 15, the degrees of freedom are:"
  },
  "options": [
   {
    "en": "14"
   },
   {
    "en": "30"
   },
   {
    "en": "13"
   },
   {
    "en": "15"
   }
  ],
  "answer": 0,
