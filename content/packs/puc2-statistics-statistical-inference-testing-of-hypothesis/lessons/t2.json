  "en": "Large sample tests for means",
  "kn": "ಸರಾಸರಿಗಳಿಗೆ ದೊಡ್ಡ ಮಾದರಿ ಪರೀಕ್ಷೆಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Is the claim true?",
    "kn": "ಹೇಳಿಕೆ ನಿಜವೇ?"
   },
   "hook": {
    "en": "A bulb company claims an average life of 1600 hours. We test 100 bulbs and find an average of 1570 hours. Is that 30-hour shortfall just chance, or is the claim wrong? The Z test for a mean decides.",
    "kn": "ಒಂದು ಬಲ್ಬ್ ಕಂಪನಿ ಸರಾಸರಿ ಆಯುಷ್ಯ 1600 ಗಂಟೆ ಎನ್ನುತ್ತದೆ. 100 ಬಲ್ಬ್ ಪರೀಕ್ಷಿಸಿದಾಗ ಸರಾಸರಿ 1570 ಗಂಟೆ. ಈ 30 ಗಂಟೆ ಕೊರತೆ ಆಕಸ್ಮಿಕವೇ ಅಥವಾ ಹೇಳಿಕೆ ತಪ್ಪೇ? ಸರಾಸರಿಗೆ Z ಪರೀಕ್ಷೆ ತೀರ್ಮಾನಿಸುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Test a single population mean with Z"
    },
    {
     "en": "Test the equality of two population means"
    },
    {
     "en": "Interpret the result at 5% and 1%"
    }
   ],
   "narration": {
    "en": "A bulb company claims an average life of 1600 hours. We test 100 bulbs and find an average of 1570 hours. Is that 30-hour shortfall just chance, or is the claim wrong? The Z test for a mean decides.",
    "kn": "ಒಂದು ಬಲ್ಬ್ ಕಂಪನಿ ಸರಾಸರಿ ಆಯುಷ್ಯ 1600 ಗಂಟೆ ಎನ್ನುತ್ತದೆ. 100 ಬಲ್ಬ್ ಪರೀಕ್ಷಿಸಿದಾಗ ಸರಾಸರಿ 1570 ಗಂಟೆ. ಈ 30 ಗಂಟೆ ಕೊರತೆ ಆಕಸ್ಮಿಕವೇ ಅಥವಾ ಹೇಳಿಕೆ ತಪ್ಪೇ? ಸರಾಸರಿಗೆ Z ಪರೀಕ್ಷೆ ತೀರ್ಮಾನಿಸುತ್ತದೆ."
   }
