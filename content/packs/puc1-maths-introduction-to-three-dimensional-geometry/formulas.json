{
 "chapterId": "puc1-maths-11-introduction-to-three-dimensional-geometry",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t1",
   "name": {
    "en": "Coordinate planes"
   },
   "tex": "xy\\text{-plane}: z = 0,\\quad yz\\text{-plane}: x = 0,\\quad zx\\text{-plane}: y = 0"
  },
  {
   "id": "zs-f2",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t1",
   "name": {
    "en": "Coordinate axes"
   },
   "tex": "x\\text{-axis}: (x,0,0),\\quad y\\text{-axis}: (0,y,0),\\quad z\\text{-axis}: (0,0,z)"
  },
  {
   "id": "zs-f3",
   "name": {
    "en": "Octants"
   },
   "tex": "\\text{I}(+,+,+),\\ \\text{II}(-,+,+),\\ \\text{III}(-,-,+),\\ \\text{IV}(+,-,+),\\ \\text{V}(+,+,-),\\ \\text{VI}(-,+,-),\\ \\text{VII}(-,-,-),\\ \\text{VIII}(+,-,-)"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t3",
   "name": {
    "en": "Distance formula"
   },
   "tex": "PQ = \\sqrt{(x_2-x_1)^2+(y_2-y_1)^2+(z_2-z_1)^2}"
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t3",
   "name": {
    "en": "Distance from the origin"
   },
   "tex": "OP = \\sqrt{x^2+y^2+z^2}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t1",
   "name": {
    "en": "Distance from the axes"
   },
   "tex": "x\\text{-axis}: \\sqrt{y^2+z^2},\\quad y\\text{-axis}: \\sqrt{z^2+x^2},\\quad z\\text{-axis}: \\sqrt{x^2+y^2}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t2",
   "name": {
    "en": "Distance from the coordinate planes"
   },
   "tex": "xy\\text{-plane}: |z|,\\quad yz\\text{-plane}: |x|,\\quad zx\\text{-plane}: |y|"
  },
  {
   "id": "zs-f8",
   "name": {
    "en": "Section formula (internal, m : n)"
   },
   "tex": "\\left(\\dfrac{mx_2+nx_1}{m+n},\\dfrac{my_2+ny_1}{m+n},\\dfrac{mz_2+nz_1}{m+n}\\right)",
   "note": {
    "en": "External: replace n by −n."
   }
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Midpoint"
   },
   "tex": "\\left(\\dfrac{x_1+x_2}2,\\dfrac{y_1+y_2}2,\\dfrac{z_1+z_2}2\\right)"
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t4",
   "name": {
    "en": "Centroid of a triangle"
   },
   "tex": "G = \\left(\\dfrac{\\sum x_i}3,\\dfrac{\\sum y_i}3,\\dfrac{\\sum z_i}3\\right)"
  },
  {
   "id": "zs-f11",
   "name": {
    "en": "Centroid of a tetrahedron"
   },
   "tex": "G = \\left(\\dfrac{\\sum x_i}4,\\dfrac{\\sum y_i}4,\\dfrac{\\sum z_i}4\\right)"
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t1",
   "name": {
    "en": "Ratio in which a coordinate plane divides PQ"
   },
   "tex": "xy\\text{-plane}: -z_1:z_2,\\quad yz\\text{-plane}: -x_1:x_2,\\quad zx\\text{-plane}: -y_1:y_2",
   "note": {
    "en": "Positive ratio = internal division."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t4",
   "name": {
    "en": "Collinearity"
   },
   "tex": "AB+BC = AC\\quad\\text{or}\\quad \\overrightarrow{AC} = \\lambda\\,\\overrightarrow{AB}"
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t1",
   "name": {
    "en": "Image in a coordinate plane"
   },
   "tex": "(x,y,z)\\xrightarrow{xy}(x,y,-z),\\quad\\xrightarrow{yz}(-x,y,z),\\quad\\xrightarrow{zx}(x,-y,z)"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-maths-11-introduction-to-three-dimensional-geometry.t4",
   "name": {
    "en": "Fourth vertex of parallelogram ABCD"
   },
   "tex": "D = A+C-B",
   "note": {
    "en": "Diagonals bisect each other."
   }
  }
 ]
}
