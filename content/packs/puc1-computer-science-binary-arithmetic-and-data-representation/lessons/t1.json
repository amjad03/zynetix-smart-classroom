     "say": {
      "en": "Column 1: 1 + 0 = 1. Column 2: 1 + 1 = 10, write 0 carry 1. Column 3: 0 + 1 + carry 1 = 10, write 0 carry 1. Column 4: 1 + 0 + 1 = 10, write 0 carry 1."
     },
     "draw": [
