  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Rules of binary addition"
   },
   "body": {
    "en": "*Binary* numbers are added column by column from the right, exactly like decimal numbers, but a column overflows at 2 instead of 10. 0 + 0 = 0; 0 + 1 = 1; 1 + 1 = 10 (write 0, carry 1); 1 + 1 + 1 = 11 (write 1, carry 1). The carry is added into the next column to the left."
   },
   "points": [
    {
     "en": "0 + 0 = 0, 0 + 1 = 1"
    },
    {
     "en": "1 + 1 = 0 carry 1"
    },
    {
     "en": "1 + 1 + 1 = 1 carry 1"
    },
    {
     "en": "Check: convert both numbers and the sum to decimal"
    }
   ],
   "narration": {
    "en": "Binary numbers are added column by column from the right, exactly like decimal numbers, but a column overflows at 2 instead of 10. 0 + 0 = 0; 0 + 1 = 1; 1 + 1 = 10 (write 0, carry 1); 1 + 1 + 1 = 11 (write 1, carry 1). The carry is added into the next column to the left."
   },
   "reveal": true,
   "voice": [
    {
     "say": {
      "en": "Binary numbers are added column by column from the right, exactly like decimal numbers, but a column overflows at 2 instead of 10. 0 plus 0 equals 0; 0 plus 1 equals 1; 1 plus 1 equals 10 (write 0, carry 1); 1 plus 1 plus 1 equals 11 (write 1, carry 1). The carry is added into the next column to the left."
     }
    },
    {
     "say": {
      "en": "1 plus 1 equals 0 carry 1."
     }
    },
    {
     "say": {
      "en": "1 plus 1 plus 1 equals 1 carry 1."
     }
    },
    {
     "say": {
      "en": "Check: convert both numbers and the sum to decimal."
     }
    }
   ]
  },
