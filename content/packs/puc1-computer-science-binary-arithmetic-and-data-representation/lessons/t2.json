  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Sign-magnitude and 1's complement"
   },
   "body": {
    "en": "In sign-magnitude form the leftmost bit is the sign (0 for +, 1 for −) and the other bits hold the magnitude: +5 = 00000101, −5 = 10000101 in 8 bits. The 1'*s complement* of a number flips every bit: −5 = 11111010. Both schemes have two zeros (+0 and −0), and adding a negative number needs special rules, so hardware uses neither for integers."
   },
   "points": [
    {
     "en": "Sign bit: 0 positive, 1 negative"
    },
    {
     "en": "1'*s complement*: invert every bit"
    },
    {
     "en": "Both have +0 and −0"
    }
   ],
   "narration": {
    "en": "In sign-magnitude form the leftmost bit is the sign (0 for +, 1 for −) and the other bits hold the magnitude: +5 = 00000101, −5 = 10000101 in 8 bits. The 1's complement of a number flips every bit: −5 = 11111010. Both schemes have two zeros (+0 and −0), and adding a negative number needs special rules, so hardware uses neither for integers."
   },
   "reveal": true,
   "voice": [
    {
     "say": {
      "en": "In sign-magnitude form the leftmost bit is the sign (0 for plus, 1 for -) and the other bits hold the magnitude: plus 5 equals 00000101, minus 5 equals 10000101 in 8 bits. The 1's complement of a number flips every bit: minus 5 equals 11111010. Both schemes have two zeros plus 0 and minus 0, and adding a negative number needs special rules, so hardware uses neither for integers. Sign bit: 0 positive, 1 negative."
     }
    },
    {
     "say": {
      "en": "1's complement: invert every bit."
     }
    },
    {
     "say": {
      "en": "Both have plus 0 and minus 0."
     }
    }
   ]
  },
