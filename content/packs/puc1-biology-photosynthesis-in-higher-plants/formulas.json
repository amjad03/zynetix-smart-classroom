{
 "chapterId": "puc1-biology-11-photosynthesis-in-higher-plants",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t1",
   "name": {
    "en": "Early experiments"
   },
   "tex": "\\text{Priestley (1770)} \\to \\text{Ingenhousz (light, green parts)} \\to \\text{Sachs (1854, glucose/starch)}",
   "note": {
    "en": "Engelmann: Cladophora + aerobic bacteria, first action spectrum (blue, red). van Niel: O₂ from H₂O."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Overall equation"
   },
   "tex": "6\\text{CO}_2 + 12\\text{H}_2\\text{O} \\xrightarrow{\\text{light}} \\text{C}_6\\text{H}_{12}\\text{O}_6 + 6\\text{H}_2\\text{O} + 6\\text{O}_2"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t1",
   "name": {
    "en": "van Niel equation"
   },
   "tex": "2\\text{H}_2\\text{A} + \\text{CO}_2 \\to 2\\text{A} + \\text{CH}_2\\text{O} + \\text{H}_2\\text{O}"
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t2",
   "name": {
    "en": "Pigment colours"
   },
   "tex": "\\text{chl } a \\text{: blue-green};\\ \\text{chl } b \\text{: yellow-green};\\ \\text{xanthophyll: yellow};\\ \\text{carotenoid: yellow-orange}",
   "note": {
    "en": "Accessory pigments widen absorbed range and protect chl a from photo-oxidation."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t2",
   "name": {
    "en": "Photosystems"
   },
   "tex": "\\text{PS I} = P_{700};\\ \\text{PS II} = P_{680}",
   "note": {
    "en": "LHC = antenna; reaction centre = one chl a."
   }
  },
  {
   "id": "zs-f6",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t3",
   "name": {
    "en": "Photolysis"
   },
   "tex": "2\\text{H}_2\\text{O} \\to 4\\text{H}^+ + \\text{O}_2 + 4e^-",
   "note": {
    "en": "Water-splitting complex with PS II, lumen side."
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t3",
   "name": {
    "en": "Non-cyclic (Z scheme)"
   },
   "tex": "\\text{H}_2\\text{O} \\to \\text{PS II} \\to \\text{ETS (cyt)} \\to \\text{PS I} \\to \\text{NADP}^+",
   "note": {
    "en": "Gives ATP + NADPH + O₂."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t3",
   "name": {
    "en": "Cyclic photophosphorylation"
   },
   "tex": "\\text{PS I only};\\ \\text{ATP only};\\ \\text{stroma lamellae};\\ \\lambda > 680\\ \\text{nm}",
   "note": {
    "en": "Stroma lamellae lack PS II and NADP reductase."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t3",
   "name": {
    "en": "Chemiosmosis"
   },
   "tex": "[\\text{H}^+]_{\\text{lumen}} \\gg [\\text{H}^+]_{\\text{stroma}};\\ \\text{CF}_0\\ \\text{channel},\\ \\text{CF}_1\\ \\text{makes ATP}",
   "note": {
    "en": "Gradient from photolysis, H-carrier pumping, NADP reductase on stroma side."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t4",
   "name": {
    "en": "Calvin cycle"
   },
   "tex": "\\text{RuBP (5C)} + \\text{CO}_2 \\xrightarrow{\\text{RuBisCO}} 2 \\times \\text{3-PGA}",
   "note": {
    "en": "Stages: carboxylation, reduction, regeneration."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t4",
   "name": {
    "en": "Calvin energetics"
   },
   "tex": "\\text{per CO}_2: 3\\ \\text{ATP} + 2\\ \\text{NADPH};\\quad \\text{per glucose}: 18\\ \\text{ATP} + 12\\ \\text{NADPH}",
   "note": {
    "en": "6 turns per glucose."
   }
  },
  {
   "id": "zs-f12",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t5",
   "name": {
    "en": "C4 pathway"
   },
   "tex": "\\text{PEP (3C)} + \\text{CO}_2 \\xrightarrow{\\text{PEPcase}} \\text{OAA (4C)} \\to \\text{malate/aspartate}",
   "note": {
    "en": "Mesophyll lacks RuBisCO; bundle sheath has RuBisCO, lacks PEPcase. Kranz = wreath."
   }
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t5",
   "name": {
    "en": "Photorespiration"
   },
   "tex": "\\text{RuBP} + \\text{O}_2 \\to \\text{PGA} + \\text{phosphoglycolate}",
   "note": {
    "en": "No sugar, ATP or NADPH; uses ATP, releases CO₂. Absent in C4."
   }
  },
  {
   "id": "zs-f14",
   "name": {
    "en": "C4 traits"
   },
   "tex": "\\text{high temperature, high light, no photorespiration, high biomass}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t6",
   "name": {
    "en": "Blackman (1905)"
   },
   "tex": "\\text{rate set by factor nearest its minimal value}"
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t6",
   "name": {
    "en": "Light"
   },
   "tex": "\\text{saturation at } \\approx 10\\%\\ \\text{of full sunlight}",
   "note": {
    "en": "Very high light breaks down chlorophyll."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t6",
   "name": {
    "en": "CO₂"
   },
   "tex": "\\text{atm. } 0.03\\text{–}0.04\\%;\\ \\text{benefit up to } 0.05\\%;\\ \\text{C4 sat.} \\approx 360,\\ \\text{C3 sat.} > 450\\ \\mu\\text{L L}^{-1}",
   "note": {
    "en": "CO₂-enriched greenhouses: tomato, bell pepper."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-11-photosynthesis-in-higher-plants.t6",
   "name": {
    "en": "Temperature and water"
   },
   "tex": "\\text{C4: higher optimum};\\ \\text{water stress} \\to \\text{stomatal closure, wilting}"
  }
 ]
}
