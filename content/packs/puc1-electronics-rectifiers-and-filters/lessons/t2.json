  {
   "id": "lab-full-wave-rectifier",
   "type": "virtual_lab",
   "labId": "full-wave-rectifier",
   "aim": {
    "en": "Study a centre-tap full-wave rectifier and find its d.c. output and ripple factor without a filter."
