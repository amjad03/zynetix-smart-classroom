  {
   "id": "ex1",
   "type": "example",
   "title": {
    "en": "Worked example"
   },
   "problem": {
    "en": "A 12–0–12 V (r.m.s.) transformer feeds a centre-tap full-wave rectifier with a 1 kΩ load (ideal diodes). Find V_dc, I_dc, the ripple frequency (50 Hz mains) and the PIV of each diode."
   },
   "steps": [
    {
     "en": "V_m (each half) = 12√2 ≈ 16.97 V."
    },
    {
     "en": "V_dc = 2V_m/π = 2 × 16.97/3.1416 ≈ 10.8 V; I_dc = 10.8 mA."
    },
    {
     "en": "Ripple frequency = 2 × 50 = 100 Hz."
    },
    {
     "en": "PIV = 2V_m ≈ 33.9 V."
