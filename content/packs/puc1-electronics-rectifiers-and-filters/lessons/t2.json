 "title": {
  "en": "Centre-tap full-wave rectifier",
  "kn": "ಮಧ್ಯ-ಟ್ಯಾಪ್ ಪೂರ್ಣ-ತರಂಗ ದಿಷ್ಟಕಾರಿ"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Do not waste half the wave",
    "kn": "ಅರ್ಧ ತರಂಗವನ್ನು ವ್ಯರ್ಥ ಮಾಡಬೇಡಿ"
   },
   "hook": {
    "en": "A half-wave rectifier throws away every negative half cycle. With a centre-tapped transformer and one more diode, we can use both halves.",
    "kn": "ಅರ್ಧ-ತರಂಗ ದಿಷ್ಟಕಾರಿ ಪ್ರತಿ ಋಣ ಅರ್ಧ ಚಕ್ರವನ್ನು ಬಿಟ್ಟುಬಿಡುತ್ತದೆ. ಮಧ್ಯ-ಟ್ಯಾಪ್ ಪರಿವರ್ತಕ ಮತ್ತು ಇನ್ನೊಂದು ಡಯೋಡ್‌ನಿಂದ ಎರಡೂ ಅರ್ಧಗಳನ್ನು ಬಳಸಬಹುದು."
   },
   "objectives": [
    {
     "en": "Explain the working of a centre-tap full-wave rectifier"
    },
    {
     "en": "Use V_dc = 2V_m/π and I_rms = I_m/√2"
    },
    {
     "en": "State its ripple factor, efficiency and PIV"
    }
   ],
   "narration": {
    "en": "A half-wave rectifier throws away every negative half cycle. With a centre-tapped transformer and one more diode, we can use both halves.",
    "kn": "ಅರ್ಧ-ತರಂಗ ದಿಷ್ಟಕಾರಿ ಪ್ರತಿ ಋಣ ಅರ್ಧ ಚಕ್ರವನ್ನು ಬಿಟ್ಟುಬಿಡುತ್ತದೆ. ಮಧ್ಯ-ಟ್ಯಾಪ್ ಪರಿವರ್ತಕ ಮತ್ತು ಇನ್ನೊಂದು ಡಯೋಡ್‌ನಿಂದ ಎರಡೂ ಅರ್ಧಗಳನ್ನು ಬಳಸಬಹುದು."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Working of the centre-tap rectifier"
   },
   "body": {
    "en": "The secondary of the transformer has a centre tap (CT) that acts as the common return. The two ends feed diodes D1 and D2, whose cathodes are joined to one end of the load; the other end of the load goes to the centre tap. In the positive half cycle D1 conducts and D2 is off; in the negative half D2 conducts and D1 is off. Both drive current through the load in the same direction, so the output has two pulses per cycle and the ripple frequency is twice the supply frequency."
   },
   "points": [
    {
     "en": "Two diodes, centre-tapped transformer"
    },
    {
     "en": "D1 and D2 conduct in alternate half cycles"
    },
    {
     "en": "Ripple frequency = 2f (100 Hz for 50 Hz mains)"
    }
   ],
   "narration": {
    "en": "In a centre-tap full-wave rectifier, D1 conducts in one half cycle and D2 in the other, both sending current through the load the same way. The output has two pulses every cycle.",
    "kn": "ಮಧ್ಯ-ಟ್ಯಾಪ್ ಪೂರ್ಣ-ತರಂಗ ದಿಷ್ಟಕಾರಿಯಲ್ಲಿ D1 ಒಂದು ಅರ್ಧ ಚಕ್ರದಲ್ಲಿ, D2 ಇನ್ನೊಂದರಲ್ಲಿ ವಹಿಸುತ್ತವೆ; ಎರಡೂ ಲೋಡ್ ಮೂಲಕ ಒಂದೇ ದಿಕ್ಕಿನಲ್ಲಿ ಪ್ರವಾಹ ಕಳುಹಿಸುತ್ತವೆ."
   }
  },
