   "type": "example",
   "title": {
    "en": "Worked example"
   },
   "problem": {
    "en": "A full-wave rectifier on 50 Hz mains has a 1000 µF capacitor filter and a 1 kΩ load. Find the ripple factor. What would it be for a half-wave rectifier?"
   },
   "steps": [
    {
     "en": "r_FW = 1/(4√3 f C R_L) = 1/(4 × 1.732 × 50 × 1000 × 10⁻⁶ × 1000)."
    },
    {
     "en": "Denominator = 6.928 × 50 × 1 = 346.4, so r ≈ 0.00289 = 0.29 %."
    },
    {
     "en": "r_HW = 1/(2√3 f C R_L) = 2 × 0.00289 ≈ 0.0058 = 0.58 %."
    }
   ],
   "answer": {
    "en": "0.29 % (full-wave); 0.58 % (half-wave)"
   },
   "narration": {
    "en": "Let us solve this together. A full-wave rectifier on 50 Hz mains has a 1000 µF capacitor filter and a 1 kΩ load. Find the ripple factor. What would it be for a half-wave rectifier?"
   }
