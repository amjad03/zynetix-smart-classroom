   "problem": {
    "en": "A half-wave rectifier (50 Hz) feeds a 500 Ω load. What capacitor gives a ripple factor of 2 %?"
   },
   "steps": [
    {
     "en": "C = 1/(2√3 f R_L r) = 1/(2 × 1.732 × 50 × 500 × 0.02)."
    },
    {
     "en": "C = 1/1732 F ≈ 5.77 × 10⁻⁴ F = 577 µF (use the next standard value, 680 µF)."
    }
   ],
