 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "A supply that does not sag",
    "kn": "ಕುಗ್ಗದ ಸರಬರಾಜು"
   },
   "hook": {
    "en": "When the mains dips from 230 V to 200 V, or you plug in a bigger load, a plain filtered supply sags. A regulated supply holds its output steady.",
    "kn": "ಮುಖ್ಯ ಸರಬರಾಜು 230 V ನಿಂದ 200 V ಗೆ ಇಳಿದರೆ ಅಥವಾ ದೊಡ್ಡ ಲೋಡ್ ಸೇರಿಸಿದರೆ ಸಾಮಾನ್ಯ ಸರಬರಾಜು ಕುಗ್ಗುತ್ತದೆ. ನಿಯಂತ್ರಿತ ಸರಬರಾಜು ಔಟ್‌ಪುಟ್ ಸ್ಥಿರವಾಗಿಡುತ್ತದೆ."
   },
   "objectives": [
    {
     "en": "Draw the block diagram of a regulated d.c. power supply"
    },
    {
     "en": "Define line and load regulation"
    },
    {
     "en": "Use three-terminal IC regulators (78xx, 79xx)"
    }
   ],
   "narration": {
    "en": "When the mains dips from 230 V to 200 V, or you plug in a bigger load, a plain filtered supply sags. A regulated supply holds its output steady.",
    "kn": "ಮುಖ್ಯ ಸರಬರಾಜು 230 V ನಿಂದ 200 V ಗೆ ಇಳಿದರೆ ಅಥವಾ ದೊಡ್ಡ ಲೋಡ್ ಸೇರಿಸಿದರೆ ಸಾಮಾನ್ಯ ಸರಬರಾಜು ಕುಗ್ಗುತ್ತದೆ. ನಿಯಂತ್ರಿತ ಸರಬರಾಜು ಔಟ್‌ಪುಟ್ ಸ್ಥಿರವಾಗಿಡುತ್ತದೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Blocks of a regulated power supply"
   },
   "body": {
    "en": "A regulated d.c. power supply has four blocks: a step-down transformer (230 V a.c. to a lower a.c. voltage, also isolating the circuit from the mains), a rectifier (a.c. to pulsating d.c.), a filter (removes most of the ripple) and a voltage regulator (keeps the output constant against changes in the input voltage and the load current). A Zener diode with a series resistor is the simplest regulator."
   },
   "points": [
    {
     "en": "Transformer → rectifier → filter → regulator"
    },
    {
     "en": "Unregulated supply: output changes with mains and load"
    },
    {
     "en": "Simplest regulator: Zener shunt regulator"
    }
   ],
   "narration": {
    "en": "A regulated supply has four blocks: transformer, rectifier, filter and regulator. The regulator keeps the output steady when the mains or the load changes.",
    "kn": "ನಿಯಂತ್ರಿತ ಸರಬರಾಜಿನಲ್ಲಿ ನಾಲ್ಕು ಭಾಗಗಳು: ಪರಿವರ್ತಕ, ದಿಷ್ಟಕಾರಿ, ಫಿಲ್ಟರ್ ಮತ್ತು ನಿಯಂತ್ರಕ. ಮುಖ್ಯ ಸರಬರಾಜು ಅಥವಾ ಲೋಡ್ ಬದಲಾದಾಗ ನಿಯಂತ್ರಕ ಔಟ್‌ಪುಟ್ ಸ್ಥಿರವಾಗಿಡುತ್ತದೆ."
   }
  },
