  {
   "id": "ex1",
   "type": "example",
   "title": {
    "en": "Worked example"
   },
   "problem": {
    "en": "A half-wave rectifier is fed from a 12 V (r.m.s.) secondary and supplies a 1 kΩ load. Treat the diode as ideal. Find V_m, V_dc, I_dc, V_rms across the load and the PIV."
   },
   "steps": [
    {
     "en": "V_m = √2 × 12 ≈ 16.97 V."
    },
    {
     "en": "V_dc = V_m/π = 16.97/3.1416 ≈ 5.40 V; I_dc = 5.40 V / 1 kΩ = 5.40 mA."
    },
    {
     "en": "V_rms = V_m/2 ≈ 8.49 V."
    },
    {
     "en": "PIV = V_m ≈ 17.0 V. (With a 0.7 V silicon drop, V_dc ≈ (16.97 − 0.7)/π ≈ 5.18 V.)"
    }
   ],
   "answer": {
    "en": "V_m ≈ 17.0 V, V_dc ≈ 5.40 V, I_dc ≈ 5.4 mA, V_rms ≈ 8.49 V, PIV ≈ 17 V"
   },
   "narration": {
    "en": "Let us solve this together. A half-wave rectifier is fed from a 12 V (r.m.s.) secondary and supplies a 1 kΩ load. Treat the diode as ideal. Find V_m, V_dc, I_dc, V_rms across the load and the PIV."
   }
