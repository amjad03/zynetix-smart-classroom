{
 "chapterId": "puc1-biology-08-cell-the-unit-of-life",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t1",
   "name": {
    "en": "Cell theory"
   },
   "tex": "\\text{Schleiden (1838, plants)} + \\text{Schwann (1839, animals)}",
   "note": {
    "en": "Virchow (1855): Omnis cellula-e cellula — cells arise from pre-existing cells."
   }
  },
  {
   "id": "zs-f2",
   "name": {
    "en": "Discoveries"
   },
   "tex": "\\text{Leeuwenhoek: live cell};\\ \\text{Brown (1831): nucleus};\\ \\text{Flemming: chromatin}"
  },
  {
   "id": "zs-f3",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t1",
   "name": {
    "en": "Cell sizes"
   },
   "tex": "\\text{Mycoplasma} \\approx 0.3\\ \\mu\\text{m};\\ \\text{bacteria } 3\\text{–}5\\ \\mu\\text{m};\\ \\text{human RBC} \\approx 7\\ \\mu\\text{m}",
   "note": {
    "en": "Largest isolated single cell: ostrich egg. Nerve cells are among the longest."
   }
  },
  {
   "id": "zs-f4",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t2",
   "name": {
    "en": "Bacterial envelope"
   },
   "tex": "\\text{glycocalyx} \\to \\text{cell wall} \\to \\text{plasma membrane}",
   "note": {
    "en": "Glycocalyx: loose = slime layer, thick and tough = capsule."
   }
  },
  {
   "id": "zs-f5",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t2",
   "name": {
    "en": "Mesosome"
   },
   "tex": "\\text{membrane infolding: wall formation, DNA replication, respiration, secretion}",
   "note": {
    "en": "Chromatophores in cyanobacteria carry pigments."
   }
  },
  {
   "id": "zs-f6",
   "name": {
    "en": "Bacterial appendages"
   },
   "tex": "\\text{flagellum (filament, hook, basal body)},\\ \\text{pili (tubes)},\\ \\text{fimbriae (bristles, attachment)}"
  },
  {
   "id": "zs-f7",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t1",
   "name": {
    "en": "Inclusion bodies"
   },
   "tex": "\\text{phosphate, cyanophycean, glycogen granules; gas vacuoles}",
   "note": {
    "en": "Not membrane-bound. Gas vacuoles: blue-green, purple and green photosynthetic bacteria."
   }
  },
  {
   "id": "zs-f8",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t5",
   "name": {
    "en": "Ribosomes"
   },
   "tex": "70\\text{S} = 50\\text{S} + 30\\text{S};\\quad 80\\text{S} = 60\\text{S} + 40\\text{S}",
   "note": {
    "en": "Palade (1953). S = Svedberg (sedimentation) unit, not additive. Polysome = many ribosomes on one mRNA."
   }
  },
  {
   "id": "zs-f9",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t3",
   "name": {
    "en": "Fluid mosaic model"
   },
   "tex": "\\text{Singer and Nicolson, 1972}",
   "note": {
    "en": "RBC membrane ≈ 52% protein, 40% lipid. Heads outward, tails inward."
   }
  },
  {
   "id": "zs-f10",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t3",
   "name": {
    "en": "Plant cell wall"
   },
   "tex": "\\text{primary (growing)} \\to \\text{secondary (inner)};\\ \\text{middle lamella} = \\text{Ca pectate}",
   "note": {
    "en": "Algal wall: cellulose, galactans, mannans, CaCO₃. Plasmodesmata connect cytoplasm."
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t4",
   "name": {
    "en": "Endomembrane system"
   },
   "tex": "\\text{ER, Golgi, lysosomes, vacuoles}",
   "note": {
    "en": "Mitochondria, chloroplasts, peroxisomes excluded (functions not coordinated)."
   }
  },
  {
   "id": "zs-f12",
   "name": {
    "en": "ER"
   },
   "tex": "\\text{RER: protein synthesis};\\ \\text{SER: lipids, steroid hormones}"
  },
  {
   "id": "zs-f13",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t4",
   "name": {
    "en": "Golgi"
   },
   "tex": "\\text{Camillo Golgi, 1898};\\ \\text{cis (convex, forming)} \\to \\text{trans (concave, maturing)}",
   "note": {
    "en": "Cisternae 0.5–1.0 µm; site of glycoprotein and glycolipid formation."
   }
  },
  {
   "id": "zs-f14",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t4",
   "name": {
    "en": "Lysosome and vacuole"
   },
   "tex": "\\text{acid hydrolases};\\ \\text{tonoplast};\\ \\text{vacuole up to } 90\\%\\ \\text{of plant cell}",
   "note": {
    "en": "Contractile vacuole in Amoeba: osmoregulation and excretion."
   }
  },
  {
   "id": "zs-f15",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t5",
   "name": {
    "en": "Mitochondria"
   },
   "tex": "\\varnothing\\ 0.2\\text{–}1.0\\ \\mu\\text{m}\\ (\\text{avg } 0.5);\\ \\text{length } 1.0\\text{–}4.1\\ \\mu\\text{m}",
   "note": {
    "en": "Cristae; matrix has circular DNA, RNA, 70S ribosomes; divide by fission."
   }
  },
  {
   "id": "zs-f16",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t5",
   "name": {
    "en": "Chloroplast"
   },
   "tex": "5\\text{–}10\\ \\mu\\text{m} \\times 2\\text{–}4\\ \\mu\\text{m};\\ 1\\ (\\text{Chlamydomonas}) \\text{ to } 20\\text{–}40\\ \\text{per mesophyll cell}",
   "note": {
    "en": "Thylakoids stacked as grana; stroma lamellae; stroma has DNA and 70S ribosomes."
   }
  },
  {
   "id": "zs-f17",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t5",
   "name": {
    "en": "Leucoplasts"
   },
   "tex": "\\text{amyloplast (starch)},\\ \\text{elaioplast (oils, fats)},\\ \\text{aleuroplast (proteins)}",
   "note": {
    "en": "Chromoplasts: carotene, xanthophylls."
   }
  },
  {
   "id": "zs-f18",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t6",
   "name": {
    "en": "Cilium / flagellum"
   },
   "tex": "\\text{axoneme } 9 + 2\\ (\\text{doublets})",
   "note": {
    "en": "Radial spokes, central sheath, linkers; arise from basal bodies."
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t6",
   "name": {
    "en": "Centriole"
   },
   "tex": "9\\ \\text{triplets (cartwheel)} + \\text{central hub}",
   "note": {
    "en": "Two perpendicular centrioles in a centrosome; form basal bodies and spindle."
   }
  },
  {
   "id": "zs-f20",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t6",
   "name": {
    "en": "Nucleus"
   },
   "tex": "\\text{perinuclear space } 10\\text{–}50\\ \\text{nm};\\ \\text{nuclear pores}",
   "note": {
    "en": "Nucleolus: rRNA synthesis, not membrane-bound. Anucleate: mammalian RBC, sieve tube cells."
   }
  },
  {
   "id": "zs-f21",
   "topicId": "puc1-biology-08-cell-the-unit-of-life.t6",
   "name": {
    "en": "Chromosome types"
   },
   "tex": "\\text{metacentric},\\ \\text{sub-metacentric},\\ \\text{acrocentric},\\ \\text{telocentric}",
   "note": {
    "en": "Kinetochores: discs on centromere. Satellite: beyond a non-staining secondary constriction."
   }
  }
 ]
}
