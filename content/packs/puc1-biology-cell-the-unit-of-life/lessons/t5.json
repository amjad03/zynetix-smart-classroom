 "title": {
  "en": "Mitochondria, plastids and ribosomes",
  "kn": "ಮೈಟೋಕಾಂಡ್ರಿಯ, ಪ್ಲಾಸ್ಟಿಡ್‌ಗಳು ಮತ್ತು ರೈಬೋಸೋಮ್‌ಗಳು"
 },
 "minutes": 40,
 "blocks": [
  {
   "id": "intro",
   "type": "intro",
   "heading": {
    "en": "Power houses and kitchens",
    "kn": "ಶಕ್ತಿ ಕೇಂದ್ರಗಳು ಮತ್ತು ಅಡುಗೆಮನೆಗಳು"
   },
   "hook": {
    "en": "Mitochondria and chloroplasts carry their own DNA and their own ribosomes, almost like small bacteria living inside our cells.",
    "kn": "ಮೈಟೋಕಾಂಡ್ರಿಯ ಮತ್ತು ಹರಿತ್ತಿಲವಕಗಳಲ್ಲಿ ತಮ್ಮದೇ ಆದ DNA ಮತ್ತು ರೈಬೋಸೋಮ್‌ಗಳಿವೆ, ನಮ್ಮ ಜೀವಕೋಶದೊಳಗೆ ವಾಸಿಸುವ ಚಿಕ್ಕ ಬ್ಯಾಕ್ಟೀರಿಯಾಗಳಂತೆ."
   },
   "objectives": [
    {
     "en": "Describe the structure of a mitochondrion."
    },
    {
     "en": "Classify plastids and describe the chloroplast."
    },
    {
     "en": "Compare 70S and 80S ribosomes."
    }
   ],
   "narration": {
    "en": "Mitochondria and chloroplasts carry their own DNA and their own ribosomes, almost like small bacteria living inside our cells.",
    "kn": "ಮೈಟೋಕಾಂಡ್ರಿಯ ಮತ್ತು ಹರಿತ್ತಿಲವಕಗಳಲ್ಲಿ ತಮ್ಮದೇ ಆದ DNA ಮತ್ತು ರೈಬೋಸೋಮ್‌ಗಳಿವೆ, ನಮ್ಮ ಜೀವಕೋಶದೊಳಗೆ ವಾಸಿಸುವ ಚಿಕ್ಕ ಬ್ಯಾಕ್ಟೀರಿಯಾಗಳಂತೆ."
   }
  },
  {
   "id": "concept1",
   "type": "concept",
   "title": {
    "en": "Mitochondria"
   },
   "body": {
    "en": "Mitochondria are sausage-shaped or cylindrical, 0.2–1.0 μm wide (average 0.5 μm) and 1.0–4.1 μm long. Each has a double membrane: the outer membrane forms the boundary, and the inner membrane folds into cristae that increase the surface area. The matrix inside has a single circular DNA molecule, a few RNA molecules, 70S ribosomes and the components for protein synthesis. They are the sites of aerobic respiration, produce energy as ATP (the power houses of the cell) and divide by fission."
   },
   "points": [
    {
     "en": "Two compartments: the outer compartment and the inner matrix."
    },
    {
     "en": "Cristae: infoldings of the inner membrane."
    },
    {
     "en": "Semi-autonomous: own DNA and 70S ribosomes."
    }
   ],
   "narration": {
    "en": "Mitochondria are sausage-shaped or cylindrical, 0.2–1.0 μm wide (average 0.5 μm) and 1.0–4.1 μm long. Each has a double membrane: the outer membrane forms the boundary, and the inner membrane folds into cristae that increase the surface area. The matrix inside has a single circular DNA molecule, a few RNA molecules, 70S ribosomes and the components for protein synthesis. They are the sites of aerobic respiration, produce energy as ATP (the power houses of the cell) and divide by fission.",
    "kn": "ಮೈಟೋಕಾಂಡ್ರಿಯಕ್ಕೆ ಎರಡು ಪೊರೆಗಳಿವೆ; ಒಳಪೊರೆ ಕ್ರಿಸ್ಟೆಗಳಾಗಿ ಮಡಚಿದೆ. ಮಾತೃಕೆಯಲ್ಲಿ ವೃತ್ತಾಕಾರದ DNA ಮತ್ತು 70S ರೈಬೋಸೋಮ್‌ಗಳಿವೆ. ಇವು ಜೀವಕೋಶದ ಶಕ್ತಿ ಕೇಂದ್ರಗಳು."
   }
  },
