{
 "chapterId": "puc2-physics-12-atoms",
 "formulas": [
  {
   "id": "zs-f1",
   "topicId": "puc2-physics-12-atoms.t1",
   "name": {
    "en": "Distance of closest approach"
   },
   "tex": "r_0 = \\dfrac{1}{4\\pi\\varepsilon_0}\\dfrac{2Ze^2}{K}",
   "note": {
    "en": "$\\dfrac{e^2}{4\\pi\\varepsilon_0} = 1.44$ MeV fm"
   }
  },
  {
   "id": "zs-f2",
   "topicId": "puc2-physics-12-atoms.t1",
   "name": {
    "en": "Impact parameter"
   },
   "tex": "b = \\dfrac{1}{4\\pi\\varepsilon_0}\\dfrac{Ze^2\\cot(\\theta/2)}{K}",
   "note": {
    "en": "b = 0 gives θ = 180°; larger b, smaller θ"
   }
  },
  {
   "id": "zs-f3",
   "topicId": "puc2-physics-12-atoms.t1",
   "name": {
    "en": "Rutherford scattering count"
   },
   "tex": "N(\\theta) \\propto \\dfrac{1}{\\sin^4(\\theta/2)}"
  },
  {
   "id": "zs-f4",
   "name": {
    "en": "Bohr quantisation"
   },
   "tex": "mvr = \\dfrac{nh}{2\\pi},\\quad 2\\pi r = n\\lambda"
  },
  {
   "id": "zs-f5",
   "topicId": "puc2-physics-12-atoms.t3",
   "name": {
    "en": "Orbit radius"
   },
   "tex": "r_n = \\dfrac{\\varepsilon_0 n^2 h^2}{\\pi m e^2 Z} = 0.529\\,\\dfrac{n^2}{Z}\\ \\text{Å}"
  },
  {
   "id": "zs-f6",
   "topicId": "puc2-physics-12-atoms.t3",
   "name": {
    "en": "Orbital speed"
   },
   "tex": "v_n = \\dfrac{e^2}{2\\varepsilon_0 h}\\dfrac{Z}{n} = 2.18\\times10^{6}\\,\\dfrac{Z}{n}\\ \\text{m/s}",
   "note": {
    "en": "$v_1 = c/137$ for H"
   }
  },
  {
   "id": "zs-f7",
   "topicId": "puc2-physics-12-atoms.t4",
   "name": {
    "en": "Energy levels"
   },
   "tex": "E_n = -\\dfrac{me^4}{8\\varepsilon_0^2h^2}\\dfrac{Z^2}{n^2} = -13.6\\,\\dfrac{Z^2}{n^2}\\ \\text{eV}"
  },
  {
   "id": "zs-f8",
   "topicId": "puc2-physics-12-atoms.t1",
   "name": {
    "en": "Kinetic and potential energy"
   },
   "tex": "K = -E,\\quad U = 2E,\\quad K : U = 1 : -2"
  },
  {
   "id": "zs-f9",
   "name": {
    "en": "Period, frequency, current"
   },
   "tex": "T \\propto \\dfrac{n^3}{Z^2},\\quad I = \\dfrac{e}{T} \\propto \\dfrac{Z^2}{n^3}"
  },
  {
   "id": "zs-f10",
   "name": {
    "en": "Orbital magnetic moment"
   },
   "tex": "\\mu = \\dfrac{neh}{4\\pi m}",
   "note": {
    "en": "Bohr magneton $\\mu_B = eh/4\\pi m = 9.27\\times10^{-24}$ A m²"
   }
  },
  {
   "id": "zs-f11",
   "topicId": "puc2-physics-12-atoms.t4",
   "name": {
    "en": "Photon emitted"
   },
   "tex": "h\\nu = E_{n_2} - E_{n_1}"
  },
  {
   "id": "zs-f12",
   "topicId": "puc2-physics-12-atoms.t2",
   "name": {
    "en": "Rydberg formula"
   },
   "tex": "\\dfrac{1}{\\lambda} = RZ^2\\left(\\dfrac{1}{n_1^2} - \\dfrac{1}{n_2^2}\\right)",
   "note": {
    "en": "$R = 1.097\\times10^7$ m$^{-1}$, $1/R = 91.2$ nm"
   }
  },
  {
   "id": "zs-f13",
   "name": {
    "en": "Series"
   },
   "tex": "\\text{Lyman } n_1{=}1\\ (\\text{UV}),\\ \\text{Balmer } 2\\ (\\text{visible}),\\ \\text{Paschen } 3,\\ \\text{Brackett } 4,\\ \\text{Pfund } 5\\ (\\text{IR})"
  },
  {
   "id": "zs-f14",
   "topicId": "puc2-physics-12-atoms.t2",
   "name": {
    "en": "Series limits and first lines (H)"
   },
   "tex": "\\text{Lyman: } 91.2\\text{–}121.6\\ \\text{nm};\\quad \\text{Balmer: } 364.6\\text{–}656.3\\ \\text{nm}"
  },
  {
   "id": "zs-f15",
   "topicId": "puc2-physics-12-atoms.t4",
   "name": {
    "en": "Number of spectral lines"
   },
   "tex": "N = \\dfrac{n(n-1)}{2}",
   "note": {
    "en": "For many atoms; a single atom gives at most n − 1 photons"
   }
  },
  {
   "id": "zs-f16",
   "name": {
    "en": "Excitation energies of H"
   },
   "tex": "10.2,\\ 12.09,\\ 12.75\\ \\text{eV (to } n = 2, 3, 4),\\quad \\text{IE} = 13.6\\ \\text{eV}"
  },
  {
   "id": "zs-f17",
   "name": {
    "en": "Recoil of emitting atom"
   },
   "tex": "v = \\dfrac{h\\nu}{Mc}"
  },
  {
   "id": "zs-f18",
   "topicId": "puc2-physics-12-atoms.t3",
   "name": {
    "en": "Reduced-mass correction"
   },
   "tex": "E_n \\propto \\mu = \\dfrac{mM}{m + M}",
   "note": {
    "en": "Positronium: μ = mₑ/2, E₁ = −6.8 eV; muonic atom: energies ×~207"
   }
  },
  {
   "id": "zs-f19",
   "topicId": "puc2-physics-12-atoms.t3",
   "name": {
    "en": "Limitations of Bohr model"
   },
   "tex": "\\text{one-electron systems only; no line intensities or fine structure}"
  }
 ]
}
