   ],
   "q": {
    "en": "A car covers the first 30 km of a trip at 30 km h⁻¹ and the next 30 km at 60 km h⁻¹. Its average speed for the whole trip is:"
   },
   "options": [
    {
     "en": "45 km h⁻¹"
    },
    {
     "en": "40 km h⁻¹"
    },
    {
     "en": "50 km h⁻¹"
    },
    {
     "en": "42.5 km h⁻¹"
    }
   ],
   "answer": 1,
   "steps": [
    {
     "en": "Average speed $=$ total distance $\\div$ total time."
    },
    {
     "en": "Time $= 30/30 + 30/60 = 1.5$ h"
    },
    {
     "en": "Average speed $= 60/1.5 = 40$ km h⁻¹"
    },
    {
     "en": "Equal distances: harmonic mean $\\frac{2v_1v_2}{v_1+v_2}$, not 45."
    }
   ],
   "idealTime": 50,
   "difficulty": 1
  },
