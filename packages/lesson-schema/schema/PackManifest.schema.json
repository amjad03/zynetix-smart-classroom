{
  "$ref": "#/definitions/PackManifest",
  "definitions": {
    "PackManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "title": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "kn": {
              "type": "string"
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "subject": {
          "type": "string",
          "enum": [
            "physics",
            "chemistry",
            "maths",
            "biology"
          ]
        },
        "year": {
          "type": "string",
          "enum": [
            "puc1",
            "puc2"
          ]
        },
        "chapterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "createdAt": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "title",
        "subject",
        "year",
        "chapterId",
        "createdAt",
        "keyId",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
