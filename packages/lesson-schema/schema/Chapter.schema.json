{
  "$ref": "#/definitions/Chapter",
  "definitions": {
    "Chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject": {
          "type": "string",
          "enum": [
            "physics",
            "chemistry",
            "maths",
            "biology",
            "computer_science",
            "electronics",
            "statistics",
            "accountancy",
            "business_studies",
            "economics",
            "commerce",
            "english"
          ]
        },
        "year": {
          "type": "string",
          "enum": [
            "puc1",
            "puc2"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "kn": {
              "type": "string"
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "title": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kn": {
                    "type": "string"
                  }
                },
                "required": [
                  "en"
                ],
                "additionalProperties": false
              },
              "ncert": {
                "type": "string"
              },
              "boards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "kar_pu",
                    "cbse",
                    "isc"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "exams": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PUC",
              "CBSE",
              "ISC",
              "KCET",
              "COMEDK",
              "NEET",
              "JEE",
              "JEE_ADV",
              "CUET"
            ]
          },
          "default": []
        },
        "boards": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "kar_pu",
              "cbse",
              "isc"
            ]
          },
          "minItems": 1,
          "default": [
            "kar_pu",
            "cbse"
          ]
        },
        "book": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "subject",
        "year",
        "number",
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
