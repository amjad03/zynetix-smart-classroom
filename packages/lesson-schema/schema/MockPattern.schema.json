{
  "$ref": "#/definitions/MockPattern",
  "definitions": {
    "MockPattern": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "exam": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "kn": {
              "type": "string"
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "blurb": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "kn": {
              "type": "string"
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 400
        },
        "minutesPerSection": {
          "type": "integer",
          "minimum": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "enum": [
                  "physics",
                  "chemistry",
                  "maths",
                  "biology",
                  "computer_science",
                  "electronics",
                  "statistics",
                  "accountancy",
                  "business_studies",
                  "economics",
                  "commerce",
                  "english"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "plus": {
                "type": "number"
              },
              "minus": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "subject",
              "count",
              "plus",
              "minus"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "exam",
        "title",
        "blurb",
        "minutes",
        "sections"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
