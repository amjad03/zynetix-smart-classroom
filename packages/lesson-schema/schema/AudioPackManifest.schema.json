{
  "$ref": "#/definitions/AudioPackManifest",
  "definitions": {
    "AudioPackManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "audio"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "packId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "chapterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "kn"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "createdAt": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        },
        "voice": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "type": "string"
            },
            "licence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "model",
            "licence"
          ],
          "additionalProperties": false
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lessonId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "blockId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "clip": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              }
            },
            "required": [
              "lessonId",
              "blockId",
              "step",
              "clip",
              "file",
              "ms",
              "sha"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "packId",
        "chapterId",
        "lang",
        "version",
        "createdAt",
        "keyId",
        "voice",
        "clips",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
