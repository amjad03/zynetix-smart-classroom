DATABASE_URL=postgres://zynetix:zynetix@localhost:5432/zynetix
JWT_SECRET=change-me
# S3 (ap-south-1). Leave S3_BUCKET empty to store packs on local disk (dev, tests).
S3_BUCKET=
AWS_REGION=ap-south-1
# Ed25519 PEM keys; generated into ./keys on first run when unset (dev only).
PACK_SIGNING_KEY_FILE=
LICENCE_KEY_FILE=
